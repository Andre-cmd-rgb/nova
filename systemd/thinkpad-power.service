[Unit]
Description=Apply the AC/battery power policy
Documentation=https://github.com/Andre-cmd-rgb/thinkpad-power
# Ordered after the sleep targets so the same unit re-applies the policy on
# resume: the machine may have been unplugged while it was asleep, and the
# GPU comes back on the bus regardless of how it went to sleep.
# Deliberately NOT ordered against power-profiles-daemon: PPD is itself
# After=multi-user.target, so an After= on it closes a cycle
# (multi-user -> thinkpad-power -> PPD -> multi-user) that systemd breaks by
# dropping PPD's own start job. Profiles are Omarchy's business anyway.
After=suspend.target hibernate.target suspend-then-hibernate.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/thinkpad-power auto

[Install]
WantedBy=multi-user.target suspend.target hibernate.target suspend-then-hibernate.target
