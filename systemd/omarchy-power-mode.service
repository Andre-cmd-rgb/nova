[Unit]
Description=Apply the AC/battery power policy
Documentation=https://github.com/Andre-cmd-rgb/omarchy-power
# Ordered after the sleep targets so the same unit re-applies the policy on
# resume: the machine may have been unplugged while it was asleep, and the
# GPU comes back on the bus regardless of how it went to sleep.
After=power-profiles-daemon.service suspend.target hibernate.target
Wants=power-profiles-daemon.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/omarchy-power-mode auto

[Install]
WantedBy=multi-user.target suspend.target hibernate.target
