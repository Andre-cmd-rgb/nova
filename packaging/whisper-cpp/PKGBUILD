# Maintainer: Andre-cmd-rgb <https://github.com/Andre-cmd-rgb/nova>
#
# whisper-cpp: dictation's speech engine, whose parakeet-cli turns a
# recording into text, built from the tagged release with the copy of ggml,
# its tensor library, that the release carries. Arch Linux ARM packages
# neither. Arch's x86 package links Arch's own ggml, which is updated apart
# from it: ggml 0.29 (2026-11-08) stops whisper.cpp 1.9.5 as it loads the
# model, rebuilt or not, and dictation with it. The [nova] repository comes
# before Arch's in pacman.conf, so this build is the one installed.
# Upstream: https://github.com/ggml-org/whisper.cpp, MIT.
#
# On the Pi it is built for the one ARM CPU Nova runs on there, the Pi 5's
# Cortex-A76: Armv8.2-A, with the dot-product and half-precision instructions
# ggml uses, and ggml linked in, the CPU its only backend. CI builds on arm64
# machines with instructions the Pi lacks, and a build for the machine it ran
# on would stop on the Pi with an illegal instruction.
#
# On x86 Nova also runs on CPUs older than x86-64-v3, so ggml's CPU backend is
# built once for each generation and the best one the CPU can run is loaded
# as it starts, as Arch does it. Those are shared libraries, kept to themselves in
# /usr/lib/whisper-cpp, where Arch's ggml, if installed, does not see them.
#
# A recording is a WAV, which whisper.cpp reads by itself, so ffmpeg is not
# needed.

pkgname=whisper-cpp
pkgver=1.9.5
# 2: above Arch's 1.9.5-1, which x86 systems had, so that pacman moves to this.
pkgrel=2
pkgdesc="Port of OpenAI's Whisper model in C/C++, with NVIDIA's Parakeet (Nova's build)"
arch=(aarch64 x86_64)
url='https://github.com/ggml-org/whisper.cpp'
license=(MIT)
depends=(glibc)
depends_aarch64=(gcc-libs)
depends_x86_64=(libgcc libgomp libstdc++)
makedepends=(cmake)
options=(!debug !lto)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('ff1a9053feb509ff9d7729703355541ae9690073a6b1c40eb692c962e0dc1720')

_libdir=/usr/lib/whisper-cpp

build() {
  local options=(
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_INSTALL_PREFIX=/usr
    -DGGML_NATIVE=OFF
    -DWHISPER_BUILD_TESTS=OFF
    -DWHISPER_BUILD_SERVER=OFF
    -DWHISPER_COMMON_FFMPEG=OFF
    -DWHISPER_SDL2=OFF
    -DWHISPER_CURL=OFF
  )
  if [[ $CARCH == x86_64 ]]; then
    options+=(
      -DBUILD_SHARED_LIBS=ON
      -DGGML_BACKEND_DL=ON
      -DGGML_CPU_ALL_VARIANTS=ON
      "-DGGML_BACKEND_DIR=$_libdir"
      "-DCMAKE_INSTALL_RPATH=$_libdir"
      -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON
    )
  else
    options+=(
      -DBUILD_SHARED_LIBS=OFF
      -DGGML_CPU_ARM_ARCH=armv8.2-a+dotprod+fp16
    )
  fi
  cmake -S "whisper.cpp-$pkgver" -B build "${options[@]}"
  cmake --build build --target parakeet-cli whisper-cli
}

check() {
  # It starts: every library found, and on the Pi's CPU or one above it.
  LD_LIBRARY_PATH=build/bin build/bin/parakeet-cli --help >/dev/null
}

package() {
  install -Dm755 build/bin/parakeet-cli build/bin/whisper-cli -t "$pkgdir/usr/bin/"
  if [[ $CARCH == x86_64 ]]; then
    # The libraries by their sonames, and every CPU variant.
    install -d "$pkgdir$_libdir"
    cp -P build/bin/lib*.so.* "$pkgdir$_libdir/"
    install -m755 build/bin/libggml-cpu-*.so -t "$pkgdir$_libdir/"
  fi
  install -Dm644 "whisper.cpp-$pkgver/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
}

