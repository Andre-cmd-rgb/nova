  fastfetch      # a summary of the system, in a terminal
  cava           # the sound playing, as bars, in a terminal
  cmatrix        # falling code, in a terminal

  # Games: game controllers and VR headsets for the user at the seat, as Steam
  # and every game reads them; AppImages, as many games and launchers come
