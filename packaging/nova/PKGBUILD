# Maintainer: Andre-cmd-rgb <https://github.com/Andre-cmd-rgb/nova>
#
# The `nova` package: everything in this repository, installed by `make install`.
#
# Source: by default this repository's own checkout (git+file://), so a local
# `makepkg` builds the *committed* HEAD, not uncommitted changes. CI overrides it:
#
#   NOVA_SOURCE='git+https://github.com/Andre-cmd-rgb/nova.git#tag=v1.0.0-beta.1' makepkg
#
# pkgver comes from `git describe`. A tag v1.0.0-beta.1 becomes 1.0.0beta.1, which
# pacman sorts before 1.0.0 (see docs/releasing.md); commits after a tag append
# +<count>.g<hash>, which sorts after the tag.

pkgname=nova
pkgver=0.0.0
pkgrel=1
pkgdesc='A small, fast Arch Linux desktop: Hyprland, a Quickshell shell, one CLI and a laptop power manager'
arch=(x86_64)
url='https://github.com/Andre-cmd-rgb/nova'
license=(MIT)
depends=(
  nova-keyring   # trusts the [nova] repository's key

  # Session: compositor, shell, login
  hyprland
  quickshell
  uwsm
  greetd
  greetd-agreety
  xdg-desktop-portal-hyprland
  xdg-desktop-portal-gtk
  xdg-terminal-exec
  xdg-utils
  hyprpicker
  hyprsunset
  xsettingsd     # X11 apps' scale and theme, as XSETTINGS (nova-hyprland-x11-scale)
  xorg-xrdb      # and the scale as Xft.dpi, in XWayland's resources
  adw-gtk-theme  # GTK 3 apps in the theme's colors, drawn as libadwaita's (nova-theme-apply)

  # Audio
  pipewire
  pipewire-pulse
  pipewire-alsa
  pipewire-jack
  pipewire-audio # pw-record, for dictation
  whisper-cpp    # parakeet-cli, dictation's speech engine (Nova's own build)
  wireplumber
  rtkit          # realtime scheduling for PipeWire's audio threads
  sof-firmware   # sound on recent Intel and AMD laptops

  # Secrets and privilege
  gnome-keyring
  libgcrypt      # nova-sessiond: the password gnome-keyring asks for, sent back in gcr's secret exchange
  libsecret      # secret-tool: the Calendar's passwords and tokens, in the login keyring
  polkit

  # Network, Bluetooth, power, backlight, removable disks, firmware
  networkmanager
  modemmanager   # mobile data, and the FCC unlocks Nova turns on (data/network)
  mobile-broadband-provider-info # the APN for a SIM, looked up the first time
  bluez
  bluez-utils
  upower
  power-profiles-daemon
  brightnessctl
  iw
  wireless-regdb # the radio rules of the country the computer is in
  openssl        # AirDrop's TLS, and the certificate it makes itself
  zlib           # AirDrop: what an iPhone sends is packed with it
  bubblewrap     # AirDrop: the picture an iPhone sends with its offer is read in a sandbox
  udisks2        # removable drives, which nova-sessiond mounts while the session is unlocked
  ddcutil        # brightness of external monitors
  fwupd          # firmware updates from the makers (nova update firmware)

  # Printing and scanning: CUPS takes the jobs, Avahi finds the printers and
  # scanners on the network, nss-mdns reaches them by their .local names
  cups
  cups-filters
  avahi
  nss-mdns
  sane-airscan
  ipp-usb        # a modern USB printer as a driverless one on the network (Settings → Printers adds the older ones)

  # Apps the session launches
  foot
