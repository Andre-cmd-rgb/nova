  gvfs-gphoto2
  gvfs-afc       # iPhones
  gvfs-smb       # Windows shares
  poppler        # pdftoppm: Quick Look's first page of a PDF (Space on a file in Files)
  ffmpeg         # Quick Look's frame of a video and cover of a song; trimming screen recordings
  loupe          # photos
  mpv            # video and music
