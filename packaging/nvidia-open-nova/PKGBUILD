# Maintainer: Andre-cmd-rgb <https://github.com/Andre-cmd-rgb/nova>
#
# Derived from the Arch Linux `nvidia-open` package (615.78.08-3, packaging commit
# ef1950544c4648b37ba56fec7b58b8ef866e2b42) by Sven-Hendrik Haase and Peter Jung,
# licensed 0BSD. It builds the same open kernel modules, from the same
# nvidia-open-dkms sources, against linux-nova instead of linux.
#
# pkgver is two versions joined: NVIDIA's, which must equal extra/nvidia-utils in the
# release's Arch Linux Archive snapshot because userspace and modules have to match
# exactly, and the linux-nova build the modules are for. A change in either makes a
# newer package. The release workflow writes it from the snapshot and the kernel it
# just built (see docs/packaging.md); the value here is the last one released. Out of
# step, the build fails loudly: it cannot resolve nvidia-open-dkms=$_nvidia.

pkgname=nvidia-open-nova
pkgver=615.78.08_7.2.11.arch1_1
pkgrel=1
_nvidia=${pkgver%%_*}
pkgdesc='NVIDIA open kernel modules for linux-nova'
arch=(x86_64)
url='https://github.com/NVIDIA/open-gpu-kernel-modules'
license=('MIT AND GPL-2.0-only')
depends=("nvidia-utils=${_nvidia}" libglvnd)
makedepends=(linux-nova-headers "nvidia-open-dkms=$_nvidia")
options=('!strip' '!debug')
conflicts=(nvidia)
provides=(NVIDIA-MODULE)

build() {
  _kernver=$(</usr/src/linux-nova/version)

  fakeroot dkms build --dkmstree "${srcdir}" -m nvidia/${_nvidia} -k ${_kernver}
}

package() {
  _kernver="$(</usr/src/linux-nova/version)"

  # Modules are specific to one kernel build, so depend on exactly the linux-nova this
  # was built against. The kernel release is <pkgver with the first '-' as '.'>-<pkgrel>
  # followed by '-nova', e.g. 7.2.11-arch1-1-nova is package version 7.2.11.arch1-1.
  _kernpkgver=${_kernver%-nova}
  _kernpkgver=${_kernpkgver/-/.}
  # (The ${:+} form keeps `makepkg --printsrcinfo`, which evaluates this line without
  # the variable set, printing a plain "linux-nova" instead of a broken "linux-nova=".)
  depends=("linux-nova${_kernpkgver:+=$_kernpkgver}" "nvidia-utils=${_nvidia}" libglvnd)

  install -Dt "${pkgdir}/usr/lib/modules/${_kernver}/extramodules" -m644 nvidia/${_nvidia}/${_kernver}/${CARCH}/module/*.ko

  # compress each module individually
  find "$pkgdir" -name '*.ko' -exec zstd --rm -19 {} +

  install -Dm644 /usr/share/licenses/nvidia-open-dkms/LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

# vim:set sw=2 et:
