     if (!m_state.pointerFocusResource || g_pInputManager->pointerConstraints().blocksAbsoluteMotion())
         return;
 
+#ifndef NO_XWAYLAND
+    // XWayland posts a motion that comes without a relative one as an absolute
+    // pointer device's, and the X server switches its core pointer to that
+    // device's absolute axes. A game that read the core pointer's axes then
+    // takes each mouse motion for a position (SDL before 3.4.16 reads them
+    // once), and its relative mouse barely moves. So a motion no mouse made, a
+    // window placed under the pointer or a warp, comes with a zero relative
+    // motion, which keeps XWayland on its relative pointer device.
+    if (g_pXWayland && g_pXWayland->m_server && m_state.pointerFocusResource->client() == g_pXWayland->m_server->m_xwaylandClient && PROTO::relativePointer)
