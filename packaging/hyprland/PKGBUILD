# Maintainer: Andre-cmd-rgb <https://github.com/Andre-cmd-rgb/nova>
# Arch's packaging: Caleb Maclennan, ThatOneCalculator, Brenno Lemos, Gabriel Fox
#
# hyprland: Arch's Hyprland with one patch, xwayland-scale.patch, which adds
# the option xwayland:scale. X11 windows are then drawn at one scale on every
# display, 1:1 on a display of that scale and shrunk to the size of one of a
# lower scale, as GNOME and KDE draw them. Without it, a display shows X11
# windows at its own resolution (force_zero_scaling, env.lua), so an app drawn
# for a 2x panel is twice its size on a 1x monitor beside it.
# nova-hyprland-x11-scale sets the option. The patch is offered to Hyprland
# (UPSTREAM.md); once Hyprland has the option, this package goes and Arch's
# comes back.
# Upstream: https://github.com/hyprwm/Hyprland, BSD-3-Clause.
#
# Arch's PKGBUILD at its packaging commit 77a60031 (0.57.2-1,
# https://gitlab.archlinux.org/archlinux/packaging/packages/hyprland), with
# three changes: the patch, applied in prepare(); hyprland alone, without
# hyprpm (Arch's hyprpm depends on any hyprland, so it works with this one);
# and no debug package.
#
# pkgrel is Arch's, then Nova's revision of the patch: 1.1 is Arch's 0.57.2-1
# with the first. pacman takes a package from the first repository that has
# it, and [nova] comes first in pacman.conf, so this is the one installed;
# being newer than Arch's build of the same pkgrel, it replaces Arch's on a
# system that had it, as an ordinary update. The release workflow writes
# Arch's pkgrel from the snapshot (Arch raises it when a library Hyprland links
# changes its soname), and builds this only while pkgver is the snapshot's: a
# newer Hyprland in Arch is released as Arch's, unpatched, until the patch is
# moved onto it (docs/packaging.md has how).

pkgname=hyprland
pkgver=0.57.2
pkgrel=1.1
pkgdesc="a highly customizable dynamic tiling Wayland compositor (Nova's build, with xwayland:scale)"
arch=(x86_64)
url='https://github.com/hyprwm/Hyprland'
license=(BSD-3-Clause)
depends=(cairo # libcairo.so
         aquamarine
         libgcc # libgcc_s.so
         'libstdc++' # libstdc++.so
         glibc # libc.so libm.so
         glib2
         glslang # libglslang-default-resource-limits.so libglslang.so
         hyprcursor
         hyprgraphics
         hyprland-guiutils
         hyprlang
         hyprutils
         hyprwire
         lcms2
         libcanberra
         libdrm # libdrm.so
         libei
         libglvnd
         libinput # libinput.so
         libx11
         libxcb # libxcb-dri3.so libxcb-present.so libxcb-render.so libxcb-res.so libxcb-shm.so libxcb.so libxcb-xfixes.so libxcb-xinput.so
         libxcomposite # libxcb-composite.so
         libxcursor # libXcursor.so
         libxfixes
         libxkbcommon
         libxrender
         lua # liblua.so
         mesa # libgbm.so
         muparser # libmuparser.so
         opengl-driver
         pango
         pixman
         re2
         sdbus-cpp
         tomlplusplus
         util-linux-libs
         wayland
         wayland-protocols
         xcb-proto
         xcb-util
         xcb-util-errors # libxcb-errors.so
         xcb-util-image
         xcb-util-keysyms
         xcb-util-renderutil # libxcb-render-util.so
         xcb-util-wm # libxcb-ewmh.so  libxcb-icccm.so
         xorg-xwayland)
makedepends=(cmake
             glaze
             hyprland-protocols
             hyprwayland-scanner
             meson
             ninja
             xorgproto)
optdepends=('hyprpm: build and install plugins'
            'hyprshutdown: clean logout and shutdown helper'
            'xdg-desktop-portal-hyprland: xdg-desktop-portal backend for hyprland')
provides=(wayland-compositor)
options=(!debug)
_archive="Hyprland-$pkgver"
source=("$_archive.tar.gz::$url/releases/download/v$pkgver/source-v$pkgver.tar.gz"
        xwayland-scale.patch)
sha256sums=('34dbec0738ab88c8228caf89385662688ab1601ea58fbe5c60a6b6ab383db46d'
            '43cad455964609aece7a5066cf4a66ecbfba8ab06a66ec314f525fb2c4ff218d')

prepare() {
  ln -sf hyprland-source "$_archive"
  cd "$_archive"
  sed -i -e '/^release:/{n;s/-D/-DCMAKE_SKIP_RPATH=ON -D/}' Makefile
  sed -i -e '/find_package.glaze/s/7...<8 //' {.,hyprpm,start}/CMakeLists.txt
  patch -Np1 -i "$srcdir/xwayland-scale.patch"
}

build() {
  cd "$_archive"
  make release PREFIX=/usr
}

check() {
  # It starts, with every library found, and has the option.
  "$_archive/build/Hyprland" --version >/dev/null
  grep -qa 'xwayland:scale' "$_archive/build/Hyprland"
}

package() {
  depends+=(libEGL.so
            libGLESv2.so
            libaquamarine.so
            libcanberra.so
            libeis.so
            libgio-2.0.so
            libgobject-2.0.so
            libhyprcursor.so
            libhyprgraphics.so
            libhyprlang.so
            libhyprutils.so
            libhyprwire.so
            liblcms2.so
            libpango-1.0.so
            libpangocairo-1.0.so
            libpixman-1.so
            libre2.so
            libreadline.so
            libsdbus-c++.so
            libtomlplusplus.so
            libuuid.so
            libwayland-server.so
            libxkbcommon.so)
  cd "$_archive"
  make DESTDIR="$pkgdir" install
  rm -fv "$pkgdir/usr/include/hyprland/src/version.h.in"
  find "$pkgdir" -name '*hyprpm*' -delete
  install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
}

