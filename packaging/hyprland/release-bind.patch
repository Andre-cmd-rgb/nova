+// Where an input is in the pressed list, which is in the order of the presses.
+static std::optional<size_t> pressedIndex(const CInputState& state, const SResolvedKey& key, const SP<IHID>& device) {
+    const auto* input = state.find(key, device);
+    if (!input)
+        return std::nullopt;
+    return sc<size_t>(input - state.pressed().data());
+}
