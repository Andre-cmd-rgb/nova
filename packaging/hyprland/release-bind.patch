+TEST_CASE(releaseBindAfterItsModifierIsReleased) {
+    constexpr uint32_t SUPER_L = KEY_LEFTMETA + 8;
+    constexpr uint32_t K       = KEY_K + 8;
+
+    const auto         count = [] { return getFromSocket("/repl return tostring(_G.hyprtester_super_k_release)"); };
+
+    OK(getFromSocket("/eval do "
+                     "_G.hyprtester_super_k_release = 0; "
+                     "hl.bind('SUPER + K', function() _G.hyprtester_super_k_release = _G.hyprtester_super_k_release + 1 end, { release = true }) "
+                     "end"));
+
+    // K let go before SUPER.
+    OK(getFromSocket(pluginKeybindCmd(true, MOD_META, SUPER_L)));
+    OK(getFromSocket(pluginKeybindCmd(true, MOD_META, K)));
+    OK(getFromSocket(pluginKeybindCmd(false, MOD_META, K)));
+    OK(getFromSocket(pluginKeybindCmd(false, 0, SUPER_L)));
+    EXPECT(count(), "1");
+
+    // SUPER let go before K: the K still held must not shadow its own release bind.
+    OK(getFromSocket(pluginKeybindCmd(true, MOD_META, SUPER_L)));
+    OK(getFromSocket(pluginKeybindCmd(true, MOD_META, K)));
+    OK(getFromSocket(pluginKeybindCmd(false, 0, SUPER_L)));
+    OK(getFromSocket(pluginKeybindCmd(false, 0, K)));
+    EXPECT(count(), "2");
+
+    OK(getFromSocket("/eval do "
+                     "hl.unbind('SUPER + K'); "
+                     "_G.hyprtester_super_k_release = nil "
+                     "end"));
+}
