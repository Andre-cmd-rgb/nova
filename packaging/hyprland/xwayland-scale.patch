+TEST(MonitorPositionController, xwaylandPositionsUseOneScaleWhenSet) {
+    // a 2x panel of 200x100 px, a 1x monitor of 50x50 and a 1.5x one of 150x75 px: X11 coordinates are 2x on all three
+    const auto first  = testMonitor(0, "first", {100, 50});
+    const auto second = testMonitor(1, "second", {50, 50});
+    const auto third  = testMonitor(2, "third", {100, 50});
+
+    first->m_explicitPosition  = Vector2D{0, 0};
+    second->m_explicitPosition = Vector2D{100, 0};
+    third->m_explicitPosition  = Vector2D{150, 0};
+    first->m_transformedSize   = Vector2D{200, 100};
+    first->m_scale             = 2.F;
+    third->m_transformedSize   = Vector2D{150, 75};
+    third->m_scale             = 1.5F;
+
+    for (const bool forceZero : {false, true}) {
+        arrange({first, second, third}, forceZero, 2.F);
+
+        EXPECT_EQ(first->m_xwaylandPosition, Vector2D(0, 0));
+        EXPECT_EQ(second->m_xwaylandPosition, Vector2D(200, 0));
+        EXPECT_EQ(third->m_xwaylandPosition, Vector2D(300, 0));
+        EXPECT_FLOAT_EQ(first->m_xwaylandScale, 2.F);
+        EXPECT_FLOAT_EQ(second->m_xwaylandScale, 2.F);
+        EXPECT_FLOAT_EQ(third->m_xwaylandScale, 2.F);
+    }
+}
+
+TEST(MonitorPositionController, xwaylandSizeIsThePixelsAtTheMonitorsOwnScale) {
+    // 2880x1800 at 1.6 is 1800x1125 logical: X11 at 1.6 is the pixels, not 1800x1125 * 1.6 rounded
+    EXPECT_EQ(State::xwaylandSizeFor({1800, 1125}, {2880, 1800}, 1.6F, 1.6F), Vector2D(2880, 1800));
+    EXPECT_EQ(State::xwaylandSizeFor({1800, 1125}, {2880, 1800}, 1.6F, 2.0), Vector2D(3600, 2250));
+    EXPECT_EQ(State::xwaylandSizeFor({1920, 1080}, {1920, 1080}, 1.F, 1.0), Vector2D(1920, 1080));
+}
