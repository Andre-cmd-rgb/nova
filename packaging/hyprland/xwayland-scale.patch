+
+double CHyprXWaylandManager::xwaylandScale(PHLMONITOR pMonitor) {
+    static auto PXWLSCALE          = CConfigValue<Config::FLOAT>("xwayland:scale");
+    static auto PXWLFORCESCALEZERO = CConfigValue<Config::INTEGER>("xwayland:force_zero_scaling");
+
+    if (*PXWLSCALE > 0)
+        return *PXWLSCALE;
+
+    return *PXWLFORCESCALEZERO && pMonitor ? pMonitor->m_scale : 1.0;
+}
+
+Vector2D CHyprXWaylandManager::xwaylandSize(PHLMONITOR pMonitor) {
+    return State::xwaylandSizeFor(pMonitor->m_size, pMonitor->m_transformedSize, pMonitor->m_scale, xwaylandScale(pMonitor));
+}
+
+void CHyprXWaylandManager::refreshScale() {
+    // xwayland's outputs were arranged with each monitor's scale of X11 coordinates at the time
+    const bool CHANGED =
+        std::ranges::any_of(State::monitorState()->monitors(), [this](const auto& m) { return m->m_xwaylandScale != sc<float>(xwaylandScale(m)); });
+    if (!CHANGED)
+        return;
+
+    State::monitorLayoutController()->arrange();
+
+    for (const auto& w : Desktop::windowState()->windows()) {
+        if (!w->mapped() || !w->backend().isX11())
+            continue;
+
+        w->sendWindowSize();
+        g_pHyprRenderer->damageWindow(w);
+    }
+}
