+// A game that sets its own resolution through RandR (an exclusive fullscreen mode) is told by XWayland that the
+// monitor has that mode, and expects its window to be given that size when fullscreen: XWayland then scales a
+// window of that size at the monitor's origin up to the whole monitor (wp_viewport), and names the mode in
+// _XWAYLAND_RANDR_EMU_MONITOR_RECTS for the window manager, as Mutter and KWin read it. Given the monitor's own
+// size instead, the game draws every pixel of the monitor, and its resolution setting does nothing but cost.
+std::optional<Vector2D> CX11Backend::emulatedModeSize(const std::vector<CBox>& modes, const CBox& clientBox, const CBox& monitorBox) {
+    // only a box that is the whole of the monitor, as fullscreen gives
+    if (clientBox.pos() != monitorBox.pos() || std::abs(clientBox.w - monitorBox.w) > 1 || std::abs(clientBox.h - monitorBox.h) > 1)
+        return std::nullopt;
+
+    for (const auto& mode : modes) {
+        if (mode.pos() == monitorBox.pos() && mode.w > 0 && mode.h > 0)
+            return mode.size();
+    }
+
+    return std::nullopt;
+}
