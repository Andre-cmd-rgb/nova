+++ b/tests/desktop/view/X11EmulatedMode.cpp
@@ -0,0 +1,28 @@
+#include <desktop/view/window/X11Backend.hpp>
+
+#include <gtest/gtest.h>
+
+using namespace Desktop::View;
+
+// A 3840x2400 monitor at X11 scale 2 is 4800x3000 in X11 coordinates; a second one, 1920x1080, is beside it.
+static const CBox FIRST  = {0, 0, 4800, 3000};
+static const CBox SECOND = {4800, 0, 1920, 1080};
+
+TEST(X11EmulatedMode, fullscreenGetsTheModeTheClientSet) {
+    EXPECT_EQ(CX11Backend::emulatedModeSize({{0, 0, 1280, 720}}, FIRST, FIRST), Vector2D(1280, 720));
+    // the client's mode on the monitor the window is fullscreen on, not another's
+    EXPECT_EQ(CX11Backend::emulatedModeSize({{0, 0, 1280, 720}, {4800, 0, 800, 600}}, SECOND, SECOND), Vector2D(800, 600));
+    // logicalToClient rounds: a pixel off is still the whole monitor
+    EXPECT_EQ(CX11Backend::emulatedModeSize({{0, 0, 1440, 1080}}, {0, 0, 4799, 3001}, FIRST), Vector2D(1440, 1080));
+}
+
+TEST(X11EmulatedMode, otherBoxesKeepTheirSize) {
+    // windowed, or tiled with the bar and gaps
+    EXPECT_EQ(CX11Backend::emulatedModeSize({{0, 0, 1280, 720}}, {0, 0, 1708, 960}, FIRST), std::nullopt);
+    EXPECT_EQ(CX11Backend::emulatedModeSize({{0, 0, 1280, 720}}, {42, 84, 4716, 2874}, FIRST), std::nullopt);
+    // fullscreen on a monitor the client set no mode for
+    EXPECT_EQ(CX11Backend::emulatedModeSize({{0, 0, 1280, 720}}, SECOND, SECOND), std::nullopt);
+    // no mode set, or an empty one
+    EXPECT_EQ(CX11Backend::emulatedModeSize({}, FIRST, FIRST), std::nullopt);
+    EXPECT_EQ(CX11Backend::emulatedModeSize({{0, 0, 0, 0}}, FIRST, FIRST), std::nullopt);
+}
