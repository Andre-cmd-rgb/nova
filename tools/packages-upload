#!/bin/bash
# packages-upload: put a release's package repository and signed files in the
# nova-packages bucket on Cloudflare R2, then read each back from the address
# pacman will use and compare, so a release is published only once its
# packages are there.
#
#   tools/packages-upload --release <release.toml> <file>...
#
# The files go into the folder release.toml's nova_repo names: for
# https://nova-packages.piserver.stream/v1.0.0, the bucket's v1.0.0/.
#
# Environment: R2_ENDPOINT (https://<account id>.r2.cloudflarestorage.com),
# R2_BUCKET, and the bucket's token as AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY. Needs the aws CLI. See docs/releasing.md.
set -euo pipefail

die() { printf 'packages-upload: %s\n' "$*" >&2; exit 1; }

release=''
while (($#)); do
  case $1 in
    --release) release=${2:?--release needs a file}; shift 2 ;;
    -h | --help) sed -n '2,/^set /p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
    -*) die "unknown option: $1" ;;
    *) break ;;
  esac
done
[[ -r $release && $# -gt 0 ]] || die "usage: tools/packages-upload --release <release.toml> <file>..."
[[ -n ${R2_ENDPOINT:-} && -n ${R2_BUCKET:-} ]] || die "R2_ENDPOINT and R2_BUCKET must be set"
[[ -n ${AWS_ACCESS_KEY_ID:-} && -n ${AWS_SECRET_ACCESS_KEY:-} ]] ||
  die "the bucket's token is not set (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY)"
command -v aws >/dev/null || die "needs the aws CLI"

repo=$(sed -n 's/^nova_repo = "\(.*\)"$/\1/p' "$release")
[[ $repo =~ ^https://[A-Za-z0-9.-]+/(.+)$ ]] || die "$release has no nova_repo with a folder in it"
folder=${BASH_REMATCH[1]}

# R2 takes any region and ignores it; the checksums are the ones R2 asks for,
# not every one a newer aws CLI would add.
export AWS_DEFAULT_REGION=auto AWS_REQUEST_CHECKSUM_CALCULATION=when_required AWS_RESPONSE_CHECKSUM_VALIDATION=when_required

for file; do
  [[ -f $file ]] || die "$file is not a file"
  aws s3 cp --only-show-errors --endpoint-url "$R2_ENDPOINT" "$file" "s3://$R2_BUCKET/$folder/${file##*/}" ||
    die "could not upload ${file##*/}"
done
for file; do
  sent=$(sha256sum <"$file")
  served=$(curl -fsSL --retry 3 --max-time 600 "$repo/${file##*/}" | sha256sum) ||
    die "$repo/${file##*/} cannot be read back"
  [[ $served == "$sent" ]] || die "$repo/${file##*/} is not what was uploaded"
done
printf 'packages-upload: %d files at %s\n' "$#" "$repo" >&2
