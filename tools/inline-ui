#!/bin/bash
# The single-file nova-usb for a release page: installer/nova-usb with
# installer/ui.bash and the wordmark written in where it would otherwise source
# them from beside itself (between its "# @ui begin" and "# @ui end" lines),
# and Nova's public key where it would read it from nova-keyring (between
# "# @key begin" and "# @key end").
#
#   tools/inline-ui >out/nova-usb
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
for marker in '# @ui begin' '# @key begin'; do
  grep -q "^$marker" "$root/installer/nova-usb" || {
    echo "inline-ui: installer/nova-usb has no '$marker' line" >&2
    exit 1
  }
done
key=$root/packaging/nova-keyring/nova.gpg
grep -q '^-----BEGIN PGP PUBLIC KEY BLOCK-----$' "$key" || {
  echo "inline-ui: $key is not an armored public key" >&2
  exit 1
}
awk -v ui="$root/installer/ui.bash" -v mark="$root/theme/wordmark/nova.txt" -v key="$key" '
  /^# @ui begin/ {
    while ((getline line < ui) > 0) print line
    print ""
    print "ui_wordmark() {"
    print "  cat <<'\''WORDMARK'\''"
    while ((getline line < mark) > 0) print line
    print "WORDMARK"
    print "}"
    skip = 1
    next
  }
  /^# @key begin/ {
    print "release_key() {"
    print "  cat <<'\''KEY'\''"
    while ((getline line < key) > 0) print line
    print "KEY"
    print "}"
    skip = 1
    next
  }
  /^# @(ui|key) end/ { skip = 0; next }
  !skip
' "$root/installer/nova-usb"
