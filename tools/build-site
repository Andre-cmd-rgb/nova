href_of() { # <page> <from page>: the link to a page from another
  local href
  if [[ $1 == README ]]; then href=./; else href=$1/; fi
  [[ $2 == README ]] || href=../${href#./}
  echo "$href"
}
label_of() { # <page>: the doc's title up to a colon ("Patches: fixes for one computer" is Patches)
  local label
