  # a javascript: link. A content-security policy of script-src 'self' runs
  # none of them; what a page runs is a file of the site (site/*.js).
  while IFS= read -r tag; do
    problem "$from: a script in the page, which a script-src 'self' policy refuses; put it in a file of the site: $tag"
  done < <({ grep -oiE '<script[^>]*>' "$page" | grep -viE ' src="[^"]+"' || true
    grep -oiE '<[a-z][^>]*[[:space:]]on[a-z]+[[:space:]]*=[^>]*>' "$page" || true
    grep -oiE '<[a-z][^>]* (href|src|action|formaction)="[[:space:]]*javascript:[^>]*>' "$page" || true; })
done < <(find "$site" -name '*.html' | sort)

# The stylesheets' url()s, to files of the site and nowhere else.
while IFS= read -r css; do
  from=${css#"$site"/}
  grep -q '@import' "$css" && problem "$from: @import fetches another stylesheet; link it from the page"
  while IFS= read -r url; do
    case $url in
      data:*) ;;
      *:* | //*) problem "$from: url($url) loads from another site" ;;
      *) [[ -f $(realpath -m "$(dirname "$css")/${url%%[?#]*}") ]] || problem "$from: url($url) is no file of the site" ;;
    esac
  done < <(grep -o 'url([^)]*)' "$css" | sed -E 's/^url\((["'\'']?)(.*)\1\)$/\2/')
done < <(find "$site" -name '*.css' | sort)

# Scripts that fetch nothing from another site: no fetch, import, worker or
# socket of an address, and no picture or script given one.
quote="[\"'\`]"
while IFS= read -r js; do
  while IFS= read -r line; do
    problem "${js#"$site"/}: fetches from another site: $line"
  done < <(grep -nE "(fetch|import|Worker|EventSource|WebSocket|sendBeacon|open)\(\s*$quote(https?:)?//|\.(src|href)\s*=\s*$quote(https?:)?//" "$js" || true)
done < <(find "$site" -name '*.js' | sort)

# A font of the site with its licence beside it.
if compgen -G "$site/fonts/*.woff2" >/dev/null && [[ ! -f $site/fonts/OFL.txt ]]; then
  problem "site/fonts has fonts without their licence (OFL.txt)"
fi

# Every link of the search index.
while IFS= read -r url; do
  follow "$site/index.html" "$url" "docs/search-index.json"
done < <(grep -o '"u":"[^"]*"' "$site/docs/search-index.json" | sed 's/^"u":"\(.*\)"$/\1/')
[[ $(grep -c '"u":' "$site/docs/search-index.json") -gt 0 ]] || problem "docs/search-index.json has no sections"

# Every theme Nova has: a block of themes.css and a button of the picker on
# every page.
palette_count=$(find "$here/theme/palettes" -mindepth 2 -maxdepth 2 -name colors.toml | wc -l)
((${#themes[@]} == palette_count)) || problem "themes.css has ${#themes[@]} themes of the $palette_count in theme/palettes"
while IFS= read -r page; do
  for name in "${themes[@]}"; do
    grep -qF "data-theme=\"$name\"><span class=\"swatch\"" "$page" ||
      problem "${source[$page]:-${page#"$site"/}}: the theme picker has no $name"
  done
done < <(find "$site" -name index.html | sort)

if ((failed)); then
  echo "build-site: the site was not built" >&2
  exit 1
fi

# ------------------------------------------------------------------ write

# Only an earlier build, or an empty folder, is replaced: one holding anything
# else, a link, or a file, is left as it is.
if [[ -e $out || -L $out ]]; then
  [[ -d $out && ! -L $out ]] || { echo "build-site: $out is not a folder" >&2; exit 1; }
  if [[ ! -f $out/.nova-site || -L $out/.nova-site ]] && [[ -n $(find "$out" -mindepth 1 -maxdepth 1 -print -quit) ]]; then
    echo "build-site: $out holds files no build made; remove them or name another --out" >&2
    exit 1
  fi
  rm -rf "$out"
fi
echo "made by tools/build-site: it replaces this folder" >"$site/.nova-site"
mkdir -p "$(dirname "$out")"
cp -r "$site" "$out"
echo "build-site: $out: the landing page, ${#pages[@]} docs and ${#themes[@]} themes"
