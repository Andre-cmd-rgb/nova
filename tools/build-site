# ------------------------------------------------------------------ check

# A link from a page of the site, followed as a browser would: to a file the
# site has (a folder is its index.html), and to an id in it. Prints the
# problem, if any.
follow() { # <page> <url> <from>
  local page=$1 url=$2 from=$3 path frag='' target
  path=${url%%#*}
  [[ $url == *#* ]] && frag=${url#*#}
  if [[ -z $path ]]; then
    target=$page
  else
    target=$(realpath -m "$(dirname "$page")/$path")
    [[ -d $target ]] && target=$target/index.html
  fi
  if [[ $target != "$site"/* || ! -f $target ]]; then
    problem "$from: $url is no page or picture of the site"
  elif [[ -n $frag ]] && ! grep -qF " id=\"$frag\"" "$target"; then
    problem "$from: $url: ${source[$target]:-${target#"$site"/}} has no heading or id $frag"
  fi
}

# Every link and picture on every page of the site.
while IFS= read -r page; do
  from=${source[$page]:-${page#"$site"/}}
  while IFS= read -r url; do
    [[ $url == *:* || $url == '#' ]] && continue # https:, mailto:
    follow "$page" "$url" "$from"
  done < <(grep -oE ' (href|src|srcset|data-wall-webp|data-wall-jpg|data-thumb|data-light)="[^"]*"' "$page" | sed -E 's/^ [a-z-]+="(.*)"$/\1/')
  # Every picture with its size, so the page does not move as it comes.
  while IFS= read -r tag; do
    [[ $tag == *' width="'[0-9]* && $tag == *' height="'[0-9]* ]] || problem "$from: a picture without its width and height: $tag"
  done < <(grep -o '<img [^>]*>' "$page")
  # Nothing fetched from another site: no script, style, picture, font or
  # frame of one.
  while IFS= read -r tag; do
    problem "$from: loads from another site: $tag"
  done < <(grep -oE '<(script|img|link|iframe|source|video|audio|embed|object|track)[^>]*>' "$page" |
    grep -E ' (src|href|srcset|poster|data)="([A-Za-z][A-Za-z0-9+.-]*:|//)' || true)
  while IFS= read -r url; do
    problem "$from: a style loads from another site: $url"
  done < <(grep -oE 'url\([^)]*\)' "$page" | grep -vE '^url\((["'\'']?)data:' | grep -E '^url\((["'\'']?)([A-Za-z][A-Za-z0-9+.-]*:|//)' || true)
