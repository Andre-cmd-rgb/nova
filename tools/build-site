# The search index: a section of a page a row, its link from the site's
# root, its page's title, its heading and its text.
for name in "${pages[@]}"; do
  if [[ $name == README ]]; then url=docs/; else url=docs/$name/; fi
  gawk -F '\t' -v url="$url" -v page="$(label_of "$name")" 'BEGIN { OFS = "\t" } { print url ($1 == "" ? "" : "#" $1), page, $2, $3 }' "$work/rendered/$name/sections"
done | gawk -F '\t' '
  function json(s) {
