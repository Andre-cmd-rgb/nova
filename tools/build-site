}

# The docs' list, by group, from a page of them.
sidebar() { # <current page>
  local group name
  for group in "${groups[@]}"; do
    printf '<p class="nav-group">%s</p>\n' "${group%%|*}"
    for name in ${group#*|}; do
      printf '<a href="%s"%s>%s</a>\n' "$(href_of "$name" "$1")" "$([[ $name == "$1" ]] && echo ' aria-current="page"')" "$(label_of "$name")"
    done
  done
}

# The page's headings, as links, when it has more than one.
headings() { # <page> <class>
  local toc=$work/rendered/$1/toc
  (($(wc -l <"$toc") > 1)) || return 0
  printf '<nav class="%s" aria-label="On this page">\n' "$2"
  [[ $2 == toc ]] && printf '<p class="nav-group">On this page</p>\n' || printf '<details><summary>On this page</summary>\n'
  gawk -F '\t' '{ gsub(/&/, "\\&amp;", $3); gsub(/</, "\\&lt;", $3); printf "<a class=\"level-%s\" href=\"#%s\">%s</a>\n", $1, $2, $3 }' "$toc"
  [[ $2 == toc ]] || printf '</details>\n'
  printf '</nav>\n'
}

# The pages before and after it, in the list's order.
pager() { # <index of the page>
  local i=$1 name=${pages[$1]}
  printf '<nav class="pager" aria-label="Pages">\n'
  if ((i > 0)); then
    printf '<a class="prev" href="%s" rel="prev"><span>Previous</span>%s</a>\n' "$(href_of "${pages[i - 1]}" "$name")" "$(label_of "${pages[i - 1]}")"
  fi
  if ((i + 1 < ${#pages[@]})); then
    printf '<a class="next" href="%s" rel="next"><span>Next</span>%s</a>\n' "$(href_of "${pages[i + 1]}" "$name")" "$(label_of "${pages[i + 1]}")"
  fi
  printf '</nav>\n'
}

declare -A source=(["$site/index.html"]=site/index.html)
for i in "${!pages[@]}"; do
