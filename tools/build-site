#!/bin/bash
# build-site: Nova's site as GitHub Pages publishes it (.github/workflows/pages.yml):
# the landing page (site/) with the pictures it shows, and a page for each of
# the user docs, in the landing page's look.
#
#   tools/build-site [--out <dir>]
#
# The site goes to _site unless --out names another folder. One already there
# is replaced only when it is empty or an earlier build (it holds the mark a
# build leaves, .nova-site); anything else is left and the build fails.
#
# The docs are rendered by cmark-gfm, as GitHub renders them (tables,
# autolinks, strikethrough, their own HTML), and their headings get GitHub's
# ids, so a link to page.md#heading works on both. A link between two rendered
# docs becomes one between their pages, a picture (images/...) is copied from
# docs/images and given its width and height, and anything else in the
# repository (the maintainer docs, src/) is linked on GitHub. Each page gets
# the list of its headings, the pages before and after it, and its part of the
# search index (docs/search-index.json).
#
# What is made from the rest of the repository, so that it cannot drift:
#   themes.css      every theme's colors, from theme/palettes/*/colors.toml as
#                   Nova derives them (src/theme/src/palette.rs). The adaptive
#                   theme's are those of the photo the page opens on
#                   (site/wallpapers/matterhorn{,.light}.colors.toml), with a
#                   block for each other photo (site/wallpapers/*.colors.toml),
#                   so that a photo picked puts the page in Nova's real palette
#                   for it, and the colors of the text set on each photo.
#                   Text colors too faint on a theme's surfaces are blended
#                   toward its text until they read (4.5:1, WCAG AA).
#   menu-model.js   the menu's own code (src/shell/plugins/menu/MenuModel.js,
#                   src/shell/plugins/calculator/Calculator.js) and its entries
#                   (data/defaults/menu.jsonc), which the landing page's
#                   Super+Space runs (site/playground.js).
#   the photos      on the landing page (the list below): each a link to Nova
#                   over it (images/desktop-<name>.jpg, the first one's
#                   desktop.jpg, and desktop-<name>-light.jpg in light mode)
#                   that the page's script makes a choice, what is open on
#                   that desktop, its palette as `nova theme palette` gives
#                   it, and its line on the credits page (credits/, from
#                   site/wallpapers/CREDITS.md).
#   the theme picker on every page, and the theme pictures.
#
# The build fails, and leaves the folder as it was, when a link to a page of
# the site or to its #anchor leads nowhere (the search index's and the
# stylesheets' url()s too), when a picture is missing or has no size, when a
# link into the repository names a file it does not have, when a page would
# load anything from another site or run a script of its own (inline, an
# on...= handler, a javascript: link) rather than one of the site's files,
# when a theme is left out or its text does not read on it, when a photo has
# no palette or credit line, or when the menu's code lacks a function the
# playground runs.

set -euo pipefail
# GitHub's heading ids keep the letters beyond ASCII, and so does this.
export LC_ALL=C.UTF-8

usage() { sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; }

here=$(cd "$(dirname "$0")/.." && pwd)
out=_site
while (($# > 0)); do
  case $1 in
    --out) out=${2:?}; shift 2 ;;
    -h | --help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
# A trailing / would have a link to a folder read as the folder.
while [[ $out == */ && $out != / ]]; do out=${out%/}; done
case $out in
  / | . | .. | */. | */..) echo "build-site: --out $out is no folder to replace: name one of its own" >&2; exit 2 ;;
esac
for tool in cmark-gfm gawk; do
  command -v "$tool" >/dev/null || { echo "build-site: needs $tool (Arch: pacman -S $tool)" >&2; exit 1; }
done

# The docs rendered, in groups, in the order of the docs' list beside each
# page; README.md, their index, is docs/ and the others docs/<name>/. The
# maintainer docs stay on GitHub; a doc in neither list fails the build, so a
# new one is not left out unnoticed.
groups=(
  "Start|README install using keys"
  "Everyday|updates apps themes airdrop iphone"
  "Your computer|hardware power patches"
)
pages=()
for group in "${groups[@]}"; do
  read -ra names <<<"${group#*|}"
  pages+=("${names[@]}")
done
github_only=(ARCHITECTURE packaging releasing)
github=https://github.com/Andre-cmd-rgb/nova

# What the landing page's Super+Space runs of the menu's code: each must be a
# function there, or the playground would break unseen.
menu_functions=(readMenuFile catalogOf appItems withApps providerItems withFilled menuRows searchRows answerRows listHeight resolve pathOf noAnswers)
calculator_functions=(expression answer)

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
work=$(cd "$work" && pwd -P) # as realpath gives the pages below
site=$work/site
mkdir -p "$site/images" "$work/rendered"
failed=0
problem() { echo "build-site: $*" >&2; failed=1; }

for doc in "$here"/docs/*.md; do
  name=$(basename "$doc" .md)
  [[ " ${pages[*]} ${github_only[*]} " == *" $name "* ]] ||
    problem "docs/$name.md is in neither list at the top of tools/build-site: a page of the site, or a maintainer doc"
done

# ------------------------------------------------------------ the pictures

# A picture's width and height, from its own header: a JPEG's frame, a PNG's
# IHDR, an SVG's width and height or viewBox. Nothing for one it cannot read.
picture_size() { # <file>
  case $1 in
    *.jpg | *.jpeg)
      od -An -v -tu1 -N 131072 "$1" | gawk '
        { for (i = 1; i <= NF; i++) b[n++] = $i }
        END {
          if (b[0] != 255 || b[1] != 216) exit 1
          for (i = 2; i + 8 < n; i += 2 + b[i + 2] * 256 + b[i + 3]) {
            if (b[i] != 255) exit 1
            m = b[i + 1]
            if (m >= 192 && m <= 207 && m != 196 && m != 200 && m != 204) {
              print b[i + 7] * 256 + b[i + 8], b[i + 5] * 256 + b[i + 6]
              exit 0
            }
          }
          exit 1
        }' ;;
    *.png)
      od -An -v -tu1 -j 16 -N 8 "$1" | gawk '{ print ($1 * 16777216 + $2 * 65536 + $3 * 256 + $4), ($5 * 16777216 + $6 * 65536 + $7 * 256 + $8) }' ;;
    *.svg)
      head -c 4096 "$1" | tr '\n' ' ' | gawk '{
        if (match($0, /<svg[^>]*>/)) tag = substr($0, RSTART, RLENGTH); else exit 1
        if (match(tag, / width="[0-9.]+"/) && match(tag, / height="[0-9.]+"/)) {
          match(tag, / width="[0-9.]+"/); w = substr(tag, RSTART + 8, RLENGTH - 9)
          match(tag, / height="[0-9.]+"/); h = substr(tag, RSTART + 9, RLENGTH - 10)
          print int(w + 0.5), int(h + 0.5); exit 0
        }
        if (match(tag, /viewBox="[^"]*"/)) {
          split(substr(tag, RSTART + 9, RLENGTH - 10), v, /[ ,]+/)
          print int(v[3] + 0.5), int(v[4] + 0.5); exit 0
        }
        exit 1
      }' ;;
    *) return 1 ;;
  esac
}

: >"$work/sizes"
for picture in "$here"/docs/images/*; do
  case $picture in *.jpg | *.jpeg | *.png | *.svg) ;; *) continue ;; esac
  if size=$(picture_size "$picture") && [[ $size =~ ^[1-9][0-9]*\ [1-9][0-9]*$ ]]; then
    echo "images/${picture##*/} $size" >>"$work/sizes"
  else
    problem "docs/images/${picture##*/}: its width and height cannot be read"
  fi
done

# ---------------------------------------------------------------- themes

# Every theme's colors as the site uses them, from its palette, derived the
# way Nova derives what a palette leaves out (src/theme/src/palette.rs). Each
# theme is a [data-theme] block of themes.css, and a line of $work/themes:
# name, label, background, accent. A text color that does not read on every
# surface of its theme (4.5:1; the focus ring 3:1) is blended toward the
# theme's text until it does; one that cannot fails the build.
read -r -d '' palettes <<'AWK' || true
function hex(c) { return c ~ /^#[0-9a-fA-F]{6}$/ }
function channel(c, i) { return strtonum("0x" substr(c, 2 + 2 * i, 2)) }
function mix(a, b, t,   i, r) {
  if (!hex(a) || !hex(b)) return a
  r = "#"
  for (i = 0; i < 3; i++) r = r sprintf("%02x", int(channel(a, i) * (1 - t) + channel(b, i) * t + 0.5))
  return r
}
function luminance(c,   i, v, s) {
  s = 0
  for (i = 0; i < 3; i++) {
    v = channel(c, i) / 255
    v = v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ^ 2.4
    s += (i == 0 ? 0.2126 : i == 1 ? 0.7152 : 0.0722) * v
  }
  return s
}
function contrast(a, b,   x, y) {
  x = luminance(a); y = luminance(b)
  return x > y ? (x + 0.05) / (y + 0.05) : (y + 0.05) / (x + 0.05)
}
# The lowest contrast of <c> on the surfaces <on> (the palette's keys).
function worst(c, on,   i, n, s, r, k) {
  r = 100
  n = split(on, s, " ")
  for (i = 1; i <= n; i++) { k = contrast(c, v[s[i]]); if (k < r) r = k }
  return r
}
# <c>, or <c> blended toward <toward> by the least step that reads at
# <ratio> on the surfaces <on>.
function legible(c, ratio, on, toward,   t, m) {
  for (t = 0; t <= 1.0001; t += 0.05) { m = mix(c, toward, t); if (worst(m, on) >= ratio) return m }
  return toward
}
function check(what, c, ratio, on) {
  if (worst(c, on) < ratio) {
    printf "build-site: theme %s: %s reads at %.2f:1 on %s, below %.1f:1\n", theme, what, worst(c, on), on, ratio > "/dev/stderr"
    bad = 1
  }
}
# A wallpaper's palette as `nova theme palette` gave it, a line of <walls>
# for the landing page to show: name, mode, then its colors.
function wallrow(name,   n, raw, i) {
  printf "%s\t%s", name, v["mode"] > walls
  n = split("background lighter_background foreground accent red yellow green cyan blue magenta", raw, " ")
  for (i = 1; i <= n; i++) printf "\t%s", v[raw[i]] > walls
  printf "\n" > walls
}
function fallback(key, value) { if (!(key in v)) v[key] = value }
function trim(s) { gsub(/^[ \t]+|[ \t\r]+$/, "", s); return s }
FNR == 1 { delete v }
{
  eq = index($0, "=")
  if (!eq) next
  key = trim(substr($0, 1, eq - 1)); gsub(/^["']|["']$/, "", key)
  if (key ~ /^#/ || key !~ /^[A-Za-z0-9_-]+$/) next
  value = trim(substr($0, eq + 1))
  if (value ~ /^["']/) { value = substr(value, 2); sub(/["'].*/, "", value) }
  else if (split(value, word, /[ \t]+/) && hex(word[1])) value = word[1]
  else if (word[1] ~ /^#./) next
  else { sub(/#.*/, "", value); gsub(/[ \t]/, "", value) }
  if (value != "") v[key] = value
}
ENDFILE {
  fallback("background", "#000000"); fallback("foreground", "#ffffff")
  fallback("light_foreground", v["foreground"])
  fallback("dark_foreground", mix(v["foreground"], v["background"], 0.4))
  fallback("muted", v["dark_foreground"])
  fallback("accent", ("blue" in v) ? v["blue"] : v["foreground"])
  fallback("selection", mix(v["background"], v["foreground"], 0.25))
  fallback("dark_background", mix(v["background"], "#000000", 0.25))
  fallback("lighter_background", mix(v["background"], v["foreground"], 0.15))
  split("red yellow green cyan blue magenta", hue, " ")
  for (i = 1; i <= 6; i++) fallback(hue[i], v["foreground"])
  fallback("orange", v["yellow"])
  fallback("selection_foreground", ("bright_foreground" in v) ? v["bright_foreground"] : v["foreground"])
  if (v["mode"] != "light" && v["mode"] != "dark")
    v["mode"] = channel(v["background"], 0) + channel(v["background"], 1) + channel(v["background"], 2) > 382 ? "light" : "dark"
  split("background dark_background lighter_background selection selection_foreground foreground light_foreground muted accent red orange yellow green cyan blue magenta", used, " ")
  for (i in used) if (!hex(v[used[i]])) {
    printf "build-site: %s: %s is %s, where the site needs a #rrggbb color\n", FILENAME, used[i], v[used[i]] > "/dev/stderr"
    bad = 1
    v[used[i]] = "#808080"
  }
  # The page is the background, its panels the darker one; code and keys
  # stand on the lighter one, a row picked on the selection, in the
  # selection's own text (Miasma's is dark on moss).
  page = "background dark_background"
  fg = v["foreground"]
  out["bg"] = v["background"]; out["bg-deep"] = v["dark_background"]
  out["bg-raised"] = v["lighter_background"]; out["sel"] = v["selection"]
  out["fg"] = fg
  out["fg-soft"] = legible(v["light_foreground"], 4.5, page, fg)
  out["muted"] = legible(v["muted"], 4.5, page, fg)
  out["sel-fg"] = v["selection_foreground"]
  # A selection its text does not read on (Miasma's, dark on moss) is blended
  # toward whichever of the text and the background its text reads on best.
  if (contrast(out["sel-fg"], out["sel"]) < 4.5) {
    toward = contrast(out["sel-fg"], fg) > contrast(out["sel-fg"], v["background"]) ? fg : v["background"]
    for (t = 0.05; t <= 1.0001 && contrast(out["sel-fg"], out["sel"]) < 4.5; t += 0.05) out["sel"] = mix(v["selection"], toward, t)
  }
  out["line"] = mix(v["background"], fg, 0.14)
  out["edge"] = legible(mix(v["background"], fg, 0.4), 3, page, fg)
  out["accent"] = v["accent"]
  out["link"] = legible(v["accent"], 4.5, page, fg)
  out["focus"] = legible(v["accent"], 3, page, fg)
  # The terminal's colors, on the background, as the terminal shows them.
  split("red orange yellow green cyan blue magenta", hue, " ")
  for (i = 1; i <= 7; i++) out[hue[i]] = legible(v[hue[i]], 4.5, "background", fg)
  check("the text", fg, 4.5, "background dark_background lighter_background")
  if (contrast(out["sel-fg"], out["sel"]) < 4.5) {
    printf "build-site: theme %s: a row picked reads at %.2f:1, below 4.5:1\n", theme, contrast(out["sel-fg"], out["sel"]) > "/dev/stderr"
    bad = 1
  }
  check("the accent's text", out["link"], 4.5, page)
  check("the focus ring", out["focus"], 3, page)
  # The button's text on its accent: the background, which reads on the
  # accent as the accent reads on it.
  if (contrast(out["bg"], out["link"]) < 4.5) {
    printf "build-site: theme %s: a button's text reads at %.2f:1 on its accent\n", theme, contrast(out["bg"], out["link"]) > "/dev/stderr"
    bad = 1
  }
  block = sprintf("color-scheme:%s;", v["mode"])
  n = split("bg bg-deep bg-raised sel sel-fg fg fg-soft muted line edge accent link focus red orange yellow green cyan blue magenta", order, " ")
  for (i = 1; i <= n; i++) block = block sprintf("--%s:%s;", order[i], out[order[i]])
  if (theme == "adaptive") print ":root,[data-theme=\"adaptive\"]{" block "}" > css
  else if (theme == "adaptive-light") {
    print "@media (prefers-color-scheme: light){:root,[data-theme=\"adaptive\"]{" block "}}" > css
    # The opening photo picked again keeps the light palette it opened with.
    light_block = block
    wallrow(opening ".light")
  }
  else if (index(theme, "wall:") == 1) {
    # A wallpaper: the page's colors while it is picked, and the text and
    # shade over the photo itself (its own palette's, whatever the theme).
    wname = substr(theme, 6)
    print ":root[data-theme=\"adaptive\"][data-wallpaper=\"" wname "\"]{" block "}" > css
    photo = sprintf("--photo-bg:%s;--photo-fg:%s;--photo-accent:%s;", out["bg"], fg, out["link"])
    if (wname == opening) {
      print ":root{" photo "}" > css
      if (light_block != "") print "@media (prefers-color-scheme: light){:root[data-theme=\"adaptive\"][data-wallpaper=\"" wname "\"]{" light_block "}}" > css
    }
    print ":root[data-wallpaper=\"" wname "\"]{" photo "}" > css
    wallrow(wname)
  }
  else print "[data-theme=\"" theme "\"]{" block "}" > css
  if (theme != "adaptive-light" && index(theme, "wall:") != 1) {
    n = split(theme, part, "-"); label = ""
    for (i = 1; i <= n; i++) label = label (i > 1 ? " " : "") toupper(substr(part[i], 1, 1)) substr(part[i], 2)
    printf "%s\t%s\t%s\t%s\n", theme, label, out["bg"], out["accent"] > list
  }
}
END { exit bad }
AWK

# The photographs of site/wallpapers, in the order the landing page shows
# them: name|label|what it shows (its picture's alt text)|what is open on
# Nova's desktop over it, as tools/screenshots takes it (its scene there
# says the same). The first is the one the page opens on, its adaptive theme
# the site's. A photo not listed here is shown after these, under its file's
# name.
wallpaper_catalog=(
  "matterhorn|Matterhorn|Snowy mountains under a pink dusk sky|a terminal and Settings at Appearance"
  "aurora|Aurora|Green polar lights over dark trees|the Calendar's week"
  "forest|Forest|An evergreen forest in fog|the menu"
  "dunes|Dunes|Desert dunes under a low sun|the App Center"
  "coast|Coast|A chalk cliff over a pebble beach, in mist|nothing open"
  "harbour|Harbour|A city's lights across the water at night|the background picker, with the photos in it"
  "peaks|Peaks|Snowy peaks among clouds|Quick Look on a photo"
  "canyon|Canyon|A beam of light in a sandstone slot canyon|the Calculator"
)
default_wall=${wallpaper_catalog[0]%%|*}

theme_files=()
# By name, as Settings lists them: catppuccin before catppuccin-latte.
while IFS= read -r name; do
  palette=$here/theme/palettes/$name/colors.toml
  [[ -f $palette ]] || continue
  case $name in
    adaptive)
      # The site's adaptive theme is the opening photo's, dark or light as
      # the visitor's system prefers.
      for mode in "" .light; do
        [[ -f $here/site/wallpapers/$default_wall$mode.colors.toml ]] ||
          problem "site/wallpapers/$default_wall$mode.colors.toml is not there: tools/site-palettes writes it"
      done
      theme_files+=("theme=adaptive" "$here/site/wallpapers/$default_wall.colors.toml"
        "theme=adaptive-light" "$here/site/wallpapers/$default_wall.light.colors.toml")
      ;;
    *[!a-z0-9-]* | '') problem "theme/palettes/$name: a theme's name is lowercase letters, digits and dashes" ;;
    *) theme_files+=("theme=$name" "$palette") ;;
  esac
done < <(find "$here/theme/palettes" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort)

# Every wallpaper's real adaptive palette (from `nova theme palette`), verified
# for WCAG AA contrast by the same AWK pass and emitted as
# [data-theme="adaptive"][data-wallpaper="<slug>"].
declare -A wall_label=() wall_scene=() wall_open=()
for entry in "${wallpaper_catalog[@]}"; do
  IFS='|' read -r wslug wlbl wsc wopen <<<"$entry"
  wall_label[$wslug]=$wlbl
  wall_scene[$wslug]=$wsc
  wall_open[$wslug]=$wopen
done
wallpaper_slugs=()
if [[ -d $here/site/wallpapers ]]; then
  # Keep the showcase catalog order first, then any extra wallpapers sorted.
  for entry in "${wallpaper_catalog[@]}"; do
    wslug=${entry%%|*}
    [[ -f $here/site/wallpapers/$wslug.jpg ]] && wallpaper_slugs+=("$wslug")
  done
  while IFS= read -r wp; do
    wslug=$(basename "$wp" .jpg)
    [[ " ${wallpaper_slugs[*]} " == *" $wslug "* ]] || wallpaper_slugs+=("$wslug")
  done < <(find "$here/site/wallpapers" -maxdepth 1 -name '*.jpg' | sort)
  for wslug in "${wallpaper_slugs[@]}"; do
    if [[ -f $here/site/wallpapers/$wslug.colors.toml ]]; then
      theme_files+=("theme=wall:$wslug" "$here/site/wallpapers/$wslug.colors.toml")
    else
      problem "site/wallpapers/$wslug.colors.toml is missing: run tools/site-palettes"
    fi
    for req in "$wslug.webp" "thumbs/$wslug.webp" "thumbs/$wslug.jpg"; do
      [[ -f $here/site/wallpapers/$req ]] || problem "site/wallpapers/$req is missing for wallpaper $wslug"
    done
    if [[ ! -f $here/site/wallpapers/CREDITS.md ]] ||
      ! grep -qE "^\|[[:space:]]*\`${wslug}\`[[:space:]]*\|.*https://" "$here/site/wallpapers/CREDITS.md"; then
      problem "site/wallpapers/CREDITS.md has no credit line with source URL for wallpaper $wslug"
    fi
  done
fi

{
  echo "/* Every theme's colors, made by tools/build-site from theme/palettes/*/colors.toml"
  echo "   and site/wallpapers/*.colors.toml: edit those, not this. */"
} >"$site/themes.css"
: >"$work/walls"
gawk -v css="$site/themes.css" -v list="$work/themes" -v walls="$work/walls" -v opening="$default_wall" "$palettes" "${theme_files[@]}" || failed=1
themes=()
while IFS=$'\t' read -r name _; do themes+=("$name"); done <"$work/themes"

# The theme picker, on every page: a radio button a theme, its swatch in the
# theme's own background and accent.
while IFS=$'\t' read -r name label bg accent; do
  printf '<button type="button" role="radio" aria-checked="false" data-theme="%s"><span class="swatch" style="--swatch-bg:%s;--swatch-accent:%s" aria-hidden="true"></span>%s</button>\n' \
    "$name" "$bg" "$accent" "$label"
done <"$work/themes" >"$work/picker.html"

# The landing page's photos, each a link to Nova's desktop over it (what it
# shows with JavaScript off); site.js makes them the buttons that put Nova and
# the page in that photo's adaptive theme. Each carries the palette `nova theme
# palette` gave for it, in the order of the swatches below, and what is open
# on Nova's desktop over it; the opening photo also its light palette, which
# the page wears on a light system, and Nova in that light mode.
palette_names=(Background Surface Text Accent Red Yellow Green Cyan Blue Magenta)
declare -A wall_line=()
while IFS=$'\t' read -r wslug rest; do wall_line[$wslug]=$rest; done <"$work/walls"
for wslug in "${wallpaper_slugs[@]}"; do
  [[ -n ${wall_line[$wslug]:-} ]] || continue
  read -r wmode colors <<<"${wall_line[$wslug]//$'\t'/ }"
  wlbl=${wall_label[$wslug]:-$wslug}
  wsc=${wall_scene[$wslug]:-$wlbl}
  shot=images/desktop-$wslug.jpg
  [[ $wslug == "$default_wall" ]] && shot=images/desktop.jpg
  more=''
  if [[ -n ${wall_line[$wslug.light]:-} ]]; then
    read -r _ lcolors <<<"${wall_line[$wslug.light]//$'\t'/ }"
    more=" data-palette-light=\"$lcolors\""
    # Nova in that light mode, where tools/screenshots has taken it.
    [[ ! -f $here/site/images/desktop-$wslug-light.jpg ]] || more+=" data-light=\"images/desktop-$wslug-light.jpg\""
  fi
  wopen=${wall_open[$wslug]:-}
  [[ -z $wopen ]] || more+=" data-open=\"$wopen\""
  printf '<a class="wall" href="%s" data-wallpaper="%s" data-label="%s" data-scene="%s" data-mode="%s" data-palette="%s"%s data-wall-webp="wallpapers/%s.webp" data-wall-jpg="wallpapers/%s.jpg" data-thumb="wallpapers/thumbs/%s.jpg">' \
    "$shot" "$wslug" "$wlbl" "$wsc" "$wmode" "$colors" "$more" "$wslug" "$wslug" "$wslug"
  printf '<picture><source srcset="wallpapers/thumbs/%s.webp" type="image/webp"><img src="wallpapers/thumbs/%s.jpg" width="360" height="225" loading="lazy" alt="%s"></picture><span>%s</span></a>\n' \
    "$wslug" "$wslug" "$wsc" "$wlbl"
done >"$work/wallpapers.html"
[[ -s $work/wallpapers.html ]] || problem "site/wallpapers has no photo with its palette for the landing page"

# The opening photo's palette, as the page shows it before one is picked: a
