#!/bin/bash
# build-site: Nova's site as GitHub Pages publishes it (.github/workflows/pages.yml):
# the landing page (site/) with the pictures it shows, and a page for each of
# the user docs, in the landing page's look.
#
#   tools/build-site [--out <dir>]
#
# The site goes to _site unless --out names another folder. One already there
# is replaced only when it is empty or an earlier build (it holds the mark a
# build leaves, .nova-site); anything else is left and the build fails.
#
# The docs are rendered by cmark-gfm, as GitHub renders them (tables,
# autolinks, strikethrough, their own HTML), and their headings get GitHub's
# ids, so a link to page.md#heading works on both. A link between two rendered
# docs becomes one between their pages, a picture (images/...) is copied from
# docs/images, and anything else in the repository (the maintainer docs, src/)
# is linked on GitHub. The build fails, and leaves the folder as it was, when a
# link to a page of the site or to its #anchor leads nowhere, when a picture is
# missing, or when a link into the repository names a file it does not have.

set -euo pipefail
# GitHub's heading ids keep the letters beyond ASCII, and so does this.
export LC_ALL=C.UTF-8

usage() { sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; }

here=$(cd "$(dirname "$0")/.." && pwd)
out=_site
while (($# > 0)); do
  case $1 in
    --out) out=${2:?}; shift 2 ;;
    -h | --help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
# A trailing / would have a link to a folder read as the folder.
while [[ $out == */ && $out != / ]]; do out=${out%/}; done
case $out in
  / | . | .. | */. | */..) echo "build-site: --out $out is no folder to replace: name one of its own" >&2; exit 2 ;;
esac
for tool in cmark-gfm gawk; do
  command -v "$tool" >/dev/null || { echo "build-site: needs $tool (Arch: pacman -S $tool)" >&2; exit 1; }
done

# The docs rendered, in the order of the docs' list beside each page; README.md,
# their index, is docs/ and the others docs/<name>/. The maintainer docs stay on
# GitHub; a doc in neither list fails the build, so a new one is not left out
# unnoticed.
pages=(README install using updates apps themes airdrop iphone hardware patches power)
github_only=(ARCHITECTURE packaging releasing)
github=https://github.com/Andre-cmd-rgb/nova

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
work=$(cd "$work" && pwd -P) # as realpath gives the pages below
site=$work/site
mkdir -p "$site/images" "$work/rendered"
failed=0
problem() { echo "build-site: $*" >&2; failed=1; }

for doc in "$here"/docs/*.md; do
  name=$(basename "$doc" .md)
  [[ " ${pages[*]} ${github_only[*]} " == *" $name "* ]] ||
    problem "docs/$name.md is in neither list at the top of tools/build-site: a page of the site, or a maintainer doc"
done

# ------------------------------------------------------------- landing page

cp -r "$here"/site/* "$site/"
landing=$here/site/index.html
# The landing page's pictures, and the theme picker's corner of each theme it
# offers (site.js swaps them in), from the docs' own.
for name in $(grep -oh 'images/[a-z0-9-]*\.[a-z]*' "$landing" | sort -u) \
  $(grep -o 'data-theme="[a-z-]*"' "$landing" | sed 's/.*="\(.*\)"/images\/corner-\1.jpg/' | sort -u); do
  if [[ -f $here/docs/$name ]]; then
    cp "$here/docs/$name" "$site/$name"
  else
    problem "site/index.html shows $name, which docs/ does not have: tools/screenshots makes it"
  fi
done

# What a docs page takes from the landing page: the theme script in its head
# (the theme picked there, before the page is drawn), the wordmark, the header
# and the footer.
part() { # <sed address range> <what>
  local text
  text=$(sed -n "$1p" "$landing")
  [[ -n $text ]] || { echo "build-site: site/index.html has no $2" >&2; exit 1; }
  printf '%s\n' "$text"
}
theme_color=$(part '/<meta name="theme-color"/' 'theme-color meta')
theme_script=$(part '/^<script>.*localStorage/' 'theme script in its <head>')
wordmark=$(part '/<svg width="0"/,/<\/svg>/' 'wordmark symbol')
header=$(part '/<header class="top">/,/<\/header>/' '<header class="top">')
footer=$(part '/<footer>/,/<\/footer>/' '<footer>')
# The landing page's own links (#tour, docs/), from a page <root> below it.
relocate() { # <root>
  sed -E -e 's,(<a [^>]*href=")(#[^"]*|[^"#:]+)",\1'"$1"'\2",g' -e 's,(<a [^>]*href=")'"$1"'#",\1'"$1"'",g'
}

# ------------------------------------------------------------------- docs

# A rendered doc, made the site's: headings with GitHub's ids, links between
# docs made links between pages, pictures and the repository linked as above,
# tables in a box that scrolls on a narrow screen. Its title (the # heading)
# and first paragraph go to the files named.
read -r -d '' finish <<'AWK' || true
function slug(html,   s) {
  s = html
  gsub(/<[^>]*>/, "", s)
  gsub(/&quot;/, "\"", s); gsub(/&lt;/, "<", s); gsub(/&gt;/, ">", s); gsub(/&amp;/, "\\&", s)
  s = tolower(s)
  gsub(/[^[:alnum:] _-]/, "", s)
  gsub(/ /, "-", s)
  return s
}
# github-slugger's: the second "foo" is foo-1, the third foo-2.
function unique(s,   r) {
  r = s
  while (r in used) r = s "-" (++count[s])
  used[r] = 1
  return r
}
function in_repo(p,   n, part, i, depth, stack, r) {
  n = split(p, part, "/")
  depth = 0
  for (i = 1; i <= n; i++) {
    if (part[i] == "" || part[i] == ".") continue
    if (part[i] == "..") { if (depth == 0) return ""; depth--; continue }
    stack[++depth] = part[i]
  }
  r = ""
  for (i = 1; i <= depth; i++) r = r (i > 1 ? "/" : "") stack[i]
  return r (p ~ /\/$/ && r != "" ? "/" : "")
}
function rewrite(url,   i, path, frag, name, p) {
  if (url ~ /^[A-Za-z][A-Za-z0-9+.-]*:/ || url ~ /^#/) return url
  i = index(url, "#")
  path = i ? substr(url, 1, i - 1) : url
  frag = i ? substr(url, i) : ""
  if (path ~ /^images\//) { print path > pictures; return root path frag }
  if (path ~ /^[A-Za-z0-9_-]+\.md$/) {
    name = substr(path, 1, length(path) - 3)
    if (name in rendered) return (name == "README" ? (up == "" ? "./" : up) : up name "/") frag
  }
  p = in_repo(path ~ /^\// ? path : "docs/" path)
  if (p == "") {
    printf "build-site: docs/%s.md: %s leads out of the repository\n", self, url > "/dev/stderr"
    bad = 1
    return url
  }
  print p > repo
  return github "/" (p ~ /\/$/ ? "tree" : "blob") "/main/" p frag
}
function relink(line,   done, attr, eq) {
  done = ""
  while (match(line, / (href|src)="[^"]*"/)) {
    attr = substr(line, RSTART, RLENGTH)
    eq = index(attr, "=")
    done = done substr(line, 1, RSTART - 1) substr(attr, 1, eq) "\"" rewrite(substr(attr, eq + 2, RLENGTH - eq - 2)) "\""
    line = substr(line, RSTART + RLENGTH)
  }
  return done line
}
BEGIN { n = split(names, list, " "); for (i = 1; i <= n; i++) rendered[list[i]] = 1 }
NR == 1 && !/^<h1>/ {
  printf "build-site: docs/%s.md does not start with its title, a # heading\n", self > "/dev/stderr"
  bad = 1
}
{ $0 = relink($0) }
/^<h[1-6]>/ {
  level = substr($0, 3, 1)
  close_tag = "</h" level ">"
  if (substr($0, length($0) - 4) != close_tag) {
    printf "build-site: docs/%s.md: a heading over more than one line: %s\n", self, $0 > "/dev/stderr"
    bad = 1
  }
  text = substr($0, 5, length($0) - 9)
  if (NR == 1) { t = text; gsub(/<[^>]*>/, "", t); print t > title }
  $0 = "<h" level " id=\"" unique(slug(text)) "\">" text close_tag
}
/^<p>/ && !described { para = 1 }
para { d = d (d == "" ? "" : " ") $0 }
para && /<\/p>$/ { para = 0; described = 1; gsub(/<[^>]*>/, "", d); print d > description }
{ sub(/^<table>/, "<div class=\"table\"><table>"); sub(/^<\/table>$/, "</table></div>") }
{ print }
END { exit bad }
AWK

for name in "${pages[@]}"; do
  if [[ $name == README ]]; then root=../ up=''; else root=../../ up=../; fi
  r=$work/rendered/$name
  mkdir -p "$r"
  [[ -f $here/docs/$name.md ]] || { problem "docs/$name.md, in the list at the top of tools/build-site, is not there"; continue; }
  : >"$r/pictures"; : >"$r/repo"; : >"$r/description"
  cmark-gfm --unsafe -e table -e autolink -e strikethrough -e tagfilter "$here/docs/$name.md" |
    gawk -v self="$name" -v names="${pages[*]}" -v root="$root" -v up="$up" -v github="$github" \
      -v pictures="$r/pictures" -v repo="$r/repo" -v title="$r/title" -v description="$r/description" \
      "$finish" >"$r/body.html" || failed=1
  while IFS= read -r picture; do
    if [[ -f $here/docs/$picture ]]; then
      cp "$here/docs/$picture" "$site/$picture"
    else
      problem "docs/$name.md shows $picture, which docs/images does not have"
    fi
  done < <(sort -u "$r/pictures")
  while IFS= read -r path; do
    [[ -e $here/${path%/} ]] || problem "docs/$name.md links $path, which the repository does not have"
  done < <(sort -u "$r/repo")
done

# The rest needs every page's title.
for name in "${pages[@]}"; do
  [[ -s $work/rendered/$name/title ]] || { echo "build-site: the site was not built" >&2; exit 1; }
done

# The docs' list, from a page of them: the label is the doc's title up to a
# colon ("Patches: fixes for one computer" is Patches).
sidebar() { # <current page>
  local name href label
  for name in "${pages[@]}"; do
    if [[ $name == README ]]; then href=./; else href=$name/; fi
    [[ $1 == README ]] || href=../${href#./}
    label=$(<"$work/rendered/$name/title")
    printf '<a href="%s"%s>%s</a>\n' "$href" "$([[ $name == "$1" ]] && echo ' aria-current="page"')" "${label%%:*}"
  done
}

declare -A source=(["$site/index.html"]=site/index.html)
for name in "${pages[@]}"; do
  if [[ $name == README ]]; then root=../ dir=$site/docs; else root=../../ dir=$site/docs/$name; fi
  r=$work/rendered/$name
  mkdir -p "$dir"
  source[$dir/index.html]=docs/$name.md
  title=$(<"$r/title")
  description=$(<"$r/description")
  cat >"$dir/index.html" <<EOF
<!doctype html>
<html lang="en" data-theme="adaptive">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>$title · Nova</title>
<meta name="description" content="$description">
$theme_color
$theme_script
<link rel="icon" href="${root}favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="${root}style.css">
</head>
<body>
$wordmark

$(relocate "$root" <<<"$header")

<div class="docs">
<nav class="docs-nav" aria-label="Documentation">
$(sidebar "$name")
</nav>
<main class="doc">
$(<"$r/body.html")
</main>
</div>

$(relocate "$root" <<<"$footer")
<script src="${root}site.js" defer></script>
</body>
</html>
EOF
done

# ------------------------------------------------------------------ check

# Every link and picture on every page of the site, followed as a browser would:
# to a file the site has (a folder is its index.html), and to an id in it.
while IFS= read -r page; do
  from=${source[$page]:-${page#"$site"/}}
  while IFS= read -r url; do
    [[ $url == *:* || $url == '#' ]] && continue # https:, mailto:
    path=${url%%#*} frag=''
    [[ $url == *#* ]] && frag=${url#*#}
    if [[ -z $path ]]; then
      target=$page
    else
      target=$(realpath -m "$(dirname "$page")/$path")
      [[ -d $target ]] && target=$target/index.html
    fi
    if [[ $target != "$site"/* || ! -f $target ]]; then
      problem "$from: $url is no page or picture of the site"
    elif [[ -n $frag ]] && ! grep -qF " id=\"$frag\"" "$target"; then
      problem "$from: $url: ${source[$target]:-${target#"$site"/}} has no heading or id $frag"
    fi
  done < <(grep -o ' \(href\|src\)="[^"]*"' "$page" | sed 's/^ [a-z]*="\(.*\)"$/\1/')
done < <(find "$site" -name '*.html' | sort)

if ((failed)); then
  echo "build-site: the site was not built" >&2
  exit 1
fi

# ------------------------------------------------------------------ write

# Only an earlier build, or an empty folder, is replaced: one holding anything
# else, a link, or a file, is left as it is.
if [[ -e $out || -L $out ]]; then
  [[ -d $out && ! -L $out ]] || { echo "build-site: $out is not a folder" >&2; exit 1; }
  if [[ ! -f $out/.nova-site || -L $out/.nova-site ]] && [[ -n $(find "$out" -mindepth 1 -maxdepth 1 -print -quit) ]]; then
    echo "build-site: $out holds files no build made; remove them or name another --out" >&2
    exit 1
  fi
  rm -rf "$out"
fi
echo "made by tools/build-site: it replaces this folder" >"$site/.nova-site"
mkdir -p "$(dirname "$out")"
cp -r "$site" "$out"
echo "build-site: $out: the landing page and ${#pages[@]} docs"
