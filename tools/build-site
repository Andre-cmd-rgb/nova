# A page with each line that is only <!-- name --> replaced by the file given.
fill() { # <file> <name=file>...
  gawk -v pairs="${*:2}" '
    BEGIN { n = split(pairs, p, " "); for (i = 1; i <= n; i++) { eq = index(p[i], "="); with[substr(p[i], 1, eq - 1)] = substr(p[i], eq + 1) } }
    match($0, /^[ \t]*<!-- [a-z-]+ -->[ \t]*$/) {
      name = $0; gsub(/^[ \t]*<!-- | -->[ \t]*$/, "", name)
