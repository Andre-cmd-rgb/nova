#!/bin/bash
# Prepare an archlinux:base-devel container for CI.
#
#   tools/ci-setup [--date YYYY/MM/DD] [package...]
#
# With --date, pacman moves to that Arch Linux Archive snapshot first (-Syyuu
# goes down as well as up), so a release builds against exactly the snapshot
# its release.toml pins. multilib is turned on, as every Nova system has it.
# Then the packages are installed, and a `builder` user is made (makepkg
# refuses root) that may run anything through sudo, which makepkg --syncdeps
# needs.
set -euo pipefail

die() { printf 'ci-setup: %s\n' "$*" >&2; exit 1; }

((EUID == 0)) || die "run as root, inside the CI container"
if [[ ${1:-} == --date ]]; then
  date=${2:?--date needs YYYY/MM/DD}
  shift 2
  [[ $date =~ ^[0-9]{4}/[0-9]{2}/[0-9]{2}$ ]] || die "bad --date: $date"
  # shellcheck disable=SC2016 # $repo and $arch are pacman's to expand
  printf 'Server = https://archive.archlinux.org/repos/%s/$repo/os/$arch\n' "$date" >/etc/pacman.d/mirrorlist
fi
# multilib, as every Nova system has it (installer/pacman.conf): nova depends
# on steam-devices, which is there.
grep -qx '\[multilib\]' /etc/pacman.conf || printf '\n[multilib]\nInclude = /etc/pacman.d/mirrorlist\n' >>/etc/pacman.conf

pacman-key --init >/dev/null
pacman-key --populate archlinux >/dev/null
# The archive is one server, and it stalls now and then. pacman keeps what it
# fetched, so a second try picks up where the first stopped. A download cut
# off halfway is left as a .part, which pacman would resume, and a mirror that
# cannot resume fails it every time after: those start over.
tries() { # pacman's arguments
  local attempt dir
  for attempt in 1 2 3; do
    pacman "$@" && return 0
    ((attempt < 3)) || die "pacman failed three times"
    echo "ci-setup: pacman failed; trying again in 30 seconds" >&2
    while read -r dir; do rm -f -- "${dir%/}"/*.part; done < <(pacman-conf CacheDir)
    sleep 30
  done
}
# A container newer than the pinned databases can hold packages they do not
# have yet, and going down cannot replace those: on 2026-11-10 openssl 4.1
# brought openssl-3, which owns the libcrypto.so.3 the snapshot's openssl
# 3.6 brings back, and the move down failed on the conflict. They go first,
# without their dependants, which the move down replaces by versions that
# never knew them.
tries -Syy
mapfile -t newer < <(pacman -Qqm)
if ((${#newer[@]})); then
  echo "ci-setup: not in the pinned databases, removed first: ${newer[*]}" >&2
  pacman -Rdd --noconfirm "${newer[@]}"
fi
tries -Suu --noconfirm --needed git sudo "$@"

id builder >/dev/null 2>&1 || useradd -m builder
echo 'builder ALL=(ALL) NOPASSWD: ALL' >/etc/sudoers.d/90-builder
chmod 440 /etc/sudoers.d/90-builder
