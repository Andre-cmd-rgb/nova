#!/bin/bash
# Turn a directory of built packages into the signed [nova] repository that a
# release publishes.
#
#   tools/repo-build --key <fingerprint> <package dir> <out dir>
#
# Every package gets a detached signature, and repo-add writes nova.db and
# nova.files, signed too. A bucket cannot hold symlinks, so the
# nova.db -> nova.db.tar.gz links repo-add makes are replaced by the files
# themselves: pacman asks for nova.db and nova.db.sig by exactly those names.
# A URL can change unusual characters, and the FAT on a nova usb stick refuses
# some, so a package file name outside A-Z a-z 0-9 . _ - (an epoch's ':', a dev
# build's '+') stops the build.
set -euo pipefail

die() { printf 'repo-build: %s\n' "$*" >&2; exit 1; }

key=
while (($#)); do
  case $1 in
    --key) key=${2:?--key needs a fingerprint}; shift 2 ;;
    -h | --help) sed -n '2,/^set /p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
    -*) die "unknown option: $1" ;;
    *) break ;;
  esac
done
(($# == 2)) || die "usage: tools/repo-build --key <fingerprint> <package dir> <out dir>"
[[ -n $key ]] || die "--key is required: the repository is always signed"
pkgdir=$1 out=$2

shopt -s nullglob
pkgs=("$pkgdir"/*.pkg.tar.zst)
((${#pkgs[@]})) || die "no packages in $pkgdir"
mkdir -p -- "$out"
[[ -z $(ls -A -- "$out") ]] || die "$out is not empty"

for pkg in "${pkgs[@]}"; do
  name=${pkg##*/}
  [[ $name =~ ^[A-Za-z0-9._-]+$ ]] || die "$name: a URL or the stick's FAT would change it, and pacman would not find it"
  cp -- "$pkg" "$out/$name"
  gpg --batch --yes --local-user "$key" --detach-sign --no-armor --output "$out/$name.sig" -- "$out/$name"
done

repo-add --quiet --sign --key "$key" "$out/nova.db.tar.gz" "$out"/*.pkg.tar.zst

for db in nova.db nova.files; do
  rm -f -- "$out/$db" "$out/$db.sig"
  mv -- "$out/$db.tar.gz" "$out/$db"
  mv -- "$out/$db.tar.gz.sig" "$out/$db.sig"
done
rm -f -- "$out"/*.old "$out"/*.old.sig

printf 'repo-build: %d packages signed into %s\n' "${#pkgs[@]}" "$out" >&2
