# What the session draws with: Mesa alone, on a card that is not NVIDIA's,
# whatever the environment this runs in says. GLVND loads every EGL vendor
# it finds and the Vulkan loader every driver, and NVIDIA's open the card,
# which wakes it from its sleep; a render node of NVIDIA's would too. A
# render node named by the caller is taken when it is not NVIDIA's.
nvidia_node() { # /dev/dri/renderDN, or a link to one
  local node
  node=$(readlink -f -- "$1")
  [[ $(readlink "/sys/class/drm/${node##*/}/device/driver" 2>/dev/null) == */nvidia ]]
}
egl=''
for vendor in /usr/share/glvnd/egl_vendor.d/*.json; do
  case $vendor in
    *nvidia* | *'*'*) ;;
    *) egl=${egl:+$egl:}$vendor ;;
  esac
done
[[ -n $egl ]] || { echo "screenshots: no EGL vendor but NVIDIA's (Mesa's is needed)" >&2; exit 1; }
render=${WLR_RENDER_DRM_DEVICE:-}
if [[ -z $render ]] || nvidia_node "$render"; then
  render=''
  for node in /dev/dri/renderD*; do
    [[ -e $node ]] && ! nvidia_node "$node" && { render=$node; break; }
  done
fi
[[ -n $render ]] || { echo "screenshots: no render node but NVIDIA's" >&2; exit 1; }
renderer=(WLR_RENDERER="${WLR_RENDERER:-gles2}" WLR_RENDER_DRM_DEVICE="$render" __EGL_VENDOR_LIBRARY_FILENAMES="$egl")
[[ -z ${LD_LIBRARY_PATH:-} ]] || renderer+=("LD_LIBRARY_PATH=$LD_LIBRARY_PATH")
env -i HOME="$work/home" XDG_RUNTIME_DIR="$work/run" LANG=C.UTF-8 TZ="${TZ:-Europe/Rome}" \
  GIO_USE_VFS=local GSETTINGS_BACKEND=memory \
  VK_LOADER_DRIVERS_DISABLE='*nvidia*' __GLX_VENDOR_LIBRARY_NAME=mesa \
  PATH="$work/bin:$root/usr/lib/nova/bin:$root/usr/bin:$PATH" \
  NOVA_PATH="$root/usr/share/nova" NOVA_BIN="$root/usr/lib/nova/bin" NOVA_LOGIN=password \
  BATTERYLIFE_POWER_SUPPLY_DIR="$work/power_supply" NOVA_POWER_SUPPLY="$work/power_supply" \
  NOVA_RFKILL_PATH="$work/rfkill" NOVA_PROC="$work/proc" NOVA_SYS="$work/sys" NOVA_DMI_PATH="$work/dmi" \
  NOVA_REPOFILE="$work/nova-repo" NOVA_MIRRORLIST="$work/nova-mirrorlist" \
  XCURSOR_THEME=Nova XCURSOR_SIZE=24 \
  DBUS_SYSTEM_BUS_ADDRESS=unix:path=/nonexistent/system-bus \
  "${renderer[@]}" WORK="$work" BACKDROP="$backdrop" SHELL_DIR="$root/usr/share/nova/shell" \
