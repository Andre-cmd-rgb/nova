#!/bin/bash
# screenshots: the pictures in the README, docs/ and site/, taken of the shell itself.
#
#   tools/screenshots --root <dir> [--out <dir>] [--background <image>]
#                     [--wallpapers <dir>] [--site-out <dir>] [--version <v>]
#
# --root is a `make install DESTDIR=<dir>` tree; the doc pictures go to
# docs/images unless --out names another folder. --background is the picture
# behind the windows: the photo the site opens on, matterhorn.jpg (from
# --wallpapers, else site/wallpapers), or another JPEG, PNG or SVG named here.
# When --wallpapers <dir> is given (typically site/wallpapers), a single nested
# session captures Nova in its adaptive theme on every JPEG wallpaper in that
# folder into --site-out (default site/images) as desktop-<name>.jpg, each with
# something else open (the Calendar, the App Center, the menu, Quick Look, the
# background picker...), and the opening one in the adaptive theme's light mode
# too as desktop-<name>-light.jpg. It pairs fixed themes with wallpapers that
# suit them, spreads the feature and app pictures across different wallpapers,
# and writes each wallpaper's real adaptive colors.toml from
# `nova theme palette`.
#
# Every picture on a new tree, the docs' and the site's, with each photo's palette:
#
#   make DESTDIR=/tmp/nova-root install
#   tools/screenshots --root /tmp/nova-root --wallpapers site/wallpapers
#
# The shell runs on a Hyprland of its own, given Nova's look, cursor and window
# rules (data/hypr) and the full transparent bar layout (menu and workspaces on
# the left; indicators, clock, keyboard layout, weather and update mark in the
# middle; tray, CPU, memory, graphics, mobile data, Bluetooth, network, sound,
# display and battery in watts on the right).
#
# Hyprland draws inside a headless labwc in a private home, runtime dir and
# D-Bus session with no system bus. Hardware and network helpers that would
# otherwise read the host computer or reach the internet are stubbed or pointed
# at synthetic fixtures (a synthetic battery in $WORK/power_supply, neutral
# weather, empty installed-apps list, a steady load for the bar's CPU, memory
# and graphics, a made-up computer for Settings → About, and Nova's version as
# --version gives it, by default the tree's last release tag) so nothing of the
# machine this runs on appears in any picture. The clock is the real one, in
# Rome's time zone (TZ): nothing sets another without touching the system's.
# The session draws with Mesa alone, on a render node that is not NVIDIA's,
# whatever the caller's environment says, so a sleeping discrete GPU stays
# asleep.

set -euo pipefail

usage() { sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; }

here=$(cd "$(dirname "$0")/.." && pwd)
root='' out=$here/docs/images background='' wallpapers='' site_out=$here/site/images version=''
while (($# > 0)); do
  case $1 in
    --root) root=${2:?}; shift 2 ;;
    --version) version=${2:?}; shift 2 ;;
    --out) out=${2:?}; shift 2 ;;
    --background) background=${2:?}; shift 2 ;;
    --wallpapers) wallpapers=${2:?}; shift 2 ;;
    --site-out) site_out=${2:?}; shift 2 ;;
    -h | --help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
if [[ -z $background ]]; then
  background=$here/site/wallpapers/matterhorn.jpg
  [[ -n $wallpapers && -f $wallpapers/matterhorn.jpg ]] && background=$wallpapers/matterhorn.jpg
fi
[[ -n $root && -f $root/usr/share/nova/shell/shell.qml ]] || { usage >&2; exit 2; }
# v1.0.0-rc.15 is 1.0.0rc.15 to pacman (packaging/nova/PKGBUILD, pkgver).
if [[ -z $version ]]; then
  version=$(git -C "$here" describe --tags --abbrev=0 --match 'v[0-9]*' 2>/dev/null || echo v1.0.0)
fi
tag=v${version#v}
version=${tag#v}
version=${version/-/}
version=${version//-/.}
[[ -f $background ]] || { echo "screenshots: no background $background" >&2; exit 2; }
if [[ -n $wallpapers ]]; then
  [[ -d $wallpapers ]] || { echo "screenshots: no wallpapers folder $wallpapers" >&2; exit 2; }
  wallpapers=$(cd "$wallpapers" && pwd)
  mkdir -p "$site_out"
  site_out=$(cd "$site_out" && pwd)
fi
for tool in labwc wlr-randr start-hyprland hyprctl qs dbus-run-session grim jq foot rsvg-convert vips; do
  command -v "$tool" >/dev/null || { echo "screenshots: needs $tool" >&2; exit 1; }
done
root=$(cd "$root" && pwd)
mkdir -p "$out"
out=$(cd "$out" && pwd)

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/home/.config/nova" "$work/home/.config/foot" "$work/home/.config/hypr" \
  "$work/home/.config/labwc" "$work/home/.local/share/nova/calendar" \
  "$work/home/.local/state/nova/settings" "$work/home/.local/state/nova-batterylife/days" \
  "$work/home/backgrounds" "$work/power_supply/BAT0" "$work/rfkill/rfkill0" "$work/rfkill/rfkill1" \
  "$work/run" "$work/bin" "$work/shots"
chmod 700 "$work/run"
# Nova's cursor theme where the cursor libraries look for one, in the home:
# Hyprland draws the pointer with it, as data/hypr/cursor.lua has it.
mkdir -p "$work/home/.local/share/icons"
ln -s "$root/usr/share/icons/Nova" "$work/home/.local/share/icons/Nova"

# What the shell and its helpers must not reach from in here: the session and
# the system this runs on. hyprctl is not among them: it looks for Hyprland in
# the runtime dir, and this one's holds only the Hyprland started here. lspci
# is: Hyprland lists the graphics cards with it as it starts, which wakes one
# that sleeps.
for stub in systemctl dbus-update-activation-environment loginctl powerprofilesctl pkexec sudo \
  systemd-inhibit nmcli bluetoothctl mmcli rfkill brightnessctl ddcutil uwsm nova-launch lspci \
  flatpak nova-apps-refresh fwupdmgr nova-power-gpu; do
  printf '#!/bin/sh\nexit 0\n' >"$work/bin/$stub"
  chmod +x "$work/bin/$stub"
done
# Static weather stand-in so the bar's weather icon renders without any network
# access or the host computer's real location.
cat >"$work/bin/curl" <<'EOF'
#!/bin/sh
case "$*" in
  *api.open-meteo.com*)
    today=$(date +%F)
    d1=$(date -d "today +1 day" +%F)
    d2=$(date -d "today +2 days" +%F)
    d3=$(date -d "today +3 days" +%F)
    printf '{"current":{"temperature_2m":17.0,"apparent_temperature":16.0,"relative_humidity_2m":54,"wind_speed_10m":11.0,"weather_code":2,"is_day":1},"daily":{"time":["%s","%s","%s","%s"],"weather_code":[2,1,3,0],"temperature_2m_max":[18,20,16,19],"temperature_2m_min":[9,10,8,11]}}\n' "$today" "$d1" "$d2" "$d3"
    ;;
  *) exit 0 ;;
esac
EOF
chmod +x "$work/bin/curl"
# Neutral synthetic weather location (never the host's real city).
printf '{"name":"Zurich","latitude":47.3769,"longitude":8.5417}\n' \
  >"$work/home/.local/state/nova/settings/weather.json"

# Clean synthetic system/laptop stand-ins for Settings and bar widgets.
printf '#!/bin/sh\necho current\n' >"$work/bin/nova-update-check"
printf '#!/bin/sh\ncase "$1" in list) printf "power-saver\\t1\\nbalanced\\t0\\nperformance\\t0\\n" ;; *) exit 0 ;; esac\n' >"$work/bin/nova-power-profile"
printf '#!/bin/sh\necho '\''{"kind":"threshold","limit":80,"on":true}'\''\n' >"$work/bin/nova-battery-limit"
# The power page's three choices, as their helpers print them (Settings shows
# a row only for a value it knows).
printf '#!/bin/sh\necho 2h\n' >"$work/bin/nova-power-hibernate"
printf '#!/bin/sh\necho sleep\n' >"$work/bin/nova-power-lid"
printf '#!/bin/sh\necho menu\n' >"$work/bin/nova-power-button"
cat >"$work/bin/nova-dictation" <<'EOF'
#!/bin/sh
case "$1" in
  check) echo ready ;;
  last) echo "Release notes are ready for the next two-week cut." ;;
  *) exit 0 ;;
esac
EOF
cat >"$work/bin/nova-airdrop" <<'EOF'
#!/bin/sh
case "$1 $2" in
  "available "*) exit 0 ;;
  "bell watch")
    printf '{"state":"listening","phones":1,"name":"iPhone","near":false,"learning":0}\n'
    exec sleep 300
    ;;
  *) exit 0 ;;
esac
EOF
# The App Center reads what is installed on the computer this runs on: in the
# pictures, nothing is, so its tiles show no one's apps.
printf '#!/bin/sh\necho '\''{"flatpak":[],"runtimes":[],"pacman":{},"explicit":[],"nova":[]}'\''\n' >"$work/bin/nova-apps-installed"
# Nova's version is the tree's, its last release tag as the package names it
# (--version), not the one installed here; release candidates off.
cat >"$work/bin/pacman" <<STUB
#!/bin/sh
[ "\$*" = "-Q nova" ] && { echo "nova $version-1"; exit 0; }
exec /usr/bin/pacman "\$@"
STUB
printf '#!/bin/sh\ncase "$1" in --candidates) echo off ;; *) exit 0 ;; esac\n' >"$work/bin/nova-update"
printf '# nova-release: %s\n' "$tag" >"$work/nova-repo"
printf '# arch-date: 2026/11/01\n' >"$work/nova-mirrorlist"
# Settings → About, and the bar's CPU, memory and graphics: a computer of the
# harness's own (NOVA_PROC, NOVA_SYS, NOVA_DMI_PATH), with a steady load. The
# processor's counters are written as the session runs (session, below).
mkdir -p "$work/proc/sys/kernel" "$work/dmi"
printf 'nova\n' >"$work/proc/sys/kernel/hostname"
printf 'processor\t: 0\nmodel name\t: AMD Ryzen 7 7840U w/ Radeon 780M Graphics\n' >"$work/proc/cpuinfo"
printf 'MemTotal:       32000000 kB\nMemFree:        20000000 kB\nMemAvailable:   23040000 kB\n' >"$work/proc/meminfo"
printf 'Framework\n' >"$work/dmi/sys_vendor"
printf 'Laptop 13 (AMD Ryzen 7040Series)\n' >"$work/dmi/product_name"
# One AMD card, with the screen on it, 4% busy (its gpu_busy_percent).
card=$work/sys/class/drm/card0
mkdir -p "$card/device/power" "$work/sys/bus/pci/drivers/amdgpu" "$work/sys/class/drm/card0-eDP-1"
ln -s "$work/sys/bus/pci/drivers/amdgpu" "$card/device/driver"
printf 'active\n' >"$card/device/power/runtime_status"
printf '4\n' >"$card/device/gpu_busy_percent"
printf '1\n' >"$card/device/boot_vga"
printf 'connected\n' >"$work/sys/class/drm/card0-eDP-1/status"
printf '#!/bin/sh\n[ "$*" = "-r" ] && { echo 7.2.0-1-nova; exit 0; }\nexec /usr/bin/uname "$@"\n' >"$work/bin/uname"
printf '#!/bin/sh\n[ "$*" = "-B1 --output=size,avail /" ] && { echo "1B-blocks Avail"; echo "1000204886016 612457349120"; exit 0; }\nexec /usr/bin/df "$@"\n' >"$work/bin/df"
chmod +x "$work/bin/nova-update-check" "$work/bin/nova-power-profile" "$work/bin/nova-battery-limit" \
  "$work/bin/nova-power-hibernate" "$work/bin/nova-power-lid" "$work/bin/nova-power-button" \
  "$work/bin/nova-dictation" "$work/bin/nova-airdrop" "$work/bin/nova-apps-installed" \
  "$work/bin/pacman" "$work/bin/nova-update" "$work/bin/uname" "$work/bin/df"

# Synthetic battery fixture using Nova's own BATTERYLIFE_POWER_SUPPLY_DIR and
# NOVA_POWER_SUPPLY testing seams, plus a clean four-hour discharge trace at
# 2-minute intervals (within GAP_SECONDS=300) so the bar shows watts (6.80W)
# and Settings > Battery shows a realistic hourly chart and battery run.
printf 'Battery\n' >"$work/power_supply/BAT0/type"
printf '1\n' >"$work/power_supply/BAT0/present"
printf 'Discharging\n' >"$work/power_supply/BAT0/status"
printf '84\n' >"$work/power_supply/BAT0/capacity"
printf '72576000\n' >"$work/power_supply/BAT0/energy_now"
printf '86400000\n' >"$work/power_supply/BAT0/energy_full"
printf '90000000\n' >"$work/power_supply/BAT0/energy_full_design"
printf '6800000\n' >"$work/power_supply/BAT0/power_now"
printf '42\n' >"$work/power_supply/BAT0/cycle_count"
printf 'wlan\n' >"$work/rfkill/rfkill0/type"
printf 'bluetooth\n' >"$work/rfkill/rfkill1/type"

now_ts=$(date +%s)
day_tsv="$work/home/.local/state/nova-batterylife/days/$(date +%F).tsv"
# Earlier finished discharge run + current active run so Today's chart and Last runs populate.
start_ts=$((now_ts - 21600))
printf '%s\tF\t100\t86400000\t86400000\t0\n' "$((start_ts - 120))" >>"$day_tsv"
for ((step = 0; step <= 60; step++)); do
  ts=$((start_ts + step * 120))
  energy=$((86400000 - step * 210000))
  pct=$((energy * 100 / 86400000))
  power=$((6100000 + (step % 5) * 420000))
  printf '%s\tD\t%s\t%s\t86400000\t%s\n' "$ts" "$pct" "$energy" "$power" >>"$day_tsv"
done
printf '%s\tC\t98\t84672000\t86400000\t0\n' "$((now_ts - 10920))" >>"$day_tsv"
for ((step = 90; step >= 1; step--)); do
  ts=$((now_ts - step * 120))
  energy=$((72576000 + step * 130000))
  pct=$((energy * 100 / 86400000))
  power=$((6400000 + (step % 6) * 380000))
  printf '%s\tD\t%s\t%s\t86400000\t%s\n' "$ts" "$pct" "$energy" "$power" >>"$day_tsv"
done

# Prepare stripped PNG copies of the main background and any wallpapers folder.
prepare_bg() { # <src> <dest-no-ext>
  local src=$1 dst=$2
  case $src in
    *.svg) rsvg-convert -w 3840 -o "$dst.png" "$src" ;;
    *) vips thumbnail "$src" "$dst.png[strip]" 3840 ;;
  esac
}
backdrop=${background##*/}
backdrop=${backdrop%.*}
prepare_bg "$background" "$work/home/backgrounds/$backdrop"

wallpaper_list=()
if [[ -n $wallpapers ]]; then
  # Put the opening backdrop first, then the rest sorted by name.
  [[ -f $wallpapers/$backdrop.jpg ]] && wallpaper_list+=("$backdrop")
  for wp in "$wallpapers"/*.jpg; do
    [[ -f $wp ]] || continue
    slug=$(basename "$wp" .jpg)
    [[ $slug == "$backdrop" ]] || wallpaper_list+=("$slug")
    [[ -f $work/home/backgrounds/$slug.png ]] || prepare_bg "$wp" "$work/home/backgrounds/$slug"
  done
fi

# Quick Look's preview photo: the canyon when it is among the wallpapers, else
# the background.
ql_file=$work/home/backgrounds/$backdrop.png ql_name=$backdrop.jpg
if [[ -f $work/home/backgrounds/canyon.png ]]; then
  ql_file=$work/home/backgrounds/canyon.png ql_name=canyon.jpg
fi
# And a copy of it 1200 pixels wide, which Quick Look opens at its own size,
# leaving the photo behind it in view.
mkdir -p "$work/home/Pictures"
ql_small=$work/home/Pictures/$ql_name
vips thumbnail "$ql_file" "${ql_small}[Q=88,strip]" 1200

# The full transparent bar layout: menu and workspaces on the left; indicators,
# clock (dddd HH:mm), keyboard layout, weather and update mark in the center;
# tray, CPU, memory, graphics, mobile data, Bluetooth, network, sound, display
# and battery in watts on the right.
jq '.bar = {
  "centerAnchor": "nova.clock",
  "layout": {
    "center": [
      { "id": "nova.indicators" },
      { "format": "dddd HH:mm", "formatAlt": "d MMMM '\''W'\''ww yyyy", "id": "nova.clock", "verticalFormat": "HH\n—\nmm" },
      { "id": "nova.keyboard-layout" },
      { "id": "nova.weather" },
      { "id": "nova.system-update" }
    ],
    "left": [
      { "id": "nova.menu" },
      { "id": "nova.workspaces" },
      { "id": "nova.active-window", "off": true },
      { "id": "nova.media", "off": true }
    ],
    "right": [
      { "id": "nova.tray" },
      { "id": "nova.cpu" },
      { "id": "nova.memory" },
      { "id": "nova.graphics" },
      { "id": "nova.screentime", "off": true },
      { "id": "nova.mobile-data" },
      { "id": "nova.bluetooth" },
      { "id": "nova.network" },
      { "id": "nova.audio" },
      { "id": "nova.monitor" },
      { "id": "nova.batterylife", "readout": "Watts" }
    ]
  },
  "transparent": true
}' "$root/usr/share/nova/default/shell.json" >"$work/home/.config/nova/shell.json"

printf 'include=~/.config/foot/theme.ini\n[main]\nfont=JetBrainsMono Nerd Font:size=11\npad=14x14\n' \
  >"$work/home/.config/foot/foot.ini"

# A week with something in it, around today.
event() { # days from today, start HH:MM, end HH:MM, summary
  local day
  day=$(date -d "today $1 days" +%Y%m%d)
  printf 'BEGIN:VEVENT\r\nUID:%s-%s@nova\r\nDTSTAMP:%sT000000Z\r\nDTSTART:%sT%s00\r\nDTEND:%sT%s00\r\nSUMMARY:%s\r\nEND:VEVENT\r\n' \
    "$day" "${2/:/}" "$day" "$day" "${2/:/}" "$day" "${3/:/}" "$4"
}
task() { # days from today, or none for no day; summary
  printf 'BEGIN:VTODO\r\nUID:task-%s@nova\r\nDTSTAMP:%sT000000Z\r\n' "${2// /-}" "$(date +%Y%m%d)"
  [[ $1 == none ]] || printf 'DUE;VALUE=DATE:%s\r\n' "$(date -d "today $1 days" +%Y%m%d)"
  printf 'SUMMARY:%s\r\nSTATUS:NEEDS-ACTION\r\nEND:VTODO\r\n' "$2"
}
{
  printf 'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//Nova//Calendar//EN\r\n'
  event -1 09:30 10:15 'Stand-up'
  event -1 14:00 16:00 'Kernel 7.3: try the candidate'
  event 0 10:00 11:30 'Release notes'
  event 0 13:00 13:45 'Lunch with Sam'
  event 0 16:30 18:00 'Measure the idle draw'
  event 1 09:00 12:00 'Theme work'
  event 2 11:00 12:00 'Dentist'
  event 2 15:00 17:30 'Hardware profile: Framework 13'
  event 3 18:30 20:00 'Climbing'
  task -2 'Answer the hardware survey'
  task 0 'Send the release notes'
  task none 'Order a second USB stick'
  task none 'Renew the passport'
  printf 'END:VCALENDAR\r\n'
} >"$work/home/.local/share/nova/calendar/calendar.ics"

# What the terminal in the pictures shows, reflecting the wallpaper and theme in view.
# Its prompt is drawn as Nova's bash draws it (data/bash/bashrc) in a repository
# with changes; tests/unit/session/bashrc.bats holds the two the same.
cat >"$work/bin/demo" <<'EOF'
#!/bin/bash
photo=${1:-${BACKDROP}}
active_theme=${2:-adaptive}
mode=${3:-}
c() { printf '\e[%sm%s\e[0m' "$1" "$2"; }
prompt() { printf '%s %s %s $ %s\n' "$(c '1;34' '~/Projects/nova')" "$(c 32 main)" "$(c 31 '*')" "$1"; }
prompt "nova theme set $active_theme"
[[ -z $mode ]] || prompt "nova theme adaptive $mode"
prompt 'git status --short'
printf ' %s src/theme/src/adaptive.rs\n %s src/theme/src/bar.rs\n %s docs/themes.md\n' "$(c 32 A)" "$(c 32 A)" "$(c 33 M)"
prompt 'ls'
printf '%s  %s  %s  %s  %s  %s\n' "$(c '1;34' data)" "$(c '1;34' docs)" "$(c '1;34' src)" "$(c '36' 'theme@')" "$(c '1;32' 'nova*')" "$(c 35 "$photo.jpg")"
prompt 'git diff'
printf '%s\n%s\n%s\n' "$(c 36 '@@ -12,3 +12,4 @@')" "$(c 31 '-    let accent = fixed();')" "$(c 32 '+    let accent = reading.accent;')"
prompt "nova theme palette $photo.jpg${mode:+ $mode} | head -4"
nova-theme palette "$HOME/backgrounds/$photo.png" ${mode:+"$mode"} | sed -n '3,6p'
prompt ''
exec sleep 3600
EOF
chmod +x "$work/bin/demo"

# One session: labwc, Hyprland in it, the shell and what is opened on that, in
# their own D-Bus session, so that all of it ends together.
session() {
  set -euo pipefail
  labwc='' hyprland='' shell='' term='' load=''
  trap 'kill $term $shell $hyprland $load 2>/dev/null; sleep 0.5; kill $labwc 2>/dev/null; wait 2>/dev/null' EXIT
  # The processor, a steady 12% busy: its counters grow by 100 jiffies, 12
  # of them busy, four times a second, so any two readings say 12%.
  (
    t=0
    while :; do
      t=$((t + 1))
      printf 'cpu  %d 0 0 %d 0 0 0 0 0 0\n' $((t * 12)) $((t * 88)) >"$NOVA_PROC/stat.new"
      mv -f "$NOVA_PROC/stat.new" "$NOVA_PROC/stat"
      sleep 0.25
    done
  ) &
  load=$!
  WLR_BACKENDS=headless WLR_LIBINPUT_NO_DEVICES=1 labwc >"$WORK/labwc.log" 2>&1 &
  labwc=$!
  local outer='' inner='' lock='' i answer=''
  for ((i = 0; i < 100; i++)); do
    outer=$(find "$XDG_RUNTIME_DIR" -maxdepth 1 -type s -name 'wayland-*' -printf '%f\n' | sed -n 1p)
    [[ -z $outer ]] || break
    sleep 0.1
  done
  [[ -n $outer ]] || { echo "screenshots: labwc did not start" >&2; cat "$WORK/labwc.log" >&2; return 1; }
  WAYLAND_DISPLAY=$outer wlr-randr --output HEADLESS-1 --custom-mode 1920x1200

  WAYLAND_DISPLAY=$outer start-hyprland -- --config "$HOME/.config/hypr/hyprland.lua" >"$WORK/hyprland.log" 2>&1 &
  for ((i = 0; i < 100; i++)); do
    lock=$(find "$XDG_RUNTIME_DIR/hypr" -mindepth 2 -maxdepth 2 -name hyprland.lock 2>/dev/null | head -1 || true)
    [[ -z $lock ]] || { read -r hyprland && read -r inner; } <"$lock" || true
    [[ -z $inner ]] || break
    sleep 0.1
  done
  [[ -n $inner ]] || { echo "screenshots: Hyprland did not start" >&2; tail -30 "$WORK/hyprland.log" >&2; return 1; }
  export WAYLAND_DISPLAY=$inner
  HYPRLAND_INSTANCE_SIGNATURE=$(basename "$(dirname "$lock")")
  export HYPRLAND_INSTANCE_SIGNATURE
  [[ -S $XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock ]] ||
    { echo "screenshots: Hyprland has no event socket; is TMPDIR too long a path for one?" >&2; return 1; }

  nova-theme set adaptive >/dev/null 2>&1 || true
  nova-theme bg set "$HOME/backgrounds/$BACKDROP.png" >/dev/null 2>&1 || true

  QS_DISABLE_FILE_WATCHER=1 QS_NO_RELOAD_POPUP=1 qs -n --no-color -p "$SHELL_DIR" >"$WORK/shell.log" 2>&1 &
  shell=$!
  ipc() { qs ipc -p "$SHELL_DIR" call "$@" 2>/dev/null; }
  for ((i = 0; i < 300; i++)); do
    answer=$(ipc shell ping || true)
    [[ $answer != ok ]] || break
    sleep 0.1
  done
  [[ $answer == ok ]] || { echo "screenshots: the shell did not answer" >&2; return 1; }
  # Let the bar's readouts (CPU/memory/graphics/battery/weather) land their first sample.
  sleep 2.5

  local pointed=()
  shot() { sleep "${2:-1.5}"; grim "${pointed[@]}" "$WORK/shots/$1.png"; }
  pointer() {
    hyprctl dispatch "hl.dsp.cursor.move({ x = $1, y = $2 })" >/dev/null 2>&1 || true
    pointed=(-c)
  }
  # Switch the background (and let adaptive recalculate when adaptive is active).
  use_bg() {
    local name=$1
    [[ -f $HOME/backgrounds/$name.png ]] || name=$BACKDROP
    nova-theme bg set "$HOME/backgrounds/$name.png" >/dev/null 2>&1 || true
    sleep 1.0
  }
  theme() { nova-theme set "$1" >/dev/null 2>&1 || true; sleep 1.2; }
  close_term() {
    if [[ -n $term ]]; then kill "$term" 2>/dev/null || true; wait "$term" 2>/dev/null || true; term=''; fi
  }
  open_term() { # <photo> [theme] [adaptive mode]
    close_term
    foot demo "$1" "${2:-adaptive}" "${3:-}" >/dev/null 2>&1 &
    term=$!
    sleep 0.9
  }
  settings() {
    ipc shell hide nova.settings >/dev/null || true
    sleep 0.4
    ipc shell summon nova.settings "{\"page\":\"${1:-appearance}\"}" >/dev/null
  }
  quicklook() { # Quick Look on <file> <its name> <type> <icon>
    local size
    size=$(stat -c %s "$1")
    ipc shell summon nova.preview "$(jq -nc --arg path "$1" --arg name "$2" --arg mime "$3" --arg icon "$4" --argjson size "$size" \
      '{uri: ("file://" + $path), path: $path, name: $name, mime: $mime, kind: "image",
        type: "Image", size: $size, sizeText: "", items: -1, icon: [$icon, "image-x-generic"], seq: 1}')" >/dev/null
  }

  # Opening desktop: terminal and Settings at Appearance over BACKDROP in adaptive.
  open_term "$BACKDROP"
  settings appearance
  pointer 659 601
  shot desktop 2.5

  # The adaptive palettes for BACKDROP (dark and light).
  nova-theme palette "$HOME/backgrounds/$BACKDROP.png" >"$WORK/shots/palette.toml" 2>/dev/null || true
  nova-theme palette "$HOME/backgrounds/$BACKDROP.png" light >"$WORK/shots/palette-light.toml" 2>/dev/null || true

  # In --wallpapers mode: the opening desktop again in the adaptive theme's
  # light mode, which the site shows on a light system, and Nova in its
  # adaptive theme over every other photo, each with something else open, as a
  # day on Nova has it. tools/build-site's list of the photos says what each
  # desktop shows; the two go together. A photo with no scene of its own gets
  # the terminal and Settings.
  if [[ -n ${WALLPAPERS_LIST:-} ]]; then
    nova-theme adaptive light >/dev/null 2>&1 || true
    sleep 1.2
    open_term "$BACKDROP" adaptive light
    settings appearance
    pointer 659 601
    shot "desktop-$BACKDROP-light" 2.5
    ipc shell hide nova.settings >/dev/null || true
    nova-theme adaptive auto >/dev/null 2>&1 || true
    sleep 1.2
    close_term
    pointed=()

    local slug picker each
    for slug in $WALLPAPERS_LIST; do
      [[ $slug == "$BACKDROP" ]] && continue
      use_bg "$slug"
      case $slug in
        aurora) # the Calendar's week
          ipc shell summon nova.calendar '{"page":"week","date":""}' >/dev/null
          shot "desktop-$slug" 3
          ipc shell hide nova.calendar >/dev/null || true ;;
        canyon) # the Calculator
          ipc shell summon nova.calculator '{"expression":"1920*1200"}' >/dev/null
          shot "desktop-$slug" 2.2
          ipc shell hide nova.calculator >/dev/null || true ;;
        coast) # nothing open
          shot "desktop-$slug" 1.5 ;;
        dunes) # the App Center
          ipc shell summon nova.store '{}' >/dev/null
          shot "desktop-$slug" 6
          ipc shell hide nova.store >/dev/null || true ;;
        forest) # the menu
          ipc shell summon nova.menu '{"menu":"root"}' >/dev/null
          shot "desktop-$slug" 1.8
          ipc shell hide nova.menu >/dev/null || true ;;
        harbour) # the background picker, with the photos in it
          mkdir -p "$HOME/.config/nova/backgrounds"
          for each in "$HOME"/backgrounds/*.png; do ln -sf "$each" "$HOME/.config/nova/backgrounds/"; done
          nova-theme bg pick >/dev/null 2>&1 &
          picker=$!
          shot "desktop-$slug" 4
          ipc shell hide nova.image-picker >/dev/null || true
          wait "$picker" 2>/dev/null || true
          rm -rf "$HOME/.config/nova/backgrounds" ;;
        peaks) # Quick Look on a photo
          quicklook "$QL_SMALL" "${QL_SMALL##*/}" image/jpeg image-jpeg
          shot "desktop-$slug" 2.5
          ipc shell hide nova.preview >/dev/null || true ;;
        *) # the terminal and Settings at Appearance
          open_term "$slug"
          settings appearance
          shot "desktop-$slug" 2.2
          ipc shell hide nova.settings >/dev/null || true
          close_term ;;
      esac
    done
  fi

  # Fixed themes, each paired with a wallpaper that suits it when --wallpapers
  # is set (otherwise all over BACKDROP). Set the theme before the background
  # so the theme's remembered wallpaper does not overwrite it.
  local pair name bg_for
  for pair in "tokyo-night:harbour" "catppuccin-latte:peaks" "gruvbox:dunes" "nord:forest" "rose-pine:matterhorn"; do
    name=${pair%%:*}
    bg_for=${pair#*:}
    if [[ -n ${WALLPAPERS_LIST:-} && -f $HOME/backgrounds/$bg_for.png ]]; then
      ipc shell hide nova.settings >/dev/null || true
      theme "$name"
      use_bg "$bg_for"
      open_term "$bg_for" "$name"
    else
      theme "$name"
    fi
    settings appearance
    pointer 659 601
    shot "theme-$name" 2
  done
  ipc shell hide nova.settings >/dev/null || true
  pointed=()

  # Helper: switch to adaptive first, then apply the desired wallpaper (which
  # updates the adaptive theme to match that photo) and open a matching terminal.
  stage_feature() {
    local want=$1
    theme adaptive
    if [[ -n ${WALLPAPERS_LIST:-} && -f $HOME/backgrounds/$want.png ]]; then
      use_bg "$want"
      open_term "$want"
    else
      use_bg "$BACKDROP"
      open_term "$BACKDROP"
    fi
  }

  # Menu (Super+Space) over aurora.
  stage_feature aurora
  ipc shell summon nova.menu '{"menu":"root"}' >/dev/null
  shot menu 1.8
  ipc shell hide nova.menu >/dev/null || true

  # Calendar over forest.
  stage_feature forest
  ipc shell summon nova.calendar '{"page":"week","date":""}' >/dev/null
  shot calendar 3
  ipc shell hide nova.calendar >/dev/null || true

  # Calculator over dunes.
  stage_feature dunes
  ipc shell summon nova.calculator '{"expression":"1234*5678"}' >/dev/null
  shot calculator 2.2
  ipc shell hide nova.calculator >/dev/null || true

  # Quick Look over forest (previewing canyon.jpg so the coral canyon window
  # stands out clearly over the misty pine forest).
  stage_feature forest
  quicklook "$QL_FILE" "$QL_NAME" image/png image-png
  shot quicklook 2.5
  ipc shell hide nova.preview >/dev/null || true

  # App Center over matterhorn.
  stage_feature matterhorn
  ipc shell summon nova.store '{}' >/dev/null
  shot store 6
  ipc shell hide nova.store >/dev/null || true

  # Welcome wizard over matterhorn.
  ipc shell summon nova.welcome '{}' >/dev/null
  shot welcome 2.5
  ipc shell hide nova.welcome >/dev/null || true

  # Settings -> Dictation over harbour.
  if grep -q 'id: "dictation"' "$SHELL_DIR/plugins/settings/Panel.qml"; then
    stage_feature harbour
    settings dictation
    shot dictation 2.5
    ipc shell hide nova.settings >/dev/null || true
  fi

  # Extra site showcase panels (AirDrop & iPhone, Updates, Battery/Laptops) when
  # running with --wallpapers.
  if [[ -n ${WALLPAPERS_LIST:-} ]]; then
    stage_feature coast
    settings airdrop
    shot airdrop 2.2
    ipc shell hide nova.settings >/dev/null || true

    stage_feature dunes
    settings updates
    shot updates 2.2
    ipc shell hide nova.settings >/dev/null || true

    stage_feature peaks
    settings battery
    shot battery 2.5
    ipc shell hide nova.settings >/dev/null || true
  fi
}

