for name in desktop theme-tokyo-night theme-catppuccin-latte theme-gruvbox; do
  vips crop "$work/shots/$name.png" "$work/shots/$name-corner.png" 0 0 1216 760
  corners+=("$work/shots/$name-corner.png")
done
vips arrayjoin "${corners[*]}" "$work/shots/themes.png" --across 2 --shim 16 --background "255 255 255"
vips resize "$work/shots/themes.png" "$out/themes.jpg[Q=86,strip,optimize_coding]" 0.78125
for name in theme-nord theme-rose-pine; do
  vips crop "$work/shots/$name.png" "$work/shots/$name-corner.png" 0 0 1216 760
done
for name in desktop theme-tokyo-night theme-catppuccin-latte theme-gruvbox theme-nord theme-rose-pine; do
  vips resize "$work/shots/$name-corner.png" "$out/corner-${name#theme-}.jpg[Q=84,strip,optimize_coding]" 0.78125
done
mv "$out/corner-desktop.jpg" "$out/corner-adaptive.jpg"

# Per-wallpaper desktop shots (opening backdrop is docs/images/desktop.jpg, its
# light mode desktop-<backdrop>-light.jpg) +
# fixed-theme full shots + extra site feature shots + site adaptive palettes.
if [[ -n $wallpapers ]]; then
  rm -f "$site_out/desktop-$backdrop.jpg"
  [[ ! -f $work/shots/desktop-$backdrop-light.png ]] || save "desktop-$backdrop-light" "$site_out" "desktop-$backdrop-light" 84
  for slug in "${wallpaper_list[@]}"; do
    [[ $slug == "$backdrop" ]] && continue
    [[ -f $work/shots/desktop-$slug.png ]] || continue
    save "desktop-$slug" "$site_out" "desktop-$slug" 84
  done
  for name in tokyo-night catppuccin-latte gruvbox nord rose-pine; do
    [[ -f $work/shots/theme-$name.png ]] || continue
    save "theme-$name" "$site_out" "theme-$name" 84
  done
  for extra in airdrop updates battery; do
    [[ -f $work/shots/$extra.png ]] || continue
    save "$extra" "$site_out" "$extra" 84
  done
  "$here/tools/site-palettes" --root "$root" --dir "$wallpapers" --default "$backdrop"
fi

# The adaptive theme's palettes over the opening background, dark and light,
# when running standalone without --wallpapers (otherwise site-palettes already
# wrote them into --wallpapers).
if [[ -z $wallpapers ]]; then
  for mode in "" light; do
    palette=$work/shots/palette${mode:+-$mode}.toml
    grep -q '^background = ' "$palette" 2>/dev/null || continue
    { printf '# The adaptive theme'\''s%s colors over %s, as `nova theme palette` gives them.\n' "${mode:+ $mode}" "${background##*/}"
      printf '# Written by tools/screenshots; tools/build-site draws the site'\''s adaptive theme with it.\n'
      grep -v '^#' "$palette"; } >"$out/$backdrop${mode:+.$mode}.colors.toml"
  done
fi
