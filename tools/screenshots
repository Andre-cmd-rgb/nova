#!/bin/bash
# screenshots: the pictures in the README and docs/, taken of the shell itself.
#
#   tools/screenshots --root <dir> [--out <dir>] [--background <image>]
#
# --root is a `make install DESTDIR=<dir>` tree; the pictures go to docs/images
# unless --out names another folder. --background is the picture behind the
# windows, docs/images/dusk.svg unless it names another: a photo, a JPEG or a
# PNG, of which only the pixels go into the pictures (Quick Look's picture is
# the dusk all the same). The shell runs on a Hyprland of its own, given
# Nova's look and window rules (data/hypr), so a picture shows the
# windows as Nova draws them: round corners, the theme's border, the terminal
# a little see-through. Hyprland draws to a screen or to a window, and has no
# way to draw to neither; here it is a window of a headless labwc (sway offers
# it too old an xdg-shell), in a home, a runtime dir and a D-Bus session of
# their own. They are given no system bus either, so nothing of the computer
# this runs on (its networks, its battery, its name) is in a picture; what is
# in them is made here: a calendar, a terminal's lines, and the background,
# which the adaptive theme takes its colours from.
#
# One thing is not as Nova has it: the windows float where the pictures want
# them, to leave the background in view, where Nova tiles them.

set -euo pipefail

usage() { sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; }

here=$(cd "$(dirname "$0")/.." && pwd)
root='' out=$here/docs/images background=$here/docs/images/dusk.svg
while (($# > 0)); do
  case $1 in
    --root) root=${2:?}; shift 2 ;;
    --out) out=${2:?}; shift 2 ;;
    --background) background=${2:?}; shift 2 ;;
    -h | --help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
[[ -n $root && -f $root/usr/share/nova/shell/shell.qml ]] || { usage >&2; exit 2; }
[[ -f $background ]] || { echo "screenshots: no background $background" >&2; exit 2; }
for tool in labwc wlr-randr start-hyprland hyprctl qs dbus-run-session grim jq foot rsvg-convert vips; do
  command -v "$tool" >/dev/null || { echo "screenshots: needs $tool" >&2; exit 1; }
done
root=$(cd "$root" && pwd)
mkdir -p "$out"
out=$(cd "$out" && pwd)

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/home/.config/nova" "$work/home/.config/foot" "$work/home/.config/hypr" \
  "$work/home/.config/labwc" "$work/home/.local/share/nova/calendar" "$work/run" "$work/bin" "$work/shots"
chmod 700 "$work/run"

# What the shell and its helpers must not reach from in here: the session and
# the system this runs on. hyprctl is not among them: it looks for Hyprland in
# the runtime dir, and this one's holds only the Hyprland started here. lspci
# is: Hyprland lists the graphics cards with it as it starts, which wakes one
# that sleeps.
for stub in systemctl dbus-update-activation-environment loginctl powerprofilesctl pkexec sudo \
  systemd-inhibit nmcli bluetoothctl rfkill brightnessctl ddcutil uwsm nova-launch lspci curl; do
  printf '#!/bin/sh\nexit 0\n' >"$work/bin/$stub"
  chmod +x "$work/bin/$stub"
done

# The background as a PNG of the screen's width twice over, its name kept for
# the terminal's lines. A photo's metadata (where and when it was taken)
# stays out: vips writes the pixels alone.
backdrop=${background##*/}
backdrop=${backdrop%.*}
case $background in
  *.svg) rsvg-convert -w 3840 -o "$work/home/$backdrop.png" "$background" ;;
  *) vips thumbnail "$background" "$work/home/$backdrop.png[strip]" 3840 ;;
esac
# Drawn for Quick Look's picture: a photo, as Space on one in Files shows it.
rsvg-convert -w 1600 -o "$work/home/dusk.png" "$here/docs/images/dusk.svg"

# The bar see-through, which Settings → Menu Bar turns on (a new install's is
# solid), and without the widgets that would show this computer's own (the
# weather where it is, its networks).
jq '.bar.transparent = true
  | .bar.layout.center |= map(select(.id != "nova.weather" and .id != "nova.system-update"))
  | .bar.layout.right |= map(select(.id == "nova.audio" or .id == "nova.tray"))' \
  "$root/usr/share/nova/default/shell.json" >"$work/home/.config/nova/shell.json"

printf 'include=~/.config/foot/theme.ini\n[main]\nfont=JetBrainsMono Nerd Font:size=11\npad=14x14\n' \
  >"$work/home/.config/foot/foot.ini"

# A week with something in it, around today.
event() { # days from today, start HH:MM, end HH:MM, summary
  local day
  day=$(date -d "today $1 days" +%Y%m%d)
  printf 'BEGIN:VEVENT\r\nUID:%s-%s@nova\r\nDTSTAMP:%sT000000Z\r\nDTSTART:%sT%s00\r\nDTEND:%sT%s00\r\nSUMMARY:%s\r\nEND:VEVENT\r\n' \
    "$day" "${2/:/}" "$day" "$day" "${2/:/}" "$day" "${3/:/}" "$4"
}
task() { # days from today, or none for no day; summary
  printf 'BEGIN:VTODO\r\nUID:task-%s@nova\r\nDTSTAMP:%sT000000Z\r\n' "${2// /-}" "$(date +%Y%m%d)"
  [[ $1 == none ]] || printf 'DUE;VALUE=DATE:%s\r\n' "$(date -d "today $1 days" +%Y%m%d)"
  printf 'SUMMARY:%s\r\nSTATUS:NEEDS-ACTION\r\nEND:VTODO\r\n' "$2"
}
{
  printf 'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//Nova//Calendar//EN\r\n'
  event -1 09:30 10:15 'Stand-up'
  event -1 14:00 16:00 'Kernel 7.3: try the candidate'
  event 0 10:00 11:30 'Release notes'
  event 0 13:00 13:45 'Lunch with Sam'
  event 0 16:30 18:00 'Measure the idle draw'
  event 1 09:00 12:00 'Theme work'
  event 2 11:00 12:00 'Dentist'
  event 2 15:00 17:30 'Hardware profile: Framework 13'
  event 3 18:30 20:00 'Climbing'
  task -2 'Answer the hardware survey'
  task 0 'Send the release notes'
  task none 'Order a second USB stick'
  task none 'Renew the passport'
  printf 'END:VCALENDAR\r\n'
} >"$work/home/.local/share/nova/calendar/calendar.ics"

# What the terminal in the pictures shows.
cat >"$work/bin/demo" <<'EOF'
#!/bin/bash
c() { printf '\e[%sm%s\e[0m' "$1" "$2"; }
prompt() { printf '%s %s $ %s\n' "$(c '1;34' '~/Projects/nova')" "$(c 32 main)" "$1"; }
prompt 'nova theme set adaptive'
prompt 'git status --short'
printf ' %s src/theme/src/adaptive.rs\n %s src/theme/src/bar.rs\n %s docs/themes.md\n' "$(c 32 A)" "$(c 32 A)" "$(c 33 M)"
prompt 'ls'
printf '%s  %s  %s  %s  %s  %s\n' "$(c '1;34' data)" "$(c '1;34' docs)" "$(c '1;34' src)" "$(c 36 'theme@')" "$(c '1;32' 'nova*')" "$(c 35 dusk.svg)"
prompt 'git diff'
printf '%s\n%s\n%s\n' "$(c 36 '@@ -12,3 +12,4 @@')" "$(c 31 '-    let accent = fixed();')" "$(c 32 '+    let accent = reading.accent;')"
prompt "nova theme palette $BACKDROP.png | head -4"
nova-theme palette "$HOME/$BACKDROP.png" | sed -n '3,6p'
prompt ''
exec sleep 3600
EOF
chmod +x "$work/bin/demo"

# One session: labwc, Hyprland in it, the shell and what is opened on that, in
# their own D-Bus session, so that all of it ends together.
session() {
  set -euo pipefail
  # However the session ends, what it started ends with it: Hyprland and what
  # is on it first, then labwc under them.
  labwc='' hyprland='' shell=''
  trap 'kill $shell $hyprland 2>/dev/null; sleep 0.5; kill $labwc 2>/dev/null; wait 2>/dev/null' EXIT
  WLR_BACKENDS=headless WLR_LIBINPUT_NO_DEVICES=1 labwc >"$WORK/labwc.log" 2>&1 &
  labwc=$!
  local outer='' inner='' lock='' i answer=''
  for ((i = 0; i < 100; i++)); do
    outer=$(find "$XDG_RUNTIME_DIR" -maxdepth 1 -type s -name 'wayland-*' -printf '%f\n' | head -1)
    [[ -z $outer ]] || break
    sleep 0.1
  done
  [[ -n $outer ]] || { echo "screenshots: labwc did not start" >&2; cat "$WORK/labwc.log" >&2; return 1; }
  WAYLAND_DISPLAY=$outer wlr-randr --output HEADLESS-1 --custom-mode 1920x1200

  # Hyprland writes its process and its socket to a lock file once it is up.
  WAYLAND_DISPLAY=$outer start-hyprland -- --config "$HOME/.config/hypr/hyprland.lua" >"$WORK/hyprland.log" 2>&1 &
  for ((i = 0; i < 100; i++)); do
    lock=$(find "$XDG_RUNTIME_DIR/hypr" -mindepth 2 -maxdepth 2 -name hyprland.lock 2>/dev/null | head -1 || true)
    [[ -z $lock ]] || { read -r hyprland && read -r inner; } <"$lock" || true
    [[ -z $inner ]] || break
    sleep 0.1
  done
  [[ -n $inner ]] || { echo "screenshots: Hyprland did not start" >&2; tail -30 "$WORK/hyprland.log" >&2; return 1; }
  export WAYLAND_DISPLAY=$inner
  HYPRLAND_INSTANCE_SIGNATURE=$(basename "$(dirname "$lock")")
  export HYPRLAND_INSTANCE_SIGNATURE
  # The shell follows Hyprland by its event socket, which Hyprland goes
  # without when the path to it is longer than a socket's may be.
  [[ -S $XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock ]] ||
    { echo "screenshots: Hyprland has no event socket; is TMPDIR too long a path for one?" >&2; return 1; }

  nova-theme set adaptive >/dev/null 2>&1 || true
  nova-theme bg set "$HOME/$BACKDROP.png" >/dev/null 2>&1 || true

  QS_DISABLE_FILE_WATCHER=1 QS_NO_RELOAD_POPUP=1 qs -n --no-color -p "$SHELL_DIR" >"$WORK/shell.log" 2>&1 &
  shell=$!
  ipc() { qs ipc -p "$SHELL_DIR" call "$@" 2>/dev/null; }
  for ((i = 0; i < 300; i++)); do
    answer=$(ipc shell ping || true)
    [[ $answer != ok ]] || break
    sleep 0.1
  done
  [[ $answer == ok ]] || { echo "screenshots: the shell did not answer" >&2; return 1; }
  shot() { sleep "${2:-1.5}"; grim "$WORK/shots/$1.png"; }
  # A theme, and the borders it gives Hyprland's windows.
  theme() { nova-theme set "$1" >/dev/null 2>&1 || true; sleep 1.2; }
  settings() {
    ipc shell hide nova.settings >/dev/null || true
    sleep 0.4
    ipc shell summon nova.settings '{"page":"appearance"}' >/dev/null
  }

  # The desktop: a terminal and Settings, in the adaptive theme.
  foot demo >/dev/null 2>&1 &
  sleep 1
  settings
  shot desktop 2.5

  # The same in three more themes, for one picture of four. Settings is
  # opened again for each: it reads the theme in use as it opens.
  local name
  for name in tokyo-night catppuccin-latte gruvbox; do
    theme "$name"
    settings
    shot "theme-$name" 2
  done
  theme adaptive
  ipc shell hide nova.settings >/dev/null || true

  ipc shell summon nova.menu '{"menu":"root"}' >/dev/null
  shot menu
  ipc shell hide nova.menu >/dev/null || true

  ipc shell summon nova.calendar '{"page":"week","date":""}' >/dev/null
  shot calendar 3
  ipc shell hide nova.calendar >/dev/null || true

  # The Calculator, with a sum worked out, as `nova calculator <sum>` opens it.
  ipc shell summon nova.calculator '{"expression":"1234*5678"}' >/dev/null
  shot calculator 2.5
  ipc shell hide nova.calculator >/dev/null || true

  # Quick Look, as Space on a photo in Files opens it: what nova-previewer
  # hands the shell for one.
  local size
  size=$(stat -c %s "$HOME/dusk.png")
  ipc shell summon nova.preview "$(jq -nc --arg path "$HOME/dusk.png" --argjson size "$size" \
    '{uri: ("file://" + $path), path: $path, name: "dusk.png", mime: "image/png", kind: "image",
      type: "PNG image", size: $size, sizeText: "", items: -1, icon: ["image-png", "image-x-generic"], seq: 1}')" >/dev/null
  shot quicklook 2.5
  ipc shell hide nova.preview >/dev/null || true
}

# labwc gives Hyprland the whole of its screen, with no frame of its own. It
# has no way to go without X: while it runs it holds a free display number in
# /tmp/.X11-unix, with no X server behind it.
cat >"$work/home/.config/labwc/rc.xml" <<'EOF'
<?xml version="1.0"?>
<labwc_config>
  <windowRules>
    <windowRule identifier="*" serverDecoration="no">
      <action name="ToggleFullscreen" />
    </windowRule>
  </windowRules>
</labwc_config>
EOF

# Hyprland with Nova's look, behaviour and window rules and the theme's
# borders, without Nova's keys, session and autostart. Every window floats
# where the pictures want it: the terminal top left, the shell's own windows
# over its corner, and the background to their right.
cat >"$work/home/.config/hypr/hyprland.lua" <<'EOF'
dofile(os.getenv("NOVA_PATH") .. "/default/hypr/bootstrap.lua")
require("default.hypr.lib")
require("default.hypr.look")
require("default.hypr.behavior")
require("default.hypr.rules")
nova.run_if_present(nova.state .. "/current/theme/hyprland.lua")

hl.monitor({ output = "", mode = "1920x1200", position = "0x0", scale = 1 })
hl.config({
  -- A picture is taken of windows at rest, not halfway through a fade.
  animations = { enabled = false },
  -- Nothing in the pictures is an X11 program.
  xwayland = { enabled = false },
  ecosystem = { no_update_news = true, no_donation_nag = true },
})

local shell_window = "^org\\.quickshell$"
nova.window("foot", { float = true, size = { 720, 440 }, move = { 44, 76 } })
nova.window({ class = shell_window, title = "^Settings$" }, { size = { 860, 620 }, move = { 180, 420 } })
nova.window({ class = shell_window, title = "^Calendar$" }, { size = { 1240, 900 }, move = { 560, 150 } })
nova.window({ class = shell_window, title = "^Calculator$" }, { move = { 1560, 170 } })
EOF

# labwc draws with the GPU where there is one it may use, and Hyprland with
# the one labwc names it; those of the caller's settings go in. GIO is kept to
# files and to memory: Hyprland's would otherwise start gvfs and dconf here.
renderer=()
for name in WLR_RENDERER WLR_RENDER_DRM_DEVICE LD_LIBRARY_PATH __EGL_VENDOR_LIBRARY_FILENAMES; do
  [[ -z ${!name:-} ]] || renderer+=("$name=${!name}")
done
env -i HOME="$work/home" XDG_RUNTIME_DIR="$work/run" LANG=C.UTF-8 TZ="${TZ:-Europe/Rome}" \
  GIO_USE_VFS=local GSETTINGS_BACKEND=memory \
  PATH="$work/bin:$root/usr/lib/nova/bin:$root/usr/bin:$PATH" \
  NOVA_PATH="$root/usr/share/nova" NOVA_BIN="$root/usr/lib/nova/bin" NOVA_LOGIN=password \
  DBUS_SYSTEM_BUS_ADDRESS=unix:path=/nonexistent/system-bus \
  "${renderer[@]}" WORK="$work" BACKDROP="$backdrop" SHELL_DIR="$root/usr/share/nova/shell" \
  timeout 240 dbus-run-session -- bash -c "$(declare -f session); session"

# Photographs of a screen are large as PNGs; as JPEGs at this quality they
# are a tenth of that and look the same.
save() { # shot, name
  vips copy "$work/shots/$1.png" "$out/$2.jpg[Q=88,strip,optimize_coding]"
}
save desktop desktop
save menu menu
save calendar calendar
save calculator calculator
save quicklook quicklook
# Four themes in one picture: the corner of each with the windows in it.
corners=()
for name in desktop theme-tokyo-night theme-catppuccin-latte theme-gruvbox; do
  vips crop "$work/shots/$name.png" "$work/shots/$name-corner.png" 0 0 1216 760
  corners+=("$work/shots/$name-corner.png")
done
vips arrayjoin "${corners[*]}" "$work/shots/themes.png" --across 2 --shim 16 --background "255 255 255"
vips resize "$work/shots/themes.png" "$out/themes.jpg[Q=88,strip,optimize_coding]" 0.78125
# And each corner on its own, for the site's theme picker (site/).
for name in desktop theme-tokyo-night theme-catppuccin-latte theme-gruvbox; do
  vips resize "$work/shots/$name-corner.png" "$out/corner-${name#theme-}.jpg[Q=86,strip,optimize_coding]" 0.78125
done
mv "$out/corner-desktop.jpg" "$out/corner-adaptive.jpg"
ls -l "$out"
