save() { # shot, dest-dir, name, [quality]
  vips copy "$work/shots/$1.png" "$2/$3.jpg[Q=${4:-86},strip,optimize_coding]"
}
save desktop "$out" desktop 86
save menu "$out" menu 86
save calendar "$out" calendar 86
save calculator "$out" calculator 86
save quicklook "$out" quicklook 86
save store "$out" store 86
save welcome "$out" welcome 86
[[ ! -f $work/shots/dictation.png ]] || save dictation "$out" dictation 86

# Four themes in one picture: the corner of each with the windows in it.
