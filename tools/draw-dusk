#!/usr/bin/env python3
"""draw-dusk: write docs/images/dusk.svg, the background in the documentation's
pictures: a lake at dusk, in flat layers.

    tools/draw-dusk

It is drawn rather than photographed so that it is Nova's own, to publish
under Nova's licence, and it is seeded, so it is the same each time. Its dusk
is what tools/screenshots gives the adaptive theme to take its colours from:
a deep blue for the surfaces, the sky's pink for the accent.
"""
import os
import random
W, H = 3840, 2400
HORIZON = 1500
rnd = random.Random(7)

def ridge(base, rough, peaks, seed, left=0, right=W, step=24):
    """A ridge line by midpoint displacement: y values across the width."""
    r = random.Random(seed)
    n = (right - left) // step + 1
    ys = [0.0] * n
    def fill(a, b, amp):
        if b - a < 2: return
        m = (a + b) // 2
        ys[m] = (ys[a] + ys[b]) / 2 + r.uniform(-amp, amp)
        fill(a, m, amp * rough); fill(m, b, amp * rough)
    ys[0] = r.uniform(-peaks, 0) * 0.3; ys[-1] = r.uniform(-peaks, 0) * 0.3
    fill(0, n - 1, peaks)
    return [(left + i * step, base + y) for i, y in enumerate(ys)]

def path(points, floor):
    d = "M%d,%d " % (points[0][0], floor) + " ".join("L%d,%.0f" % p for p in points) + " L%d,%d Z" % (points[-1][0], floor)
    return d

out = []
out.append(f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" viewBox="0 0 {W} {H}">')
out.append('''<defs>
<linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
<stop offset="0" stop-color="#141a3a"/><stop offset="0.28" stop-color="#2b2a5e"/><stop offset="0.52" stop-color="#6a3f86"/>
<stop offset="0.72" stop-color="#c9608f"/><stop offset="0.88" stop-color="#f29a7c"/><stop offset="1" stop-color="#ffd3a0"/>
</linearGradient>
<linearGradient id="water" x1="0" y1="0" x2="0" y2="1">
<stop offset="0" stop-color="#f0a487"/><stop offset="0.12" stop-color="#b65f8c"/><stop offset="0.4" stop-color="#4a3a78"/><stop offset="1" stop-color="#10152e"/>
</linearGradient>
<radialGradient id="glow" cx="0.5" cy="0.5" r="0.5">
<stop offset="0" stop-color="#fff1cf" stop-opacity="0.95"/><stop offset="0.25" stop-color="#ffc59a" stop-opacity="0.55"/><stop offset="1" stop-color="#ff9a8a" stop-opacity="0"/>
</radialGradient>
<linearGradient id="haze" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffb08f" stop-opacity="0"/><stop offset="1" stop-color="#ffb08f" stop-opacity="0.35"/></linearGradient>
<filter id="soft" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="38"/></filter>
<filter id="softer" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="14"/></filter>
</defs>''')
out.append(f'<rect width="{W}" height="{HORIZON}" fill="url(#sky)"/>')
# stars, thinning toward the horizon
for _ in range(260):
    x, y = rnd.uniform(0, W), rnd.uniform(0, HORIZON * 0.62) ** 1.0
    if rnd.random() < y / (HORIZON * 0.62): continue
    out.append(f'<circle cx="{x:.0f}" cy="{y:.0f}" r="{rnd.choice([1.6,1.6,2.2,2.2,3])}" fill="#fff" opacity="{rnd.uniform(0.25,0.85):.2f}"/>')
# clouds: long soft bands, lit from below
for i in range(9):
    cx, cy = rnd.uniform(200, W - 200), rnd.uniform(380, 1150)
    rx, ry = rnd.uniform(420, 980), rnd.uniform(26, 70)
    lit = cy / HORIZON
    color = "#ff9fb0" if lit > 0.55 else "#8a5fa8"
    out.append(f'<ellipse cx="{cx:.0f}" cy="{cy:.0f}" rx="{rx:.0f}" ry="{ry:.0f}" fill="{color}" opacity="{0.20 + 0.25*lit:.2f}" filter="url(#soft)"/>')
# the sun, low, right of centre
SX = 2480
out.append(f'<circle cx="{SX}" cy="{HORIZON-150}" r="640" fill="url(#glow)"/>')
out.append(f'<circle cx="{SX}" cy="{HORIZON-150}" r="84" fill="#fff3d6"/>')
# a thin moon
out.append('<path d="M1010,470 a70,70 0 1 0 58,112 a56,56 0 1 1 -58,-112z" fill="#f4ecff" opacity="0.9"/>')
out.append(f'<rect y="{HORIZON-420}" width="{W}" height="420" fill="url(#haze)"/>')
# far to near ridges
layers = [
    (HORIZON - 250, 0.58, 300, 11, "#8b5b96"),
    (HORIZON - 150, 0.60, 340, 23, "#5d4585"),
    (HORIZON - 60, 0.62, 300, 31, "#3a2f66"),
]
for base, rough, peaks, seed, color in layers:
    out.append(f'<path d="{path(ridge(base, rough, peaks, seed), HORIZON + 4)}" fill="{color}"/>')
# the water, with the sky's reflection and the sun's path
out.append(f'<rect y="{HORIZON}" width="{W}" height="{H-HORIZON}" fill="url(#water)"/>')
for base, rough, peaks, seed, color in layers[::-1][:2]:
    pts = ridge(base, rough, peaks, seed)
    refl = [(x, HORIZON + (HORIZON - y) * 0.55) for x, y in pts]
    d = "M0,%d " % HORIZON + " ".join("L%d,%.0f" % p for p in refl) + " L%d,%d Z" % (W, HORIZON)
    out.append(f'<path d="{d}" fill="{color}" opacity="0.55" filter="url(#softer)"/>')
out.append(f'<ellipse cx="{SX}" cy="{HORIZON+250}" rx="150" ry="330" fill="#ffd9a8" opacity="0.30" filter="url(#soft)"/>')
y = HORIZON + 10
for i in range(44):
    y += 5 + i * 0.9 + rnd.uniform(0, 6)
    spread = 40 + (y - HORIZON) * 0.42
    w = rnd.uniform(28, 46 + i * 5)
    x = SX + rnd.uniform(-spread, spread) - w / 2
    out.append(f'<rect x="{x:.0f}" y="{y:.0f}" width="{w:.0f}" height="{3.5 + i*0.12:.1f}" rx="2" fill="#ffe6c2" opacity="{max(0.08, 0.72 - (y-HORIZON)/1100):.2f}"/>')
# near shores, almost black, each running down into the water
def shore(points, toward_right):
    n = len(points)
    shaped = []
    for i, (x, y) in enumerate(points):
        t = i / (n - 1) if toward_right else 1 - i / (n - 1)
        shaped.append((x, y + (t ** 2.2) * 760))
    return shaped
out.append(f'<path d="{path(shore(ridge(HORIZON + 250, 0.55, 150, 47, 0, 1900), True), H)}" fill="#0c1024"/>')
out.append(f'<path d="{path(shore(ridge(HORIZON + 380, 0.55, 130, 53, 2500, W + 48), False), H)}" fill="#0c1024"/>')
out.append('</svg>')
target = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "docs", "images", "dusk.svg")
with open(target, "w") as f:
    f.write("\n".join(out) + "\n")
