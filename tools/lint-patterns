#!/bin/bash
# lint-patterns: kinds of bug that were found more than once, caught by the
# text that makes them, in Nova's own scripts, QML and JavaScript.
#
#   tools/lint-patterns [file...]
#   tools/lint-patterns --list
#
# With no files, every tracked file under src/, data/, installer/, theme/ and tools/
# that is a shell script (by its first line: a sh or bash #!, or shellcheck's
# `# shellcheck shell=` for one that is sourced), QML or JavaScript; finding
# none is an error, not a pass. --list prints those files and checks none
# (tests/unit/tools/shell-sources.bats takes the shell scripts from it).
# Prints each finding as file:line: what, and exits 1 if there was one.
#
#   locale    output a program translates (pactl's full listings and events,
#             lpstat, lpinfo, pacman -Qi/-Qk/-Si/-Qu) read without LC_ALL=C: under
#             another language its labels change and the parse finds nothing
#   exec      `exec {fd}>file 2>/dev/null`: exec keeps every redirection on the
#             line, so the script's stderr goes to /dev/null from there on;
#             `{ exec {fd}>file; } 2>/dev/null` is meant (a bare
#             `exec 2>/dev/null` says what it does, and passes)
#   grep      journalctl -g/--grep with no `||`, `if` or `!`: it exits 1 when
#             nothing matches, which under set -e and pipefail ends the script
#   patsub    a bare & in the replacement of ${var//pattern/replacement}: from
#             bash 5.2 it stands for the text matched (patsub_replacement); a
#             quoted or escaped one is the character
#   shadow    a property named state or data on a QML file's root object that
#             hides one of its own: Item.state, or the data the children go
#             in, which an Item and a Quickshell window have (not a QtObject,
#             Scope or Singleton) (docs/ARCHITECTURE.md, QML)
#   fullscreen
#             a window over the whole screen (a WlSessionLockSurface; a
#             PanelWindow, FloatingWindow or PopupWindow anchored or sized to
#             the screen both ways, `implicitWidth: screen.width`; or a file
#             whose root is one of these, used by its name with the rest)
#             whose own color is not "black" or "transparent", or that names
#             none (a Quickshell window is white by default): it shows before
#             what is in it is drawn, and a theme's colour there flashed
#             between the boot's black and the lock screen's picture (the
#             white of a light theme); what waits for a picture draws it when
#             it is ready (plugins/lock/LockView.qml). Objects are followed by
#             their braces, so indentation and comments (a /* */ over lines
#             too) do not matter, and one written on a line, or opened on
#             its parent's line, is read property by property. Text cannot
#             see: a window the compositor makes full screen (a rule, a
#             dispatch), a size or color worked out in a function, behind a
#             condition (`screen ? screen.width : 0`) or set from outside (a
#             state, a binding in another object), an object opened after a
#             property on the same line, and a file used by its name that is
#             not among those checked; of two files of one name in
#             different folders, a use of it away from both is taken for
#             the first whose root is a window
#   pipefail  in a script under pipefail (and in one that is sourced, which
#             runs under that of the script sourcing it), a command fed by a
#             pipe that stops reading before the end: head, grep -q/-l/-m,
#             sed with q, awk with an exit before its END, read. What still
#             writes to it dies of SIGPIPE and the pipeline exits 141: a list
#             that was printed reads as failure, `x=$(... | head -n 1)` ends
#             the script under set -e, and `if ... | grep -q` answers no when
#             it found. One that only prints passes inside <( ), in a $( )
#             whose value no plain assignment takes (quoted or not, after
#             && or if too; local, export and the like answer for
#             themselves), or in a pipeline followed by `|| true`; one whose
#             status is its answer (grep -q) never does, in a subshell too.
#             A q in a sed s command or address, an option-like argument
#             after --, and an exit in an awk string are no closers. Read to
#             the end instead
#             (`awk 'NR <= 25'`, `sed -n 1p`, `grep ... >/dev/null`,
#             `awk '... && !found++'`), or say why it is safe on the line, or
#             a comment line right above it:
#             `# lint-patterns: pipefail <why>`. A loop that breaks out of
#             `while read` fed by a pipe is not seen
#   process   a QML Process that destroys itself (or what holds it) once it
#             has exited, with no onRunningChanged: a command that cannot
#             start is never heard to exit, only to stop running, so each
#             such Process stays for good (docs/ARCHITECTURE.md, QML); a
#             destroy() in an object of its own (its stdout's) counts as
#             its. Text cannot see one destroyed from elsewhere, and takes a
#             destroy() of something else in its block (`onStarted:
#             old.destroy()`) for its own
#
# A statement is checked whole, at its first line: a shell line continued by
# a backslash or ended by a pipe, || or && (50 lines at most), and a QML
# command array over several lines. Each command of a shell statement is
# checked for locale on its own: one run with LC_ALL=C, or its output thrown
# away, says nothing of the next. A heredoc's lines are text, not commands.

set -euo pipefail

cd "$(dirname "$0")/.."

# The files checked when none are named, a line each.
default_files() {
  local file
  while IFS= read -r -d '' file; do
    case $file in
      *.qml | *.js) printf '%s\n' "$file" ;;
      *.md | *.json | *.jsonc | *.conf | *.lua | *.rs | *.toml | *.css | *.html | *.svg | *.png | *.jpg | *.txt) ;;
      *)
        if [[ -f $file ]] && head -n 1 -- "$file" | grep -E '^(#!.*\b(ba)?sh\b|# shellcheck shell=(ba)?sh\b)' >/dev/null; then
          printf '%s\n' "$file"
        fi
        ;;
    esac
  done < <(git ls-files -z src data installer theme tools)
}

if [[ ${1:-} == --list ]]; then
  default_files
  exit 0
fi

files=("$@")
if ((${#files[@]} == 0)); then
  mapfile -t files < <(default_files)
  if ((${#files[@]} == 0)); then
    echo "lint-patterns: found no files to check (is this a git checkout?)" >&2
    exit 2
  fi
fi

awk '
  function report(file, line, kind, what) {
    printf "%s:%d: %s: %s\n", file, line, kind, what
    found = 1
  }

  # How many more [ than ] in <s>, those in strings left out.
  function brackets(s,   open, shut) {
    gsub(/"([^"\\]|\\.)*"/, "", s)
    gsub(/\047([^\047\\]|\\.)*\047/, "", s)
    open = gsub(/\[/, "", s)
    shut = gsub(/\]/, "", s)
    return open - shut
  }

  # Whether pacman with these letters (its operation and options, without
  # the -) prints labels in the language of the user: -Qi, -Qk, -Si and -Qu
  # do; -Syu, -Su and the rest are run for the user to watch, and -Qqu prints
  # names alone.
  function translated(flags) {
    return (flags ~ /^Q/ && (flags ~ /[ik]/ || (flags ~ /u/ && flags !~ /q/))) || (flags ~ /^S/ && flags ~ /i/ && flags !~ /[uy]/)
  }

  function checkQml(file, line, text,   flags) {
    if (text ~ /LC_ALL=C/) return
    # pactl, with its options first ("-f", "json": the values are still its words).
    if (text ~ /"pactl"[^\]]*"(list|subscribe|info|stat|get-(sink|source)-(volume|mute))"/ && text !~ /"short"/)
      report(file, line, "locale", "pactl read in the user\047s language: run it with LC_ALL=C.UTF-8")
    if (text ~ /\[[^\]]*"(lpstat|lpinfo)"/)
      report(file, line, "locale", "CUPS read in the user\047s language: run it with LC_ALL=C.UTF-8")
    if (match(text, /"pacman"[[:space:]]*,[[:space:]]*"-[QS][A-Za-z]*"/)) {
      flags = substr(text, RSTART, RLENGTH)
      sub(/^.*"-/, "", flags)
      sub(/"$/, "", flags)
      if (translated(flags)) report(file, line, "locale", "pacman read in the user\047s language: run it with LC_ALL=C")
    }
  }

  # Whether a $( ) opened after <cur> is the value of a plain assignment
  # (x=$(…), x="…$(…)", after && or if as well), whose status is the
  # statement\047s: not one after local, declare, export or readonly, which
  # answer for themselves.
  function assigning(cur) {
    sub(/\$$/, "", cur)
    if (cur ~ /(^|[[:space:]])(local|declare|typeset|readonly|export)[[:space:]]/) return 0
    return cur ~ /(^|[[:space:]!])[A-Za-z_][A-Za-z0-9_]*(\[[^]]*\])?\+?=([^[:space:]"]*|[^[:space:]"]*"[^"]*)$/
  }

  # The commands of a shell statement, cut at each |, ||, &&, ; and & that
  # is code (not in quotes): segText[i], and whether a pipe feeds it
  # (segPiped), the innermost $( ) or <( ) it is in, if any, is a $( )
  # (segSub), one whose value is assigned (segAsg), or a <( ) (segProc), and
  # where in <s> it ends (segEnd). Returns how many.
  function segments(s,   i, c, n, top, kind, asg, k, cur, p, len, piped) {
    top = 0; kind[0] = "c"; k = 1; cur = ""
    segPiped[1] = 0; segSub[1] = 0; segProc[1] = 0; segAsg[1] = 0
    len = length(s)
    for (i = 1; i <= len; i++) {
      c = substr(s, i, 1)
      if (kind[top] == "s") { if (c == "\047") top--; cur = cur c; continue }
      if (c == "\\") { cur = cur substr(s, i, 2); i++; continue }
      if (kind[top] == "d") {
        if (c == "\"") top--
        else if (c == "$" && substr(s, i + 1, 1) == "(") { kind[++top] = "$"; asg[top] = assigning(cur); cur = cur "$("; i++; continue }
        cur = cur c; continue
      }
      if (c == "\047") kind[++top] = "s"
      else if (c == "\"") kind[++top] = "d"
      else if (c == "(") {
        p = substr(s, i - 1, 1)
        kind[++top] = (p == "$") ? "$" : (p == "<" || p == ">") ? "p" : "("
        asg[top] = (p == "$") ? assigning(cur) : 0
      } else if (c == ")") { if (top > 0) top-- }
      else if (c == "|" || c == ";" || c == "&" || c == "\n") {
        if (c == "&" && (substr(s, i + 1, 1) == ">" || substr(s, i - 1, 1) ~ /[<>]/)) { cur = cur c; continue }
        if (c == "|" && substr(s, i - 1, 1) == ">") { cur = cur c; continue }
        segText[k] = cur; segEnd[k] = i
        piped = (c == "|" && substr(s, i + 1, 1) != "|")
        if (c == "|" && substr(s, i + 1, 1) == "&") i++
        else if (substr(s, i + 1, 1) == c) i++
        k++; cur = ""; segPiped[k] = piped
        for (n = top; n >= 1; n--) if (kind[n] == "$" || kind[n] == "p") break
        segSub[k] = (n >= 1 && kind[n] == "$"); segProc[k] = (n >= 1 && kind[n] == "p")
        segAsg[k] = (segSub[k] && asg[n])
        continue
      }
      cur = cur c
    }
    segText[k] = cur; segEnd[k] = len + 1
    return k
  }

  # Whether a command reads its input to the end: "" when it does; "output"
  # when it stops early and only prints (head, grep -m, sed q, awk exit,
  # read); "status" when what it answers is its exit status (grep -q or -l,
  # an awk that exits early and again in its END).
  # <args> with what is quoted emptied, and cut at --: the options alone.
  function options(args) {
    gsub(/\047[^\047]*\047/, "\047\047", args)
    gsub(/"([^"\\]|\\.)*"/, "\"\"", args)
    sub(/(^|[[:space:]])--[[:space:]].*$/, "", args)
    sub(/(^|[[:space:]])--$/, "", args)
    return args
  }

  # A sed script with its s and y commands and its addresses emptied: a q
  # in what they match is no command.
  function sedCode(a) {
    gsub(/s\/[^\/]*\/[^\/]*\//, "s//", a)
    gsub(/s\|[^|]*\|[^|]*\|/, "s//", a)
    gsub(/s#[^#]*#[^#]*#/, "s//", a)
    gsub(/s,[^,]*,[^,]*,/, "s//", a)
    gsub(/s:[^:]*:[^:]*:/, "s//", a)
    gsub(/s@[^@]*@[^@]*@/, "s//", a)
    gsub(/y\/[^\/]*\/[^\/]*\//, "y//", a)
    gsub(/\/[^\/]*\//, "//", a)
    return a
  }

  # An awk program (what is in single quotes) with its strings and regular
  # expressions emptied: an exit in them is no statement.
  function awkCode(a,   i, c, out, single, len, last) {
    out = ""; single = 0; len = length(a); last = ""
    for (i = 1; i <= len; i++) {
      c = substr(a, i, 1)
      if (c == "\047") { single = !single; out = out c; last = c; continue }
      if (single && c == "\"") {
        for (i++; i <= len && substr(a, i, 1) != "\""; i++) if (substr(a, i, 1) == "\\") i++
        out = out "\"\""; last = "\""; continue
      }
      if (single && c == "/" && (last == "\047" || last ~ /[~(,!{};&|]/)) {
        for (i++; i <= len && substr(a, i, 1) != "/"; i++) if (substr(a, i, 1) == "\\") i++
        out = out "//"; last = "/"; continue
      }
      out = out c
      if (c !~ /[[:space:]]/) last = c
    }
    return out
  }

  function closer(seg,   w, cmd, args, opts, prog) {
    w = seg
    sub(/^[[:space:]!({]*/, "", w)
    sub(/^(command|exec|env)[[:space:]]+/, "", w)
    while (w ~ /^[A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+/) sub(/^[A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+/, "", w)
    cmd = w; sub(/[^A-Za-z0-9_.\/-].*$/, "", cmd); sub(/^.*\//, "", cmd)
    args = w; sub(/^[^[:space:])]*/, "", args)
    opts = options(args)
    if (cmd == "head") return (opts ~ /(-n[[:space:]]*|--lines=)-[0-9]/) ? "" : "output"
    if (cmd ~ /^(grep|egrep|fgrep)$/) {
      if (opts ~ /(^|[[:space:]])(-[A-Za-z]*[ql][A-Za-z]*|--quiet|--silent|--files-with-matches)([[:space:]]|$)/) return "status"
      if (opts ~ /(^|[[:space:]])(-[A-Za-z]*m|--max-count)/) return "output"
      return ""
    }
    if (cmd == "sed") return (sedCode(args) ~ /(^|[[:space:]\047";{}0-9$\/])[qQ][0-9]*([[:space:]\047";})]|$)/) ? "output" : ""
    if (cmd ~ /^(awk|gawk|mawk)$/) {
      args = awkCode(args)
      prog = args; sub(/END[[:space:]]*\{.*$/, "", prog)
      if (prog !~ /(^|[^A-Za-z0-9_])exit([^A-Za-z0-9_]|$)/) return ""
      return (args ~ /END[[:space:]]*\{.*exit/) ? "status" : "output"
    }
    if (cmd == "read") return "output"
    return ""
  }

  # Under pipefail, a command fed by a pipe that stops reading kills what
  # still writes to it (SIGPIPE), and the pipeline exits 141: a list that
  # ends in success, or a grep -q that found, reads as failure. One that
  # only prints is safe where its status is never looked at: in <( ), in a
  # $( ) that is not assigned, or followed by || true.
  function checkPipes(file, line, text,   n, i, j, kind) {
    # The patterns of a case arm (`a | b)`, each a word) are no pipe; a
    # subshell (`(a x | b)`) is.
    sub(/^[[:space:]]*\(?[[:space:]]*[^[:space:]()|;&]+([[:space:]]*\|[[:space:]]*[^[:space:]()|;&]+)*[[:space:]]*\)/, "", text)
    n = segments(text)
    for (i = 2; i <= n; i++) {
      if (!segPiped[i] || segProc[i]) continue
      kind = closer(segText[i])
      if (kind == "") continue
      # The end of its pipeline, where a || true would answer for it.
      for (j = i; j < n && segPiped[j + 1]; j++) ;
      if (kind == "output" && ((segSub[i] && !segAsg[i]) || substr(text, segEnd[j]) ~ /^[)[:space:]]*\|\|[[:space:]]*(true|:)([^A-Za-z0-9_]|$)/)) continue
      report(file, line, "pipefail", "a reader that stops early under pipefail kills what writes to it (exit 141): read to the end (awk \047NR <= n\047, sed -n 1p, grep ... >/dev/null), or say why it is safe: # lint-patterns: pipefail <why>")
      return
    }
  }

  function checkShell(file, line, text,   n, i, seg, segs, rest, flags, plain, opened, piece) {
    if (pipefail && !marked && text ~ /\|/) checkPipes(file, line, text)
    # Each command of the statement on its own.
    n = split(text, segs, /\|\||&&|;/)
    for (i = 1; i <= n; i++) {
      seg = segs[i]
      # Run in English, or its output thrown away: not read.
      if (seg ~ /LC_ALL=C/ || seg ~ /(^|[^0-9])>[[:space:]]*\/dev\/null/) continue
      if (seg ~ /(^|[^A-Za-z0-9_-])pactl([[:space:]]+(-f[[:space:]]*[a-z]+|--format=[a-z]+|-[sn][[:space:]]*[^-[:space:]][^[:space:]]*|--(server|client-name)=[^[:space:]]+))*[[:space:]]+(list|subscribe|info|stat|get-(sink|source)-(volume|mute))/ && seg !~ /[[:space:]]short([[:space:]]|$|\))/)
        report(file, line, "locale", "pactl read in the user\047s language: run it with LC_ALL=C.UTF-8")
      if (seg ~ /(^|[^A-Za-z0-9_-])(lpstat|lpinfo)[[:space:]]/)
        report(file, line, "locale", "CUPS read in the user\047s language: run it with LC_ALL=C.UTF-8")
      rest = seg
      while (match(rest, /(^|[^A-Za-z0-9_-])pacman[[:space:]]+-[QS][A-Za-z]*/)) {
        flags = substr(rest, RSTART, RLENGTH)
        sub(/^.*[[:space:]]-/, "", flags)
        if (translated(flags)) { report(file, line, "locale", "pacman read in the user\047s language: run it with LC_ALL=C"); break }
        rest = substr(rest, RSTART + RLENGTH)
      }
    }

    plain = text
    gsub(/<\([^)]*\)/, "", plain)
    if (plain ~ /2>[[:space:]]*\/dev\/null/) {
      opened = plain
      gsub(/2>[[:space:]]*\/dev\/null/, "", opened)
      if (opened ~ /^[[:space:]]*exec[[:space:]]+(\{[A-Za-z_][A-Za-z0-9_]*\}|[0-9]+)?[<>]/)
        report(file, line, "exec", "exec keeps 2>/dev/null for the rest of the script: { exec ...; } 2>/dev/null")
    }

    # The || has to come after it: one before it is for something else.
    if (match(text, /(^|[^A-Za-z0-9_-])journalctl[[:space:]]/) && text ~ /[[:space:]](-g|--grep(=|[[:space:]]))/ && substr(text, RSTART) !~ /\|\|/ && text !~ /^[[:space:]]*(if|while|until|!)[[:space:]]/)
      report(file, line, "grep", "journalctl -g exits 1 when nothing matches: add || true, or test it")

    if (text ~ /\$\{[A-Za-z_][A-Za-z0-9_]*\/\/?[^}\/]*\/([^}\\]|\\.)*&/) {
      rest = text
      while (match(rest, /\$\{[A-Za-z_][A-Za-z0-9_]*\/\/?[^}\/]*\/([^}\\]|\\.)*\}/)) {
        piece = substr(rest, RSTART, RLENGTH)
        sub(/^\$\{[A-Za-z_][A-Za-z0-9_]*\/\/?[^}\/]*\//, "", piece)
        gsub(/\\./, "", piece)
        # Quoted, & is the character.
        gsub(/"[^"]*"/, "", piece)
        gsub(/\047[^\047]*\047/, "", piece)
        if (piece ~ /&/) { report(file, line, "patsub", "a bare & in a replacement is the text matched (bash 5.2): write \\&"); break }
        rest = substr(rest, RSTART + RLENGTH)
      }
    }
  }

  # The statement joined so far, checked as it is: at the end of a file, or
  # one joined for too long.
  function flush() {
    if (joined == "") { marked = 0; return }
    if (qml) checkQml(file, start, joined)
    else checkShell(file, start, joined)
    joined = ""
    lines = 0
    marked = 0
  }

  # A line of QML as code: a comment at its end (// or /* */), outside the
  # strings, left out, and a /* */ over several lines (inBlock: one still
  # open at the line\047s end) left out whole.
  function uncomment(s,   i, c, q, n, rest) {
    if (inBlock) {
      if (!index(s, "*/")) return ""
      s = " " substr(s, index(s, "*/") + 2)
      inBlock = 0
    }
    n = length(s)
    for (i = 1; i <= n; i++) {
      c = substr(s, i, 1)
      if (q != "") {
        if (c == "\\") i++
        else if (c == q) q = ""
      } else if (c == "\"" || c == "\047" || c == "`") q = c
      else if (c == "/" && substr(s, i + 1, 1) == "/") return substr(s, 1, i - 1)
      else if (c == "/" && substr(s, i + 1, 1) == "*") {
        rest = substr(s, i + 2)
        if (!index(rest, "*/")) { inBlock = 1; return substr(s, 1, i - 1) }
        s = substr(s, 1, i - 1) " " substr(rest, index(rest, "*/") + 2)
        n = length(s)
      }
    }
    return s
  }

  # How many more { than } in <s>, those in strings left out.
  function braces(s) {
    gsub(/"([^"\\]|\\.)*"/, "", s)
    gsub(/\047([^\047\\]|\\.)*\047/, "", s)
    gsub(/`[^`]*`/, "", s)
    return gsub(/\{/, "", s) - gsub(/\}/, "", s)
  }

  # Whether an object of <type> with these edges anchored and this size
  # covers the whole screen: a lock surface always; another window when it
  # is anchored or sized to the screen both ways.
  function covers(type, top, bottom, left, right, wide, tall) {
    if (type == "WlSessionLockSurface") return 1
    return (wide || (left && right)) && (tall || (top && bottom))
  }

  function checkColor(file, line, value) {
    if (value == "")
      report(file, line, "fullscreen", "a window over the whole screen with no color is white until it is drawn: color: \"black\" or \"transparent\"")
    else if (value !~ /^"(black|transparent)"$/)
      report(file, line, "fullscreen", "a window over the whole screen shows its color before what is in it: color: \"black\" or \"transparent\", not " value)
  }

  # The object <n> on the stack, when its block closes: a window over the
  # whole screen must be black or transparent. Any other that sets an edge,
  # a size or a color may be a window by another name (a file whose root is
  # one): it is kept, to be looked at once every file has been read.
  function closeObject(n,   k, e) {
    if (objType[n] in windowType) {
      if (covers(objType[n], objEdge[n, "top"], objEdge[n, "bottom"], objEdge[n, "left"], objEdge[n, "right"], objWide[n], objTall[n]))
        checkColor(FILENAME, objLine[n], objColor[n])
    } else if (objSet[n]) {
      k = ++uses
      useType[k] = objType[n]; useFile[k] = FILENAME; useLine[k] = objLine[n]
      useDir[k] = FILENAME; sub(/[^\/]*$/, "", useDir[k])
      useColor[k] = objColor[n]; useWide[k] = objWide[n]; useTall[k] = objTall[n]
      for (e in edges) useEdge[k, e] = objEdge[n, e]
    }
    if (objType[n] == "Process" && objDestroys[n] && !objRunning[n])
      report(FILENAME, objLine[n], "process", "a Process that goes once it has exited stays for good when it cannot start, which only stops it running: end it in onRunningChanged too")
    if (n == 1) {
      # The root of the file: what a use of it by its name starts from.
      rootType[FILENAME] = objType[n]; rootColor[FILENAME] = objColor[n]
      rootWide[FILENAME] = objWide[n]; rootTall[FILENAME] = objTall[n]
      for (e in edges) rootEdge[FILENAME, e] = objEdge[n, e]
    }
  }

  # A line of the own properties of the object <n>: its anchors, its size and
  # its color.
  function ownProperty(n, text,   line, value) {
    if (text ~ /^[[:space:]]*anchors[[:space:]]*\{/) {
      countAnchors(n, text)
      if (braces(text) > 0) objAnchors[n] = objDepth[n] + 1
    } else if (text ~ /^[[:space:]]*anchors\.(top|bottom|left|right)[[:space:]]*:/) {
      line = text; sub(/anchors\./, "", line); countAnchors(n, line)
    } else if (match(text, /^[[:space:]]*(implicitWidth|width|implicitHeight|height)[[:space:]]*:[[:space:]]*/)) {
      value = substr(text, RSTART + RLENGTH); sub(/[[:space:]]*;?[[:space:]]*$/, "", value)
      sub(/[[:space:]]*(\?\?|\|\|)[[:space:]]*0$/, "", value)
      if (text ~ /^[[:space:]]*(implicitWidth|width)/ && value ~ /^([A-Za-z_][A-Za-z0-9_]*\??\.)*[A-Za-z_]*[Ss]creen\??\.width$/) { objWide[n] = 1; objSet[n] = 1 }
      if (text ~ /^[[:space:]]*(implicitHeight|height)/ && value ~ /^([A-Za-z_][A-Za-z0-9_]*\??\.)*[A-Za-z_]*[Ss]creen\??\.height$/) { objTall[n] = 1; objSet[n] = 1 }
    } else if (text ~ /^[[:space:]]*color[[:space:]]*:/) {
      value = text; sub(/^[[:space:]]*color[[:space:]]*:[[:space:]]*/, "", value); if (value !~ /^\{/) sub(/[[:space:]]*[;}].*$/, "", value); sub(/[[:space:]]*$/, "", value)
      objColor[n] = value; objSet[n] = 1
    }
  }

  # The own properties on a line of the object <n>, each on its own: those
  # after its opening brace, or a line of its block, cut at each ; that is
  # code (not in quotes, braces or brackets), and after a block of its own,
  # up to the brace that closes it.
  # Whether it hears that it stopped running, as a Process.
  function ownLine(n, text,   i, c, q, d, len, piece) {
    len = length(text); d = 0; q = ""; piece = ""
    for (i = 1; i <= len; i++) {
      c = substr(text, i, 1)
      if (q != "") { if (c == "\\") { piece = piece c substr(text, i + 1, 1); i++; continue } if (c == q) q = "" }
      else if (c == "\"" || c == "\047" || c == "`") q = c
      else if (c ~ /[{([]/) d++
      else if (c ~ /[})\]]/) {
        if (--d < 0) break
        # A block ends its property: `anchors { … } color: "red"`.
        if (d == 0 && c == "}") { ownPiece(n, piece c); piece = ""; continue }
      }
      else if (c == ";" && d == 0) { ownPiece(n, piece); piece = ""; continue }
      piece = piece c
    }
    ownPiece(n, piece)
  }

  function ownPiece(n, piece) {
    ownProperty(n, piece)
    if (piece ~ /^[[:space:]]*onRunningChanged[[:space:]]*:/) objRunning[n] = 1
  }

  # A destroy() in the block of the object <n> or of one in it: the nearest
  # Process around it is the one it ends, as far as text tells.
  function destroys(n,   k) {
    for (k = n; k >= 1; k--) if (objType[k] == "Process") { objDestroys[k] = 1; return }
  }

  # The anchors a line names, counted once each.
  function countAnchors(n, text,   edge) {
    for (edge in edges) if (text ~ ("(^|[^A-Za-z.])" edge "[[:space:]]*:[[:space:]]*true")) { objEdge[n, edge] = 1; objSet[n] = 1 }
  }

  # A use of a window by another name, once every file has been read: the
  # file whose root it is (beside the use first, else any of that name whose
  # root is a window, as an import would find it), the edges and size of its root
  # added to those of the use, its color unless the use sets one; a root that is
  # itself used by another name is followed on, a few names deep.
  function checkUses(   k, type, file, name, byName, f, hops, color, e, edge, wide, tall) {
    for (f in rootType) {
      name = f; sub(/^.*\//, "", name); sub(/\.qml$/, "", name)
      if (!(name in byName) || rootType[f] in windowType) byName[name] = f
    }
    for (k = 1; k <= uses; k++) {
      type = useType[k]; color = useColor[k]; wide = useWide[k]; tall = useTall[k]
      for (e in edges) edge[e] = useEdge[k, e]
      file = useDir[k] type ".qml"
      for (hops = 0; hops < 5 && !(type in windowType); hops++) {
        if (!(file in rootType)) {
          if (!(type in byName)) break
          file = byName[type]
        }
        if (color == "") color = rootColor[file]
        wide = wide || rootWide[file]; tall = tall || rootTall[file]
        for (e in edges) edge[e] = edge[e] || rootEdge[file, e]
        type = rootType[file]
        f = file; sub(/[^\/]*$/, "", f); file = f type ".qml"
      }
      if ((type in windowType) && covers(type, edge["top"], edge["bottom"], edge["left"], edge["right"], wide, tall))
        checkColor(useFile[k], useLine[k], color)
    }
  }

  BEGIN {
    edges["top"]; edges["bottom"]; edges["left"]; edges["right"]
    windowType["WlSessionLockSurface"]; windowType["PanelWindow"]; windowType["FloatingWindow"]; windowType["PopupWindow"]
    # A pipe that is safe as it is, and why.
    mark = "#[[:space:]]*lint-patterns:[[:space:]]*pipefail[[:space:]]+[^[:space:]]"
  }

  FNR == 1 {
    flush()
    file = FILENAME
    start = 0; root = ""; depth = 0; lines = 0; heredoc = ""; stripped = 0
    qml = FILENAME ~ /\.(qml|js)$/
    objs = 0; bdepth = 0; inBlock = 0
    pipefail = 0; marked = 0
  }

  # A file that is sourced (with `# shellcheck shell=` on its first
  # line) runs under the options of what sources it, in Nova set -euo pipefail.
  FNR == 1 && !qml && /^# shellcheck shell=/ {
    pipefail = 1
  }

  # A heredoc: text up to its word, not commands.
  !qml && heredoc != "" {
    word = $0
    if (stripped) sub(/^\t+/, "", word)
    if (word == heredoc) heredoc = ""
    next
  }

  # The type of the root object: the first object at the left margin.
  qml && root == "" && /^[A-Z][A-Za-z0-9_.]*[[:space:]]*\{/ { root = $1; sub(/\{.*/, "", root) }

  # A comment line, in either language.
  qml && /^[[:space:]]*\/\// { next }
  !qml && /^[[:space:]]*#/ { if ($0 ~ mark) marked = 1; next }

  # Objects, by the braces that open and close them: the name of a type opens
  # one (`Type {`, `name: Type {`, `component Name: Type {`, that of a property,
  # `property T name: Type {`), and the lines one brace in are its own,
  # however they are indented; what follows its brace on its line is too.
  qml && FILENAME ~ /\.qml$/ {
    text = $0
    if (inBlock || index(text, "//") || index(text, "/*")) text = uncomment(text)
    at = bdepth
    opener = "^[[:space:]]*(component[[:space:]]+[A-Za-z0-9_]+[[:space:]]*:[[:space:]]*|((readonly|required|default)[[:space:]]+)*property[[:space:]]+[A-Za-z_.<>]+[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*:[[:space:]]*|[a-z][A-Za-z0-9_.]*[[:space:]]*:[[:space:]]*)?[A-Z][A-Za-z0-9_.]*[[:space:]]*\\{"
    if (match(text, opener)) {
      # One object, or one opened in it on the same line, and so on.
      rest = text; deeper = 0
      while (match(rest, opener)) {
        type = substr(rest, RSTART, RLENGTH); sub(/[[:space:]]*\{$/, "", type); sub(/^.*[^A-Za-z0-9_.]/, "", type); sub(/^.*\./, "", type)
        rest = substr(rest, RSTART + RLENGTH)
        n = ++objs
        objType[n] = type; objLine[n] = FNR; objDepth[n] = at + 1 + deeper++; objColor[n] = ""
        objWide[n] = 0; objTall[n] = 0; objSet[n] = 0; objAnchors[n] = 0
        objDestroys[n] = 0; objRunning[n] = 0
        for (e in edges) objEdge[n, e] = 0
      }
      ownLine(n, rest)
      if (text ~ /destroy\(\)/) destroys(n)
    } else if (objs > 0) {
      n = objs
      if (objAnchors[n] && at >= objAnchors[n]) countAnchors(n, text)
      else if (at == objDepth[n]) ownLine(n, text)
      # A Process: whether it ends itself, in a handler or a function of
      # its own, or an object of its own does.
      if (text ~ /destroy\(\)/) destroys(n)
    }
    bdepth += braces(text)
    while (objs > 0 && bdepth < objDepth[objs]) { closeObject(objs); objs-- }
    if (objs > 0 && objAnchors[objs] && bdepth < objAnchors[objs]) objAnchors[objs] = 0
  }

  qml {
    # Properties of the root object, two spaces in. An Item has both; a
    # Quickshell window has data alone; a QtObject, Scope or Singleton
    # neither.
    if (root !~ /^(QtObject|Scope|Singleton)$/ && $0 ~ /^  ((readonly|required|default)[[:space:]]+)*property[[:space:]]+[A-Za-z_.<>]+[[:space:]]+(state|data)([[:space:]]*:|[[:space:]]*$)/) {
      name = $0; sub(/[[:space:]]*:.*$/, "", name); sub(/^.*[[:space:]]/, "", name)
      if (name == "data" || root !~ /(PanelWindow|FloatingWindow|PopupWindow)$/)
        report(FILENAME, FNR, "shadow", "a property named " name " on the root hides the root\047s own: name it for what it holds")
    }
    # A command array, until its brackets close.
    if (joined == "") {
      if ($0 ~ /command[[:space:]]*[:=][[:space:]]*\[/ && brackets($0) > 0) {
        start = FNR; joined = $0 " "; depth = brackets($0); lines = 1
        next
      }
      checkQml(FILENAME, FNR, $0)
      next
    }
    depth += brackets($0)
    joined = joined $0 " "
    if (depth > 0 && ++lines < 50) next
    flush()
    next
  }

  {
    if (joined == "") start = FNR
    if ($0 ~ /^[[:space:]]*set[[:space:]]+[^#]*-[A-Za-z]*o[[:space:]]+pipefail/) pipefail = 1
    if ($0 ~ /^[[:space:]]*set[[:space:]]+[^#]*\+o[[:space:]]+pipefail/) pipefail = 0
    if ($0 ~ mark) marked = 1
    # The line as code, a comment at its end left out.
    body = $0
    sub(/[[:space:]]#[^"\047]*$/, "", body)
    # A heredoc begins here: this line is the last of the statement, and the
    # lines after it are text.
    if (match(body, /(^|[^<])<<-?[[:space:]]*["\047\\]?[A-Za-z_][A-Za-z0-9_]*/)) {
      heredoc = substr(body, RSTART, RLENGTH)
      stripped = heredoc ~ /<<-/
      sub(/^[^<]*<<-?[[:space:]]*["\047\\]?/, "", heredoc)
      joined = joined body
      flush()
      next
    }
    # Continued with a backslash, or ended by a pipe, || or &&: the rest is
    # on the next line.
    if (body ~ /\\$/ && ++lines < 50) { joined = joined substr(body, 1, length(body) - 1) " "; next }
    if (body ~ /(\||&&)[[:space:]]*$/ && ++lines < 50) { joined = joined body " "; next }
    joined = joined body
    flush()
  }

  END { flush(); checkUses(); exit found }
' "${files[@]}"
