#!/bin/bash
# lint-patterns: kinds of bug that were found more than once, caught by the
# text that makes them, in Nova's own scripts, QML and JavaScript.
#
#   tools/lint-patterns [file...]
#
# With no files, every tracked file under src/, data/, installer/ and tools/
# that is a shell script (by its first line: a sh or bash #!, or shellcheck's
# `# shellcheck shell=` for one that is sourced), QML or JavaScript; finding
# none is an error, not a pass. Prints each finding as file:line: what, and
# exits 1 if there was one.
#
#   locale    output a program translates (pactl's full listings and events,
#             lpstat, lpinfo, pacman -Qi/-Qk/-Si/-Qu) read without LC_ALL=C: under
#             another language its labels change and the parse finds nothing
#   exec      `exec {fd}>file 2>/dev/null`: exec keeps every redirection on the
#             line, so the script's stderr goes to /dev/null from there on;
#             `{ exec {fd}>file; } 2>/dev/null` is meant (a bare
#             `exec 2>/dev/null` says what it does, and passes)
#   grep      journalctl -g/--grep with no `||`, `if` or `!`: it exits 1 when
#             nothing matches, which under set -e and pipefail ends the script
#   patsub    a bare & in the replacement of ${var//pattern/replacement}: from
#             bash 5.2 it stands for the text matched (patsub_replacement); a
#             quoted or escaped one is the character
#   shadow    a property named state or data on a QML file's root object that
#             hides one of its own: Item.state, or the data the children go
#             in, which an Item and a Quickshell window have (not a QtObject,
#             Scope or Singleton) (docs/ARCHITECTURE.md, QML)
#
# A statement is checked whole, at its first line: a shell line continued by
# a backslash or ended by a pipe, || or &&, and a QML command array over
# several lines.

set -euo pipefail

cd "$(dirname "$0")/.."

files=("$@")
if ((${#files[@]} == 0)); then
  while IFS= read -r -d '' file; do
    case $file in
      *.qml | *.js) files+=("$file") ;;
      *.md | *.json | *.jsonc | *.conf | *.lua | *.rs | *.toml | *.css | *.html | *.svg | *.png | *.jpg | *.txt) ;;
      *) [[ -f $file ]] && head -n 1 -- "$file" | grep -qE '^(#!.*\b(ba)?sh\b|# shellcheck shell=(ba)?sh\b)' && files+=("$file") ;;
    esac
  done < <(git ls-files -z src data installer tools)
  if ((${#files[@]} == 0)); then
    echo "lint-patterns: found no files to check (is this a git checkout?)" >&2
    exit 2
  fi
fi

awk '
  FNR == 1 {
    joined = ""; start = 0; root = ""; depth = 0
    qml = FILENAME ~ /\.(qml|js)$/
  }
  # The type of the root object: the first object at the left margin.
  qml && root == "" && /^[A-Z][A-Za-z0-9_.]*[[:space:]]*\{/ { root = $1; sub(/\{.*/, "", root) }
  function report(line, kind, what) {
    printf "%s:%d: %s: %s\n", FILENAME, line, kind, what
    found = 1
  }
  # How many more [ than ] in <s>.
  function brackets(s,   open, shut) {
    open = gsub(/\[/, "[", s); shut = gsub(/\]/, "]", s)
    return open - shut
  }
  # A comment line, in either language.
  qml && /^[[:space:]]*\/\// { next }
  !qml && /^[[:space:]]*#/ { next }
  {
    text = $0
    if (!qml) {
      # Continued with a backslash, or ended by a pipe, || or &&: the rest is
      # on the next line.
      if (joined == "") start = FNR
      if (text ~ /\\$/) { joined = joined substr(text, 1, length(text) - 1) " "; next }
      if (text ~ /(\||&&)[[:space:]]*$/) { joined = joined text " "; next }
      text = joined text
      joined = ""
    } else {
      # A command array, until its brackets close.
      if (joined == "") {
        start = FNR
        if (text ~ /command:[[:space:]]*\[/ && brackets(text) > 0) { joined = text " "; depth = brackets(text); next }
      } else {
        depth += brackets(text)
        joined = joined text " "
        if (depth > 0) next
        text = joined
        joined = ""
      }
    }

    if (qml) {
      if (text ~ /"(pactl)"[[:space:]]*,[[:space:]]*"(list|subscribe|info|stat|get-(sink|source)-(volume|mute))"/ && text !~ /"(short)"/ && text !~ /LC_ALL=C/)
        report(start, "locale", "pactl read in the user'"'"'s language: run it with LC_ALL=C.UTF-8")
      if (text ~ /"(lpstat|lpinfo)"/ && text !~ /LC_ALL=C/)
        report(start, "locale", "CUPS read in the user'"'"'s language: run it with LC_ALL=C.UTF-8")
      # Properties of the root object, two spaces in. An Item has both; a
      # Quickshell window has data alone; a QtObject, Scope or Singleton
      # neither.
      if (root !~ /^(QtObject|Scope|Singleton)$/ && text ~ /^  ((readonly|required|default)[[:space:]]+)*property[[:space:]]+[A-Za-z_.<>]+[[:space:]]+(state|data)([[:space:]]*:|[[:space:]]*$)/) {
        name = text; sub(/[[:space:]]*:.*$/, "", name); sub(/^.*[[:space:]]/, "", name)
        if (name == "data" || root !~ /(PanelWindow|FloatingWindow|PopupWindow)$/)
          report(start, "shadow", "a property named " name " on the root hides the root'"'"'s own: name it for what it holds")
      }
      next
    }

    # Output thrown away is not read.
    discarded = text ~ /(^|[^0-9])>[[:space:]]*\/dev\/null/
    # pactl with its options first (-f json: the values are still its words).
    if (!discarded && text ~ /(^|[^A-Za-z0-9_-])pactl([[:space:]]+(-f[[:space:]]*[a-z]+|--format=[a-z]+|-[sn][[:space:]]*[^-[:space:]][^[:space:]]*|--(server|client-name)=[^[:space:]]+))*[[:space:]]+(list|subscribe|info|stat|get-(sink|source)-(volume|mute))/ && text !~ /[[:space:]]short([[:space:]]|$|\))/ && text !~ /LC_ALL=C/)
      report(start, "locale", "pactl read in the user'"'"'s language: run it with LC_ALL=C.UTF-8")
    if (!discarded && text ~ /(^|[^A-Za-z0-9_-])(lpstat|lpinfo)[[:space:]]/ && text !~ /LC_ALL=C/)
      report(start, "locale", "CUPS read in the user'"'"'s language: run it with LC_ALL=C.UTF-8")
    # pacman -Qi, -Qk, -Si and -Qu print labels in the language of the user;
    # -Syu, -Su and the rest are run for the user to watch, and -Qqu prints
    # names.
    if (!discarded && text !~ /LC_ALL=C/ && match(text, /(^|[^A-Za-z0-9_-])pacman[[:space:]]+-[QS][A-Za-z]*/)) {
      flags = substr(text, RSTART, RLENGTH); sub(/^.*[[:space:]]-/, "", flags)
      if ((flags ~ /^Q/ && (flags ~ /[ik]/ || (flags ~ /u/ && flags !~ /q/))) || (flags ~ /^S/ && flags ~ /i/ && flags !~ /[uy]/))
        report(start, "locale", "pacman read in the user'"'"'s language: run it with LC_ALL=C")
    }

    plain = text
    gsub(/<\([^)]*\)/, "", plain)
    if (plain ~ /2>[[:space:]]*\/dev\/null/) {
      opened = plain
      gsub(/2>[[:space:]]*\/dev\/null/, "", opened)
      if (opened ~ /^[[:space:]]*exec[[:space:]]+(\{[A-Za-z_][A-Za-z0-9_]*\}|[0-9]+)?[<>]/)
        report(start, "exec", "exec keeps 2>/dev/null for the rest of the script: { exec ...; } 2>/dev/null")
    }

    # The || has to come after it: one before it is for something else.
    if (match(text, /(^|[^A-Za-z0-9_-])journalctl[[:space:]]/) && text ~ /[[:space:]](-g|--grep(=|[[:space:]]))/ && substr(text, RSTART) !~ /\|\|/ && text !~ /^[[:space:]]*(if|while|until|!)[[:space:]]/)
      report(start, "grep", "journalctl -g exits 1 when nothing matches: add || true, or test it")

    if (text ~ /\$\{[A-Za-z_][A-Za-z0-9_]*\/\/?[^}\/]*\/([^}\\]|\\.)*&/) {
      rest = text
      while (match(rest, /\$\{[A-Za-z_][A-Za-z0-9_]*\/\/?[^}\/]*\/([^}\\]|\\.)*\}/)) {
        piece = substr(rest, RSTART, RLENGTH)
        sub(/^\$\{[A-Za-z_][A-Za-z0-9_]*\/\/?[^}\/]*\//, "", piece)
        gsub(/\\./, "", piece)
        # Quoted, & is the character.
        gsub(/"[^"]*"/, "", piece)
        gsub("\047[^\047]*\047", "", piece)
        if (piece ~ /&/) { report(start, "patsub", "a bare & in a replacement is the text matched (bash 5.2): write \\&"); break }
        rest = substr(rest, RSTART + RLENGTH)
      }
    }
  }
  END { exit found }
' "${files[@]}"
