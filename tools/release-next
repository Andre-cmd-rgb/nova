#!/bin/bash
# release-next: the tag the next release candidate gets, from the tags there are.
#
#   tools/release-next [--stdin]
#
# A candidate continues the newest version that is not final yet: after
# v1.0.0-beta.3 comes v1.0.0-beta.4, after v1.1.0-rc.1 comes v1.1.0-rc.2. Once
# the newest is final (v1.1.0), the next candidate starts the next minor
# version, v1.2.0-rc.1; with no tags at all, it is v1.0.0-beta.1. The tags come
# from `git tag`, or one per line on stdin with --stdin.
set -euo pipefail

case ${1:-} in
  --stdin) tags=$(cat) ;;
  "") tags=$(git tag --list 'v*') ;;
  *) sed -n '2,/^set /p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2 ;;
esac

# major minor patch stage n name, where stage orders beta < rc < final.
newest=$(awk '/^v[0-9]+\.[0-9]+\.[0-9]+(-(beta|rc)\.[0-9]+)?$/ {
    split(substr($0, 2), part, /[.-]/)
    stage = part[4] == "" ? 2 : part[4] == "rc" ? 1 : 0
    printf "%d %d %d %d %d %s\n", part[1], part[2], part[3], stage, part[5], part[4]
  }' <<<"$tags" | sort -k1,1n -k2,2n -k3,3n -k4,4n -k5,5n | tail -n 1)

if [[ -z $newest ]]; then
  echo v1.0.0-beta.1
  exit 0
fi
read -r major minor patch stage n name <<<"$newest"
if ((stage == 2)); then
  echo "v$major.$((minor + 1)).0-rc.1"
else
  echo "v$major.$minor.$patch-$name.$((n + 1))"
fi
