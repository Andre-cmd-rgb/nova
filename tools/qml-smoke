#!/bin/bash
# qml-smoke: open each of the shell's windows offscreen and fail on any QML
# warning or error, which qmllint cannot see: a property that shadows one of
# Item's, a singleton that resolves to the wrong type, a binding to undefined.
#
#   tools/qml-smoke --root <dir> [--shots <dir>] [--theme <name>]
#
# --root is a `make install DESTDIR=<dir>` tree, so the windows run the
# installed commands (nova-settings state, the plugins' own helpers). Each
# window runs in a scratch home under Qt's offscreen platform, with no system
# bus and the modem helper stubbed: no compositor, no radios,
# nothing of the real session touched. --shots saves a PNG of every page.

set -euo pipefail

usage() { sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; }

repo=$(cd "$(dirname "$0")/.." && pwd)
root='' shots='' theme=white
while (($# > 0)); do
  case $1 in
    --root) root=${2:?}; shift 2 ;;
    --shots) shots=${2:?}; shift 2 ;;
    --theme) theme=${2:?}; shift 2 ;;
    -h | --help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
[[ -n $root && -d $root/usr/share/nova/shell ]] || { usage >&2; exit 2; }
command -v qs >/dev/null || { echo "qml-smoke: needs quickshell (qs)" >&2; exit 1; }
root=$(cd "$root" && pwd)
palette=$repo/theme/palettes/$theme
[[ -f $palette/colors.toml ]] || { echo "qml-smoke: no theme '$theme'" >&2; exit 2; }
background=$(sed -n -E 's/^background *= *"(#[0-9a-fA-F]{6})".*/\1/p' "$palette/colors.toml")

# plugin: the pages to open (one shot each), "-" for a window without pages
windows=(
  "settings:wifi bluetooth mobile-data sound battery screentime appearance bar lock apps updates about"
)

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/home" "$work/run" "$work/out" "$work/shell/plugins" "$work/stub"
chmod 700 "$work/run"
# No compositor here: hyprctl answers as it does with no Hyprland running,
# whether or not this machine has one installed.
printf '#!/bin/sh\necho "HYPRLAND_INSTANCE_SIGNATURE not set! (is hyprland running?)" >&2\nexit 1\n' >"$work/stub/hyprctl"
# The real one asks the modem, and the first start it decides on can switch
# the radio off; this one is a modem on a network, so its page shows the most.
cat >"$work/stub/nova-mobile-data" <<'EOF'
#!/bin/sh
[ "$1" = info ] || exit 0
printf '%s\n' hw=yes state=connected managed=yes profile=smoke operator=Smoke tech=5G signal=70 \
  iface=wwan0 ip=10.0.0.2 used_bytes=123456789 next_reset=2026-11-01
EOF
chmod +x "$work/stub/hyprctl" "$work/stub/nova-mobile-data"
# Screen Time on, with a day recorded, so its page draws the chart and the
# apps rather than only its switch.
mkdir -p "$work/home/.config/nova" "$work/home/.local/state/nova-screentime/days"
jq '.bar.layout.right += [{ id: "nova.screentime" }]' "$root/usr/share/nova/default/shell.json" \
  >"$work/home/.config/nova/shell.json"
printf 'foot\t9\t1500\nfoot\t10\t2400\ngoogle-chrome\t10\t900\norg.gnome.Nautilus\t11\t300\n' \
  >"$work/home/.local/state/nova-screentime/days/$(date +%F).tsv"
ln -s "$root/usr/share/nova/shell/Commons" "$work/shell/Commons"
ln -s "$root/usr/share/nova/shell/Ui" "$work/shell/Ui"

# A shell that loads one window, opens it, and grabs each page after it has
# had time to load its state, then opens it once more with no page asked for.
# A window that never appears, or that opens again where it was left, is a
# warning, which fails the run like any other, and ends it there.
harness() { # plugin
  cat <<EOF
import QtQuick
import Quickshell
import "plugins/$1"

ShellRoot {
  id: harness
  property var pages: Quickshell.env("SMOKE_PAGES").split(" ")
  property int index: 0
  property bool backed: false

  Panel { id: window }

  function floating(item) {
    for (var i = 0; i < item.data.length; i++)
      if (item.data[i] && item.data[i].contentItem !== undefined) return item.data[i]
    return null
  }

  Timer {
    id: shot
    interval: 1500
    onTriggered: {
      var floating = harness.floating(window)
      if (!floating || !floating.visible) {
        console.warn("qml-smoke: the window did not open")
        Qt.quit()
        return
      }
      var target = floating.contentItem.children[0]
      if (!harness.backed) {
        Qt.createQmlObject('import QtQuick; Rectangle { anchors.fill: parent; z: -1; color: "' + Quickshell.env("SMOKE_BG") + '" }', target)
        harness.backed = true
      }
      target.grabToImage(function (result) {
        result.saveToFile(Quickshell.env("SMOKE_OUT") + "/" + harness.pages[harness.index] + ".png")
        harness.index++
        if (harness.index < harness.pages.length) {
          window.page = harness.pages[harness.index]
          shot.restart()
        } else {
          // Opened again with no page asked for, it starts over at the first
          // it offers rather than staying on the last: Wi-Fi, or on a
          // computer with no radios, as in CI, Sound.
          window.open("")
          if (window.page !== window.pages[0].id)
            console.warn("qml-smoke: opened again, the window shows " + window.page + ", not " + window.pages[0].id)
          Qt.quit()
        }
      })
    }
  }

  Component.onCompleted: {
    window.open(JSON.stringify({ page: pages[0] }))
    shot.start()
  }
}
EOF
}

failed=0
for entry in "${windows[@]}"; do
  plugin=${entry%%:*} pages=${entry#*:}
  [[ $pages == - ]] && pages=$plugin
  ln -sfn "$root/usr/share/nova/shell/plugins/$plugin" "$work/shell/plugins/$plugin"
  harness "$plugin" >"$work/shell/$plugin.qml"
  rm -rf "$work/run/quickshell" "$work/out"/*
  status=0
  # A system bus that is not there: Bluetooth, Wi-Fi and the battery come
  # from it, and the pages would scan with the real radios.
  env -i HOME="$work/home" XDG_RUNTIME_DIR="$work/run" LANG=C.UTF-8 \
    DBUS_SYSTEM_BUS_ADDRESS="unix:path=$work/run/no-system-bus" \
    PATH="$work/stub:$root/usr/lib/nova/bin:$root/usr/bin:/usr/bin" \
    NOVA_PATH="$root/usr/share/nova" NOVA_BIN="$root/usr/lib/nova/bin" NOVA_THEME_DIR="$palette" \
    QT_QPA_PLATFORM=offscreen SMOKE_PAGES="$pages" SMOKE_OUT="$work/out" SMOKE_BG="$background" \
    timeout 90 qs --no-color -p "$work/shell/$plugin.qml" >/dev/null 2>&1 || status=$?
  # The locale and window-mask lines are the offscreen platform's, the
  # PipeWire one the scratch session's, which has no sound server, and the
  # Bluetooth and network ones its missing system bus: not ours.
  problems=$(env -i HOME="$work/home" XDG_RUNTIME_DIR="$work/run" PATH=/usr/bin \
    qs log --no-color -p "$work/shell/$plugin.qml" 2>&1 |
    grep -E '^ *(WARN|ERROR|CRIT|FATAL)' |
    grep -vE 'Detected locale|window masks|pipewire context|quickshell\.(bluetooth|network\.networkmanager): Could not connect to DBus|quickshell\.network: Network will not work' || true)
  shot_count=$(find "$work/out" -name '*.png' | wc -l)
  if ((status != 0)) || [[ -n $problems ]] || ((shot_count != $(wc -w <<<"$pages"))); then
    echo "FAIL $plugin (exit $status, $shot_count of $(wc -w <<<"$pages") pages)"
    [[ -z $problems ]] || while IFS= read -r line; do echo "  $line"; done <<<"$problems"
    failed=1
  else
    echo "ok   $plugin ($shot_count pages)"
  fi
  if [[ -n $shots ]]; then
    mkdir -p "$shots/$plugin"
    cp "$work/out"/*.png "$shots/$plugin/" 2>/dev/null || true
  fi
done
exit "$failed"
