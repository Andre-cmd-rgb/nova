#!/bin/bash
# Write release.toml: the facts that tie a Nova release to the Arch snapshot it
# was built and tested against, and to the Arch Linux ARM set its Raspberry Pi
# build pins.
#
#   tools/release-pin --version 1.0.0-beta.1 [options]
#
#   --version V   release version, with or without a leading "v". Defaults to the
#                 tag that points at HEAD.
#   --date D      Arch Linux Archive date, YYYY/MM/DD. Defaults to today (UTC). CI
#                 passes the date it built against, so the pin is the build's truth.
#   --packages U  where Nova's package repositories are, one folder per release
#                 under it (the nova-packages bucket on Cloudflare R2). Defaults to
#                 https://nova-packages.piserver.stream
#   --alarm-date D  the day the release's Arch Linux ARM packages were pinned
#                 (tools/alarm-pin), YYYY/MM/DD: a release with a Raspberry Pi
#                 build. Arch Linux ARM has no archive, so the date only says
#                 when; the packages are the release's own.
#   --alarm-pool U  where the files of those packages are, which releases share.
#                 Defaults to <packages>/alarm/aarch64
#   --out FILE    where to write. Defaults to ./release.toml
#   --verify      check that the Archive has a snapshot for the date (needs network)
#
# `nova update` and the installer read the result; see docs/releasing.md.
set -euo pipefail

die() { printf 'release-pin: %s\n' "$*" >&2; exit 1; }

version=
date=
alarm_date=
alarm_pool=
packages=https://nova-packages.piserver.stream
out=release.toml
verify=0

while (( $# )); do
  case $1 in
    --version) version=${2:?--version needs a value}; shift 2 ;;
    --date)    date=${2:?--date needs a value}; shift 2 ;;
    --packages) packages=${2:?--packages needs a value}; shift 2 ;;
    --alarm-date) alarm_date=${2:?--alarm-date needs a value}; shift 2 ;;
    --alarm-pool) alarm_pool=${2:?--alarm-pool needs a value}; shift 2 ;;
    --out)     out=${2:?--out needs a value}; shift 2 ;;
    --verify)  verify=1; shift ;;
    -h|--help) sed -n '2,/^set /p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown argument: $1 (try --help)" ;;
  esac
done

if [[ -z $version ]]; then
  version=$(git describe --tags --exact-match 2>/dev/null) ||
    die "no --version given and HEAD is not at a tag"
fi
version=${version#v}
[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$ ]] ||
  die "version must look like 1.0.0 or 1.0.0-beta.1, got: $version"

calendar_date() { # option value
  [[ $2 =~ ^[0-9]{4}/[0-9]{2}/[0-9]{2}$ ]] || die "$1 must be YYYY/MM/DD, got: $2"
  # Reject dates that match the pattern but do not exist (2026/02/31).
  [[ $(date -u -d "${2//\//-}" +%Y/%m/%d 2>/dev/null) == "$2" ]] || die "not a calendar date: $2"
}
https_address() { # option value
  [[ $2 =~ ^https://[A-Za-z0-9.-]+(/[A-Za-z0-9._~%-]+)*$ ]] || die "$1 must be an https:// address, got: $2"
}

[[ -n $date ]] || date=$(date -u +%Y/%m/%d)
calendar_date --date "$date"
packages=${packages%/}
https_address --packages "$packages"
if [[ -n $alarm_date ]]; then
  calendar_date --alarm-date "$alarm_date"
  alarm_pool=${alarm_pool:-$packages/alarm/aarch64}
  alarm_pool=${alarm_pool%/}
  https_address --alarm-pool "$alarm_pool"
elif [[ -n $alarm_pool ]]; then
  die "--alarm-pool goes with --alarm-date"
fi

if (( verify )); then
  url="https://archive.archlinux.org/repos/$date/core/os/x86_64/core.db"
  curl -fsSI --retry 3 --connect-timeout 10 --max-time 60 -o /dev/null "$url" ||
    die "no Arch Linux Archive snapshot for $date ($url)"
fi

tmp=$(mktemp "$out.XXXXXX")
trap 'rm -f "$tmp"' EXIT
cat > "$tmp" <<EOF
# Written by tools/release-pin. Read by \`nova update\` and the installer.
version = "$version"
arch_date = "$date"
nova_repo = "$packages/v$version"
EOF
if [[ -n $alarm_date ]]; then
  printf 'alarm_date = "%s"\nalarm_pool = "%s"\n' "$alarm_date" "$alarm_pool" >>"$tmp"
fi
chmod 644 "$tmp"
mv "$tmp" "$out"
trap - EXIT
printf 'release-pin: wrote %s (version %s, Arch snapshot %s%s)\n' "$out" "$version" "$date" \
  "${alarm_date:+, Arch Linux ARM of $alarm_date}" >&2
