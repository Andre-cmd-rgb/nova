#!/bin/bash
#
# Put the current Omarchy wallpaper behind the boot splash.
#
#   omarchy-splash-wallpaper [--theme <slug>] [--force] [--home <dir>]
#
# Omarchy's own omarchy-plymouth-set paints the splash a flat theme colour and
# centres the theme's unlock.png on it — so the first thing you see is a logo on
# a colour, not the wallpaper you picked. This puts the wallpaper there and
# drops the logo.
#
# The login screen deliberately does not get the wallpaper. The password box
# sits in the middle of the screen, which is exactly where a wallpaper's
# branding sits, so the two land on top of each other. It gets the theme
# background as a flat colour instead, with the logo dropped, which leaves the
# password box alone on it.
#
# Plymouth lives in the initramfs, so a wallpaper change costs a rebuild of it
# (about a minute). That is why this checks whether anything actually changed
# before doing any work: it is wired to a path unit that fires on every
# wallpaper change, including the ones that changed nothing.
#
# It also fixes the login screen's colours. omarchy-plymouth-set writes them
# with two sequential seds:
#
#     sed -e "s/#1a1b26/#$bg_hex/g" -e "s/#ffffff/#$text_hex/g"
#
# On a theme whose background is #ffffff the first expression writes that value
# and the second one rewrites it to the foreground — so the White theme gets a
# black login screen. The substitution here goes through placeholders instead.

set -uo pipefail

# Overridable so the suite can drive the real transformations against fixture
# directories instead of /usr/share, the way LIMINE_CONF does for the menu.
PLY_DIR=${OMARCHY_PLYMOUTH_DIR:-/usr/share/plymouth/themes/omarchy}
SDDM_DIR=${OMARCHY_SDDM_DIR:-/usr/share/sddm/themes/omarchy}
STAMP_DIR=${OMARCHY_BOOT_THEME_STATE:-/var/lib/omarchy-boot-theme}
STAMP=$STAMP_DIR/splash.stamp
MARK_BEGIN='# >>> omarchy-boot-theme >>>'
MARK_END='# <<< omarchy-boot-theme <<<'
QML_MARK='// omarchy-boot-theme: plain background, no logo'
# A 4K photo re-encoded as PNG can run to tens of megabytes, and this one goes
# into the initramfs. Past this, it gets rendered smaller instead — Plymouth
# scales it back up, and a soft splash beats a boot image that doubled in size.
MAX_BYTES=$((4 * 1024 * 1024))

die() {
  printf '\033[31mx\033[0m %s\n' "$*" >&2
  exit 1
}
ok() { printf '  \033[32m✓\033[0m %s\n' "$*"; }
note() { printf '  \033[2m·\033[0m %s\n' "$*"; }

theme=
force=0
user_home=

while (($#)); do
  case $1 in
  --theme)
    theme=${2:-}
    shift 2 || die '--theme needs a slug'
    ;;
  --home)
    user_home=${2:-}
    shift 2 || die '--home needs a directory'
    ;;
  --force) force=1; shift ;;
  -h | --help)
    sed -n '3,6p' "${BASH_SOURCE[0]}" | sed 's/^# \?//'
    exit 0
    ;;
  *) die "unknown argument: $1 (try --help)" ;;
  esac
done

# Redirected targets mean a test run against fixtures, which needs no root.
((EUID == 0)) || [[ -n ${OMARCHY_PLYMOUTH_DIR:-} ]] ||
  die 'this writes to /usr/share and rebuilds the initramfs — run it with sudo'

for cmd in magick awk sed flock; do
  command -v "$cmd" >/dev/null 2>&1 || die "$cmd is not installed"
done

# The wallpaper lives under the user's home, and this runs as root — the same
# trap the boot hook fell into. $HOME is /root here, so it is never the answer.
if [[ -z $user_home ]]; then
  if [[ -n ${OMARCHY_USER_HOME:-} ]]; then
    user_home=$OMARCHY_USER_HOME
  elif [[ -n ${SUDO_USER:-} ]]; then
    user_home=$(getent passwd "$SUDO_USER" | cut -d: -f6)
  fi
fi
[[ -n $user_home && -d $user_home ]] ||
  die 'could not work out whose wallpaper to use — pass --home'

# Two runs inside mkinitcpio at once is a corrupt initramfs. The path unit
# cannot overlap itself — systemd will not start a second oneshot — but a hand
# run can overlap the unit, so both go through this. Whoever waits finds the
# stamp already current and does nothing.
install -d -m 755 "$STAMP_DIR" || die "could not create $STAMP_DIR"
exec {lockfd}>"$STAMP_DIR/lock" || die "could not open $STAMP_DIR/lock"
if ! flock -w 900 "$lockfd"; then
  die 'another run has been holding the lock for 15 minutes — giving up'
fi

STATE=$user_home/.local/state/omarchy
[[ -n $theme ]] || theme=$(cat "$STATE/current/theme.name" 2>/dev/null)
[[ -n $theme ]] || die "could not read the current theme from $STATE"

# readlink -f, because current/background is a symlink into the theme or into
# the user's own pictures. A non-regular target is refused rather than copied:
# these land in world-readable /usr/share and in the initramfs.
wallpaper=$(readlink -f "$STATE/current/background" 2>/dev/null)
[[ -n $wallpaper ]] || die "no current background set in $STATE"
[[ -f $wallpaper ]] || die "the current background is not a regular file: $wallpaper"

[[ -d $PLY_DIR ]] || die "$PLY_DIR is missing — is the Omarchy Plymouth theme installed?"

# Editing the omarchy theme changes nothing if Plymouth is set to another one,
# and the symptom is a splash that looks like this never ran.
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
  default_theme=$(plymouth-set-default-theme 2>/dev/null)
  [[ -z $default_theme || $default_theme == omarchy ]] ||
    printf '  \033[33m!\033[0m Plymouth'"'"'s default theme is "%s", not omarchy — this will not show\n' \
      "$default_theme" >&2
fi

# Native mode of the first enabled connector. hyprctl is not available to root
# without the user's session, and DRM is.
geometry() {
  local card mode
  for card in /sys/class/drm/card*-*; do
    [[ -r $card/enabled ]] || continue
    [[ $(cat "$card/enabled" 2>/dev/null) == enabled ]] || continue
    mode=$(head -1 "$card/modes" 2>/dev/null)
    [[ $mode =~ ^[0-9]+x[0-9]+$ ]] && { printf '%s' "$mode"; return; }
  done
  printf '1920x1080'
}
geom=${OMARCHY_SPLASH_GEOMETRY:-$(geometry)}
[[ $geom =~ ^[0-9]+x[0-9]+$ ]] || die "not a usable screen geometry: $geom"

theme_colors() {
  local dir
  dir=$user_home/.config/omarchy/themes/$theme
  [[ -r $dir/colors.toml ]] || dir=${OMARCHY_PATH:-/usr/share/omarchy}/themes/$theme
  [[ -r $dir/colors.toml ]] || return 1
  printf '%s' "$dir/colors.toml"
}
colors=$(theme_colors) || die "no colors.toml for \"$theme\""

val() {
  local v
  v=$(awk -F= -v k="$1" '
    { key = $1; gsub(/^[ \t]+|[ \t]+$/, "", key) }
    key == k { gsub(/[" \t]/, "", $2); print $2; exit }
  ' "$colors")
  v=${v#\#}
  [[ $v =~ ^[0-9a-fA-F]{6}$ ]] || return 1
  printf '%s' "$v"
}
bg=$(val background) || die "no usable 'background' in $colors"
fg=$(val foreground) || die "no usable 'foreground' in $colors"

# ---------------------------------------------------------------- up to date?

sha=$(sha256sum "$wallpaper" | cut -d' ' -f1)
want="theme=$theme wallpaper=$sha geometry=$geom"

# The stamp alone is not enough. omarchy-plymouth-set rewrites omarchy.script
# from Omarchy's default whenever anyone sets an unlock style by hand, which
# silently removes our block while the stamp still reads current — so the
# installed state gets checked too.
installed() {
  [[ -f $PLY_DIR/background.png ]] || return 1
  grep -qF "$MARK_BEGIN" "$PLY_DIR/omarchy.script" 2>/dev/null || return 1
  grep -qF "$QML_MARK" "$SDDM_DIR/Main.qml" 2>/dev/null || return 1
  [[ -f $STAMP && $(cat "$STAMP") == "$want" ]]
}

if ((!force)) && installed; then
  note "splash already on this wallpaper — nothing to rebuild"
  exit 0
fi

printf '\033[1mPutting the boot splash on the current wallpaper\033[0m\n'
note "theme \"$theme\", $(basename -- "$wallpaper"), $geom"

# ------------------------------------------------------------------- render

work=$(mktemp -d) || die 'mktemp failed'
trap 'rm -rf "$work"' EXIT

render() {
  # [0] is not optional. A wallpaper can legitimately be an animated GIF, and
  # ImageMagick writes one numbered file per frame — background-0.png,
  # background-1.png — so background.png is never created at all.
  #
  # -resize WxH^ then -extent centres and crops to fill, so nothing is
  # stretched out of shape the way a plain Scale would. That is also how the
  # desktop draws it (PreserveAspectCrop), so the splash frames the wallpaper
  # the same way the desktop does.
  #
  # Alpha is flattened onto the theme background rather than left to
  # ImageMagick, which picks white — wrong on every dark theme.
  #
  # -flatten, not -alpha remove. On ImageMagick 7.1.2 `-background '#1a1b26'
  # -alpha remove` returns srgb(26,26,26) — it keeps the red channel and greys
  # the rest — where -flatten with the same background correctly returns
  # srgb(26,27,38). A transparent wallpaper on Tokyo Night came out grey.
  magick "$wallpaper[0]" -auto-orient -strip \
    -background "#$bg" -flatten -alpha off \
    -resize "$1^" -gravity center -extent "$1" \
    -define png:compression-level=9 "PNG24:$work/background.png" 2>/dev/null
}

target=$geom
for attempt in 1 2 3 4; do
  render "$target" || die "could not render $wallpaper at $target"
  size=$(stat -c%s "$work/background.png")
  ((size <= MAX_BYTES)) && break
  w=${target%x*} h=${target#*x}
  target=$((w * 7 / 10))x$((h * 7 / 10))
  ((attempt == 4)) || note "$((size / 1024 / 1024))MB is too big for the initramfs, retrying at $target"
done
[[ $target == "$geom" ]] || note "rendered at $target to keep the initramfs small"
((size <= MAX_BYTES)) ||
  note "still $((size / 1024 / 1024))MB after scaling down — the initramfs will grow by that much"

# ------------------------------------------------------------------ plymouth

# Appended, not edited in: omarchy-plymouth-set rewrites this file from
# Omarchy's default on every theme change, so the block has to be re-addable
# rather than a patch to a line that may have moved.
ply_block=$(
  printf '%s\n' "$MARK_BEGIN"
  printf '# Written by omarchy-splash-wallpaper. Re-appended after anything that\n'
  printf '# regenerates this file from Omarchy'"'"'s default; edits here are lost.\n'
  printf 'background.image = Image("background.png");\n'
  # Already rendered at the screen size, so the usual unconditional Scale would
  # allocate a second full-resolution copy for nothing — 36MB of it at 4K, in
  # early boot. Scale only when the screen is not the size it was rendered for,
  # which is what a monitor change since the last run looks like.
  printf 'if (background.image.GetWidth() != Window.GetWidth() ||\n'
  printf '    background.image.GetHeight() != Window.GetHeight())\n'
  printf '  background.image = background.image.Scale(Window.GetWidth(), Window.GetHeight());\n'
  printf 'background.sprite = Sprite(background.image);\n'
  # Behind everything. The dialogue is at z 10001, the progress bar at 1 and its
  # box at 0, so anything below 0 is out of their way. If a Plymouth ever
  # ignored a negative z the sprite would tie with the progress box and hide its
  # outline — the splash, the wallpaper and the password field would all still
  # be there, which is why this is the direction to be wrong in.
  printf 'background.sprite.SetPosition(0, 0, -100);\n'
  printf '# The wallpaper carries its own branding, so the theme logo on top of it is\n'
  printf '# two logos. The sprite has to stay — entry.y is measured from it — so it is\n'
  printf '# hidden rather than removed.\n'
  printf 'logo.sprite.SetOpacity(0);\n'
  printf '%s\n' "$MARK_END"
)

[[ -r $PLY_DIR/omarchy.script ]] || die "$PLY_DIR/omarchy.script is missing"
# Loudly, not silently: without these two the block is a no-op and the splash
# would come out looking untouched with nothing to explain why.
grep -q 'logo.sprite' "$PLY_DIR/omarchy.script" ||
  die "$PLY_DIR/omarchy.script has no logo.sprite — Omarchy's theme has changed shape"

awk -v b="$MARK_BEGIN" -v e="$MARK_END" '
  $0 == b { skip = 1; next }
  $0 == e { skip = 0; next }
  !skip   { print }
' "$PLY_DIR/omarchy.script" >"$work/omarchy.script" || die 'could not rewrite omarchy.script'
printf '%s\n' "$ply_block" >>"$work/omarchy.script"

install -m 644 "$work/background.png" "$PLY_DIR/background.png" ||
  die "could not install the background into $PLY_DIR"
install -m 644 "$work/omarchy.script" "$PLY_DIR/omarchy.script" ||
  die "could not install omarchy.script"
ok "splash background installed ($((size / 1024))KB)"

# ---------------------------------------------------------------------- sddm

sddm_template=${OMARCHY_PATH:-/usr/share/omarchy}/default/sddm/omarchy/Main.qml
if [[ -d $SDDM_DIR && -r $sddm_template ]]; then
  # Two phases through placeholders. Substituting straight to the final values
  # lets the second expression rewrite what the first one just wrote, which is
  # how a white theme ends up with a black login screen.
  sed -e 's/#1a1b26/@@OBT_BG@@/g' -e 's/#ffffff/@@OBT_FG@@/g' \
    -e "s/@@OBT_BG@@/#$bg/g" -e "s/@@OBT_FG@@/#$fg/g" \
    "$sddm_template" >"$work/Main.qml.colored" || die 'could not colour Main.qml'

  # Drop the logo block. Brace counting rather than a line range, because the
  # template is upstream's and will move.
  awk -v mark="$QML_MARK" '
    # The colour on the root Rectangle is the whole background now. The marker
    # goes on the line after it, both to record that this file has been through
    # here and to keep the anchor honest: if upstream drops the colour line, the
    # END block below refuses the whole transform rather than installing a
    # login screen with no background at all.
    !placed && /^[[:space:]]*color:[[:space:]]*"#/ { print; print "  " mark; placed = 1; next }
    # An "Image {" whose next line declares id: logo, and everything to its
    # matching brace.
    /^[[:space:]]*Image[[:space:]]*\{[[:space:]]*$/ && !skip {
      held = $0
      if ((getline nxt) > 0) {
        if (nxt ~ /id:[[:space:]]*logo/) { skip = 1; depth = 1; dropped = 1; next }
        print held; print nxt; next
      }
      print held; next
    }
    skip {
      depth += gsub(/\{/, "{") - gsub(/\}/, "}")
      if (depth <= 0) skip = 0
      next
    }
    { print }
    END {
      if (!placed) { print "OBT_ERROR: no root colour line to anchor to" > "/dev/stderr"; exit 1 }
      if (!dropped) { print "OBT_ERROR: no logo Image block found" > "/dev/stderr"; exit 1 }
    }
  ' "$work/Main.qml.colored" >"$work/Main.qml" ||
    die "Omarchy's SDDM template has changed shape — not installing a broken login screen"

  install -m 644 "$work/Main.qml" "$SDDM_DIR/Main.qml" ||
    die "could not install Main.qml"
  # Earlier versions put the wallpaper here. Leaving that file behind would
  # leave a stale 4K image in /usr/share that nothing reads any more.
  rm -f "$SDDM_DIR/background.png"
  ok "login screen plain (background #$bg, text #$fg)"
else
  note "no SDDM theme at $SDDM_DIR — skipping the login screen"
fi

# ----------------------------------------------------------------- initramfs

note 'rebuilding the initramfs so the splash picks this up, about a minute...'
if [[ -n ${OMARCHY_MKINITCPIO:-} ]]; then
  $OMARCHY_MKINITCPIO || die "$OMARCHY_MKINITCPIO failed"
elif command -v limine-mkinitcpio >/dev/null 2>&1; then
  limine-mkinitcpio || die 'limine-mkinitcpio failed'
else
  mkinitcpio -P || die 'mkinitcpio failed'
fi

printf '%s\n' "$want" >"$STAMP"
ok 'done — visible at the next restart'
