#!/bin/bash
#
# omarchy-gpu-switch — turn the discrete GPU on or off, now, without a reboot.
#
# This is what the Omarchy menu's GPU entry runs. Omarchy's own
# omarchy-toggle-hybrid-gpu drives supergfxd and reboots to change mode; this
# takes the card off the PCI bus instead, which needs neither.

set -uo pipefail

MODE=/usr/local/bin/omarchy-power-mode
[[ -x $MODE ]] || {
  echo "omarchy-power-mode is not installed." >&2
  exit 1
}

"$MODE" status
echo

if [[ $("$MODE" status | awk '/dGPU on bus/ { print $NF }') == yes ]]; then
  held=$("$MODE" status | sed -n 's/^dGPU held by *: *//p')
  if [[ -n ${held// /} ]]; then
    echo "Something is using the GPU right now (PIDs:$held)."
    echo "Close it first — turning the card off underneath a running program"
    echo "would take the GPU out from under it."
    exit 1
  fi
  gum confirm "Turn the discrete GPU OFF? (saves about 6 W)" || exit 0
  sudo "$MODE" gpu-off
else
  gum confirm "Turn the discrete GPU ON?" || exit 0
  sudo "$MODE" gpu-on
fi

echo
"$MODE" status
echo
echo "Note: plugging in or unplugging re-applies the automatic policy."
