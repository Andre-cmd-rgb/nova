#!/bin/bash

# nova:summary=Make a Nova installer stick, and carry your things over on it
# nova:args=[--preset] [--iso <file>] [--dry-run]
#
# nova-usb: make a Nova installer stick, and carry your things over on it.
#
# Runs on any Arch-based Linux, Nova or not, as you; sudo is asked for once, at
# the end, to write the stick. Every question comes first: the stick, then
# Clean (only the installer), Custom (pick what to bring) or Last time (the
# choices saved in ~/.config/nova/usb.toml). Nothing touches the stick until
# its device name is typed back.
#
# The stick: a FAT partition with the installer (the ISO's own files, which
# archiso boots from as they are) and, if asked for, every package an install
# can need, so it installs without a network. When anything is carried, a
# second, LUKS2-encrypted btrfs partition holds one compressed archive per item
# and their SHA-256 sums; the installer asks for its passphrase and puts it all
# back. Everything written is read back from the stick and checked before it is
# done.
#
#   nova usb                 the wizard
#   nova usb --preset        last time's choices; asks only for the stick and passphrase
#   nova usb --iso <file>    this ISO rather than the latest release's (packages
#                            on the stick then need the release's release.toml
#                            and packages.txt next to it)
#   nova usb --dry-run       everything but the writing
#   nova usb --help          this text
#
# NOVA_USB_* variables override paths for testing; the functions are sourceable
# (tests/unit/installer/usb.bats) and `main` runs only when executed.

set -euo pipefail

USB_HOME=${NOVA_USB_HOME:-$HOME}
PRESET=${NOVA_USB_PRESET:-${XDG_CONFIG_HOME:-$USB_HOME/.config}/nova/usb.toml}
CACHE=${NOVA_USB_CACHE:-${XDG_CACHE_HOME:-$USB_HOME/.cache}/nova/usb}
RELEASES=${NOVA_USB_RELEASES:-https://api.github.com/repos/Andre-cmd-rgb/nova/releases}
SYSROOT=${NOVA_USB_SYSROOT:-}
DMI=${NOVA_DMI_PATH:-/sys/class/dmi/id}
# The package lists of the system being left, so "your extra packages" are the
# ones you added rather than everything it came with.
OLD_PACKAGE_LISTS=${NOVA_USB_OLD_PACKAGE_LISTS:-/usr/share/omarchy/install}

MiB=$((1024 * 1024))
MIN_STICK_BYTES=$((2 * 1024 * MiB))
# LUKS2 header, btrfs metadata and a margin, on top of what is carried.
DATA_OVERHEAD=$((512 * MiB))
MAPPER=nova-usb-data

# The setup screens' look: installer/ui.bash, from beside this file or from
# the nova package. The nova-usb on a release page travels alone, so
# tools/inline-ui writes ui.bash and the wordmark in between these markers.
# @ui begin
if [[ -r ${BASH_SOURCE[0]%/*}/ui.bash ]]; then
  # shellcheck source=installer/ui.bash
  source "${BASH_SOURCE[0]%/*}/ui.bash"
else
  # shellcheck source=installer/ui.bash
  source /usr/share/nova/ui.bash
fi
# @ui end

say() { printf '\n  \e[1m%s\e[0m\n' "$*" >&2; }
info() { printf '  %s\n' "$*" >&2; }
# The wizard clears the screen between questions, so a warning given during
# one is shown again under the next one's header (UI_NOTES, set by main).
warn() {
  ui_warn "$*"
  [[ -z ${UI_NOTES:-} ]] || printf '%s\n' "$*" >>"$UI_NOTES"
}
die() {
  printf '\n\e[31mnova usb: %s\e[0m\n' "$*" >&2
  exit 1
}

human_size() {
  awk -v b="$1" 'BEGIN { split("B KB MB GB TB PB", u); i = 1; while (b >= 1000 && i < 6) { b /= 1000; i++ } printf (i > 3 ? "%.1f %s" : "%.0f %s"), b, u[i] }'
}

# /dev/sdb -> /dev/sdb1, /dev/nvme1n1 -> /dev/nvme1n1p1
partition_path() {
  if [[ $1 =~ [0-9]$ ]]; then echo "${1}p$2"; else echo "$1$2"; fi
}

# ------------------------------------------------------------- what to carry

# What Custom offers, one item per line, tab-separated: id, what the checklist
# says (no commas: the checklist's gum splits on them), the kind, and the
# paths, |-separated. "home" paths are relative to your home; "system" ones are
# absolute and read through sudo; "list", "projects" and "folders" are made
# from your answers.
catalog() {
  cat <<'EOF'
ssh	SSH keys	home	.ssh
gnupg	GnuPG keys	home	.gnupg
git	Git and GitHub CLI settings	home	.gitconfig|.config/git|.config/gh
chrome	Chrome signed in: its profile and the keyring that unlocks it	home	.config/google-chrome|.local/share/keyrings
vscode	VS Code settings and extensions	home	.config/Code/User|.vscode/extensions
ai	Claude Code and Codex	home	.claude|.claude.json|.codex
t3	T3 Code	home	.t3|.config/t3code|.config/t3code-v2
mise	mise tools	home	.config/mise
history	Screen Time and Battery Life and mobile data history	home	.local/state/nova-screentime|.local/state/nova-batterylife|.local/state/nova-mobile-data|.local/state/nova-mobile|.local/state/omarchy-screentime|.local/state/omarchy-batterylife|.local/state/omarchy-mobile-data|.local/state/omarchy-mobile
bar	Menu bar layout	home	.config/nova/shell.json|.config/omarchy/shell.json
backgrounds	Your own backgrounds	home	.config/nova/backgrounds
shell	Shell history	home	.bash_history
wifi	Network connections with their Wi-Fi passwords	system	/etc/NetworkManager/system-connections
bluetooth	Bluetooth pairings (back on this same computer only)	system	/var/lib/bluetooth
fingerprints	Fingerprints (back on this same computer only)	system	/var/lib/fprint
packages	Your extra packages installed again	list	-
projects	Git repositories: their files and history but not what git ignores	projects	-
folders	Whole folders such as Documents or Pictures	folders	-
EOF
}

# Ticked when Custom starts: everything that needs no further answer.
DEFAULT_ITEMS=(ssh gnupg git chrome vscode ai t3 mise history bar backgrounds shell wifi bluetooth fingerprints)

item_field() { # id field(2 label, 3 kind, 4 paths)
  catalog | awk -F'\t' -v id="$1" -v f="$2" '$1 == id { print $f; exit }'
}

item_paths() { # id -> its paths, one per line
  local paths
  paths=$(item_field "$1" 4)
  [[ $paths != - ]] || return 0
  tr '|' '\n' <<<"$paths"
}

valid_item() { [[ -n $(item_field "$1" 3) ]]; }

# What rebuilds or downloads itself again: a browser's and an editor's caches,
# Chrome's site storage (File System holds what sites downloaded, often
# gigabytes) and the components it fetches, Codex's own runtime; and the lock
# files that would make Chrome think its profile is open on another computer.
# Cookies, passwords, extensions and IndexedDB stay, so Chrome is still signed
# in.
item_excludes() {
  case $1 in
    chrome) printf '%s\n' Cache 'Code Cache' GPUCache ShaderCache GrShaderCache GraphiteDawnCache \
      DawnGraphiteCache DawnWebGPUCache component_crx_cache 'File System' 'Service Worker' \
      screen_ai optimization_guide_model_store OptGuideOnDeviceModel WasmTtsEngine \
      'Crash Reports' Crashpad SingletonLock SingletonSocket SingletonCookie ;;
    vscode) printf '%s\n' workspaceStorage CachedExtensionVSIXs ;;
    ai) printf '%s\n' .codex/packages ;;
    gnupg) printf '%s\n' 'S.*' '*.lock' ;;
  esac
}

# Omarchy's names for the same things, renamed on the way in, so the installer
# only ever sees Nova's.
item_transform() {
  case $1 in
    history) echo 's,^\.local/state/omarchy-,.local/state/nova-,' ;;
    bar) echo 's,^\.config/omarchy/shell\.json$,.config/nova/shell.json,' ;;
  esac
}

# Bytes an item will take, roughly (uncompressed, so never an underestimate).
# System items cannot be read without root and are a few kilobytes.
item_bytes() { # id plan
  local id=$1 plan=$2 kind path bytes=0 excludes=() pattern
  kind=$(item_field "$id" 3)
  case $kind in
    home)
      while IFS= read -r pattern; do excludes+=("--exclude=$pattern"); done < <(item_excludes "$id")
      while IFS= read -r path; do
        [[ -e $USB_HOME/$path ]] || continue
        bytes=$((bytes + $(du -sb "${excludes[@]}" -- "$USB_HOME/$path" 2>/dev/null | awk '{ print $1 }')))
      done < <(item_paths "$id")
      ;;
    system) bytes=$MiB ;;
    list) bytes=$(cat "$plan/packages.txt" "$plan/aur.txt" 2>/dev/null | wc -c) ;;
    projects)
      [[ -s $plan/projects.files ]] && bytes=$(cd "$USB_HOME" && du -cb --files0-from="$plan/projects.files" 2>/dev/null | awk 'END { print $1 }')
      [[ -s $plan/projects.gitdirs ]] && bytes=$((bytes + $(cd "$USB_HOME" && du -cb --files0-from="$plan/projects.gitdirs" 2>/dev/null | awk 'END { print $1 }')))
      ;;
    folders)
      [[ -s $plan/folders.list ]] && bytes=$(cd "$USB_HOME" && du -cb --files0-from="$plan/folders.list" 2>/dev/null | awk 'END { print $1 }')
      ;;
  esac
  echo "${bytes:-0}"
}

# An item with nothing to carry on this computer is left off the stick.
item_present() { # id plan
  local id=$1 plan=$2 path
  case $(item_field "$id" 3) in
    home | system)
      while IFS= read -r path; do
        if [[ $path == /* ]]; then path=$SYSROOT$path; else path=$USB_HOME/$path; fi
        [[ -e $path ]] && return 0
      done < <(item_paths "$id")
      return 1
      ;;
    list) [[ -s $plan/packages.txt || -s $plan/aur.txt ]] ;;
    projects) [[ -s $plan/projects.gitdirs ]] ;;
    folders) [[ -s $plan/folders.list ]] ;;
  esac
}

# A folder you named, as a path inside your home, or nothing if it is not one.
home_relative() {
  local dir=${1%/}
  dir=${dir/#\~/$USB_HOME}
  [[ $dir == /* ]] || dir=$USB_HOME/$dir
  dir=$(realpath -e -- "$dir" 2>/dev/null) || return 1
  [[ -d $dir && $dir == "$USB_HOME"/* ]] || return 1
  echo "${dir#"$USB_HOME"/}"
}

# The git repositories under a folder (inside your home), outermost first.
find_repos() { # home-relative dir
  (cd "$USB_HOME" && find "$1" -maxdepth 6 \( -name node_modules -o -name .cache \) -prune -o -name .git -prune -print 2>/dev/null) |
    sed 's,/\.git$,,' | sort
}

# What git would call the repository: tracked files, and new ones it does not
# ignore. Files deleted from the work tree but not from the index are skipped,
# and directories are left to the files in them. NUL-separated, home-relative.
# A repository git cannot read is carried as its .git alone, with a word.
repo_files() { # home-relative repo
  local repo=$1 f
  { git -C "$USB_HOME/$repo" ls-files -z --cached --others --exclude-standard 2>/dev/null ||
    warn "git could not read ~/$repo; only its .git is carried."; } |
    while IFS= read -r -d '' f; do
      if [[ -L $USB_HOME/$repo/$f || -f $USB_HOME/$repo/$f ]]; then printf '%s\0' "$repo/$f"; fi
    done
}

# projects.files (no recursion) and projects.gitdirs (recursed): every
# repository under the folders named in PROJECT_DIRS.
list_projects() { # plan
  local plan=$1 dir repo
  : >"$plan/projects.files"
  : >"$plan/projects.gitdirs"
  for dir in "${PROJECT_DIRS[@]}"; do
    while IFS= read -r repo; do
      repo_files "$repo" >>"$plan/projects.files"
      printf '%s\0' "$repo/.git" >>"$plan/projects.gitdirs"
    done < <(find_repos "$dir")
  done
}

list_folders() { # plan
  local plan=$1 dir
  : >"$plan/folders.list"
  for dir in "${FOLDER_DIRS[@]}"; do printf '%s\0' "$dir" >>"$plan/folders.list"; done
}

# Explicitly installed packages minus what the old system came with and what
# the installer chooses for the hardware itself. Packages from the AUR go to
# their own list: pacman cannot install them, so the installer leaves a note.
list_packages() { # plan
  local plan=$1 base
  base=$(cat "$OLD_PACKAGE_LISTS"/*.packages 2>/dev/null | sed 's/#.*//; s/[[:space:]]//g; /^$/d' | sort -u)
  local skip='^(base|base-devel|linux(-lts|-zen|-hardened)?(-headers)?|.*-ucode|nvidia.*|nova.*|omarchy.*|limine.*|plymouth.*|sddm.*|google-chrome|visual-studio-code-bin)$'
  comm -23 <(pacman -Qqen 2>/dev/null | sort -u) <(echo "$base") | grep -Ev "$skip" >"$plan/packages.txt" || true
  comm -23 <(pacman -Qqem 2>/dev/null | sort -u) <(echo "$base") | grep -Ev "$skip" >"$plan/aur.txt" || true
}

# ---------------------------------------------------------------- the preset

# usb.toml: three arrays and a flag. Its strings are written as JSON, which is
# what TOML's basic strings are, so jq reads them back.
write_preset() { # items offline
  local items=$1 offline=$2
  mkdir -p "$(dirname "$PRESET")"
  {
    echo '# nova usb: what "Last time" brings. Written by nova usb; folders are inside your home.'
    printf 'items = %s\n' "$(printf '%s\n' "$items" | jq -Rc 'split(" ") | map(select(. != ""))')"
    printf 'projects = %s\n' "$(printf '%s\n' "${PROJECT_DIRS[@]}" | jq -Rsc 'split("\n") | map(select(. != ""))')"
    printf 'folders = %s\n' "$(printf '%s\n' "${FOLDER_DIRS[@]}" | jq -Rsc 'split("\n") | map(select(. != ""))')"
    printf 'offline = %s\n' "$( ((offline)) && echo true || echo false)"
  } >"$PRESET.tmp"
  mv -f "$PRESET.tmp" "$PRESET"
}

preset_value() { # key -> the raw value
  sed -n "s/^$1 = //p" "$PRESET" | awk 'NR == 1'
}

# Sets ITEMS, PROJECT_DIRS, FOLDER_DIRS and OFFLINE from the preset. Unknown
# items and folders that are gone are dropped, with a word about each.
read_preset() {
  [[ -r $PRESET ]] || return 1
  local id dir rel
  ITEMS=() PROJECT_DIRS=() FOLDER_DIRS=()
  while IFS= read -r id; do
    if valid_item "$id"; then ITEMS+=("$id"); else warn "usb.toml: no item called '$id', skipped."; fi
  done < <(preset_value items | jq -r '.[]' 2>/dev/null)
  while IFS= read -r dir; do
    if rel=$(home_relative "$dir"); then PROJECT_DIRS+=("$rel"); else warn "usb.toml: no folder $dir, skipped."; fi
  done < <(preset_value projects | jq -r '.[]' 2>/dev/null)
  while IFS= read -r dir; do
    if rel=$(home_relative "$dir"); then FOLDER_DIRS+=("$rel"); else warn "usb.toml: no folder $dir, skipped."; fi
  done < <(preset_value folders | jq -r '.[]' 2>/dev/null)
  OFFLINE=0
  [[ $(preset_value offline) == true ]] && OFFLINE=1
  return 0
}

# ----------------------------------------------------------------- the stick

lsblk_disks() {
  lsblk -J -b -d -o NAME,PATH,SIZE,MODEL,SERIAL,TYPE,RM,RO,TRAN
}

# Disks this system runs from: its own file systems and swap, and the ones your
# home and the download cache are on, traced back through any LUKS or LVM
# layers to the disk underneath.
system_disks() {
  local src mountpoint path
  {
    for mountpoint in / /boot /efi /boot/efi /home /usr /var /opt /srv; do
      findmnt -nro SOURCE -- "$mountpoint" 2>/dev/null || true
    done
    for path in "$USB_HOME" "$CACHE"; do
      if [[ -e $path ]]; then findmnt -nro SOURCE -T "$path" 2>/dev/null || true; fi
    done
    swapon --noheadings --show=NAME 2>/dev/null || true
  } | while IFS= read -r src; do
    src=${src%%\[*}
    [[ -b $src ]] || continue
    lsblk -nrso PATH,TYPE -- "$src" 2>/dev/null | awk '$2 == "disk" { print $1 }'
  done | sort -u
}

# One tab-separated line per disk that may become the stick: path, size in
# bytes, model, serial, with "-" for an unknown field. Only removable and USB
# disks, never one this system runs from; NOVA_USB_ALLOW_ANY=1 lifts the first
# rule (an SD card in an internal reader, say), never the second.
stick_candidates() {
  local sys
  sys=$(system_disks | jq -Rsc 'split("\n") | map(select(. != ""))')
  lsblk_disks | jq -r --argjson sys "$sys" --argjson min "$MIN_STICK_BYTES" --arg any "${NOVA_USB_ALLOW_ANY:-0}" '
    def yes: . == true or . == "1" or . == 1;
    def field: (. // "") | tostring | gsub("^\\s+|\\s+$"; "") | if . == "" then "-" else . end;
    .blockdevices[]
    | select(.type == "disk")
    | select(.path as $p | $sys | index([$p]) | not)
    | select(.ro | yes | not)
    | select($any == "1" or (.rm | yes) or .tran == "usb")
    | select((.name | test("^(loop|zram|sr|ram|fd|nbd)")) | not)
    | select((.size | tonumber) >= $min)
    | [.path, (.size | tostring), (.model | field), (.serial | field)]
    | @tsv'
}

mounted_partitions() { # disk -> "partition mountpoint" per mounted one
  lsblk -nrpo PATH,MOUNTPOINTS -- "$1" 2>/dev/null | awk 'NF > 1 { print $1, $2 }'
}

# ----------------------------------------------------------- the release

# The newest release from GitHub's list of them (newest first), on stdin: a
# final one if there is any, else the newest pre-release. Fails when there is
# none.
latest_release() {
  jq -ce '[.[] | select(.draft | not)] | (map(select(.prerelease | not)) + map(select(.prerelease)))[0]'
}

asset_url() { # release-json name
  jq -r --arg n "$2" '.assets[] | select(.name == $n) | .browser_download_url' <<<"$1" | awk 'NR == 1'
}

download() { # url file
  [[ -s $2 ]] && return 0
  curl -fL --retry 3 --progress-bar -C - -o "$2.part" "$1" && mv -f "$2.part" "$2"
}

# Downloads the release's ISO (checked against its .sha256), release.toml and
# packages.txt into the cache; prints the ISO's path.
fetch_release() {
  local releases release tag version dir iso name url
  releases=$(curl -fsSL --max-time 30 "$RELEASES?per_page=20") ||
    die "could not reach the Nova releases ($RELEASES). Online? Or pass --iso <file>."
  release=$(latest_release <<<"$releases") ||
    die "Nova has no published release yet. Pass --iso <file> to use an ISO you built."
  tag=$(jq -r .tag_name <<<"$release")
  [[ $tag =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$ ]] || die "the newest release has an odd tag: $tag"
  version=${tag#v}
  dir=$CACHE/$tag
  iso=nova-$version-x86_64.iso
  mkdir -p "$dir"
  say "Nova $version"
  for name in release.toml packages.txt "$iso.sha256" "$iso"; do
    url=$(asset_url "$release" "$name")
    if [[ -z $url ]]; then
      [[ $name == packages.txt ]] && continue
      die "the $tag release has no $name"
    fi
    [[ $name != "$iso" ]] || info "Downloading the installer ($(human_size "$(jq -r --arg n "$iso" '.assets[] | select(.name == $n) | .size' <<<"$release")"))"
    download "$url" "$dir/$name" || die "could not download $name"
  done
  (cd "$dir" && sha256sum --quiet -c "$iso.sha256") || {
    rm -f -- "$dir/$iso"
    die "the downloaded ISO does not match its checksum; it was deleted, run nova usb again."
  }
  echo "$dir/$iso"
}

release_value() { # release.toml key
  sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*\"\\([^\"]*\\)\"[[:space:]]*\$/\\1/p" "$1" | awk 'NR == 1'
}

# The pacman.conf the stick's packages are fetched with: the release's own
# Arch snapshot and [nova] repository. Signatures are checked at install time,
# by the stick's keyring, which trusts Nova's key; this system's may not.
offline_pacman_conf() { # release.toml
  local arch_date nova_repo repo
  arch_date=$(release_value "$1" arch_date)
  nova_repo=$(release_value "$1" nova_repo)
  [[ $arch_date =~ ^[0-9]{4}/[0-9]{2}/[0-9]{2}$ ]] || die "$1 has no valid arch_date"
  [[ $nova_repo =~ ^https://[A-Za-z0-9._~:/%+-]+$ ]] || die "$1 has no valid nova_repo"
  printf '[options]\nArchitecture = x86_64\nSigLevel = Never\n\n[nova]\nServer = %s\n' "$nova_repo"
  for repo in core extra multilib; do
    # shellcheck disable=SC2016 # $repo and $arch are pacman's to expand
    printf '\n[%s]\nServer = https://archive.archlinux.org/repos/%s/$repo/os/$arch\n' "$repo" "$arch_date"
  done
}

package_urls() { # pacman.conf dbpath package... -> url<TAB>bytes of each, dependencies included
  local conf=$1 db=$2
  shift 2
  pacman --config "$conf" --dbpath "$db" --cachedir "$db/cache" --logfile /dev/null \
    --noconfirm -Sp --print-format '%l	%s' "$@" 2>/dev/null
}

# offline.urls: every package an install on any computer can need (the
# release's packages.txt) with all of their dependencies, as "url<TAB>bytes".
# pacman resolves them against an empty database of its own, so nothing on
# this system counts as already installed. The list holds alternatives that
# conflict (two NVIDIA modules), which pacman refuses in one transaction; then
# each is resolved on its own.
list_offline_packages() { # release.toml packages.txt plan
  local release=$1 packages=$2 plan=$3 db names=() name status=0
  db=$(mktemp -d)
  offline_pacman_conf "$release" >"$plan/offline.conf"
  mkdir -p "$db/cache"
  mapfile -t names < <(grep -v -e '^#' -e '^[[:space:]]*$' "$packages")
  if fakeroot -- pacman --config "$plan/offline.conf" --dbpath "$db" --logfile /dev/null -Sy >/dev/null; then
    if ! package_urls "$plan/offline.conf" "$db" "${names[@]}" >"$plan/offline.urls"; then
      : >"$plan/offline.urls"
      for name in "${names[@]}"; do
        package_urls "$plan/offline.conf" "$db" "$name" >>"$plan/offline.urls" || { status=1 && break; }
      done
    fi
    sort -u -o "$plan/offline.urls" "$plan/offline.urls"
  else
    status=1
  fi
  rm -rf -- "$db"
  return "$status"
}

# ------------------------------------------------------------ the wizard
#
# One question a screen, under the wordmark: Esc goes back a question, Ctrl+C
# stops with nothing written. Each step_ function asks its question and returns
# 1 for Esc. The answers are globals: STICK (its stick_candidates line), MODE
# (clean, custom or preset), ITEMS, PROJECT_DIRS, FOLDER_DIRS, OFFLINE and
# PASSPHRASE. PLAN is the folder the writer reads its orders from.

declare -gA SIZES=()
STICK='' MODE='' PASSPHRASE='' PLAN='' ISO='' RELEASE_DIR='' NO_OFFLINE='' DRY=0 PRESET_ONLY=0
ITEMS=() PROJECT_DIRS=() FOLDER_DIRS=() CARRIED=() OFFLINE=1
UI_STOPPED="nova usb stopped; nothing was written."

screen() { # [what this question is about]
  ui_header "Make a Nova stick${1:+  ·  $1}"
}

ticked() { [[ " ${ITEMS[*]} " == *" $1 "* ]]; }

measure() { # id plan
  case $1 in
    projects) list_projects "$2" ;;
    folders) list_folders "$2" ;;
  esac
  SIZES[$1]=$(item_bytes "$1" "$2")
}

# The items that are ticked and have something to carry.
carried_items() { # plan
  local id
  for id in "${ITEMS[@]}"; do
    item_present "$id" "$1" && echo "$id"
  done
  return 0
}

# Last time's choices, and the lists they need.
load_preset() {
  read_preset || return 1
  ! ticked packages || list_packages "$PLAN"
  list_projects "$PLAN"
  list_folders "$PLAN"
}

# The removable disks, each with what is on it now, so a backup drive is
# recognised before it is erased.
step_stick() {
  local sticks=() options=() mounted=() i path size model held label selected='' part where
  mapfile -t sticks < <(stick_candidates)
  ((${#sticks[@]})) || die "no USB stick found: one of 2 GiB or more, not write-protected. Plug one in and run nova usb again (a card in a built-in reader needs NOVA_USB_ALLOW_ANY=1)."
  for i in "${!sticks[@]}"; do
    IFS=$'\t' read -r path size model _ <<<"${sticks[i]}"
    [[ $model != - ]] || model="unknown model"
    held=$(disk_contents "$path" | awk '{ printf "%s%s", (NR > 1 ? "  ·  " : ""), $0 }')
    label="${path##*/}  $(human_size "$size")  $model${held:+  ·  $held}"
    label=${label//[,$'\t']/ }
    options+=("$label"$'\t'"$i")
    [[ ${sticks[i]} != "$STICK" ]] || selected=$label
  done
  screen "the stick"
  ui_ask ui_choose "Which stick? Everything on it will be erased." "$selected" "${options[@]}" || return 1
  STICK=${sticks[REPLY]}
  # A desktop may have mounted it on its own; that much can be undone.
  mapfile -t mounted < <(mounted_partitions "${STICK%%$'\t'*}")
  for part in "${mounted[@]}"; do
    where=${part#* } part=${part%% *}
    if ! ui_ask ui_confirm "$part is mounted at $where. Unmount it?" || ! udisksctl unmount -b "$part" >/dev/null 2>&1; then
      die "$part is still mounted; unmount it and run nova usb again."
    fi
  done
}

step_mode() {
  local options=() option selected='' before=$MODE id
  options=("Clean: only the installer"$'\t'clean "Custom: the installer and things of yours"$'\t'custom)
  [[ ! -r $PRESET ]] || options+=("Last time: the same as before"$'\t'preset)
  for option in "${options[@]}"; do
    [[ ${option#*$'\t'} != "${MODE:-custom}" ]] || selected=${option%$'\t'*}
  done
  screen
  ui_ask ui_choose "What goes on the stick?" "$selected" "${options[@]}" || return 1
  MODE=$REPLY
  case $MODE in
    clean) ITEMS=() ;;
    preset) load_preset ;;
    custom)
      [[ $before != custom ]] || return 0
      ITEMS=("${DEFAULT_ITEMS[@]}") PROJECT_DIRS=() FOLDER_DIRS=() OFFLINE=1
      ui_note "Measuring what is here..."
      while IFS=$'\t' read -r id _ kind _; do
        [[ $kind != home && $kind != system ]] || [[ -n ${SIZES[$id]:-} ]] || measure "$id" "$PLAN"
      done < <(catalog)
      ;;
  esac
}

# The checklist, every item with its size; then the folders for the items that
# need them, and a look at the package list.
step_items() {
  while :; do
    checklist || return 1
    item_details && return 0
  done
}

checklist() {
  local id label kind size options=() selected=()
  while IFS=$'\t' read -r id label kind _; do
    size=''
    if [[ $kind == home || $kind == system ]] && ! item_present "$id" "$PLAN"; then
      size="nothing here"
    elif [[ -n ${SIZES[$id]:-} ]]; then
      size=$(human_size "${SIZES[$id]}")
    fi
    [[ -z $size ]] || label=$(printf '%-66s %s' "$label" "$size")
    options+=("$label"$'\t'"$id")
    ! ticked "$id" || selected+=("$label")
  done < <(catalog)
  screen "what to bring"
  ui_ask ui_choose_many "What to bring? Tab ticks and unticks, Enter goes on." \
    "$(printf '%s\n' "${selected[@]}")" "${options[@]}" || return 1
  ITEMS=()
  [[ -z $REPLY ]] || mapfile -t ITEMS <<<"$REPLY"
}

# Returns 1 for Esc, back to the checklist.
item_details() {
  if ticked projects; then
    ask_folders PROJECT_DIRS "Which folders hold your git repositories?" Projects || return 1
    ui_note "Measuring..."
    measure projects "$PLAN"
  fi
  if ticked folders; then
    ask_folders FOLDER_DIRS "Which folders, whole?" Documents || return 1
    ui_note "Measuring..."
    measure folders "$PLAN"
  fi
  if ticked packages; then
    list_packages "$PLAN"
    measure packages "$PLAN"
    screen "your extra packages"
    ui_note "$(wc -l <"$PLAN/packages.txt") from Arch, installed again; $(wc -l <"$PLAN/aur.txt") from the AUR, listed for you."
    if ui_ask ui_confirm "Look over the list first?" no; then
      "${EDITOR:-nano}" "$PLAN/packages.txt" </dev/tty >/dev/tty || true
    fi
  fi
  return 0
}

ask_folders() { # array-name question default
  local -n dirs=$1
  local entered=() dir rel defaults=$3
  if ((${#dirs[@]})); then
    defaults=$(printf '%s, ' "${dirs[@]}")
    defaults=${defaults%, }
  fi
  screen "folders"
  ui_ask ui_input "$2" "$defaults" "inside your home, separated by commas" || return 1
  dirs=()
  IFS=, read -ra entered <<<"$REPLY"
  for dir in "${entered[@]}"; do
    dir=$(sed 's/^[[:space:]]*//; s/[[:space:]]*$//' <<<"$dir")
    [[ -n $dir ]] || continue
    if rel=$(home_relative "$dir"); then dirs+=("$rel"); else warn "No folder $dir in your home, skipped."; fi
  done
}

# Offered only when the release says which packages there are and this system
# can fetch them (NO_OFFLINE says why not).
step_offline() {
  local yes="Yes: it then installs without internet" no="No: the installer downloads them"
  screen "packages"
  ui_ask ui_choose "Put every package on the stick too?" "$( ((OFFLINE)) && echo "$yes" || echo "$no")" \
    "$yes"$'\t'1 "$no"$'\t'0 || return 1
  OFFLINE=$REPLY
}

step_passphrase() {
  screen "passphrase"
  ui_note "What you bring is encrypted on the stick, and the installer asks for this"
  ui_note "passphrase to open it. Without it, your things stay locked."
  echo >&2
  ui_ask ui_password "Choose a passphrase, 8 characters or more" 8 || return 1
  PASSPHRASE=$REPLY
}

# What happens to which disk, and whether it fits; then the stick's name typed
# back. Writes the plan the writer reads.
step_summary() {
  local stick size model serial id label line tool tools offline_bytes=0 carry_bytes=0 iso_bytes p1_mib need lines=()
  IFS=$'\t' read -r stick size model serial <<<"$STICK"
  [[ -z $NO_OFFLINE ]] || OFFLINE=0

  # What the writer will run, checked now rather than halfway through.
  tools=(sudo sfdisk wipefs mkfs.fat tar zstd diff)
  ((${#CARRIED[@]} == 0)) || tools+=(cryptsetup mkfs.btrfs)
  ((!OFFLINE)) || tools+=(repo-add)
  for tool in "${tools[@]}"; do
    command -v "$tool" >/dev/null || die "writing this stick needs $tool, which is not installed."
  done

  if ((OFFLINE)); then
    if [[ ! -s $PLAN/offline.urls ]]; then
      screen
      ui_note "Working out the packages..."
      list_offline_packages "$RELEASE_DIR/release.toml" "$RELEASE_DIR/packages.txt" "$PLAN" ||
        die "could not list the release's packages (is the network up?)"
    fi
    offline_bytes=$(awk -F'\t' '{ s += $2 } END { print s + 0 }' "$PLAN/offline.urls")
  fi
  for id in "${CARRIED[@]}"; do
    [[ -n ${SIZES[$id]:-} ]] || SIZES[$id]=$(item_bytes "$id" "$PLAN")
    carry_bytes=$((carry_bytes + SIZES[$id]))
  done
  iso_bytes=$(stat -c %s -- "$ISO")
  p1_mib=$(installer_mib "$iso_bytes" "$offline_bytes")
  need=$((p1_mib * MiB))
  ((${#CARRIED[@]} == 0)) || need=$((need + carry_bytes + DATA_OVERHEAD))

  lines=("Erased     ${stick##*/}  $(human_size "$size")$([[ $model == - ]] || echo "  $model")")
  while IFS= read -r line; do
    [[ -z $line ]] || lines+=("           now holds $line")
  done < <(disk_contents "$stick")
  lines+=("Installer  ${ISO##*/}")
  if ((OFFLINE)); then
    lines+=("           and $(wc -l <"$PLAN/offline.urls") packages  $(human_size "$offline_bytes")")
  else
    lines+=("           packages download while installing")
  fi
  if ((${#CARRIED[@]})); then
    lines+=("Encrypted  $(human_size "$carry_bytes") of yours")
    for id in "${CARRIED[@]}"; do
      # The label's head: "Chrome signed in", "Bluetooth pairings".
      label=$(item_field "$id" 2)
      label=${label%%[:(]*}
      lines+=("$(printf '           %-34s %s' "${label% }" "$(human_size "${SIZES[$id]}")")")
    done
  fi
  lines+=("" "$(ui_bar "$need" "$size" 34)  $(human_size "$need") of $(human_size "$size")")
  screen "ready"
  ui_box "${lines[@]}"
  [[ -z $NO_OFFLINE ]] || ui_note "No packages on the stick: $NO_OFFLINE."
  ((size <= 256 * 1024 * MiB)) || ui_warn "That is a big disk for a stick. Make sure it is not a backup drive."
  if [[ " ${CARRIED[*]} " == *" chrome "* ]] && pgrep -x chrome >/dev/null 2>&1; then
    ui_warn "Chrome is open; quit it before going on, or its profile is copied mid-write."
  fi
  if ((need > size)); then
    ui_warn "That is more than the stick holds."
    ui_ask ui_confirm "Go back and bring less?" && return 1
    die "it does not fit on the stick; nothing was written."
  fi

  write_plan_env "$PLAN" "device=$stick" "size=$size" "serial=$serial" "iso=$ISO" \
    "user=$(id -un)" "home=$USB_HOME" "items=${CARRIED[*]}" "offline=$OFFLINE" "installer_mib=$p1_mib" \
    "keymap=$(console_keymap)"
  ((!DRY)) || return 0
  echo >&2
  while :; do
    ui_ask ui_input "Type ${stick##*/} to erase it and write Nova, or Esc to go back" || return 1
    [[ $REPLY != "${stick##*/}" ]] || return 0
    ui_warn "That is not ${stick##*/}."
  done
}

# The questions in order, Esc stepping back one. Which are asked depends on
# the answers so far, so the list is made again after each.
wizard() {
  local steps=() i=0
  while :; do
    mapfile -t CARRIED < <(carried_items "$PLAN")
    steps=(stick)
    ((PRESET_ONLY)) || steps+=(mode)
    [[ $MODE != custom ]] || steps+=(items)
    [[ $MODE == preset || -n $NO_OFFLINE ]] || steps+=(offline)
    ((${#CARRIED[@]} == 0)) || steps+=(passphrase)
    steps+=(summary)
    ((i < ${#steps[@]})) || return 0
    if "step_${steps[i]}"; then
      i=$((i + 1))
    elif ((i > 0)); then
      i=$((i - 1))
    else
      die "stopped; nothing was written."
    fi
  done
}

# This computer's console keyboard layout. The stick offers it first, so the
# passphrase and the Wi-Fi password are typed on the keys they were chosen on.
console_keymap() {
  local keymap=''
  [[ -r $SYSROOT/etc/vconsole.conf ]] &&
    keymap=$(sed -n 's/^KEYMAP=//p' "$SYSROOT/etc/vconsole.conf" | tr -d "\"'" | awk 'NR == 1')
  if [[ $keymap =~ ^[a-z][a-z0-9_-]*$ ]]; then echo "$keymap"; fi
}

# This computer's time zone, which the installer offers first.
local_timezone() {
  local zone
  zone=$(readlink -- "$SYSROOT/etc/localtime" 2>/dev/null) || return 0
  zone=${zone#*zoneinfo/}
  if [[ $zone =~ ^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*$ ]]; then echo "$zone"; fi
}

# The plan the writer reads: key=value lines, one value each, no shell in them.
write_plan_env() { # plan key=value...
  local plan=$1
  shift
  printf '%s\n' "$@" >"$plan/plan.env"
}

plan_value() { # plan key
  sed -n "s/^$2=//p" "$1/plan.env" | awk 'NR == 1'
}

# The size of the installer partition: the ISO, the packages, and room to spare.
installer_mib() { # iso-bytes package-bytes
  echo $(((($1 + $2) * 105 / 100 + MiB - 1) / MiB + 128))
}

main() {
  local preset=0 tool self
  while (($#)); do
    case $1 in
      write)
        shift
        write_stick "$@"
        return
        ;;
      --preset) preset=1 ;;
      --iso)
        ISO=${2:?--iso needs a file}
        shift
        ;;
      --dry-run) DRY=1 ;;
      -h | --help)
        sed -n '/^# nova-usb:/,/^$/s/^# \{0,1\}//p' "$0"
        return 0
        ;;
      *) die "unknown argument: $1 (try --help)" ;;
    esac
    shift
  done
  ((EUID != 0)) || die "run nova usb as yourself: it asks sudo for the writing, and reads your home as you."
  for tool in lsblk jq curl sha256sum du git; do
    command -v "$tool" >/dev/null || die "nova usb needs $tool"
  done
  command -v gum >/dev/null || die "nova usb needs gum: sudo pacman -S gum"

  # Global: the EXIT trap runs after main has returned.
  PLAN=$(mktemp -d /tmp/nova-usb.XXXXXX)
  trap 'rm -rf -- "$PLAN"' EXIT
  UI_NOTES=$PLAN/notes

  screen
  if [[ -n $ISO ]]; then
    ISO=$(realpath -e -- "$ISO") || die "no ISO at $ISO"
  else
    ISO=$(fetch_release)
  fi
  RELEASE_DIR=$(dirname "$ISO")

  # Packages on the stick: possible when the release says what they are, and
  # this system has the tools to fetch and index them.
  if [[ ! -r $RELEASE_DIR/release.toml || ! -r $RELEASE_DIR/packages.txt ]]; then
    NO_OFFLINE="there is no release.toml and packages.txt next to the ISO"
  elif ! command -v pacman >/dev/null || ! command -v fakeroot >/dev/null; then
    NO_OFFLINE="that needs pacman and fakeroot on this system"
  fi

  if ((preset)); then
    load_preset || die "no saved choices at $PRESET yet; run nova usb without --preset once."
    MODE=preset PRESET_ONLY=1
  fi
  wizard
  [[ $MODE == clean ]] || write_preset "${ITEMS[*]}" "$OFFLINE"

  if ((DRY)); then
    say "Dry run: nothing was written. The plan:"
    sed 's/^/  /' "$PLAN/plan.env" >&2
    return 0
  fi
  self=$(realpath -e -- "${BASH_SOURCE[0]}")
  # sudo drops the environment, so the one setting the writer re-checks goes
  # through by hand.
  printf '%s' "$PASSPHRASE" | sudo -- env NOVA_USB_ALLOW_ANY="${NOVA_USB_ALLOW_ANY:-0}" "$BASH" "$self" write "$PLAN" ||
    die "the stick was not written, or not finished; do not install from it."
  say "The stick is ready."
  info "Boot the computer from it (F12 on a ThinkPad, F12 or F9 on a Legion) and follow the installer."
  ((${#CARRIED[@]} == 0)) || info "It asks for the passphrase you just chose; without it, your things stay locked."
}

# ------------------------------------------------------------ the writer
#
# Everything below runs as root, through `sudo nova-usb write <plan>`, with the
# passphrase on stdin. It trusts nothing the wizard said about the disk: it
# checks it again, and stops on anything unexpected.

WORK=''
UDEV_RULE=${NOVA_USB_UDEV_RULE:-/run/udev/rules.d/90-nova-usb.rules}

# A desktop automounter (udiskie, on Nova) would mount the new partitions, and
# ask for the encrypted one's passphrase, while they are being written. udisks
# leaves alone whatever udev marks UDISKS_IGNORE; the rule lasts as long as the
# write, and the stick shows up again when it is next plugged in.
hide_from_desktop() { # device
  local name=${1##*/} part
  part=$(partition_path "$name" "")
  mkdir -p -- "${UDEV_RULE%/*}"
  printf 'KERNEL=="%s|%s[0-9]*", ENV{UDISKS_IGNORE}="1"\nENV{DM_NAME}=="%s", ENV{UDISKS_IGNORE}="1"\n' \
    "$name" "$part" "$MAPPER" >"$UDEV_RULE"
  udevadm control --reload 2>/dev/null || true
}

writer_cleanup() {
  if [[ -f $UDEV_RULE ]]; then
    rm -f -- "$UDEV_RULE"
    udevadm control --reload 2>/dev/null || true
  fi
  [[ -n $WORK ]] || return 0
  local m
  # Each step on its own: one that fails must not stop the rest.
  for m in "$WORK/data" "$WORK/stick" "$WORK/iso"; do
    if mountpoint -q "$m" 2>/dev/null; then umount "$m" 2>/dev/null || true; fi
  done
  if [[ -e /dev/mapper/$MAPPER ]]; then cryptsetup close "$MAPPER" 2>/dev/null || true; fi
  # Never into a file system that failed to unmount: that would be the stick.
  rm -rf --one-file-system -- "$WORK"
  return 0
}

# lsblk -J of one disk, on stdin: is it a whole removable or USB disk of this
# size and serial? NOVA_USB_ALLOW_ANY=1 also lets through a fixed disk, or a
# loop device (an image file, which is how CI writes a stick).
stick_matches() { # size serial
  jq -e --argjson size "$1" --arg serial "$2" --arg any "${NOVA_USB_ALLOW_ANY:-0}" '
    def yes: . == true or . == "1" or . == 1;
    .blockdevices[0]
    | (.type == "disk" or ($any == "1" and .type == "loop")) and (.size | tonumber) == $size
      and ((.serial // "-" | tostring | gsub("^\\s+|\\s+$"; "") | if . == "" then "-" else . end) == $serial)
      and ($any == "1" or (.rm | yes) or .tran == "usb")' >/dev/null
}

# The device is still the stick that was picked: same size and serial, a whole
# removable or USB disk, nothing of it mounted, and not one this system runs on.
check_stick() { # device size serial
  local device=$1 size=$2 serial=$3
  [[ -b $device ]] || die "$device is gone."
  lsblk -J -b -d -o PATH,SIZE,SERIAL,TYPE,RM,TRAN -- "$device" | stick_matches "$size" "$serial" ||
    die "$device is not the stick that was picked (size, serial or kind differ). Nothing was written."
  ! system_disks | grep -qx -- "$device" || die "$device holds this running system. Nothing was written."
  [[ -z $(mounted_partitions "$device") ]] || die "$device has mounted partitions. Nothing was written."
  ! lsblk -nro TYPE -- "$device" | grep -Eq '^(crypt|lvm|raid[0-9]*|md|dm)$' ||
    die "$device is in use (an open encrypted or LVM volume on it). Nothing was written."
  [[ ! -e /dev/mapper/$MAPPER ]] || die "an earlier nova usb left /dev/mapper/$MAPPER open; close it with: sudo cryptsetup close $MAPPER"
}

wait_for() { # device
  local i
  for ((i = 0; i < 50; i++)); do
    [[ -b $1 ]] && return 0
    udevadm settle 2>/dev/null || sleep 0.1
  done
  [[ -b $1 ]]
}

# The packages, straight onto the stick, each with its signature. FAT cannot
# name a file with a colon (an epoch: ffmpeg-2:7.1-1), so those are saved with
# an underscore; pacman fetches by the name in the database, which repo-add
# takes from the file.
download_packages() { # urls dir
  local urls=$1 dir=$2 url name config
  config=$(mktemp)
  while IFS=$'\t' read -r url _; do
    [[ -n $url ]] || continue
    name=${url##*/}
    name=$(printf '%b' "${name//%/\\x}")
    name=${name//:/_}
    # Decoded, %2F is a slash: as root, a name like that could write anywhere.
    [[ -n $name && $name != [.-]* && $name != */* ]] || {
      echo "nova usb: refusing the package file name '$name'" >&2
      rm -f -- "$config"
      return 1
    }
    printf 'url = "%s"\noutput = "%s/%s"\nurl = "%s.sig"\noutput = "%s/%s.sig"\n' "$url" "$dir" "$name" "$url" "$dir" "$name"
  done <"$urls" >"$config"
  curl --parallel --parallel-max 6 --fail --location --retry 3 --show-error --config "$config" || {
    rm -f -- "$config"
    return 1
  }
  rm -f -- "$config"
}

# repo-add writes a symlink FAT cannot hold, so the database is made aside and
# copied under both names pacman looks for.
make_offline_repo() { # dir
  local dir=$1 tmp
  tmp=$(mktemp -d)
  repo-add -q "$tmp/nova-offline.db.tar.gz" "$dir"/*.pkg.tar.zst >/dev/null || { rm -rf -- "$tmp"; return 1; }
  cp -- "$tmp/nova-offline.db.tar.gz" "$dir/nova-offline.db"
  cp -- "$tmp/nova-offline.db.tar.gz" "$dir/nova-offline.db.tar.gz"
  rm -rf -- "$tmp"
}

# The names in a NUL-separated list that are still there. The wizard listed
# them minutes ago, and tar gives up on a name it is handed that has gone since
# (an editor's swap file, say). The list is the user's and the writer is root,
# so a name that would leave the home is dropped.
still_there() { # home list
  local name
  while IFS= read -r -d '' name; do
    [[ $name != /* && /$name/ != */../* ]] || continue
    if [[ -e $1/$name || -L $1/$name ]]; then printf '%s\0' "$name"; fi
  done <"$2"
}

# One item as a zstd-compressed tar, as root, so the system items can be read
# and the files keep their modes. A file changed while it was read (an open
# Chrome, say) is a warning; a file that cannot be read at all, which is how
# btrfs reports a checksum error, stops everything.
make_archive() { # id plan home out
  local id=$1 plan=$2 home=$3 out=$4 kind path pattern transform args=() err status files='' gitdirs=''
  kind=$(item_field "$id" 3)
  args=(--create --file=- --null --verbatim-files-from)
  case $kind in
    home | system)
      while IFS= read -r pattern; do args+=("--exclude=$pattern"); done < <(item_excludes "$id")
      transform=$(item_transform "$id")
      [[ -z $transform ]] || args+=("--transform=$transform")
      if [[ $kind == home ]]; then args+=(-C "$home"); else args+=(-C "$SYSROOT/"); fi
      local present=()
      while IFS= read -r path; do
        if [[ $kind == system ]]; then
          [[ -e $SYSROOT$path ]] && present+=("${path#/}")
        else
          [[ -e $home/$path || -L $home/$path ]] && present+=("$path")
        fi
      done < <(item_paths "$id")
      ((${#present[@]})) || return 2
      args+=(-- "${present[@]}")
      ;;
    # The lists that are still there go in files of the writer's own: the
    # plan's directory is the user's, and a link planted there would have root
    # write through it.
    projects)
      files=$(mktemp) gitdirs=$(mktemp)
      still_there "$home" "$plan/projects.files" >"$files"
      still_there "$home" "$plan/projects.gitdirs" >"$gitdirs"
      args+=(-C "$home" --no-recursion -T "$files" --recursion -T "$gitdirs")
      ;;
    folders)
      files=$(mktemp)
      still_there "$home" "$plan/folders.list" >"$files"
      args+=(-C "$home" -T "$files")
      ;;
    list) args+=(-C "$plan" -- packages.txt aur.txt) ;;
    *) return 1 ;;
  esac
  err=$(mktemp)
  set +e
  tar "${args[@]}" 2>"$err" | zstd -q -f -T0 -3 -o "$out"
  status=("${PIPESTATUS[@]}")
  set -e
  rm -f -- ${files:+"$files"} ${gitdirs:+"$gitdirs"}
  if ((status[0] > 1 || status[1] != 0)); then
    sed 's/^/    /' "$err" >&2
    rm -f -- "$err"
    return 1
  fi
  ((status[0] == 0)) || warn "Some files changed while they were copied; their newest version may be missing."
  rm -f -- "$err"
}

# A hash of this computer's identity, so the installer puts back Bluetooth
# pairings and fingerprints only on the computer they belong to.
machine_hash() {
  local id
  id=$(cat "$DMI/product_uuid" "$DMI/product_serial" 2>/dev/null) || true
  [[ -n $id ]] || return 0
  printf '%s' "$id" | sha256sum | awk '{ print $1 }'
}

write_stick() { # plan, with the passphrase on stdin
  local plan=${1:?the writer needs a plan}
  ((EUID == 0)) || die "the writer runs as root (sudo nova-usb write <plan>)"
  [[ -r $plan/plan.env ]] || die "no plan at $plan"
  local device size serial iso user home items offline installer_mib keymap passphrase=''
  device=$(plan_value "$plan" device)
  size=$(plan_value "$plan" size)
  serial=$(plan_value "$plan" serial)
  iso=$(plan_value "$plan" iso)
  user=$(plan_value "$plan" user)
  home=$(plan_value "$plan" home)
  items=$(plan_value "$plan" items)
  offline=$(plan_value "$plan" offline)
  installer_mib=$(plan_value "$plan" installer_mib)
  keymap=$(plan_value "$plan" keymap)
  IFS= read -r -d '' passphrase || true
  [[ $device == /dev/* && $size =~ ^[0-9]+$ && $installer_mib =~ ^[0-9]+$ && -r $iso ]] || die "the plan is incomplete"
  [[ -z $items || -n $passphrase ]] || die "things to carry, and no passphrase to lock them with"
  local id
  for id in $items; do valid_item "$id" || die "the plan names an unknown item: $id"; done
  check_stick "$device" "$size" "$serial"

  WORK=$(mktemp -d /tmp/nova-usb-write.XXXXXX)
  trap writer_cleanup EXIT
  mkdir -p "$WORK/iso" "$WORK/stick" "$WORK/data"
  hide_from_desktop "$device"

  say "Partitioning $device"
  wipefs -aq "$device"
  {
    echo 'label: gpt'
    echo "size=${installer_mib}MiB, type=uefi, name=\"NOVA\""
    [[ -z $items ]] || echo 'type=linux, name="NOVA-DATA"'
  } | sfdisk -q --wipe always --wipe-partitions always "$device" >/dev/null
  partprobe "$device" 2>/dev/null || true
  # udev looks the new partitions over first; mkfs waits for it to finish.
  udevadm settle 2>/dev/null || true
  local p1 p2
  p1=$(partition_path "$device" 1)
  p2=$(partition_path "$device" 2)
  wait_for "$p1" || die "the new partition $p1 did not appear"
  mkfs.fat -F 32 -n NOVA "$p1" >/dev/null

  say "Copying the installer"
  mount -o loop,ro -- "$iso" "$WORK/iso"
  mount -- "$p1" "$WORK/stick"
  cp -r -- "$WORK/iso/." "$WORK/stick/"
  if [[ $keymap =~ ^[a-z][a-z0-9_-]*$ ]]; then
    mkdir -p "$WORK/stick/nova"
    echo "$keymap" >"$WORK/stick/nova/keymap"
  fi
  if [[ $offline == 1 ]]; then
    say "Downloading the packages onto the stick"
    mkdir -p "$WORK/stick/nova/repo"
    download_packages "$plan/offline.urls" "$WORK/stick/nova/repo" || die "a package did not download"
    make_offline_repo "$WORK/stick/nova/repo" || die "could not index the packages"
  fi
  umount "$WORK/stick"

  if [[ -n $items ]]; then
    say "Encrypting the second partition"
    wait_for "$p2" || die "the new partition $p2 did not appear"
    printf '%s' "$passphrase" | cryptsetup luksFormat --type luks2 --batch-mode --label NOVA-DATA --key-file - "$p2"
    printf '%s' "$passphrase" | cryptsetup open --key-file - "$p2" "$MAPPER"
    mkfs.btrfs -q -f -L nova-data "/dev/mapper/$MAPPER"
    mount "/dev/mapper/$MAPPER" "$WORK/data"
    mkdir -p "$WORK/data/carry"
    local entries=() file label status
    for id in $items; do
      label=$(item_field "$id" 2)
      info "$label"
      file=$id.tar.zst
      set +e
      make_archive "$id" "$plan" "$home" "$WORK/data/carry/$file"
      status=$?
      set -e
      case $status in
        0) ;;
        2)
          rm -f -- "$WORK/data/carry/$file"
          continue
          ;;
        *) die "could not copy $label; the stick is not finished." ;;
      esac
      entries+=("$(jq -nc --arg id "$id" --arg kind "$(item_field "$id" 3)" --arg file "$file" --arg label "$label" \
        --argjson bytes "$(stat -c %s -- "$WORK/data/carry/$file")" '{id: $id, kind: $kind, label: $label, file: $file, bytes: $bytes}')")
    done
    ((${#entries[@]})) || die "none of the chosen things were found; nothing to carry."
    printf '%s\n' "${entries[@]}" | jq -s --arg user "$user" --arg home "$home" --arg machine "$(machine_hash)" \
      --arg name "$(getent passwd "$user" | cut -d: -f5 | cut -d, -f1)" --arg timezone "$(local_timezone)" \
      --arg created "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg host "$(cat /proc/sys/kernel/hostname 2>/dev/null)" \
      '{version: 1, created: $created, source: {user: $user, name: $name, home: $home, host: $host, machine: $machine, timezone: $timezone}, items: .}' \
      >"$WORK/data/carry/manifest.json"
    (cd "$WORK/data/carry" && sha256sum -- manifest.json *.tar.zst >SHA256SUMS)
    umount "$WORK/data"
    cryptsetup close "$MAPPER"
  fi
  sync

  # Read back what was written. Unmounting dropped it from the page cache, so
  # this reads the stick itself.
  say "Checking the stick"
  mount -o ro -- "$p1" "$WORK/stick"
  diff -r --exclude=repo --exclude=keymap -- "$WORK/iso" "$WORK/stick" >/dev/null || die "the installer on the stick does not match the ISO; the stick may be failing."
  if [[ $offline == 1 ]]; then
    info "Reading the packages back"
    zstd -tq -- "$WORK/stick/nova/repo"/*.pkg.tar.zst || die "the packages on the stick do not read back whole; the stick may be failing."
  fi
  umount "$WORK/stick"
  if [[ -n $items ]]; then
    printf '%s' "$passphrase" | cryptsetup open --readonly --key-file - "$p2" "$MAPPER"
    mount -o ro "/dev/mapper/$MAPPER" "$WORK/data"
    (cd "$WORK/data/carry" && sha256sum --quiet -c SHA256SUMS) || die "what was carried does not read back the same; the stick may be failing."
    umount "$WORK/data"
    cryptsetup close "$MAPPER"
  fi
  umount "$WORK/iso"
  sync
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
