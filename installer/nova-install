#!/bin/bash
#
# nova-install: install Nova from the USB stick onto this computer's disk.
#
# Runs as root in the live system. Every question comes first, one a screen
# (installer/ui.bash), then one summary, and only after "erase" is typed does
# anything touch a disk. The whole disk is
# used: a 2 GiB EFI system partition and one btrfs partition holding the
# subvolumes that snapshots and rollback expect (@ @home @log @pkg @snapshots
# @swap). The btrfs partition can be encrypted (LUKS2), when asked for.
#
# Packages come from the offline repository on the stick when there is one, and
# otherwise from the pinned Arch snapshot and [nova] repository named in the
# release file. Either way the installed system ends up pointed at the release
# it was installed from, which is what `nova update` moves forward.
#
#   nova-install                  the interactive install
#   nova-install --answers FILE   the same install with no questions, answered
#                                 by FILE in key=value lines: keymap, disk,
#                                 fullname, user, password (8 characters or
#                                 more), hostname, timezone,
#                                 passphrase (for things carried), erase=yes to
#                                 go ahead, and optionally encrypt=yes with
#                                 disk_passphrase (8 characters or more), apps=no and
#                                 after=<script>, run in the new system at the
#                                 end. tests/install/run uses it.
#   nova-install --portable [disk]
#                                 Nova onto a USB disk of 32 GB or more, to
#                                 start any PC from: the disk given (nova usb
#                                 picks it), or one asked for. portable=yes in
#                                 an answers file does the same.
#   nova-install --portable-disks the USB disks --portable would offer
#   nova-install --unlock         open the things carried on the stick (nova usb)
#   nova-install --keymap [km]    the keyboard layout screen, km first; prints
#                                 the keymap chosen (km for Esc)
#   nova-install --list-packages  every package an install on any computer can
#                                 need: what nova usb puts on a stick
#   nova-install --help           this text
#
# Exits 3, with nothing changed and before any question, on a computer that
# has to be set otherwise first: started in legacy BIOS mode, or with Secure
# Boot on, which would refuse to start the boot loader Nova installs.
#
# A portable install is the same Nova, made a guest on every computer it
# starts: Arch's own kernel, which any 64-bit CPU runs; every computer's
# microcode and video drivers; an initramfs for every computer rather than
# this one; no swap file, since a hibernated image must never resume on
# another computer; and no boot entry in any computer's firmware, now or
# when Limine updates, since the stick starts from EFI/BOOT/BOOTX64.EFI.
# /etc/nova/portable marks it, and what is tuned for one model (its /etc
# files, its packages, an undervolt) stays off.
#
# NOVA_* variables override paths for testing; the functions are sourceable
# (tests/unit/installer/install.bats) and `main` runs only when executed.

set -euo pipefail

SHARE=${NOVA_INSTALLER_SHARE:-/usr/share/nova-installer}
TARGET=${NOVA_TARGET:-/mnt}
STICK=${NOVA_STICK:-/run/archiso/bootmnt}
OFFLINE_REPO=${NOVA_OFFLINE_REPO:-$STICK/nova/repo}
RELEASE_FILE=${NOVA_RELEASE_FILE:-$SHARE/release.toml}
CPUINFO=${NOVA_CPUINFO:-/proc/cpuinfo}
MEMINFO=${NOVA_MEMINFO:-/proc/meminfo}
PCI_DEVICES=${NOVA_PCI_DEVICES_PATH:-/sys/bus/pci/devices}
LOG=${NOVA_INSTALL_LOG:-/var/log/nova-install.log}
CARRY=${NOVA_CARRY:-/run/nova-carry}
DMI=${NOVA_DMI_PATH:-/sys/class/dmi/id}
EFI=${NOVA_EFI_PATH:-/sys/firmware/efi}
FPRINT_DIR=${NOVA_FPRINT_DIR:-/var/lib/fprint}
# The answers file, for an install with no questions (--answers).
ANSWERS=''
CARRY_MAPPER=nova-carry
# Left by "Enter to install without them", so the passphrase is asked once.
CARRY_DECLINED=$CARRY.declined

ESP_MIB=2048
MIN_DISK_BYTES=$((64 * 1024 * 1024 * 1024))
BTRFS_OPTS=noatime,compress=zstd:1
SUBVOLUMES=("@:/" "@home:/home" "@log:/var/log" "@pkg:/var/cache/pacman/pkg" "@snapshots:/.snapshots" "@swap:/swap")
# The opened LUKS2 container of an encrypted install, as /dev/mapper/ names it
# here (CRYPT_NAME) and in the new system's initramfs (BOOT_CRYPT_NAME). The
# same but for a portable install, which may be made from a running Nova
# whose own root already has the name.
CRYPT_NAME=nova-root
BOOT_CRYPT_NAME=nova-root

# A portable install (--portable): onto a USB disk, of 32 GB or more, which a
# "32 GB" stick is (about 29.8 GiB): the system, its apps and snapshots take
# about 12 GB, and the rest is the home's.
PORTABLE=0
PORTABLE_DISK=''
MIN_PORTABLE_BYTES=$((28 * 1024 * 1024 * 1024))
PORTABLE_MARKER=/etc/nova/portable

# What each kind of display controller needs beyond mesa, which has the AMD
# video driver built in. hardware_packages picks this machine's; every_package
# lists them all. NVK, Vulkan on nouveau, is for a portable install, which
# drives NVIDIA cards with nouveau (portable_packages says why).
GPU_INTEL=(intel-media-driver vulkan-intel)
GPU_AMD=(vulkan-radeon)
GPU_NOUVEAU=(vulkan-nouveau)

# An Intel MIPI camera, an IPU6 or IPU7, by the device ids the kernel's
# intel-ipu6 and intel-ipu7 drivers take (nova doctor has the same list).
# Apps reach it through PipeWire's libcamera plugin, which WirePlumber leaves
# a USB camera's to V4L2.
IPU_IDS=" 0x9a19 0x4e19 0x465d 0x462e 0xa75d 0x7d19 0x645d 0xb05d "
CAMERA_IPU=(libcamera libcamera-ipa pipewire-libcamera)

# The setup screens' look, and the questions and account every Nova setup
# shares: beside this file in the repository, in the share on the stick.
if [[ -r ${BASH_SOURCE[0]%/*}/ui.bash ]]; then
  # shellcheck source=installer/ui.bash
  source "${BASH_SOURCE[0]%/*}/ui.bash"
  # shellcheck source=installer/setup.bash
  source "${BASH_SOURCE[0]%/*}/setup.bash"
  # shellcheck source=installer/wifi.bash
  source "${BASH_SOURCE[0]%/*}/wifi.bash"
else
  # shellcheck source=installer/ui.bash
  source "$SHARE/ui.bash"
  # shellcheck source=installer/setup.bash
  source "$SHARE/setup.bash"
  # shellcheck source=installer/wifi.bash
  source "$SHARE/wifi.bash"
fi

# While the progress view is up, what is said goes into it, and into the log
# as plain lines.
say() {
  if ((PROGRESS)); then printf '\n%s\n' "$*" >&2; else echo >&2; ui_title "$*"; fi
  progress_event say "$*"
}
info() {
  if ((PROGRESS)); then printf '%s\n' "$*" >&2; else ui_note "$*"; fi
  progress_event info "$*"
}
warn() {
  if ((PROGRESS)); then printf '%s\n' "$*" >&2; else ui_warn "$*"; fi
  progress_event warn "$*"
  [[ -z ${UI_NOTES:-} ]] || printf '%s\n' "$*" >>"$UI_NOTES"
}
die() {
  local shown=$PROGRESS
  progress_end fail
  echo >&2
  ui_error "nova-install: $*"
  ((!shown)) || progress_tail
  exit 1
}

# ------------------------------------------------------------------- the disk

# The disk the live system booted from, so it is never offered. Empty when it
# cannot be told (booted with copytoram, say); removable disks are left out
# anyway.
boot_disk() {
  local src parent
  src=$(findmnt -no SOURCE -- "$STICK" 2>/dev/null) || return 0
  [[ -b $src ]] || return 0
  parent=$(lsblk -no PKNAME -- "$src" 2>/dev/null | awk 'NR == 1')
  if [[ -n $parent ]]; then echo "/dev/$parent"; else echo "$src"; fi
}

lsblk_disks() {
  lsblk -J -b -d -o NAME,PATH,SIZE,MODEL,SERIAL,TYPE,RM,RO,TRAN
}

# One tab-separated line per disk Nova may go on: path, size in bytes, model,
# serial, transport, with "-" for an unknown field so the columns never shift.
# Left out: the stick it booted from, read-only, removable and USB disks,
# virtual devices, and anything under 64 GiB. NOVA_ALLOW_USB=1 lets a USB disk
# through, for installing onto an external drive on purpose.
#
# A portable install turns the rule around: only removable and USB disks, of
# 32 GB or more. NOVA_ALLOW_ANY=1 lets any disk through, an image file on a
# loop device too, the way nova usb's own NOVA_USB_ALLOW_ANY does for tests.
candidate_disks() {
  local boot min=$MIN_DISK_BYTES
  boot=$(boot_disk)
  ((!PORTABLE)) || min=$MIN_PORTABLE_BYTES
  lsblk_disks | jq -r --arg boot "$boot" --argjson min "$min" --arg usb "${NOVA_ALLOW_USB:-0}" \
    --arg portable "$PORTABLE" --arg any "${NOVA_ALLOW_ANY:-0}" '
    def yes: . == true or . == "1" or . == 1;
    def portable: $portable == "1";
    .blockdevices[]
    | select((.type == "disk" or (portable and $any == "1" and .type == "loop")) and .path != $boot)
    | select(.ro | yes | not)
    | if portable then select($any == "1" or (.rm | yes) or .tran == "usb")
      else select($usb == "1" or ((.rm | yes | not) and .tran != "usb")) end
    | select((.name | test("^(zram|sr|ram|fd)")) | not)
    | select((.size | tonumber) >= $min)
    | def field: (. // "") | tostring | gsub("^\\s+|\\s+$"; "") | if . == "" then "-" else . end;
      [.path, (.size | tostring), (.model | field), (.serial | field), (.tran | field)]
    | @tsv'
}

# Something on the live system is using the disk: a mounted partition, active
# swap, or an LVM, RAID or dm-crypt device built on it.
disk_in_use() {
  local disk=$1
  lsblk -nro MOUNTPOINTS -- "$disk" | grep -q . && return 0
  lsblk -nro TYPE -- "$disk" | grep -Eq '^(lvm|crypt|raid[0-9]*|dm|md)$'
}

# What an install that stopped part-way left behind: its swap file in use and
# the new system mounted at $TARGET. Both are let go before the disk is chosen,
# or the disk would look in use by the live system and could not be picked.
release_target() {
  if swapon --noheadings --show=NAME 2>/dev/null | grep -qxF -- "$TARGET/swap/swapfile"; then
    swapoff -- "$TARGET/swap/swapfile" || die "could not stop using the last try's swap file; restart and try again."
  fi
  if mountpoint -q -- "$TARGET"; then
    info "Unmounting what the last try left at $TARGET"
    umount -R -- "$TARGET" || die "something still uses $TARGET; restart and try again."
  fi
  if [[ -e /dev/mapper/$CRYPT_NAME ]]; then
    cryptsetup close "$CRYPT_NAME" || die "could not close the last try's encrypted disk; restart and try again."
  fi
}

# /dev/nvme0n1 -> /dev/nvme0n1p2, /dev/sda -> /dev/sda2
partition_path() {
  local disk=$1 number=$2
  if [[ $disk =~ [0-9]$ ]]; then echo "${disk}p$number"; else echo "$disk$number"; fi
}

human_size() {
  awk -v b="$1" 'BEGIN { split("B KB MB GB TB PB", u); i = 1; while (b >= 1000 && i < 6) { b /= 1000; i++ } printf (i > 3 ? "%.1f %s" : "%.0f %s"), b, u[i] }'
}

# Swap for hibernation: the size of RAM, so a full image always fits, rounded
# up to a GiB and never more than an eighth of the disk.
swap_gib() {
  local disk_bytes=$1 ram_gib cap
  ram_gib=$(awk '/^MemTotal:/ { printf "%d", ($2 + 1048575) / 1048576 }' "$MEMINFO")
  cap=$((disk_bytes / 8 / 1024 / 1024 / 1024))
  ((ram_gib > 0)) || ram_gib=8
  if ((ram_gib > cap)); then echo "$cap"; else echo "$ram_gib"; fi
}

# ------------------------------------------------------------- the machine

cpu_has_x86_64_v3() {
  local flags f
  flags=$(grep -m 1 '^flags' "$CPUINFO" 2>/dev/null) || return 1
  for f in avx avx2 bmi1 bmi2 f16c fma abm movbe xsave; do
    [[ " ${flags#*:} " == *" $f "* ]] || return 1
  done
}

cpu_vendor() {
  awk -F': ' '/^vendor_id/ { print $2; exit }' "$CPUINFO" 2>/dev/null
}

# Whether the firmware has Secure Boot on. Its SecureBoot variable is four
# bytes of attributes and one of value, 1 when on. Firmware without it has no
# Secure Boot to be on, and one that cannot be read counts as off: this stops
# an install, so only a plain yes does.
secure_boot_on() {
  local value
  value=$(od -An -tu1 -j4 -N1 -- "$EFI/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c" 2>/dev/null) || return 1
  [[ ${value//[[:space:]]/} == 1 ]]
}

# What turning Secure Boot off costs a PC with Windows on it.
BITLOCKER_NOTE=$'A PC with Windows and BitLocker or Device Encryption asks for its recovery\nkey at its next start once Secure Boot is off: have the key at hand first.'

# This computer has to be set otherwise before Nova can go on it: said on a
# screen of its own, before any question, with nothing changed. Exits 3, so
# nova-install-start knows trying again as it is would not help.
not_ready() { # setting what [note...]
  local note
  if [[ -z $ANSWERS ]]; then screen '' "$1"; else echo >&2; fi
  ui_error "$2"
  for note in "${@:3}"; do
    echo >&2
    ui_note "$note"
  done
  exit 3
}

# Nova goes only onto a computer that will start it: one that booted the stick
# with UEFI, and with Secure Boot off, since Limine and the kernels Nova
# installs are not signed for it. A portable install is made here and started
# elsewhere, so this computer's settings are no matter to it; its last screen
# says what the PCs it starts need.
computer_ready() {
  ((!PORTABLE)) || return 0
  [[ -d $EFI ]] ||
    not_ready UEFI "This computer started the stick in legacy BIOS mode; Nova needs UEFI." \
      $'Turn on UEFI boot in the firmware settings, then start this stick again.\nNothing was changed.'
  if secure_boot_on; then
    not_ready "Secure Boot" "Secure Boot is on, so this computer would not start Nova once installed." \
      $'Nova\'s boot loader is not signed for it. Turn Secure Boot off in the\nfirmware settings: restart, press the setup key as the computer starts (F2,\nF1, Del or Esc on most; Enter, then F1, on a ThinkPad), set Secure Boot to\nDisabled under Security or Boot, save, and start this stick again.\nNothing was changed.' \
      "$BITLOCKER_NOTE"
  fi
}

# The kernel Nova boots: linux-nova is built for x86-64-v3, so an older CPU
# gets Arch's own kernel instead. linux-lts is installed either way as the
# fallback entry. A portable install cannot know which CPU it will start on
# next, so it always has Arch's.
main_kernel() {
  if ((!PORTABLE)) && cpu_has_x86_64_v3; then echo linux-nova; else echo linux; fi
}

# A portable install starts a different computer each time, so it has what any
# of them needs: both microcodes (the initramfs loads the one that fits) and
# the Intel and AMD video drivers. NVIDIA cards run on nouveau, with NVK for
# Vulkan: NVIDIA's own driver blacklists nouveau and drives nothing older than
# Turing, so on the computers it does not fit it would leave no driver at all.
portable_packages() {
  printf '%s\n' intel-ucode amd-ucode "${GPU_INTEL[@]}" "${GPU_AMD[@]}" "${GPU_NOUVEAU[@]}"
}

# Packages this hardware needs, from the CPU and the display controllers,
# modem and camera in sysfs (never lspci, which wakes a sleeping GPU). The
# model's own profile adds to this; see profile_packages. A portable install's
# are portable_packages.
hardware_packages() {
  local kernel=$1 dev vendor device dgpu=0 igpu=0 modem=0 camera=0
  if ((PORTABLE)); then
    portable_packages
    return 0
  fi
  case $(cpu_vendor) in
    GenuineIntel) echo intel-ucode ;;
    AuthenticAMD) echo amd-ucode ;;
  esac
  for dev in "$PCI_DEVICES"/*; do
    [[ -r $dev/class ]] || continue
    # A cellular modem on PCIe: ModemManager reads its SIM and runs it. With
    # no SIM, Nova keeps it switched off (shell/plugins/mobile-data).
    if [[ $(<"$dev/class") == 0x0d40* ]]; then modem=1; continue; fi
    vendor=$(<"$dev/vendor")
    if [[ $vendor == 0x8086 && $IPU_IDS == *" $(<"$dev/device") "* ]]; then camera=1; continue; fi
    [[ $(<"$dev/class") == 0x03* ]] || continue
    case $vendor in
      0x8086) printf '%s\n' "${GPU_INTEL[@]}"; igpu=1 ;;
      0x1002) printf '%s\n' "${GPU_AMD[@]}"; igpu=1 ;;
      0x10de)
        device=$(<"$dev/device")
        # The open modules need GSP firmware, which starts with Turing. The
        # LTS fallback kernel gets its own build, so it can drive the card too.
        if ((device >= 0x1e00)); then
          if [[ $kernel == linux-nova ]]; then echo nvidia-open-nova; else echo nvidia-open; fi
          echo nvidia-open-lts
          echo nvidia-utils
          dgpu=1
        fi
        ;;
    esac
  done
  # With an integrated GPU beside it, the desktop and the browser run on that
  # one, and prime-run puts a game on the NVIDIA card. Whichever card drives
  # the monitors decodes video, which the session decides as it starts
  # (data/hypr/gpu.lua): a desktop with its iGPU on and its monitors on the
  # NVIDIA card has VA-API pointed at NVIDIA's driver, so it is always there.
  if ((dgpu && igpu)); then echo nvidia-prime; fi
  if ((dgpu)); then echo libva-nvidia-driver; fi
  if ((modem)); then echo modemmanager; fi
  if ((camera)); then printf '%s\n' "${CAMERA_IPU[@]}"; fi
}

# This computer's model, as its maker names it; `fallback` when no DMI field
# does.
computer_model() { # fallback
  NOVA_DMI_PATH=$DMI "$SHARE/hardware/nova-hw-model" 2>/dev/null || echo "$1"
}

# The model's profile, which a portable install never takes: the computer it
# is made on is only the first of many.
hardware_profile() {
  ((!PORTABLE)) || return 0
  NOVA_HARDWARE=$SHARE/hardware "$SHARE/hardware/nova-hw-detect" 2>/dev/null || true
}

# The model profile's package list. nvidia-open-nova only exists for linux-nova,
# so an older CPU gets Arch's nvidia-open in its place.
profile_packages() {
  local profile=$1 kernel=$2 name
  [[ -n $profile && -r $SHARE/hardware/$profile/packages ]] || return 0
  while IFS= read -r name; do
    name=${name%%#*}
    name=${name//[[:space:]]/}
    [[ -n $name ]] || continue
    if [[ $name == nvidia-open-nova && $kernel != linux-nova ]]; then name=nvidia-open; fi
    echo "$name"
  done <"$SHARE/hardware/$profile/packages"
}

# Every package an install on any computer could ask for, for the offline
# repository nova usb puts on a stick: one stick installs any machine.
every_package() {
  local list
  {
    grep -v -e '^#' -e '^[[:space:]]*$' "$SHARE/packages"
    printf '%s\n' linux-nova linux linux-lts intel-ucode amd-ucode "${GPU_INTEL[@]}" "${GPU_AMD[@]}" "${GPU_NOUVEAU[@]}" \
      nvidia-open-nova nvidia-open nvidia-open-lts nvidia-utils nvidia-prime libva-nvidia-driver modemmanager "${CAMERA_IPU[@]}"
    for list in "$SHARE"/hardware/*/packages; do
      [[ -r $list ]] || continue
      sed 's/#.*//; s/[[:space:]]//g; /^$/d' "$list"
    done
  } | awk '!seen[$0]++'
}

# Everything pacstrap installs, one per line, without duplicates.
package_set() { # kernel profile [package...]
  local kernel=$1 profile=$2
  {
    grep -v -e '^#' -e '^[[:space:]]*$' "$SHARE/packages"
    echo "$kernel"
    echo linux-lts
    hardware_packages "$kernel"
    profile_packages "$profile" "$kernel"
    printf '%s\n' "${@:3}"
  } | awk 'NF && !seen[$0]++'
}

# --------------------------------------------------------- the release and repos

# A string value from release.toml: key = "value"
release_value() {
  sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\"\\([^\"]*\\)\"[[:space:]]*\$/\\1/p" "$RELEASE_FILE" | awk 'NR == 1'
}

offline_repo_ready() {
  [[ -r $OFFLINE_REPO/nova-offline.db ]]
}

# The pacman.conf pacstrap uses. Offline, one repository on the stick holds
# every package; online, the same repositories the installed system will use.
# A directory of hooks, when given, comes after pacman's own: a hook there of
# the same name as a package's replaces it, and one linked to /dev/null masks
# it.
pacstrap_conf() { # arch-date nova-repo [hook-directory]
  local arch_date=$1 nova_repo=$2 hooks=${3:-}
  cat <<EOF
[options]
Architecture = auto
SigLevel = Required DatabaseOptional
LocalFileSigLevel = Optional
ParallelDownloads = 5
EOF
  [[ -z $hooks ]] || printf 'HookDir = /etc/pacman.d/hooks/\nHookDir = %s/\n' "$hooks"
  if offline_repo_ready; then
    printf '\n[nova-offline]\nServer = file://%s\n' "$OFFLINE_REPO"
  else
    printf '\n[nova]\nSigLevel = Required\nServer = %s\n' "$nova_repo"
    local repo
    for repo in core extra multilib; do
      # shellcheck disable=SC2016 # $arch is pacman's to expand
      printf '\n[%s]\nServer = https://archive.archlinux.org/repos/%s/$repo/os/$arch\n' "$repo" "$arch_date"
    done
  fi
}

# ------------------------------------------------------------- the boot line

# The machine-specific half of the kernel command line; the quiet-boot half is
# in /etc/limine-entry-tool.d/10-nova.conf. zswap is off because zram does the
# compressing. rootflags=subvol=@ is the form limine-snapper-sync rewrites to
# boot a snapshot. root is PARTUUID=<the partition's>, or, encrypted,
# /dev/mapper/nova-root, which rd.luks.name has the initramfs open with the
# passphrase it asks for; the swap file, and so resume, is inside it. A
# portable install has no swap file, so no resume either.
install_cmdline() { # root resume-offset|"" [luks-uuid]
  local root=$1 resume_offset=$2 luks=${3:-}
  [[ -z $luks ]] || printf 'rd.luks.name=%s=%s ' "$luks" "$BOOT_CRYPT_NAME"
  printf 'root=%s rootflags=subvol=@ rw rootfstype=btrfs zswap.enabled=0' "$root"
  [[ -z $resume_offset ]] || printf ' resume=%s resume_offset=%s' "$root" "$resume_offset"
}

# An encrypted install's initramfs asks for the passphrase (sd-encrypt), in
# the keyboard layout picked (sd-vconsole, from /etc/vconsole.conf): both put
# into Nova's own HOOKS line, wherever a later Nova moves the rest of it.
encrypt_mkinitcpio_conf() {
  cat <<'CONF'
# Written by nova-install: the root is encrypted. The initramfs asks for its
# passphrase, in the keyboard layout of /etc/vconsole.conf.
_nova_hooks=()
for _nova_hook in "${HOOKS[@]}"; do
  case $_nova_hook in
    keyboard) _nova_hooks+=(keyboard sd-vconsole) ;;
    block) _nova_hooks+=(block sd-encrypt) ;;
    *) _nova_hooks+=("$_nova_hook") ;;
  esac
done
HOOKS=("${_nova_hooks[@]}")
unset _nova_hooks _nova_hook
CONF
}

limine_install_conf() {
  local cmdline=$1 kernel=$2
  echo "# Written by nova-install for this machine's disk."
  printf 'KERNEL_CMDLINE[default]+=" %s"\n' "$cmdline"
  if [[ $kernel != linux-nova ]]; then
    if ((PORTABLE)); then
      echo "# Portable: Arch's kernel stands in for linux-nova, so any 64-bit CPU starts it."
    else
      echo "# This CPU predates x86-64-v3, so Arch's kernel stands in for linux-nova."
    fi
    echo "MKINITCPIO_FALLBACK=$kernel"
    echo "BOOT_ORDER=\"$kernel, *fallback, linux-lts, *, Snapshots\""
  fi
  if ((PORTABLE)); then
    # limine-install reads this at every run, the limine package's own hook
    # after an update included, so the promise holds for as long as the stick
    # is used, not only on the day it is made.
    echo "# Portable: Limine starts from EFI/BOOT/BOOTX64.EFI on the stick, and no"
    echo "# computer it meets gets a boot entry written into its firmware."
    echo "SKIP_UEFI=yes"
  fi
}

# The initramfs of a portable install is for every computer, not the one it
# was built on: without autodetect it holds every disk, USB and keyboard
# driver, so the stick starts, and its passphrase can be typed, anywhere.
# Without kms, about a third of the size: kms would add every GPU driver and
# its firmware, for the screen to change mode a second sooner. The video
# driver then loads from the stick.
portable_mkinitcpio_conf() {
  cat <<'CONF'
# Written by nova-install --portable: an initramfs for every computer this
# stick starts, not only the one it was made on.
_nova_hooks=()
for _nova_hook in "${HOOKS[@]}"; do
  case $_nova_hook in
    autodetect | nova-blacklist | kms) ;;
    *) _nova_hooks+=("$_nova_hook") ;;
  esac
done
HOOKS=("${_nova_hooks[@]}")
unset _nova_hooks _nova_hook
CONF
}

# No hibernation on a portable install: there is no swap file to write memory
# to, and an image written on one computer must never resume on another.
portable_sleep_conf() {
  cat <<'CONF'
# Written by nova-install --portable: sleep is suspend alone. A hibernated
# image must never resume on another computer, and there is no swap file to
# write one to.
[Sleep]
AllowHibernation=no
AllowSuspendThenHibernate=no
AllowHybridSleep=no
CONF
}

portable_marker() {
  cat <<'MARKER'
# Written by nova-install --portable. This Nova runs from a USB disk, on
# whatever computer it is plugged into, so nothing tuned for one model applies:
# nova-hw-apply puts no model's files in /etc, nova update adds no model's
# packages, and nova power undervolt stays off.
MARKER
}

# What makes a portable install one, written before pacstrap: the kernels'
# install hooks build the initramfs with the mkinitcpio drop-in, and the nova
# package's own hook (nova-hw-apply) reads the marker.
write_portable_config() {
  portable_marker | install -Dm644 /dev/stdin "$TARGET$PORTABLE_MARKER"
  portable_mkinitcpio_conf | install -Dm644 /dev/stdin "$TARGET/etc/mkinitcpio.conf.d/30-nova-portable.conf"
  portable_sleep_conf | install -Dm644 /dev/stdin "$TARGET/etc/systemd/sleep.conf.d/20-nova-portable.conf"
}

# Into portable mode, from --portable or an answers file's portable=yes. The
# container is opened under a name of its own: nova usb runs this on a running
# system, which may be a Nova with its own nova-root. Encryption starts ticked
# on screen: a stick is easy to lose.
portable_mode() {
  PORTABLE=1
  CRYPT_NAME=nova-usb-root
  ENCRYPT=yes
}

# genfstab writes subvolid= next to subvol=, and a subvolid pins the mount to
# one subvolume forever: rolling back to a snapshot would mount the old one.
strip_subvolid() {
  sed -E 's/,subvolid=[0-9]+//; s/subvolid=[0-9]+,//'
}

# ------------------------------------------------------------- the questions
#
# The questions themselves are installer/setup.bash's; these are the
# installer's own.

# An answer from the answers file: the last key=value line for the key.
answer() { # key
  sed -n "s/^$1=//p" "$ANSWERS" | tail -n 1
}

# The answers, asked on screen or read from the answers file.
KEYMAP='' DISK_LINE='' FULLNAME='' ACCOUNT='' PASSWORD='' COMPUTER='' TIMEZONE='' FINGERPRINT=''
ENCRYPT=no DISK_PASSPHRASE=''
# Who FINGERPRINT was enrolled for: going back and changing the username
# leaves the print behind.
ENROLLED_FOR=''
UI_STOPPED="The installer stopped; nothing was changed. nova-install-start starts it again."

# What carried things say about the computer they came from, as defaults.
carried_default() { # name|user|host|timezone
  carry_ready || return 0
  local value
  value=$(carry_value ".source.$1")
  case $1 in
    name) valid_fullname "$value" || value= ;;
    user) valid_username "$value" || value= ;;
    # Only for this same computer; another one deserves its own name.
    host) [[ -n $(machine_hash) && $(machine_hash) == "$(carry_value .source.machine)" ]] && valid_hostname "$value" || value= ;;
    timezone) valid_timezone "$value" || value= ;;
  esac
  echo "$value"
}

# A portable install is a computer of its own, on every network it joins, so
# it is not named after the one it is made on.
default_answer() {
  if ((PORTABLE)) && [[ $1 == host ]]; then
    echo nova-usb
    return 0
  fi
  carried_default "$1"
}

# Why no disk is offered.
no_disk() {
  if ((PORTABLE)); then
    echo "no USB disk to put Nova on: it needs a USB stick or drive of 32 GB or more, besides the stick this runs from."
  else
    echo "no disk to install on: Nova needs an internal disk of at least 64 GiB."
  fi
}

# --answers: every answer from the file, where a wrong one ends the install
# rather than asking again.
answers_from_file() {
  local line
  KEYMAP=$(answer keymap)
  KEYMAP=${KEYMAP:-us}
  valid_keymap "$KEYMAP" || die "the answers file: no keyboard layout called '$KEYMAP'."
  local disks=()
  mapfile -t disks < <(candidate_disks)
  ((${#disks[@]})) || die "$(no_disk)"
  DISK_LINE=''
  for line in "${disks[@]}"; do
    [[ ${line%%$'\t'*} == "$(answer disk)" ]] && DISK_LINE=$line
  done
  [[ -n $DISK_LINE ]] || die "the answers file names no disk this can install on (disk=$(answer disk))"
  ! disk_in_use "${DISK_LINE%%$'\t'*}" || die "the answers file's disk is in use by the live system"
  FULLNAME=$(answer_or fullname "$(carried_default name)")
  valid_fullname "$FULLNAME" || die "the answers file: a name without : in it."
  ACCOUNT=$(answer_or user "$(carried_default user)")
  [[ -n $ACCOUNT ]] || ACCOUNT=$(suggested_username "$FULLNAME")
  valid_username "$ACCOUNT" || die "the answers file: no account can be called '$ACCOUNT'."
  PASSWORD=$(answer password)
  [[ -n $PASSWORD ]] || die "the answers file has no password"
  ((${#PASSWORD} >= MIN_PASSWORD)) || die "the answers file: a password of at least $MIN_PASSWORD characters."
  COMPUTER=$(answer_or hostname nova)
  valid_hostname "$COMPUTER" || die "the answers file: no computer can be called '$COMPUTER'."
  TIMEZONE=$(answer_or timezone UTC)
  valid_timezone "$TIMEZONE" || die "the answers file: no time zone called '$TIMEZONE'."
  ENCRYPT=$(answer_or encrypt no)
  [[ $ENCRYPT == yes || $ENCRYPT == no ]] || die "the answers file: encrypt=yes or encrypt=no."
  DISK_PASSPHRASE=''
  if [[ $ENCRYPT == yes ]]; then
    DISK_PASSPHRASE=$(answer disk_passphrase)
    ((${#DISK_PASSPHRASE} >= MIN_PASSWORD)) ||
      die "the answers file: encrypt=yes needs a disk_passphrase of at least $MIN_PASSWORD characters."
  fi
}

# ------------------------------------------------------------- the screens
#
# One question a screen under the wordmark, as nova usb asks its own: Esc goes
# back a step, Ctrl+C stops with nothing changed. Each step_ function returns 1
# for Esc; the keyboard, you and this computer are installer/setup.bash's.
#
# The steps show above each question (UI_TRAIL, ui_trail): the ones
# nova-install-start went through first (NOVA_TRAIL_BEFORE: the keyboard, the
# network), then this installer's own, and the install. A portable install
# says so above them.

screen() { # [the step it is in] [what it is about]
  UI_AT=${1:-}
  if ((PORTABLE)); then
    ui_header "Portable Nova, onto a USB disk${2:+  ·  $2}"
  else
    ui_header "${2:-}"
  fi
}

# The step of the trail each question is in.
trail_step() { # step_ name
  case $1 in
    keymap) echo Keyboard ;;
    disk | encryption) echo Disk ;;
    you | fingerprint) echo You ;;
    computer) echo Computer ;;
    summary) echo Review ;;
  esac
}

step_keymap() {
  ui_ask choose_keymap "${KEYMAP:-us}" || return 1
  KEYMAP=$REPLY
  loadkeys "$KEYMAP" >/dev/null 2>&1 || true
}

# What a disk holds, for the list of disks: each partition's label, file
# system and size, the largest first (on a Windows disk, Windows), the ones
# with neither label nor file system left out. With a width, as many as fit,
# and how many more there are.
disk_held() { # disk [width]
  local width=${2:-0} entries=() i out='' more
  mapfile -t entries < <(disk_contents "$1" | awk '{
      label = ""
      if (match($0, /"[^"]*"$/)) label = substr($0, RSTART)
      fs = ($3 == "no") ? "" : $3
      if (fs == "" && label == "") next
      entry = label
      if (fs != "") entry = entry (entry == "" ? "" : " ") fs
      print $2 "\t" entry " " $2
    }' | sort -t $'\t' -k1,1hr -s | cut -f2-)
  for i in "${!entries[@]}"; do
    more=''
    ((i + 1 == ${#entries[@]})) || more="  ·  +$((${#entries[@]} - i - 1)) more"
    if ((width > 0 && ${#out} + (${#out} ? 5 : 0) + ${#entries[i]} + ${#more} > width)); then
      # The largest alone, when there is room for nothing more.
      if [[ -n $out ]]; then
        out+="  ·  +$((${#entries[@]} - i)) more"
      elif ((${#entries[i]} <= width)); then
        out=${entries[i]}
      else
        out="${#entries[@]} partitions"
      fi
      break
    fi
    out+="${out:+  ·  }${entries[i]}"
  done
  printf '%s' "$out"
}

step_disk() {
  local disks=() options=() names=() sizes=() models=() i path size model held label selected='' problem=''
  local name_width=0 size_width=0 model_width=0
  mapfile -t disks < <(candidate_disks)
  ((${#disks[@]})) || die "$(no_disk)"
  for i in "${!disks[@]}"; do
    IFS=$'\t' read -r path size model _ _ <<<"${disks[i]}"
    [[ $model != - ]] || model="unknown model"
    names[i]=${path#/dev/} sizes[i]=$(human_size "$size") models[i]=$model
    ((${#names[i]} <= name_width)) || name_width=${#names[i]}
    ((${#sizes[i]} <= size_width)) || size_width=${#sizes[i]}
    ((${#model} <= model_width)) || model_width=${#model}
  done
  # In columns: the name, the size and the model line up, then what is on it,
  # as much as fits beside the cursor.
  for i in "${!disks[@]}"; do
    printf -v label '%-*s  %*s  %-*s' "$name_width" "${names[i]}" "$size_width" "${sizes[i]}" "$model_width" "${models[i]}"
    held=$(disk_held "${disks[i]%%$'\t'*}" $(($(ui_frame_width) - 2 - ${#label} - 5)))
    label="$label${held:+  ·  $held}"
    label=${label//[,$'\t']/ }
    label=${label%"${label##*[! ]}"}
    options+=("$label"$'\t'"$i")
    [[ ${disks[i]} != "$DISK_LINE" ]] || selected=$label
  done
  while :; do
    screen Disk
    [[ -z $problem ]] || ui_warn "$problem"
    ui_ask ui_choose "Which disk? Everything on it will be erased." "$selected" "${options[@]}" || return 1
    path=${disks[REPLY]%%$'\t'*}
    if ! disk_in_use "$path"; then
      DISK_LINE=${disks[REPLY]}
      return 0
    fi
    problem="${path#/dev/} is in use by the live system (mounted, swap or LVM). Pick another."
  done
}

# Off unless asked for. On, the btrfs partition is LUKS2 and its passphrase is
# asked at every start, before anything else; the EFI partition, which holds
# the kernels, stays plain for the firmware to start them. A choice rather
# than a yes or no, so Esc goes back to the disk.
step_encryption() {
  local off="No" on="Yes: a passphrase at every start"
  screen Disk
  ui_ask ui_choose "Encrypt the disk?" "$([[ $ENCRYPT == yes ]] && echo "$on" || echo "$off")" \
    "$off"$'\t'no "$on"$'\t'yes || return 1
  ENCRYPT=$REPLY DISK_PASSPHRASE=''
  [[ $ENCRYPT == yes ]] || return 0
  ui_answered Encryption on
  ui_note "Without the passphrase nothing on the disk can be read, by anyone: keep it safe."
  ui_ask ui_password "The disk's passphrase" "$MIN_PASSWORD" || return 1
  DISK_PASSPHRASE=$REPLY
}

# Offered when the reader is one fprintd drives. Esc is No here.
step_fingerprint() {
  screen You
  if ! ui_ask ui_confirm "Unlock with your fingerprint too?"; then
    FINGERPRINT='' ENROLLED_FOR=''
    return 0
  fi
  until enroll_fingerprint "$ACCOUNT"; do
    ui_warn "That did not work."
    if ! ui_ask ui_confirm "Try again?"; then
      FINGERPRINT='' ENROLLED_FOR=''
      ui_note "Settings, Lock Screen sets it up later."
      return 0
    fi
  done
  FINGERPRINT="right index finger" ENROLLED_FOR=$ACCOUNT
}

# What the install will do, one line each; the screens frame it, the answers
# file's install logs it.
summary_lines() {
  local disk size model line
  IFS=$'\t' read -r disk size model _ _ <<<"$DISK_LINE"
  echo "Erased       ${disk#/dev/}  $(human_size "$size")$([[ $model == - ]] || echo "  $model")"
  while IFS= read -r line; do
    [[ -z $line ]] || echo "             now holds $line"
  done < <(disk_contents "$disk")
  if ((PORTABLE)); then
    echo "Layout       2 GiB EFI partition, btrfs with snapshots, no swap file"
    echo "Portable     starts any 64-bit PC from its boot menu, with what is on it"
    echo "             now; no PC's firmware gets a boot entry, this one included"
  else
    echo "Layout       2 GiB EFI partition, btrfs with snapshots, $(swap_gib "$size") GiB swap file"
  fi
  if [[ $ENCRYPT == yes ]]; then
    echo "Encryption   on: the passphrase at every start"
  else
    echo "Encryption   off: anyone with the disk can read it"
  fi
  echo "Kernel       $(main_kernel), with linux-lts as the fallback"
  echo "Account      $ACCOUNT ($FULLNAME) on $COMPUTER"
  echo "Time zone    $TIMEZONE, keyboard $KEYMAP"
  [[ -z $FINGERPRINT ]] || echo "Fingerprint  $FINGERPRINT"
  if carry_ready && [[ -n $(restorable_labels) ]]; then
    echo "Your things  $(restorable_labels | paste -sd, - | sed 's/,/, /g') from $(carry_value .source.host)"
  fi
}

# The summary in its box: each line's label in grey, and the disk that is
# erased in the warning colour, so it is the first thing read.
summary_box() {
  local line lines=()
  while IFS= read -r line; do
    if [[ $line == Erased* ]]; then
      lines+=("$(ui_sgr "$UI_WARN")${line:0:13}$(ui_sgr "$UI_BRIGHT")${line:13}")
    elif [[ ${line:0:13} == *[![:space:]]* ]]; then
      lines+=("$(ui_sgr "$UI_MUTED")${line:0:13}$(ui_sgr "$UI_TEXT")${line:13}")
    else
      lines+=("${line:0:13}$(ui_sgr "$UI_MUTED")${line:13}")
    fi
  done < <(summary_lines)
  ui_box "${lines[@]}"
}

step_summary() {
  local disk=${DISK_LINE%%$'\t'*}
  screen Review
  summary_box
  echo >&2
  ui_note "Nothing has been changed yet."
  echo >&2
  while :; do
    ui_ask ui_input "Type erase to wipe ${disk#/dev/} and $( ((PORTABLE)) && echo "put Nova on it" || echo install), or Esc to go back" || return 1
    [[ $REPLY != erase ]] || return 0
    ui_warn "That is not erase."
  done
}

# The steps in order, Esc stepping back one. The layout is asked only when
# nova-install-start has not asked it already, and the disk only when nova usb
# has not picked it (--portable <disk>).
questions_on_screen() { # fingerprint(yes|no): whether to offer enrolling one
  local steps=() i=0 name trail=" ${NOVA_TRAIL_BEFORE:-} "
  KEYMAP=${NOVA_KEYMAP:-}
  steps=()
  valid_keymap "$KEYMAP" || steps+=(keymap)
  [[ -n $PORTABLE_DISK ]] || steps+=(disk)
  steps+=(encryption you)
  [[ $1 != yes ]] || steps+=(fingerprint)
  steps+=(computer summary)
  for name in "${steps[@]}" install; do
    name=$(trail_step "$name")
    name=${name:-Install}
    [[ $trail == *" $name "* ]] || trail+="$name "
  done
  read -r UI_TRAIL <<<"$trail"
  while ((i < ${#steps[@]})); do
    [[ -z $ENROLLED_FOR || $ENROLLED_FOR == "$ACCOUNT" ]] || FINGERPRINT='' ENROLLED_FOR=''
    if "step_${steps[i]}"; then
      i=$((i + 1))
    elif ((i > 0)); then
      i=$((i - 1))
    else
      die "nothing was changed."
    fi
  done
}

# ------------------------------------------------------------- the install
#
# Each step of the install is timed: its seconds go into the log as it ends,
# as a line of its own (STEP_LINE), and the log ends with a table of them all
# (step_table), so a slow install says where its time went.

STEP_LINE=':: nova-install step:'
STEP='' STEP_STARTED='' INSTALL_STARTED=''

# Microseconds since the epoch, whatever the locale's decimal point.
now_us() { echo "${EPOCHREALTIME//[!0-9]/}"; }

# Seconds since a now_us, to a tenth.
seconds_since() { # microseconds
  local us=$(($(now_us) - $1))
  printf '%d.%d' $((us / 1000000)) $((us / 100000 % 10))
}

log_step() { # label started-microseconds
  printf '%s %s: %s s\n' "$STEP_LINE" "$1" "$(seconds_since "$2")" >>"$LOG"
}

# Runs one step and logs how long it took. A step that fails under set -e
# ends the install where it is, and stopped (the ERR trap) names it.
step() { # label command...
  STEP=$1 STEP_STARTED=$(now_us)
  INSTALL_STARTED=${INSTALL_STARTED:-$STEP_STARTED}
  shift
  printf '\n==> %s\n' "$STEP" >>"$LOG"
  progress_event step "$STEP"
  "$@"
  local status=$?
  log_step "$STEP" "$STEP_STARTED"
  progress_event took "$STEP" "$(seconds_since "$STEP_STARTED")"
  return "$status"
}

# Every step's time, as the log has it, and the whole install's.
step_table() {
  local label seconds
  echo "The install's steps and their times:"
  while IFS=$'\t' read -r label seconds; do
    case $label in
      Packages:*) printf '    %-34s %7s s\n' "${label#Packages: }" "$seconds" ;;
      *) printf '  %-36s %7s s\n' "$label" "$seconds" ;;
    esac
  done < <(sed -n "s/^$STEP_LINE \\(.*\\): \\([0-9.]*\\) s\$/\\1\\t\\2/p" "$LOG")
  [[ -z $INSTALL_STARTED ]] || printf '  %-36s %7s s\n' "In all" "$(seconds_since "$INSTALL_STARTED")"
}

# ------------------------------------------------------------- the progress view
#
# On a screen, the install is one view while it runs, not every command's
# output scrolling by: its parts, ticked with their times as each is done;
# the one running with what it does now and its clock, and for the packages
# a bar, as pacman counts them. What would have scrolled by goes to the log.
# With an answers file, or no terminal, it is plain lines as before.
#
# One process draws the view (progress_view), the only one writing to the
# screen, so its clocks run on while a command says nothing for minutes. The
# install tells it what happens, a line at a time, over a pipe
# (progress_event): step and took (step's), say, info and warn (a part's
# words), part and count (pacstrap's), and end.

PROGRESS=0 PROGRESS_PID='' PROGRESS_ROWS=() PROGRESS_TITLE=()

# The part of the view a step is in.
progress_row() { # step label
  case $1 in
    "Checking the packages") echo "Checking the packages" ;;
    "Partitioning and formatting" | "Subvolumes and swap file" | "Boot configuration") echo "Preparing the disk" ;;
    "Packages, in all") echo "Installing the packages" ;;
    "System configuration" | Snapshots | Account | Fingerprint | "Your things" | Services) echo "Setting up the system" ;;
    "Boot loader") echo "Installing the boot loader" ;;
    Apps) echo "Installing the apps" ;;
    *) echo Finishing ;;
  esac
}

# The view's parts for this install: the packages are checked only online,
# the apps installed only when the answers do not say apps=no.
progress_rows() {
  PROGRESS_ROWS=()
  offline_repo_ready || PROGRESS_ROWS+=("Checking the packages")
  PROGRESS_ROWS+=("Preparing the disk" "Installing the packages" "Setting up the system" "Installing the boot loader")
  [[ $(answer_or apps yes) == no ]] || PROGRESS_ROWS+=("Installing the apps")
  PROGRESS_ROWS+=(Finishing)
}

progress_event() { # field...
  ((PROGRESS)) || return 0
  # A view that is gone reads nothing: the pipe would fill, and the install
  # wait at its next line for good. Its lines go to the screen again instead.
  if ! kill -0 "$PROGRESS_PID" 2>/dev/null; then
    PROGRESS=0
    exec 2>&8 8>&- 7>&-
    printf '\e[?25h\n' >&2
    return 0
  fi
  local IFS=$'\t' strip=$'\t\n'
  printf '%s\n' "${*//[$strip]/ }" >&7 2>/dev/null || true
}

# m:ss, or h:mm:ss, of a number of tenths of a second, into the variable named.
progress_clock() { # variable tenths
  local s=$(($2 / 10))
  if ((s >= 3600)); then
    printf -v "$1" '%d:%02d:%02d' $((s / 3600)) $((s / 60 % 60)) $((s % 60))
  else
    printf -v "$1" '%d:%02d' $((s / 60)) $((s % 60))
  fi
}

# The view: the header of the Install step, PROGRESS_TITLE under it, then a
# line for each part. Redrawn in place, never cleared, so it does not flicker;
# every second for the clocks, and on the install's news, at most ten times a
# second. It ends at the install's end event, with the view as it ended.
progress_view() {
  set +eu
  trap - ERR
  # Counted in characters, the √ and » too.
  local LC_ALL=C.UTF-8
  local cols rows hrows head kind a b c i at=-1 started now row_started last=0 detail='' part='' n=0 total=0 item=''
  local -a secs=() warnings=()
  local c_text c_bright c_muted c_accent c_warn c_error width margin
  cols=$(ui_columns) rows=$(ui_rows)
  # The view has to fit, or redrawing it in place would scroll: under 45
  # rows, the wordmark is the name alone.
  hrows=$rows
  ((rows >= 45)) || hrows=33
  width=$(ui_frame_width "$cols") margin=$(ui_margin "$cols")
  c_text=$(ui_sgr "$UI_TEXT") c_bright=$(ui_sgr "$UI_BRIGHT") c_muted=$(ui_sgr "$UI_MUTED")
  c_accent=$(ui_sgr "$UI_ACCENT") c_warn=$(ui_sgr "$UI_WARN") c_error=$(ui_sgr "$UI_ERROR")
  head=$(COLUMNS=$cols LINES=$hrows UI_NOTES='' ui_header 2>&1)
  started=${EPOCHREALTIME//[!0-9]/} row_started=$started
  printf '\e[?25l\e[H\e[2J' >&2

  # The row of a step, by its label.
  row_of() {
    local name i
    name=$(progress_row "$1")
    for i in "${!PROGRESS_ROWS[@]}"; do
      [[ ${PROGRESS_ROWS[i]} != "$name" ]] || { echo "$i"; return; }
    done
    echo -1
  }

  # A line of the column: left-aligned text, and some at its right edge.
  line() { # colour text [right]
    local right=${3:-} text
    text=${2:0:$((width - ${#right} - 1))}
    printf -v line '%*s%s%s%s%*s\e[0m\e[K\n' "$margin" '' "$1" "$text" "$c_muted" $((width - ${#text})) "$right"
    out+=$line
  }

  frame() { # [ok|fail]: the last one
    local out='' i mark colour time label bar filled
    now=${EPOCHREALTIME//[!0-9]/}
    for label in "${PROGRESS_TITLE[@]}"; do line "$c_muted" "$label"; done
    out+=$'\e[K\n'
    for i in "${!PROGRESS_ROWS[@]}"; do
      label=${PROGRESS_ROWS[i]} time=''
      if ((i < at)); then
        mark='√' colour=$c_accent
        progress_clock time "${secs[i]:-0}"
      elif ((i == at)); then
        mark='»' colour=$c_bright
        [[ ${1:-} != fail ]] || mark='x' colour=$c_error
        progress_clock time $(((now - row_started) / 100000))
      else
        mark='·' colour=$c_muted
      fi
      line "$colour" "$mark $label" "$time"
      ((i == at)) && [[ ${1:-} != ok ]] || continue
      # What the part running does now, and for the packages how far.
      if ((total > 0 && n > 0)); then
        filled=$((n * 24 / total))
        ((filled <= 24)) || filled=24
        printf -v bar '%*s' "$filled" ''
        printf -v time '%*s' $((24 - filled)) ''
        line '' "    $c_accent${bar// /█}$c_muted${time// /░}$c_text  $part $n of $total"
        [[ -z $item ]] || line "$c_muted" "    $item"
      elif [[ -n $part ]]; then
        line "$c_text" "    $part"
        [[ -z $item ]] || line "$c_muted" "    $item"
      elif [[ -n $detail && $detail != "$label" ]]; then
        line "$c_muted" "    $detail"
      fi
    done
    out+=$'\e[K\n'
    progress_clock time $(((now - started) / 100000))
    line "$c_muted" "In all" "$time"
    if ((${#warnings[@]})); then
      out+=$'\e[K\n'
      # The last four.
      i=$((${#warnings[@]} > 4 ? ${#warnings[@]} - 4 : 0))
      for label in "${warnings[@]:i}"; do line "$c_warn" "$label"; done
    fi
    if [[ ${1:-} == ok ]]; then
      # The last one under the steps all ticked.
      UI_AT='*'
      head=$(COLUMNS=$cols LINES=$hrows UI_NOTES='' ui_header 2>&1)
    elif [[ ${1:-} == fail ]]; then
      # Under the name alone, to leave room for the error and the log's
      # last lines.
      head=$(COLUMNS=$cols LINES=33 UI_NOTES='' ui_header 2>&1)
      printf '\e[2J' >&2
    fi
    printf '\e[H%s\n\n%s\e[J' "$head" "$out" >&2
    last=$now
  }

  while :; do
    if IFS=$'\t' read -r -t 1 kind a b c; then
      case $kind in
        step)
          i=$(row_of "$a")
          if ((i >= 0 && i != at)); then
            at=$i row_started=${EPOCHREALTIME//[!0-9]/} detail='' part='' n=0 total=0 item=''
          fi
          ;;
        took)
          i=$(row_of "$a")
          ((i < 0)) || secs[i]=$((${secs[i]:-0} + ${b%.*} * 10 + ${b#*.}))
          ;;
        say | info) detail=$a part='' n=0 total=0 item='' ;;
        warn) warnings+=("$a") ;;
        part) part=$a n=0 total=${b:-0} item='' ;;
        count) n=$a total=$b item=$c ;;
        end)
          [[ $a != ok ]] || at=${#PROGRESS_ROWS[@]}
          frame "$a"
          printf '\e[?25h' >&2
          exit 0
          ;;
      esac
      now=${EPOCHREALTIME//[!0-9]/}
      ((now - last < 100000)) && continue
    fi
    frame
  done
}

# The view, when there is a screen to draw it on; otherwise the Install
# step's header and its title, and the install's lines under it.
progress_start() {
  local fifo title
  if [[ ! -t 2 ]]; then
    screen Install
    for title in "${PROGRESS_TITLE[@]}"; do info "$title"; done
    return 0
  fi
  UI_AT=Install
  fifo=$(mktemp -u /tmp/nova-progress.XXXXXX)
  mkfifo -m 600 "$fifo"
  # Read and write: the install never blocks opening it, and never dies of
  # a closed pipe. The view stops at the end event, not at the pipe's end,
  # since a program the install starts may keep it open.
  exec 7<>"$fifo"
  rm -f -- "$fifo"
  progress_view <&7 &
  PROGRESS_PID=$!
  exec 8>&2 2>>"$LOG"
  PROGRESS=1
}

# The view's last frame, and the screen back for the lines after it.
progress_end() { # ok|fail
  ((PROGRESS && !BASH_SUBSHELL)) || return 0
  local i
  progress_event end "$1"
  # Gone already, and the screen given back (progress_event).
  ((PROGRESS)) || return 0
  PROGRESS=0
  for ((i = 0; i < 50; i++)); do
    kill -0 "$PROGRESS_PID" 2>/dev/null || break
    sleep 0.1
  done
  kill "$PROGRESS_PID" 2>/dev/null || true
  wait "$PROGRESS_PID" 2>/dev/null || true
  exec 2>&8 8>&- 7>&-
  printf '\e[?25h' >&2
}

# Under a failed install's view: the log's last lines, where what went wrong
# usually is, and where the whole log is.
progress_tail() {
  local width
  width=$(($(ui_frame_width) - 2))
  echo >&2
  ui_note "The log's last lines:"
  ui_note "$(grep -v "^$STEP_LINE" "$LOG" | tail -n 12 | tr -d '\000-\010\013-\037' | cut -c "1-$width" | sed 's/^/  /')"
  echo >&2
  ui_note "The whole log: $LOG"
}

partition_and_format() {
  local disk=$1 esp root
  say "Partitioning $disk"
  logged wipefs -af "$disk"
  logged sfdisk --wipe always --wipe-partitions always "$disk" <<EOF
label: gpt
size=${ESP_MIB}MiB, type=uefi, name="NOVA-ESP"
type=linux, name="nova"
EOF
  logged udevadm settle
  esp=$(partition_path "$disk" 1)
  root=$(partition_path "$disk" 2)
  [[ -b $esp && -b $root ]] || die "the new partitions did not appear ($esp, $root)"
  logged mkfs.fat -F 32 -n NOVA-ESP "$esp"
  if [[ $ENCRYPT == yes ]]; then
    say "Encrypting the btrfs partition"
    # The passphrase on stdin, never on a command line. Discards pass
    # through (the flag kept in the header), so fstrim still reaches the SSD.
    printf '%s' "$DISK_PASSPHRASE" | logged cryptsetup luksFormat --type luks2 --batch-mode --label nova-crypt --key-file - "$root"
    printf '%s' "$DISK_PASSPHRASE" | logged cryptsetup open --allow-discards --persistent --key-file - "$root" "$CRYPT_NAME"
  fi
  logged mkfs.btrfs -f -L nova "$(root_device "$disk")"
}

# Where the btrfs filesystem is: the partition, or the container opened on it.
root_device() { # disk
  if [[ $ENCRYPT == yes ]]; then
    echo "/dev/mapper/$CRYPT_NAME"
  else
    partition_path "$1" 2
  fi
}

create_subvolumes_and_mount() {
  local disk=$1 swap=$2 esp root entry name mountpoint
  esp=$(partition_path "$disk" 1)
  root=$(root_device "$disk")
  say "Creating the filesystem layout"
  logged mount "$root" "$TARGET"
  for entry in "${SUBVOLUMES[@]}"; do
    logged btrfs subvolume create "$TARGET/${entry%%:*}"
  done
  logged umount "$TARGET"

  logged mount -o "$BTRFS_OPTS,subvol=@" "$root" "$TARGET"
  for entry in "${SUBVOLUMES[@]:1}"; do
    name=${entry%%:*}
    mountpoint=${entry#*:}
    logged mkdir -p "$TARGET$mountpoint"
    if [[ $name == @swap ]]; then
      logged mount -o "noatime,subvol=$name" "$root" "$TARGET$mountpoint"
    else
      logged mount -o "$BTRFS_OPTS,subvol=$name" "$root" "$TARGET$mountpoint"
    fi
  done
  logged chmod 750 "$TARGET/.snapshots"
  logged mkdir -p "$TARGET/boot"
  logged mount -o fmask=0077,dmask=0077 "$esp" "$TARGET/boot"

  # None for a portable install (swap 0), which never hibernates; its
  # subvolume stays, for a swap file made by hand later.
  ((swap > 0)) || return 0
  info "A ${swap} GiB swap file, for hibernation"
  logged btrfs filesystem mkswapfile --size "${swap}g" --uuid clear "$TARGET/swap/swapfile"
  logged swapon "$TARGET/swap/swapfile"
}

# Online, every package comes from the release's Arch snapshot and its own
# repository. Both are asked for their lists, and the whole set looked up in
# them, before the disk is erased: an outage of either, or a package neither
# has, stops the install with the disk as it was. The packages themselves are
# fetched after, onto the new disk (there is nowhere else with room for
# them), so a network that goes then leaves the install to be run again.
# Nothing is installed from this, so signatures are left to pacstrap.
packages_available() { # kernel profile arch_date nova_repo [package...]
  local kernel=$1 profile=$2 arch_date=$3 nova_repo=$4 dir status=0
  local -a packages
  offline_repo_ready && return 0
  dir=$(mktemp -d /tmp/nova-preflight.XXXXXX)
  mkdir "$dir/db"
  pacstrap_conf "$arch_date" "$nova_repo" | sed 's/^SigLevel = .*/SigLevel = Never/' >"$dir/pacman.conf"
  mapfile -t packages < <(package_set "$kernel" "$profile" "${@:5}")
  logged pacman --config "$dir/pacman.conf" --dbpath "$dir/db" --logfile /dev/null -Sy &&
    logged pacman --config "$dir/pacman.conf" --dbpath "$dir/db" --logfile /dev/null -Sp --print-format %n "${packages[@]}" ||
    status=$?
  rm -rf -- "$dir"
  return "$status"
}

# Hooks of the packages' that pacstrap leaves to install_bootloader, which
# does what they do once, with everything in place. pacstrap runs pacman from
# the live system, which takes the new system's hooks under /usr but not its
# /etc/pacman.d/hooks, where limine-entry-tool replaces mkinitcpio's: so in
# pacstrap mkinitcpio's own runs, and builds a plain initramfs for each
# kernel, and copies each vmlinuz to /boot, that nothing boots and nothing
# updates again. Limine boots the UKIs that limine-update builds in
# install_bootloader, from /usr/lib/modules, and the installed system's
# kernel updates run limine-entry-tool's. Limine's own deploys Limine and
# adds its firmware entry, which limine-install does again there.
PACSTRAP_MASKED=(90-mkinitcpio-install.hook 80-limine-efi-deploy.hook)

install_packages() { # kernel profile arch_date nova_repo [package...]
  local kernel=$1 profile=$2 arch_date=$3 nova_repo=$4 conf hooks hook
  conf=$(mktemp /tmp/nova-pacstrap.XXXXXX.conf)
  hooks=$(mktemp -d /tmp/nova-pacstrap-hooks.XXXXXX)
  for hook in "${PACSTRAP_MASKED[@]}"; do ln -s /dev/null "$hooks/$hook"; done
  pacstrap_conf "$arch_date" "$nova_repo" "$hooks" >"$conf"
  say "Installing packages (this is the long part)"
  mapfile -t packages < <(package_set "$kernel" "$profile" "${@:5}")
  info "${#packages[@]} packages, from $(offline_repo_ready && echo "the stick" || echo "the internet")"
  # pacstrap's lines go through pacstrap_feed: to the log, and as parts and
  # counts to the progress view, or without one to the terminal. The kernels'
  # boot check is skipped: Limine is not installed yet, and install_bootloader
  # checks once it is. So are snap-pac's snapshots: snapper has no
  # configuration until configure_snapper, and the first snapshot is the
  # installed system's.
  local status=0
  printf '+ pacstrap -C %s -K %s %s\n' "$conf" "$TARGET" "${packages[*]}" >>"$LOG"
  NOVA_BOOT_CHECK=skip SNAP_PAC_SKIP=y pacstrap -C "$conf" -K "$TARGET" "${packages[@]}" 2>&1 | pacstrap_feed ||
    status=$?
  rm -rf -- "$conf" "$hooks"
  ((status == 0)) || die "pacstrap failed; the log is in $LOG"
}

# pacstrap's output, line by line: into the log, onto the terminal (or, under
# the progress view, its parts and counts into the view), and the time of
# each of its parts into the log as steps of their own, from the lines pacman
# starts each with (it flushes its output after every one): the keyring and
# the package lists, fetching the packages (from the stick, or the internet),
# checking their signatures, unpacking them, and the hooks. Its output is
# not a terminal, so pacman draws no bars: it says "Packages (N)" once, then
# a line as each package downloads, as each is unpacked ("installing mesa..."),
# and as each hook runs ("( 5/36) Updating linux initcpios...").
pacstrap_feed() {
  local line part='Packages: keyring and lists' started next n=0 total=0 fetching=Downloading
  started=$(now_us)
  offline_repo_ready && fetching="Reading from the stick"
  while IFS= read -r line; do
    printf '%s\n' "$line" >>"$LOG"
    ((PROGRESS)) || printf '%s\n' "$line" >&2
    next=''
    case $line in
      ':: Retrieving packages...'*) next='Packages: fetching' ;;
      'checking keyring...'*) next='Packages: checking signatures' ;;
      ':: Processing package changes...'*) next='Packages: unpacking' ;;
      ':: Running post-transaction hooks...'*) next='Packages: hooks' ;;
    esac
    if [[ -n $next && $next != "$part" ]]; then
      log_step "$part" "$started"
      part=$next started=$(now_us) n=0
      case $part in
        *fetching) progress_event part "$fetching" "$total" ;;
        *signatures) progress_event part "Checking signatures" ;;
        *unpacking) progress_event part Installing "$total" ;;
        *hooks) progress_event part "Running hooks" ;;
      esac
      continue
    fi
    ((PROGRESS)) || continue
    case $part:$line in
      *':Packages ('[0-9]*')'*)
        total=${line#Packages (}
        total=${total%%)*}
        ;;
      *fetching:*' downloading...')
        ((n < total)) && n=$((n + 1))
        line=${line% downloading...}
        progress_event count "$n" "$total" "${line# }"
        ;;
      *unpacking:'installing '*)
        n=$((n + 1))
        line=${line#installing }
        progress_event count "$n" "$total" "${line%...}"
        ;;
      *hooks:'('*'/'*') '*)
        if [[ $line =~ ^\(\ *([0-9]+)/([0-9]+)\)\ (.*)$ ]]; then
          progress_event count "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]%...}"
        fi
        ;;
    esac
  done
  log_step "$part" "$started"
}

write_system_config() {
  local hostname=$1 timezone=$2 keymap=$3 arch_date=$4 nova_repo=$5 tag=$6
  say "Configuring the system"
  genfstab -U "$TARGET" | strip_subvolid >"$TARGET/etc/fstab"
  # genfstab lists the swap file it saw active; make sure it is there.
  if [[ -e $TARGET/swap/swapfile ]] && ! grep -q '/swap/swapfile' "$TARGET/etc/fstab"; then
    echo '/swap/swapfile none swap defaults 0 0' >>"$TARGET/etc/fstab"
  fi

  write_names "$hostname" "$timezone"
  sed -i 's/^#\(en_US.UTF-8 UTF-8\)/\1/' "$TARGET/etc/locale.gen"
  in_target locale-gen
  echo 'LANG=en_US.UTF-8' >"$TARGET/etc/locale.conf"
  write_keyboard "$keymap"

  install -Dm644 "$SHARE/pacman.conf" "$TARGET/etc/pacman.conf"
  write_release_pins "$arch_date" "$nova_repo" "$tag"
}

# The same two files nova update rewrites for every release, so the installed
# system starts on the release it was installed from.
write_release_pins() {
  local arch_date=$1 nova_repo=$2 tag=$3
  {
    echo '# Managed by nova update; the next update rewrites this file.'
    printf '# nova-release: %s\n# arch-date: %s\n' "$tag" "$arch_date"
    # shellcheck disable=SC2016 # $repo and $arch are pacman's to expand
    printf 'Server = https://archive.archlinux.org/repos/%s/$repo/os/$arch\n' "$arch_date"
  } >"$TARGET/etc/pacman.d/nova-mirrorlist"
  {
    echo '# Managed by nova update; the next update rewrites this file.'
    printf '# nova-release: %s\nServer = %s\n' "$tag" "$nova_repo"
  } >"$TARGET/etc/pacman.d/nova-repo"
}

# ------------------------------------------------------------------ fingerprint

# Whether the live system's fprintd has a reader. It starts on this first call,
# and sees only the readers libfprint can drive, which are the ones worth
# setting up.
fingerprint_reader() {
  local devices
  devices=$(busctl --system call net.reactivated.Fprint /net/reactivated/Fprint/Manager \
    net.reactivated.Fprint.Manager GetDevices 2>/dev/null) || return 1
  [[ $devices == "ao "[1-9]* ]]
}

# One finger for the new account, enrolled here on the stick before anything
# is installed; copy_fingerprints moves it into the new system. fprintd files
# prints under a user name, so a stand-in for the account exists here too.
enroll_fingerprint() { # user
  local user=$1 line
  id -u "$user" >/dev/null 2>&1 || useradd -M -s /usr/bin/nologin "$user" >/dev/null 2>&1 || return 1
  info "Touch the reader with your right index finger, lift it, and again, until it says done."
  { fprintd-enroll -f right-index-finger "$user" 2>&1 || true; } | while IFS= read -r line; do
    case $line in
      *enroll-stage-passed*) info "Got it. Again." ;;
      *enroll-retry-scan* | *enroll-swipe-too-short* | *enroll-finger-not-centered* | *enroll-remove-and-retry*)
        info "That did not read. Lift your finger and touch again."
        ;;
      *enroll-completed*) info "Done." ;;
    esac
  done
  [[ -n $(find "$FPRINT_DIR/$user" -type f 2>/dev/null) ]]
}

copy_fingerprints() { # user
  [[ -d $FPRINT_DIR/$1 ]] || return 0
  install -d -m 700 "$TARGET/var/lib/fprint"
  cp -a "$FPRINT_DIR/$1" "$TARGET/var/lib/fprint/"
}

# --------------------------------------------------------------- answers file

answer_or() { # key default: the answer, or the default when there is none
  local value=''
  [[ -z $ANSWERS ]] || value=$(answer "$1")
  echo "${value:-$2}"
}

# The answers file's after= script, run as root in the new system once the
# install is done; a relative path is next to the answers file.
run_after() {
  local script
  script=$(answer_or after '')
  [[ -n $script ]] || return 0
  [[ $script == /* ]] || script=${ANSWERS%/*}/$script
  [[ -r $script ]] || die "the answers file's after= script is not there: $script"
  say "Running $script"
  install -m 700 "$script" "$TARGET/root/nova-after"
  in_target /root/nova-after || die "$script failed; the log is in $LOG"
  rm -f "$TARGET/root/nova-after"
}

configure_snapper() {
  # What `snapper create-config` writes, without the .snapshots subvolume it
  # would create: @snapshots is already mounted there, outside the root
  # subvolume, so a rollback does not take the snapshots with it.
  install -Dm644 "$TARGET/usr/share/snapper/config-templates/nova" "$TARGET/etc/snapper/configs/root"
  echo 'SNAPPER_CONFIGS="root"' >"$TARGET/etc/conf.d/snapper"
}

# Written before pacstrap, so that everything the boot loader step reads is
# in place however the packages' hooks go: the root and resume arguments,
# the keyboard layout an encrypted disk is opened with, the Limine header.
prepare_boot_config() {
  local disk=$1 kernel=$2 root partuuid offset='' luks cmdline
  root=$(partition_path "$disk" 2)
  if ((!PORTABLE)); then
    offset=$(btrfs inspect-internal map-swapfile -r "$TARGET/swap/swapfile")
    [[ $offset =~ ^[0-9]+$ ]] || die "could not find the swap file's offset"
  fi
  if [[ $ENCRYPT == yes ]]; then
    luks=$(cryptsetup luksUUID "$root")
    [[ -n $luks ]] || die "could not read the LUKS UUID of $root"
    cmdline=$(install_cmdline "/dev/mapper/$BOOT_CRYPT_NAME" "$offset" "$luks")
    encrypt_mkinitcpio_conf | install -Dm644 /dev/stdin "$TARGET/etc/mkinitcpio.conf.d/20-nova-encrypt.conf"
    # The initramfs opens the disk on the console, in the keyboard layout
    # picked: it has to be there before any is built.
    write_keyboard "$KEYMAP"
  else
    partuuid=$(blkid -s PARTUUID -o value "$root")
    [[ -n $partuuid ]] || die "could not read the PARTUUID of $root"
    cmdline=$(install_cmdline "PARTUUID=$partuuid" "$offset")
  fi
  mkdir -p "$TARGET/etc/limine-entry-tool.d"
  limine_install_conf "$cmdline" "$kernel" >"$TARGET/etc/limine-entry-tool.d/90-nova-install.conf"
  ((!PORTABLE)) || write_portable_config
  install -Dm644 "$SHARE/limine.conf" "$TARGET/boot/limine.conf"
}

install_bootloader() {
  say "Installing the boot loader"
  # --fallback also puts Limine at EFI/BOOT/BOOTX64.EFI, so the disk boots even
  # if the firmware forgets its boot entries. A portable stick starts from
  # there alone: its SKIP_UEFI=yes (limine_install_conf) already keeps this
  # computer's firmware out of it, and --no-efi-register says so here too.
  if ((PORTABLE)); then
    in_target limine-install --fallback --no-efi-register
  else
    in_target limine-install --fallback
  fi
  in_target limine-update
  # The same check nova update makes: every kernel has an entry, and every file
  # an entry loads is on the ESP.
  in_target /usr/lib/nova/bin/nova-boot-check post || die "the boot entries did not check out; the log is in $LOG"
}

enable_services() {
  say "Enabling services"
  iwd_to_networkmanager "$TARGET/etc/NetworkManager/system-connections"
  in_target systemctl enable greetd.service NetworkManager.service bluetooth.service \
    systemd-resolved.service systemd-timesyncd.service systemd-oomd.service \
    power-profiles-daemon.service fstrim.timer snapper-cleanup.timer limine-snapper-sync.service \
    avahi-daemon.service cups.socket btrfs-scrub@-.timer
  # A cellular modem's ModemManager, which hardware_packages added: Arch
  # enables nothing a package brings, and mobile data cannot work without it.
  in_target /usr/lib/nova/bin/nova-modemmanager || warn "Could not turn on ModemManager; mobile data needs: sudo systemctl enable --now ModemManager.service"
}

finish() {
  # arch-chroot binds the live system's resolv.conf over the target's while it
  # runs, so the link to systemd-resolved is made from outside.
  ln -sf ../run/systemd/resolve/stub-resolv.conf "$TARGET/etc/resolv.conf"
  [[ ! -e $TARGET/swap/swapfile ]] || logged swapoff "$TARGET/swap/swapfile"
  sync
  # The new system keeps the log, with the table of the steps' times so far:
  # all but this last one, which only unmounts once the log is written.
  step_table >>"$LOG"
  install -Dm600 "$LOG" "$TARGET/var/log/nova-install.log"
  sync
  logged umount -R "$TARGET"
}

# ------------------------------------------------- what nova usb carried
#
# A stick made by nova usb with things of yours on it has a second partition,
# NOVA-DATA: LUKS2, then btrfs, then carry/ with one tar.zst per item, their
# SHA-256 sums and manifest.json. It is opened read-only at $CARRY before the
# questions, so the account can default to the old one's name, and the install
# puts the SSH keys and the files back once the account exists.

carry_ready() { [[ -r $CARRY/carry/manifest.json ]]; }

# The stick's NOVA-DATA partition: on the disk the live system booted from
# when that can be told, anywhere otherwise.
carry_partition() {
  local disk
  disk=$(boot_disk)
  if [[ -n $disk ]]; then
    lsblk -nrpo PATH,PARTLABEL -- "$disk" 2>/dev/null
  else
    lsblk -nrpo PATH,PARTLABEL 2>/dev/null
  fi | awk '$2 == "NOVA-DATA" { print $1; exit }'
}

carry_items() { # -> id, kind, file and label of each item, tab-separated
  jq -r '.items[] | [.id, .kind, .file, (.label // .id)] | @tsv' "$CARRY/carry/manifest.json"
}

carry_value() { # jq path
  jq -r "$1 // empty" "$CARRY/carry/manifest.json"
}

# This computer, hashed the way nova usb hashes the one it ran on.
machine_hash() {
  local id
  id=$(cat "$DMI/product_uuid" "$DMI/product_serial" 2>/dev/null) || true
  [[ -n $id ]] || return 0
  printf '%s' "$id" | sha256sum | awk '{ print $1 }'
}

# Asks for the passphrase until it opens (or Enter skips), mounts the
# partition and checks every archive against its sum. All or nothing: a stick
# that reads back wrong carries nothing over.
carry_unlock() {
  carry_ready && return 0
  local part pass tries
  part=$(carry_partition)
  [[ -n $part ]] || return 1
  if [[ -n $ANSWERS ]]; then
    say "Your things are on this stick, encrypted"
  else
    screen Network "Your things"
    ui_note "What nova usb brought from your other computer is on this stick, encrypted."
    echo >&2
  fi
  for ((tries = 0; tries < 5; tries++)); do
    if [[ -n $ANSWERS ]]; then
      pass=$(answer passphrase)
      tries=4
    else
      # Esc, or Enter on an empty field, installs without them.
      ui_ask ui_secret "Its passphrase" "Enter to install without them" || REPLY=''
      pass=$REPLY
    fi
    if [[ -z $pass ]]; then
      : >"$CARRY_DECLINED"
      return 1
    fi
    if printf '%s' "$pass" | cryptsetup open --readonly --key-file - "$part" "$CARRY_MAPPER" 2>/dev/null; then
      mkdir -p "$CARRY"
      mount -o ro "/dev/mapper/$CARRY_MAPPER" "$CARRY" || {
        cryptsetup close "$CARRY_MAPPER"
        warn "The partition opened but would not mount; installing without your things."
        return 1
      }
      if ! (cd "$CARRY/carry" && sha256sum --quiet -c SHA256SUMS >&2); then
        warn "Some of it does not read back as it was written (above); installing without your things."
        umount "$CARRY"
        cryptsetup close "$CARRY_MAPPER"
        return 1
      fi
      info "$(carry_items | wc -l) things, from $(carry_value .source.host)"
      return 0
    fi
    [[ -z $ANSWERS ]] || die "the answers file's passphrase does not open what this stick carries; nothing was changed."
    warn "That is not the passphrase."
  done
  return 1
}

unpack() { # archive directory [tar options]
  local archive=$1 dir=$2
  shift 2
  mkdir -p "$dir"
  printf '+ unpack %s into %s\n' "$archive" "$dir" >>"$LOG"
  zstd -dc "$CARRY/carry/$archive" 2>>"$LOG" | tar -x -C "$dir" "$@" >>"$LOG" 2>&1
}

target_ids() { # user -> uid:gid in the new system
  awk -F: -v u="$1" '$1 == u { print $3 ":" $4 }' "$TARGET/etc/passwd"
}

# What this installer puts back: the SSH keys and the files picked. A stick
# from an older nova usb may carry more (a browser, Wi-Fi networks, a package
# list); that is left on the stick.
restorable() { # id kind
  [[ $1:$2 == ssh:home || $2 == folders || $2 == projects ]]
}

# The labels of what restore_carry puts back, one a line.
restorable_labels() {
  local id kind file label
  while IFS=$'\t' read -r id kind file label; do
    ! restorable "$id" "$kind" || echo "$label"
  done < <(carry_items)
}

# Puts each carried item back into the new home, as it was in the old one,
# and hands it all to the account.
restore_carry() { # user
  local user=$1 home=$TARGET/home/$1 id kind file label
  carry_ready || return 0
  say "Putting your things back"
  while IFS=$'\t' read -r id kind file label; do
    if ! restorable "$id" "$kind"; then
      info "$label: left out, this installer brings back only SSH keys and files"
      continue
    fi
    info "$label"
    unpack "$file" "$home" || warn "$label did not unpack completely; the log is in $LOG"
  done < <(carry_items)
  chown -R "$(target_ids "$user")" "$home"
}

usage() {
  sed -n '3,/^$/s/^# \{0,1\}//p' "$0"
}

# The ERR trap once the disk is being written: a step that fails ends the
# install, and this says which instead of stopping without a word. Subshells
# inherit the trap (set -E), so only the outermost shell speaks.
stopped() { # line command
  ((BASH_SUBSHELL)) && return
  local shown=$PROGRESS
  [[ -z $STEP ]] || printf '%s %s (stopped): %s s\n' "$STEP_LINE" "$STEP" "$(seconds_since "$STEP_STARTED")" >>"$LOG"
  progress_end fail
  echo >&2
  ui_error "nova-install: the install stopped at line $1 ($2)${STEP:+, in the step $STEP}. The log is in $LOG."
  ((!shown)) || progress_tail
}

# What is left to undo whenever this ends: the progress view, when it ended
# some other way than the install's own (Ctrl+C), files to remove (CLEANUP,
# from installer/setup.bash) and, on the console, its colours to give back.
leave() {
  if ((PROGRESS)); then
    progress_end fail
    echo >&2
    ui_error "nova-install: the install stopped. The log is in $LOG."
  fi
  local file
  for file in "${CLEANUP[@]}"; do
    umount -- "$file" 2>/dev/null || true # the apps' sudo rule is mounted over its file
    rm -f -- "$file"
  done
  ui_console_end
}

# The screens on the console are in Nova's colours and a font for the screen
# (ui_console_begin), unless nova-install-start has set them already.
console_screens() {
  ui_console_begin
  trap leave EXIT
}

main() {
  case ${1:-} in
    -h | --help)
      usage
      return 0
      ;;
    --list-packages)
      every_package
      return 0
      ;;
    --unlock)
      ((EUID == 0)) || die "run me as root."
      console_screens
      rm -f -- "$CARRY_DECLINED"
      carry_unlock || true
      return 0
      ;;
    --keymap)
      local status=0
      console_screens
      choose_keymap "${2:-us}" || status=$?
      if ((status == 130)); then
        echo >&2
        ui_note "$UI_STOPPED"
        exit 130
      fi
      ((status == 0)) || echo "${2:-us}"
      return 0
      ;;
    --answers)
      ANSWERS=$(realpath -e -- "${2:?--answers needs a file}") || die "no answers file at $2"
      [[ $(answer portable) != yes ]] || portable_mode
      ;;
    --portable)
      portable_mode
      PORTABLE_DISK=${2:-}
      ;;
    --portable-disks)
      portable_mode
      candidate_disks | cut -f1
      return 0
      ;;
    "") ;;
    *) die "unknown argument: $1 (try --help)" ;;
  esac
  ((EUID == 0)) || die "run me as root."
  trap leave EXIT
  [[ -n $ANSWERS ]] || console_screens
  computer_ready
  [[ -r $RELEASE_FILE ]] || die "no release file at $RELEASE_FILE"
  # A try after a stopped one keeps the stopped one's log beside it.
  [[ ! -s $LOG ]] || mv -f -- "$LOG" "$LOG.1"
  : >"$LOG"

  local tag arch_date nova_repo
  tag=v$(release_value version)
  arch_date=$(release_value arch_date)
  nova_repo=$(release_value nova_repo)
  [[ $tag =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$ ]] || die "the release file has no valid version"
  [[ $arch_date =~ ^[0-9]{4}/[0-9]{2}/[0-9]{2}$ ]] || die "the release file has no valid arch_date"
  [[ $nova_repo =~ ^https://[A-Za-z0-9._~:/%+-]+$ ]] || die "the release file has no valid nova_repo"
  if ! offline_repo_ready && ! curl -fsI --max-time 10 -o /dev/null https://archive.archlinux.org/; then
    die "this stick has no offline packages and there is no internet connection. Connect with: iwctl"
  fi

  # Things carried on the stick: opened now (nova-install-start usually already
  # has), put back once the account exists.
  carry_ready || [[ -e $CARRY_DECLINED ]] || carry_unlock || true

  local kernel profile
  kernel=$(main_kernel)
  profile=$(hardware_profile)
  # Only a reader fprintd can drive gets fprintd in the new system, and the
  # offer to enroll a finger; a print enrolled on one computer's reader is no
  # use on the next one's, so a portable install offers none.
  local extra=() offer_fingerprint=no
  if ((!PORTABLE)) && fingerprint_reader; then
    extra+=(fprintd)
    offer_fingerprint=yes
  fi
  release_target

  # nova usb has picked the disk already: it has to be one this would offer.
  if [[ -n $PORTABLE_DISK && -z $ANSWERS ]]; then
    DISK_LINE=$(candidate_disks | awk -F'\t' -v d="$PORTABLE_DISK" '$1 == d')
    [[ -n $DISK_LINE ]] || die "$PORTABLE_DISK is not a USB disk of 32 GB or more; nothing was changed."
    ! disk_in_use "$PORTABLE_DISK" || die "$PORTABLE_DISK is in use (mounted, swap or LVM); nothing was changed."
  fi

  if [[ -n $ANSWERS ]]; then
    answers_from_file
    say "Nova ${tag#v}"
    if ((PORTABLE)); then
      info "Portable, onto a USB disk"
    else
      info "Computer: $(computer_model unknown)${profile:+ (Nova knows this one)}"
    fi
    say "Ready to install"
    summary_lines | sed 's/^/  /'
    [[ $(answer erase) == yes ]] || die "the answers file does not say erase=yes; nothing was changed."
    ((PORTABLE)) || [[ $kernel == linux-nova ]] || info "This CPU predates x86-64-v3, so Nova uses Arch's standard kernel."
  else
    questions_on_screen "$offer_fingerprint"
    if ((PORTABLE)); then
      PROGRESS_TITLE=("Nova ${tag#v} onto ${DISK_LINE%%$'\t'*}, to carry around")
    else
      PROGRESS_TITLE=("Nova ${tag#v} on $(computer_model "this computer")${profile:+, which Nova knows}")
    fi
    ((PORTABLE)) || [[ $kernel == linux-nova ]] || PROGRESS_TITLE+=("This CPU predates x86-64-v3, so Nova uses Arch's standard kernel.")
    progress_rows
    progress_start
  fi
  loadkeys "$KEYMAP" >/dev/null 2>&1 || true

  local disk swap=0
  disk=${DISK_LINE%%$'\t'*}
  ((PORTABLE)) || swap=$(swap_gib "$(cut -f2 <<<"$DISK_LINE")")
  # Minutes may have gone by since the disk was picked. The same disk, by size,
  # model and serial, has to be there still, and free, before it is erased.
  grep -qxF -- "$DISK_LINE" <<<"$(candidate_disks)" ||
    die "$disk is no longer the disk that was picked (unplugged or swapped?); nothing was changed."
  ! disk_in_use "$disk" || die "$disk is in use by the live system now; nothing was changed."
  if ! offline_repo_ready; then
    info "Checking that every package is there to download"
    step "Checking the packages" packages_available "$kernel" "$profile" "$arch_date" "$nova_repo" "${extra[@]}" ||
      die "the Arch snapshot of $arch_date or Nova's repository did not have every package; nothing was changed. Try again later; the log is in $LOG"
  fi
  set -E
  trap 'stopped "$LINENO" "$BASH_COMMAND"' ERR
  step "Partitioning and formatting" partition_and_format "$disk"
  unset DISK_PASSPHRASE
  step "Subvolumes and swap file" create_subvolumes_and_mount "$disk" "$swap"
  step "Boot configuration" prepare_boot_config "$disk" "$kernel"
  step "Packages, in all" install_packages "$kernel" "$profile" "$arch_date" "$nova_repo" "${extra[@]}"
  step "System configuration" write_system_config "$COMPUTER" "$TIMEZONE" "$KEYMAP" "$arch_date" "$nova_repo" "$tag"
  step "Snapshots" configure_snapper
  step "Account" create_user "$ACCOUNT" "$FULLNAME" "$PASSWORD"
  unset PASSWORD
  step "Fingerprint" copy_fingerprints "$ACCOUNT"
  step "Your things" restore_carry "$ACCOUNT"
  # The services before the boot loader, and the apps after both: the apps
  # are the long part with the most to go wrong (a network, the AUR), and
  # the system that starts when they are cut short is whole without them.
  step "Services" enable_services
  step "Boot loader" install_bootloader
  [[ $(answer_or apps yes) == no ]] || step "Apps" install_apps "$ACCOUNT"
  step "After script" run_after
  step "Finishing" finish
  progress_end ok

  if ((PORTABLE)); then
    echo >&2
    ui_good "Nova is on the stick."
    info "Start any PC from it: plug it in, and pick it in the PC's boot menu (F12 on"
    info "most, F9, F11 or Esc on some). Secure Boot has to be off, as for an install."
    info "$BITLOCKER_NOTE"
    ! secure_boot_on || info "This PC has Secure Boot on: it starts the stick once that is off."
    info "The install log is kept on it, at /var/log/nova-install.log."
  else
    echo >&2
    ui_good "Nova is installed."
    info "Take the stick out and restart: reboot"
    info "The install log is kept at /var/log/nova-install.log."
  fi
  # With nobody there (tests/install/run), the times go onto its console,
  # which the test keeps.
  if [[ -n $ANSWERS ]]; then
    echo >&2
    step_table >&2
  fi
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
