#!/bin/bash
#
# nova-install: install Nova from the USB stick onto this computer's disk.
#
# Runs as root in the live system. Every question comes first, then one summary,
# and only after "erase" is typed does anything touch a disk. The whole disk is
# used: a 2 GiB EFI system partition and one btrfs partition holding the
# subvolumes that snapshots and rollback expect (@ @home @log @pkg @snapshots
# @swap).
#
# Packages come from the offline repository on the stick when there is one, and
# otherwise from the pinned Arch snapshot and [nova] repository named in the
# release file. Either way the installed system ends up pointed at the release
# it was installed from, which is what `nova update` moves forward.
#
#   nova-install                  the interactive install
#   nova-install --answers FILE   the same install with no questions, answered
#                                 by FILE in key=value lines: keymap, disk,
#                                 fullname, user, password, hostname, timezone,
#                                 passphrase (for things carried), erase=yes to
#                                 go ahead, and optionally apps=no and
#                                 after=<script>, run in the new system at the
#                                 end. tests/install/run uses it.
#   nova-install --unlock         open the things carried on the stick (nova usb),
#                                 and join their Wi-Fi networks
#   nova-install --list-packages  every package an install on any computer can
#                                 need: what nova usb puts on a stick
#   nova-install --help           this text
#
# NOVA_* variables override paths for testing; the functions are sourceable
# (tests/unit/installer/install.bats) and `main` runs only when executed.

set -euo pipefail

SHARE=${NOVA_INSTALLER_SHARE:-/usr/share/nova-installer}
TARGET=${NOVA_TARGET:-/mnt}
STICK=${NOVA_STICK:-/run/archiso/bootmnt}
OFFLINE_REPO=${NOVA_OFFLINE_REPO:-$STICK/nova/repo}
RELEASE_FILE=${NOVA_RELEASE_FILE:-$SHARE/release.toml}
CPUINFO=${NOVA_CPUINFO:-/proc/cpuinfo}
MEMINFO=${NOVA_MEMINFO:-/proc/meminfo}
PCI_DEVICES=${NOVA_PCI_DEVICES_PATH:-/sys/bus/pci/devices}
LOG=${NOVA_INSTALL_LOG:-/var/log/nova-install.log}
CARRY=${NOVA_CARRY:-/run/nova-carry}
DMI=${NOVA_DMI_PATH:-/sys/class/dmi/id}
IWD_DIR=${NOVA_IWD_DIR:-/var/lib/iwd}
FPRINT_DIR=${NOVA_FPRINT_DIR:-/var/lib/fprint}
KBD_MODEL_MAP=${NOVA_KBD_MODEL_MAP:-/usr/share/systemd/kbd-model-map}
# The answers file, for an install with no questions (--answers).
ANSWERS=''
CARRY_MAPPER=nova-carry

ESP_MIB=2048
MIN_DISK_BYTES=$((64 * 1024 * 1024 * 1024))
BTRFS_OPTS=noatime,compress=zstd:1
SUBVOLUMES=("@:/" "@home:/home" "@log:/var/log" "@pkg:/var/cache/pacman/pkg" "@snapshots:/.snapshots" "@swap:/swap")

# What each kind of display controller needs beyond mesa, which has the AMD
# video driver built in. hardware_packages picks this machine's; every_package
# lists them all.
GPU_INTEL=(intel-media-driver vulkan-intel)
GPU_AMD=(vulkan-radeon)

say() { printf '\n\e[1m%s\e[0m\n' "$*"; }
info() { printf '  %s\n' "$*"; }
warn() { printf '  \e[33m%s\e[0m\n' "$*" >&2; }
die() {
  printf '\n\e[31mnova-install: %s\e[0m\n' "$*" >&2
  exit 1
}

# ------------------------------------------------------------------- the disk

# The disk the live system booted from, so it is never offered. Empty when it
# cannot be told (booted with copytoram, say); removable disks are left out
# anyway.
boot_disk() {
  local src parent
  src=$(findmnt -no SOURCE -- "$STICK" 2>/dev/null) || return 0
  [[ -b $src ]] || return 0
  parent=$(lsblk -no PKNAME -- "$src" 2>/dev/null | awk 'NR == 1')
  if [[ -n $parent ]]; then echo "/dev/$parent"; else echo "$src"; fi
}

lsblk_disks() {
  lsblk -J -b -d -o NAME,PATH,SIZE,MODEL,SERIAL,TYPE,RM,RO,TRAN
}

# One tab-separated line per disk Nova may go on: path, size in bytes, model,
# serial, transport, with "-" for an unknown field so the columns never shift.
# Left out: the stick it booted from, read-only, removable and USB disks,
# virtual devices, and anything under 64 GiB. NOVA_ALLOW_USB=1 lets a USB disk
# through, for installing onto an external drive on purpose.
candidate_disks() {
  local boot
  boot=$(boot_disk)
  lsblk_disks | jq -r --arg boot "$boot" --argjson min "$MIN_DISK_BYTES" \
    --arg usb "${NOVA_ALLOW_USB:-0}" '
    def yes: . == true or . == "1" or . == 1;
    .blockdevices[]
    | select(.type == "disk" and .path != $boot)
    | select(.ro | yes | not)
    | select($usb == "1" or ((.rm | yes | not) and .tran != "usb"))
    | select((.name | test("^(loop|zram|sr|ram|fd)")) | not)
    | select((.size | tonumber) >= $min)
    | def field: (. // "") | tostring | gsub("^\\s+|\\s+$"; "") | if . == "" then "-" else . end;
      [.path, (.size | tostring), (.model | field), (.serial | field), (.tran | field)]
    | @tsv'
}

# Something on the live system is using the disk: a mounted partition, active
# swap, or an LVM, RAID or dm-crypt device built on it.
disk_in_use() {
  local disk=$1
  lsblk -nro MOUNTPOINTS -- "$disk" | grep -q . && return 0
  lsblk -nro TYPE -- "$disk" | grep -Eq '^(lvm|crypt|raid[0-9]*|dm|md)$'
}

# /dev/nvme0n1 -> /dev/nvme0n1p2, /dev/sda -> /dev/sda2
partition_path() {
  local disk=$1 number=$2
  if [[ $disk =~ [0-9]$ ]]; then echo "${disk}p$number"; else echo "$disk$number"; fi
}

human_size() {
  awk -v b="$1" 'BEGIN { split("B KB MB GB TB PB", u); i = 1; while (b >= 1000 && i < 6) { b /= 1000; i++ } printf (i > 3 ? "%.1f %s" : "%.0f %s"), b, u[i] }'
}

# Swap for hibernation: the size of RAM, so a full image always fits, rounded
# up to a GiB and never more than an eighth of the disk.
swap_gib() {
  local disk_bytes=$1 ram_gib cap
  ram_gib=$(awk '/^MemTotal:/ { printf "%d", ($2 + 1048575) / 1048576 }' "$MEMINFO")
  cap=$((disk_bytes / 8 / 1024 / 1024 / 1024))
  ((ram_gib > 0)) || ram_gib=8
  if ((ram_gib > cap)); then echo "$cap"; else echo "$ram_gib"; fi
}

# ------------------------------------------------------------- the machine

cpu_has_x86_64_v3() {
  local flags f
  flags=$(grep -m 1 '^flags' "$CPUINFO" 2>/dev/null) || return 1
  for f in avx avx2 bmi1 bmi2 f16c fma abm movbe xsave; do
    [[ " ${flags#*:} " == *" $f "* ]] || return 1
  done
}

cpu_vendor() {
  awk -F': ' '/^vendor_id/ { print $2; exit }' "$CPUINFO" 2>/dev/null
}

# The kernel Nova boots: linux-nova is built for x86-64-v3, so an older CPU
# gets Arch's own kernel instead. linux-lts is installed either way as the
# fallback entry.
main_kernel() {
  if cpu_has_x86_64_v3; then echo linux-nova; else echo linux; fi
}

# Packages this hardware needs, from the CPU and the display controllers in
# sysfs (never lspci, which wakes a sleeping GPU). The model's own profile adds
# to this; see profile_packages.
hardware_packages() {
  local kernel=$1 dev vendor device dgpu=0 igpu=0
  case $(cpu_vendor) in
    GenuineIntel) echo intel-ucode ;;
    AuthenticAMD) echo amd-ucode ;;
  esac
  for dev in "$PCI_DEVICES"/*; do
    [[ -r $dev/class && $(<"$dev/class") == 0x03* ]] || continue
    vendor=$(<"$dev/vendor")
    case $vendor in
      0x8086) printf '%s\n' "${GPU_INTEL[@]}"; igpu=1 ;;
      0x1002) printf '%s\n' "${GPU_AMD[@]}"; igpu=1 ;;
      0x10de)
        device=$(<"$dev/device")
        # The open modules need GSP firmware, which starts with Turing. The
        # LTS fallback kernel gets its own build, so it can drive the card too.
        if ((device >= 0x1e00)); then
          if [[ $kernel == linux-nova ]]; then echo nvidia-open-nova; else echo nvidia-open; fi
          echo nvidia-open-lts
          echo nvidia-utils
          dgpu=1
        fi
        ;;
    esac
  done
  # With an integrated GPU beside it, the desktop and the browser run on that
  # one, and prime-run puts a game on the NVIDIA card; alone, the NVIDIA card
  # decodes video itself.
  if ((dgpu && igpu)); then echo nvidia-prime; fi
  if ((dgpu && !igpu)); then echo libva-nvidia-driver; fi
}

hardware_profile() {
  NOVA_HARDWARE=$SHARE/hardware "$SHARE/hardware/nova-hw-detect" 2>/dev/null || true
}

# The model profile's package list. nvidia-open-nova only exists for linux-nova,
# so an older CPU gets Arch's nvidia-open in its place.
profile_packages() {
  local profile=$1 kernel=$2 name
  [[ -n $profile && -r $SHARE/hardware/$profile/packages ]] || return 0
  while IFS= read -r name; do
    name=${name%%#*}
    name=${name//[[:space:]]/}
    [[ -n $name ]] || continue
    if [[ $name == nvidia-open-nova && $kernel != linux-nova ]]; then name=nvidia-open; fi
    echo "$name"
  done <"$SHARE/hardware/$profile/packages"
}

# Every package an install on any computer could ask for, for the offline
# repository nova usb puts on a stick: one stick installs any machine.
every_package() {
  local list
  {
    grep -v -e '^#' -e '^[[:space:]]*$' "$SHARE/packages"
    printf '%s\n' linux-nova linux linux-lts intel-ucode amd-ucode "${GPU_INTEL[@]}" "${GPU_AMD[@]}" \
      nvidia-open-nova nvidia-open nvidia-open-lts nvidia-utils nvidia-prime libva-nvidia-driver
    for list in "$SHARE"/hardware/*/packages; do
      [[ -r $list ]] || continue
      sed 's/#.*//; s/[[:space:]]//g; /^$/d' "$list"
    done
  } | awk '!seen[$0]++'
}

# Everything pacstrap installs, one per line, without duplicates.
package_set() { # kernel profile [package...]
  local kernel=$1 profile=$2
  {
    grep -v -e '^#' -e '^[[:space:]]*$' "$SHARE/packages"
    echo "$kernel"
    echo linux-lts
    hardware_packages "$kernel"
    profile_packages "$profile" "$kernel"
    printf '%s\n' "${@:3}"
  } | awk 'NF && !seen[$0]++'
}

# --------------------------------------------------------- the release and repos

# A string value from release.toml: key = "value"
release_value() {
  sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\"\\([^\"]*\\)\"[[:space:]]*\$/\\1/p" "$RELEASE_FILE" | awk 'NR == 1'
}

offline_repo_ready() {
  [[ -r $OFFLINE_REPO/nova-offline.db ]]
}

# The pacman.conf pacstrap uses. Offline, one repository on the stick holds
# every package; online, the same repositories the installed system will use.
pacstrap_conf() {
  local arch_date=$1 nova_repo=$2
  cat <<EOF
[options]
Architecture = auto
SigLevel = Required DatabaseOptional
LocalFileSigLevel = Optional
ParallelDownloads = 5
EOF
  if offline_repo_ready; then
    printf '\n[nova-offline]\nServer = file://%s\n' "$OFFLINE_REPO"
  else
    printf '\n[nova]\nSigLevel = Required\nServer = %s\n' "$nova_repo"
    local repo
    for repo in core extra multilib; do
      # shellcheck disable=SC2016 # $arch is pacman's to expand
      printf '\n[%s]\nServer = https://archive.archlinux.org/repos/%s/$repo/os/$arch\n' "$repo" "$arch_date"
    done
  fi
}

# ------------------------------------------------------------- the boot line

# The machine-specific half of the kernel command line; the quiet-boot half is
# in /etc/limine-entry-tool.d/10-nova.conf. zswap is off because zram does the
# compressing. rootflags=subvol=@ is the form limine-snapper-sync rewrites to
# boot a snapshot.
install_cmdline() {
  local root_partuuid=$1 resume_offset=$2
  printf 'root=PARTUUID=%s rootflags=subvol=@ rw rootfstype=btrfs zswap.enabled=0 resume=PARTUUID=%s resume_offset=%s' \
    "$root_partuuid" "$root_partuuid" "$resume_offset"
}

limine_install_conf() {
  local cmdline=$1 kernel=$2
  echo "# Written by nova-install for this machine's disk."
  printf 'KERNEL_CMDLINE[default]+=" %s"\n' "$cmdline"
  if [[ $kernel != linux-nova ]]; then
    echo "# This CPU predates x86-64-v3, so Arch's kernel stands in for linux-nova."
    echo "MKINITCPIO_FALLBACK=$kernel"
    echo "BOOT_ORDER=\"$kernel, *fallback, linux-lts, *, Snapshots\""
  fi
}

# genfstab writes subvolid= next to subvol=, and a subvolid pins the mount to
# one subvolume forever: rolling back to a snapshot would mount the old one.
strip_subvolid() {
  sed -E 's/,subvolid=[0-9]+//; s/subvolid=[0-9]+,//'
}

# ------------------------------------------------------------- the questions

# Never root, the greeter or another system account: those exist in the new
# system too, and useradd would fail there after the disk is already erased. An
# ordinary account of that name on the live system (the fingerprint stand-in of
# an earlier attempt) is fine.
valid_username() {
  [[ $1 =~ ^[a-z_][a-z0-9_-]{0,31}$ && $1 != root && $1 != greeter ]] || return 1
  local entry uid
  entry=$(getent passwd "$1") || return 0
  IFS=: read -r _ _ uid _ <<<"$entry"
  ((uid >= 1000 && uid != 65534))
}

valid_hostname() {
  [[ $1 =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]]
}

valid_timezone() {
  [[ $1 =~ ^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*$ && -f ${NOVA_ZONEINFO:-/usr/share/zoneinfo}/$1 ]]
}

valid_keymap() {
  [[ $1 =~ ^[a-z][a-z0-9_-]*$ ]] && localectl list-keymaps 2>/dev/null | grep -qx -- "$1"
}

# An answer from the answers file: the last key=value line for the key.
answer() { # key
  sed -n "s/^$1=//p" "$ANSWERS" | tail -n 1
}

ask() { # key prompt default -> the answer on stdout
  local reply
  if [[ -n $ANSWERS ]]; then
    reply=$(answer "$1")
  else
    read -rp "  $2${3:+ [$3]}: " reply </dev/tty
  fi
  echo "${reply:-$3}"
}

# Asked again after a wrong answer; from the answers file, there is no again.
retry() { # message
  [[ -z $ANSWERS ]] || die "the answers file: $1"
  warn "$1"
}

ask_password() {
  local first second
  if [[ -n $ANSWERS ]]; then
    first=$(answer password)
    [[ -n $first ]] || die "the answers file has no password"
    printf '%s' "$first"
    return
  fi
  while :; do
    read -rsp "  Password: " first </dev/tty
    echo >&2
    read -rsp "  Again: " second </dev/tty
    echo >&2
    if [[ -z $first ]]; then
      warn "The password cannot be empty."
    elif [[ $first != "$second" ]]; then
      warn "Those did not match."
    else
      printf '%s' "$first"
      return
    fi
  done
}

choose_disk() {
  local disks=() line i choice path size model serial
  mapfile -t disks < <(candidate_disks)
  ((${#disks[@]})) || die "no disk to install on: Nova needs an internal disk of at least 64 GB."
  if [[ -n $ANSWERS ]]; then
    for line in "${disks[@]}"; do
      [[ ${line%%$'\t'*} == "$(answer disk)" ]] || continue
      disk_in_use "${line%%$'\t'*}" && die "the answers file's disk is in use by the live system"
      echo "$line"
      return
    done
    die "the answers file names no disk this can install on (disk=$(answer disk))"
  fi
  # The menu goes to stderr: what this prints on stdout is the answer.
  {
    say "Which disk? Everything on it will be erased."
    for i in "${!disks[@]}"; do
      IFS=$'\t' read -r path size model serial _ <<<"${disks[i]}"
      [[ $model != - ]] || model="unknown model"
      [[ $serial != - ]] || serial=
      printf '  %d) %-14s %8s  %s%s\n' "$((i + 1))" "$path" "$(human_size "$size")" "$model" "${serial:+  ($serial)}"
      lsblk -nro NAME,FSTYPE,LABEL,SIZE -- "$path" | awk 'NR > 1 { printf "       %s %s %s %s\n", $1, $2, $3, $4 }'
    done
  } >&2
  while :; do
    choice=$(ask - "Disk number" "$( ((${#disks[@]} == 1)) && echo 1)")
    if [[ $choice =~ ^[0-9]+$ ]] && ((choice >= 1 && choice <= ${#disks[@]})); then
      line=${disks[choice - 1]}
      path=${line%%$'\t'*}
      if disk_in_use "$path"; then
        warn "$path is in use by the live system (mounted, swap or LVM). Pick another."
        continue
      fi
      echo "$line"
      return
    fi
    warn "Type one of the numbers above."
  done
}

# ------------------------------------------------------------- the install

logged() { # log the command, then run it with its output in the log
  printf '+ %s\n' "$*" >>"$LOG"
  "$@" >>"$LOG" 2>&1
}

in_target() {
  logged arch-chroot "$TARGET" "$@"
}

partition_and_format() {
  local disk=$1 esp root
  say "Partitioning $disk"
  logged wipefs -af "$disk"
  logged sfdisk --wipe always --wipe-partitions always "$disk" <<EOF
label: gpt
size=${ESP_MIB}MiB, type=uefi, name="NOVA-ESP"
type=linux, name="nova"
EOF
  logged udevadm settle
  esp=$(partition_path "$disk" 1)
  root=$(partition_path "$disk" 2)
  [[ -b $esp && -b $root ]] || die "the new partitions did not appear ($esp, $root)"
  logged mkfs.fat -F 32 -n NOVA-ESP "$esp"
  logged mkfs.btrfs -f -L nova "$root"
}

create_subvolumes_and_mount() {
  local disk=$1 swap=$2 esp root entry name mountpoint
  esp=$(partition_path "$disk" 1)
  root=$(partition_path "$disk" 2)
  say "Creating the filesystem layout"
  logged mount "$root" "$TARGET"
  for entry in "${SUBVOLUMES[@]}"; do
    logged btrfs subvolume create "$TARGET/${entry%%:*}"
  done
  logged umount "$TARGET"

  logged mount -o "$BTRFS_OPTS,subvol=@" "$root" "$TARGET"
  for entry in "${SUBVOLUMES[@]:1}"; do
    name=${entry%%:*}
    mountpoint=${entry#*:}
    logged mkdir -p "$TARGET$mountpoint"
    if [[ $name == @swap ]]; then
      logged mount -o "noatime,subvol=$name" "$root" "$TARGET$mountpoint"
    else
      logged mount -o "$BTRFS_OPTS,subvol=$name" "$root" "$TARGET$mountpoint"
    fi
  done
  logged chmod 750 "$TARGET/.snapshots"
  logged mkdir -p "$TARGET/boot"
  logged mount -o fmask=0077,dmask=0077 "$esp" "$TARGET/boot"

  info "A ${swap} GiB swap file, for hibernation"
  logged btrfs filesystem mkswapfile --size "${swap}g" --uuid clear "$TARGET/swap/swapfile"
  logged swapon "$TARGET/swap/swapfile"
}

install_packages() { # kernel profile arch_date nova_repo [package...]
  local kernel=$1 profile=$2 arch_date=$3 nova_repo=$4 conf
  conf=$(mktemp /tmp/nova-pacstrap.XXXXXX.conf)
  pacstrap_conf "$arch_date" "$nova_repo" >"$conf"
  say "Installing packages (this is the long part)"
  mapfile -t packages < <(package_set "$kernel" "$profile" "${@:5}")
  info "${#packages[@]} packages, from $(offline_repo_ready && echo "the stick" || echo "the internet")"
  # Output goes to the terminal as well as the log: this is minutes long and
  # pacman's own progress is the progress bar.
  printf '+ pacstrap -C %s -K %s %s\n' "$conf" "$TARGET" "${packages[*]}" >>"$LOG"
  pacstrap -C "$conf" -K "$TARGET" "${packages[@]}" 2>&1 | tee -a "$LOG" ||
    die "pacstrap failed; the log is in $LOG"
}

write_system_config() {
  local hostname=$1 timezone=$2 keymap=$3 arch_date=$4 nova_repo=$5 tag=$6
  say "Configuring the system"
  genfstab -U "$TARGET" | strip_subvolid >"$TARGET/etc/fstab"
  # genfstab lists the swap file it saw active; make sure it is there.
  grep -q '/swap/swapfile' "$TARGET/etc/fstab" ||
    echo '/swap/swapfile none swap defaults 0 0' >>"$TARGET/etc/fstab"

  echo "$hostname" >"$TARGET/etc/hostname"
  printf '127.0.0.1 localhost\n::1 localhost\n127.0.1.1 %s.localdomain %s\n' "$hostname" "$hostname" >"$TARGET/etc/hosts"
  ln -sf "/usr/share/zoneinfo/$timezone" "$TARGET/etc/localtime"
  in_target hwclock --systohc
  sed -i 's/^#\(en_US.UTF-8 UTF-8\)/\1/' "$TARGET/etc/locale.gen"
  in_target locale-gen
  echo 'LANG=en_US.UTF-8' >"$TARGET/etc/locale.conf"
  # The session reads the keyboard layout from here (default/hypr/input.lua), so
  # the console, the greeter, the lock screen and the desktop all agree.
  local layout variant
  IFS=$'\t' read -r layout variant < <(xkb_layout "$keymap")
  {
    printf 'KEYMAP=%s\nXKBLAYOUT=%s\n' "$keymap" "$layout"
    [[ -z $variant ]] || printf 'XKBVARIANT=%s\n' "$variant"
  } >"$TARGET/etc/vconsole.conf"

  install -Dm644 "$SHARE/pacman.conf" "$TARGET/etc/pacman.conf"
  write_release_pins "$arch_date" "$nova_repo" "$tag"
}

# The XKB layout and variant for a console keymap, tab-separated, from the table
# localectl converts with (sv-latin1 is se, sg is ch with de_nodeadkeys). A
# keymap the table lacks is taken to be the layout's own name, less a -latin1
# style suffix.
xkb_layout() { # keymap
  local keymap=$1 layout='' variant=''
  if [[ -r $KBD_MODEL_MAP ]]; then
    read -r layout variant < <(awk -v k="$keymap" \
      '$1 == k { print $2, ($4 == "-" ? "" : $4); found = 1; exit } END { if (!found) print "" }' "$KBD_MODEL_MAP")
  fi
  if [[ -z $layout ]]; then
    case $keymap in
      *-latin1 | *-latin9 | *-nodeadkeys) layout=${keymap%%-*} ;;
      *) layout=$keymap ;;
    esac
  fi
  printf '%s\t%s\n' "$layout" "$variant"
}

# The same two files nova update rewrites for every release, so the installed
# system starts on the release it was installed from.
write_release_pins() {
  local arch_date=$1 nova_repo=$2 tag=$3
  {
    echo '# Managed by nova update; the next update rewrites this file.'
    printf '# nova-release: %s\n# arch-date: %s\n' "$tag" "$arch_date"
    # shellcheck disable=SC2016 # $repo and $arch are pacman's to expand
    printf 'Server = https://archive.archlinux.org/repos/%s/$repo/os/$arch\n' "$arch_date"
  } >"$TARGET/etc/pacman.d/nova-mirrorlist"
  {
    echo '# Managed by nova update; the next update rewrites this file.'
    printf '# nova-release: %s\nServer = %s\n' "$tag" "$nova_repo"
  } >"$TARGET/etc/pacman.d/nova-repo"
}

create_user() {
  local user=$1 fullname=$2 password=$3
  say "Creating your account"
  in_target useradd -m -k /usr/share/nova/skel -G wheel -c "$fullname" -s /bin/bash "$user"
  printf '%s:%s\n' "$user" "$password" | arch-chroot "$TARGET" chpasswd ||
    die "could not set the password"
  in_target passwd -l root
  install -m 440 /dev/stdin "$TARGET/etc/sudoers.d/10-nova-wheel" <<<'%wheel ALL=(ALL:ALL) ALL'
  in_target visudo -cf /etc/sudoers.d/10-nova-wheel

  # Autologin goes to this account; anyone else signs in at the greeter.
  sed "s/@NOVA_USER@/$user/" "$TARGET/usr/share/nova/session/greetd.toml" >"$TARGET/etc/greetd/config.toml"
  # The greeter shows the user's theme without root: the theme engine mirrors
  # it here, and the directory is the user's.
  install -d -m 755 "$TARGET/var/lib/nova/greeter"
  in_target chown "$user:$user" /var/lib/nova/greeter
  in_target runuser -u "$user" -- env HOME="/home/$user" PATH=/usr/lib/nova/bin:/usr/bin nova-theme set white
}

# ------------------------------------------------------------------ fingerprint

# Whether the live system's fprintd has a reader. It starts on this first call,
# and sees only the readers libfprint can drive, which are the ones worth
# setting up.
fingerprint_reader() {
  local devices
  devices=$(busctl --system call net.reactivated.Fprint /net/reactivated/Fprint/Manager \
    net.reactivated.Fprint.Manager GetDevices 2>/dev/null) || return 1
  [[ $devices == "ao "[1-9]* ]]
}

# Fingerprints carried from this same computer, which restore_carry puts back.
carried_fingerprints() {
  carry_ready && carry_items | awk -F'\t' '$1 == "fingerprints" { found = 1 } END { exit !found }' &&
    [[ -n $(machine_hash) && $(machine_hash) == "$(carry_value .source.machine)" ]]
}

# One finger for the new account, enrolled here on the stick before anything
# is installed; copy_fingerprints moves it into the new system. fprintd files
# prints under a user name, so a stand-in for the account exists here too.
enroll_fingerprint() { # user
  local user=$1 line
  id -u "$user" >/dev/null 2>&1 || useradd -M -s /usr/bin/nologin "$user" >/dev/null 2>&1 || return 1
  info "Touch the reader with your right index finger, lift it, and again, until it says done."
  { fprintd-enroll -f right-index-finger "$user" 2>&1 || true; } | while IFS= read -r line; do
    case $line in
      *enroll-stage-passed*) info "Got it. Again." ;;
      *enroll-retry-scan* | *enroll-swipe-too-short* | *enroll-finger-not-centered* | *enroll-remove-and-retry*)
        info "That did not read. Lift your finger and touch again."
        ;;
      *enroll-completed*) info "Done." ;;
    esac
  done
  [[ -n $(find "$FPRINT_DIR/$user" -type f 2>/dev/null) ]]
}

copy_fingerprints() { # user
  [[ -d $FPRINT_DIR/$1 ]] || return 0
  install -d -m 700 "$TARGET/var/lib/fprint"
  cp -a "$FPRINT_DIR/$1" "$TARGET/var/lib/fprint/"
}

# --------------------------------------------------------------- answers file

answer_or() { # key default: the answer, or the default when there is none
  local value=''
  [[ -z $ANSWERS ]] || value=$(answer "$1")
  echo "${value:-$2}"
}

# The answers file's after= script, run as root in the new system once the
# install is done; a relative path is next to the answers file.
run_after() {
  local script
  script=$(answer_or after '')
  [[ -n $script ]] || return 0
  [[ $script == /* ]] || script=${ANSWERS%/*}/$script
  [[ -r $script ]] || die "the answers file's after= script is not there: $script"
  say "Running $script"
  install -m 700 "$script" "$TARGET/root/nova-after"
  in_target /root/nova-after || die "$script failed; the log is in $LOG"
  rm -f "$TARGET/root/nova-after"
}

configure_snapper() {
  # What `snapper create-config` writes, without the .snapshots subvolume it
  # would create: @snapshots is already mounted there, outside the root
  # subvolume, so a rollback does not take the snapshots with it.
  install -Dm644 "$TARGET/usr/share/snapper/config-templates/nova" "$TARGET/etc/snapper/configs/root"
  echo 'SNAPPER_CONFIGS="root"' >"$TARGET/etc/conf.d/snapper"
}

# Written before pacstrap: the kernel's own install hooks build the boot
# entries, and they need the root and resume arguments and the Limine header
# already in place to get them right the first time.
prepare_boot_config() {
  local disk=$1 kernel=$2 root partuuid offset
  root=$(partition_path "$disk" 2)
  partuuid=$(blkid -s PARTUUID -o value "$root")
  [[ -n $partuuid ]] || die "could not read the PARTUUID of $root"
  offset=$(btrfs inspect-internal map-swapfile -r "$TARGET/swap/swapfile")
  [[ $offset =~ ^[0-9]+$ ]] || die "could not find the swap file's offset"
  mkdir -p "$TARGET/etc/limine-entry-tool.d"
  limine_install_conf "$(install_cmdline "$partuuid" "$offset")" "$kernel" >"$TARGET/etc/limine-entry-tool.d/90-nova-install.conf"
  install -Dm644 "$SHARE/limine.conf" "$TARGET/boot/limine.conf"
}

install_bootloader() {
  say "Installing the boot loader"
  # --fallback also puts Limine at EFI/BOOT/BOOTX64.EFI, so the disk boots even
  # if the firmware forgets its boot entries.
  in_target limine-install --fallback
  in_target limine-update
  # The same check nova update makes: every kernel has an entry, and every file
  # an entry loads is on the ESP.
  in_target /usr/lib/nova/bin/nova-boot-check post || die "the boot entries did not check out; the log is in $LOG"
}

# Chrome, VS Code (built from their AUR recipes, since neither may be
# redistributed) and the mise tools, Claude Code and Codex. Online only, and
# never fatal: the system is complete without them, and the same two commands
# finish the job later.
install_apps() {
  local user=$1 rule=$TARGET/etc/sudoers.d/90-nova-install-apps
  if ! curl -fsI --max-time 10 -o /dev/null https://aur.archlinux.org/; then
    warn "No internet: Chrome, VS Code, Claude Code and Codex are not installed."
    warn "Once connected, run: nova apps install; mise install"
    return 0
  fi
  say "Installing Chrome, VS Code, Claude Code and Codex"
  # makepkg installs through sudo, and the account has no password prompt to
  # answer here, so pacman alone is allowed for the length of this step.
  install -m 440 /dev/stdin "$rule" <<<"$user ALL=(root) NOPASSWD: /usr/bin/pacman"
  trap 'rm -f -- "$rule"' EXIT
  in_target runuser -u "$user" -- env HOME="/home/$user" PATH=/usr/lib/nova/bin:/usr/bin nova-apps-install --noconfirm ||
    warn "Chrome or VS Code did not install; run nova apps install after the first login."
  rm -f -- "$rule"
  trap - EXIT
  in_target runuser -u "$user" -- env HOME="/home/$user" PATH=/usr/bin mise install --yes ||
    warn "The mise tools did not install; run mise install after the first login."
}

enable_services() {
  say "Enabling services"
  in_target systemctl enable greetd.service NetworkManager.service bluetooth.service \
    systemd-resolved.service systemd-timesyncd.service systemd-oomd.service \
    power-profiles-daemon.service fstrim.timer snapper-cleanup.timer limine-snapper-sync.service
}

finish() {
  # arch-chroot binds the live system's resolv.conf over the target's while it
  # runs, so the link to systemd-resolved is made from outside.
  ln -sf ../run/systemd/resolve/stub-resolv.conf "$TARGET/etc/resolv.conf"
  install -Dm600 "$LOG" "$TARGET/var/log/nova-install.log"
  logged swapoff "$TARGET/swap/swapfile"
  sync
  logged umount -R "$TARGET"
}

# ------------------------------------------------- what nova usb carried
#
# A stick made by nova usb with things of yours on it has a second partition,
# NOVA-DATA: LUKS2, then btrfs, then carry/ with one tar.zst per item, their
# SHA-256 sums and manifest.json. It is opened read-only at $CARRY before the
# network is needed, so carried Wi-Fi can get the live system online, and the
# install puts each item back once the account exists.

carry_ready() { [[ -r $CARRY/carry/manifest.json ]]; }

# The stick's NOVA-DATA partition: on the disk the live system booted from
# when that can be told, anywhere otherwise.
carry_partition() {
  local disk
  disk=$(boot_disk)
  if [[ -n $disk ]]; then
    lsblk -nrpo PATH,PARTLABEL -- "$disk" 2>/dev/null
  else
    lsblk -nrpo PATH,PARTLABEL 2>/dev/null
  fi | awk '$2 == "NOVA-DATA" { print $1; exit }'
}

carry_items() { # -> id, kind, file and label of each item, tab-separated
  jq -r '.items[] | [.id, .kind, .file, (.label // .id)] | @tsv' "$CARRY/carry/manifest.json"
}

carry_value() { # jq path
  jq -r "$1 // empty" "$CARRY/carry/manifest.json"
}

# This computer, hashed the way nova usb hashes the one it ran on.
machine_hash() {
  local id
  id=$(cat "$DMI/product_uuid" "$DMI/product_serial" 2>/dev/null) || true
  [[ -n $id ]] || return 0
  printf '%s' "$id" | sha256sum | awk '{ print $1 }'
}

# Asks for the passphrase until it opens (or Enter skips), mounts the
# partition and checks every archive against its sum. All or nothing: a stick
# that reads back wrong carries nothing over.
carry_unlock() {
  carry_ready && return 0
  local part pass tries
  part=$(carry_partition)
  [[ -n $part ]] || return 1
  say "Your things are on this stick, encrypted"
  for ((tries = 0; tries < 5; tries++)); do
    if [[ -n $ANSWERS ]]; then
      pass=$(answer passphrase)
      tries=4
    else
      read -rsp "  Passphrase (Enter to install without them): " pass </dev/tty
      echo >&2
    fi
    [[ -n $pass ]] || return 1
    if printf '%s' "$pass" | cryptsetup open --readonly --key-file - "$part" "$CARRY_MAPPER" 2>/dev/null; then
      mkdir -p "$CARRY"
      mount -o ro "/dev/mapper/$CARRY_MAPPER" "$CARRY" || {
        cryptsetup close "$CARRY_MAPPER"
        warn "The partition opened but would not mount; installing without your things."
        return 1
      }
      if ! (cd "$CARRY/carry" && sha256sum --quiet -c SHA256SUMS >&2); then
        warn "Some of it does not read back as it was written (above); installing without your things."
        umount "$CARRY"
        cryptsetup close "$CARRY_MAPPER"
        return 1
      fi
      info "$(carry_items | wc -l) things, from $(carry_value .source.host)"
      return 0
    fi
    warn "That is not the passphrase."
  done
  return 1
}

keyfile_value() { # NetworkManager keyfile, section, key
  awk -v section="[$2]" -v key="$3" '
    /^\[/ { inside = ($0 == section); next }
    inside && index($0, key "=") == 1 { print substr($0, length(key) + 2); exit }' "$1"
}

# iwd names a network's file after its SSID when that is plain, and = plus the
# SSID in hex when it is not.
iwd_name() {
  local LC_ALL=C
  if [[ $1 =~ ^[A-Za-z0-9\ _-]+$ ]]; then
    echo "$1"
  else
    printf '=%s\n' "$(printf '%s' "$1" | od -An -tx1 | tr -d ' \n')"
  fi
}

# The carried Wi-Fi networks, written as iwd networks for the live system,
# which joins a known network by itself. Personal (WPA2/WPA3) and open ones;
# a network that needs a certificate waits for the installed system.
carry_wifi_live() {
  local file tmp conf ssid psk mgmt name
  file=$(carry_items | awk -F'\t' '$1 == "wifi" { print $3 }')
  [[ -n $file ]] || return 0
  tmp=$(mktemp -d)
  if ! zstd -dc "$CARRY/carry/$file" | tar -x -C "$tmp"; then
    rm -rf -- "$tmp"
    return 1
  fi
  mkdir -p "$IWD_DIR"
  for conf in "$tmp"/etc/NetworkManager/system-connections/*.nmconnection; do
    [[ -r $conf && $(keyfile_value "$conf" connection type) == wifi ]] || continue
    ssid=$(keyfile_value "$conf" wifi ssid)
    mgmt=$(keyfile_value "$conf" wifi-security key-mgmt)
    psk=$(keyfile_value "$conf" wifi-security psk)
    [[ -n $ssid ]] || continue
    name=$(iwd_name "$ssid")
    case $mgmt in
      "") install -m 600 /dev/null "$IWD_DIR/$name.open" ;;
      wpa-psk | sae)
        [[ -n $psk ]] || continue
        printf '[Security]\nPassphrase=%s\n' "$psk" | install -m 600 /dev/stdin "$IWD_DIR/$name.psk"
        ;;
    esac
  done
  rm -rf -- "$tmp"
}

unpack() { # archive directory [tar options]
  local archive=$1 dir=$2
  shift 2
  mkdir -p "$dir"
  printf '+ unpack %s into %s\n' "$archive" "$dir" >>"$LOG"
  zstd -dc "$CARRY/carry/$archive" 2>>"$LOG" | tar -x -C "$dir" "$@" >>"$LOG" 2>&1
}

target_ids() { # user -> uid:gid in the new system
  awk -F: -v u="$1" '$1 == u { print $3 ":" $4 }' "$TARGET/etc/passwd"
}

# A carried menu bar layout may be Omarchy's: its widgets are renamed to
# Nova's, and the ones Nova does not have are dropped.
adopt_shell_config() { # shell.json
  local file=$1 ids
  [[ -f $file ]] || return 0
  ids=$({ find "$TARGET/usr/share/nova/shell/plugins" -name '*manifest.json' -exec jq -r .id {} + 2>/dev/null || true; } |
    jq -Rsc 'split("\n") | map(select(. != ""))')
  if jq --argjson ids "$ids" '
      def nova: if type == "string" then sub("^[A-Za-z0-9_-]+\\."; "nova.") else . end;
      def keep: map(select(type == "object") | .id |= nova | select(.id as $i | $ids | index([$i])));
      (if (.bar.layout | type) == "object"
        then .bar.layout |= with_entries(.value |= (if type == "array" then keep else . end)) else . end)
      | (if (.plugins | type) == "array" then .plugins |= keep else . end)
      | (if (.idle | type) == "object" then del(.idle.screensaver) else . end)' \
    "$file" >"$file.tmp" 2>>"$LOG"; then
    mv -f -- "$file.tmp" "$file"
  else
    rm -f -- "$file.tmp" "$file"
    warn "The carried menu bar layout could not be read; Nova's own is used."
  fi
}

# The keyrings come with Chrome. A passwordless Default keyring (where Omarchy
# keeps secrets) is moved into the login keyring at the first unlock by
# nova-keyring-migrate; an old login keyring would not open with the new
# password, so it is kept, renamed, for Passwords and Keys to open by hand.
adopt_keyrings() { # keyrings-dir state-dir
  local dir=$1 state=$2
  [[ -d $dir ]] || return 0
  [[ ! -f $dir/login.keyring ]] || mv -f -- "$dir/login.keyring" "$dir/carried-login.keyring"
  if [[ -f $dir/Default_keyring.keyring ]]; then
    mkdir -p "$state"
    : >"$state/keyring-migrate-pending"
  fi
}

# Puts each carried item back. Home items are unpacked into the account and
# handed to it; network connections go to NetworkManager; Bluetooth pairings
# and fingerprints only on the computer they came from, being tied to its
# adapter and its sensor; the package list waits for install_carried_packages.
restore_carry() { # user
  local user=$1 home=$TARGET/home/$1 id kind file label same=0 here there olduser
  carry_ready || return 0
  say "Putting your things back"
  here=$(machine_hash)
  there=$(carry_value .source.machine)
  [[ -n $here && $here == "$there" ]] && same=1
  olduser=$(carry_value .source.user)
  valid_username "$olduser" || olduser=
  while IFS=$'\t' read -r id kind file label; do
    case $kind in
      home | projects | folders)
        info "$label"
        unpack "$file" "$home" || warn "$label did not unpack completely; the log is in $LOG"
        ;;
      system)
        if [[ $id == bluetooth || $id == fingerprints ]] && ((!same)); then
          info "$label: left out, this is another computer"
          continue
        fi
        info "$label"
        if [[ $id == fingerprints && -n $olduser && $olduser != "$user" ]]; then
          unpack "$file" "$TARGET" "--transform=s,^var/lib/fprint/$olduser/,var/lib/fprint/$user/," ||
            warn "$label did not unpack; the log is in $LOG"
        else
          unpack "$file" "$TARGET" || warn "$label did not unpack; the log is in $LOG"
        fi
        ;;
      list)
        unpack "$file" "$home/.local/state/nova/carried" || warn "$label did not unpack; the log is in $LOG"
        ;;
    esac
  done < <(carry_items)
  adopt_shell_config "$home/.config/nova/shell.json"
  adopt_keyrings "$home/.local/share/keyrings" "$home/.local/state/nova"
  chown -R "$(target_ids "$user")" "$home"
}

# The carried package list, once the system is there: what the release's
# repositories have is installed, and the rest (AUR packages, ones Arch has
# since dropped) is written to not-installed.txt next to the list.
install_carried_packages() { # user
  local user=$1 dir=$TARGET/home/$1/.local/state/nova/carried available wanted=() name
  [[ -s $dir/packages.txt ]] || return 0
  if ! curl -fsI --max-time 10 -o /dev/null https://archive.archlinux.org/; then
    warn "No internet: your extra packages are listed in ~/.local/state/nova/carried/ for later."
    return 0
  fi
  say "Installing your extra packages"
  in_target pacman -Sy || {
    warn "Could not reach the repositories; your packages are listed in ~/.local/state/nova/carried/."
    return 0
  }
  available=$(arch-chroot "$TARGET" pacman -Slq 2>>"$LOG" | sort -u)
  mapfile -t wanted < <(comm -12 <(sort -u "$dir/packages.txt") <(echo "$available"))
  comm -23 <(sort -u "$dir/packages.txt") <(echo "$available") >"$dir/not-installed.txt"
  if ((${#wanted[@]})); then
    info "${#wanted[@]} packages"
    # One transaction first; if one of them conflicts with Nova's, each on its
    # own, so the rest still go in.
    if ! in_target pacman -S --needed --noconfirm "${wanted[@]}"; then
      for name in "${wanted[@]}"; do
        in_target pacman -S --needed --noconfirm "$name" || echo "$name" >>"$dir/not-installed.txt"
      done
    fi
  fi
  [[ -s $dir/not-installed.txt ]] &&
    info "$(wc -l <"$dir/not-installed.txt") were left out; they are listed in ~/.local/state/nova/carried/not-installed.txt"
  chown -R "$(target_ids "$user")" "$dir"
}

usage() {
  sed -n '3,/^$/s/^# \{0,1\}//p' "$0"
}

# The ERR trap once the disk is being written: a step that fails ends the
# install, and this says which instead of stopping without a word. Subshells
# inherit the trap (set -E), so only the outermost shell speaks.
stopped() { # line command
  ((BASH_SUBSHELL)) && return
  printf '\n\e[31mnova-install: the install stopped at line %s (%s). The log is in %s.\e[0m\n' \
    "$1" "$2" "$LOG" >&2
}

main() {
  case ${1:-} in
    -h | --help)
      usage
      return 0
      ;;
    --list-packages)
      every_package
      return 0
      ;;
    --unlock)
      ((EUID == 0)) || die "run me as root."
      carry_unlock || return 0
      carry_wifi_live || warn "The carried Wi-Fi networks could not be read."
      return 0
      ;;
    --answers)
      ANSWERS=$(realpath -e -- "${2:?--answers needs a file}") || die "no answers file at $2"
      ;;
    "") ;;
    *) die "unknown argument: $1 (try --help)" ;;
  esac
  ((EUID == 0)) || die "run me as root."
  [[ -d /sys/firmware/efi ]] || die "this computer booted the stick in legacy BIOS mode; Nova needs UEFI. Turn on UEFI boot in the firmware settings."
  [[ -r $RELEASE_FILE ]] || die "no release file at $RELEASE_FILE"
  : >"$LOG"

  local tag arch_date nova_repo
  tag=v$(release_value version)
  arch_date=$(release_value arch_date)
  nova_repo=$(release_value nova_repo)
  [[ $tag =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$ ]] || die "the release file has no valid version"
  [[ $arch_date =~ ^[0-9]{4}/[0-9]{2}/[0-9]{2}$ ]] || die "the release file has no valid arch_date"
  [[ $nova_repo =~ ^https://[A-Za-z0-9._~:/%+-]+$ ]] || die "the release file has no valid nova_repo"
  if ! offline_repo_ready && ! curl -fsI --max-time 10 -o /dev/null https://archive.archlinux.org/; then
    die "this stick has no offline packages and there is no internet connection. Connect with: iwctl"
  fi

  # Things carried on the stick: opened now (nova-install-start usually already
  # has, for their Wi-Fi), put back once the account exists.
  carry_ready || carry_unlock || true

  local kernel profile
  kernel=$(main_kernel)
  profile=$(hardware_profile)
  say "Nova ${tag#v}"
  info "Computer: $(cat /sys/class/dmi/id/product_version 2>/dev/null || echo unknown)${profile:+ (Nova knows this one)}"
  [[ $kernel == linux-nova ]] || info "This CPU predates x86-64-v3, so Nova will use Arch's standard kernel."

  # The layout first, and loaded at once: the password typed below has to be
  # the password the lock screen sees, on the same keyboard layout.
  say "Keyboard"
  local keymap
  while :; do
    keymap=$(ask keymap "Layout (us, es, it, de, fr, uk, ...)" us)
    valid_keymap "$keymap" && break
    retry "No keyboard layout called '$keymap'."
  done
  loadkeys "$keymap" >/dev/null 2>&1 || true

  local disk_line disk disk_size disk_model
  disk_line=$(choose_disk)
  IFS=$'\t' read -r disk disk_size disk_model _ _ <<<"$disk_line"
  [[ $disk_model != - ]] || disk_model=

  say "You"
  local fullname user password hostname timezone carried_user=''
  if carry_ready; then
    carried_user=$(carry_value .source.user)
    valid_username "$carried_user" || carried_user=
  fi
  fullname=$(ask fullname "Full name" "$(carry_ready && carry_value .source.name)")
  while :; do
    user=$(ask user "Username" "${carried_user:-$(tr '[:upper:]' '[:lower:]' <<<"${fullname%% *}" | tr -cd 'a-z0-9_-')}")
    valid_username "$user" && break
    retry "Lower-case letters, digits, - and _, starting with a letter."
  done
  password=$(ask_password)
  while :; do
    hostname=$(ask hostname "Computer name" nova)
    valid_hostname "$hostname" && break
    retry "Letters, digits and -, up to 63 characters."
  done
  while :; do
    timezone=$(ask timezone "Time zone (Europe/Rome, America/New_York, ...)" UTC)
    valid_timezone "$timezone" && break
    retry "No time zone called '$timezone'."
  done

  # Only a reader fprintd can drive gets fprintd in the new system; prints
  # carried from this computer need no enrolling.
  local extra=() fingerprint=''
  if fingerprint_reader; then
    extra+=(fprintd)
    if carried_fingerprints; then
      fingerprint="carried from $(carry_value .source.host)"
    elif [[ -z $ANSWERS ]]; then
      say "Fingerprint"
      while [[ $(ask - "Unlock with your fingerprint? (yes/no)" yes) == y* ]]; do
        if enroll_fingerprint "$user"; then
          fingerprint="right index finger"
          break
        fi
        warn "That did not work."
      done
      [[ -n $fingerprint ]] || info "Settings, Lock Screen sets it up later."
    fi
  fi

  local swap
  swap=$(swap_gib "$disk_size")
  say "Ready to install"
  info "Disk          $disk, $(human_size "$disk_size") ${disk_model:+($disk_model)}: ERASED"
  info "Layout        2 GiB EFI partition, btrfs with snapshots, ${swap} GiB swap file"
  info "Kernel        $kernel, with linux-lts as the fallback"
  info "Account       $user ($fullname) on $hostname"
  info "Time zone     $timezone, keyboard $keymap"
  [[ -z $fingerprint ]] || info "Fingerprint   $fingerprint"
  carry_ready && info "Your things   $(carry_items | wc -l) items from $(carry_value .source.host), put back after the install"
  if [[ -n $ANSWERS ]]; then
    [[ $(answer erase) == yes ]] || die "the answers file does not say erase=yes; nothing was changed."
  else
    [[ $(ask - "Type erase to wipe $disk and install" "") == erase ]] || die "nothing was changed."
  fi

  set -E
  trap 'stopped "$LINENO" "$BASH_COMMAND"' ERR
  partition_and_format "$disk"
  create_subvolumes_and_mount "$disk" "$swap"
  prepare_boot_config "$disk" "$kernel"
  install_packages "$kernel" "$profile" "$arch_date" "$nova_repo" "${extra[@]}"
  write_system_config "$hostname" "$timezone" "$keymap" "$arch_date" "$nova_repo" "$tag"
  configure_snapper
  create_user "$user" "$fullname" "$password"
  unset password
  copy_fingerprints "$user"
  restore_carry "$user"
  install_bootloader
  [[ $(answer_or apps yes) == no ]] || install_apps "$user"
  install_carried_packages "$user"
  enable_services
  run_after
  finish

  say "Nova is installed."
  info "Take the stick out and restart: reboot"
  info "The install log is kept at /var/log/nova-install.log."
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
