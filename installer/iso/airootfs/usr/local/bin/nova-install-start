#!/bin/bash
# The installer stick's first console: the keyboard, the network, nova-install,
# and a restart; one screen each, as nova-install asks its own questions.
#
# Ethernet connects by itself (systemd-networkd). Wi-Fi is picked from what iwd
# sees, and joined with its password; many laptops, the ThinkPad P1 among them,
# have no Ethernet port. A stick that carries its own packages (nova usb) can
# install without a network. Leaving at any point drops to a root shell, where
# `nova-install-start` starts over.
#
# The functions are sourceable (tests/unit/installer/start.bats); `main` runs
# only when executed.

set -uo pipefail

SHARE=${NOVA_INSTALLER_SHARE:-/usr/share/nova-installer}
STICK=${NOVA_STICK:-/run/archiso/bootmnt}
PROBE=https://archive.archlinux.org/

# shellcheck source=installer/ui.bash
source "$SHARE/ui.bash"
# shellcheck source=installer/wifi.bash
source "$SHARE/wifi.bash"
UI_STOPPED="Stopped. nova-install-start starts again."

online() { curl -fsI --max-time 5 -o /dev/null "$PROBE"; }

offline_repo() { [[ -r ${NOVA_OFFLINE_REPO:-$STICK/nova/repo}/nova-offline.db ]]; }

wifi_device() { iw dev 2>/dev/null | awk '$1 == "Interface" { print $2; exit }'; }

wait_online() { # seconds
  local i
  for ((i = 0; i < $1; i++)); do
    online && return 0
    sleep 1
  done
  return 1
}

screen() { ui_header "Install Nova${1:+  ·  $1}"; }

# The networks iwd found, one "name<TAB>security" line each, as iwctl lists
# them (strongest first). Only the ones a password or nothing joins: a network
# that needs a certificate waits for the installed system.
wifi_networks() { # device
  iwctl station "$1" get-networks 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | awk '
    /Network name/ { listed = 1; next }
    !listed || /^[-[:space:]]*$/ { next }
    {
      sub(/^[[:space:]]*>?[[:space:]]*/, "")
      if (match($0, /[[:space:]][[:space:]]+(psk|open)[[:space:]]/)) {
        security = substr($0, RSTART, RLENGTH)
        gsub(/[[:space:]]/, "", security)
        print substr($0, 1, RSTART - 1) "\t" security
      }
    }'
}

# Returns 0 once online, 1 to go on without a network.
connect_wifi() { # device
  local dev=$1 networks=() options=() i ssid security verb hidden problem=''
  rfkill unblock wlan 2>/dev/null
  while :; do
    screen "network"
    ui_note "Looking for Wi-Fi networks..."
    iwctl station "$dev" scan >/dev/null 2>&1
    sleep 3
    mapfile -t networks < <(wifi_networks "$dev")
    options=()
    for i in "${!networks[@]}"; do
      IFS=$'\t' read -r ssid security <<<"${networks[i]}"
      ssid=${ssid//[,$'\t']/ }
      [[ $security != open ]] || ssid+="  (open)"
      options+=("$ssid"$'\t'"$i")
    done
    options+=("A hidden network"$'\t'hidden "Look again"$'\t'again "Without a network"$'\t'none)
    screen "network"
    [[ -z $problem ]] || ui_warn "$problem"
    ui_ask ui_choose "Which Wi-Fi network?" "" "${options[@]}" || return 1
    verb=connect hidden=''
    case $REPLY in
      again) problem='' && continue ;;
      none) return 1 ;;
      hidden)
        ui_ask ui_input "The network's name" || continue
        ssid=$REPLY security=psk verb=connect-hidden hidden=yes
        ;;
      *) IFS=$'\t' read -r ssid security <<<"${networks[REPLY]}" ;;
    esac
    # The password goes in iwd's file for the network, not on iwctl's command
    # line, where any process could read it. --dont-ask fails the connection
    # rather than prompting where nobody sees it.
    if [[ $security != open ]]; then
      ui_ask ui_secret "Password for $ssid" || continue
      iwd_write_psk "$ssid" "$REPLY" "$hidden"
      iwd_wait_known "$ssid" || true
    fi
    if iwctl --dont-ask station "$dev" "$verb" "$ssid" >/dev/null 2>&1; then
      ui_note "Connected to $ssid, waiting for an address..."
      wait_online 20 && return 0
    elif [[ $security != open ]]; then
      # A refused password is not kept for iwd to try again by itself.
      rm -f -- "$IWD_DIR/$(iwd_name "$ssid").psk"
    fi
    problem="Could not connect to $ssid."
  done
}

get_online() {
  local dev
  screen "network"
  ui_note "Checking the network..."
  wait_online 8 && return 0
  dev=$(wifi_device)
  if [[ -n $dev ]]; then
    connect_wifi "$dev"
    return
  fi
  ui_ask ui_confirm "No network. Plug in an Ethernet cable, then Yes; No goes on without one." || return 1
  wait_online 15
}

main() {
  # A stick with an answers file installs with nobody there (tests/install/run):
  # no questions, the report on the console the file names, and the machine off
  # at the end, installed or not.
  local answers=${NOVA_ANSWERS:-$STICK/nova/answers} console keymap keymap_default
  if [[ -r $answers ]]; then
    console=$(sed -n 's/^console=//p' "$answers" | tail -n 1)
    [[ -z $console ]] || exec >>"$console" 2>&1
    if nova-install --answers "$answers"; then
      echo "nova-install-start: installed"
    else
      echo "nova-install-start: the install failed"
      tail -n 40 /var/log/nova-install.log
    fi
    systemctl poweroff
    exit 0
  fi

  # The keyboard first: the passphrase and the Wi-Fi password below are typed
  # on it. nova usb leaves the layout of the computer it ran on as the default.
  keymap_default=$(cat "$STICK/nova/keymap" 2>/dev/null) || keymap_default=us
  # A warning nova-install gives (a stick that will not open) stays on screen
  # past the next one's clearing.
  UI_NOTES=$(mktemp)
  export UI_NOTES
  keymap=$(nova-install --keymap "$keymap_default") || exit
  loadkeys "$keymap" >/dev/null 2>&1
  export NOVA_KEYMAP=$keymap

  # Things carried on the stick (nova usb) are opened first: their Wi-Fi
  # networks can get this system online without a question.
  nova-install --unlock || (($? != 130)) || exit 130

  if ! get_online; then
    screen
    if ! offline_repo; then
      ui_note "Nova installs over the network, so it needs a connection first."
      ui_note "Connect by hand with iwctl, then run nova-install-start again."
      exit 0
    fi
    ui_note "Without a network, Nova installs from the stick. Chrome, VS Code, Claude"
    ui_note "Code and Codex need the network, so they come later: nova apps install"
    echo >&2
    ui_ask ui_confirm "Install without a network?" || exit 0
  fi

  if nova-install; then
    echo
    ui_ask ui_confirm "Take the stick out. Restart now?" && systemctl reboot
  elif (($? != 130)); then
    echo
    echo "The install stopped. Its log is /var/log/nova-install.log;"
    echo "run nova-install-start to try again."
  fi
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
