#!/bin/bash
# The installer stick's first console: the keyboard, the network, nova-install,
# and a restart; one screen each, as nova-install asks its own questions. With
# a USB disk of 32 GB or more plugged in beside the stick, Nova can go on that
# instead, to start any PC from (nova-install --portable): how a stick written
# with any USB writer, on Windows say, makes a portable Nova.
#
# Ethernet connects by itself (systemd-networkd). Wi-Fi is picked from what iwd
# sees, and joined with its password; many laptops, the ThinkPad P1 among them,
# have no Ethernet port. A stick that carries its own packages (nova usb) can
# install without a network. Leaving at any point drops to a root shell, where
# `nova-install-start` starts over.
#
# The functions are sourceable (tests/unit/installer/start.bats); `main` runs
# only when executed.

set -uo pipefail

SHARE=${NOVA_INSTALLER_SHARE:-/usr/share/nova-installer}
STICK=${NOVA_STICK:-/run/archiso/bootmnt}
PROBE=https://archive.archlinux.org/

# shellcheck source=installer/ui.bash
source "$SHARE/ui.bash"
# shellcheck source=installer/wifi.bash
source "$SHARE/wifi.bash"
UI_STOPPED="Stopped. nova-install-start starts again."

online() { curl -fsI --max-time 5 -o /dev/null "$PROBE"; }

offline_repo() { [[ -r ${NOVA_OFFLINE_REPO:-$STICK/nova/repo}/nova-offline.db ]]; }

wifi_device() { iw dev 2>/dev/null | awk '$1 == "Interface" { print $2; exit }'; }

wait_online() { # seconds
  local i
  for ((i = 0; i < $1; i++)); do
    online && return 0
    sleep 1
  done
  return 1
}

# Some network interface has a link: a cable plugged in and up, or Wi-Fi
# joined. Without one no address can come, however long it is waited for.
NET_DIR=${NOVA_NET_DIR:-/sys/class/net}
has_link() {
  local dev
  for dev in "$NET_DIR"/*; do
    [[ ${dev##*/} != lo && $(cat -- "$dev/carrier" 2>/dev/null) == 1 ]] && return 0
  done
  return 1
}

# The steps of an install, as every screen shows them: this program's own
# two first (nova-install shows the rest, and is told these are done), then
# nova-install's, as they usually are.
export UI_TRAIL="Keyboard Network Disk You Computer Review Install"
export NOVA_TRAIL_BEFORE="Keyboard Network"

screen() { # [the step it is in]
  UI_AT=${1:-}
  ui_header
}

# The networks iwd found, one "name<TAB>security" line each, as iwctl lists
# them (strongest first). Only the ones a password or nothing joins: a network
# that needs a certificate waits for the installed system.
wifi_networks() { # device
  iwctl station "$1" get-networks 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | awk '
    /Network name/ { listed = 1; next }
    !listed || /^[-[:space:]]*$/ { next }
    {
      sub(/^[[:space:]]*>?[[:space:]]*/, "")
      if (match($0, /[[:space:]][[:space:]]+(psk|open)[[:space:]]/)) {
        security = substr($0, RSTART, RLENGTH)
        gsub(/[[:space:]]/, "", security)
        print substr($0, 1, RSTART - 1) "\t" security
      }
    }'
}

# Returns 0 once online, 1 to go on without a network.
connect_wifi() { # device
  local dev=$1 networks=() options=() i ssid security verb hidden problem=''
  rfkill unblock wlan 2>/dev/null
  while :; do
    screen Network
    ui_note "Looking for Wi-Fi networks..."
    iwctl station "$dev" scan >/dev/null 2>&1
    sleep 3
    mapfile -t networks < <(wifi_networks "$dev")
    options=()
    for i in "${!networks[@]}"; do
      IFS=$'\t' read -r ssid security <<<"${networks[i]}"
      ssid=${ssid//[,$'\t']/ }
      [[ $security != open ]] || ssid+="  (open)"
      options+=("$ssid"$'\t'"$i")
    done
    options+=("A hidden network"$'\t'hidden "Look again"$'\t'again "Without a network"$'\t'none)
    screen Network
    [[ -z $problem ]] || ui_warn "$problem"
    ui_ask ui_choose "Which Wi-Fi network?" "" "${options[@]}" || return 1
    verb=connect hidden=''
    case $REPLY in
      again) problem='' && continue ;;
      none) return 1 ;;
      hidden)
        ui_ask ui_input "The network's name" || continue
        ssid=$REPLY security=psk verb=connect-hidden hidden=yes
        ;;
      *) IFS=$'\t' read -r ssid security <<<"${networks[REPLY]}" ;;
    esac
    # The password goes in iwd's file for the network, not on iwctl's command
    # line, where any process could read it. --dont-ask fails the connection
    # rather than prompting where nobody sees it.
    if [[ $security != open ]]; then
      ui_ask ui_secret "Password for $ssid" || continue
      iwd_write_psk "$ssid" "$REPLY" "$hidden"
      iwd_wait_known "$ssid" || true
    fi
    if iwctl --dont-ask station "$dev" "$verb" "$ssid" >/dev/null 2>&1; then
      ui_note "Connected to $ssid, waiting for an address..."
      wait_online 20 && return 0
    elif [[ $security != open ]]; then
      # A refused password is not kept for iwd to try again by itself.
      rm -f -- "$IWD_DIR/$(iwd_name "$ssid").psk"
    fi
    problem="Could not connect to $ssid."
  done
}

# Online by cable already, or else Wi-Fi. A computer with no link at all
# (most laptops, the ThinkPad P1 among them, have no Ethernet port) goes
# straight to the networks, not after eight seconds of asking for an address
# that cannot come; a cable's link, which comes up a second or two after its
# driver, has three to show.
get_online() {
  local dev i
  screen Network
  ui_note "Checking the network..."
  for ((i = 0; i < 3; i++)); do
    has_link && break
    sleep 1
  done
  if has_link; then wait_online 8 && return 0; fi
  dev=$(wifi_device)
  if [[ -n $dev ]]; then
    connect_wifi "$dev"
    return
  fi
  ui_ask ui_confirm "No network. Plug in an Ethernet cable, then Yes; No goes on without one." || return 1
  wait_online 15
}

# WHERE: this computer's disk (install), or a USB disk plugged in beside the
# stick, to carry around (portable); asked only when there is such a disk.
# Returns 1 for Esc.
WHERE=install
where_nova_goes() {
  WHERE=install
  [[ -n $(nova-install --portable-disks 2>/dev/null) ]] || return 0
  screen Disk
  ui_ask ui_choose "Where does Nova go?" "" \
    "On this computer's disk"$'\t'install \
    "On the USB disk beside this stick, to start any PC from"$'\t'portable || return 1
  WHERE=$REPLY
}

# nova-install, onto this computer's disk or the USB disk (WHERE), and a
# restart. A try that stopped says where its log is; one stopped with Ctrl+C
# (130), or by a computer set so Nova cannot go on it (3, Secure Boot on, say),
# has said why already, and trying again as it is would not help.
run_install() {
  local status=0 restart="Take the stick out. Restart now?" stopped
  stopped=$'The install stopped. Its log is /var/log/nova-install.log.\nRun nova-install-start to try again.'
  if [[ $WHERE == portable ]]; then
    restart="Take this stick out and leave the new one in. Restart now?"
    stopped=$'Nova was not put on the USB disk. The log is /var/log/nova-install.log.\nRun nova-install-start to try again.'
    nova-install --portable || status=$?
  else
    nova-install || status=$?
  fi
  if ((status == 0)); then
    echo
    ui_ask ui_confirm "$restart" && systemctl reboot
  elif ((status != 130 && status != 3)); then
    echo
    ui_warn "$stopped"
  fi
}

main() {
  # A stick with an answers file installs with nobody there (tests/install/run):
  # no questions, the report on the console the file names, and the machine off
  # at the end, installed or not.
  local answers=${NOVA_ANSWERS:-$STICK/nova/answers} console keymap keymap_default
  if [[ -r $answers ]]; then
    console=$(sed -n 's/^console=//p' "$answers" | tail -n 1)
    [[ -z $console ]] || exec >>"$console" 2>&1
    if nova-install --answers "$answers"; then
      echo "nova-install-start: installed"
    else
      echo "nova-install-start: the install failed"
      tail -n 40 /var/log/nova-install.log
    fi
    systemctl poweroff
    exit 0
  fi

  # The console in Nova's colours and a font for the screen's size, for this
  # and every screen nova-install shows; its own colours back at the end.
  ui_console_begin
  trap ui_console_end EXIT

  # The keyboard first: the passphrase and the Wi-Fi password below are typed
  # on it. nova usb leaves the layout of the computer it ran on as the default.
  keymap_default=$(cat "$STICK/nova/keymap" 2>/dev/null) || keymap_default=us
  # A warning nova-install gives (a stick that will not open) stays on screen
  # past the next one's clearing.
  UI_NOTES=$(mktemp)
  export UI_NOTES
  keymap=$(nova-install --keymap "$keymap_default") || exit
  loadkeys "$keymap" >/dev/null 2>&1
  export NOVA_KEYMAP=$keymap

  # Things carried on the stick (nova usb) are opened first, while the
  # passphrase's layout is the one just picked.
  nova-install --unlock || (($? != 130)) || exit 130

  if ! get_online; then
    screen Network
    if ! offline_repo; then
      ui_note $'Nova installs over the network, so it needs a connection first.\nConnect by hand with iwctl, then run nova-install-start again.'
      exit 0
    fi
    ui_note $'Without a network, Nova installs from the stick. Chrome, VS Code, Claude\nCode and Codex need the network, so they come later: nova apps install.'
    echo >&2
    ui_ask ui_confirm "Install without a network?" || exit 0
  fi

  where_nova_goes || exit 0
  run_install
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
