#!/bin/bash
# The installed system's first boot, in tests/install/run: what a person would
# see, reported on the serial port, then the machine off. Each line starts
# "probe: ok", "probe: FAIL", or "probe:" for the record; "probe: done" ends
# the report.
set -uo pipefail

check() { # what command...: a failure is followed by the command's last lines
  local what=$1 out
  shift
  if out=$("$@" 2>&1); then
    echo "probe: ok   $what"
  else
    probe_failures=1
    echo "probe: FAIL $what"
    [[ -z $out ]] || tail -n 5 <<<"$out" | sed 's/^/probe:   /'
  fi
}

probe() {
  probe_failures=0
  user=$(awk -F: '$3 >= 1000 && $3 < 60000 { print $1; exit }' /etc/passwd)
  uid=$(id -u "$user")
  shell() { runuser -u "$user" -- env XDG_RUNTIME_DIR="/run/user/$uid" /usr/lib/nova/bin/nova-shell "$@" 2>/dev/null; }

  # The desktop starts behind the lock, here on software rendering: give it time.
  for ((i = 0; i < 300; i++)); do
    [[ $(shell lock state) == secure ]] && break
    sleep 1
  done
  check "the session started locked, and the lock is secure" test "$(shell lock state)" = secure
  check "Hyprland is running" pgrep -u "$user" -x Hyprland
  check "the shell answers" test "$(shell shell ping)" = ok
  check "greetd is running" systemctl is-active greetd
  check "the lock screen can count wrong passwords" test "$(stat -c %U "/run/faillock/$user" 2>/dev/null)" = "$user"
  # Nobody has unlocked yet: the welcome waits for the first unlock.
  check "the new account's welcome waits for its first unlock" \
    test "$(stat -c %U "/home/$user/.local/state/nova/welcome-pending" 2>/dev/null)" = "$user"

  # An encrypted install: the root came out of the LUKS2 container, as the
  # initramfs opened it.
  if [[ -e /etc/mkinitcpio.conf.d/20-nova-encrypt.conf ]]; then
    check "the root is on the encrypted disk" \
      bash -c '[[ $(findmnt -no SOURCE /) == /dev/mapper/nova-root* ]] && cryptsetup status nova-root | grep -q "type: *LUKS2"'
  fi

  failed=$(systemctl --failed --plain --no-legend | awk '{ print $1 }' | paste -sd' ')
  check "no failed services${failed:+ (failed: $failed)}" test -z "$failed"
  as_user() { runuser -u "$user" -- env XDG_RUNTIME_DIR="/run/user/$uid" "$@" 2>/dev/null; }
  failed=$(as_user DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" systemctl --user --failed --plain --no-legend |
    awk '{ print $1 }' | paste -sd' ')
  check "no failed services in the session${failed:+ (failed: $failed)}" test -z "$failed"
  # nova-sessiond: the lock before sleep holds logind's sleep back as a delay
  # inhibitor, and apps that keep the screen awake find the name they ask.
  check "nova-sessiond runs in the session" \
    as_user DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" systemctl --user is-active nova-sessiond.service
  check "a sleep waits for the session's lock" \
    bash -c 'systemd-inhibit --list --no-pager --no-legend | awk -v uid="$1" '\''$1 == "Nova" && $2 == uid && /sleep/ && / delay *$/ { found = 1 } END { exit !found }'\''' _ "$uid"
  check "apps can keep the screen awake (org.freedesktop.ScreenSaver)" \
    as_user DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" gdbus call --session --dest org.freedesktop.ScreenSaver \
    --object-path /org/freedesktop/ScreenSaver --method org.freedesktop.ScreenSaver.GetActive
  # Printing is Nova's own: Settings' Printers page asks CUPS through nova-printers (which this
  # check leaves to the page: asking CUPS would start it), and nothing of the applet it replaced
  # owns the name its udev rules called, or is installed.
  check "nova-printers says who may administer CUPS's printers" \
    bash -c '/usr/lib/nova/bin/nova-printers admin | jq -e ".groups | length > 0"'
  check "no printer applet is installed (system-config-printer)" \
    bash -c '! pacman -Q system-config-printer'
  check "ipp-usb is installed, for a USB printer to be driverless" pacman -Q ipp-usb

  # What starts at login is Nova's choice, not each package's
  # (data/systemd/install.mk): a package autostart Nova has not chosen is one
  # more program held all day. A fresh install has no autostart of its user's.
  autostarts=$(as_user DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" systemctl --user list-units \
    --plain --no-legend --state=active,activating 'app-*@autostart.service' | awk '{ print $1 }' | paste -sd' ')
  check "only what Nova chose starts at login${autostarts:+ (also: $autostarts)}" test -z "$autostarts"

  # Nova's memory at rest, as the session's processes hold it (each shared page
  # split among those that share it), against a budget, so that it stays light
  # without anyone watching for it. The budget is the session on the P1 after
  # the lean work of 2026-11-19 (about 360 MB at 3840x2400) with room for this
  # machine's software rendering; lower it to what the release runs report,
  # with a little room, once they have.
  budget=600
  session_kb=0
  for pid in $(pgrep -u "$user"); do
    kb=$(awk '/^Pss:/ { print $2 }' "/proc/$pid/smaps_rollup" 2>/dev/null) || continue
    session_kb=$((session_kb + ${kb:-0}))
  done
  used_kb=$(awk '/^MemTotal:/ { t = $2 } /^MemAvailable:/ { a = $2 } END { print t - a }' /proc/meminfo)
  echo "probe:      memory at rest: the session $((session_kb / 1024)) MB; the computer $((used_kb / 1024)) MB in use"
  pgrep -u "$user" | while read -r pid; do
    kb=$(awk '/^Pss:/ { print $2 }' "/proc/$pid/smaps_rollup" 2>/dev/null) || continue
    printf '%s %s\n' "$((${kb:-0} / 1024))" "$(cat "/proc/$pid/comm" 2>/dev/null)"
  done | sort -rn | head -n 8 | sed 's/ / MB /;s/^/probe:        /'
  check "the session at rest fits its memory budget ($((session_kb / 1024)) of $budget MB)" \
    test "$((session_kb / 1024))" -le "$budget"

  # Nova's programs are Rust or the shell: a Python one costs 15 to 20 MB
  # for each, where the Rust that replaced them takes 1. Read from /proc:
  # the probe is root, and the user's processes are the account's.
  nova_on_python() {
    local cmdline argv arg found=""
    for cmdline in /proc/[0-9]*/cmdline; do
      [[ $(stat -c %u "$cmdline" 2>/dev/null) == "$uid" ]] || continue
      mapfile -d '' -t argv <"$cmdline" 2>/dev/null || continue
      [[ ${argv[0]:-} == *python* ]] || continue
      for arg in "${argv[@]:1}"; do
        [[ $arg == /usr/lib/nova/* || $arg == /usr/share/nova/* || $arg == /usr/bin/nova* ]] && found+=" ${arg##*/}"
      done
    done
    [[ -z $found ]] || { echo "on Python:$found"; return 1; }
  }
  check "no program of Nova's runs on Python in the session" nova_on_python

  # A config error is a red banner across the top of the desktop. A clean config
  # reports one empty string.
  signature=$(find "/run/user/$uid/hypr" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | head -n 1)
  config=$(as_user HYPRLAND_INSTANCE_SIGNATURE="$signature" hyprctl configerrors -j)
  errors=$(jq -r '.[] | select(. != "")' <<<"$config" 2>/dev/null | paste -sd';' -)
  check "Hyprland's config has no errors${errors:+ ($errors)}" jq -e 'map(select(. != "")) == []' <<<"$config"
  # A Flatpak app keeps a password or a sign-in through the Secret portal,
  # which the session offers only as Nova's portals config routes it.
  # An app that plays sound or video through GStreamer plays the common
  # formats: MP4 and Matroska, H.264, AAC, Opus and MP3.
  check "GStreamer plays the common formats" \
    bash -c 'for element in qtdemux matroskademux avdec_h264 avdec_aac opusdec mpg123audiodec; do
      gst-inspect-1.0 --exists "$element" || { echo "no $element"; exit 1; }
    done'
  check "the desktop portals offer Flatpak apps a place for secrets" \
    as_user DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" gdbus call --session --dest org.freedesktop.portal.Desktop \
    --object-path /org/freedesktop/portal/desktop --method org.freedesktop.DBus.Properties.Get org.freedesktop.portal.Secret version

  # What nova update will ask pacman for, with /etc/pacman.conf's options. The
  # release's own [nova] repository is not published yet, so only the pinned Arch
  # snapshot is asked, once the network is up.
  pinned_mirror() {
    local dir
    nm-online -q --timeout=60 || echo "the network did not come up within a minute"
    dir=$(mktemp -d)
    printf '[options]\nArchitecture = auto\nSigLevel = Required DatabaseOptional\nDBPath = %s\n\n[core]\nInclude = /etc/pacman.d/nova-mirrorlist\n' "$dir" >"$dir/pacman.conf"
    pacman --config "$dir/pacman.conf" --logfile /dev/null -Sy
  }
  check "the pinned Arch snapshot answers, for nova update" pinned_mirror
  doctor=$(nova doctor 2>&1)
  status=$?
  sed 's/^/probe:   /' <<<"$doctor"
  check "nova doctor finds nothing wrong" test "$status" = 0
  echo "probe: $(systemd-analyze 2>/dev/null | head -n 1)"
  # A failure explained by what the session said, kept in the run's logs:
  # its journal for this boot from the start, where a start that hangs shows
  # (a session the guard ended pushes it out of the last lines), and the
  # system's units it leans on, to their end.
  if ((probe_failures)); then
    echo "probe: the session's journal, this boot, from its start:"
    journalctl -b --no-pager -o short-monotonic _UID="$uid" 2>&1 | head -n 400 | sed 's/^/probe:   /'
    echo "probe: greetd, logind and the user's service manager, this boot:"
    journalctl -b --no-pager -o short-monotonic -n 60 -u greetd -u systemd-logind -u "user@$uid.service" 2>&1 |
      sed 's/^/probe:   /'
  fi
  return "$probe_failures"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  exec >/dev/ttyS0 2>&1
  probe || true
  echo "probe: done"
  systemctl poweroff
fi
