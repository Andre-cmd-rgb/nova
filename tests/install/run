#!/bin/bash
# Installs a release from its ISO in a QEMU virtual machine, as a stick made by
# nova usb would, then boots what was installed and checks it.
#
#   tests/install/run --iso <file> [--logs <dir>] [--encrypt] [--nvme]
#
#   tests/install/run --upgrade --repo <dir> --release <release.toml> [--logs <dir>] [--nvme]
#
# --upgrade installs the newest published release older than --release, from
# its signed ISO and its own packages. Four boots check it, update to --release,
# downgrade, and restore the pre-update root snapshot. It needs python and
# openssl too, for the guest's HTTPS repository (upgrade-lib).
#
# --encrypt installs onto an encrypted disk (encrypt=yes), opened at the first
# boot by a key file the test leaves in the initramfs (tests/install/after-encrypted).
#
# --nvme puts the disk on an NVMe controller, as most laptops have it: the
# installer is told /dev/nvme0n1, whose partitions are nvme0n1p1 and p2,
# rather than virtio's /dev/vda.
#
# The stick is a disk image laid out the way nova usb lays one out: a FAT
# partition with the ISO's files, every package an install can need among
# them (nova/repo). A release from before the ISO carried them (1.0.0-rc.11
# and older, which the upgrade test can start from) gets them put beside, from
# its own package list, as nova usb did then. An answers file on it (nova-install
# --answers) installs onto a blank 80 GB disk with no questions; the probe its
# after= script leaves behind reports on the first boot (tests/install/probe).
# Both runs log to the serial port; --logs keeps the logs.
#
# Hyprland needs a GL driver in the guest, so the machine has a virgl GPU, which
# QEMU draws with Mesa's software renderer in a hidden X server: no GPU is
# needed, and none is touched.
#
# Needs /dev/kvm, qemu with its GTK and OpenGL display and the virtio-vga-gl
# device, virglrenderer, Xvfb, edk2-ovmf, mtools, dosfstools, libarchive, and
# about 15 GB of disk under $TMPDIR (/var/tmp if unset). release.yml runs it
# before anything is published.
set -euo pipefail

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
root=$(cd -- "$here/../.." && pwd)
# fetch_release_files, signed_by_nova and release_value: nova usb's own.
# shellcheck source=installer/nova-usb
source "$root/installer/nova-usb"

die() { printf 'install-test: %s\n' "$*" >&2; exit 1; }
step() { printf '\n== %s\n' "$*"; }

iso='' repo='' release='' logs='' encrypt=0 upgrade=0 nvme=0
while (($#)); do
  case $1 in
    --iso) iso=${2:?}; shift 2 ;;
    --repo) repo=${2:?}; shift 2 ;;
    --release) release=${2:?}; shift 2 ;;
    --logs) logs=${2:?}; shift 2 ;;
    --encrypt) encrypt=1; shift ;;
    --nvme) nvme=1; shift ;;
    --upgrade) upgrade=1; shift ;;
    -h | --help) sed -n '2,/^set /p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown argument: $1 (try --help)" ;;
  esac
done
if ((upgrade)); then
  [[ -r $repo/nova.db && -r $release ]] || die "--upgrade needs --repo <dir> and --release <release.toml>"
  repo=$(realpath -- "$repo")
fi
# The disk the install goes onto, as the installer names it and as QEMU
# attaches it. QEMU's NVMe controller needs a serial number.
if ((nvme)); then
  install_disk=/dev/nvme0n1 disk_device=nvme,drive=disk,serial=nova-test,bootindex=1
else
  install_disk=/dev/vda disk_device=virtio-blk-pci,drive=disk,bootindex=1
fi

MiB=$((1024 * 1024))
work=$(mktemp -d "${TMPDIR:-/var/tmp}/nova-install-test.XXXXXX")
keep() { [[ -z $logs ]] || { mkdir -p "$logs" && cp -- "$work"/*.log "$logs/"; } 2>/dev/null || true; }
xvfb='' repo_pid=''
cleanup() {
  [[ -z $xvfb ]] || kill "$xvfb" 2>/dev/null || true
  [[ -z $repo_pid ]] || kill "$repo_pid" 2>/dev/null || true
  keep
  rm -rf -- "$work"
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT

if ((upgrade)); then
  ((!encrypt)) || die "--upgrade uses the plain disk; encryption is tested by install-test"
  # shellcheck source=tests/install/upgrade-lib
  source "$here/upgrade-lib"
  step "The previous published release, candidates included"
  published_releases "$work/releases.json" || die "could not read the published releases"
  tag=v$(release_value "$release" version)
  rc=0
  previous=$(previous_release "$tag" <"$work/releases.json") || rc=$?
  if ((rc == 4)); then
    echo "::notice::No published Nova release older than $tag; skipping the upgrade test."
    exit 0
  fi
  ((rc == 0)) || die "could not select the previous release"
  # The bucket keeps the newest releases alone: run again once it is no longer
  # the newest, a release finds the one before it gone.
  previous_toml=$(asset_url "$previous" release.toml)
  if [[ -n $previous_toml ]] && curl -fsSL --retry 3 -o "$work/previous-release.toml" "$previous_toml" &&
    [[ $(curl -sS -I -o /dev/null -w '%{http_code}' --max-time 30 \
      "$(release_value "$work/previous-release.toml" nova_repo)/nova.db" || true) == 404 ]]; then
    echo "::notice::$(jq -r .tag_name <<<"$previous") is no longer in the package bucket, which keeps the newest releases alone; skipping the upgrade test."
    exit 0
  fi
  CACHE=$work/download
  iso=$(fetch_release_files "$previous")
  previous_dir=${iso%/*}
  [[ v$(release_value "$previous_dir/release.toml" version) == "$(jq -r .tag_name <<<"$previous")" ]] || die "previous manifest and release disagree"
  cp "$previous_dir/release.toml" "$work/previous.toml"
  start_upgrade_repo "$work" "$repo" || die "the HTTPS repository did not start"
  sed "s@^nova_repo = .*@nova_repo = \"$upgrade_repo\"@" "$release" >"$work/candidate.toml"
  release=$previous_dir/release.toml
fi
[[ -r $iso ]] || die "needs --iso <file> (or --upgrade)"
for tool in qemu-system-x86_64 Xvfb mcopy mkfs.fat sfdisk bsdtar curl; do
  command -v "$tool" >/dev/null || die "needs $tool"
done
[[ -r /dev/kvm && -w /dev/kvm ]] || die "needs /dev/kvm"
ovmf=/usr/share/edk2/x64
[[ -r $ovmf/OVMF_CODE.4m.fd ]] || die "needs edk2-ovmf"
stick=$work/stick
mkdir -p "$stick"

step "The stick: the ISO's files"
bsdtar -xf "$iso" -C "$stick"
chmod -R u+w "$stick"
entry=$stick/loader/entries/01-nova.conf
[[ -f $entry ]] || die "the ISO keeps no boot entries among its files, so a stick copied from it cannot boot"
sed -i '/^options/ s/$/ console=ttyS0,115200/' "$entry"

if [[ ! -r $stick/nova/repo/nova-offline.db ]]; then
  ((upgrade)) || die "the ISO carries no packages (nova/repo/nova-offline.db)"
  # The release before is from when the ISO did not carry its packages: they
  # go beside its files, from its own signed list, as nova usb put them then.
  step "The stick: every package an install can need"
  previous_repo=$(release_value "$release" nova_repo)
  curl -fsSL --retry 3 -o "$work/packages.txt" "$previous_repo/packages.txt" &&
    curl -fsSL --retry 3 -o "$work/packages.txt.sig" "$previous_repo/packages.txt.sig" ||
    die "could not download the previous release's package list"
  signed_by_nova "$work/packages.txt" || die "the previous release's package list is not signed by Nova's key"
  "$root/tools/offline-repo" --release "$release" --packages "$work/packages.txt" "$stick/nova/repo" ||
    die "could not put the previous release's packages on the stick"
fi

step "The stick: answers, so nobody has to be there"
cat >"$stick/nova/answers" <<ANSWERS
console=/dev/ttyS0
keymap=us
disk=$install_disk
fullname=Nova Test
user=nova
password=nova-install-test
hostname=nova-test
timezone=UTC
apps=no
erase=yes
after=after
ANSWERS
((!encrypt)) || printf 'encrypt=yes\ndisk_passphrase=nova-disk-test\n' >>"$stick/nova/answers"
{
  cat "$here/after"
  ((!encrypt)) || cat "$here/after-encrypted"
  printf "\ninstall -Dm755 /dev/stdin /usr/local/lib/nova-test-probe <<'PROBE'\n"
  cat "$here/probe"
  printf 'PROBE\n'
  ((!upgrade)) || upgrade_after "$work"
} >"$stick/nova/after"

step "The stick: a FAT partition, as nova usb writes one"
size_mib=$(($(du -sm "$stick" | cut -f1) * 11 / 10 + 256))
mkfs.fat -F 32 -n NOVA -C "$work/fat.img" $((size_mib * 1024)) >/dev/null
(cd "$stick" && MTOOLS_SKIP_CHECK=1 mcopy -s -i "$work/fat.img" ./* ::/)
rm -rf -- "$stick"
truncate -s $(((size_mib + 2) * MiB)) "$work/stick.img"
printf 'label: gpt\nstart=2048, size=%d, type=uefi, name="NOVA"\n' $((size_mib * 2048)) | sfdisk -q "$work/stick.img"
dd if="$work/fat.img" of="$work/stick.img" bs=1M seek=1 conv=notrunc,sparse status=none
rm -f -- "$work/fat.img"

# A display nothing uses, named outright: Xvfb -displayfd takes the first one
# whose socket it can bind, unlinking a running Xwayland's on the way.
display=''
for ((n = 90; n < 200; n++)); do
  [[ -e /tmp/.X$n-lock || -e /tmp/.X11-unix/X$n ]] || { display=$n; break; }
done
[[ -n $display ]] || die "no free X display between :90 and :199"
Xvfb ":$display" -screen 0 1280x800x24 -nolisten tcp >"$work/xvfb.log" 2>&1 &
xvfb=$!
for ((i = 0; i < 100; i++)); do [[ -S /tmp/.X11-unix/X$display ]] && break; sleep 0.1; done
[[ -S /tmp/.X11-unix/X$display ]] || die "Xvfb did not start; the log is xvfb.log"
display=:$display

# One machine for every run, the same firmware variables included. The network
# card has no boot ROM, so the firmware goes straight to the disks.
cp "$ovmf/OVMF_VARS.4m.fd" "$work/vars.fd"
truncate -s 80G "$work/disk.img"
machine() { # minutes serial-log [qemu options...]
  local minutes=$1 log=$2
  shift 2
  timeout "${minutes}m" env -u WAYLAND_DISPLAY DISPLAY="$display" GDK_BACKEND=x11 NO_AT_BRIDGE=1 LIBGL_ALWAYS_SOFTWARE=1 \
    qemu-system-x86_64 -machine q35,accel=kvm -cpu host -smp 4 -m 4096 \
    -drive if=pflash,format=raw,unit=0,readonly=on,file="$ovmf/OVMF_CODE.4m.fd" \
    -drive if=pflash,format=raw,unit=1,file="$work/vars.fd" \
    -drive file="$work/disk.img",format=raw,if=none,id=disk,cache=unsafe -device "$disk_device" \
    -netdev user,id=net -device virtio-net-pci,netdev=net,romfile= \
    -device virtio-vga-gl -display gtk,gl=on -serial file:"$log" -no-reboot "$@"
}

step "Installing from the stick"
started=$SECONDS
machine 45 "$work/install.log" -device qemu-xhci \
  -drive file="$work/stick.img",format=raw,if=none,id=stick,cache=unsafe -device usb-storage,drive=stick,bootindex=0 ||
  die "the install machine did not power off by itself within 45 minutes; the log is install.log"
grep -aq 'nova-install-start: installed' "$work/install.log" ||
  { tr -d '\r' <"$work/install.log" | tail -n 60; die "the install failed"; }
echo "installed in $(((SECONDS - started) / 60)) min"
rm -f -- "$work/stick.img"

report_boot() { # log expected-completion; cursor codes can precede the first line
  local log=$1 completion=$2 report
  report=$(tr -d '\r' <"$log" | grep -ao 'probe:.*' || true)
  printf '%s\n' "$report"
  grep -q "^probe: done$completion" <<<"$report" || die "the probe did not finish"
  ! grep -q '^probe: FAIL' <<<"$report" || die "the installed system has problems (above)"
}

if ((upgrade)); then
  # One install, four boots, with a separate deadline and serial log for each.
  # Powering off between them gives QEMU a reboot boundary without needing
  # an unreliable serial-console login.
  for stage in previous upgraded downgraded restored; do
    case $stage in previous|upgraded) minutes=30 ;; *) minutes=15 ;; esac
    step "Upgrade test: $stage"
    machine "$minutes" "$work/$stage.log" || die "$stage did not power off within $minutes minutes"
    report_boot "$work/$stage.log" " $stage"
  done
  echo 'ok   installed the previous release, upgraded, downgraded, and booted its pre-update snapshot as the root'
else
  step "The first boot"
  machine 20 "$work/boot.log" || die "the installed system did not power off by itself within 20 minutes; the log is boot.log"
  report_boot "$work/boot.log" ''
  echo
  echo "ok   installed from the stick$( ((encrypt)) && echo " onto an encrypted disk")$( ((nvme)) && echo " on NVMe"), booted locked, and nova doctor is content"
fi
