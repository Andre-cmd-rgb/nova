#!/usr/bin/python3
# secret-tool, for nova-calendar-sync's tests: store, lookup and clear, the
# secrets kept in the JSON file $NOVA_TEST_SECRETS by their attributes, and
# never in the login keyring of the computer the tests run on.
import json
import os
import sys

path = os.environ["NOVA_TEST_SECRETS"]
args = sys.argv[1:]
command = args.pop(0) if args else ""
if command == "store" and args[:1] == ["--label"]:
    args = args[2:]
key = json.dumps(dict(zip(args[::2], args[1::2])), sort_keys=True)
try:
    with open(path) as f:
        secrets = json.load(f)
except FileNotFoundError:
    secrets = {}
if command == "store":
    secrets[key] = sys.stdin.read()
elif command == "lookup":
    if key not in secrets:
        sys.exit(1)
    sys.stdout.write(secrets[key])
    sys.exit(0)
elif command == "clear":
    secrets.pop(key, None)
else:
    sys.exit(2)
with open(path, "w") as f:
    json.dump(secrets, f)
