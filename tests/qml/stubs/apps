#!/bin/sh
# The App Center's helpers, as the store's window test needs them, by the
# name each is called by:
#   nova-apps-catalog    a list of seven apps in brief, made in $HOME with the
#                        page of one of them (GIMP's, whose Krita's is not
#                        there), the list's path
#   nova-apps-installed  $HOME/installed.json, or Firefox from Arch and foot,
#                        part of Nova
#   nova-apps-run        noted in $HOME/stub-calls, as `record` notes a
#                        call; an install from Flathub then says it is
#                        under way in status.json, and a moment later done,
#                        with the app installed
#   nova-apps-refresh, nova-apps-shots, nova-apps-size: nothing to say
name=$(basename "$0")
case $name in
  nova-apps-catalog)
    # What `--list` prints: the apps in brief, and the folder of the pages.
    # Krita's page is not there, as when one cannot be read.
    mkdir -p "$HOME/pages"
    cat >"$HOME/pages/org.gimp.GIMP.json" <<'EOF'
{"id":"org.gimp.GIMP","name":"GIMP","summary":"Create images and edit photographs","developer":"The GIMP team","category":"create","keywords":"photoshop paint","license":"GPL-3.0+ AND LGPL-3.0+","homepage":"https://www.gimp.org/","description":["GIMP edits pictures.","• Layers"],"shots":[{"url":"https://dl.flathub.org/media/gimp.png"}],
 "sources":[{"kind":"arch","package":"gimp","repo":"extra","version":"3.0.4-1"},{"kind":"flathub","app":"org.gimp.GIMP","ref":"app/org.gimp.GIMP/x86_64/stable","version":"3.0.4","download":100000000,"installed":300000000,"runtime":"org.gnome.Platform/x86_64/48","verified":true}],
 "featured":"create","position":0,"rank":1085,
 "runtimes":{"org.gnome.Platform/x86_64/48":{"download":300000000,"installed":900000000}}}
EOF
    cat >"$HOME/list.json" <<EOF
{"format":1,"built":1,"flathub":true,"arch":true,"pages":"$HOME/pages",
 "apps":[
  {"id":"org.gimp.GIMP","name":"GIMP","summary":"Create images and edit photographs","category":"create","keywords":"photoshop paint","page":"org.gimp.GIMP.json",
   "sources":[{"kind":"arch","package":"gimp"},{"kind":"flathub","app":"org.gimp.GIMP"}],
   "featured":"create","position":0,"rank":1085},
  {"id":"org.inkscape.Inkscape","name":"Inkscape","summary":"Vector graphics editor","category":"create","page":"org.inkscape.Inkscape.json",
   "sources":[{"kind":"flathub","app":"org.inkscape.Inkscape"}],
   "featured":"create","position":1,"rank":1020},
  {"id":"org.kde.krita","name":"Krita","summary":"Digital painting","category":"create","keywords":"paint","page":"org.kde.krita.json",
   "sources":[{"kind":"flathub","app":"org.kde.krita"}],
   "rank":40},
  {"id":"com.google.Chrome","name":"Google Chrome","summary":"The browser built by Google","category":"internet","desktop":"google-chrome.desktop","iconName":"google-chrome","page":"com.google.Chrome.json",
   "sources":[{"kind":"nova","package":"google-chrome"}],
   "featured":"internet","position":0,"popular":1,"rank":1060},
  {"id":"org.mozilla.firefox","name":"Firefox","summary":"Fast, private and safe web browser","category":"internet","desktop":"firefox.desktop","page":"org.mozilla.firefox.json",
   "sources":[{"kind":"arch","package":"firefox","desktop":"firefox.desktop"},{"kind":"flathub","app":"org.mozilla.firefox"}],
   "featured":"internet","position":1,"rank":1065},
  {"id":"com.valvesoftware.Steam","name":"Steam","summary":"Launcher for the Steam software distribution service","category":"play","page":"com.valvesoftware.Steam.json",
   "sources":[{"kind":"flathub","app":"com.valvesoftware.Steam"}],
   "featured":"play","position":0,"popular":2,"rank":1000},
  {"id":"foot","name":"Foot","summary":"Fast, lightweight and minimalistic Wayland terminal emulator","category":"utilities","desktop":"foot.desktop","page":"foot.json",
   "sources":[{"kind":"arch","package":"foot","desktop":"foot.desktop"}],
   "rank":25}
 ]}
EOF
    echo "$HOME/list.json"
    ;;
  nova-apps-installed)
    if [ -f "$HOME/installed.json" ]; then
      cat "$HOME/installed.json"
    else
      echo '{"flatpak":[],"runtimes":[],"pacman":{"firefox":"145.0-1","foot":"1.24.0-1"},"explicit":["firefox"],"nova":["foot"]}'
    fi
    ;;
  nova-apps-run)
    printf '%s' "$name" >>"$HOME/stub-calls"
    for word in "$@"; do printf ' %s' "$word" >>"$HOME/stub-calls"; done
    printf '\n' >>"$HOME/stub-calls"
    if [ "$1 $3 $4" = "install --from flathub" ]; then
      dir=$XDG_RUNTIME_DIR/nova/apps
      mkdir -p "$dir"
      now=$(date +%s)
      printf '{"%s":{"action":"install","source":"flathub","state":"running","progress":40,"text":"Downloading","error":"","time":%s}}\n' "$2" "$now" >"$dir/status.json.part"
      mv -f "$dir/status.json.part" "$dir/status.json"
      (
        sleep 1
        printf '{"flatpak":[{"app":"%s","installation":"user","version":"3.0.4"}],"runtimes":["org.gnome.Platform/x86_64/48"],"pacman":{"firefox":"145.0-1","foot":"1.24.0-1"},"explicit":["firefox"],"nova":["foot"]}\n' "$2" >"$HOME/installed.json"
        printf '{"%s":{"action":"install","source":"flathub","state":"done","progress":100,"text":"","error":"","time":%s}}\n' "$2" "$(date +%s)" >"$dir/status.json.part"
        mv -f "$dir/status.json.part" "$dir/status.json"
      ) >/dev/null 2>&1 &
    fi
    ;;
  nova-apps-size) echo "0 0" ;;
  *) ;;
esac
exit 0
