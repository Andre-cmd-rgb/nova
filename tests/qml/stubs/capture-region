#!/bin/sh
# nova-capture-region as the shell's picker asks it: --layout gives a
# 1280x720 screen with a 400x300 window at 100,100 and a 200x200 one at
# 600,100; anything else is noted in $HOME/stub-calls, as `record` notes one.
if [ "$1" = --layout ]; then
  printf '%s\n' "focused 0,0 1280x720" "monitor 0,0 1280x720" "window 100,100 400x300" "window 600,100 200x200"
  exit 0
fi
printf 'nova-capture-region %s\n' "$*" >>"$HOME/stub-calls"
