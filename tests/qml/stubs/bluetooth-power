#!/bin/sh
# nova-bluetooth-power as BluetoothPower asks it: the call noted in
# $HOME/stub-calls, as `record` notes one, and done with the exit code in
# $HOME/bluetooth-power-exit, 0 without one.
printf 'nova-bluetooth-power %s\n' "$*" >>"$HOME/stub-calls"
exit "$(cat "$HOME/bluetooth-power-exit" 2>/dev/null || echo 0)"
