#!/bin/sh
# vipsthumbnail as AirDrop asks it for a smaller copy of a photo: the call
# noted in $HOME/stub-calls, as `record` notes one, with whether untrusted
# loaders are blocked, and the copy made, empty, where -o says, unless
# $HOME/thumbnails-fail is there.
printf 'vipsthumbnail VIPS_BLOCK_UNTRUSTED=%s' "${VIPS_BLOCK_UNTRUSTED:-}" >>"$HOME/stub-calls"
for word in "$@"; do printf ' %s' "$word" >>"$HOME/stub-calls"; done
printf '\n' >>"$HOME/stub-calls"
# A photo with "slow" in its name takes a second.
case $1 in *slow*) sleep 1 ;; esac
[ ! -e "$HOME/thumbnails-fail" ] || exit 1
while [ $# -gt 0 ]; do
  if [ "$1" = -o ]; then
    : >"${2%\[*}"
  fi
  shift
done
