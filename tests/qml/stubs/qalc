#!/bin/sh
# qalc, for the menu's sums and the Calculator: notes each run, a line a run,
# in $HOME/qalc-calls (the expression, its locale and where qalc may write),
# and answers a few as qalc 5 does, sin(30) in the angle unit it is set to;
# anything else as a word it does not know. The expression is the last word,
# after qalc's options.
angle=rad
for word; do
  [ "$word" = "angle deg" ] && angle=deg
  last=$word
done
printf '%s|%s|%s\n' "$last" "$LC_ALL" "$QALCULATE_USER_DIR" >>"$HOME/qalc-calls"
case $last in
  "2*(3+4)" | "2×(3+4)") echo "2 × (3 + 4) = 14" ;;
  "12*3") echo "12 × 3 = 36" ;;
  "2+3") echo "2 + 3 = 5" ;;
  "5+3") echo "5 + 3 = 8" ;;
  "5 km to -miles") echo "5 kilometers ≈ 3.106855961 mi" ;;
  " -5 - 2") echo "(−5) − 2 = −7" ;;
  "log10(100)") echo "log10(100) = 2" ;;
  "1÷0") printf 'warning: Division by zero.\n1 / 0 = 1 / 0\n' ;;
  "sin(30)")
    if [ $angle = deg ]; then echo "sin(30 degrees) = 1/2 = 0.5"; else echo "sin(30 radians) ≈ −0.9880316241"; fi
    ;;
  *)
    echo "error: \"$last\" is not a valid variable/function/unit."
    echo "0 = 0"
    ;;
esac
