#!/bin/sh
# systemctl as Settings asks it whether a user service runs: `is-active`
# prints what $HOME/systemctl-active says (active, activating, failed, ...),
# and succeeds for active alone, as systemctl does; each call is noted in
# $HOME/stub-calls. Anything else does nothing.
printf 'systemctl' >>"$HOME/stub-calls"
for word in "$@"; do printf ' %s' "$word" >>"$HOME/stub-calls"; done
printf '\n' >>"$HOME/stub-calls"
case " $* " in
  *" is-active "*)
    state=$(cat "$HOME/systemctl-active" 2>/dev/null || echo inactive)
    case " $* " in *" --quiet "*) ;; *) echo "$state" ;; esac
    [ "$state" = active ] ;;
  *) exit 0 ;;
esac
