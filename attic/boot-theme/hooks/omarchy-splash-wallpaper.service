[Unit]
Description=Re-theme the boot splash from the current Omarchy wallpaper
Documentation=https://github.com/omarchy-plugins/omarchy-boot-theme
# It writes the initramfs to the ESP. [Unit], not [Service] — systemd ignores
# this key in [Service] and says so in the journal.
RequiresMountsFor=/boot

[Service]
Type=oneshot
# systemd's default start timeout is 90 seconds, and a limine-mkinitcpio run is
# about that — so the default would SIGTERM the rebuild partway through writing
# the initramfs this machine boots from.
TimeoutStartSec=1800
# Triggered by picking a wallpaper, and it spends about a minute in mkinitcpio.
# Nobody asked for their desktop to get slower because of a boot screen.
Nice=10
IOSchedulingClass=idle
# /usr/local/bin, not the user's ~/.local/bin: this runs as root, and a root
# unit that executes a user-writable file hands root to anything running as
# that user.
ExecStart=@SPLASH_CMD@ --home "@USER_HOME@"
