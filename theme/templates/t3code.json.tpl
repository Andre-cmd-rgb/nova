{
  "version": 1,
  "name": "Nova",
  "appearance": "{{ mode }}",
  "canvas": "{{ background }}",
  "accent": "{{ accent }}",
  "colors": {
    "canvas": "{{ background }}",
    "chrome": "{{ background }}",
    "text": "{{ foreground }}",
    "textMuted": "{{ legible light_foreground background 5 }}",
    "border": "{{ mix background foreground 14% }}",
    "input": "{{ mix background foreground 20% }}",
    "focus": "{{ legible accent background 3.5 }}",

    "toolbar": "{{ background }}",
    "toolbarForeground": "{{ foreground }}",
    "toolbarBorder": "{{ mix background foreground 12% }}",
    "toolbarControl": "{{ mix background foreground 6% }}",
    "toolbarControlForeground": "{{ foreground }}",
    "toolbarControlHover": "{{ mix background foreground 12% }}",

    "surface": "{{ mix background foreground 3% }}",
    "surfaceRaised": "{{ mix background foreground 5% }}",
    "surfaceOverlay": "{{ mix background foreground 4% }}",

    "accent": "{{ accent }}",
    "accentForeground": "{{ legible background accent 4.5 }}",
    "accentSurface": "{{ mix background accent 10% }}",
    "accentSurfaceForeground": "{{ foreground }}",
    "secondary": "{{ mix background foreground 8% }}",
    "secondaryForeground": "{{ foreground }}",
    "muted": "{{ mix background foreground 5% }}",
    "mutedForeground": "{{ legible light_foreground background 5 }}",
    "placeholder": "{{ legible muted background 5.3 }}",
    "secondaryLabel": "{{ legible light_foreground background 5 }}",
    "iconMuted": "{{ legible muted background 3.5 }}",

    "error": "{{ legible red background 3.5 }}",
    "errorForeground": "{{ legible red background 5.5 }}",
    "errorSurface": "{{ mix background red 12% }}",
    "warning": "{{ legible yellow background 3.5 }}",
    "warningForeground": "{{ legible yellow background 5.5 }}",
    "warningSurface": "{{ mix background yellow 12% }}",
    "update": "{{ legible accent background 3.5 }}",
    "updateForeground": "{{ legible accent background 5.5 }}",
    "updateSurface": "{{ mix background accent 12% }}",

    "messageSurface": "{{ mix background foreground 7% }}",
    "messageForeground": "{{ foreground }}",
    "messageAction": "{{ accent }}",
    "messageActionForeground": "{{ legible background accent 5 }}",
    "messageActionHover": "{{ mix accent foreground 10% }}",

    "codeBackground": "{{ dark_background }}",
    "codeForeground": "{{ foreground }}",

    "searchMatchBackground": "{{ mix background yellow 20% }}",
    "searchMatchForeground": "{{ foreground }}",
    "searchMatchActiveBackground": "{{ yellow }}",
    "searchMatchActiveForeground": "{{ legible background yellow 4.5 }}",

    "sidebar": "{{ dark_background }}",
    "sidebarForeground": "{{ foreground }}",
    "sidebarMutedForeground": "{{ legible muted dark_background 5.3 }}",
    "sidebarControlSurface": "{{ mix dark_background foreground 6% }}",
    "sidebarBorder": "{{ mix dark_background foreground 12% }}",
    "sidebarRowHover": "{{ mix dark_background foreground 5% }}",
    "sidebarRowActive": "{{ mix dark_background accent 12% }}",
    "sidebarRowSelected": "{{ mix dark_background foreground 10% }}",

    "terminalBackground": "{{ background }}",
    "terminalForeground": "{{ foreground }}",
    "terminalCursor": "{{ cursor }}",
    "terminalSelection": "{{ mix selection_background background 55% }}",
    "terminalScrollbar": "{{ mix background foreground 15% }}",
    "terminalScrollbarHover": "{{ mix background foreground 30% }}"
  }
}
