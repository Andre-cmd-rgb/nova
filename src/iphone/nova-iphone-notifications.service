[Unit]
Description=Your iPhone's notifications on this computer
Documentation=https://github.com/Andre-cmd-rgb/nova/blob/main/docs/iphone.md
# The notifications go to the session's shell, so it lasts as long as the
# session does.
PartOf=graphical-session.target
After=graphical-session.target
ConditionPathIsDirectory=/sys/class/bluetooth

[Service]
# Ready once it owns its name, which `nova notification iphone on` then calls.
Type=dbus
BusName=org.nova.iPhoneNotifications
ExecStart=/usr/lib/nova/nova-iphone-notifications
# Its state goes with it however it ends, a crash too, so that Settings never
# reads an iPhone connected from a run that is over.
ExecStopPost=-/usr/bin/rm -f %t/nova/iphone-notifications.json
Restart=on-failure
RestartSec=5
# 3: its bus name is another program's, which starting again would not change.
RestartPreventExitStatus=3
Slice=background.slice

# It talks to BlueZ and to the shell over D-Bus, through the buses' sockets
# in the file system, reads /etc/bluetooth/main.conf, and writes in the
# runtime folder its state file and, for the pairing question's buttons, a
# file of commands in nova/notifications/ (the shell's
# plugins/notifications/README.md); nothing else is its business.
RuntimeDirectory=nova
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateNetwork=yes
CapabilityBoundingSet=
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=graphical-session.target
