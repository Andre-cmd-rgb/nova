# ---------------------------------------------------------------- ANCS
#
# As Apple's specification has it: the service and its three
# characteristics, the Notification Source's events, the Control Point's
# commands and the Data Source's answers.

ANCS_SERVICE = "7905f431-b5ce-4e99-a40f-4b1e122d00d0"
NOTIFICATION_SOURCE = "9fbf120d-6301-42d9-8c58-25e699a21dbd"
CONTROL_POINT = "69d1d8f3-45e1-49a8-9821-9bbdfdaad9d9"
DATA_SOURCE = "22eac6e9-24d6-4bb5-be44-b36ace7c7bfb"

# EventID
ADDED, MODIFIED, REMOVED = 0, 1, 2
# EventFlags
SILENT, IMPORTANT, PRE_EXISTING, POSITIVE_ACTION, NEGATIVE_ACTION = 1, 2, 4, 8, 16
# CategoryID
(OTHER, INCOMING_CALL, MISSED_CALL, VOICEMAIL, SOCIAL, SCHEDULE, EMAIL, NEWS,
 HEALTH_AND_FITNESS, BUSINESS_AND_FINANCE, LOCATION, ENTERTAINMENT) = range(12)
# CommandID
GET_NOTIFICATION_ATTRIBUTES, GET_APP_ATTRIBUTES, PERFORM_NOTIFICATION_ACTION = 0, 1, 2
# NotificationAttributeID
APP_IDENTIFIER, TITLE, SUBTITLE, MESSAGE, MESSAGE_SIZE, DATE = 0, 1, 2, 3, 4, 5
# AppAttributeID
DISPLAY_NAME = 0
# ActionID
POSITIVE, NEGATIVE = 0, 1

# The most of each text asked for, in bytes: a toast shows two lines of title
# and three of message, and every byte asked for crosses the radio.
LIMITS = {TITLE: 128, SUBTITLE: 128, MESSAGE: 320}

# A glyph for each category, as the iPhone's apps have no icon here.
GLYPHS = {
    MISSED_CALL: "\U000F03FA", VOICEMAIL: "\U000F057D", SOCIAL: "\U000F0369",
    SCHEDULE: "\U000F00ED", EMAIL: "\U000F01EE", NEWS: "\U000F0395",
    HEALTH_AND_FITNESS: "\U000F05F6", BUSINESS_AND_FINANCE: "\U000F0114",
    LOCATION: "\U000F034E", ENTERTAINMENT: "\U000F0ECF",
}
PHONE_GLYPH = "\U000F011C"
BLUETOOTH_GLYPH = "\U000F00AF"

Event = namedtuple("Event", "kind flags category count uid")


def parse_event(value):
    """A Notification Source event, from its eight bytes, or None."""
    data = bytes(value)
    if len(data) != 8:
        return None
    event = Event(*struct.unpack("<BBBBI", data))
    return event if event.kind <= REMOVED else None


def notification_attributes_command(uid, attributes):
    """Get Notification Attributes for <uid>: each attribute's ID, and the
    texts' a length the answer may not pass."""
    command = bytearray(struct.pack("<BI", GET_NOTIFICATION_ATTRIBUTES, uid))
    for attribute in attributes:
        command.append(attribute)
        if attribute in LIMITS:
            command += struct.pack("<H", LIMITS[attribute])
    return bytes(command)


def app_attributes_command(app):
    """Get App Attributes for the app identifier <app> (bytes): its name."""
    return bytes([GET_APP_ATTRIBUTES]) + bytes(app) + b"\0" + bytes([DISPLAY_NAME])


def action_command(uid, action):
    """Perform Notification Action: <action> on notification <uid>."""
    return struct.pack("<BIB", PERFORM_NOTIFICATION_ACTION, uid, action)


class Answer:
    """A Data Source answer put back together from its fragments: an answer
    has no length of its own, and is whole once every attribute asked for
    is in. <start> is how it begins: the command's ID and the notification's
    UID, or the app's identifier. Bytes before the start, left of an answer
    that was given up on, are passed over."""

    def __init__(self, start, wanted):
        self.start = bytes(start)
        self.wanted = frozenset(wanted)
        self.buffer = b""

    def feed(self, fragment):
        """The attributes, {ID: bytes}, once all are in; None until then.
        ValueError for an answer that cannot be the one asked for."""
        self.buffer += bytes(fragment)
        at = self.buffer.find(self.start)
        if at < 0:
            # What could be the start's first bytes is kept for the next one.
            keep = len(self.start) - 1
            self.buffer = self.buffer[-keep:] if keep else b""
            return None
        self.buffer = self.buffer[at:]
        found = {}
        position = len(self.start)
        while len(found) < len(self.wanted):
            if position + 3 > len(self.buffer):
                return None
            attribute, size = struct.unpack_from("<BH", self.buffer, position)
            if attribute not in self.wanted or attribute in found:
                raise ValueError(f"attribute {attribute} was not asked for")
            if position + 3 + size > len(self.buffer):
                return None
            found[attribute] = self.buffer[position + 3:position + 3 + size]
            position += 3 + size
        return found


def text(raw, limit=None):
    """An attribute as text: UTF-8, its control characters spaces, its lines
    without runs of space and none of them empty. Cut short by the iPhone at
    <limit> bytes, half a character is dropped and it ends in an ellipsis."""
    value = bytes(raw).decode("utf-8", "replace")
    cut = limit is not None and len(raw) >= limit
    if cut:
        value = value.rstrip("�")
    value = value.replace(" ", "\n").replace(" ", "\n")
    value = "".join(" " if c != "\n" and unicodedata.category(c) == "Cc" else c for c in value)
    value = "\n".join(line for line in (" ".join(part.split()) for part in value.split("\n")) if line)
    return value + "…" if cut and value else value


def app_fallback(app):
    """An app's name when the iPhone does not give it: the last part of its
    identifier (net.whatsapp.WhatsApp is WhatsApp)."""
    name = text(app).rsplit(".", 1)[-1]
    return name or "iPhone"


def toast_text(app, title, subtitle, message):
    """A notification's summary and body: the app and the title, as the
    iPhone's lock screen has them in that order, and the subtitle and the
    message below. The body is markup to the shell, so it is escaped."""
    summary = f"{app} · {title}" if title and title != app else app or title
    body = "\n".join(part for part in (subtitle, message) if part)
    return summary, html.escape(body, quote=False)


def parse_date(value):
    """The Date attribute, yyyyMMdd'T'HHmmSS in the iPhone's local time, as
    seconds since the epoch, or None."""
    try:
        return time.mktime(time.strptime(text(value), "%Y%m%dT%H%M%S"))
    except (ValueError, OverflowError):
        return None


def arrived_while_away(date, dropped, now):
    """Whether a notification of <date> came after the link dropped at
    <dropped>, give or take a minute of the two clocks, and not from the
    future."""
    when = parse_date(date)
    return when is not None and dropped - 60 <= when <= now + 300


# --------------------------------------------------------------- tunables

def seconds(name, default):
    try:
        return float(os.environ.get(f"NOVA_IPHONE_{name}_SECONDS", default))
    except ValueError:
        return float(default)


# Apple's accessory guidelines: 20 ms for the first 30 s, then a longer
# interval from their list; 1285 ms is the longest, and a whole number of
# milliseconds, which is what BlueZ takes. The pairing window advertises as
# the kernel does for a discoverable controller.
INTERVALS = {"pairing": (100, 150), "fast": (20, 30), "slow": (1285, 1285)}
FAST_SECONDS = seconds("FAST", 30)
PAIR_SECONDS = seconds("PAIR", 180)
# How long an answer on the Data Source may take.
REPLY_SECONDS = seconds("REPLY", 5)
# A connection back within this long counts as a blip (a reset of the card,
# a sleep of a minute): notifications that came meanwhile are shown, a few.
MISSED_SECONDS = seconds("MISSED", 300)
MISSED_MOST = 5
CALL_TIMEOUT = 10

