#!/bin/bash
# nova-apps-apply: the root half of installing and removing an app from
# Arch's repositories, for the App Center and `nova apps` (through pkexec, as
# org.nova.apps).
#
#   install <package>   install an app Arch's catalog lists, with this computer's
#                       graphics drivers when it needs a Vulkan driver
#                       (nova-hw-packages): pacman left to pick one takes
#                       NVIDIA's on every computer. They go in as dependencies,
#                       so they leave with the app.
#   remove <package>    remove an installed app, and what it alone needed
#
# An app's recipe (src/apps/data/recipes, read only from
# /usr/share/nova/apps/recipes, a file only root can write) adds packages to
# its install, marked as dependencies and taken out with it when nothing else
# needs them, and steps done as root once it is in, from a fixed list:
# enable-socket <unit> for a socket a package installed ships, add-group
# libvirt for the account that authenticated. A recipe that breaks those
# rules stops the install with nothing changed.
#   built <file>        install Chrome or VS Code, built by nova apps install
#                       (nova-update-apply checks and installs it)
#
# Never a partial upgrade. Nova pins Arch's repositories to the snapshot the
# release was tested against, and nova update reads their package lists and
# brings every package to them in one step, so on a system that is up to
# date the lists and the packages are the same snapshot, and an app goes in
# from it as it was tested. This never reads newer lists (no -y, which would
# leave everything else behind them): only lists that are missing, as on a
# system installed from a stick, which the pins make the same snapshot.
# And it installs nothing on a system whose packages are behind its lists,
# as an update that did not finish leaves it (pacman -Qu): an app from
# newer lists could bring a library newer than what uses it. Packages held
# back with IgnorePkg are the owner's choice, and do not count.
#
# Nothing here runs while nova update does, nor the other way round: both
# take /run/nova-update.lock. snap-pac takes a snapshot before and after, as
# for any pacman transaction.
#
# Exit status: 0 done; 1 failed; 2 bad arguments; 3 refused, the system not
# up to date (said why); 75 an update or another install is running.
#
# Run through pkexec, so it trusts nothing it is given.

set -euo pipefail

HERE=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# The test seams (a scratch root, the helpers beside it) are honoured only for
# a caller that is not root, whose pacman is a test's: as root nothing from
# the environment is read, though pkexec empties it anyway.
if ((EUID == 0)); then
  ROOT=''
  HW_PACKAGES=$HERE/bin/nova-hw-packages
  UPDATE_APPLY=$HERE/bin/nova-update-apply
else
  ROOT=${NOVA_ROOT:-}
  HW_PACKAGES=${NOVA_HW_PACKAGES:-$HERE/bin/nova-hw-packages}
  UPDATE_APPLY=${NOVA_UPDATE_APPLY:-$HERE/bin/nova-update-apply}
fi
MIRRORLIST=$ROOT/etc/pacman.d/nova-mirrorlist
REPOFILE=$ROOT/etc/pacman.d/nova-repo
SYNC_DIR=$ROOT/var/lib/pacman/sync
SWCATALOG=$ROOT/usr/share/swcatalog
RECIPES=$ROOT/usr/share/nova/apps/recipes

say() { printf '==> %s\n' "$*"; }
die() {
  printf 'nova-apps-apply: %s\n' "$1" >&2
  exit "${2:-1}"
}

usage() { die "usage: nova-apps-apply install|remove <package> | built <file>" 2; }

(($# == 2)) || usage
action=$1 target=$2
case $action in
  install | remove)
    # A package's name, which never begins as an option does.
    [[ $target =~ ^[a-z0-9@_+][a-z0-9@._+-]*$ ]] || usage
    ;;
  built) ;;
  *) usage ;;
esac
((EUID == 0)) || [[ -n $ROOT ]] || die "this runs as root; use nova apps or the App Center"

mkdir -p "$ROOT/run"
exec {lock}>"$ROOT/run/nova-update.lock"
flock -n "$lock" || die "Nova is installing an update or another app; try again once it is done" 75

if [[ $action == built ]]; then
  # Under the lock nova-update-apply takes too: it is let go first.
  exec {lock}>&-
  exec "$UPDATE_APPLY" --packages-only --package "$target"
fi

# An update that stopped before its end leaves the pins of the release it was
# for beside copies of the ones before it.
unfinished() {
  local f
  for f in "$MIRRORLIST" "$REPOFILE" "$SYNC_DIR"; do
    [[ ! -e $f.nova-prev && ! -e $f.nova-absent ]] || return 0
  done
  [[ ! -e $REPOFILE.nova-boot-unchecked ]] || return 0
  return 1
}

# Whether Arch's catalog lists the package as an app: what this installs.
an_app() { # package
  local file
  for file in "$SWCATALOG"/xml/*.xml.gz; do
    [[ -e $file ]] || continue
    zgrep -qF "<pkgname>$1</pkgname>" "$file" && return 0
  done
  return 1
}

# The package lists a system installed from a stick has none of. The pins
# make them the release's snapshot, the one the packages are from.
read_missing_lists() {
  local repo
  for repo in $(pacman-conf --repo-list 2>/dev/null); do
    if [[ ! -e $SYNC_DIR/$repo.db ]]; then
      say "Reading the package lists"
      pacman -Sy --noconfirm
      return
    fi
  done
}

# This computer's graphics drivers, as nova-hw-packages finds them: as root
# with nothing of the caller's environment.
hw_packages() { # option...
  local portable=()
  [[ ! -e $ROOT/etc/nova/portable ]] || portable=(--portable)
  if ((EUID == 0)); then
    env -i PATH=/usr/bin "$HW_PACKAGES" "${portable[@]}" "$@"
  else
    "$HW_PACKAGES" "${portable[@]}" "$@"
  fi
}

# The graphics drivers to install beside the packages: this computer's own,
# for what they would bring in (pacman -Sp; nova-hw-packages --needed-by
# says which, as for the App Center's size in nova-apps-size). Left to pick
# a provider of vulkan-driver or lib32-vulkan-driver (Steam needs both),
# pacman takes NVIDIA's on every computer; given one in the same
# transaction, it takes that one.
graphics_for() { # package...
  local brought
  brought=$(pacman -Sp --print-format %n -- "$@" 2>/dev/null) || return 0
  hw_packages --needed-by <<<"$brought" | grep -xE '[a-z0-9@_+][a-z0-9@._+-]*' || true
}

# Of the packages, those not installed yet.
not_installed() { # package...
  local name
  for name; do
    pacman -Q -- "$name" >/dev/null 2>&1 || printf '%s\n' "$name"
  done
}

# --- the app's recipe ---------------------------------------------------------
#
# What an app needs beyond its own dependencies (src/apps/data/recipes):
# packages installed with it, and what is done as root once it is in. Read
# from the one root-owned file, never from an argument or the environment;
# each line split with read -a, so nothing in it is expanded, each word
# checked before it is used, and packages passed to pacman after --.

PACKAGE_NAME='^[a-z0-9@_+][a-z0-9@._+-]*$'
SOCKET_UNIT='^[a-z0-9][a-z0-9_-]*\.socket$'
# The groups an app may put its user in: one that gives what the app needs
# and no more. Never wheel, root's, or a group that reads the disks.
RECIPE_GROUPS=(libvirt)

# A recipe that is not as it should be stops the install: it is Nova's, and
# a broken one is a bug, not something to guess around.
broken_recipe() { die "the recipe for $target is broken ($1); nothing was changed"; }

# The target's recipe, checked, into RECIPE_WITH (packages) and RECIPE_AFTER
# ("action operand"). Run in this shell, so a broken one stops it. The file
# has to be a plain file that only root can write; with none, no recipe.
RECIPE_WITH=() RECIPE_AFTER=()
read_recipe() {
  local line word action operand
  local -a words
  [[ -e $RECIPES || -L $RECIPES ]] || return 0
  [[ -f $RECIPES && ! -L $RECIPES ]] || broken_recipe "$RECIPES is not a plain file"
  if ((EUID == 0)); then
    [[ $(stat -c '%u %a' -- "$RECIPES") =~ ^0\ [0-7]?[0-7][0145][0145]$ ]] || broken_recipe "$RECIPES is not root's alone"
  fi
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%%#*}
    read -r -a words <<<"$line"
    ((${#words[@]} >= 2)) && [[ ${words[0]} == "$target" ]] || continue
    case ${words[1]} in
      with | skip)
        ((${#words[@]} > 2)) || broken_recipe "a ${words[1]} that names nothing"
        for word in "${words[@]:2}"; do
          [[ $word =~ $PACKAGE_NAME || (${words[1]} == skip && $word =~ ^[A-Za-z0-9@._+-]+$) ]] ||
            broken_recipe "'$word' is not a package's name"
          [[ ${words[1]} == skip ]] || RECIPE_WITH+=("$word")
        done
        ;;
      prefer)
        ((${#words[@]} == 3)) && [[ ${words[2]} == flathub || ${words[2]} == arch ]] ||
          broken_recipe "prefer takes flathub or arch"
        ;;
      after)
        ((${#words[@]} == 4)) || broken_recipe "after takes an action and one operand"
        action=${words[2]} operand=${words[3]}
        case $action in
          enable-socket) [[ $operand =~ $SOCKET_UNIT ]] || broken_recipe "'$operand' is not a socket unit" ;;
          add-group) [[ " ${RECIPE_GROUPS[*]} " == *" $operand "* ]] || broken_recipe "'$operand' is not a group an app may add" ;;
          *) broken_recipe "'$action' is no action an app may take" ;;
        esac
        RECIPE_AFTER+=("$action $operand")
        ;;
      *) broken_recipe "'${words[1]}' is no directive" ;;
    esac
  done <"$RECIPES"
}

# A socket unit that a package installed ships, and that package.
socket_owner() { # unit
  local path=/usr/lib/systemd/system/$1
  [[ -f $ROOT$path ]] || return 1
  pacman -Qqo -- "$path" 2>/dev/null
}

# What the recipe does once the app is in. A step that fails is said, and
# the app stays installed: it is in, and the step can be done by hand.
run_after() { # "action operand"...
  local step action operand user
  for step; do
    read -r action operand <<<"$step"
    case $action in
      enable-socket)
        if ! socket_owner "$operand" >/dev/null; then
          echo "nova-apps-apply: $operand is not a socket of an installed package; it is left off" >&2
          continue
        fi
        say "Turning on $operand"
        systemctl enable --now -- "$operand" ||
          echo "nova-apps-apply: could not turn on $operand; try: sudo systemctl enable --now $operand" >&2
        ;;
      add-group)
        # The account pkexec authenticated, which only pkexec sets.
        user=''
        if [[ ${PKEXEC_UID:-} =~ ^[0-9]+$ ]]; then user=$(getent passwd "$PKEXEC_UID" | cut -d: -f1); fi
        if [[ ! $user =~ ^[a-z_][a-z0-9_-]*$ ]]; then
          echo "nova-apps-apply: no account to add to $operand; add yours with: sudo gpasswd -a \$USER $operand" >&2
          continue
        fi
        getent group "$operand" >/dev/null || { echo "nova-apps-apply: there is no group $operand" >&2; continue; }
        say "Adding $user to the $operand group, from the next login"
        gpasswd -a "$user" "$operand" >/dev/null || echo "nova-apps-apply: could not add $user to $operand" >&2
        ;;
    esac
  done
}

# The extras the recipes of the other apps installed name: one of those is
# still that app's, though pacman lists an optional dependency in no Required
# By (Firefox and Thunderbird both install hunspell-en_us).
extras_of_others() {
  local line
  local -a words
  [[ -f $RECIPES ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%%#*}
    read -r -a words <<<"$line"
    ((${#words[@]} > 2)) && [[ ${words[1]} == with && ${words[0]} != "$target" && ${words[0]} =~ $PACKAGE_NAME ]] || continue
    pacman -Q -- "${words[0]}" >/dev/null 2>&1 || continue
    printf '%s\n' "${words[@]:2}"
  done <"$RECIPES"
}

# A field of pacman -Qi that lists packages, its words on one line.
qi_field() { # package field
  LC_ALL=C pacman -Qi -- "$1" 2>/dev/null |
    awk -v field="$2" 'index($0, field) == 1 { on = 1; sub(/^[^:]*:/, ""); printf "%s ", $0; next } on && /^ / { printf "%s ", $0; next } { on = 0 } END { print "" }'
}

# Of the extras the recipe brought, those that can go with the app: installed
# as dependencies (one installed by name was asked for), named by the recipe
# of no other app installed, and needed or optionally used by nothing that
# stays (what pacman -Rs takes with the app does not). Dropping one can leave
# another needed by it, so until none drops.
extras_to_remove() { # extra...
  local -a keep=("$@") next=() by=() going=() others=()
  local changed=1 name who
  mapfile -t others < <(extras_of_others)
  mapfile -t going < <(pacman -Rsp --print-format %n -- "$target" 2>/dev/null || true)
  while ((changed)); do
    changed=0 next=()
    for name in "${keep[@]}"; do
      if [[ $(pacman -Qqd -- "$name" 2>/dev/null) != "$name" || " ${others[*]} " == *" $name "* ]]; then
        changed=1
        continue
      fi
      read -r -a by <<<"$(qi_field "$name" 'Required By')"
      for who in "${by[@]}"; do
        [[ $who == None || $who == "$target" || " ${keep[*]} " == *" $who "* ]] || { changed=1; continue 2; }
      done
      read -r -a by <<<"$(qi_field "$name" 'Optional For')"
      for who in "${by[@]}"; do
        [[ $who == None || $who == "$target" || " ${keep[*]} ${going[*]} " == *" $who "* ]] || { changed=1; continue 2; }
      done
      next+=("$name")
    done
    keep=("${next[@]}")
  done
  ((${#keep[@]} == 0)) || printf '%s\n' "${keep[@]}"
}

install_app() {
  local behind
  if unfinished; then
    die "the last update did not finish: Settings, Updates finishes it, and then the app can be installed" 3
  fi
  an_app "$target" || die "$target is not an app in Arch's catalog"
  read_missing_lists
  pacman -Si -- "$target" >/dev/null 2>&1 || die "$target is not in the release's repositories"
  behind=$(LC_ALL=C pacman -Qu 2>/dev/null | grep -v '\[ignored\]$' | awk '{ print $1 }' | paste -sd' ' || true)
  [[ -z $behind ]] || die "this computer's packages are older than its package lists ($behind): update Nova first, in Settings, Updates" 3
  read_recipe
  local name
  local -a extras=() gone=() drivers=() new_extras=() new_drivers=()
  for name in "${RECIPE_WITH[@]}"; do
    if pacman -Si -- "$name" >/dev/null 2>&1; then extras+=("$name"); else gone+=("$name"); fi
  done
  ((${#gone[@]} == 0)) || echo "nova-apps-apply: not in the release's repositories, so left out: ${gone[*]}" >&2
  mapfile -t drivers < <(graphics_for "$target" "${extras[@]}")
  mapfile -t new_extras < <(not_installed "${extras[@]}")
  mapfile -t new_drivers < <(not_installed "${drivers[@]}")
  say "Installing $target"
  ((${#new_extras[@]} == 0)) || say "With it: ${new_extras[*]}"
  ((${#new_drivers[@]} == 0)) || say "With this computer's graphics drivers: ${new_drivers[*]}"
  stdbuf -oL pacman -S --needed --noconfirm -- "$target" "${extras[@]}" "${drivers[@]}"
  # Dependencies, as pacman would have made them: they go with the app.
  ((${#new_extras[@]} + ${#new_drivers[@]} == 0)) || pacman -D --asdeps -- "${new_extras[@]}" "${new_drivers[@]}" >/dev/null
  ((${#RECIPE_AFTER[@]} == 0)) || run_after "${RECIPE_AFTER[@]}"
}

remove_app() {
  local owner
  pacman -Q -- "$target" >/dev/null 2>&1 || die "$target is not installed"
  case $target in
    nova | nova-*) die "$target is part of Nova" ;;
  esac
  # An app: it has a launcher entry. Not a library or a tool, which other
  # things use. (Not grep -q: it would stop reading at the first one, and
  # pacman, shot by SIGPIPE, would fail the pipeline.)
  pacman -Qlq -- "$target" 2>/dev/null | grep -E '^/usr/share/applications/[^/]+\.desktop$' >/dev/null ||
    die "$target is not an app"
  # Nova needs it.
  owner=$(LC_ALL=C pacman -Qi nova 2>/dev/null | awk '/^Depends On/ { on = 1; sub(/^[^:]*:/, ""); print; next } on && /^ / { print; next } { on = 0 }' |
    tr -s ' ' '\n' | sed -E 's/[<>=].*//' | grep -cx -- "$target" || true)
  ((owner == 0)) || die "$target is part of Nova"
  read_recipe
  local -a extras=() going=()
  local step action unit owner
  if ((${#RECIPE_WITH[@]})); then mapfile -t extras < <(extras_to_remove "${RECIPE_WITH[@]}"); fi
  # A socket the recipe turned on, whose package goes now: off first, so
  # that no link to a unit that is gone is left behind.
  if ((${#RECIPE_AFTER[@]})); then
    mapfile -t going < <(pacman -Rsp --print-format %n -- "$target" "${extras[@]}" 2>/dev/null || true)
    for step in "${RECIPE_AFTER[@]}"; do
      read -r action unit <<<"$step"
      [[ $action == enable-socket ]] || continue
      owner=$(socket_owner "$unit") || continue
      [[ -n $owner && " ${going[*]} " == *" $owner "* ]] || continue
      systemctl disable --now -- "$unit" || true
    done
  fi
  say "Removing $target"
  ((${#extras[@]} == 0)) || say "With what it brought: ${extras[*]}"
  # pacman refuses a removal that would break anything installed, and says
  # what; what nothing else needs goes with it.
  stdbuf -oL pacman -Rns --noconfirm -- "$target" "${extras[@]}"
}

case $action in
  install) install_app ;;
  remove) remove_app ;;
esac
