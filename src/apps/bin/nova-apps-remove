#!/bin/bash
# nova:summary=Remove an app installed from the App Center, or with nova apps install
# nova:args=<app>
#
# From wherever it is installed. A Flathub app's data, its sandbox folder
# ~/.var/app/<id>, goes with it, and so do the runtimes no app uses any
# more. An app from Arch's repositories or Nova's own keeps its files and
# settings in the home folder, at places only the app knows, so they stay,
# as a Mac app outside the sandbox keeps them. One from Arch's repositories
# asks for a password or a finger, and takes with it what only it needed.
# Nova's own parts are not removed.

set -euo pipefail

HERE=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
(($# == 1)) || { echo "Usage: nova apps remove <app>" >&2; exit 2; }
exec "$HERE/nova-apps-job" remove "$1"
