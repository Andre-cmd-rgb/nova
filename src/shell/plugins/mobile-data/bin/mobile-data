#!/bin/bash
# nova:summary=Mobile data: the modem's connection, signal, usage and texts
#
# mobile-data — mobile broadband control and status behind Nova's mobile data
# bar widget (nova.mobile-data), run as `nova mobile-data <command>`.
#
# NetworkManager only: Nova's network stack is NetworkManager, so the bearer is
# an ordinary `gsm` connection profile. NetworkManager's shipped polkit policy sets
# allow_active=yes for both network-control and settings.modify.system, so
# every command here runs as your normal user — no root, no polkit rule, no
# systemd unit.

set -uo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/nova-mobile-data"
CONFIG="$CONFIG_DIR/config"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/nova-mobile-data"
METER="$STATE_DIR/meter"
MODEM_CACHE="$STATE_DIR/modem"
# Written the first time a modem answers. Its presence is what separates a
# machine whose modem has not come back yet from one that never had one.
MODEM_SEEN="$STATE_DIR/seen"
# Which SIM the profile's APN was looked up for, as a hash of the SIM's ICCID
# (or IMSI): another SIM in the slot has its own looked up.
SIM_SET_UP="$STATE_DIR/sim"
# A modem with no SIM is switched off and left out of the bar, for the power
# it saves, until a SIM is seen in its slot (look_while_parked), or `check`
# (Settings > Mobile Data) finds one. The file holds why: nosim.
PARKED="$STATE_DIR/parked"
# Mobile data switched off here because the modem could not be turned on, so
# that nothing asks it again every two seconds (watch_enabling). The file
# holds why; the switch tries again.
STOPPED="$STATE_DIR/stopped"
# Since when, and when last, the modem was seen on its way up and not getting
# there: "<since> <last>", in seconds of the epoch.
TRYING="$STATE_DIR/trying"
# Text messages, once they are off the modem and safely somewhere else.
INBOX="$STATE_DIR/inbox"
SMS_LOCK="$STATE_DIR/.sms.lock"

# Paths used by andre.mobile 2.x, read once so an upgrade keeps the billing
# period and the configured profile instead of silently starting over.
LEGACY_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/nova/mobile.conf"
LEGACY_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/nova-mobile"

# Testing seam; there is no reason to set this in normal use.
NET_DIR="${NOVA_MOBILE_NET_DIR:-/sys/class/net}"

# Testing seam, as is NOVA_MOBILE_NOW for the clock.
PROVIDERS="${NOVA_MOBILE_PROVIDERS:-/usr/share/mobile-broadband-provider-info/serviceproviders.xml}"

DUMP="" IDX=""
STATE=absent HW=no MANAGED=no PROFILE_NAME=""
MODEM_STATE="" DEVICE_STATE="" WHY="" UNLOCK="" PIN_TRIES=""
OPERATOR="" TECH="" SIGNAL=0 IFACE="" IPADDR=""
USED_BYTES=0 PERIOD_START="" PERIOD_NEXT=""

die() {
  printf 'mobile-data: %s\n' "$*" >&2
  exit 1
}

have() { command -v "$1" >/dev/null 2>&1; }

# nmcli translates device states — an Italian desktop reports "connesso" — and
# every comparison below is against the English word, so the tools whose output
# is parsed are pinned to the C locale. The script's own locale is deliberately
# left alone: printf's \U escapes need a UTF-8 charset to emit the bar glyphs,
# and under LC_ALL=C they would print as a literal backslash sequence.
nm() { LC_ALL=C nmcli "$@"; }
mm() { LC_ALL=C mmcli "$@"; }
rf() { LC_ALL=C rfkill "$@"; }

# ------------------------------------------------------------------- config
# Parsed, never sourced: this file is user-editable and must not be able to
# execute anything.

get_cfg() {
  local key=$1 def=${2:-} value="" line
  if [[ -r $CONFIG ]]; then
    # Keys are literals from this script, never user input, so building the
    # match out of one is safe. The last line for a key wins.
    local pattern="^[[:space:]]*${key}[[:space:]]*=(.*)$"
    while IFS= read -r line || [[ -n $line ]]; do
      [[ $line =~ $pattern ]] && value=${BASH_REMATCH[1]}
    done <"$CONFIG"
    value=${value//$'\r'/}
    value=${value#"${value%%[![:space:]]*}"}
    value=${value%"${value##*[![:space:]]}"}
  fi
  printf '%s' "${value:-$def}"
}

set_cfg() {
  local key=$1 value=$2 tmp
  mkdir -p -- "$CONFIG_DIR" || return 1
  if [[ ! -f $CONFIG ]]; then
    (
      umask 077
      : >"$CONFIG"
    ) || return 1
  fi
  tmp=$(mktemp -- "$CONFIG.XXXXXX") || return 1
  # awk rather than sed: the value is data, and a sed replacement would read an
  # APN containing & or \1 as a back-reference and rewrite it.
  if ! awk -v key="$key" -v value="$value" '
    BEGIN { pattern = "^[[:space:]]*" key "[[:space:]]*=" }
    $0 ~ pattern { if (!seen++) print key "=" value; next }
    { print }
    END { if (!seen) print key "=" value }
  ' "$CONFIG" >"$tmp"; then
    rm -f -- "$tmp"
    return 1
  fi
  # Copy rather than move so the file keeps its own ownership and mode.
  cat -- "$tmp" >"$CONFIG"
  rm -f -- "$tmp"
}

# A positive integer from the config file, falling back to the default when the
# key is missing or holds something that is not one.
cfg_number() {
  local value
  value=$(get_cfg "$1" "$2")
  [[ $value =~ ^[0-9]+$ ]] && ((10#$value > 0)) || value=$2
  printf '%s' "$((10#$value))"
}

# Carry 2.x state forward on first run. Copies rather than moves, so rolling
# back to the old plugin finds everything where it left it. And a park made
# for want of ModemManager is undone (forget_old_park).
migrate_legacy_state() {
  if [[ ! -e $CONFIG && -r $LEGACY_CONFIG ]]; then
    mkdir -p -- "$CONFIG_DIR" 2>/dev/null &&
      (
        umask 077
        cat -- "$LEGACY_CONFIG" >"$CONFIG"
      ) 2>/dev/null
  fi
  if [[ ! -d $STATE_DIR && -d $LEGACY_STATE_DIR ]]; then
    mkdir -p -- "$STATE_DIR" 2>/dev/null || return 0
    local file
    for file in meter modem; do
      [[ -r $LEGACY_STATE_DIR/$file ]] &&
        cat -- "$LEGACY_STATE_DIR/$file" >"$STATE_DIR/$file" 2>/dev/null
    done
  fi
  forget_old_park
  # A SIM seen once kept a modem on whatever its slot held after; nothing
  # reads that mark now.
  rm -f -- "$STATE_DIR/sim-seen"
}

# -------------------------------------------------------------------- modem

# One `mmcli -m N -K` in the common case: the index is cached, and only a
# cache miss costs the extra `mmcli -L`.
load_dump() {
  local cached="" index
  DUMP="" IDX=""
  have mmcli || return 1

  [[ -r $MODEM_CACHE ]] && cached=$(<"$MODEM_CACHE")
  if [[ $cached =~ ^[0-9]+$ ]]; then
    DUMP=$(mm -m "$cached" -K 2>/dev/null) && {
      IDX=$cached
      parse_dump
      return 0
    }
  fi

  index=$(mm -L 2>/dev/null | sed -n 's|.*/Modem/\([0-9][0-9]*\).*|\1|p' | sed -n 1p)
  [[ -n $index ]] || return 1
  DUMP=$(mm -m "$index" -K 2>/dev/null) || return 1
  IDX=$index
  parse_dump
  mkdir -p -- "$STATE_DIR" && printf '%s' "$index" >"$MODEM_CACHE"
  return 0
}

# What the SIM at this path says it is, as "<iccid>|<imsi>", either of them
# empty; a failure when it does not answer, which says nothing about it.
sim_numbers() { # path
  local dump line iccid="" imsi=""
  dump=$(mm -i "${1##*/}" -K 2>/dev/null) || return 1
  [[ $dump == *sim.properties.* ]] || return 1
  while IFS= read -r line; do
    case $line in
    sim.properties.iccid*) iccid=${line#*:} ;;
    sim.properties.imsi*) imsi=${line#*:} ;;
    esac
  done <<<"$dump"
  printf '%s|%s\n' "${iccid//[[:space:]-]/}" "${imsi//[[:space:]-]/}"
}

# Whether the SIM at this path has nothing on it to read, neither its ICCID
# nor its IMSI: an eSIM with no plan on it.
sim_blank() { # path
  local numbers
  numbers=$(sim_numbers "$1") || return 1
  [[ $numbers == "|" ]]
}

# Whether the SIM at this path is an eSIM with no plan on it, as a modem
# switched off has it: ModemManager says so, or nothing on it is there to
# read while the chip itself answers, with its EID. A card that a modem
# reads only while it is on says nothing while it is off, its EID neither
# (a card has none), and is not taken for none.
esim_without_plan() { # path
  local dump line iccid="" imsi="" eid="" status=""
  dump=$(mm -i "${1##*/}" -K 2>/dev/null) || return 1
  [[ $dump == *sim.properties.* ]] || return 1
  while IFS= read -r line; do
    case $line in
    sim.properties.iccid*) iccid=${line#*:} ;;
    sim.properties.imsi*) imsi=${line#*:} ;;
    sim.properties.eid*) eid=${line#*:} ;;
    sim.properties.esim-status*) status=${line#*:} ;;
    esac
  done <<<"$dump"
  [[ ${status//[[:space:]]/} != no-profiles ]] || return 0
  iccid=${iccid//[[:space:]-]/} imsi=${imsi//[[:space:]-]/} eid=${eid//[[:space:]-]/}
  [[ -z $iccid && -z $imsi && -n $eid ]]
}

# The SIM at this path, as a short hash of its ICCID, else its IMSI; nothing,
# and a failure, for one with neither or one that does not answer. A hash,
# so that the state folder does not keep the SIM's number.
sim_id() { # path
  local numbers iccid imsi hash
  numbers=$(sim_numbers "$1") || return 1
  IFS='|' read -r iccid imsi <<<"$numbers"
  [[ -n $iccid || -n $imsi ]] || return 1
  hash=$(printf '%s' "${iccid:-$imsi}" | sha256sum)
  printf '%s\n' "${hash:0:16}"
}

# Whether the modem's slot holds a SIM, from its dump: "yes" for one that says
# what it is (or that the modem could not read), "no" for an empty slot or an
# eSIM with nothing on it, and nothing while the modem is still reading its
# slot or the SIM does not answer. Switched off, a modem may keep its slot to
# itself, a card's numbers too: only an eSIM with no plan on it is no SIM
# then, and an empty slot or a blank card says nothing.
sim_in_slot() {
  local state sim
  state=$(kv modem.generic.state) sim=$(kv modem.generic.sim)
  case $state in
  "" | unknown | initializing | enabling) return 0 ;;
  failed)
    case $(kv modem.generic.state-failed-reason) in
    sim-missing | esim-without-profiles) echo no ;;
    *) [[ -z $sim || $sim == "/" ]] && echo no || echo yes ;;
    esac
    return 0
    ;;
  esac
  if [[ -z $sim || $sim == "/" ]]; then
    [[ $state == disabled || $state == disabling ]] || echo no
  elif sim_id "$sim" >/dev/null; then
    echo yes
  elif [[ $state == disabled || $state == disabling ]]; then
    ! esim_without_plan "$sim" || echo no
  elif sim_blank "$sim"; then
    echo no
  fi
  return 0
}

mark_modem_seen() {
  [[ -e $MODEM_SEEN ]] && return 0
  mkdir -p -- "$STATE_DIR" 2>/dev/null && : >"$MODEM_SEEN" 2>/dev/null
  return 0
}


# The radio soft-blocked straight through rfkill, not `nmcli radio wwan off`:
# NetworkManager does nothing with a modem ModemManager is not there to drive.
# systemd-rfkill keeps the block across reboots.
park() { # reason
  mkdir -p -- "$STATE_DIR" 2>/dev/null && printf '%s\n' "$1" >"$PARKED" 2>/dev/null
  have rfkill && rf block wwan >/dev/null 2>&1
  STATE=parked
  return 0
}

parked_reason() {
  [[ -r $PARKED ]] || return 1
  local reason
  reason=$(<"$PARKED")
  printf '%s' "${reason:-nosim}"
}

# A modem kept off by a release before ModemManager came with Nova, for want
# of it (no-modemmanager): ModemManager is here now, so that is undone, its
# radio too, and the first start decides again.
forget_old_park() {
  [[ -e $PARKED && $(parked_reason) == no-modemmanager ]] && have mmcli || return 0
  rm -f -- "$PARKED"
  have rfkill && rf unblock wwan >/dev/null 2>&1
  return 0
}

# A modem with no SIM is switched off whenever that is seen, not only on its
# first start: an empty slot, or an eSIM with no plan on it. Its radio is
# blocked, which leaves the modem in low power with its slot still read, so
# a SIM seen there later brings it back (look_while_parked). A modem still
# on its way up has not read its slot, and is no answer.
park_without_sim() {
  [[ $HW == yes && $STATE == nosim ]] || return 0
  park nosim
}

# Back on, as a SIM brings it: the radio unblocked and mobile data on, as a
# phone takes a new SIM.
unpark() {
  rm -f -- "$PARKED"
  have rfkill && rf unblock wwan >/dev/null 2>&1
  have nmcli && nm radio wwan on >/dev/null 2>&1
  return 0
}

# A parked modem is in low power with its radio off, and ModemManager still
# reads its slot (on the ThinkPad P1; where blocking the radio cuts the
# modem's power there is no modem to ask, and check looks again). A SIM there
# that says what it is, put in while the computer was off or noticed going in,
# brings the modem back. One that does not answer, or has nothing on it, is
# not taken for one, so a modem is never switched on to find nothing.
look_while_parked() {
  load_dump && [[ $(sim_in_slot) == yes ]] || return 1
  unpark
}

# The APN looked up for a SIM, once it is on a network: for one new in the
# slot, as a phone does, and for one with no profile yet. A SIM already set up
# before this was kept is taken as the one the profile is for, so an APN set
# by hand stays. One that could not be set up is tried again a minute later,
# not at every look; and one look at a time sets up, so that the bar's and
# Settings' at once do not make a profile each.
SETUP_RETRY=60
set_up_for_sim() {
  [[ $STATE == disconnected || $STATE == noprofile ]] || return 0
  local sim id kept="" tried="" at=0 now=${NOVA_MOBILE_NOW:-$EPOCHSECONDS} lock=""
  sim=$(kv modem.generic.sim)
  [[ -n $sim && $sim != "/" ]] && id=$(sim_id "$sim") || return 0
  [[ -r $SIM_SET_UP ]] && kept=$(<"$SIM_SET_UP")
  [[ $id != "$kept" ]] || return 0
  if [[ $STATE == noprofile || -n $kept ]]; then
    [[ -r $SIM_SET_UP.tried ]] && read -r tried at <"$SIM_SET_UP.tried"
    [[ $tried == "$id" && $at =~ ^[0-9]+$ ]] && ((now - at < SETUP_RETRY)) && return 0
    mkdir -p -- "$STATE_DIR" 2>/dev/null
    { exec {lock}>"$STATE_DIR/.setup.lock"; } 2>/dev/null || return 0
    flock -n "$lock" 2>/dev/null || {
      exec {lock}>&-
      return 0
    }
    # Set up by another look while this one came to the lock.
    [[ -r $SIM_SET_UP ]] && kept=$(<"$SIM_SET_UP")
    if [[ $id == "$kept" ]]; then
      exec {lock}>&-
      return 0
    fi
    # In a subshell: what fails in it dies there, not the info it is part of.
    if ! (cmd_setup) >/dev/null 2>&1; then
      printf '%s %s\n' "$id" "$now" >"$SIM_SET_UP.tried" 2>/dev/null
      exec {lock}>&-
      return 0
    fi
    rm -f -- "$SIM_SET_UP.tried"
    PROFILE_NAME=$(nm_profile)
    [[ -n $PROFILE_NAME ]] && STATE=disconnected
  fi
  mkdir -p -- "$STATE_DIR" 2>/dev/null && printf '%s\n' "$id" >"$SIM_SET_UP" 2>/dev/null
  # Held until the SIM is noted, so that a look taking it next finds it so.
  [[ -z $lock ]] || exec {lock}>&-
  return 0
}

# A modem ModemManager cannot power up falls back to disabled, with its radio
# on. NetworkManager takes that for somebody turning it off, so it counts no
# failure and asks again at once: every two seconds for as long as the radio
# is on (an FCC lock nothing unlocked did that on a P1 all day, 65,000 times).
# A modem seen like that for a minute is switched off here, the way the
# switch does it, and said to be one that could not be turned on; the switch
# tries again. A gap of minutes between two looks (a sleep, a shell that was
# not running) starts the minute again.
ENABLE_GRACE=60
watch_enabling() {
  local since=0 last=0 now=${NOVA_MOBILE_NOW:-$EPOCHSECONDS}
  # On its way up and not there, while NetworkManager has it with the radio
  # on, which is what keeps asking.
  if [[ $MODEM_STATE != disabled && $MODEM_STATE != enabling ]] ||
    [[ -z $DEVICE_STATE || ${DEVICE_STATE%% *} == unavailable || ${DEVICE_STATE%% *} == unmanaged ]]; then
    rm -f -- "$TRYING"
    return 0
  fi
  [[ -r $TRYING ]] && read -r since last <"$TRYING"
  [[ $since =~ ^[0-9]+$ && $last =~ ^[0-9]+$ ]] || since=0 last=0
  ((since > 0 && now - last <= 300)) || since=$now
  if ((now - since >= ENABLE_GRACE)); then
    stop_trying noenable
    return 0
  fi
  mkdir -p -- "$STATE_DIR" 2>/dev/null && printf '%s %s\n' "$since" "$now" >"$TRYING" 2>/dev/null
  return 0
}

# Mobile data off, as the switch turns it off, and kept so with why.
stop_trying() { # why
  mkdir -p -- "$STATE_DIR" 2>/dev/null && printf '%s\n' "$1" >"$STOPPED" 2>/dev/null
  rm -f -- "$TRYING"
  if ! nm radio wwan off >/dev/null 2>&1; then
    have rfkill && rf block wwan >/dev/null 2>&1
  fi
  STATE=failed WHY=$1
  # Said in this look already, so that the widget stops asking now, not a
  # look later.
  radio_blocked && RADIO=blocked
  return 0
}

# ModemManager asked to power the modem up, as NetworkManager asks it. No
# when it answers as it does for a modem its maker locked (an FCC lock) that
# it has no unlock for: "Invalid transition", from the modem's own
# OperationNotAllowed, over MBIM and QMI alike. Anything else, a slow
# power-up among them, is not this one's to judge.
modem_powers_up() {
  local said
  said=$(mm -m "$IDX" --enable --timeout=30 2>&1) && return 0
  [[ $said == *"Invalid transition"* || $said == *OperationNotAllowed* ]] && return 1
  return 0
}

# An `mmcli -K` dump, read once into KV by key, and its keys in order. Split
# on the first colon only, so values that contain colons (IPv6) survive
# intact. The widget reads a status every few seconds, and an awk for each
# key was most of what one cost.
declare -A KV=()
KV_KEYS=() KV_DUMP=""

parse_dump() {
  local line key
  KV=() KV_KEYS=() KV_DUMP=$DUMP
  while IFS= read -r line; do
    [[ $line == *:* ]] || continue
    key=${line%%:*}
    key=${key%"${key##*[![:space:]]}"}
    [[ -n ${KV[$key]+set} ]] && continue
    line=${line#*:}
    KV[$key]=${line#"${line%%[![:space:]]*}"}
    KV_KEYS+=("$key")
  done <<<"$DUMP"
}

# One key of the dump in DUMP.
kv() {
  [[ $DUMP == "$KV_DUMP" ]] || parse_dump
  local value=${KV[$1]-}
  [[ $value != "--" ]] || value=""
  printf '%s\n' "$value"
}

# Values of a repeated `foo.value[N]` list, one per line.
kv_list() {
  [[ $DUMP == "$KV_DUMP" ]] || parse_dump
  local key
  for key in "${KV_KEYS[@]}"; do
    [[ $key == "$1"* && $key =~ \.value\[[0-9]+\] ]] && printf '%s\n' "${KV[$key]}"
  done
  return 0
}

# The honest label is the highest generation the modem reports. On 5G NSA
# (EN-DC) the list is {lte, 5gnr} — reading only the first entry prints LTE
# while you are actually on 5G.
tech_label() {
  local rank=0 label="" tech r l
  while IFS= read -r tech; do
    [[ -n $tech && $tech != "--" ]] || continue
    case ${tech,,} in
    5gnr) r=5 l="5G" ;;
    lte) r=4 l="LTE" ;;
    lte-cat-m | lte-nb-iot) r=4 l="LTE-M" ;;
    hspa-plus) r=3 l="H+" ;;
    hspa | hsdpa | hsupa | umts) r=3 l="3G" ;;
    edge | gprs | gsm) r=2 l="2G" ;;
    *) r=1 l="${tech^^}" ;;
    esac
    if ((r > rank)); then
      rank=$r
      label=$l
    fi
  done < <(kv_list "modem.generic.access-technologies")
  printf '%s' "$label"
}

signal_icon() {
  case $STATE in
  absent | disabled | locked | searching | nosim | noprofile | failed | denied)
    printf '\U000F08BF'
    ;;
  *)
    if ((SIGNAL >= 67)); then
      printf '\U000F08BE'
    elif ((SIGNAL >= 34)); then
      printf '\U000F08BD'
    elif ((SIGNAL > 0)); then
      printf '\U000F08BC'
    else
      printf '\U000F08BF'
    fi
    ;;
  esac
}

# A soft-blocked radio is a deliberate "off", not a missing modem — and while
# blocked the modem usually vanishes from mmcli entirely, so this is checked
# before anything else and the rfkill entry itself proves the hardware.
radio_blocked() {
  have rfkill || return 1
  local soft=""
  read -r _ soft _ < <(rf -n -o TYPE,SOFT list wwan 2>/dev/null) || true
  [[ $soft == blocked ]]
}

radio_present() {
  have rfkill || return 1
  [[ -n $(rf -n -o TYPE list wwan 2>/dev/null) ]]
}

# ModemManager installed but not on the system bus: its service was never
# enabled (Arch enables nothing a package brings), or it has stopped. Then
# NetworkManager sees no modem at all, and nothing here can reach one: `mmcli
# -L` fails, where with ModemManager up and no modem it only finds none.
MM_FIX="sudo systemctl enable --now ModemManager.service"

mm_stopped() {
  have mmcli || return 1
  ! mm -L >/dev/null 2>&1
}

# A physical switch, and no amount of waiting or retrying will talk it round.
radio_hard_blocked() {
  have rfkill || return 1
  [[ $(rf -n -o TYPE,HARD list wwan 2>/dev/null | awk 'NR == 1 { print $2 }') == blocked ]]
}

# Drop any bearer the modem is still holding. An MBIM modem answers the next
# connect with "Busy" while a session from the last one is open, which is
# exactly what blocking the radio under a live connection leaves behind.
modem_disconnect() {
  have mmcli || return 0
  load_dump || return 0
  mm -m "$IDX" --simple-disconnect >/dev/null 2>&1
  return 0
}

# NetworkManager reduces every activation failure to "Unknown error"; the
# reason the modem actually gave is in ModemManager's journal. Best effort —
# the journal is not readable for every user.
last_modem_error() {
  journalctl -b -u ModemManager --since "-30s" --no-pager 2>/dev/null |
    sed -n 's/.*connection attempt #[0-9]* failed: //p' | tail -n1
}

# ----------------------------------------------------------- NetworkManager

# `nmcli -t` escapes the field separator and the escape character itself inside
# a value, so a connection named "Work: SIM" comes back as "Work\: SIM".
nm_unescape() {
  sed 's/\\\(.\)/\1/g'
}

# TYPE first so the connection name — the only field that can contain a colon
# — is everything after the first one.
nm_profile() {
  local configured
  configured=$(get_cfg PROFILE)
  if [[ -n $configured ]]; then
    printf '%s' "$configured"
    return 0
  fi
  have nmcli || return 0
  local line
  while IFS= read -r line; do
    if [[ $line == gsm:* ]]; then
      line=${line#gsm:}
      printf '%s\n' "$line" | nm_unescape
      return 0
    fi
  done < <(nm -t -f TYPE,NAME connection show 2>/dev/null)
  return 0
}

nm_has_profile() {
  local name=$1 existing
  while IFS= read -r existing; do
    [[ $existing == "$name" ]] && return 0
  done < <(nm -t -f NAME connection show 2>/dev/null | nm_unescape)
  return 1
}

nm_gsm_device_name() {
  have nmcli || return 0
  nm -t -f TYPE,DEVICE device status 2>/dev/null |
    awk -F: '$1 == "gsm" && !found++ { print $2 }'
}

nm_gsm_device_state() {
  have nmcli || return 0
  local type device state
  while IFS=: read -r type device state; do
    if [[ $type == gsm ]]; then
      printf '%s\n' "${state%%:*}"
      return 0
    fi
  done < <(nm -t -f TYPE,DEVICE,STATE device status 2>/dev/null)
  return 0
}

# ------------------------------------------------------------------- meter

# NetworkManager does not accumulate usage and the kernel counters reset with
# the interface, so the billing-period total is kept here: add the delta since
# the last sample, and treat a counter that went backwards (or a new
# interface) as a fresh start rather than a negative delta.

# Sets <var> to <day>, or to the last day of <month> in <year> when that
# month is shorter.
clamp_day() { # var year month day
  local last=31
  case $3 in
  2) last=$(($2 % 4 == 0 && ($2 % 100 != 0 || $2 % 400 == 0) ? 29 : 28)) ;;
  4 | 6 | 9 | 11) last=30 ;;
  esac
  printf -v "$1" '%d' "$(($4 > last ? last : $4))"
}

# Sets PERIOD_START and PERIOD_NEXT from the configured renewal day. In
# bash, without a `date`: the widget asks for this every few seconds.
period_bounds() {
  local reset_day year month day start today=${NOVA_MOBILE_TODAY:-}
  reset_day=$(get_cfg RESET_DAY 1)
  [[ $reset_day =~ ^[0-9]+$ ]] && ((10#$reset_day >= 1 && 10#$reset_day <= 31)) || reset_day=1
  reset_day=$((10#$reset_day))

  [[ -n $today ]] || printf -v today '%(%F)T' -1
  year=$((10#${today:0:4})) month=$((10#${today:5:2}))
  clamp_day day "$year" "$month" "$reset_day"
  printf -v start '%04d-%02d-%02d' "$year" "$month" "$day"

  # Zero-padded ISO dates, so a plain lexical comparison is also chronological.
  if [[ $today < $start ]]; then
    if ((month == 1)); then year=$((year - 1)) month=12; else month=$((month - 1)); fi
    clamp_day day "$year" "$month" "$reset_day"
    printf -v start '%04d-%02d-%02d' "$year" "$month" "$day"
  fi
  PERIOD_START=$start

  if ((month == 12)); then year=$((year + 1)) month=1; else month=$((month + 1)); fi
  clamp_day day "$year" "$month" "$reset_day"
  printf -v PERIOD_NEXT '%04d-%02d-%02d' "$year" "$month" "$day"
}

meter_update() {
  period_bounds
  mkdir -p -- "$STATE_DIR" 2>/dev/null

  local current=0 rx=0 tx=0
  if [[ -n $IFACE && -r $NET_DIR/$IFACE/statistics/rx_bytes ]]; then
    rx=$(<"$NET_DIR/$IFACE/statistics/rx_bytes")
    tx=$(<"$NET_DIR/$IFACE/statistics/tx_bytes")
    [[ $rx =~ ^[0-9]+$ ]] || rx=0
    [[ $tx =~ ^[0-9]+$ ]] || tx=0
    current=$((rx + tx))
  fi

  # Serialise against the other poll cadence; a lost sample is better than a
  # torn read-modify-write. Losing the lock just means skipping this update.
  #
  # Braces around the exec: a redirection on a bare exec is applied to the
  # shell itself, so `exec {lock}>… 2>/dev/null` would silence stderr for the
  # rest of the run rather than just for the open.
  { exec {lock}>"$STATE_DIR/.lock"; } 2>/dev/null || {
    USED_BYTES=0
    return 0
  }
  flock -w 2 "$lock" 2>/dev/null || {
    exec {lock}>&-
    USED_BYTES=0
    return 0
  }

  local period="" used=0 last=0 last_iface="" key value read=" "
  if [[ -r $METER ]]; then
    while IFS='=' read -r key value; do
      [[ $read == *" $key "* ]] && continue
      case $key in
      period) period=$value ;;
      used) used=$value ;;
      last) last=$value ;;
      iface) last_iface=$value ;;
      *) continue ;;
      esac
      read+="$key "
    done <"$METER"
  fi
  [[ $used =~ ^[0-9]+$ ]] || used=0
  [[ $last =~ ^[0-9]+$ ]] || last=0

  # A new period starts the total at zero and rebaselines against the counter
  # as it stands right now — whatever it already held belongs to last period.
  if [[ $period != "$PERIOD_START" ]]; then
    used=0
    if [[ -n $IFACE ]]; then
      last=$current
      last_iface=$IFACE
    fi
  fi

  # With no interface the modem is simply gone. Carry the old baseline
  # forward untouched: rebaselining to zero here would make the next sample
  # after it returns look like the whole lifetime counter is new traffic.
  local delta=0
  if [[ -n $IFACE ]]; then
    if [[ $IFACE != "$last_iface" || $current -lt $last ]]; then
      delta=$current
    else
      delta=$((current - last))
    fi
    used=$((used + delta))
    last=$current
    last_iface=$IFACE
  fi

  if printf 'period=%s\nused=%s\nlast=%s\niface=%s\n' \
    "$PERIOD_START" "$used" "$last" "$last_iface" >"$METER.tmp" 2>/dev/null; then
    mv -f -- "$METER.tmp" "$METER" 2>/dev/null || rm -f -- "$METER.tmp"
  fi

  exec {lock}>&-
  USED_BYTES=$used
}

# ------------------------------------------------------------------- status

read_state() {
  STATE=absent HW=no MANAGED=unknown RADIO=on
  OPERATOR="" TECH="" SIGNAL=0 IFACE="" IPADDR=""
  MODEM_STATE="" WHY="" UNLOCK="" PIN_TRIES=""

  PROFILE_NAME=$(nm_profile)

  # Only a device NetworkManager can see but refuses to drive is a problem
  # worth reporting. While the modem is away there is no device at all, and
  # calling that "unmanaged" turns a normal thirty seconds into an alarm.
  DEVICE_STATE=$(nm_gsm_device_state)
  if [[ -n $DEVICE_STATE ]]; then
    if [[ ${DEVICE_STATE%% *} == unmanaged ]]; then MANAGED=no; else MANAGED=yes; fi
  fi

  if radio_present; then HW=yes; fi

  if [[ -e $PARKED ]]; then
    STATE=parked
    return 0
  fi

  # Switched off here because it could not be turned on: said so while it is
  # off. Turned on since by something else (airplane mode going off, say), it
  # is a fresh try.
  if [[ -e $STOPPED ]]; then
    if radio_blocked; then
      STATE=failed HW=yes WHY=$(<"$STOPPED") RADIO=blocked
      return 0
    fi
    rm -f -- "$STOPPED"
  fi

  if radio_blocked; then
    STATE=disabled
    HW=yes RADIO=blocked
    # Off, and it could not come on: that is worth saying while it is off.
    mm_stopped && STATE=noservice
    return 0
  fi

  # No modem on a machine that has had one is a modem on its way back, not a
  # missing one. These M.2 modems do not survive a suspend: the MHI driver
  # logs "failed to resume device", starts its own recovery, and the module
  # re-enumerates about half a minute later, at which point NetworkManager
  # autoconnects on its own. Reporting that as "No modem" next to an unlit
  # switch is what makes people flip a switch that was never off.
  if ! load_dump; then
    if [[ $HW == yes || -e $MODEM_SEEN ]] && mm_stopped; then
      STATE=noservice HW=yes
    elif [[ -e $MODEM_SEEN ]]; then
      STATE=starting
    fi
    return 0
  fi
  HW=yes
  mark_modem_seen

  OPERATOR=$(kv modem.3gpp.operator-name)
  TECH=$(tech_label)
  SIGNAL=$(kv modem.generic.signal-quality.value)
  [[ $SIGNAL =~ ^[0-9]+$ ]] || SIGNAL=0

  local port
  while IFS= read -r port; do
    if [[ $port == *" (net)" ]]; then
      IFACE=${port% (net)}
      break
    fi
  done < <(kv_list "modem.generic.ports")

  local sim
  MODEM_STATE=$(kv modem.generic.state)
  sim=$(kv modem.generic.sim)

  case $MODEM_STATE in
  locked) STATE=locked ;;
  # An empty slot, or an eSIM with no plan on it, is where ModemManager gives
  # up on a modem: "failed", with the reason beside it. So is a SIM it could
  # not read, and a modem it could not set up.
  failed)
    WHY=$(kv modem.generic.state-failed-reason)
    case $WHY in
    sim-missing | esim-without-profiles) STATE=nosim ;;
    *) STATE=failed ;;
    esac
    ;;
  disabled | disabling) STATE=disabled ;;
  initializing | enabling) STATE=starting ;;
  searching) STATE=searching ;;
  connecting) STATE=connecting ;;
  connected) STATE=connected ;;
  registered | disconnecting) STATE=disconnected ;;
  # Powered and idle is not the same as registered: the modem has a radio on
  # but no network yet, and calling that "registered, not connected" reads as
  # a working link that simply is not carrying traffic.
  enabled) STATE=searching ;;
  *) STATE=starting ;;
  esac

  # An empty slot reports the path "/". A modem still starting has not read
  # its slot yet, and no path then says nothing about the SIM: taken as an
  # empty slot, a modem that has one would be switched off.
  # An eSIM built into the modem, with no plan on it and no card in the slot,
  # has a path all the same, and some modems are then on and searching, or
  # switched off, not "failed": with nothing on it to read, it is no SIM
  # either. Switched off, that is only so where the eSIM answers as one with
  # no plan (esim_without_plan): a card can say nothing then too.
  if [[ -n $sim && $sim != "/" ]]; then
    if [[ $STATE == searching ]] && sim_blank "$sim"; then
      STATE=nosim
    elif [[ $STATE == disabled ]] && esim_without_plan "$sim"; then
      STATE=nosim
    fi
  elif [[ $STATE != disabled && $STATE != starting ]]; then
    STATE=nosim
  fi

  # Locked: by its PIN, or after three wrong ones by its PUK, and how many
  # tries are left, as "sim-pin (3)".
  if [[ $STATE == locked ]]; then
    UNLOCK=$(kv modem.generic.unlock-required)
    local retry
    while IFS= read -r retry; do
      [[ $retry =~ ^"$UNLOCK "\(([0-9]+)\)$ ]] && PIN_TRIES=${BASH_REMATCH[1]}
    done < <(kv_list "modem.generic.unlock-retries")
  fi

  # On, and turned away by every network it found: the SIM is barred.
  if [[ $STATE == searching && $(kv modem.3gpp.registration-state) == denied ]]; then
    STATE=denied
  fi

  # Nothing to connect with yet: the switch sets it up.
  if [[ -z $PROFILE_NAME && $STATE == disconnected ]]; then
    STATE=noprofile
  fi

  if [[ -n $IFACE ]]; then
    local line
    read -r line < <(LC_ALL=C ip -4 -o addr show dev "$IFACE" 2>/dev/null) || true
    if [[ $line =~ [[:space:]]inet[[:space:]]+([^/[:space:]]+) ]]; then
      IPADDR=${BASH_REMATCH[1]}
    fi
  fi
}

cmd_info() {
  read_state
  if [[ $STATE == parked ]] && look_while_parked; then
    read_state
  fi
  park_without_sim
  set_up_for_sim
  watch_enabling
  # Kept off: airplane mode going off, say, unblocks every radio at once.
  if [[ $STATE == parked ]] && ! radio_blocked; then
    have rfkill && rf block wwan >/dev/null 2>&1
  fi
  meter_update

  printf 'hw=%s\n' "$HW"
  printf 'state=%s\n' "$STATE"
  # Off at the radio, the switch's off: only an rfkill change brings it back,
  # so the widget listens for one and asks nothing meanwhile. ModemManager's
  # own disabled, or failed, with the radio on, is not that.
  [[ $RADIO != blocked ]] || printf 'radio=blocked\n'
  # Why it is off, while it is kept off: nosim.
  [[ $STATE != parked ]] || printf 'parked=%s\n' "$(parked_reason)"
  # Why it failed: noenable (it could not be turned on), or ModemManager's
  # reason, sim-error say.
  [[ $STATE != failed ]] || printf 'why=%s\n' "$WHY"
  # Locked: sim-pin or sim-puk, and the tries left.
  [[ $STATE != locked ]] || printf 'unlock=%s\npin_tries=%s\n' "$UNLOCK" "$PIN_TRIES"
  printf 'managed=%s\n' "$MANAGED"
  printf 'profile=%s\n' "$PROFILE_NAME"
  printf 'operator=%s\n' "$OPERATOR"
  printf 'tech=%s\n' "$TECH"
  printf 'signal=%s\n' "$SIGNAL"
  printf 'iface=%s\n' "$IFACE"
  printf 'ip=%s\n' "$IPADDR"
  printf 'icon=%s\n' "$(signal_icon)"
  printf 'used_bytes=%s\n' "$USED_BYTES"
  printf 'next_reset=%s\n' "$PERIOD_NEXT"

  # Byte counters and an interface-bound ping cost real time — the ping alone
  # can burn its full 1 s timeout — so the widget asks for them only while it
  # is showing the panel or keeping its stats window warm.
  if [[ ${1:-} == --verbose && -n $IFACE ]]; then
    if [[ -r $NET_DIR/$IFACE/statistics/rx_bytes ]]; then
      printf 'rx_bytes=%s\n' "$(<"$NET_DIR/$IFACE/statistics/rx_bytes")"
      printf 'tx_bytes=%s\n' "$(<"$NET_DIR/$IFACE/statistics/tx_bytes")"
    fi
    # Bound to the modem's interface: the default route is normally Wi-Fi, and
    # an unbound ping would measure the wrong link entirely.
    if [[ $STATE == connected ]] && have ping; then
      local line ms=""
      while read -r line; do
        if [[ $line =~ time[=\<]([0-9.]+) ]]; then
          ms=${BASH_REMATCH[1]}
          break
        fi
      done < <(LC_ALL=C ping -n -c 1 -W 1 -I "$IFACE" 1.1.1.1 2>/dev/null || true)
      printf 'ping_ms=%s\n' "$ms"
    fi
  fi
}

cmd_status() {
  read_state
  case $STATE in
  parked) echo "Off: no SIM. One put in brings it back; Settings > Mobile Data, or mobile-data check, looks again." ;;
  absent) echo "No WWAN modem detected." ;;
  noservice) echo "ModemManager is not running, so the modem cannot be used: $MM_FIX" ;;
  disabled) echo "Mobile data: off" ;;
  nosim) echo "No SIM." ;;
  failed)
    if [[ $WHY == sim-error ]]; then
      echo "The SIM could not be read."
    else
      echo "The modem could not be turned on, so mobile data is off; nova doctor says why. mobile-data on tries again."
    fi
    ;;
  locked)
    if [[ $UNLOCK == sim-puk ]]; then
      echo "The SIM is blocked after three wrong PINs: it needs the PUK from your carrier."
    else
      echo "The SIM needs its PIN${PIN_TRIES:+ ($PIN_TRIES tries left)}: Settings > Mobile Data, or mobile-data pin."
    fi
    ;;
  denied) echo "The network refused this SIM." ;;
  noprofile) echo "Not set up yet: mobile-data on sets it up and connects." ;;
  starting) echo "Modem starting — it comes back about half a minute after sleep." ;;
  searching) echo "Searching for a network…" ;;
  connecting) echo "Connecting…" ;;
  disconnected) echo "Registered on ${OPERATOR:-unknown}, not connected." ;;
  connected) echo "Connected to ${OPERATOR:-unknown} on ${TECH:-?} at ${SIGNAL}% (${IPADDR:-no address})." ;;
  *) echo "Modem starting…" ;;
  esac
}

# ------------------------------------------------------------------ control

require_nmcli() {
  have nmcli ||
    die "nmcli not found — this plugin needs NetworkManager"
}

# NetworkManager can call the device "disconnected" while the modem behind it
# is still enabling, searching for a network, or registering. Activating then
# is a guaranteed refusal, so wait for the modem's own state as well. Not
# powered up yet, it is asked to, once, and a modem that cannot be is said
# at once (2), as are a locked SIM (3) and a modem ModemManager gave up on
# (4), rather than waited out to the end of the budget.
wait_for_modem() {
  local timeout=$1 deadline state asked=0
  have mmcli || return 0
  deadline=$((SECONDS + timeout))
  while :; do
    if load_dump; then
      state=$(kv modem.generic.state)
      case $state in
      registered | connected | connecting) return 0 ;;
      locked) return 3 ;;
      failed) return 4 ;;
      disabled | enabling)
        if ((!asked)); then
          asked=1
          modem_powers_up || return 2
        fi
        ;;
      esac
    fi
    ((SECONDS < deadline)) || return 1
    sleep 1
  done
}

# Wait for the gsm device to reach one of the listed states. nmcli spells
# transient states out in full — "connecting (getting IP configuration)" — so
# only the first word is compared.
wait_for_state() {
  local wanted=" $1 " timeout=$2 deadline state
  deadline=$((SECONDS + timeout))
  while :; do
    state=$(nm_gsm_device_state)
    [[ $wanted == *" ${state%% *} "* ]] && return 0
    ((SECONDS < deadline)) || return 1
    sleep 1
  done
}

NO_POWER_UP="the modem could not be turned on, so mobile data is off again"

cmd_on() {
  [[ ! -e $PARKED ]] || die "the modem is off because no SIM was found — mobile-data check looks again"
  require_nmcli
  ! mm_stopped || die "ModemManager is not running: $MM_FIX"
  local profile timeout deadline left reason="" ready=0
  # A try of its own, whatever stopped the last.
  rm -f -- "$STOPPED" "$TRYING"
  profile=$(nm_profile)

  radio_hard_blocked && die "the WWAN radio is off at the hardware switch"

  # One budget for the whole command, not per step. `nmcli connection up` blocks
  # for its own 90 s before reporting failure, so retries that each waited that
  # long would leave a bar toggle spinning for minutes.
  timeout=$(cfg_number ON_TIMEOUT 90)
  deadline=$((SECONDS + timeout))

  nm radio wwan on >/dev/null 2>&1

  # On most laptops the WWAN rfkill switch cuts power to the module, so coming
  # back means a firmware boot and a fresh network registration. Half a minute
  # is ordinary; the old 25 s ceiling gave up while the modem was on its way.
  if ! wait_for_state "connected disconnected connecting" $((deadline - SECONDS)); then
    read_state
    die "the modem did not become available within ${timeout}s (state: $STATE)"
  fi

  [[ $(nm_gsm_device_state) == connected ]] && return 0

  # NetworkManager autoconnects the instant the modem appears — after a
  # suspend it is usually already mid-activation by the time anyone asks. Our
  # own `connection up` would be a second activation request, which tears the
  # first one down and starts the clock again, so let an attempt in flight
  # finish before deciding anything.
  local device_state
  device_state=$(nm_gsm_device_state)
  if [[ ${device_state%% *} == connecting ]]; then
    wait_for_state "connected disconnected" $((deadline - SECONDS)) || true
    [[ $(nm_gsm_device_state) == connected ]] && return 0
  fi

  # NetworkManager calls the device disconnected as soon as it exists, while
  # the modem behind it may still be enabling or searching. Activating then is
  # a refusal every time, so wait for the modem to reach the network first.
  wait_for_modem $((deadline - SECONDS)) || ready=$?
  case $ready in
  2)
    stop_trying noenable
    die "$NO_POWER_UP"
    ;;
  3) die "the SIM needs its PIN: Settings > Mobile Data asks for it" ;;
  4)
    read_state
    [[ $STATE != nosim ]] || die "there is no SIM in the slot"
    die "the SIM could not be read"
    ;;
  esac

  # Nothing to connect with yet: made now, as a phone does it, with the APN
  # looked up for the SIM. NetworkManager may take it up by itself, at once.
  if [[ -z $profile ]]; then
    cmd_setup >/dev/null || die "could not set mobile data up"
    profile=$(nm_profile)
    sleep 1
    if [[ $(nm_gsm_device_state) == connecting* ]]; then
      wait_for_state "connected disconnected" $((deadline - SECONDS)) || true
    fi
    [[ $(nm_gsm_device_state) == connected ]] && return 0
  fi

  while :; do
    left=$((deadline - SECONDS))
    # Always give an attempt a fair run rather than a token one.
    ((left < 20)) && left=20
    nm --wait "$left" connection up "$profile" >/dev/null 2>&1 && return 0
    reason=$(last_modem_error)
    ((SECONDS < deadline)) || break
    # The usual reason for a refusal is a session the modem is still holding
    # from last time. Drop it and ask again with whatever budget is left.
    modem_disconnect
    sleep 3
  done

  # Say what the modem was actually doing. NetworkManager reports every one of
  # these as "Unknown error", and most of them are conditions no retry fixes.
  read_state
  case $STATE in
  nosim) die "there is no SIM in the slot" ;;
  locked) die "the SIM needs its PIN: Settings > Mobile Data asks for it" ;;
  esac
  # Never powered up: no retry here mends that, and NetworkManager's would
  # go on for ever.
  if [[ $MODEM_STATE == disabled || $MODEM_STATE == enabling ]]; then
    stop_trying noenable
    die "$NO_POWER_UP"
  fi

  local registration
  registration=$(kv modem.3gpp.registration-state)
  case $registration in
  idle | searching)
    die "the modem is not registered on a network yet (signal ${SIGNAL}%)"
    ;;
  denied)
    die "the network refused to register this SIM for data"
    ;;
  esac

  case $reason in
  Busy | RadioPowerOff)
    die "the modem refused the connection ($reason); it needs a power cycle: mobile-data reset"
    ;;
  esac
  # The APN, or the plan behind it: what Settings asks for an APN at (exit 3).
  local apn
  apn=$(profile_apn "$profile")
  case ${reason,,} in
  *apn* | *accessstring* | *"access string"*)
    die_apn "the network does not know the APN${apn:+ \"$apn\"}: Settings > Mobile Data takes another"
    ;;
  *authentication*)
    die_apn "the network refused the APN's user name or password: Settings > Mobile Data takes another APN"
    ;;
  *subscribed*)
    die_apn "the network refused data for this SIM: it has no data plan, or needs another APN (Settings > Mobile Data)"
    ;;
  esac
  die "could not bring up '$profile'${reason:+ ($reason)}"
}

# A refusal Settings answers with a field for the APN.
die_apn() {
  printf 'mobile-data: %s\n' "$*" >&2
  exit 3
}

# `nmcli radio wwan off` is the honest off switch: it soft-blocks the radio, so
# NetworkManager will not autoconnect around it the way it does after a plain
# `connection down`.
#
# The session is torn down first. Cutting the radio out from under a live
# bearer leaves that session open inside the modem, and every connect after
# that comes back "Busy" until the module is power-cycled — which is a toggle
# that turns off and then will not turn back on.
cmd_off() {
  require_nmcli
  local device
  device=$(nm_gsm_device_name)
  if [[ -n $device ]]; then
    nm device disconnect "$device" >/dev/null 2>&1
    wait_for_state "disconnected unavailable unmanaged" 15
  fi
  modem_disconnect
  nm radio wwan off >/dev/null || die "could not turn the radio off"
}

# The escape hatch for a modem that has wedged anyway. Neither dropping its
# bearers nor a ModemManager reset clears an MBIM session the firmware still
# believes in; cutting the radio power-cycles the module, which does.
cmd_reset() {
  require_nmcli
  local deadline
  echo "Powering the modem down…"
  modem_disconnect
  nm radio wwan off >/dev/null || die "could not turn the radio off"

  # Give the module its moment with the radio down. Some leave the bus and
  # come back with a new index; this ThinkPad's stays enumerated throughout,
  # so this waits for either and settles for a short pause otherwise.
  deadline=$((SECONDS + 15))
  while ((SECONDS < deadline)); do
    have mmcli || break
    [[ -z $(mm -L 2>/dev/null | sed -n 's|.*/Modem/[0-9].*|found|p') ]] && break
    load_dump || break
    case $(kv modem.generic.state) in
    disabled | disabling | failed | "") break ;;
    esac
    sleep 1
  done
  rm -f "$MODEM_CACHE"

  echo "Powering it back up…"
  cmd_on
  echo "Connected."
}

# What Settings > Mobile Data runs, to look for a SIM. A parked modem's slot
# is read where it is, in low power: a SIM there brings it back, and none
# leaves it off, the radio never on. Where blocking the radio cuts the
# modem's power there is nothing to ask while it is parked: it is switched
# on to look, reads its slot about half a minute after it boots, and with
# nothing there is off again. With a SIM it stays on, back in the bar.
cmd_check() {
  local timeout deadline found=""
  # Nothing to look with: refused before anything changes, and above all
  # before an answer that never comes is taken for an empty slot.
  have mmcli || die "looking for a SIM needs ModemManager"
  ! mm_stopped || die "looking for a SIM needs ModemManager running: $MM_FIX"
  radio_hard_blocked && die "the WWAN radio is off at the hardware switch"
  load_dump && found=$(sim_in_slot)
  if [[ -z $found ]]; then
    unpark
    timeout=$(cfg_number CHECK_TIMEOUT 90)
    deadline=$((SECONDS + timeout))
    while :; do
      load_dump && found=$(sim_in_slot)
      [[ -z $found ]] || break
      if ((SECONDS >= deadline)); then
        park nosim
        die "the modem did not answer within ${timeout}s; it is off again"
      fi
      sleep 2
    done
  fi
  if [[ $found == no ]]; then
    park nosim
    die "there is no SIM in the slot; the modem is off"
  fi
  unpark
  mark_modem_seen
  echo "There is a SIM: mobile data is back in the bar."
}

cmd_toggle() {
  read_state
  case $STATE in
  connected | connecting) cmd_off ;;
  *) cmd_on ;;
  esac
}

# ---------------------------------------------------------------------- sms
#
# ModemManager leaves a received message in the modem's own storage, and that
# storage is small — a couple of dozen slots on a SIM. Once it is full the
# network stops delivering, so `sms poll` is the whole lifecycle in one
# command: read what has arrived, file it in an archive of our own, say so,
# and only then delete it from the modem. Filed before deleted, always — the
# copy on the SIM is the only other one there is.

# Toasts in one pass. More than this is a backlog — a shell that has not run
# since yesterday, a SIM out of a drawer — and one popup per message would
# bury the screen; a backlog gets a single line instead.
SMS_BURST=3

# mmcli prints message text through GLib's g_strescape: C escapes for the
# usual control characters, three-digit octal for every byte outside printable
# ASCII. So a message arrives on one line whatever it contains, and is kept
# that way — which is what makes one archived message one line, and what stops
# a message with a newline in it from becoming two.
sms_unescape() {
  local text=$1
  # A raw \001 cannot occur in escaped text — it would itself have been
  # escaped — so it stands in for an escaped backslash while the octal runs
  # are rewritten into the \0NNN form printf understands. Without that step
  # the digits after a literal backslash would be read as part of one.
  text=${text//\\\\/$'\001'}
  text=${text//\\\"/\"}
  text=$(sed 's/\\\([0-7][0-7][0-7]\)/\\0\1/g' <<<"$text")
  text=${text//$'\001'/\\\\}
  printf '%b' "$text"
}

# A message is bytes from a network and every one of them is someone else's
# choice. An ESC that reaches a terminal is a control sequence, not a
# character. Tab and newline are text and stay.
sms_printable() {
  LC_ALL=C tr -d '\000-\010\013-\037\177'
}

# The sender is network-supplied too. It goes in a notification headline,
# where a leading dash would be read as an option, and into a text item that
# auto-detects markup. A GSM alphanumeric sender is letters and digits, so
# nothing real is lost by holding it to that.
sms_sender() {
  local sender
  sender=$(sms_unescape "$1" | LC_ALL=C tr -d '\000-\037\177<>&' | sed 's/^-*//')
  printf '%s' "${sender:-Unknown}"
}

# Today is a time, anything older is a date: a message from this morning and
# one from last month want different halves of the same stamp.
sms_when() {
  local stamp
  stamp=$(date -d "$1" +%s 2>/dev/null)
  [[ $stamp =~ ^-?[0-9]+$ ]] || {
    printf '%s' "?"
    return 0
  }
  if [[ $(date -d "@$stamp" +%F) == $(date +%F) ]]; then
    date -d "@$stamp" +%H:%M
  else
    date -d "@$stamp" '+%b %-d'
  fi
}

sms_stamp() {
  local stamp
  stamp=$(date -d "$1" +%s 2>/dev/null)
  [[ $stamp =~ ^-?[0-9]+$ ]] || {
    printf '%s' "$1"
    return 0
  }
  date -d "@$stamp" '+%F %H:%M'
}

# id, a hash of the message for the duplicate check, when it was sent, who
# sent it, and the text exactly as mmcli escaped it — tab-separated, oldest
# line first. Only the last field can hold anything unusual, and it is still
# escaped, so it can contain neither a tab nor a newline.
sms_hash() {
  printf '%s\t%s\t%s' "$1" "$2" "$3" | md5sum | cut -d' ' -f1
}

sms_is_archived() {
  [[ -r $INBOX ]] || return 1
  # The hash is hex from md5sum, so it carries nothing awk would reinterpret.
  awk -F'\t' -v hash="$1" '$2 == hash { found = 1; exit } END { exit !found }' "$INBOX"
}

sms_archive() {
  local hash=$1 date=$2 number=$3 text=$4 id keep count
  keep=$(cfg_number SMS_KEEP 200)
  mkdir -p -- "$STATE_DIR" 2>/dev/null || return 1
  if [[ ! -f $INBOX ]]; then
    (
      umask 077
      : >"$INBOX"
    ) || return 1
  fi

  # END sees the last record, and runs on an empty file too.
  id=$(awk -F'\t' 'END { print ($1 ~ /^[0-9]+$/) ? $1 + 1 : 1 }' "$INBOX")
  printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$hash" "$date" "$number" "$text" >>"$INBOX" || return 1

  # Keep the tail. The archive is also the duplicate check, so it is never
  # trimmed to nothing: a message still sitting on the modem whose line had
  # been dropped would be announced all over again. The copy that replaces it
  # is as private as the archive was made.
  count=$(wc -l <"$INBOX")
  if [[ $count =~ ^[0-9]+$ ]] && ((count > keep)); then
    (
      umask 077
      rm -f -- "$INBOX.tmp" && tail -n "$keep" "$INBOX" >"$INBOX.tmp"
    ) 2>/dev/null &&
      mv -f -- "$INBOX.tmp" "$INBOX" 2>/dev/null || rm -f -- "$INBOX.tmp"
  fi
  return 0
}

# Nova renders a notification body as StyledText, so an unescaped & or <
# in a message loses characters or swallows the rest of the line.
#
# nova-notification-send hands the server typed D-Bus arguments instead of
# going through notify-send's argv parsing, which is the surface that would
# read a message beginning with `--hint=` as options. notify-send is the
# fallback for a desktop that is not Nova's.
sms_notify() {
  local headline=$1 body=$2
  # The backslashes are load-bearing: since bash 5.2 an unquoted & in the
  # replacement half of a substitution stands for the text that matched, so
  # ${body//</&lt;} would turn < into <lt; rather than into &lt;.
  body=${body//&/\&amp;}
  body=${body//</\&lt;}
  body=${body//>/\&gt;}
  # The description is the one word after the headline that is no option; a
  # message that is only "-r" or "--exec" would be taken for one and lost.
  [[ $body != -* ]] || body=" $body"
  if have nova-notification-send; then
    nova-notification-send --app-name "Mobile Data" -u normal \
      -g "$(printf '\U000F0361')" "$headline" "$body" >/dev/null 2>&1
  elif have notify-send; then
    notify-send -a "Mobile Data" -u normal -- "$headline" "$body" >/dev/null 2>&1
  fi
  return 0
}

# Who a backlog is from, for the one line it gets instead of a toast each.
# Repeats collapse — five from the same operator is one name.
sms_senders_line() {
  local sender out="" seen=""
  for sender in "$@"; do
    [[ $seen == *"|$sender|"* ]] && continue
    seen="$seen|$sender|"
    out="${out:+$out, }$sender"
  done
  ((${#out} > 60)) && out="${out:0:59}…"
  printf '%s' "$out"
}

cmd_sms_poll() {
  have mmcli || die "mmcli not found — this plugin needs ModemManager"
  mkdir -p -- "$STATE_DIR" 2>/dev/null

  # One pump at a time. The widget polls on its own cadence, a modem holding a
  # backlog can leave a run still going when the next tick arrives, and two
  # runs reading the same message would announce it twice. Losing the race
  # just means waiting for the next tick.
  local lock
  # Braces around the exec, not a bare `exec ... 2>/dev/null`: a redirection on
  # a bare exec is applied to the shell itself, and would silence stderr for
  # the rest of the run.
  { exec {lock}>"$SMS_LOCK"; } 2>/dev/null || return 0
  flock -n "$lock" 2>/dev/null || {
    exec {lock}>&-
    return 0
  }

  local -a senders=() bodies=()
  local paths path pdu state number text date hash body count i

  # No modem is nothing to read: the store is inside it, and while the radio
  # is blocked it is not there at all.
  if load_dump; then
    paths=$(mm -m "$IDX" --messaging-list-sms 2>/dev/null |
      sed -n 's|^[[:space:]]*\(/org/freedesktop/ModemManager1/SMS/[0-9][0-9]*\).*|\1|p')

    while IFS= read -r path; do
      [[ -n $path ]] || continue
      # kv reads whatever is in DUMP, so this replaces the modem's dump with
      # the message's. Nothing below wants the modem's again.
      DUMP=$(mm -s "$path" -K 2>/dev/null) || continue
      parse_dump

      pdu=$(kv sms.properties.pdu-type)
      state=$(kv sms.properties.state)
      # Received, and whole: a multipart message still missing parts reads as
      # `receiving`, and MM assembles it before it says otherwise. A draft or
      # something sent from this modem is not ours to announce or to delete.
      [[ $pdu == deliver && $state == received ]] || continue

      number=$(kv sms.content.number)
      text=$(kv sms.content.text)
      date=$(kv sms.properties.timestamp)
      # Not every network stamps a message. Ours is worse than the sender's
      # but better than a blank column.
      [[ -n $date ]] || date=$(date +%FT%T%:z)

      hash=$(sms_hash "$date" "$number" "$text")
      if ! sms_is_archived "$hash"; then
        # Filed first, and the delete skipped entirely if filing failed: until
        # this line is written the modem holds the only copy there is.
        sms_archive "$hash" "$date" "$number" "$text" || continue
        body=$(sms_unescape "$text" | sms_printable)
        senders+=("$(sms_sender "$number")")
        # A data-only message — a WAP push, an operator configuration SMS —
        # has nothing to show, but the fact that it arrived is still worth a
        # line rather than an empty toast.
        bodies+=("${body:-(no text)}")
      fi

      # Off the modem now that it is somewhere safer. A store nobody empties
      # fills up, and a full store is a phone that has stopped receiving.
      mm -m "$IDX" --messaging-delete-sms="$path" >/dev/null 2>&1
    done <<<"$paths"
  fi

  exec {lock}>&-

  count=${#senders[@]}
  ((count > 0)) || return 0
  if ((count > SMS_BURST)); then
    sms_notify "$count new messages" "$(sms_senders_line "${senders[@]}")"
  else
    for ((i = 0; i < count; i++)); do
      sms_notify "${senders[i]}" "${bodies[i]}"
    done
  fi
  return 0
}

cmd_sms_list() {
  [[ -s $INBOX ]] || {
    echo "No messages."
    return 0
  }

  local width room id hash date number text
  width=$(tput cols 2>/dev/null)
  [[ $width =~ ^[0-9]+$ ]] && ((width > 48)) || width=80
  room=$((width - 31))

  # Newest first: the one worth reading is the one that just arrived. The
  # tabs are read as unit separators, as bash runs empty tab fields together
  # and a message can come without a number.
  while IFS=$'\x1f' read -r id hash date number text; do
    text=$(sms_unescape "$text" | sms_printable | tr '\n\t' '  ')
    ((${#text} > room)) && text="${text:0:room - 1}…"
    printf '%4s  %-14.14s %-7s %s\n' \
      "$id" "$(sms_sender "$number")" "$(sms_when "$date")" "$text"
  done < <(tac -- "$INBOX" | tr '\t' '\037')
}

cmd_sms_show() {
  local want=${1:-} id hash date number text
  [[ $want =~ ^[0-9]+$ ]] || die "usage: mobile-data sms show <id>"
  [[ -s $INBOX ]] || die "there are no messages"

  while IFS=$'\x1f' read -r id hash date number text; do
    [[ $id == "$want" ]] || continue
    printf 'From: %s\n' "$(sms_sender "$number")"
    printf 'Date: %s\n\n' "$(sms_stamp "$date")"
    printf '%s\n' "$(sms_unescape "$text" | sms_printable)"
    return 0
  done < <(tr '\t' '\037' <"$INBOX")
  die "no message with id $want — try: mobile-data sms list"
}

cmd_sms_clear() {
  # The archive, and only the archive. Whatever is still on the modem is a
  # message this has never seen, and not ours to throw away.
  local lock=""
  mkdir -p -- "$STATE_DIR" 2>/dev/null
  if { exec {lock}>"$SMS_LOCK"; } 2>/dev/null; then
    flock -w 5 "$lock" 2>/dev/null
  fi
  rm -f -- "$INBOX"
  [[ -n $lock ]] && exec {lock}>&-
  echo "Cleared the message archive."
}

cmd_sms() {
  local sub=${1:-list}
  (($# > 0)) && shift
  case $sub in
  list | ls) cmd_sms_list ;;
  show | read) cmd_sms_show "${1:-}" ;;
  poll | fetch) cmd_sms_poll ;;
  clear) cmd_sms_clear ;;
  *) die "unknown sms command: $sub — try: mobile-data sms list|show|poll|clear" ;;
  esac
}

# -------------------------------------------------------------------- setup

# The APN for the SIM in the modem, as GNOME's assistant finds one: in
# mobile-broadband-provider-info, by the network the SIM belongs to (its MCC
# and MNC, which ModemManager reads off it), else by the network it is on.
# "apn<US>user<US>password" (US the unit separator, as a user or password
# may be empty), or nothing when the database has none.
lookup_apn() {
  local sim code codes=()
  load_dump || return 1
  sim=$(kv modem.generic.sim)
  if [[ -n $sim && $sim != / ]]; then
    codes+=("$(mm -i "$sim" -K 2>/dev/null | sed -n 's/^sim\.properties\.operator-code *: *\([0-9]*\)$/\1/p')")
  fi
  codes+=("$(kv modem.3gpp.operator-code)")
  for code in "${codes[@]}"; do
    [[ $code =~ ^[0-9]{5,6}$ ]] || continue
    apn_for "${code:0:3}" "${code:3}" && return 0
  done
  return 1
}

# The first APN for the internet of the provider with the network <mcc>
# <mnc>: the one marked primary, else the only one. Carriers that share a
# network with others (Vodafone's, under a dozen brands of their own) have no
# APN to guess, and get the network's own. An APN that says nothing of what
# it is for counts as the internet's.
apn_for() { # mcc mnc
  [[ -r $PROVIDERS ]] || return 1
  local found
  found=$(awk -v mcc="$1" -v mnc="$2" '
    function attr(name,   rest) {
      rest = $0
      if (!sub(".*[ \t]" name "=\"", "", rest)) return ""
      sub("\".*", "", rest)
      return rest
    }
    function text(tag,   rest) {
      rest = $0
      sub(".*<" tag ">", "", rest)
      sub("</" tag ">.*", "", rest)
      return rest
    }
    /<provider[ >]/ { primary = ($0 ~ /primary="true"/); ours = 0; pick = ""; inapn = 0 }
    /<network-id / && attr("mcc") == mcc && attr("mnc") == mnc { ours = 1 }
    /<apn value=/ { inapn = 1; apn = attr("value"); use = ""; user = ""; pass = "" }
    inapn && /<usage type=/ { use = attr("type") }
    inapn && /<username>/ { user = text("username") }
    inapn && /<password>/ { pass = text("password") }
    # An APN with nothing in it closes itself: <apn value="internet"/>.
    /<\/apn>/ || /<apn value=[^>]*\/>/ {
      if (inapn && pick == "" && (use == "" || use == "internet")) pick = apn "\037" user "\037" pass
      inapn = 0
    }
    /<\/provider>/ && ours && pick != "" {
      if (primary) { first = pick; count = 1; exit }
      if (first == "") first = pick
      count++
    }
    END { if (count == 1) print first }
  ' "$PROVIDERS")
  [[ -n $found ]] || return 1
  printf '%s\n' "$found"
}

# The APN the profile is set to, "" for the network's own.
profile_apn() { # profile
  nm -g gsm.apn connection show "$1" 2>/dev/null | sed -n 1p
}

cmd_setup() {
  require_nmcli
  local apn=${1:-} profile metric found user="" pass=""
  # The profile already driven (the configured one, or the first gsm profile
  # NetworkManager has), so that one made by hand is set up, not a second
  # one made beside it; `mobile` only when there is none.
  profile=$(nm_profile)
  [[ -n $profile ]] || profile=mobile
  metric=$(get_cfg ROUTE_METRIC 700)
  [[ $metric =~ ^[0-9]+$ ]] || metric=700

  if nm_has_profile "$profile"; then
    echo "Refreshing the existing '$profile' profile."
  else
    echo "Creating the '$profile' profile."
    nm connection add type gsm ifname '*' con-name "$profile" \
      connection.autoconnect yes >/dev/null ||
      die "could not create the '$profile' profile"
  fi

  # Above the Wi-Fi metric so mobile data only carries traffic when nothing
  # better has a default route. Nova's Wi-Fi sits at 600.
  nm connection modify "$profile" \
    connection.autoconnect yes \
    ipv4.route-metric "$metric" \
    ipv6.route-metric "$metric" >/dev/null ||
    die "could not configure '$profile'"

  # Named, it is that one. Not, it is looked up for the SIM; and with none to
  # be found, the network's own, which most of them give a SIM that asks for
  # none. Settings asks for one only if the network then says no.
  if [[ -z $apn ]] && found=$(lookup_apn); then
    IFS=$'\037' read -r apn user pass <<<"$found"
  fi
  nm connection modify "$profile" gsm.auto-config no gsm.apn "$apn" \
    gsm.username "$user" gsm.password "$pass" >/dev/null ||
    die "could not set the APN"
  if [[ -n $apn ]]; then echo "APN: $apn"; else echo "APN: none, the network gives its own"; fi

  set_cfg PROFILE "$profile" || die "could not write $CONFIG"
  echo "Done. Autoconnect is on and the route metric is $metric."
}

# Which NetworkManager profile this plugin drives. Without this the only way
# to move it off the profile `setup` happened to create was editing the config
# file by hand, which is not a setting if you cannot set it.
cmd_profile() {
  local name=${1:-} type
  if [[ -z $name ]]; then
    printf '%s\n' "$(nm_profile)"
    return 0
  fi
  require_nmcli
  nm_has_profile "$name" || die "no connection named '$name'"
  type=$(nm -t -f connection.type connection show "$name" 2>/dev/null |
    sed -n 's/^connection\.type://p' | sed -n 1p)
  [[ $type == gsm ]] || die "'$name' is a ${type:-non-gsm} connection, not a mobile one"
  set_cfg PROFILE "$name" || die "could not write $CONFIG"
  echo "Now driving the '$name' profile."
}

# With no APN, the one set now ("" for the network's own); with one, that
# one, on the profile made for it if there is none yet.
cmd_apn() {
  require_nmcli
  local apn=${1:-} profile
  profile=$(nm_profile)
  if [[ -z $apn ]]; then
    [[ -z $profile ]] || profile_apn "$profile"
    return 0
  fi
  if [[ -z $profile ]]; then
    cmd_setup "$apn" >/dev/null || exit 1
    profile=$(nm_profile)
  fi
  nm connection modify "$profile" gsm.auto-config no gsm.apn "$apn" \
    gsm.username "" gsm.password "" >/dev/null ||
    die "could not set the APN"
  echo "APN set to $apn on '$profile'."
}

# The PIN to the SIM <path> over the system bus, read from the standard
# input: nova-sim-pin (nova-sessiond under that name), rather than mmcli,
# which takes it as an argument any process could read while it runs. An
# error is its D-Bus name and message, as mmcli says it.
send_pin() { # sim path
  nova-sim-pin "$1"
}

# The SIM's PIN, from the standard input, never in any process's arguments.
# The last try is given only with --last-try: a wrong PIN then blocks the SIM
# until the carrier's PUK. Then mobile data comes on, as NetworkManager gave
# up asking for the PIN itself.
cmd_pin() {
  local pin said sim
  IFS= read -r pin || true
  [[ $pin =~ ^[0-9]{4,8}$ ]] || die "a PIN is 4 to 8 digits"
  load_dump || die "the modem is not there"
  sim=$(kv modem.generic.sim)
  [[ -n $sim && $sim != / ]] || die "there is no SIM in the slot"
  read_state
  [[ $PIN_TRIES != 1 || ${1:-} == --last-try ]] ||
    die "one try is left, and a wrong PIN blocks the SIM: mobile-data pin --last-try gives it"
  if ! said=$(send_pin "$sim" <<<"$pin" 2>&1); then
    read_state
    if [[ $UNLOCK == sim-puk ]]; then
      die "the SIM is blocked after three wrong PINs: it needs the PUK from your carrier"
    elif [[ $said == *[Ii]ncorrect* || $said == *[Ww]rong* ]]; then
      die "that is not the PIN${PIN_TRIES:+: $PIN_TRIES tries left}"
    fi
    die "the SIM did not take the PIN"
  fi
  echo "The SIM is unlocked."
  cmd_on
}

cmd_reset_day() {
  local day=${1:-}
  [[ -n $day ]] || die "usage: mobile-data reset-day <1-31>"
  [[ $day =~ ^[0-9]+$ ]] && ((10#$day >= 1 && 10#$day <= 31)) ||
    die "the renewal day must be 1-31"
  set_cfg RESET_DAY "$((10#$day))" || die "could not write $CONFIG"
  period_bounds
  echo "Usage counter renews on day $((10#$day)) — next reset $PERIOD_NEXT."
}

# Read from the manifest next to this script, so there is one version to bump.
# BASH_SOURCE, not $0: the CLI is normally reached through a symlink on PATH.
cmd_version() {
  local self plugin_dir version=""
  self=$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null) || self=""
  plugin_dir=${self%/bin/*}
  if [[ -n $plugin_dir && -r $plugin_dir/manifest.json ]]; then
    version=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
      "$plugin_dir/manifest.json" | sed -n 1p)
  fi
  printf 'mobile-data %s\n' "${version:-unknown}"
}

usage() {
  cat <<'USAGE'
mobile-data — mobile broadband status and control for the Nova bar widget.

Usage:
  mobile-data info [--verbose]   key=value status block for the widget
  mobile-data status             one human-readable line
  mobile-data on | off | toggle  radio and connection control
  mobile-data enable | disable   aliases for on and off
  mobile-data reset              power-cycle a modem that refuses to connect
  mobile-data check              look for a SIM now, for a modem kept off for
                                 want of one
  mobile-data pin [--last-try]   unlock the SIM with the PIN on standard input,
                                 then turn mobile data on; the last try only
                                 with --last-try
  mobile-data setup [APN]        create or refresh the NetworkManager profile
  mobile-data profile [name]     show or choose the NetworkManager profile
  mobile-data apn [APN]          show or change the APN on the profile
  mobile-data reset-day <1-31>   billing day for the usage counter
  mobile-data version            print the plugin version

Text messages:
  mobile-data sms list           messages received, newest first
  mobile-data sms show <id>      one message in full
  mobile-data sms poll           file and announce what has arrived
  mobile-data sms clear          empty the local archive

`poll` is what the widget runs: every message it finds is written to the
archive and announced, then deleted from the modem so its small store cannot
fill up and stop the network delivering.

Config file (key=value per line):
  ~/.config/nova-mobile-data/config
    PROFILE=mobile        NetworkManager gsm profile to drive
    RESET_DAY=1           day of month the usage counter renews
    ROUTE_METRIC=700      route metric written by `setup`
    ON_TIMEOUT=90         seconds `on` may spend bringing the modem up
    CHECK_TIMEOUT=90      seconds `check` waits for the modem to read its slot
    SMS_KEEP=200          messages kept in the archive
USAGE
}

# --------------------------------------------------------------------- main

migrate_legacy_state

command=${1:-info}
(($# > 0)) && shift

case $command in
info) cmd_info "${1:-}" ;;
status) cmd_status ;;
on | enable) cmd_on ;;
off | disable) cmd_off ;;
toggle) cmd_toggle ;;
reset) cmd_reset ;;
check) cmd_check ;;
pin) cmd_pin "${1:-}" ;;
setup) cmd_setup "${1:-}" ;;
profile) cmd_profile "${1:-}" ;;
apn) cmd_apn "${1:-}" ;;
reset-day) cmd_reset_day "${1:-}" ;;
sms) cmd_sms "$@" ;;
version | --version | -V) cmd_version ;;
-h | --help | help) usage ;;
*) die "unknown command: $command — try: mobile-data --help" ;;
esac
