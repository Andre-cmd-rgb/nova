#!/bin/bash
# nova:summary=Dictation: hold Super+D, speak, and the words are pasted where the cursor is
# nova:args=[status|setup|remove|last|vocab|toggle|cancel]
#
# dictation — the user's side of Nova's dictation (nova.dictation), run as
# `nova dictation <command>`: the speech model's download, the words of the
# last dictation, and the paste. The shell owns the shortcut and the pill at
# the bottom of the screen; nova-dictationd (src/dictation) records and
# hears, while the words are said, and hands the shell the words.
#
# All of it happens on this computer: the recording is in nova-dictationd's
# memory only, and Parakeet (whisper-cpp's libparakeet) hears it on the
# CPU. The network is used once, by `setup`, for the model.

set -euo pipefail

# NVIDIA's Parakeet TDT 0.6B v3 (CC-BY-4.0), as ggml-org converted it for
# whisper.cpp (MIT): 25 European languages, English and Spanish among them,
# each told apart by itself, with punctuation and capitals. The 8-bit file is
# as accurate as the 16-bit one at half its size. It is pinned to a commit,
# and used only once its SHA-256 matches: whisper.cpp trusts what it loads.
MODEL_NAME=ggml-parakeet-tdt-0.6b-v3-q8_0.bin
MODEL_URL=https://huggingface.co/ggml-org/parakeet-GGUF/resolve/35156454d1a39de06863303dd209fd2bed6ee079/$MODEL_NAME
MODEL_BYTES=668757119
MODEL_SIZE="669 MB"
MODEL_SHA256=4d64e9e96c2792186d072fde0034df0ad670cf680a2f53069052ead827fd600e

DATA_DIR=${XDG_DATA_HOME:-$HOME/.local/share}/nova-dictation
MODEL=$DATA_DIR/$MODEL_NAME
# The speech engine, as nova-dictationd opens it, and nova-dictationd, which
# knows whether it is one it can use (of the whisper.cpp release it was made
# for: src/dictation/src/engine.rs).
ENGINE=${NOVA_DICTATION_LIBRARY:-/usr/lib/whisper-cpp/libparakeet.so.1}
DAEMON=${NOVA_DICTATIOND:-/usr/lib/nova/nova-dictationd}
# The last dictation's words, which nova-dictationd keeps.
LAST=${XDG_RUNTIME_DIR:-/run/user/$UID}/nova/dictation/last
# Held while the model downloads or is deleted, so that one download runs at
# a time: in the runtime folder, never left beside the model.
LOCK=${XDG_RUNTIME_DIR:-/run/user/$UID}/nova/dictation-download.lock

die() {
  printf 'dictation: %s\n' "$*" >&2
  exit 1
}

# NetworkManager's Metered: 1 is yes, 3 a guess of yes (a phone's hotspot).
metered() {
  local value
  value=$(busctl --system get-property org.freedesktop.NetworkManager /org/freedesktop/NetworkManager \
    org.freedesktop.NetworkManager Metered 2>/dev/null) || return 1
  [[ $value == "u 1" || $value == "u 3" ]]
}

# --------------------------------------------------------------- the shell's

# One word for the shell: ready, no-engine (whisper-cpp is not installed),
# with "other" when it is but is not one dictation can use (another release),
# or no-model, with "metered" when downloading it would spend a data plan.
cmd_check() {
  if [[ ! -e $ENGINE ]]; then
    echo no-engine
  elif ! "$DAEMON" --engine 2>/dev/null; then
    echo "no-engine other"
  elif [[ -f $MODEL ]]; then
    echo ready
  elif metered; then
    echo "no-model metered"
  else
    echo no-model
  fi
}

# Pastes <text> where the cursor is, as SUPER + V does (default/hypr/keys/
# clipboard.lua): from the clipboard, with Hyprland sending the paste keys
# with modifiers of their own, Shift+Insert to a terminal and Ctrl+V to the
# rest, down and up apart. Typed by wtype instead, the words would merge with
# the SUPER still held from the shortcut into shortcuts.
#
# The text stays on the clipboard, so a paste that went to the wrong window
# can be made again (and `nova dictation last` has it), marked sensitive, as
# a password manager marks a password: the clipboard's history passes it
# over, so that dictations do not fill it. What was on the clipboard before
# is not put back. Its paste is the app's to ask for, whenever it gets to the
# keys, and nothing says when it has: put back after a guess, a slow app
# pastes the old clipboard, maybe a password, into the text; and wl-copy can
# put back only one of the kinds an image or a document offers.
cmd_insert() {
  local text=${1-} mods=CTRL key=V state
  [[ -n $text ]] || return 0
  printf '%s' "$text" | wl-copy --sensitive
  # Dynamic tags carry a trailing "*".
  if hyprctl activewindow -j 2>/dev/null | jq -e '(.tags // []) | map(sub("\\*$"; "")) | index("terminal") != null' >/dev/null; then
    mods=SHIFT key=Insert
  fi
  for state in down up; do
    hyprctl dispatch "hl.dsp.send_key_state({ mods = \"$mods\", key = \"$key\", state = \"$state\" })" >/dev/null
    [[ $state == up ]] || sleep 0.05
  done
}

# ---------------------------------------------------------------- yours

progress_line() { # <percent> <for the shell?>
  if [[ $2 == true ]]; then
    printf 'progress %d\n' "$1"
  else
    printf '\rDownloading the speech model (%s): %3d%%' "$MODEL_SIZE" "$1"
  fi
}

# Downloads the model, once: a stopped download carries on from where it
# was, and the file is moved into place only once its SHA-256 matches.
# --progress prints "progress <percent>" lines, then "checking", for the
# shell. One download runs at a time: a second (Download in Settings while
# Super+D downloads, or the other way round) follows the one under way, and
# carries on from its part if that one stops.
cmd_setup() {
  local for_shell=false part size pid lock
  [[ ${1:-} == --progress ]] && for_shell=true
  [[ -e $ENGINE ]] || die "this computer has no speech engine: dictation needs whisper-cpp (nova update installs it)"
  if [[ -f $MODEL ]]; then
    $for_shell || echo "The speech model is already here."
    return 0
  fi
  mkdir -p -- "$DATA_DIR" "${LOCK%/*}"
  exec {lock}>"$LOCK"
  while ! flock -n "$lock"; do
    size=$(stat -c %s -- "$MODEL.part" 2>/dev/null || echo 0)
    progress_line $((size * 100 / MODEL_BYTES)) "$for_shell"
    sleep 0.5
  done
  if [[ -f $MODEL ]]; then
    exec {lock}>&-
    $for_shell || printf '\nThe speech model is already here.\n'
    return 0
  fi
  part=$MODEL.part
  size=$(stat -c %s -- "$part" 2>/dev/null || echo 0)
  if ((size < MODEL_BYTES)); then
    curl -fsSL --retry 3 -C - -o "$part" "$MODEL_URL" &
    pid=$!
    # Stopped (the pill's Esc), curl stops too, and the part is kept.
    # shellcheck disable=SC2064 # the pid is fixed now
    trap "kill $pid 2>/dev/null; wait $pid 2>/dev/null; exit 1" TERM INT
    while kill -0 "$pid" 2>/dev/null; do
      size=$(stat -c %s -- "$part" 2>/dev/null || echo 0)
      progress_line $((size * 100 / MODEL_BYTES)) "$for_shell"
      sleep 0.5
    done
    trap - TERM INT
    if ! wait "$pid"; then
      $for_shell || echo
      die "the download stopped; nova dictation setup carries on from where it is"
    fi
  fi
  progress_line 100 "$for_shell"
  if $for_shell; then echo checking; else echo; fi
  if [[ $(sha256sum -- "$part" | cut -d' ' -f1) != "$MODEL_SHA256" ]]; then
    rm -f -- "$part"
    die "the download is not the model Nova knows, so it was deleted"
  fi
  mv -- "$part" "$MODEL"
  exec {lock}>&-
  nova-shell -q dictation refresh || true
  $for_shell || echo "Dictation is ready: hold Super+D and speak."
}

cmd_remove() {
  local lock
  mkdir -p -- "${LOCK%/*}"
  exec {lock}>"$LOCK"
  flock -n "$lock" || die "the speech model is being downloaded; stop it first"
  rm -f -- "$MODEL" "$MODEL.part"
  exec {lock}>&-
  rmdir -- "$DATA_DIR" 2>/dev/null || true
  nova-shell -q dictation refresh || true
  echo "The speech model is deleted; nova dictation setup downloads it again."
}

# The user's spellings, which nova-dictationd reads at every dictation
# (src/dictation/src/vocab.rs): a file of examples, all commented out, the
# first time, then the user's editor on it.
VOCAB=${XDG_CONFIG_HOME:-$HOME/.config}/nova/dictation/vocab.toml

cmd_vocab() {
  if [[ ! -e $VOCAB ]]; then
    mkdir -p -- "$(dirname -- "$VOCAB")"
    cat >"$VOCAB" <<'TEMPLATE'
# Your spellings for dictation: words Parakeet writes another way, and how
# to write them, a line each, as "what Parakeet writes" = "how it is written".
# The words match in any case, and the marks around them stay. Read at every
# dictation; take the # off a line to use it.
#
# "hyper land" = "Hyprland"
# "quick shell" = "Quickshell"
TEMPLATE
  fi
  exec nova-launch-editor "$VOCAB"
}

# The last dictation's words, kept in memory until the session ends.
cmd_last() {
  [[ -s $LAST ]] || die "no dictation yet in this session"
  cat -- "$LAST"
  [[ -t 1 ]] && echo
  return 0
}

cmd_status() {
  local why
  echo "Hold Super+D and speak, and the words are pasted where the cursor is when"
  echo "you let go. A tap keeps listening until the next; Esc cancels."
  echo
  if [[ ! -e $ENGINE ]]; then
    echo "Not available here: dictation needs whisper-cpp, which this computer does not have."
  elif ! why=$("$DAEMON" --engine 2>&1); then
    echo "Not available here: ${why:-the speech engine could not be opened}."
  elif [[ -f $MODEL ]]; then
    echo "Ready. The speech model ($MODEL_SIZE) is in $DATA_DIR."
  else
    echo "The speech model is not downloaded yet: nova dictation setup ($MODEL_SIZE)."
  fi
}

usage() {
  cat <<'USAGE'
Usage: nova dictation [command]

Hold Super+D and speak: the words are pasted where the cursor is when you
let go. A tap keeps listening until the next press, and Esc cancels. It is
all done on this computer; only the speech model is downloaded, once.

Commands:
  status    whether dictation is ready (the default)
  setup     download the speech model (669 MB)
  remove    delete the speech model
  last      print the last dictation's words again
  vocab     edit your spellings: words Parakeet writes another way
  toggle    start listening hands-free, or stop and paste: for a key of your own
  press     start listening, as Super+D going down does
  release   stop and paste, as letting Super+D go does, unless it was a tap
  cancel    stop without pasting
USAGE
}

main() {
  case ${1:-status} in
  status) cmd_status ;;
  setup) cmd_setup "${@:2}" ;;
  remove) cmd_remove ;;
  press | release | toggle | cancel) nova-shell dictation "$1" >/dev/null ;;
  last) cmd_last ;;
  vocab) cmd_vocab ;;
  check) cmd_check ;;
  insert) cmd_insert "${@:2}" ;;
  -h | --help | help) usage ;;
  *) die "unknown command: $1 — try: nova dictation --help" ;;
  esac
}

# Sourced by tests/unit/shell/dictation.bats, which swaps the model for one of
# its own; executed, it runs.
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
