#!/bin/bash
# nova:summary=Screen Time: where your time on this computer goes, per app
#
# screentime — the history behind Nova's Screen Time (nova.screentime), run as
# `nova screentime <command>`. Off until turned on: nothing is recorded while
# the plugin is not in ~/.config/nova/shell.json.
#
# The shell-side service watches which window has focus and how long you have
# been idle, and hands this script the seconds it has counted. Everything else
# — storage, aggregation, settings — lives here, so the numbers can be read,
# corrected, or thrown away from a terminal without touching the shell.
#
# Nothing here needs root, and no window titles are ever stored: only the
# application id, the hour it was used in, and a count of seconds.

set -uo pipefail

PLUGIN_ID="nova.screentime"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/nova-screentime"
CONFIG="$CONFIG_DIR/config"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/nova-screentime"
DAYS_DIR="$STATE_DIR/days"

die() {
  printf 'screentime: %s\n' "$*" >&2
  exit 1
}

have() { command -v "$1" >/dev/null 2>&1; }

# ------------------------------------------------------------------- config
# Parsed, never sourced: this file is user-editable and must not be able to
# execute anything.

# A key that is present but empty means empty, not unset: clearing IGNORE has
# to be able to beat its default rather than fall back to it.
get_cfg() {
  local key=$1 def=${2:-} value=""
  # The key is always a literal from this script, never user input, so
  # building the match out of one is safe.
  if [[ -r $CONFIG ]] && grep -qE "^[[:space:]]*${key}[[:space:]]*=" "$CONFIG" 2>/dev/null; then
    value=$(sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*//p" "$CONFIG" |
      tail -n1 | tr -d '\r')
    value=${value%"${value##*[![:space:]]}"}
    printf '%s' "$value"
    return 0
  fi
  printf '%s' "$def"
}

set_cfg() {
  local key=$1 value=$2 tmp
  mkdir -p -- "$CONFIG_DIR" || return 1
  [[ -f $CONFIG ]] || (
    umask 077
    : >"$CONFIG"
  ) || return 1
  tmp=$(mktemp -- "$CONFIG.XXXXXX") || return 1
  # awk rather than sed: the value is data, and a sed replacement would read a
  # & or a \1 in it as a back-reference.
  if ! awk -v key="$key" -v value="$value" '
    BEGIN { pattern = "^[[:space:]]*" key "[[:space:]]*=" }
    $0 ~ pattern { if (!seen++) print key "=" value; next }
    { print }
    END { if (!seen) print key "=" value }
  ' "$CONFIG" >"$tmp"; then
    rm -f -- "$tmp"
    return 1
  fi
  cat -- "$tmp" >"$CONFIG"
  rm -f -- "$tmp"
}

cfg_number() {
  local value
  value=$(get_cfg "$1" "$2")
  [[ $value =~ ^[0-9]+$ ]] || value=$2
  printf '%s' "$((10#$value))"
}

# Settings this script recognises. Anything else is refused rather than
# written and silently ignored later.
setting_default() {
  case $1 in
  IDLE_TIMEOUT) printf '180' ;;
  FLUSH_INTERVAL) printf '60' ;;
  RETENTION_DAYS) printf '90' ;;
  DAILY_GOAL) printf '0' ;;
  # The shell's own surfaces are not an application you spend time in: the
  # Nova menu and this plugin's own window are both org.quickshell.
  IGNORE) printf 'org.quickshell' ;;
  *) return 1 ;;
  esac
}

setting_help() {
  case $1 in
  IDLE_TIMEOUT) printf 'seconds without input before time stops counting' ;;
  FLUSH_INTERVAL) printf 'seconds between writes to disk' ;;
  RETENTION_DAYS) printf 'days of history to keep (0 keeps everything)' ;;
  DAILY_GOAL) printf 'daily limit in minutes, drawn on the chart (0 = none)' ;;
  IGNORE) printf 'comma-separated app ids never to record' ;;
  esac
}

# -------------------------------------------------------------------- names
#
# A window manager reports application ids, not names: "org.gnome.Nautilus",
# "steam_app_387990", "xdg-desktop-portal-gtk", "chrome-app.hey.com__-Default".
# None of those are what anyone calls the application, so every id is looked
# up in the desktop entries the machine already ships, in Steam's own
# manifests, and in a couple of rules for the ids no desktop entry describes.
# Anything still wrong can be pinned by hand:
#
#   screentime name steam_app_387990 "Scrap Mechanic"
#
# Resolved names are cached: the lookup reads every desktop entry on the
# machine, and the panel asks for these names on every refresh.

NAMES_FILE="$CONFIG_DIR/names"
NAME_CACHE="$STATE_DIR/names.tsv"

# Names pinned by hand, one `app-id=Display Name` per line. Parsed like the
# settings file, but the key is an app id rather than a literal from this
# script, so the match is a string comparison and never a pattern.
override_name() {
  [[ -r $NAMES_FILE ]] || return 1
  # The id travels through the environment rather than -v, because awk expands
  # escape sequences in a -v assignment and this is data.
  st_want="${1,,}" awk '
    BEGIN { want = ENVIRON["st_want"] }
    function trim(value) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", value); return value }
    {
      line = trim($0)
      if (line == "" || substr(line, 1, 1) == "#") next
      at = index(line, "=")
      if (at == 0) next
      if (tolower(trim(substr(line, 1, at - 1))) != want) next
      value = trim(substr(line, at + 1))
      if (value != "") name = value
    }
    END { if (name == "") exit 1; print name }
  ' "$NAMES_FILE"
}

set_name() {
  local id=$1 value=$2 tmp
  mkdir -p -- "$CONFIG_DIR" || return 1
  [[ -f $NAMES_FILE ]] || (
    umask 077
    : >"$NAMES_FILE"
  ) || return 1
  tmp=$(mktemp -- "$NAMES_FILE.XXXXXX") || return 1
  # Through the environment for the same reason: a display name is whatever
  # was typed, and a \ in it has to reach the file intact.
  if ! st_want="${id,,}" st_entry="$id=$value" st_keep="${value:+1}" awk '
    BEGIN { want = ENVIRON["st_want"]; entry = ENVIRON["st_entry"]; keep = ENVIRON["st_keep"] }
    function trim(value) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", value); return value }
    function id_of(line,   at) {
      line = trim(line)
      if (line == "" || substr(line, 1, 1) == "#") return ""
      at = index(line, "=")
      return at == 0 ? "" : tolower(trim(substr(line, 1, at - 1)))
    }
    id_of($0) == want { if (keep != "" && !seen++) print entry; next }
    { print }
    END { if (keep != "" && !seen) print entry }
  ' "$NAMES_FILE" >"$tmp"; then
    rm -f -- "$tmp"
    return 1
  fi
  cat -- "$tmp" >"$NAMES_FILE"
  rm -f -- "$tmp"
}

# key -> name, built on the first cache miss. "id:" is the entry's own file
# name, "wm:" its StartupWMClass, "url:" the web app it opens, "game:" the
# Steam game it launches.
declare -A DESKTOP_INDEX=()
DESKTOP_INDEX_LOADED=0

applications_dirs() {
  local dir
  while IFS= read -r dir; do
    [[ -n $dir && -d $dir/applications ]] && printf '%s\n' "$dir/applications"
  done < <(tr ':' '\n' \
    <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}")
}

# One pass over every desktop entry on the machine. Only the [Desktop Entry]
# group is read: the action groups below it carry their own Name= lines, and
# "New Window" is not an application.
desktop_entries() {
  local -a dirs=()
  mapfile -t dirs < <(applications_dirs)
  ((${#dirs[@]})) || return 0
  find "${dirs[@]}" -maxdepth 3 -name '*.desktop' -type f -print0 2>/dev/null |
    xargs -0 -r awk -v OFS='\t' '
      BEGIN { quote = sprintf("%c", 39) }
      function trim(value) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", value); return value }
      # Entries written on another platform arrive with CRLF line endings.
      { sub(/\r$/, "") }
      function flush() {
        if (base == "" || name == "") return
        print "id:" tolower(base), name
        if (wm != "") print "wm:" tolower(wm), name
        if (url != "") print "url:" url, name
        if (game != "") print "game:" game, name
      }
      FNR == 1 {
        flush()
        base = FILENAME
        sub(/.*\//, "", base)
        sub(/\.desktop$/, "", base)
        name = ""; wm = ""; url = ""; game = ""; entry = 0
      }
      /^[[:space:]]*\[/ { entry = ($0 ~ /^[[:space:]]*\[Desktop Entry\][[:space:]]*$/); next }
      !entry { next }
      # Localised names are "Name[de]=" and never match this.
      /^[[:space:]]*Name[[:space:]]*=/ {
        if (name == "") name = trim(substr($0, index($0, "=") + 1))
        next
      }
      /^[[:space:]]*StartupWMClass[[:space:]]*=/ {
        if (wm == "") wm = trim(substr($0, index($0, "=") + 1))
        next
      }
      /^[[:space:]]*Exec[[:space:]]*=/ {
        if (match($0, /steam:\/\/rungameid\/[0-9]+/)) {
          game = substr($0, RSTART, RLENGTH)
          sub(/.*\//, "", game)
        }
        if (match($0, /https?:\/\/[^[:space:]"]+/)) {
          url = substr($0, RSTART, RLENGTH)
          gsub(quote, "", url)
          sub(/^https?:\/\//, "", url)
          sub(/\/+$/, "", url)
          url = tolower(url)
        }
        next
      }
      END { flush() }
    '
}

load_desktop_index() {
  ((DESKTOP_INDEX_LOADED)) && return 0
  DESKTOP_INDEX_LOADED=1
  local key value
  while IFS=$'\t' read -r key value; do
    [[ -n $key && -n $value ]] || continue
    # ~/.local/share wins over /usr/share, as it does everywhere else in XDG.
    [[ -n ${DESKTOP_INDEX[$key]:-} ]] || DESKTOP_INDEX[$key]=$value
  done < <(desktop_entries)
}

# Steam knows the name of every game it has installed; the window manager only
# ever sees the app id.
steam_name() {
  local game=$1 root dir manifest name
  local -a dirs=()
  for root in "$HOME/.steam/steam" "$HOME/.steam/root" \
    "${XDG_DATA_HOME:-$HOME/.local/share}/Steam" "$HOME/.local/share/Steam"; do
    [[ -d $root/steamapps ]] || continue
    dirs+=("$root/steamapps")
    # A game on a second drive lives in a library listed here.
    [[ -r $root/steamapps/libraryfolders.vdf ]] || continue
    while IFS= read -r dir; do
      [[ -n $dir && -d $dir/steamapps ]] && dirs+=("$dir/steamapps")
    done < <(sed -n 's/^[[:space:]]*"path"[[:space:]]*"\(.*\)".*/\1/p' \
      "$root/steamapps/libraryfolders.vdf")
  done
  for dir in "${dirs[@]}"; do
    manifest="$dir/appmanifest_$game.acf"
    [[ -r $manifest ]] || continue
    name=$(sed -n 's/^[[:space:]]*"name"[[:space:]]*"\(.*\)".*/\1/p' "$manifest" | head -n1)
    [[ -n $name ]] && {
      printf '%s' "$name"
      return 0
    }
  done
  return 1
}

# Chrome names a web app window after the url it opens, with every slash
# turned into an underscore and the profile appended:
# "chrome-app.hey.com__-Default" is https://app.hey.com/ in the default
# profile. Prints the "host/path" that identifies it.
web_key() {
  local id=$1 rest
  case ${id,,} in
  chrome-*.* | chromium-*.* | brave-*.* | vivaldi-*.* | msedge-*.* | edge-*.*) rest=${id#*-} ;;
  *) return 1 ;;
  esac
  case ${rest,,} in
  *-default | *-guest* | *-system* | *-profile*) rest=${rest%-*} ;;
  esac
  [[ $rest == *.* ]] || return 1
  printf '%s' "$(sed 's/_\{1,\}/\//g; s/\/\{1,\}$//' <<<"${rest,,}")"
}

# No desktop entry claims this url, so the domain has to answer for it: the
# label before the public one is the closest thing to a name it carries.
web_name() {
  local host=${1%%/*}
  local -a labels=()
  IFS='.' read -ra labels <<<"$host"
  ((${#labels[@]})) || return 1
  local label=${labels[-1]}
  ((${#labels[@]} > 1)) && label=${labels[-2]}
  [[ -n $label ]] || return 1
  printf '%s' "${label^}"
}

# Ids that describe a piece of the desktop rather than an application. The
# portals are the ones that really turn up: every file chooser, screen-share
# prompt and screenshot dialog is one of their windows, and their own desktop
# entry calls itself "Portal".
alias_name() {
  case ${1,,} in
  xdg-desktop-portal | xdg-desktop-portal-*) printf 'System Dialog' ;;
  org.quickshell | org.quickshell.*) printf 'Nova Shell' ;;
  polkit-* | *.polkit-* | gcr-prompter) printf 'Authentication' ;;
  *) return 1 ;;
  esac
}

# Nothing recognised the id: "org.gnome.Boxes" -> "Boxes", "google-chrome" ->
# "Google Chrome". Right often enough to be worth trying, wrong often enough
# to be worth `screentime name`.
guess_name() {
  local id=$1 base word out=""
  local -a words=()
  base=${id##*.}
  base=${base//[-_]/ }
  read -ra words <<<"$base"
  for word in "${words[@]}"; do out+="${out:+ }${word^}"; done
  printf '%s' "${out:-$id}"
}

# The name one app id is shown under. Most specific source first: what you
# said it is, then what the desktop says it is, then a guess.
display_name() {
  local id=$1 name="" key game leaf
  name=$(override_name "$id") && {
    printf '%s' "$name"
    return 0
  }
  name=$(alias_name "$id") && {
    printf '%s' "$name"
    return 0
  }
  load_desktop_index
  if [[ ${id,,} =~ ^steam_app_([0-9]+)$ ]]; then
    game=${BASH_REMATCH[1]}
    name=$(steam_name "$game") || name=${DESKTOP_INDEX[game:$game]:-}
  fi
  [[ -n $name ]] || name=${DESKTOP_INDEX[id:${id,,}]:-}
  [[ -n $name ]] || name=${DESKTOP_INDEX[wm:${id,,}]:-}
  # A reverse-dns id often has a plainer entry behind it:
  # "org.pulseaudio.pavucontrol" is pavucontrol.desktop, which calls itself
  # "PulseAudio Volume Control".
  if [[ -z $name && $id == *.* ]]; then
    leaf=${id##*.}
    name=${DESKTOP_INDEX[id:${leaf,,}]:-}
    [[ -n $name ]] || name=${DESKTOP_INDEX[wm:${leaf,,}]:-}
  fi
  if [[ -z $name ]] && key=$(web_key "$id"); then
    name=${DESKTOP_INDEX[url:$key]:-}
    [[ -n $name ]] || name=$(web_name "$key")
  fi
  [[ -n $name ]] || name=$(guess_name "$id")
  # An entry that names itself in lower case ("hyperwriter") sits oddly in a
  # column of proper names.
  [[ $name == "${name,,}" ]] && name=${name^}
  printf '%s' "$name"
}

names_cache_stale() {
  [[ -r $NAME_CACHE ]] || return 0
  # A name pinned by hand has to beat one already resolved. The config
  # directory's own timestamp is checked too, because that is what moves when
  # the names file is created or deleted rather than edited.
  [[ -f $NAMES_FILE && $NAMES_FILE -nt $NAME_CACHE ]] && return 0
  [[ -d $CONFIG_DIR && $CONFIG_DIR -nt $NAME_CACHE ]] && return 0
  # A newer copy of this script may resolve an id differently than the copy
  # that filled the cache, so a plugin update reprices every name.
  [[ ${BASH_SOURCE[0]} -nt $NAME_CACHE ]] && return 0
  # A week is soon enough to notice an application that was renamed or removed.
  [[ -n $(find "$NAME_CACHE" -mtime +7 -print -quit 2>/dev/null) ]] && return 0
  return 1
}

# app id + seconds rows on stdin: make sure every id in them has a name in the
# cache. Written whole and moved into place, so a panel reading it at the same
# moment sees either the old file or the new one.
ensure_names() {
  local -A names=()
  local -a ids=() missing=()
  local id name tmp
  mapfile -t ids < <(cut -f1 | sort -u)
  ((${#ids[@]})) || return 0
  mkdir -p -- "$STATE_DIR" 2>/dev/null || return 0
  if ! names_cache_stale; then
    while IFS=$'\t' read -r id name; do
      [[ -n $id ]] && names[$id]=$name
    done <"$NAME_CACHE"
  fi
  for id in "${ids[@]}"; do
    [[ -n $id ]] || continue
    [[ -n ${names[$id]:-} ]] || missing+=("$id")
  done
  ((${#missing[@]})) || return 0
  for id in "${missing[@]}"; do names[$id]=$(display_name "$id"); done
  tmp=$(mktemp -- "$NAME_CACHE.XXXXXX" 2>/dev/null) || return 0
  for id in "${!names[@]}"; do printf '%s\t%s\n' "$id" "${names[$id]}"; done |
    sort >"$tmp" && mv -f -- "$tmp" "$NAME_CACHE"
  rm -f -- "$tmp"
}

# app id + seconds in, app id + name + seconds out.
annotate_names() {
  local rows cache=$NAME_CACHE
  rows=$(cat)
  [[ -n $rows ]] || return 0
  ensure_names <<<"$rows"
  [[ -r $cache ]] || cache=/dev/null
  awk -F'\t' -v OFS='\t' '
    NR == FNR { name[$1] = $2; next }
    NF >= 2 { print $1, (($1 in name) && name[$1] != "" ? name[$1] : $1), $2 }
  ' "$cache" <(printf '%s\n' "$rows")
}

# --------------------------------------------------------------------- data
#
# One file per day, three tab-separated columns: app id, hour of day, seconds.
# Small enough (a few hundred lines) to rewrite whole on every flush, which
# keeps the merge trivial and the file always complete.

today_date() { date +%F; }
day_file() { printf '%s/%s.tsv' "$DAYS_DIR" "$1"; }

is_ignored() {
  local app=${1,,} list item
  list=$(get_cfg IGNORE "$(setting_default IGNORE)")
  [[ -n $list ]] || return 1
  while IFS= read -r item; do
    item=${item// /}
    [[ -n $item && ${item,,} == "$app" ]] && return 0
  done < <(tr ',' '\n' <<<"$list")
  return 1
}

# app=seconds pairs from the service, each in this hour or in the one after
# its @: app=60@2026-10-24T09. Seconds may be negative: when the idle monitor
# fires, the service takes back the timeout it had already counted, from the
# hours it was written to.
cmd_record() {
  (($# > 0)) || return 0
  local today hour pair app secs at day lock
  local -A deltas=()
  today=$(today_date)
  hour=$((10#$(date +%H)))

  for pair in "$@"; do
    app=${pair%%=*}
    secs=${pair#*=}
    [[ -n $app && $app != "$pair" ]] || continue
    at=""
    [[ $secs != *@* ]] || at=${secs#*@} secs=${secs%%@*}
    [[ $secs =~ ^-?[0-9]+$ ]] || continue
    if [[ -z $at ]]; then
      at=${today}T$(printf '%02d' "$hour")
    elif [[ ! $at =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3])$ ]]; then
      continue
    fi
    app=${app//[$'\t\n']/ }
    is_ignored "$app" && continue
    day=${at%T*}
    deltas[$day]+="$app"$'\t'"$((10#${at#*T}))"$'\t'"$secs"$'\n'
  done
  ((${#deltas[@]} > 0)) || return 0

  mkdir -p -- "$DAYS_DIR" 2>/dev/null || return 0

  # A new day's first write is the natural moment to drop old history.
  [[ -e $(day_file "$today") ]] || prune_history

  exec {lock}>"$STATE_DIR/.lock" 2>/dev/null || return 0
  flock -w 5 "$lock" 2>/dev/null || {
    exec {lock}>&-
    return 0
  }

  for day in "${!deltas[@]}"; do
    record_day "$(day_file "$day")" "${deltas[$day]}"
  done

  exec {lock}>&-
}

# Adds app<TAB>hour<TAB>seconds lines to a day file. An hour that comes to
# less than a second is dropped.
record_day() { # file deltas
  local file=$1
  {
    [[ -r $file ]] && cat -- "$file"
    printf '%s' "$2"
  } | awk -F'\t' -v OFS='\t' '
      NF == 3 { total[$1 SUBSEP $2] += $3 }
      END {
        for (key in total) {
          if (total[key] < 1) continue
          split(key, part, SUBSEP)
          print part[1], part[2], total[key]
        }
      }
    ' | sort >"$file.tmp" 2>/dev/null && mv -f -- "$file.tmp" "$file"
  rm -f -- "$file.tmp"
}

prune_history() {
  local keep cutoff name
  keep=$(cfg_number RETENTION_DAYS 90)
  ((keep > 0)) || return 0
  cutoff=$(date -d "-$keep day" +%F) || return 0
  [[ -d $DAYS_DIR ]] || return 0
  for name in "$DAYS_DIR"/*.tsv; do
    [[ -e $name ]] || continue
    local base=${name##*/}
    base=${base%.tsv}
    [[ $base =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || continue
    [[ $base < $cutoff ]] && rm -f -- "$name"
  done
  return 0
}

# Seconds across the given day files.
sum_seconds() {
  cat -- "$@" 2>/dev/null | awk -F'\t' 'NF == 3 { s += $3 } END { print s + 0 }'
}

# id, display name, seconds — busiest first.
apps_tsv() {
  cat -- "$@" 2>/dev/null | awk -F'\t' -v OFS='\t' '
    NF == 3 { total[$1] += $3 }
    END { for (app in total) print app, total[app] }
  ' | annotate_names | sort -t$'\t' -k3,3nr
}

# 24 comma-separated hourly totals for one day file.
hours_csv() {
  cat -- "$1" 2>/dev/null | awk -F'\t' '
    NF == 3 { hour[$2 + 0] += $3 }
    END {
      out = ""
      for (i = 0; i < 24; i++) out = out (i ? "," : "") (hour[i] + 0)
      print out
    }
  '
}

# date, weekday label, seconds — oldest first, ending today.
days_tsv() {
  local span=$1 index date
  for ((index = span - 1; index >= 0; index--)); do
    date=$(date -d "-$index day" +%F) || continue
    printf '%s\t%s\t%s\n' "$date" "$(date -d "$date" +%a)" "$(sum_seconds "$(day_file "$date")")"
  done
}

files_for_span() {
  local span=$1 index date
  for ((index = span - 1; index >= 0; index--)); do
    date=$(date -d "-$index day" +%F) || continue
    printf '%s\n' "$(day_file "$date")"
  done
}

# ------------------------------------------------------------------ reports

format_duration() {
  local total=${1:-0} hours minutes
  ((total < 0)) && total=0
  hours=$((total / 3600))
  minutes=$(((total % 3600) / 60))
  if ((hours > 0)); then
    printf '%dh %dm' "$hours" "$minutes"
  elif ((minutes > 0)); then
    printf '%dm' "$minutes"
  else
    printf '%ds' "$total"
  fi
}

format_short() {
  local total=${1:-0} hours minutes
  ((total < 0)) && total=0
  hours=$((total / 3600))
  minutes=$(((total % 3600) / 60))
  if ((hours > 0)); then
    printf '%dh%02dm' "$hours" "$minutes"
  else
    printf '%dm' "$minutes"
  fi
}

cmd_today() {
  local file total
  file=$(day_file "$(today_date)")
  total=$(sum_seconds "$file")

  if [[ ${1:-} == --short ]]; then
    format_short "$total"
    echo
    return 0
  fi

  printf 'Today: %s\n' "$(format_duration "$total")"
  ((total > 0)) || return 0
  while IFS=$'\t' read -r _ name seconds; do
    printf '  %-24s %s\n' "$name" "$(format_duration "$seconds")"
  done < <(apps_tsv "$file" | head -n 10)
}

cmd_week() {
  local span=${1:-7} total
  [[ $span =~ ^[0-9]+$ ]] && ((span > 0)) || span=7
  mapfile -t files < <(files_for_span "$span")
  total=$(sum_seconds "${files[@]}")

  printf 'Last %d days: %s (%s/day)\n' "$span" "$(format_duration "$total")" \
    "$(format_duration $((total / span)))"
  while IFS=$'\t' read -r date label seconds; do
    printf '  %s %s  %s\n' "$label" "$date" "$(format_duration "$seconds")"
  done < <(days_tsv "$span")
  echo
  while IFS=$'\t' read -r _ name seconds; do
    printf '  %-24s %s\n' "$name" "$(format_duration "$seconds")"
  done < <(apps_tsv "${files[@]}" | head -n 10)
}

cmd_top() {
  local count=${1:-10} file
  [[ $count =~ ^[0-9]+$ ]] && ((count > 0)) || count=10
  file=$(day_file "$(today_date)")
  while IFS=$'\t' read -r _ name seconds; do
    printf '%-24s %s\n' "$name" "$(format_duration "$seconds")"
  done < <(apps_tsv "$file" | head -n "$count")
}

# Everything the panel draws, in one call.
cmd_json() {
  have jq || die "jq is required for json output"
  local span=7 today file
  while (($# > 0)); do
    case $1 in
    --days)
      shift
      [[ ${1:-} =~ ^[0-9]+$ ]] && ((10#$1 > 0)) && span=$((10#$1))
      ;;
    esac
    shift
  done

  today=$(today_date)
  file=$(day_file "$today")
  mapfile -t files < <(files_for_span "$span")

  jq -n \
    --arg today "$today" \
    --arg todayApps "$(apps_tsv "$file")" \
    --arg rangeApps "$(apps_tsv "${files[@]}")" \
    --arg days "$(days_tsv "$span")" \
    --argjson todaySeconds "$(sum_seconds "$file")" \
    --argjson rangeSeconds "$(sum_seconds "${files[@]}")" \
    --argjson hours "[$(hours_csv "$file")]" \
    --argjson goalMinutes "$(cfg_number DAILY_GOAL 0)" \
    --argjson rangeDays "$span" '
      def rows:
        split("\n")
        | map(select(length > 0) | split("\t"))
        | map({ id: .[0], name: .[1], seconds: (.[2] | tonumber) });
      {
        today: $today,
        todaySeconds: $todaySeconds,
        hours: $hours,
        goalMinutes: $goalMinutes,
        rangeDays: $rangeDays,
        rangeSeconds: $rangeSeconds,
        todayApps: ($todayApps | rows),
        rangeApps: ($rangeApps | rows),
        days: ($days
          | split("\n")
          | map(select(length > 0) | split("\t"))
          | map({ date: .[0], label: .[1], seconds: (.[2] | tonumber) }))
      }
    '
}

# ----------------------------------------------------------------- settings

cmd_config() {
  local key value default
  if (($# > 0)); then
    key=${1^^}
    default=$(setting_default "$key") || die "unknown setting: $1"
    printf '%s\n' "$(get_cfg "$key" "$default")"
    return 0
  fi
  for key in IDLE_TIMEOUT FLUSH_INTERVAL RETENTION_DAYS DAILY_GOAL IGNORE; do
    default=$(setting_default "$key")
    value=$(get_cfg "$key" "$default")
    printf '%-16s %-8s  %s\n' "$key" "$value" "$(setting_help "$key")"
  done
}

cmd_set() {
  local key=${1:-} value=${2:-}
  [[ -n $key ]] || die "usage: screentime set <key> <value>"
  key=${key^^}
  setting_default "$key" >/dev/null || die "unknown setting: $key"
  case $key in
  IDLE_TIMEOUT | FLUSH_INTERVAL | RETENTION_DAYS | DAILY_GOAL)
    [[ $value =~ ^[0-9]+$ ]] || die "$key must be a whole number"
    value=$((10#$value))
    ;;
  esac
  set_cfg "$key" "$value" || die "could not write $CONFIG"
  printf '%s=%s\n' "$key" "$value"
}

cmd_ignore() {
  local app=${1:-} list
  [[ -n $app ]] || die "usage: screentime ignore <app-id>"
  is_ignored "$app" && {
    echo "$app is already ignored."
    return 0
  }
  list=$(get_cfg IGNORE "$(setting_default IGNORE)")
  set_cfg IGNORE "${list:+$list,}$app" || die "could not write $CONFIG"
  echo "Ignoring $app. Time already recorded for it is kept; run: screentime forget $app"
}

cmd_unignore() {
  local app=${1:-} list kept="" item
  [[ -n $app ]] || die "usage: screentime unignore <app-id>"
  list=$(get_cfg IGNORE "$(setting_default IGNORE)")
  while IFS= read -r item; do
    item=${item// /}
    [[ -n $item ]] || continue
    [[ ${item,,} == "${app,,}" ]] && continue
    kept+="${kept:+,}$item"
  done < <(tr ',' '\n' <<<"$list")
  set_cfg IGNORE "$kept" || die "could not write $CONFIG"
  echo "No longer ignoring $app."
}

# Every app id in the history and the name it is shown under — the list to
# look at before pinning one of them.
cmd_names() {
  local id name seconds found=0
  while IFS=$'\t' read -r id name seconds; do
    printf '%-34s %-22s %s\n' "$id" "$name" "$(format_duration "$seconds")"
    found=1
  done < <(apps_tsv "$DAYS_DIR"/*.tsv)
  ((found)) || echo "Nothing recorded yet."
}

cmd_name() {
  local id=${1:-} value=${2:-}
  [[ -n $id ]] || die "usage: screentime name <app-id> [<display name>|--reset]"
  if (($# < 2)); then
    printf '%s\n' "$(display_name "$id")"
    return 0
  fi
  if [[ -z $value || $value == --reset ]]; then
    set_name "$id" "" || die "could not write $NAMES_FILE"
    printf '%s goes back to its detected name (%s).\n' "$id" "$(display_name "$id")"
    return 0
  fi
  set_name "$id" "$value" || die "could not write $NAMES_FILE"
  printf '%s is now shown as %s.\n' "$id" "$value"
}

# Remove one app from the stored history entirely.
cmd_forget() {
  local app=${1:-} file lock
  [[ -n $app ]] || die "usage: screentime forget <app-id>"
  [[ -d $DAYS_DIR ]] || return 0
  exec {lock}>"$STATE_DIR/.lock" 2>/dev/null
  flock -w 5 "$lock" 2>/dev/null
  for file in "$DAYS_DIR"/*.tsv; do
    [[ -e $file ]] || continue
    awk -F'\t' -v app="$app" '$1 != app' "$file" >"$file.tmp" &&
      mv -f -- "$file.tmp" "$file"
    rm -f -- "$file.tmp"
  done
  exec {lock}>&-
  echo "Forgot every record for $app."
}

# --------------------------------------------------------------- shell glue

# Its page in Settings, today or (--week) the last seven days.
cmd_open() {
  local range=today
  [[ ${1:-} == --week ]] && range=week
  have nova-shell || die "nova-shell not found"
  nova-shell shell summon nova.settings "{\"page\":\"screentime\",\"range\":\"$range\"}" >/dev/null ||
    die "could not open Settings"
}

# Screen Time records only while shell.json names it (its manifest says
# "enabledByDefault": false), so turning it on and off is its bar entry.
is_enabled() {
  local config=${XDG_CONFIG_HOME:-$HOME/.config}/nova/shell.json
  [[ -r $config ]] &&
    jq -e --arg id "$PLUGIN_ID" '[.. | objects | select(.id? == $id)] | length > 0' "$config" >/dev/null 2>&1
}

cmd_switch() {
  have nova || die "the nova CLI is required"
  case $1 in
  on)
    nova bar put "$PLUGIN_ID" >/dev/null || die "could not turn Screen Time on"
    echo "Screen Time is on, and counts from now."
    ;;
  off)
    nova bar remove "$PLUGIN_ID" >/dev/null || die "could not turn Screen Time off"
    echo "Screen Time is off. What it recorded stays until: nova screentime forget <app-id>"
    ;;
  toggle) if is_enabled; then cmd_switch off; else cmd_switch on; fi ;;
  enabled) is_enabled ;;
  esac
}

cmd_indicator() {
  local state=${1:-status}
  have nova || die "the nova CLI is required"
  case $state in
  on | off)
    nova bar set "$PLUGIN_ID" indicator "$([[ $state == on ]] && echo true || echo false)" --json >/dev/null ||
      die "could not update the bar entry — is the plugin enabled?"
    echo "Bar indicator $state."
    ;;
  status)
    if is_enabled; then
      echo "The plugin is in the bar layout."
    else
      echo "The plugin is not in the bar layout."
    fi
    ;;
  *) die "usage: screentime indicator on|off" ;;
  esac
}

cmd_version() {
  local self plugin_dir version=""
  self=$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null) || self=""
  plugin_dir=${self%/bin/*}
  if [[ -n $plugin_dir && -r $plugin_dir/manifest.json ]]; then
    version=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
      "$plugin_dir/manifest.json" | head -n1)
  fi
  printf 'screentime %s\n' "${version:-unknown}"
}

usage() {
  cat <<'USAGE'
nova screentime — where your time on this machine goes.

Usage:
  nova screentime today [--short]     today's total and its busiest apps
  nova screentime week [days]         a day-by-day breakdown (default 7)
  nova screentime top [n]             today's busiest apps
  nova screentime json [--days n]     everything the panel draws
  nova screentime open [--week]       show it in Settings, under Screen Time

  nova screentime config [key]        show settings
  nova screentime set <key> <value>   change one
  nova screentime names               every app id and the name it is shown under
  nova screentime name <id> [name]    show that name, or pin your own
  nova screentime ignore <app-id>     never record an app again
  nova screentime unignore <app-id>   undo that
  nova screentime forget <app-id>     delete an app's history

  nova screentime on | off | toggle     start or stop recording (off at first)
  nova screentime enabled               succeeds while it is on
  nova screentime indicator on|off      show or hide the bar indicator
  nova screentime record <app>=<secs>[@<day>T<hour>]
                                        used by the shell service
  nova screentime version

Settings live in ~/.config/nova-screentime/config, pinned names in
~/.config/nova-screentime/names, history in
~/.local/state/nova-screentime/days/. Only app ids and second counts are
stored — never window titles.
USAGE
}

# --------------------------------------------------------------------- main

command=${1:-today}
(($# > 0)) && shift

case $command in
record) cmd_record "$@" ;;
today) cmd_today "$@" ;;
week) cmd_week "$@" ;;
top) cmd_top "$@" ;;
json) cmd_json "$@" ;;
open) cmd_open "$@" ;;
config) cmd_config "$@" ;;
set) cmd_set "$@" ;;
names) cmd_names "$@" ;;
name) cmd_name "$@" ;;
ignore) cmd_ignore "$@" ;;
unignore) cmd_unignore "$@" ;;
forget) cmd_forget "$@" ;;
prune) prune_history ;;
on | off | toggle | enabled) cmd_switch "$command" ;;
indicator) cmd_indicator "$@" ;;
version | --version | -V) cmd_version ;;
-h | --help | help) usage ;;
*) die "unknown command: $command — try: nova screentime --help" ;;
esac
