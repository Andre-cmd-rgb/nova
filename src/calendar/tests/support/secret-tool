#!/bin/sh
# secret-tool, for nova-calendar-sync's tests: store, lookup and clear, the
# secrets kept as files in the folder $NOVA_TEST_SECRETS, one for each set of
# attributes, and never in the login keyring of the computer the tests run on.
command=$1
shift
if [ "$command" = store ] && [ "$1" = --label ]; then
    shift 2
fi
key=
while [ $# -gt 1 ]; do
    key="$key$1=$2;"
    shift 2
done
mkdir -p "$NOVA_TEST_SECRETS"
file=$NOVA_TEST_SECRETS/$(printf '%s' "$key" | tr -c 'A-Za-z0-9._=;-' '_')
case $command in
store) cat >"$file" ;;
lookup)
    [ -f "$file" ] || exit 1
    cat "$file"
    ;;
clear) rm -f "$file" ;;
*) exit 2 ;;
esac
