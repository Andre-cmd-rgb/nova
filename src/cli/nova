#!/bin/bash

# nova: run a Nova command. `nova theme set white` runs the longest helper name
# its words spell (nova-theme-set-white, nova-theme-set, then nova-theme) with
# the remaining words as arguments. Helpers live in /usr/lib/nova/bin and
# describe themselves with `# nova:summary=` lines; `# nova:hidden=true` keeps
# one out of the help.

set -euo pipefail

readonly bin=${NOVA_BIN:-/usr/lib/nova/bin}

# Compiled helpers cannot carry a summary comment, or a hidden one: "" keeps
# one out of the help. nova-undervolt is nova power undervolt's own half,
# nova-apps-catalog the App Center's list of apps; nova-keyring-migrate and
# nova-password-change are the session's and Settings' own, and the second
# reads passwords on a stdin a terminal would echo; nova-pinentry,
# nova-share-picker, nova-sim-pin and nova-tray-quit are nova-sessiond under
# the names gpg-agent, the screen-sharing portal, mobile-data and the tray's
# menu run it by; nova-launch starts every app, from keys, the menu and the
# helpers, and takes a command, not a verb; nova-calendar-sync is the
# Calendar's and nova-screensaver-effect the screensaver's. A compiled helper
# missing here is listed with no summary (tests/unit/cli/dispatcher.bats).
declare -A compiled=(
  [nova-airdrop]="Send to and receive from iPhones nearby with AirDrop"
  [nova-apps-catalog]=""
  [nova-calendar-sync]=""
  [nova-keyring-migrate]=""
  [nova-launch]=""
  [nova-password-change]=""
  [nova-pinentry]=""
  [nova-screensaver-effect]=""
  [nova-share-picker]=""
  [nova-sim-pin]=""
  [nova-theme]="Switch themes and backgrounds, and read theme colors"
  [nova-tray-quit]=""
  [nova-undervolt]=""
)

summary() {
  local file=$bin/$1 line
  if [[ -n ${compiled[$1]:-} ]]; then
    echo "${compiled[$1]}"
    return
  fi
  line=$(grep -m1 -a '^# nova:summary=' "$file" 2>/dev/null || true)
  echo "${line#\# nova:summary=}"
}

hidden() {
  [[ ! -v compiled[$1] || -n ${compiled[$1]} ]] || return 0
  grep -q -m1 -a '^# nova:hidden=true' "$bin/$1" 2>/dev/null
}

# Visible helper names, sorted, one per line.
helpers() {
  local path name
  for path in "$bin"/nova-*; do
    [[ -x $path && -f $path ]] || continue
    name=${path##*/}
    hidden "$name" || echo "$name"
  done
}

list() {
  local prefix=$1 name words
  while IFS= read -r name; do
    [[ $name == "$prefix"* ]] || continue
    words=${name#nova-}
    printf '  %-34s %s\n' "${words//-/ }" "$(summary "$name")"
  done < <(helpers)
}

usage() {
  local groups
  groups=$(helpers | sed -E 's/^nova-([a-z0-9]+).*/\1/' | sort -u | paste -sd' ' -)
  cat <<USAGE
Usage: nova <command> [args...]
       nova help [group]

Groups: ${groups}

\`nova help\` lists every command; \`nova help <group>\` one group's.
USAGE
}

case ${1:-} in
  "" | -h | --help)
    usage
    exit 0
    ;;
  help)
    if (($# > 1)); then
      [[ $2 =~ ^[a-z0-9]+$ ]] || { echo "nova: no group '$2'" >&2; exit 2; }
      out=$(list "nova-$2")
      [[ -n $out ]] || { echo "nova: no group '$2'" >&2; exit 2; }
      echo "$out"
    else
      list nova-
    fi
    exit 0
    ;;
esac

# Helpers call one another by name, also under sudo, whose PATH lacks $bin.
export PATH="$bin:$PATH"

# The words that can be part of a helper name, up to the first that cannot.
words=()
for arg in "$@"; do
  [[ $arg =~ ^[a-z0-9][a-z0-9-]*$ ]] || break
  words+=("$arg")
done

for ((n = ${#words[@]}; n > 0; n--)); do
  name=nova-$(IFS=-; echo "${words[*]:0:n}")
  # nova-launch starts any program, so a typo after "launch" must not reach it.
  [[ $name != nova-launch ]] || continue
  if [[ -x $bin/$name && -f $bin/$name ]]; then
    exec "$bin/$name" "${@:n+1}"
  fi
done

# A group name alone lists the group.
if (($# == 1)) && out=$(list "nova-$1-") && [[ -n $out ]]; then
  echo "$out"
  exit 0
fi

echo "nova: unknown command '$*' (see nova help)" >&2
exit 2
