#!/bin/bash

# nova:summary=Returns true when running on a laptop (has a lid or laptop chassis).
# nova:hidden=true

set -euo pipefail

lid_path="${NOVA_LID_PATH:-/proc/acpi/button/lid}"
dmi_path="${NOVA_DMI_PATH:-/sys/class/dmi/id}"

# A lid switch is the definitive signal for clamshell-capable hardware.
for state in "$lid_path"/*/state; do
  [[ -e $state ]] && exit 0
done

# Fall back to the DMI chassis type for laptops that don't expose an ACPI lid
# button. 8=Portable 9=Laptop 10=Notebook 14=Sub Notebook 30=Tablet
# 31=Convertible 32=Detachable.
chassis_type=""
if [[ -r $dmi_path/chassis_type ]]; then
  chassis_type=$(<"$dmi_path/chassis_type")
fi

case $chassis_type in
  8 | 9 | 10 | 14 | 30 | 31 | 32) exit 0 ;;
esac

exit 1
