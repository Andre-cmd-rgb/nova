#!/bin/bash

# nova:summary=Print the detected Hyprland touchscreen device name
# nova:hidden=true

set -euo pipefail

# Hyprland lists touchscreens as touch devices; the first is the screen's.
# nova-toggle-input-device touchscreen turns it off and on by this name.
name=$(hyprctl devices -j | jq -r 'first(.touch[]?.name) // empty')
[[ -n $name ]] || exit 1
printf '%s\n' "$name"
