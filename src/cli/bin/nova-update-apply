#!/bin/bash
# nova:hidden=true
# nova:summary=Apply a Nova release as root (run by nova update through pkexec)
# nova:args=--tag <tag> --version <v> --arch-date <YYYY/MM/DD> --nova-repo <url> [--package <file>]... | --packages-only --package <file>... | --repair [--package <file>]... | --repairs | --check-boot | --login-command
# nova:after-pacman=1
#
# The privileged half of `nova update`. One pkexec call runs all of it, so there is a
# single authentication prompt and nothing privileged is left to the unprivileged side.
#
#   0. room enough on / and on the boot partition, or nothing begins
#   1. snapper pre-snapshot, taken first so rolling back to it restores the old
#      mirror and repository files together with the old packages
#   2. write /etc/pacman.d/nova-mirrorlist (Arch Linux Archive snapshot) and
#      /etc/pacman.d/nova-repo (the release's [nova] server)
#   3. the keyrings first (pacman -Syy archlinux-keyring nova-keyring), so a new
#      packager key is trusted before the upgrade checks signatures. The databases
#      are refreshed with -yy because pacman skips a database that is not newer
#      than its local copy, which is exactly the case when moving to an older
#      snapshot.
#   4. pacman -Su (-Suu with --allow-downgrade). A failed step puts the previous
#      mirror and repository files back, and the databases that went with them.
#      Going back to an older release takes with it the packages only the newer
#      one had (left_behind, below).
#   5. the repairs (repair_steps): install anything the new release adds to this
#      computer's hardware profile, the graphics drivers its GPUs need, 32-bit
#      too once anything 32-bit is installed, in place of NVIDIA's where it has
#      no NVIDIA kernel module for them (keep_graphics_drivers), and game
#      controllers' rules where the 32-bit repository is on (install_controllers)
#   6. snapper post-snapshot
#   7. check that every installed kernel still has a boot entry whose files exist
#      and hold that kernel
#
# Steps 5 to 7 are run by the nova-update-apply that step 4 installed, so that
# a release's own steps apply in the update that brings it (run_installed): it
# is started with --after-pacman, the update's arguments, the snapshot's
# number (--pre) and this run's lock (--lock-fd), and goes on under that lock
# and this run's hold on shutting down. One without the nova:after-pacman line
# above (an older release's, after a move back) leaves them to this one. What
# --after-pacman takes is kept as it is from one release to the next.
#
# The pair of snapshots is marked important, so the snapshots snap-pac takes
# around later pacman runs do not push the way back out (NUMBER_LIMIT_IMPORTANT).
# --check-boot runs step 7 alone, and the boot fallback's check, to look again
# after a repair.
# --login-command sets greetd's boot autologin to the line the installed Nova
# has (login_command), as the nova package's post_upgrade asks.
#
# --repair runs step 5 alone, for nova update on a system already on the newest
# release: the repairs nova doctor points at need no new release. --repairs,
# which anyone may run and which changes nothing, says what --repair would do,
# a line a step, and nothing when there is nothing to do.
#
# --package installs a package built beforehand as the user (Chrome and VS Code,
# by nova apps install --build), after step 5, so that an update from Settings
# asks for authentication once. With --packages-only it installs those alone,
# when only the apps are behind; with --repair, after the repairs. It takes those two apps alone, from files of
# the account that ran pkexec (PKEXEC_UID; not always the one whose password
# was typed), and installs copies made as they were checked.
# One that will not go in leaves the release in, and the update goes on to its
# end: it then ends with 4, finished with problems.
#
# Exit status: 0 done; 3 installed, but the boot entries do not check out
# (which outweighs an app); 4 finished, but an app did not go in; 1 failed.
#
# Closing the terminal does not stop it: from then on its output goes to
# /var/log/nova-update.log.
#
# Every argument is validated: this runs as root and its caller is merely whoever
# polkit let through.
set -euo pipefail

# As root nothing of the environment named NOVA_ is read, here or by what this
# runs: those are test seams (below, in nova-hw-packages, and in pacman's hooks,
# nova-boot-check's NOVA_BOOT_ESP say), and the tests run it as an ordinary
# account. pkexec empties the environment; sudo -E or a root shell would not.
if ((EUID == 0)); then
  for seam in $(compgen -e -X '!NOVA_*'); do unset "$seam"; done
fi

ROOT=${NOVA_ROOT:-} # a test seam: prefix for every path
MIRRORLIST=$ROOT/etc/pacman.d/nova-mirrorlist
REPOFILE=$ROOT/etc/pacman.d/nova-repo
SYNC_DIR=$ROOT/var/lib/pacman/sync
LOG=$ROOT/var/log/nova-update.log
SNAPPER_CONFIG=${NOVA_SNAPPER_CONFIG:-root}
# There while an update's packages are all in and only its boot entries did
# not check out: the one unfinished update that --check-boot may end. Copies
# kept without it are of an update whose packages may be half in (the power
# went), which boot entries that check out say nothing about.
BOOT_UNCHECKED=$REPOFILE.nova-boot-unchecked
# The room an update needs on / (check_space says why), in MiB.
ROOT_NEED_MIB=4096

die() {
  warn "$*"
  [[ -z ${staged:-} ]] || rm -rf -- "$staged"
  exit 1
}
# A line on stdout (1) or stderr (2). Once what read them is gone (nova update
# stopped, at a logout say, or a `| tee` did), a write fails, and from then on
# both go to the log: an update that has begun goes on to its end.
out() { # fd, line
  printf '%s\n' "$2" >&"$1" && return 0
  { exec >>"$LOG" 2>&1; } 2>/dev/null || exec >/dev/null 2>&1
  printf '==> what read the output went away; continuing here\n%s\n' "$2" >&"$1" || true
}
warn() { out 2 "nova update: $*"; }
say() { out 1 "==> $*"; }

write_file() { # path; content on stdin. Atomic, so pacman never reads half a file.
  local path=$1 tmp
  tmp=$(mktemp "$path.XXXXXX")
  cat > "$tmp"
  chmod 644 "$tmp"
  mv -f "$tmp" "$path"
}

write_config() {
  {
    echo '# Managed by nova update; the next update rewrites this file.'
    printf '# nova-release: %s\n' "$tag"
    printf '# arch-date: %s\n' "$arch_date"
    # shellcheck disable=SC2016 # $repo and $arch are for pacman to expand
    printf 'Server = https://archive.archlinux.org/repos/%s/$repo/os/$arch\n' "$arch_date"
  } | write_file "$MIRRORLIST"
  {
    echo '# Managed by nova update; the next update rewrites this file.'
    printf '# nova-release: %s\n' "$tag"
    printf 'Server = %s\n' "$nova_repo"
  } | write_file "$REPOFILE"
}

# The sync databases go with the mirror files: put back without them, pacman
# would read the new snapshot's packages from the old snapshot's server.
# A copy already there is from an update that never finished (the power went,
# say), and holds what was in place before it: it is kept rather than replaced
# by what that update left half done. Each copy is made aside and renamed, so
# one that is there is whole.
backup_config() {
  local f kept=0
  for f in "$MIRRORLIST" "$REPOFILE"; do
    if [[ -e $f.nova-prev || -e $f.nova-absent ]]; then kept=1; continue; fi
    if [[ -e $f ]]; then
      # Two commands, not one && the other, which would let a copy that
      # fails (a full disk) pass: the update stops here, before the pins
      # change with nothing to go back to.
      cp -p "$f" "$f.nova-prev.tmp"
      mv -f "$f.nova-prev.tmp" "$f.nova-prev"
    else
      touch "$f.nova-absent"
    fi
  done
  if [[ -d $SYNC_DIR.nova-prev ]]; then
    kept=1
  elif [[ -d $SYNC_DIR ]]; then
    rm -rf "$SYNC_DIR.nova-prev.tmp"
    cp -a "$SYNC_DIR" "$SYNC_DIR.nova-prev.tmp"
    mv "$SYNC_DIR.nova-prev.tmp" "$SYNC_DIR.nova-prev"
  fi
  if (( kept )); then
    warn "an earlier update did not finish; keeping the files from before it to go back to"
  fi
}

restore_config() {
  local f restored=0
  rm -f "$BOOT_UNCHECKED"
  for f in "$MIRRORLIST" "$REPOFILE"; do
    if [[ -e $f.nova-prev ]]; then mv -f "$f.nova-prev" "$f"; restored=1; fi
    if [[ -e $f.nova-absent ]]; then rm -f "$f" "$f.nova-absent"; restored=1; fi
  done
  if [[ -d $SYNC_DIR.nova-prev ]]; then
    rm -rf "$SYNC_DIR.nova-old"
    if [[ -d $SYNC_DIR ]]; then mv "$SYNC_DIR" "$SYNC_DIR.nova-old"; fi
    mv "$SYNC_DIR.nova-prev" "$SYNC_DIR"
    rm -rf "$SYNC_DIR.nova-old"
  fi
  if (( restored )); then
    warn "put the previous mirror and repository files back"
  else
    warn "there were no previous mirror files to restore; the new ones stay, pacman.conf needs them"
  fi
}

drop_backup() {
  local f
  for f in "$MIRRORLIST" "$REPOFILE"; do rm -f "$f.nova-prev" "$f.nova-absent"; done
  rm -rf "$SYNC_DIR.nova-prev"
  rm -f "$BOOT_UNCHECKED"
}

snapshot() { # description, then extra snapper arguments; prints the snapshot number
  local desc=$1
  shift
  snapper -c "$SNAPPER_CONFIG" create "$@" --print-number \
    --cleanup-algorithm number --userdata important=yes --description "$desc"
}

# Packages a release adds to this computer's hardware profile (new firmware, a driver)
# arrive with the new nova package, so the list is read after the upgrade and the
# missing ones go in a second transaction. A failure here leaves a working system on
# the new release, so it warns rather than failing the update. A portable Nova
# (/etc/nova/portable) takes none: the model it is updated on is only one of many it
# starts, and a model's packages (NVIDIA's driver, linux-nova's modules) would not
# start the others.
# The profile's packages that are not installed, one a line.
hardware_missing() {
  local profile list name
  local -a wanted=()
  [[ ! -e $ROOT/etc/nova/portable ]] || return 0
  profile=$(NOVA_HARDWARE=$ROOT/usr/share/nova/hardware "${0%/*}/nova-hw-detect" 2>/dev/null) || return 0
  list=$ROOT/usr/share/nova/hardware/$profile/packages
  [[ -r $list ]] || return 0
  while IFS= read -r name; do
    name=${name%%#*}
    name=${name//[[:space:]]/}
    [[ -n $name ]] || continue
    [[ $name =~ ^[a-z0-9@._+-]+$ ]] || { warn "ignoring '$name' in $list"; continue; }
    # nvidia-open-nova is built for linux-nova; another kernel has Arch's, as
    # the installer and nova doctor read the list.
    if [[ $name == nvidia-open-nova ]] && ! pacman -T linux-nova > /dev/null 2>&1; then name=nvidia-open; fi
    wanted+=("$name")
  done < "$list"
  (( ${#wanted[@]} )) || return 0
  pacman -T "${wanted[@]}" || true
}

install_hardware_packages() { # 1 for --noconfirm, then a command prefix for pacman
  local noconfirm=$1
  local -a missing=() confirm=()
  shift
  (( ! noconfirm )) || confirm=(--noconfirm)
  mapfile -t missing < <(hardware_missing)
  (( ${#missing[@]} )) || return 0
  say "Installing for this computer: ${missing[*]}"
  "$@" pacman -S --needed "${confirm[@]}" "${missing[@]}" ||
    warn "could not install ${missing[*]}; try again with: sudo pacman -S ${missing[*]}"
}

# The graphics drivers this computer's GPUs need, as nova-hw-packages finds
# them: the 32-bit ones too once anything 32-bit is installed (Steam, Wine),
# without which a 32-bit game finds no Vulkan driver for the GPU it runs on.
# Then NVIDIA's drivers where an app brought them in only as "a Vulkan
# driver", which pacman picks by itself: on a computer with no NVIDIA kernel
# module to run them, nvidia-utils only blacklists nouveau, puts NVIDIA first
# for every EGL app and changes how the system suspends. Which those are is
# nova-hw-packages --stray's to say, as for nova doctor: only what pacman
# installed as a dependency goes, never one asked for by name, and pacman
# refuses if anything installed needs one by name. A repair, so a failure
# warns and the update goes on.

# What keep_graphics_drivers does, into graphics_missing (to install) and
# graphics_stray (to remove). Fails when it cannot tell.
graphics_plan() {
  local lib32=0 list stray
  local -a hw=() graphics=() wanted=()
  graphics_missing=() graphics_stray=()
  # pacman's own folder of what is installed, a folder a package: nothing
  # 32-bit and no nvidia-utils is nothing to do, without asking pacman.
  if compgen -G "$ROOT/var/lib/pacman/local/lib32-*" > /dev/null; then
    lib32=1
  elif ! compgen -G "$ROOT/var/lib/pacman/local/nvidia-utils-[0-9]*" > /dev/null; then
    return 0
  fi
  [[ ! -e $ROOT/etc/nova/portable ]] || hw=(--portable)
  if ! list=$("${0%/*}/nova-hw-packages" "${hw[@]}" --graphics) ||
    { (( lib32 )) && ! list+=$'\n'$("${0%/*}/nova-hw-packages" "${hw[@]}" --lib32); } ||
    ! stray=$("${0%/*}/nova-hw-packages" "${hw[@]}" --stray); then
    warn "could not tell which graphics drivers this computer needs"
    return 1
  fi
  mapfile -t graphics < <(grep . <<< "$list")
  mapfile -t graphics_stray < <(grep -xE '(lib32-)?nvidia-utils' <<< "$stray")
  # The 64-bit ones are the installer's already, but for a computer it did not
  # give one (a virtual machine's): removing NVIDIA's Vulkan driver needs
  # another in its place first.
  (( ! lib32 && ! ${#graphics_stray[@]} )) || wanted=("${graphics[@]}")
  if (( ${#wanted[@]} )); then mapfile -t graphics_missing < <(pacman -T "${wanted[@]}" || true); fi
  return 0
}

keep_graphics_drivers() { # 1 for --noconfirm, then a command prefix for pacman
  local noconfirm=$1
  local -a confirm=()
  shift
  (( ! noconfirm )) || confirm=(--noconfirm)
  graphics_plan || return 0
  if (( ${#graphics_missing[@]} )); then
    say "Installing this computer's graphics drivers: ${graphics_missing[*]}"
    # Without them in, NVIDIA's may be the only Vulkan driver there is: they
    # stay.
    if ! "$@" pacman -S --needed --asdeps "${confirm[@]}" "${graphics_missing[@]}"; then
      warn "could not install ${graphics_missing[*]}; try again with: sudo pacman -S --asdeps ${graphics_missing[*]}"
      (( ! ${#graphics_stray[@]} )) || warn "NVIDIA's stay until they do: ${graphics_stray[*]}"
      return 0
    fi
  fi
  (( ${#graphics_stray[@]} )) || return 0
  say "Removing NVIDIA drivers this computer cannot use: ${graphics_stray[*]}"
  "$@" pacman -Rns --noconfirm "${graphics_stray[@]}" ||
    warn "could not remove ${graphics_stray[*]}; pacman said why above"
}

# greetd's boot autologin, the line the installer wrote. Until 1.0.0-rc.15 it
# started uwsm itself, which left uwsm's errors on the console; since, it
# runs nova-session-start (data/session/bin/nova-session-start says why). It
# is set to the line the installed Nova has, either way: after a move back to
# a release without nova-session-start, a line naming it would leave every
# boot at the password greeter, and pacman runs only the scriptlets of the
# package coming in, which an older one does not have. The update runs it
# after pacman, and the nova package's post_upgrade (--login-command). A line
# changed by hand is left alone. Written beside the file and renamed over
# it, with its owner and mode, so that greetd never reads half of one: a
# full disk or a power cut leaves the old file whole.
LOGIN_UWSM='command = "env NOVA_LOGIN=autologin UWSM_SILENT_START=1 uwsm start -e -D Hyprland hyprland.desktop"'
LOGIN_NOVA='command = "env NOVA_LOGIN=autologin /usr/lib/nova/bin/nova-session-start"'
login_command() {
  local config=$ROOT/etc/greetd/config.toml old=$LOGIN_NOVA new=$LOGIN_UWSM tmp
  if [[ -x $ROOT/usr/lib/nova/bin/nova-session-start ]]; then old=$LOGIN_UWSM new=$LOGIN_NOVA; fi
  [[ -f $config && ! -L $config ]] && grep -qxF -- "$old" "$config" || return 0
  tmp=$(mktemp "$config.XXXXXX") || { warn "could not set greetd's login command in $config"; return 0; }
  if awk -v old="$old" -v new="$new" '$0 == old { print new; next } { print }' "$config" > "$tmp" &&
    chown --reference="$config" -- "$tmp" && chmod --reference="$config" -- "$tmp" &&
    sync -- "$tmp" && mv -f -- "$tmp" "$config"; then
    return 0
  fi
  rm -f -- "$tmp"
  warn "could not set greetd's login command in $config; it is as it was"
}

# Game controllers' and VR headsets' udev rules (steam-devices), which Steam
# and every game read, on every computer where the 32-bit repository they
# come from (multilib) is on. Not a dependency of nova: with that repository
# off, every update would fail at pacman -Su. The installer installs them,
# and this where they are missing.
controllers_missing() {
  pacman-conf --repo-list 2> /dev/null | grep -x multilib >/dev/null || return 0
  pacman -T steam-devices > /dev/null 2>&1 || echo steam-devices
}

install_controllers() { # 1 for --noconfirm, then a command prefix for pacman
  local noconfirm=$1
  local -a missing=() confirm=()
  shift
  (( ! noconfirm )) || confirm=(--noconfirm)
  mapfile -t missing < <(controllers_missing)
  (( ${#missing[@]} )) || return 0
  say "Installing game controllers' rules: ${missing[*]}"
  "$@" pacman -S --needed "${confirm[@]}" "${missing[@]}" ||
    warn "could not install ${missing[*]}; try again with: sudo pacman -S ${missing[*]}"
}

# Step 5, the repairs: what this computer's hardware and the release's
# packages call for, which needs no new release once the release is in.
repair_steps() { # 1 for --noconfirm, then a command prefix for pacman
  install_hardware_packages "$@"
  keep_graphics_drivers "$@"
  install_controllers "$@"
}

# What repair_steps would do, a line a step, as it says them.
repairs_said() {
  local -a missing=()
  mapfile -t missing < <(hardware_missing)
  (( ! ${#missing[@]} )) || echo "Installing for this computer: ${missing[*]}"
  if graphics_plan; then
    (( ! ${#graphics_missing[@]} )) || echo "Installing this computer's graphics drivers: ${graphics_missing[*]}"
    (( ! ${#graphics_stray[@]} )) || echo "Removing NVIDIA drivers this computer cannot use: ${graphics_stray[*]}"
  fi
  mapfile -t missing < <(controllers_missing)
  (( ! ${#missing[@]} )) || echo "Installing game controllers' rules: ${missing[*]}"
}

# What an earlier Nova depended on and this one does not (the retired list):
# with nothing to take it out, a package a release stops needing would stay
# installed for good. Only where pacman has it as a dependency that nothing
# installed needs (-Qdt), so one that was asked for by name, or that something
# else uses, stays.
drop_retired() { # a command prefix for pacman
  local list=$ROOT/usr/share/nova/retired name
  local -a unneeded=()
  [[ -r $list ]] || return 0
  while IFS= read -r name; do
    name=${name%%#*}
    name=${name//[[:space:]]/}
    # A package's name, which never begins as an option does.
    [[ $name =~ ^[a-z0-9][a-z0-9@._+-]*$ ]] || continue
    [[ $(pacman -Qdtq "$name" 2> /dev/null) != "$name" ]] || unneeded+=("$name")
  done < "$list"
  (( ${#unneeded[@]} )) || return 0
  say "Removing what Nova no longer needs: ${unneeded[*]}"
  "$@" pacman -Rns --noconfirm "${unneeded[@]}" ||
    warn "could not remove ${unneeded[*]}; try again with: sudo pacman -Rns ${unneeded[*]}"
}

# The apps nova apps install builds: the only packages --package takes.
BUILT_APPS=(google-chrome visual-studio-code-bin)

package_name() { # path
  local name=${1##*/}
  printf '%s\n' "${name%-*-*-*}"
}

# A package file as makepkg names one, name-version-release-arch.pkg.tar[.*],
# of one of those apps, owned by the account that ran pkexec.
valid_package() { # path
  [[ $1 == /* && -f $1 && ! -L $1 && ${1##*/} =~ ^[a-z0-9@._+-]+-[^/-]+-[^/-]+-(x86_64|any)\.pkg\.tar(\.[a-z0-9]+)?$ ]] || return 1
  [[ " ${BUILT_APPS[*]} " == *" $(package_name "$1") "* ]] || return 1
  [[ -z ${PKEXEC_UID:-} || $(stat -c %u -- "$1") == "$PKEXEC_UID" ]]
}

# Copied, as they are checked, to where only root writes: pacman reads them
# long after, once the release is in, and reads the files that were checked.
stage_packages() {
  (( ${#packages[@]} )) || return 0
  mkdir -p "$ROOT/var/tmp"
  staged=$(mktemp -d -p "$ROOT/var/tmp" nova-update.XXXXXX)
  local i copy
  for i in "${!packages[@]}"; do
    valid_package "${packages[i]}" || die "bad --package: ${packages[i]}"
    copy=$staged/${packages[i]##*/}
    cp -P -- "${packages[i]}" "$copy" && [[ -f $copy && ! -L $copy ]] || die "could not copy ${packages[i]}"
    packages[i]=$copy
  done
}

# A system installed offline starts with none of its repositories' package
# lists, and pacman would find none of the apps' dependencies: they are read
# once first. The repositories are pinned to the release, so nothing installed
# goes out of step with them.
read_missing_lists() {
  local repo
  for repo in $(pacman-conf --repo-list 2>/dev/null); do
    if [[ ! -e $SYNC_DIR/$repo.db ]]; then
      say "Reading the package lists"
      pacman -Sy
      return
    fi
  done
}

# The packages of --package. Failing leaves what came before in place, the
# release among it, so the caller decides what that means.
install_built_packages() { # then a command prefix for pacman
  (( ${#packages[@]} )) || return 0
  local -a names=()
  local file status=0
  for file in "${packages[@]}"; do names+=("$(package_name "$file")"); done
  say "Installing ${names[*]}"
  "$@" pacman -U --needed --noconfirm "${packages[@]}" || status=$?
  rm -rf -- "$staged"
  staged=''
  (( status == 0 )) || warn "could not install ${names[*]}; nova apps install tries again"
  return "$status"
}

# --- boot entry verification ------------------------------------------------------

find_esp() {
  local f esp
  for f in "$ROOT/etc/default/limine" "$ROOT/etc/limine-entry-tool.conf" "$ROOT"/etc/limine-entry-tool.d/*.conf; do
    [[ -r $f ]] || continue
    esp=$(grep -h -E '^[[:space:]]*ESP_PATH=' "$f" | tail -n 1 | sed 's/^[^=]*=//' | tr -d "\"'" | sed 's/[[:space:]].*//')
    if [[ -n $esp ]]; then
      printf '%s' "$ROOT$esp"
      return 0
    fi
  done
  for esp in /efi /boot /boot/efi; do
    if [[ -f $ROOT$esp/limine.conf ]]; then
      printf '%s' "$ROOT$esp"
      return 0
    fi
  done
  return 1
}

# True when the boot partition fstab names is not mounted: its directory is then an
# empty one on the root filesystem, which the firmware never reads. The scratch
# roots of the tests have no mounts to check.
esp_unmounted() { # esp
  [[ -z $ROOT ]] || return 1
  findmnt -n -s -- "$1" > /dev/null 2>&1 && ! mountpoint -q -- "$1"
}

# Succeeds when limine.conf exists, names every installed kernel, and every file it
# loads from the boot partition is there. Entries that live in a snapshot (written by
# limine-snapper-sync) point into the root filesystem and cannot be checked from here.
verify_boot_entries() {
  local esp conf pkgbase_file pkgbase pattern kver uki line value rel ok=0
  esp=$(find_esp) || { warn "no limine.conf found (looked at ESP_PATH, /efi, /boot, /boot/efi)"; return 1; }
  if esp_unmounted "$esp"; then
    warn "the boot partition is not mounted at $esp"
    return 1
  fi
  conf=$esp/limine.conf
  [[ -s $conf ]] || { warn "$conf is missing or empty"; return 1; }

  for pkgbase_file in "$ROOT"/usr/lib/modules/*/pkgbase; do
    [[ -r $pkgbase_file && -e ${pkgbase_file%pkgbase}vmlinuz ]] || continue
    pkgbase=$(<"$pkgbase_file")
    kver=${pkgbase_file%/pkgbase}
    kver=${kver##*/}
    # The name as a whole word, so linux is not found in linux-lts; still loose
    # about how limine-entry-tool names the entry around it.
    pattern=${pkgbase//./\\.}
    pattern=${pattern//+/\\+}
    # Not a pipe: grep -q stops at the first match, and pipefail would count
    # the first grep's broken pipe on a long limine.conf as no match.
    if ! grep -qE -- "(^|[^A-Za-z0-9+-])$pattern([^A-Za-z0-9+-]|$)" <<<"$(grep -v '^[[:space:]]*#' "$conf")"; then
      warn "$conf has no boot entry for the installed kernel $pkgbase"
      ok=1
    fi
    # An image the kernel hook did not rebuild boots the old kernel, whose
    # modules this update removed. Each image carries its kernel's version.
    for uki in "$esp"/EFI/Linux/*_"$pkgbase".efi "$esp"/EFI/Linux/*_"$pkgbase"-fallback.efi; do
      [[ -f $uki ]] || continue
      if ! LC_ALL=C grep -aqF -- "$kver" "$uki"; then
        warn "${uki#"$esp"/} was not rebuilt for the installed $pkgbase ($kver)"
        ok=1
      fi
    done
  done

  while IFS= read -r line; do
    value=${line#*:}
    value=${value#"${value%%[![:space:]]*}"} # ltrim
    value=${value%%#*}                      # drop a #blake2b hash suffix
    value=${value%"${value##*[![:space:]]}"} # rtrim
    [[ $value =~ ^boot\(\):(/.+)$ ]] || continue
    rel=${BASH_REMATCH[1]}
    if [[ ! -e $esp$rel ]]; then
      warn "$conf loads $rel but $esp$rel does not exist"
      ok=1
    fi
  done < <(grep -E '^[[:space:]]*(path|kernel_path|module_path|image_path|dtb_path):' "$conf" || true)

  return "$ok"
}

# Why this machine has to restart to run what was installed, if it has to.
reboot_reason() {
  local loaded installed
  if [[ ! -d /usr/lib/modules/$(uname -r) ]]; then
    echo "The running kernel was replaced"
    return 0
  fi
  # NVIDIA's module and its libraries must be the same version; the loaded
  # module stays the old one until a restart.
  if [[ -r /sys/module/nvidia/version ]] && installed=$(pacman -Q nvidia-utils 2>/dev/null); then
    read -r loaded </sys/module/nvidia/version || loaded=''
    installed=${installed#* }
    installed=${installed%-*}
    installed=${installed#*:}
    if [[ $loaded != "$installed" ]]; then
      echo "The NVIDIA driver was updated"
      return 0
    fi
  fi
  return 1
}

# pacman failed: the previous files back, the snapshot pair closed, and
# Hyprland reloading again (the hook that would have done it runs only after
# a transaction that went through).
pacman_failed() {
  restore_config
  NOVA_HYPRLAND_RELOAD_GUARD_RUN_ROOT=$ROOT/run/user NOVA_HYPRLAND_RELOAD_GUARD_STATE_DIR=$ROOT/run/nova/hyprland-reload-guard \
    "${0%/*}/nova-hyprland-reload-guard" resume 2>/dev/null || true
  if [[ -n $pre ]]; then
    snapshot "$label (pacman failed)" --type post --pre-number "$pre" > /dev/null ||
      warn "could not close snapshot $pre"
    warn "snapshot $pre was taken before the attempt"
  fi
  die "pacman failed; check its output above. The system is as pacman left it: run nova update again once the problem is fixed."
}

# What to do about boot entries that do not check out, after the update or a
# check of them.
boot_advice() { # [snapshot number]
  local esp=''
  esp=$(find_esp) || esp=/boot
  if esp_unmounted "$esp"; then
    warn "Mount the boot partition (sudo mount $esp), run sudo limine-update, then nova update --check-boot."
  else
    warn "Run sudo limine-update, then nova update --check-boot to look again."
  fi
  [[ -z ${1:-} ]] || warn "Snapshot $1 is the state before this update."
}

# The checks the update ends with, on their own.
check_boot() {
  if ! verify_boot_entries || ! "${0%/*}/nova-boot-check" status; then
    warn "the boot entries do NOT check out. Do not reboot yet."
    boot_advice
    return 3
  fi
  say "Boot entries look right"
  # After the repair an update asked for (boot_advice): that update is done.
  if [[ -e $BOOT_UNCHECKED ]]; then
    drop_backup
    say "The update is finished"
  fi
}

# --- room -------------------------------------------------------------------------

# MiB free on the file system a path is on. NOVA_FREE_SPACE, a test seam, is a
# file of "<path> <MiB>" lines read instead, as NOVA_PROC_STAT is for /proc/stat.
free_mib() { # path
  if [[ -n ${NOVA_FREE_SPACE:-} ]]; then
    awk -v path="$1" '$1 == path { print $2; found = 1; exit } END { exit !found }' "$NOVA_FREE_SPACE"
    return
  fi
  stat -f -c '%a %S' -- "$1" | awk '{ printf "%d\n", $1 * $2 / 1048576 }'
}

# MiB of the images on the boot partition that pacman's kernel hook writes
# again: each installed kernel's, and its fallback.
images_mib() { # esp
  local pkgbase_file pkgbase image bytes=0
  for pkgbase_file in "$ROOT"/usr/lib/modules/*/pkgbase; do
    [[ -r $pkgbase_file && -e ${pkgbase_file%pkgbase}vmlinuz ]] || continue
    pkgbase=$(<"$pkgbase_file")
    for image in "$1"/EFI/Linux/*_"$pkgbase".efi "$1"/EFI/Linux/*_"$pkgbase"-fallback.efi; do
      [[ -f $image ]] || continue
      bytes=$((bytes + $(stat -c %s -- "$image")))
    done
  done
  echo $(((bytes + 1048575) / 1048576))
}

in_words() { # MiB
  if (($1 >= 1024)); then
    awk -v mib="$1" 'BEGIN { s = sprintf("%.1f", mib / 1024); sub(/\.0$/, "", s); print s " GiB" }'
  else
    echo "$1 MiB"
  fi
}

# A full disk stops pacman halfway, the system half one release and half the
# other, with a message that never says the disk is full. So the room is
# looked at before anything changes.
#
# On /: the update's downloads, and its packages unpacked. Every file pacman
# replaces stays in the pre-update snapshot, so nothing it replaces frees room
# while it runs, which pacman's own CheckSpace counts on. The biggest two weeks
# on the P1 Gen 4i so far were 0.7 GiB downloaded and 1.9 GiB unpacked (81
# packages, 2026-11-11); ROOT_NEED_MIB leaves room for a release that moves
# further, or a computer that skipped one.
#
# On the boot partition: the images the kernel hook writes again. mkinitcpio
# builds each in /tmp, and limine-entry-tool copies it in beside the one it
# replaces, which a snapshot's boot entry may keep: room for what they take
# now, once more, and a little for one that grows.
check_space() { # esp, or nothing
  local free need
  if free=$(free_mib "$ROOT/") && ((free < ROOT_NEED_MIB)); then
    die "the disk is too full to update: / has $(in_words "$free") free, and an update needs $(in_words "$ROOT_NEED_MIB"), so nothing was changed." \
      "Old snapshots keep deleted files (snapper list, then sudo snapper delete <number>), and sudo pacman -Sc deletes old downloads"
  fi
  [[ -n $1 ]] || return 0
  need=$(($(images_mib "$1") + 64))
  if free=$(free_mib "$1") && ((free < need)); then
    die "the boot partition is too full to update: it has $(in_words "$free") free, and the boot images the update writes need $(in_words "$need"), so nothing was changed." \
      "Each snapshot in the boot menu keeps images there; deleting old ones (snapper list, then sudo snapper delete <number>) takes theirs away"
  fi
}

# --- main -------------------------------------------------------------------------

main() {
  local tag='' version='' arch_date='' nova_repo='' from='' snapshot=1 downgrade=0 noconfirm=0 only_boot=0 only_packages=0
  local repair=0 repairs=0 after_pacman=0 lock_fd='' pre_arg='' only_login=0
  packages=() staged=''
  while (( $# )); do
    case $1 in
      --check-boot)      only_boot=1; shift ;;
      --packages-only)   only_packages=1; shift ;;
      --repair)          repair=1; shift ;;
      --repairs)         repairs=1; shift ;;
      --login-command)   only_login=1; shift ;;
      --after-pacman)    after_pacman=1; shift ;;
      --lock-fd)         lock_fd=${2:?}; shift 2 ;;
      --pre)             pre_arg=${2:?}; shift 2 ;;
      --package)         packages+=("${2:?}"); shift 2 ;;
      --tag)             tag=${2:?}; shift 2 ;;
      --version)         version=${2:?}; shift 2 ;;
      --arch-date)       arch_date=${2:?}; shift 2 ;;
      --nova-repo)       nova_repo=${2:?}; shift 2 ;;
      --from)            from=${2:?}; shift 2 ;;
      --no-snapshot)     snapshot=0; shift ;;
      --allow-downgrade) downgrade=1; shift ;;
      --noconfirm)       noconfirm=1; shift ;;
      *) die "unknown argument: $1" ;;
    esac
  done

  # Reads, as whoever runs it, and changes nothing.
  if (( repairs )); then
    repairs_said
    return 0
  fi
  (( EUID == 0 )) || [[ -n $ROOT ]] || die "this helper must run as root; use 'nova update'"
  # The nova package's post_upgrade, inside pacman's transaction, which an
  # update may be running: no lock.
  if (( only_login )); then
    login_command
    return 0
  fi
  if (( only_boot )); then
    take_lock
    check_boot
    return
  fi
  stage_packages
  if (( only_packages )); then
    (( ${#packages[@]} )) || die "--packages-only needs a --package"
    take_lock
    read_missing_lists
    install_built_packages || return 4
    return
  fi
  if (( repair )); then
    take_lock
    repair_current
    return
  fi
  [[ $tag =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$ ]] || die "bad --tag"
  [[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$ && v$version == "$tag" ]] || die "bad --version"
  [[ $arch_date =~ ^[0-9]{4}/[0-9]{2}/[0-9]{2}$ ]] || die "bad --arch-date"
  [[ $nova_repo =~ ^https://[A-Za-z0-9._~:/%+-]+$ ]] || die "bad --nova-repo"
  [[ -z $from || $from =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$ ]] || die "bad --from"
  label="nova update ${from:+$from -> }$tag" pre=''

  if (( after_pacman )); then
    [[ -z $pre_arg || $pre_arg =~ ^[0-9]+$ ]] || die "bad --pre"
    pre=$pre_arg
    take_handed_lock "$lock_fd"
    trap 'exec >>"$LOG" 2>&1; echo "==> the terminal closed; continuing here"' HUP
    trap '' PIPE
    restore_on_exit=0
    trap on_exit EXIT
    after_pacman
    return
  fi

  take_lock

  # Kernel images written while the boot partition is not mounted land where
  # the firmware never looks. Its pacman hook would refuse them anyway, after
  # the pins had changed; better to stop before anything does.
  local esp=''
  if esp=$(find_esp) && esp_unmounted "$esp"; then
    die "the boot partition is not mounted at $esp; mount it (sudo mount $esp) and try again. Nothing was changed."
  fi
  check_space "$esp"

  # Read by pacman_failed. pacman finishes a transaction when the terminal
  # closes; so does this, writing to the log instead. With SIGPIPE ignored, a
  # reader that goes away stops neither this nor pacman (out() above).
  trap 'exec >>"$LOG" 2>&1; echo "==> the terminal closed; continuing here"' HUP
  trap '' PIPE
  restore_on_exit=0
  trap on_exit EXIT
  hold_power
  if (( snapshot )); then
    say "Taking the pre-update snapshot"
    pre=$(snapshot "$label" --type pre) ||
      die "snapper could not take a snapshot, so nothing was changed (--no-snapshot goes on without one)"
    [[ $pre =~ ^[0-9]+$ ]] || die "snapper printed '$pre' instead of a snapshot number; nothing was changed"
    say "Snapshot $pre taken"
  else
    warn "continuing without snapshots, as asked"
  fi

  # Stopped between here and the end of pacman, the new mirror files would stay
  # without the update they belong to. Like pacman's own commit, this does not
  # stop halfway: Ctrl+C still reaches pacman, which sets its own handler, and
  # stops it cleanly, and pacman_failed puts the old files back.
  trap '' INT
  # Read before the pins change: what no repository has already (the apps
  # built here, say) is not the move's to take out.
  local -a foreign=()
  (( ! downgrade )) || mapfile -t foreign < <(pacman -Qqm 2> /dev/null || true)
  backup_config
  say "Pointing pacman at Arch snapshot $arch_date and $tag"
  # Until pacman starts, any error must put both pins back, including a
  # failed second write after the first file was replaced.
  restore_on_exit=1
  write_config

  local -a pacman_args=(-Su)
  (( ! downgrade )) || pacman_args=(-Suu)
  (( ! noconfirm )) || pacman_args+=(--noconfirm)

  # snap-pac would add a second pair of snapshots around the same transaction.
  local -a env_skip=()
  (( ! snapshot )) || env_skip=(env SNAP_PAC_SKIP=y)
  say "Updating the keyrings"
  restore_on_exit=0
  "${env_skip[@]}" pacman -Syy --needed --noconfirm archlinux-keyring nova-keyring || pacman_failed
  left=() left_files=()
  local -a overwrite=()
  if (( downgrade )); then
    left_behind "${foreign[@]}"
    if (( ${#left[@]} )); then
      say "The older release has no ${left[*]}: taken out with the move"
      mapfile -t overwrite < <(overwrite_flags)
    fi
  fi
  say "pacman ${pacman_args[*]}"
  # A line at a time, also into a pipe: Settings reads how far it is from it.
  "${env_skip[@]}" stdbuf -oL pacman "${pacman_args[@]}" "${overwrite[@]}" || pacman_failed
  (( ! ${#left[@]} )) || drop_left_behind "${env_skip[@]}"
  trap - INT

  local status=0
  run_installed || status=$?
  if (( status == 125 )); then
    status=0
    after_pacman || status=$?
  fi
  return "$status"
}

# Steps 5 to 7, with what main read: whichever nova-update-apply runs them.
after_pacman() {
  local esp=''
  esp=$(find_esp) || esp=''
  local -a env_skip=()
  (( ! snapshot )) || env_skip=(env SNAP_PAC_SKIP=y)

  login_command
  repair_steps "$noconfirm" "${env_skip[@]}"
  # An app that will not go in is said, and the rest goes on.
  local apps=0
  install_built_packages "${env_skip[@]}" || apps=4
  drop_retired "${env_skip[@]}"

  if [[ -n $pre ]]; then
    say "Taking the post-update snapshot"
    snapshot "$label" --type post --pre-number "$pre" > /dev/null ||
      warn "could not take the post-update snapshot (pre-update snapshot is $pre)"
  fi

  say "Checking the boot entries"
  if ! verify_boot_entries; then
    if ! esp_unmounted "$esp" && command -v limine-update > /dev/null 2>&1; then
      warn "regenerating boot entries with limine-update"
      limine-update || warn "limine-update failed"
      verify_boot_entries && { say "Boot entries repaired"; finished; return "$apps"; }
    fi
    warn "the boot entries do NOT check out. Do not reboot yet."
    boot_advice "$pre"
    : > "$BOOT_UNCHECKED"
    return 3
  fi

  say "Boot entries look right"
  finished
  return "$apps"
}

# Steps 5 to 7 by the nova-update-apply pacman just installed: its status,
# or 125 when this one is to run them itself. That copy is the new release's
# (or this one's again, when nova was already in), under this run's lock and
# hold on shutting down. It takes the built packages from the copies made at
# the start, which are root's, so as a run of root's, without PKEXEC_UID.
run_installed() {
  local next=${0%/*}/nova-update-apply status=0 file
  [[ -f $next && -x $next ]] && grep -qx '# nova:after-pacman=1' "$next" || return 125
  local -a args=(--after-pacman --lock-fd "$update_lock" --tag "$tag" --version "$version"
    --arch-date "$arch_date" --nova-repo "$nova_repo")
  [[ -z $from ]] || args+=(--from "$from")
  [[ -z $pre ]] || args+=(--pre "$pre")
  (( snapshot )) || args+=(--no-snapshot)
  (( ! noconfirm )) || args+=(--noconfirm)
  (( ! downgrade )) || args+=(--allow-downgrade)
  for file in "${packages[@]}"; do args+=(--package "$file"); done
  env -u PKEXEC_UID "$next" "${args[@]}" || status=$?
  # Not started at all (126, 127): this one goes on.
  (( status != 126 && status != 127 )) || { warn "could not start $next; going on with this one"; return 125; }
  [[ -z $staged ]] || rm -rf -- "$staged"
  staged=''
  return "$status"
}

# Step 5 on a system already on the newest release (--repair), with the built
# apps after it. Not while an update is unfinished: that one has to end first,
# as nova update does.
repair_current() {
  local f
  for f in "$MIRRORLIST" "$REPOFILE" "$SYNC_DIR"; do
    [[ ! -e $f.nova-prev && ! -e $f.nova-absent ]] ||
      die "the last update did not finish: nova update finishes it. Nothing was changed."
  done
  read_missing_lists
  repair_steps "$noconfirm"
  install_built_packages || return 4
}

# Pacman's lock starts too late to protect the pins and their backups.
# /run is owned by root, so another account cannot supply this lock file.
take_lock() {
  mkdir -p "$ROOT/run"
  exec {update_lock}>"$ROOT/run/nova-update.lock"
  flock -n "$update_lock" || die "another Nova update is running"
  clear_stale_pacman_lock
}

# The lock of the run that started this one (run_installed), handed down
# open: an open file of this lock, held, or that this one can hold.
take_handed_lock() { # fd
  [[ $1 =~ ^[0-9]+$ && /proc/self/fd/$1 -ef $ROOT/run/nova-update.lock ]] ||
    die "--after-pacman is the update's own step: its --lock-fd is the update's lock"
  update_lock=$1
  flock -n "$update_lock" || die "another Nova update is running"
}

# pacman's own lock, left by a computer that lost power in the middle of a
# transaction, fails every update after it. One older than this boot can be
# held by nothing that still runs; one made since may be a pacman's at work.
clear_stale_pacman_lock() {
  local lock=$ROOT/var/lib/pacman/db.lck booted made
  [[ -e $lock ]] || return 0
  booted=$(awk '$1 == "btime" { print $2 }' "${NOVA_PROC_STAT:-/proc/stat}" 2> /dev/null)
  made=$(stat -c %Y -- "$lock" 2> /dev/null) || return 0
  [[ $booted =~ ^[0-9]+$ ]] && (( made < booted )) || return 0
  warn "pacman's lock was left by a computer that stopped in the middle of an update; it is taken away"
  rm -f -- "$lock"
}

# Going back to an older snapshot, a package the newer one brought in as a
# dependency is in none of the databases any more, so pacman leaves it where it
# is: and where it owns a file the older packages have themselves, the move
# down stops on the conflict. On 2026-11-10 openssl 4.1 brought openssl-3,
# which owns the libcrypto.so.3 that openssl 3.6 brings back. Such packages go
# with the move: their files may be written over (overwrite_flags), and once
# the older versions are in, they are taken out (drop_left_behind). Taken out
# first, what still runs against them would be broken in between, pacman
# itself among it. What was installed by hand stays: that was asked for.
left_behind() { # the packages no repository had before the pins changed
  mapfile -t left < <(LC_ALL=C comm -13 <(printf '%s\n' "$@" | LC_ALL=C sort -u) \
    <(pacman -Qqdm 2> /dev/null | LC_ALL=C sort -u))
  (( ${#left[@]} )) || return 0
  mapfile -t left_files < <(pacman -Qlq "${left[@]}" | LC_ALL=C sort -u)
}

# pacman's --overwrite for each of their files, a pattern that matches that
# file alone: no leading slash, and nothing in the name read as a wildcard.
overwrite_flags() {
  printf '%s\n' "${left_files[@]}" |
    sed -n -e '/\/$/d' -e '/^$/d' -e 's|^/||' -e 's/[][\\*?]/\\&/g' -e 's/^/--overwrite\n/p'
}

# Out of pacman's books, and off the disk what they alone owned: pacman -R
# would take the files the older packages now own as well. Not -dd: one that
# something installed still needs stays, and pacman says which. A file goes
# only when pacman has listed what every package owns and it is not there: with
# no list to go by, all of them stay.
drop_left_behind() { # then a command prefix for pacman
  local path owned
  if ! "$@" pacman -R --dbonly --noconfirm "${left[@]}" > /dev/null; then
    warn "${left[*]} could not be taken out, which the older release does not have: pacman said why above"
    return 0
  fi
  owned=$(mktemp)
  if ! pacman -Qlq > "$owned" || [[ ! -s $owned ]]; then
    warn "pacman did not list what the packages own, so the files of ${left[*]} stay where they are"
    rm -f -- "$owned"
    return 0
  fi
  while IFS= read -r path; do
    [[ $path == /* ]] || continue
    if [[ $path == */ ]]; then
      rmdir -- "$ROOT$path" 2> /dev/null || true
    else
      rm -f -- "$ROOT$path" || true
    fi
  done < <(LC_ALL=C sort -u "$owned" | LC_ALL=C comm -23 <(printf '%s\n' "${left_files[@]}") - | LC_ALL=C sort -r)
  rm -f -- "$owned"
}

# Until this ends, the computer does not shut down or restart, from the menu,
# the power key or systemctl: stopped in the middle, pacman would leave the
# release half installed. Nor does closing the lid put it to sleep, in a bag
# say, where the update would wait until it was opened: logind leaves the lid
# alone while a handle-lid-switch hold is there, as under Caffeine, and Nova's
# lid binding (nova-system-lid-close) sees the hold and locks and darkens the
# panel instead. Only the lid: a Suspend from the menu still sleeps, and so
# does UPower at the battery's end, which a sleep hold would refuse; pacman
# goes on after the wake. Once the update is over with the lid still shut,
# logind sleeps as it would have.
#
# logind lets go when this process ends, however it ends: at once as it
# leaves (on_exit), and within the second tail takes to see it gone had it
# been killed outright. The scratch roots of the tests have no logind to ask.
hold_power() {
  [[ -z $ROOT ]] && command -v systemd-inhibit > /dev/null 2>&1 || return 0
  (
    trap '' HUP INT PIPE
    exec systemd-inhibit --what=shutdown:handle-lid-switch --mode=block --who="nova update" \
      --why="Installing Nova $tag; stopped now it would be left half done" \
      tail --pid=$$ -f /dev/null
  ) < /dev/null > /dev/null 2>&1 &
  power_hold=$!
}

# Waited for, so that a restart asked for the moment the update ends is not
# refused in its name.
release_power() {
  [[ -n ${power_hold:-} ]] || return 0
  kill "$power_hold" 2> /dev/null || true
  wait "$power_hold" 2> /dev/null || true
  power_hold=''
}

# However the update ends: the pins back if it ends before pacman has them,
# then the shutdown and the lid let go.
on_exit() {
  if (( ${restore_on_exit:-0} )); then
    restore_on_exit=0
    restore_config
  fi
  release_power
}

finished() {
  drop_backup
  local reason
  if [[ -z $ROOT ]] && reason=$(reboot_reason); then
    out 1 "$reason: restart to finish the update."
  fi
  out 1 "Nova is now on $tag."
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
