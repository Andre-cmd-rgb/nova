#!/bin/bash

# nova:summary=Returns true when the compositor holds a session lock
# nova:hidden=true

set -euo pipefail

# Hyprland has no query for its session lock. It does list what keeps each
# monitor from going solitary, and a held ext-session-lock is LOCK there, which
# stays after the locker that took it has died: the case to catch.
#
# Exits 0 locked, 1 unlocked, 2 when it cannot be told. Hyprland stops at the
# first reason, and on a monitor without a workspace that is WORKSPACE, before
# LOCK is looked at; when every monitor stops there, nothing was asked. A
# caller that only tests for success takes 2 as unlocked.
monitors=$(hyprctl -j monitors 2>/dev/null) || exit 2
answer=$(jq '
  def blocked_by($reason): (.solitaryBlockedBy // []) | index($reason) != null;
  if any(.[]; blocked_by("LOCK")) then 0
  elif any(.[]; blocked_by("WORKSPACE") | not) then 1
  else 2 end
' <<<"$monitors" 2>/dev/null) || true
[[ $answer == [01] ]] || answer=2
exit "$answer"
