#!/bin/bash

# nova:summary=Show or set the hours Do Not Disturb holds every day
# nova:args=[off | hours | <from> <to>]
# nova:examples=nova notification schedule | nova notification schedule 22:00 07:00 | nova notification schedule off
#
# doNotDisturb in ~/.config/nova/shell.json, which the shell's notifications
# follow: Do Not Disturb comes on at the first time and goes off at the
# second, every day, on the clock. `hours` alone takes the hours set before,
# 22:00 to 07:00 at first. A switch by hand, from the bar, the keys or the
# menu, lasts until the next turn.

set -euo pipefail

source nova-shell-config

usage="usage: nova notification schedule [off|hours|<from> <to>], the times as 22:00"

# A time of day as HH:MM, or nothing for anything else.
time_of_day() {
  [[ $1 =~ ^([01]?[0-9]|2[0-3]):([0-5][0-9])$ ]] || return 1
  printf '%02d:%s\n' "$((10#${BASH_REMATCH[1]}))" "${BASH_REMATCH[2]}"
}

said() {
  in_effect | jq -r '.doNotDisturb | objects // {} |
    if .schedule == "hours" then "From \(.from // "22:00") to \(.to // "07:00"), every day."
    else "Off: Do Not Disturb comes on only by hand." end'
}

case ${1:-} in
  "")
    (($# == 0)) || fail "$usage"
    said
    ;;
  off | hours)
    (($# == 1)) || fail "$usage"
    commit '.doNotDisturb = (.doNotDisturb | objects // {}) + {schedule: $schedule}' --arg schedule "$1"
    said
    ;;
  *)
    (($# == 2)) && from=$(time_of_day "$1") && to=$(time_of_day "$2") || fail "$usage"
    [[ $from != "$to" ]] || fail "Do Not Disturb's hours start and end at different times"
    commit '.doNotDisturb = (.doNotDisturb | objects // {}) + {schedule: "hours", from: $from, to: $to}' --arg from "$from" --arg to "$to"
    said
    ;;
esac
