#!/bin/bash

# nova:summary=Watch Hyprland monitor events and recover monitor toggles when a monitor is removed
# nova:hidden=true

set -euo pipefail

if [[ -z ${XDG_RUNTIME_DIR:-} || -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  echo "nova-hyprland-monitor-watch: not running inside a Hyprland session" >&2
  exit 1
fi

SOCKET="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
LOCK_DIR="$XDG_RUNTIME_DIR/nova"
LOCK="$LOCK_DIR/monitor-clamshell.lock"
MODELESS_LOCK="$LOCK_DIR/monitor-modeless.lock"
mkdir -p "$LOCK_DIR"

# A failed sync must not stop the watcher: the delayed re-syncs and the poll
# below retry it, and nothing else would restart this process.
sync_clamshell() {
  (
    flock -n 9 || exit 0
    nova-hyprland-monitor-clamshell || true
  ) 9>"$LOCK"
}

# Hyprland reports each monitor twice (v1 and v2) and a dock brings several
# at once, so the passes follow the last of a burst: an event moments after
# another leaves the pass to the delayed ones, and the delayed ones start
# again, from the newest event. Killing the old schedule leaves a pass it is
# in the middle of to finish.
delayed_pid="" last_change=0
sync_clamshell_after_monitor_change() {
  local now=${EPOCHREALTIME/./}
  ((now - last_change < 500000)) || sync_clamshell
  last_change=$now

  [[ -z $delayed_pid ]] || kill "$delayed_pid" 2>/dev/null || true
  (
    for delay in 1 3 7; do
      sleep "$delay"
      sync_clamshell
    done
  ) &
  delayed_pid=$!
}

# Powering the monitor on fires no DRM hotplug, and forcing a re-probe needs
# root, so only a reload re-reads the EDID and only a reload reveals whether it
# worked. Back off: the machine can sit like this all night. The lock keeps one
# loop running across the events that call this; the wait is for an event landing
# in the moment one is exiting, which would otherwise be the last one to come.
recover_modeless() {
  (
    flock -w 1 9 || exit 0

    local delay=3 state reloaded unanswered=0

    while true; do
      # The status is the answer (0 modeless, 1 not, 2 unknown), not a failure.
      state=0
      nova-hyprland-monitor-modeless || state=$?

      # A monitor reporting a mode is recovered. One the compositor cannot speak
      # for is not an answer, and nothing else will ask again -- but a compositor
      # that stays silent has gone, taking the session and this loop's reason
      # with it.
      if ((state == 1)); then
        break
      elif ((state == 2)); then
        unanswered=$((unanswered + 1))
        ((unanswered <= 20)) || break
      else
        unanswered=0
      fi

      reloaded=0
      # Reloading into half-replaced package config is what the guard prevents.
      if ((state == 0)) && ! nova-hyprland-reload-guard paused; then
        hyprctl reload >/dev/null 2>&1 || true
        reloaded=1
      fi

      sleep "$delay"
      if ((reloaded)); then
        delay=$((delay * 2))
        ((delay <= 60)) || delay=60
      fi
    done
  ) 9>"$MODELESS_LOCK" &
}

# A pass of nova-hyprland-monitor-clamshell is some 25 processes, and nearly
# always nothing has moved: every two seconds the poll reads the lid itself (a
# builtin read, no process), and passes when it has moved since the last
# pass, or every 30 s for drift the lid does not show.
poll_clamshell_state() {
  local lid last="" polls=0 state word
  while true; do
    sleep 2
    lid=""
    for state in "${NOVA_LID_PATH:-/proc/acpi/button/lid}"/*/state; do
      [[ -r $state ]] && read -r _ word <"$state" && lid+=$word
    done
    polls=$((polls + 1))
    if [[ $lid != "$last" ]] || ((polls >= 15)); then
      sync_clamshell
      last=$lid
      polls=0
    fi
  done
}

# The internal panel is only ever disabled while a laptop is docked (lid shut
# with an external monitor active), so the reconciliation poll only has anything
# to reconcile while an external monitor is active. Run it then, stop it when
# there is none, and never on a machine without a lid. Lid open/close itself is
# handled by the Hyprland "switch:*:Lid Switch" binds; this poll is the recovery
# backstop for drift those binds can miss (e.g. across suspend/resume).
poll_pid=""
sync_poll_state() {
  if nova-hw-laptop && nova-hyprland-monitor-external-active; then
    if [[ -z $poll_pid ]] || ! kill -0 "$poll_pid" 2>/dev/null; then
      poll_clamshell_state &
      poll_pid=$!
    fi
  elif [[ -n $poll_pid ]]; then
    kill "$poll_pid" 2>/dev/null || true
    poll_pid=""
  fi
}

sync_clamshell_after_monitor_change
sync_poll_state
recover_modeless

# Process substitution (not a pipe) keeps this loop in the main shell, so
# sync_poll_state can start and stop the background poll as monitors come and go.
while read -r event; do
  case "$event" in
    monitoradded\>\>* | monitoraddedv2\>\>* | monitorremoved\>\>* | monitorremovedv2\>\>*)
      sync_clamshell_after_monitor_change
      sync_poll_state
      recover_modeless
      ;;
    # A reload while the monitor is unpowered leaves it at 0x0 with no hotplug
    # to notice, same as at boot. Our own recovery reload lands here too, and is
    # a no-op while its loop still holds the pid.
    configreloaded\>\>*)
      recover_modeless
      ;;
  esac
done < <(socat -U - "UNIX-CONNECT:$SOCKET")
