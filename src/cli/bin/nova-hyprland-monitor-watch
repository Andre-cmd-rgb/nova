#!/bin/bash

# nova:summary=Watch Hyprland monitor events and recover monitor toggles when a monitor is removed
# nova:hidden=true

set -euo pipefail

if [[ -z ${XDG_RUNTIME_DIR:-} || -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  echo "nova-hyprland-monitor-watch: not running inside a Hyprland session" >&2
  exit 1
fi

events=$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock
locks=$XDG_RUNTIME_DIR/nova
mkdir -p "$locks"

# One clamshell pass at a time: a pass asked for while one runs is that one.
# A pass that fails leaves the watcher running, as nothing would start it
# again; the passes after it try again. X11 apps then take the scale of the
# displays the pass left on.
clamshell_pass() {
  (
    flock -n 9 || exit 0
    nova-hyprland-monitor-clamshell || true
    nova-hyprland-x11-scale || true
  ) 9>"$locks/monitor-clamshell.lock"
}

# Hyprland announces each display twice (v1 and v2), and a dock brings several
# at once. The first event of a burst runs a pass; one moments after another
# leaves it to the passes 1, 3 and 7 seconds later, which start over from the
# newest event. A pass they are in the middle of finishes.
# EPOCHREALTIME has the locale's decimal separator, which is not always a dot.
delayed="" last_event=0
after_monitor_change() {
  local now=${EPOCHREALTIME//[!0-9]/}
  ((now - last_event < 500000)) || clamshell_pass
  last_event=$now

  if [[ -n $delayed ]]; then kill "$delayed" 2>/dev/null || true; fi
  (
    for pause in 1 3 7; do
      sleep "$pause"
      clamshell_pass
    done
  ) &
  delayed=$!
}

# A display powered on after it was found fires no hotplug, and asking the
# kernel to probe it again takes root: only a reload reads its EDID again, and
# only the reload shows whether that worked. The machine can sit like this all
# night, so the reloads back off, from 3 seconds to a minute. The lock keeps
# one loop across the events that start one; its wait catches an event that
# lands as a loop is ending, which might be the last to come.
reload_while_modeless() {
  (
    flock -w 1 9 || exit 0
    local pause=3 answer silent=0
    while true; do
      # Every display has a mode (1): done. Hyprland not saying (2) is no
      # answer, and nothing else will ask again; but one that stays silent has
      # gone, and the session, and the reason for this loop, with it.
      answer=0
      nova-hyprland-monitor-modeless || answer=$?
      case $answer in
        1) break ;;
        2) silent=$((silent + 1)) ;;
        *) silent=0 ;;
      esac
      ((silent <= 20)) || break
      # No reload into an update's half-replaced files, which the reload guard
      # holds back: only a reload counts towards the backing off.
      if ((answer == 0)) && ! nova-hyprland-reload-guard paused; then
        hyprctl reload >/dev/null 2>&1 || true
        sleep "$pause"
        pause=$((pause < 30 ? pause * 2 : 60))
      else
        sleep "$pause"
      fi
    done
  ) 9>"$locks/monitor-modeless.lock" &
}

# Nearly always nothing has moved, and even a clamshell pass with nothing to
# do is half a dozen processes. logind says when the lid moves (its LidClosed
# changes, and the system bus carries that to anyone listening), and a pass
# runs then; and after five minutes without a word, for drift the lid does
# not show. A bus that goes away is listened to again after a pause.
watch_lid() {
  local line answer monitor=""
  trap 'kill "$monitor" 2>/dev/null; exit 0' TERM
  while true; do
    while true; do
      monitor=$!
      answer=0
      IFS= read -r -t 300 line || answer=$?
      if ((answer > 128)); then
        clamshell_pass
        continue
      fi
      ((answer == 0)) || break
      [[ $line != *"'LidClosed'"* ]] || clamshell_pass
    done < <(exec gdbus monitor --system --dest org.freedesktop.login1 --object-path /org/freedesktop/login1 2>/dev/null)
    sleep 5
  done
}

# The panel goes off only on a laptop with another display on, so only then is
# there anything for the watch to catch. Hyprland's lid switch binds handle the
# lid itself; the watch catches what they miss, across a sleep and a wake.
lid_watch=""
watch_lid_while_docked() {
  if nova-hw-laptop && nova-hyprland-monitor-external-active; then
    if [[ -z $lid_watch ]] || ! kill -0 "$lid_watch" 2>/dev/null; then
      watch_lid &
      lid_watch=$!
    fi
  else
    stop_lid_watch
  fi
}

stop_lid_watch() {
  if [[ -n $lid_watch ]]; then kill "$lid_watch" 2>/dev/null || true; fi
  lid_watch=""
}

# What a display coming or going sets off, and the start, which may follow
# one this did not see.
displays_changed() {
  after_monitor_change
  watch_lid_while_docked
  reload_while_modeless
}

# Hyprland's events read from a process substitution, not a pipe, so the loop
# runs in this shell and can start and stop the lid's watch, which ends with
# it. A reload while a display is unpowered leaves it at 0x0, with no hotplug
# to tell, as at boot; the loop's own reloads land there too, and change
# nothing while it holds the lock.
trap stop_lid_watch EXIT
displays_changed
while IFS= read -r event; do
  case ${event%%>>*} in
    monitoradded | monitoraddedv2 | monitorremoved | monitorremovedv2) displays_changed ;;
    # A reload may bring other scales (monitors.lua, Settings putting one
    # back).
    configreloaded)
      reload_while_modeless
      nova-hyprland-x11-scale || true
      ;;
  esac
done < <(socat -U - "UNIX-CONNECT:$events")
