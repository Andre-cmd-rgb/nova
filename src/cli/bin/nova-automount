#!/bin/bash

# nova:summary=Mount removable drives as they are plugged in, or hold them
# nova:args=on|off
# nova:hidden=true
#
# Run by the lock screen: on once somebody has unlocked, off while it is
# locked. Mounting a drive has the kernel read whatever file system is on it,
# so a drive plugged into a locked computer waits for an unlock.
#
# nova-sessiond mounts them while $XDG_RUNTIME_DIR/nova/automount holds this
# session's Hyprland instance: on writes it, off removes it. A file an earlier
# session left (one that crashed under the lock) names another instance, and
# counts for nothing. The first on of a session mounts every drive there is;
# after that, only those plugged in since, so a drive unmounted on purpose
# stays so.

set -euo pipefail

usage() {
  echo "Usage: nova-automount on|off" >&2
  exit 2
}

(($# == 1)) || usage
dir=${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set}/nova
switch=$dir/automount

case $1 in
  on)
    session=${HYPRLAND_INSTANCE_SIGNATURE:-}
    if [[ -z $session || $session == */* ]]; then
      echo "nova-automount: not running inside a Hyprland session" >&2
      exit 1
    fi
    (umask 077 && mkdir -p "$dir")
    # Whole or not at all: the daemon reads it as soon as it is there.
    tmp=$(mktemp "$dir/.automount.XXXXXX")
    trap 'rm -f -- "$tmp"' EXIT
    printf '%s\n' "$session" >"$tmp"
    mv -f "$tmp" "$switch"
    ;;
  off)
    rm -f "$switch"
    ;;
  *) usage ;;
esac
