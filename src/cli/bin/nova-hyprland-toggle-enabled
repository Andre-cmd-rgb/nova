#!/bin/bash

# nova:summary=Check if a Hyprland toggle is currently enabled
# nova:args=<flag-name>
# nova:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: nova-hyprland-toggle-enabled <flag-name>" >&2
  exit 2
fi

# On while nova-hyprland-toggle has left its file among the toggles.
[[ -f $HOME/.local/state/nova/toggles/hypr/$1.lua ]]
