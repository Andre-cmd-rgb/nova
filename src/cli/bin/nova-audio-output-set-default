#!/bin/bash

# nova:summary=Make an output the default one, and move what is playing to it
# nova:args=<node-id> <sink-name>

set -euo pipefail

node=${1:-}
sink=${2:-}
if [[ -z $node || -z $sink ]]; then
  echo "Usage: nova-audio-output-set-default <node-id> <sink-name>" >&2
  exit 1
fi

# WirePlumber and PulseAudio each get told; either may be missing, or the
# device already gone, and one of them taking it is enough. Every call has two
# seconds, so that an audio server that hangs does not hang the panel too.
timeout 2 wpctl set-default "$node" 2>/dev/null || true
timeout 2 pactl set-default-sink "$sink" 2>/dev/null || true

# Only the streams of applications move. A filter's own output, a speaker
# tuning's or EasyEffects', is a stream too; moved, it would play into the
# headphones unprocessed, or into its own input.
while read -r stream; do
  timeout 2 pactl move-sink-input "$stream" "$sink" 2>/dev/null || true
done < <(timeout 2 pactl list sink-inputs 2>/dev/null | awk '
  /^Sink Input #/ { stream = substr($3, 2) }
  /application\.name = / && !/application\.name = "EasyEffects"$/ { print stream }')
