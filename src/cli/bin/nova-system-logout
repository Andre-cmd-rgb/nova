#!/bin/bash

# nova:summary=Close every window, then end the session

set -euo pipefail

# The session ends two seconds from now in a process of its own, whatever
# becomes of this one: it may be running in one of the windows closed below.
nohup bash -c "sleep 2 && uwsm stop" >/dev/null 2>&1 &

nova-osd -i logout -m "Logging out" -d 5000 || true
# Asked to close now, apps such as Chrome get a second to save their state.
nova-hyprland-window-close-all || true
sleep 1
