#!/bin/bash

# nova:summary=Log out after closing application windows
# nova:aliases=nova logout

nohup bash -c "sleep 2 && uwsm stop" >/dev/null 2>&1 &

nova-osd -i logout -m "Logging out" -d 5000

# Now close all windows
nova-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
