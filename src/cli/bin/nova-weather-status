#!/bin/bash

# nova:summary=Print the weather: place, temperature and wind

set -euo pipefail

unavailable() {
  echo "Weather unavailable"
  exit 1
}

place=$(nova-weather-location 2>/dev/null || true)
[[ -n $place ]] || unavailable

query=$(jq -rn --arg place "$place" '$place | @uri')
weather=$(curl -fsS --max-time 4 "https://wttr.in/${query}?format=%t|%w" 2>/dev/null || true)
weather=${weather//$'\n'/}
[[ -n $weather ]] || unavailable

IFS='|' read -r temperature wind <<<"$weather"
if [[ $place =~ ^-?[0-9.]+,-?[0-9.]+$ ]]; then place="Here"; else place=${place^}; fi
temperature=${temperature#+}

echo "$place  ·  Temp $temperature  ·  Wind $wind"
