#!/bin/bash

# nova:summary=Set the default editor used by nova-launch-editor
# nova:args=[code|cursor|zed|sublime_text|helix|vim|emacs|nvim]

set -euo pipefail

editor_file="$HOME/.local/state/nova/defaults/editor"

if (($# == 0)); then
  editor=""
  if [[ -f $editor_file ]]; then
    read -r editor <"$editor_file" || editor=""
  fi

  echo "${editor:-nvim}"
  exit 0
fi

case "$1" in
code) editor="code"; name="VSCode"; glyph= ;;
cursor) editor="cursor"; name="Cursor"; glyph= ;;
zed | zeditor) editor="zeditor"; name="Zed"; glyph= ;;
sublime_text) editor="sublime_text"; name="Sublime Text"; glyph= ;;
helix) editor="helix"; name="Helix"; glyph= ;;
vim) editor="vim"; name="Vim"; glyph= ;;
emacs) editor="emacs"; name="Emacs"; glyph= ;;
nvim) editor="nvim"; name="Neovim"; glyph= ;;
*)
  echo "Usage: nova-default-editor <code|cursor|zed|sublime_text|helix|vim|emacs|nvim>" >&2
  exit 1
  ;;
esac

mkdir -p "$(dirname "$editor_file")"
printf '%s\n' "$editor" >"$editor_file"

nova-notification-send -g "$glyph" "$name is now the default editor"
