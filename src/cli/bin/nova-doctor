#!/bin/bash
# nova:summary=Look this computer over for problems, and say how to fix each
# nova:args=[--json | --bundle [path]]
#
# Read-only. Run as yourself it checks the system and your session; under sudo
# it checks the system and the boot menu's fallback entry, which lives on the
# EFI partition only root can read. Either way it looks this computer's parts
# over, on any model: Secure Boot, the graphics cards' drivers, Wi-Fi, sound,
# the camera, missing firmware, sleep, and what games and apps need of the
# system. Exits 1 when something is wrong; warnings alone exit 0.
#
# --bundle writes one .tar.gz to attach to a bug report, with this check and
# what a bug needs besides (the journal, crashes, snapshots, versions, the
# hardware), and nothing that says whose computer it is (bundle, below). It
# goes into the downloads folder, or the folder or file given, and prints its
# path, then a line of what is in it.
#
# NOVA_* variables point the checks at test fixtures (tests/unit/cli/doctor.bats).

set -euo pipefail

json=false bundle=false bundle_to=''
case $#:${1:-} in
  0:) ;;
  1:--json) json=true ;;
  1:--bundle) bundle=true ;;
  2:--bundle) bundle=true bundle_to=$2 ;;
  *) echo 'Usage: nova doctor [--json | --bundle [path]]' >&2; exit 2 ;;
esac
reports=()

# A service (or pkexec) runs it without HOME.
: "${HOME:=$(getent passwd "$EUID" | cut -d: -f6)}"

SYSFS_BTRFS=${NOVA_SYSFS_BTRFS:-/sys/fs/btrfs}
PAM_DIR=${NOVA_PAM_DIR:-/etc/pam.d}
MODULES_DIR=${NOVA_MODULES_DIR:-/usr/lib/modules}
SNAPPER_CONFIG=${NOVA_SNAPPER_CONFIG:-/etc/snapper/configs/root}
ESP=${NOVA_BOOT_ESP:-/boot}
HARDWARE=${NOVA_HARDWARE:-/usr/share/nova/hardware}
PATCH_STATUS=${NOVA_PATCH_STATUS:-/var/lib/nova/patches}
RAM_TEST=${NOVA_RAM_TEST:-/etc/limine-entry-tool.d/85-nova-patch-ram-test.conf}
SYS=${NOVA_SYS:-/sys}
PROC=${NOVA_PROC:-/proc}
PORTABLE_MARKER=${NOVA_PORTABLE_MARKER:-/etc/nova/portable}
NTSYNC=${NOVA_NTSYNC:-/dev/ntsync}
KEYRINGS=${XDG_DATA_HOME:-$HOME/.local/share}/keyrings
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/nova

declare -A color=([ok]='' [warn]='' [FAIL]='' [--]='')
reset=''
if [[ -t 1 ]]; then
  color=([ok]=$'\e[32m' [warn]=$'\e[33m' [FAIL]=$'\e[31m' [--]=$'\e[2m')
  reset=$'\e[0m'
fi

failed=0
report() { # ok|warn|FAIL|-- what [how...]
  local level=$1 what=$2 how
  if $json; then
    reports+=("$(jq -cn --arg level "$level" --arg what "$what" --args \
      '{level: $level, what: $what, how: $ARGS.positional}' -- "${@:3}")")
  else
    printf '%s%-4s%s  %s\n' "${color[$level]}" "$level" "$reset" "$what"
    for how in "${@:3}"; do printf '      %s\n' "$how"; done
  fi
  [[ $level != FAIL ]] || failed=1
}

check_root_filesystem() {
  local fstype options uuid file name value counted=0 errors='' total=0
  # Each read a check depends on says when it fails: a check runs with errexit
  # off (checked), and would go on to judge an empty value.
  if ! read -r fstype options uuid < <(findmnt -rno FSTYPE,OPTIONS,UUID / 2>/dev/null) || [[ -z $fstype ]]; then
    report warn "could not read how / is mounted" "findmnt / says why."
    return 0
  fi
  if [[ ,$options, == *,ro,* ]]; then
    report FAIL "/ is read-only: the filesystem stopped writing after an error" \
      "journalctl -k -b says why. Back up what you can, then check it from the installer stick."
    return
  fi
  if [[ $fstype != btrfs ]]; then
    report ok "/ is writable ($fstype)"
    return
  fi
  # The kernel's per-device counters, kept on the disk across boots.
  for file in "$SYSFS_BTRFS/$uuid"/devinfo/*/error_stats; do
    [[ -r $file ]] || continue
    counted=1
    while read -r name value; do
      ((value > 0)) || continue
      total=$((total + value))
      errors+="${errors:+, }$name $value"
    done <"$file"
  done
  if ((total > 0)); then
    report FAIL "btrfs on / has recorded errors: $errors" \
      "Back up now. sudo btrfs scrub start -B / finds what is damaged;" \
      "once it is dealt with, sudo btrfs device stats -z / clears the count."
  elif ((counted)); then
    report ok "/ is writable btrfs, with no device errors"
  else
    report ok "/ is writable btrfs"
  fi
}

check_disk_space() {
  local used mounted
  used=$(df -P / 2>/dev/null | awk 'NR == 2 { sub("%", "", $5); print $5 + 0 }') || true
  if [[ -z $used ]]; then
    report warn "could not read how full / is" "df / says why."
    return 0
  fi
  if ((used >= 95)); then
    report FAIL "/ is ${used}% full" "Old snapshots keep deleted files: snapper list, then sudo snapper delete <number>."
  elif ((used >= 90)); then
    report warn "/ is ${used}% full" "Old snapshots keep deleted files: snapper list, then sudo snapper delete <number>."
  else
    report ok "/ is ${used}% full"
  fi

  # The boot partition, 2 GiB, where each update writes its kernels' images
  # again, beside the old ones (nova-update-apply's check_space). The fallback
  # image alone is about 220 MB: from 80% full the next update may not find
  # room for them all, and from 90% (205 MiB free) not for that one. The
  # images are root's to read, so here it is the share full that counts.
  read -r used mounted < <(df -P -- "$ESP" 2>/dev/null | awk 'NR == 2 { sub("%", "", $5); print $5 + 0, $6 }') || return 0
  [[ -n $mounted && $mounted != / ]] || return 0
  if ((used >= 90)); then
    report FAIL "the boot partition is ${used}% full, too full for an update's boot images" \
      "Each snapshot in the boot menu keeps images there: snapper list, then sudo snapper delete <number> takes an old one's away."
  elif ((used >= 80)); then
    report warn "the boot partition is ${used}% full: an update's boot images may not fit" \
      "Each snapshot in the boot menu keeps images there: snapper list, then sudo snapper delete <number> takes an old one's away."
  else
    report ok "the boot partition is ${used}% full"
  fi
}

check_package() {
  local version checked missing unreadable
  if ! version=$(pacman -Q nova 2>/dev/null); then
    report warn "nova is not installed as a package"
    return
  fi
  checked=$(LC_ALL=C pacman -Qk nova 2>&1 || true)
  missing=$(sed -nE 's/.* ([0-9]+) missing files?$/\1/p' <<<"$checked")
  # Run as a user, pacman cannot look into root-only directories
  # (/etc/sudoers.d) and counts each file in them as missing.
  unreadable=$(grep -c ' (Permission denied)$' <<<"$checked" || true)
  missing=$((${missing:-0} - unreadable))
  if ((missing > 0)); then
    report FAIL "$missing of nova's files are missing" "sudo pacman -S nova puts them back."
  else
    report ok "$version, every file in place"
  fi
}

check_kernel() {
  local running
  running=$(uname -r) || true
  if [[ -z $running ]]; then
    report warn "could not read which kernel is running" "uname -r says why."
    return 0
  fi
  if [[ -d $MODULES_DIR/$running ]]; then
    report ok "the running kernel is the installed one ($running)"
  else
    report warn "the kernel was updated since this boot" \
      "Restart to use it; until then, a device plugged in now may not work."
  fi
}

check_lock() {
  if [[ -f $PAM_DIR/nova-lock-password ]]; then
    report ok "the lock screen has its PAM service"
  else
    report FAIL "the lock screen has no PAM service, so it cannot lock" "sudo pacman -S nova puts it back."
  fi
}

check_snapshots() {
  local unit off=()
  [[ -f $SNAPPER_CONFIG ]] || {
    report warn "snapshots are not set up: there is no $SNAPPER_CONFIG"
    return
  }
  for unit in snapper-cleanup.timer limine-snapper-sync.service; do
    systemctl is-enabled --quiet "$unit" 2>/dev/null || off+=("$unit")
  done
  if ((${#off[@]} > 0)); then
    report warn "snapshots are not looked after: ${off[*]} not enabled" "sudo systemctl enable --now ${off[*]}"
  else
    report ok "snapshots are taken, pruned and offered in the boot menu"
  fi
}

check_clock() {
  if [[ $(timedatectl show -p NTPSynchronized --value 2>/dev/null) == yes ]]; then
    report ok "the clock is synchronised"
  else
    report warn "the clock is not synchronised" "It needs the network; systemctl status systemd-timesyncd says more."
  fi
}

failed_units() { # [--user]
  { systemctl "$@" --failed --plain --no-legend --no-pager 2>/dev/null || true; } | awk '{ print $1 }' | paste -sd' ' -
}

check_services() {
  local system
  system=$(failed_units)
  if [[ -n $system ]]; then
    report warn "failed system services: $system" "systemctl status <name> says why."
  else
    report ok "no failed system services"
  fi
}

check_session() {
  local user file name plaintext=() lines
  user=$(failed_units --user)
  if [[ -n $user ]]; then
    report warn "failed services of yours: $user" "systemctl --user status <name> says why."
  else
    report ok "no failed services of yours"
  fi

  if [[ -n ${WAYLAND_DISPLAY:-} ]]; then
    if nova-shell shell ping >/dev/null 2>&1; then
      report ok "the shell is running"
    else
      report warn "the shell is not running" "nova restart shell starts it."
    fi
  fi

  # Hyprland reports a config error as a red banner; a clean config reports one
  # empty string.
  if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
    local errors
    if errors=$(hyprctl configerrors -j 2>/dev/null | jq -r '.[] | select(. != "")' 2>/dev/null); then
      if [[ -z $errors ]]; then
        report ok "Hyprland's config has no errors"
      else
        mapfile -t lines <<<"$errors"
        report warn "Hyprland's config has errors, in ~/.config/hypr:" "${lines[@]}"
      fi
    fi
  fi

  # gnome-keyring writes a keyring without a password as plain text.
  for file in "$KEYRINGS"/*.keyring; do
    [[ -f $file && $(head -c 9 -- "$file") == '[keyring]' ]] || continue
    name=${file##*/}
    plaintext+=("${name%.keyring}")
  done
  if ((${#plaintext[@]} == 0)); then
    report ok "no secrets stored unencrypted"
  elif [[ -f $STATE/keyring-migrate-pending ]]; then
    report -- "the passwordless keyring moves into your login keyring at the next unlock"
  else
    report warn "secrets stored unencrypted, in the keyring ${plaintext[*]}" \
      "To move them into your login keyring:" \
      "echo ${plaintext[0]} >$STATE/keyring-migrate-pending && /usr/lib/nova/bin/nova-keyring-migrate"
  fi
}

check_boot_fallback() {
  local out lines
  if out=$(nova-boot-check status 2>&1); then
    report ok "the boot menu has its fallback entry"
    return
  fi
  # Below its heading line, nova-boot-check lists what is missing. A single
  # line is an error of its own (it could not run), so show that instead.
  if [[ $out == *$'\n'* ]]; then
    mapfile -t lines < <(tail -n +2 <<<"$out")
  else
    lines=("$out")
  fi
  report FAIL "the boot menu's fallback is incomplete" "${lines[@]}"
}

check_undervolt() {
  local undervolt state offset reason
  undervolt=$(nova-power-undervolt status --json 2>/dev/null) || return 0
  # A unit separator, not a tab: bash runs empty tab fields together.
  IFS=$'\x1f' read -r state offset reason < <(jq -r '[.state,
    (if .core == null then "" elif .core == .cache then "\(.core) mV" else "\(.core) mV on the core and \(.cache) mV on the cache" end),
    (.reason // "")] | join("\u001f")' <<<"$undervolt" 2>/dev/null) || true
  case $state in
    applied) report ok "the CPU is undervolted by $offset" ;;
    held)
      report warn "the CPU's undervolt is held: $reason" \
        "nova power undervolt on applies it again; nova power undervolt set <mV> sets a smaller one"
      ;;
    pending) report warn "an undervolt of $offset is set but not on the CPU" "systemctl status nova-undervolt says why" ;;
  esac
}

profile=''
check_hardware() {
  local list name missing
  local -a wanted=()
  if ! profile=$(nova-hw-detect 2>/dev/null); then
    profile=''
    report -- "no hardware profile for this model: the generic setup"
    return 0
  fi
  report -- "hardware profile: $profile"

  # What the profile adds (firmware, a driver, the speaker tuning's plugins)
  # comes with nova update, so one missing is an update yet to run, or one
  # that could not install it.
  list=$HARDWARE/$profile/packages
  [[ -r $list ]] || return 0
  while IFS= read -r name; do
    name=${name%%#*}
    name=${name//[[:space:]]/}
    [[ -n $name ]] || continue
    # nvidia-open-nova is built for linux-nova; another kernel has Arch's.
    if [[ $name == nvidia-open-nova ]] && ! pacman -T linux-nova >/dev/null 2>&1; then name=nvidia-open; fi
    wanted+=("$name")
  done <"$list"
  ((${#wanted[@]})) || return 0
  missing=$(pacman -T "${wanted[@]}" 2>/dev/null || true)
  if [[ -n $missing ]]; then
    report warn "packages this computer needs are not installed: ${missing//$'\n'/ }" "nova update installs them."
  else
    report ok "this computer's packages are installed"
  fi
}

# --------------------------------------------------------- any computer's parts
#
# What any computer can be looked over for, read from sysfs as the user can
# (never lspci, which wakes a sleeping GPU), each silent where it does not
# apply: a desktop has no lid, a virtual machine no firmware to load.

# Secure Boot on: Limine and the kernels are not signed for it. A computer that
# started Nova with it on is letting them through, for now.
check_secure_boot() {
  local value
  value=$(od -An -tu1 -j4 -N1 -- "$SYS/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c" 2>/dev/null) || return 0
  [[ ${value//[[:space:]]/} == 1 ]] || return 0
  report warn "Secure Boot is on, and Nova's boot loader is not signed for it" \
    "This start got past it; the firmware may refuse the boot loader after an update." \
    "Turn Secure Boot off in the firmware settings (the setup key as the computer starts)."
}

vendor_name() { # PCI vendor id
  case $1 in
    0x8086) echo Intel ;;
    0x1002) echo AMD ;;
    0x10de) echo NVIDIA ;;
    *) echo "${1#0x}" ;;
  esac
}

driver_of() { # PCI device directory
  local link
  link=$(readlink -- "$1/driver" 2>/dev/null) || return 0
  echo "${link##*/}"
}

# The package of NVIDIA's open modules for the running kernel.
nvidia_modules() {
  case $(uname -r) in
    *-nova*) echo nvidia-open-nova ;;
    *-lts*) echo nvidia-open-lts ;;
    *) echo nvidia-open ;;
  esac
}

# Each graphics card and the driver it is on. NVIDIA's own drives cards from
# Turing (device 0x1e00) on, as the installer and data/hypr/gpu.lua split them;
# an older one runs on nouveau. The card the firmware drew its boot screen on
# drives the display, NVIDIA's when none says so, as gpu.lua takes it.
check_graphics() {
  local dev vendor driver nvidia_dev='' nvidia_id=0 nvidia_boots=0 other_boots=0 igpu=0 status connected setting
  local -a cards=() unbound=()
  for dev in "$SYS"/bus/pci/devices/*; do
    [[ -r $dev/class && $(<"$dev/class") == 0x03* ]] || continue
    # A card taken off the bus between the reads is not judged on empty values.
    [[ -r $dev/vendor && -r $dev/device ]] || continue
    vendor=$(<"$dev/vendor")
    driver=$(driver_of "$dev")
    cards+=("$(vendor_name "$vendor") (${driver:-no driver})")
    [[ -n $driver ]] || unbound+=("$dev")
    if [[ $vendor == 0x10de ]]; then
      nvidia_dev=$dev nvidia_id=$(($(<"$dev/device")))
      [[ $(cat "$dev/boot_vga" 2>/dev/null) != 1 ]] || nvidia_boots=1
    else
      [[ $vendor != 0x8086 && $vendor != 0x1002 ]] || igpu=1
      [[ $(cat "$dev/boot_vga" 2>/dev/null) != 1 ]] || other_boots=1
    fi
  done
  ((${#cards[@]})) || return 0
  report -- "graphics: $(printf '%s\n' "${cards[@]}" | paste -sd, - | sed 's/,/, /g')"
  for dev in "${unbound[@]}"; do
    if [[ $dev == "$nvidia_dev" ]] && ((nvidia_id >= 0x1e00)); then
      report warn "the NVIDIA graphics card has no driver" \
        "NVIDIA's driver for it: sudo pacman -S --needed $(nvidia_modules) nvidia-utils, then restart"
    else
      report warn "the $(vendor_name "$(<"$dev/vendor")") graphics card has no driver" "journalctl -k -b says why"
    fi
  done
  [[ -n $nvidia_dev ]] || return 0
  driver=$(driver_of "$nvidia_dev")

  if [[ $driver == nouveau ]] && ((nvidia_id < 0x1e00)); then
    report -- "the NVIDIA card predates NVIDIA's own driver (GTX 16 and RTX 20 on), so it runs on nouveau: fine for the desktop, slow for games"
  fi
  [[ $driver == nvidia ]] || return 0

  # Driving the display, NVIDIA decodes the video (data/hypr/env.lua).
  if ((nvidia_id >= 0x1e00 && (nvidia_boots || !other_boots))) &&
    [[ -n $(pacman -T libva-nvidia-driver 2>/dev/null || true) ]]; then
    report warn "video is decoded by the CPU: NVIDIA drives the display, and its VA-API driver is not installed" \
      "sudo pacman -S libva-nvidia-driver"
  fi

  # A laptop with an iGPU beside it: the NVIDIA card should sleep while nothing
  # uses it. The P1 Gen 4i's power governor takes it off the bus instead.
  ((igpu)) && [[ $profile != thinkpad-p1-gen4i ]] && nova-hw-laptop 2>/dev/null || return 0
  status=$(cat "$nvidia_dev/power/runtime_status" 2>/dev/null || echo unknown)
  if [[ $status == suspended ]]; then
    report ok "the NVIDIA card sleeps while nothing uses it"
    return 0
  fi
  connected=0
  for status in "$nvidia_dev"/drm/card*/card*-*/status; do
    [[ -r $status && $(<"$status") == connected ]] && connected=1
  done
  ((!connected)) || return 0
  # NVIDIA lets a laptop's card sleep by itself from Ampere (device 0x2200) on;
  # a Turing one sleeps only when its driver is asked to, which neither NVIDIA
  # nor Nova does unasked (data/hardware/udev/80-nova-nvidia-sleep.rules).
  # Read from the module's parameters: asking the card itself would wake it.
  setting=$(cat "$SYS/module/nvidia/parameters/NVreg_DynamicPowerManagement" 2>/dev/null || true)
  if ((nvidia_id < 0x2200)) && [[ $setting == 3 || $setting == 0 ]]; then
    report -- "the NVIDIA card stays awake while nothing uses it, which costs battery unplugged: a GTX 16 or RTX 20 sleeps only when its driver is asked to" \
      "To ask it: echo 'options nvidia NVreg_DynamicPowerManagement=0x02' | sudo tee /etc/modprobe.d/nova-nvidia-sleep.conf, then restart." \
      "If the card then misbehaves, delete that file and restart."
  else
    report -- "the NVIDIA card is awake with no display on it, which costs battery unplugged: a program is using it" \
      "sudo fuser -v /dev/nvidia* names the programs"
  fi
}

# Wi-Fi or sound hardware with no Wi-Fi device or sound card at all: its driver
# or its firmware did not load. Said only then, so a card that only looks like
# one of these never raises it on a computer that works. And a cellular modem
# with no ModemManager running, without which mobile data cannot work.
check_devices() {
  local dev class wifi='' audio=0 modem=0
  for dev in "$SYS"/bus/pci/devices/*; do
    [[ -r $dev/class ]] || continue
    class=$(<"$dev/class")
    case $class in
      0x0280*) wifi+="${wifi:+, }$(vendor_name "$(<"$dev/vendor")") $(<"$dev/device")" ;;
      0x0401* | 0x0403*) audio=1 ;;
      0x0d40*) modem=1 ;;
    esac
  done
  if [[ -n $wifi ]] && ! compgen -G "$SYS/class/ieee80211/*" >/dev/null; then
    report warn "no Wi-Fi: the Wi-Fi card ($wifi) has no driver, or no firmware for it" "journalctl -k -b says which"
  fi
  if ((audio)) && ! compgen -G "$SYS/class/sound/card*" >/dev/null; then
    report warn "no sound card: the sound hardware has no driver, or no firmware for it" "journalctl -k -b says which"
  fi
  if ((modem)) && ! systemctl is-active --quiet ModemManager.service 2>/dev/null; then
    report warn "ModemManager is not running, so mobile data cannot work" "sudo systemctl enable --now ModemManager.service"
  fi
}

# A cellular modem its maker locked (an FCC lock), which cannot be turned on
# until something unlocks it. Nova turns on every unlock ModemManager ships
# (data/network/install.mk); a modem it has none for, or one whose unlock no
# longer works on newer firmware, needs its maker's own tool, which Nova does
# not ship: Lenovo's for the modems in its laptops. Said while ModemManager's
# last try to power it up, this boot, failed as a lock does ("Invalid
# transition"), from its journal: nothing at all when that cannot be read.
check_modem_unlock() {
  local dev id last how
  local mine=${NOVA_FCC_ADMIN:-/etc/ModemManager/fcc-unlock.d} shipped=${NOVA_FCC_PACKAGE:-/usr/lib/ModemManager/fcc-unlock.d}
  local available=${NOVA_FCC_AVAILABLE:-/usr/share/ModemManager/fcc-unlock.available.d}
  for dev in "$SYS"/bus/pci/devices/*; do
    [[ -r $dev/class && $(<"$dev/class") == 0x0d40* ]] || continue
    id=$(<"$dev/vendor"):$(<"$dev/device")
    id=${id//0x/}
    # journalctl -g exits 1 when nothing matches, as on most boots.
    last=$(journalctl -b -u ModemManager.service -q --no-pager -o cat \
      -g "couldn't enable interface: 'Invalid transition'|state changed \(enabling -> enabled\)" 2>/dev/null | tail -n 1) || true
    [[ $last == *"Invalid transition"* ]] || continue
    # The maker's script goes where ModemManager looks first, and pacman
    # keeps nothing: /usr/lib's names are Nova's package's.
    how="its maker's unlock script turns it on, put in $mine/$id"
    [[ $(cat "$SYS/class/dmi/id/sys_vendor" 2>/dev/null) != LENOVO ]] ||
      how="Lenovo's unlock script turns it on, put in $mine/$id: https://github.com/lenovo/lenovo-wwan-unlock"
    if [[ ! -e $mine/$id && ! -e $shipped/$id && -e $available/$id ]]; then
      report warn "the cellular modem ($id) is locked by its maker, and ModemManager's unlock for it is not turned on" \
        "sudo ln -s $available/$id $mine/"
    elif [[ -e $mine/$id || -e $shipped/$id ]]; then
      report warn "the cellular modem ($id) is locked by its maker, and ModemManager's unlock for it did not work" "$how"
    else
      report warn "the cellular modem ($id) is locked by its maker, and ModemManager has no unlock for it" "$how"
    fi
  done
}

# An Intel MIPI camera: an IPU6 or IPU7, by the device ids the kernel's
# intel-ipu6 and intel-ipu7 drivers take (nova-install has the same list).
# Apps reach it through PipeWire's libcamera plugin.
IPU_IDS=" 0x9a19 0x4e19 0x465d 0x462e 0xa75d 0x7d19 0x645d 0xb05d "
check_camera() {
  local dev ipu='' missing
  for dev in "$SYS"/bus/pci/devices/*; do
    [[ -r $dev/vendor && $(<"$dev/vendor") == 0x8086 && $IPU_IDS == *" $(<"$dev/device") "* ]] && ipu=$dev
  done
  [[ -n $ipu ]] || return 0
  if [[ -z $(find "$ipu/" -maxdepth 4 -path '*/video4linux/video*' -print -quit 2>/dev/null) ]]; then
    report warn "the camera (Intel IPU) has no video device: its driver or firmware did not load" \
      "journalctl -k -b | grep -i ipu says why"
    return 0
  fi
  missing=$(pacman -T libcamera libcamera-ipa pipewire-libcamera 2>/dev/null || true)
  if [[ -n $missing ]]; then
    report warn "apps cannot see the camera: it needs libcamera, which is not installed" \
      "sudo pacman -S libcamera libcamera-ipa pipewire-libcamera"
  fi
}

# Firmware the kernel asked for this boot and did not find. iwlwifi asks for
# the newest it knows first, down to the one installed, so its misses are left
# out: a Wi-Fi card left with none has no Wi-Fi device, which check_devices
# says.
check_firmware() {
  local log files
  log=$(journalctl -k -b -q -o cat --no-pager 2>/dev/null || true)
  # Outside the wheel and adm groups, none of the kernel's messages show.
  [[ -n $log ]] || return 0
  files=$(sed -nE 's/.*Direct firmware load for ([^ ]+) failed.*/\1/p; s/.*firmware: failed to load ([^ ]+).*/\1/p' <<<"$log" |
    { grep -vE '(^|/)iwlwifi-' || true; } | sort -u | paste -sd, - | sed 's/,/, /g')
  [[ -n $files ]] || return 0
  report warn "the kernel asked for firmware that is not here: $files" \
    "A device may not work fully without it. Some drivers ask for several versions and take the one there is."
}

# How this computer sleeps: the suspend the kernel uses, of those the firmware
# offers, and hibernation. The lid, the suspend key and the menu's Suspend
# hibernate after a while asleep; a computer that cannot only suspends, which
# empties a battery in a few days.
check_sleep() {
  local offered chosen how lockdown swap=0 memory=0 reasons=()
  [[ -r $SYS/power/mem_sleep ]] || return 0
  offered=$(<"$SYS/power/mem_sleep")
  chosen=$(sed -nE 's/.*\[([^]]+)\].*/\1/p' <<<"$offered")
  offered=$(tr -d '[]' <<<"$offered")
  how=${chosen:-$offered}
  [[ $offered == "$how" ]] || how+=" (of ${offered// /, })"
  if [[ -e $PORTABLE_MARKER ]]; then
    report -- "sleep: $how; a portable Nova never hibernates"
    return 0
  fi
  if nova-hibernation-available 2>/dev/null; then
    report -- "sleep: $how, and hibernation"
    return 0
  fi

  [[ " $(cat "$SYS/power/state" 2>/dev/null) " == *" disk "* ]] || reasons+=("The kernel offers no hibernation.")
  lockdown=$(sed -nE 's/.*\[([^]]+)\].*/\1/p' "$SYS/kernel/security/lockdown" 2>/dev/null || true)
  [[ -z $lockdown || $lockdown == none ]] || reasons+=("The kernel is locked down ($lockdown, with Secure Boot), which turns hibernation off.")
  # zram is memory itself: an image has to go to a disk.
  swap=$(awk 'NR > 1 && $1 !~ /zram/ { kb += $3 } END { print kb + 0 }' "$PROC/swaps" 2>/dev/null || echo 0)
  memory=$(awk '/^MemTotal:/ { print $2; exit }' "$PROC/meminfo" 2>/dev/null || echo 0)
  if ((swap == 0)); then
    reasons+=("There is no swap on a disk to keep the memory in.")
  elif ((swap < memory)); then
    reasons+=("The swap ($(((swap + 524288) / 1048576)) GiB) is smaller than the memory ($(((memory + 524288) / 1048576)) GiB).")
  fi
  [[ " $(cat "$PROC/cmdline" 2>/dev/null) " == *" resume="* ]] || reasons+=("The boot line has no resume=, so a hibernated image may not be found.")
  ((${#reasons[@]})) || reasons=("systemctl hibernate says why.")
  if nova-hw-laptop 2>/dev/null; then
    report warn "this computer cannot hibernate, so a closed lid only suspends, which empties the battery in a few days" "${reasons[@]}"
  else
    report -- "sleep: $how; no hibernation" "${reasons[@]}"
  fi
}

# This computer's patches (nova patch), as nova-patch-apply last left them.
check_patches() {
  local name state reason
  local -a on=() other=()
  if [[ -r $PATCH_STATUS ]]; then
    while IFS=$'\t' read -r name state reason; do
      case $state in
        on) on+=("$name") ;;
        other) other+=("$name") ;;
        bad) report warn "patch $name is off: $reason" "nova patch show $name shows it; nova patch remove $name takes it out" ;;
      esac
    done <"$PATCH_STATUS"
  fi
  ((${#on[@]} == 0)) || report -- "this computer's patches: ${on[*]}"
  ((${#other[@]} == 0)) || report -- "patches made for another computer, so off here: ${other[*]}"
  [[ ! -e $RAM_TEST ]] || report -- "the memory test runs at the next start (nova patch ram test)"
}

# ------------------------------------------------------------------ games & apps
#
# What games and apps need of the system beside themselves: Arch's 32-bit
# repository, this computer's own 32-bit graphics drivers once anything 32-bit
# is installed (Steam, Wine) and no NVIDIA driver without NVIDIA's kernel
# module to run it (nova-hw-packages, as nova update reads them, a portable
# Nova's too), Flatpak's runtime for the NVIDIA driver installed
# (nova-flatpak-gl), ntsync for Wine and Proton, and Steam's rules for game
# controllers. nova update repairs the packages and the runtime.
check_games() {
  local problems=0 lib32=0 multilib=1 missing stray flatpak line
  local -a hw=()
  [[ ! -e $PORTABLE_MARKER ]] || hw=(--portable)
  if ! pacman-conf --repo-list 2>/dev/null | grep -qx multilib; then
    multilib=0
    report warn "Arch's 32-bit repository (multilib) is off: Steam and 32-bit games cannot be installed" \
      "Add [multilib] with Include = /etc/pacman.d/nova-mirrorlist to /etc/pacman.conf, as Nova installs it."
    problems=1
  fi
  if pacman -Qq 2>/dev/null | grep -q '^lib32-'; then lib32=1; fi
  if ((lib32)); then
    missing=$(nova-hw-packages "${hw[@]}" --lib32 2>/dev/null | xargs -r pacman -T 2>/dev/null | paste -sd' ' || true)
    if [[ -n $missing ]]; then
      report warn "32-bit games lack this computer's graphics drivers: $missing" "nova update installs them."
      problems=1
    fi
  fi
  # NVIDIA's userspace with no NVIDIA kernel module to run it: what pacman
  # picks for "a Vulkan driver" left alone. The same list nova update takes
  # out.
  stray=$(nova-hw-packages "${hw[@]}" --stray 2>/dev/null | paste -sd' ' || true)
  if [[ -n $stray ]]; then
    report warn "NVIDIA's driver is installed without NVIDIA's kernel module to run it: $stray" \
      "It keeps the open driver for NVIDIA cards (nouveau) from loading and puts NVIDIA first for every app. nova update takes it out."
    problems=1
  fi
  flatpak=$(nova-flatpak-gl check 2>/dev/null || true)
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    report warn "${line^}: Flatpak apps cannot use the NVIDIA card" \
      "nova update fetches it, or now: /usr/lib/nova/bin/nova-flatpak-gl sync"
    problems=1
  done <<<"$flatpak"
  if [[ ! -e $NTSYNC ]]; then
    report warn "ntsync is not loaded: Windows games under Wine and Proton run slower" \
      "It loads at the next start; now: sudo modprobe ntsync"
    problems=1
  elif [[ ! -r $NTSYNC || ! -w $NTSYNC ]]; then
    report warn "/dev/ntsync is not open to you: Wine and Proton cannot use it" "ls -l /dev/ntsync says who may."
    problems=1
  fi
  if ! pacman -Q steam-devices >/dev/null 2>&1; then
    if ((multilib)); then
      report warn "game controllers' rules (steam-devices) are not installed: a controller may not work in games" "nova update installs them."
    else
      report warn "game controllers' rules (steam-devices) are not installed: a controller may not work in games" \
        "They come from the 32-bit repository: with it on (above), nova update installs them."
    fi
    problems=1
  fi
  ((problems)) || report ok "games and apps: 32-bit repository, graphics drivers, ntsync and controllers in place"
}

# ---------------------------------------------------------------------- --bundle
#
# A report for a bug: what a bug needs, and nothing that says whose computer it
# is. Never read: Wi-Fi passwords and NetworkManager's connection files, the
# firmware's serial numbers and UUID (product_serial, board_serial,
# product_uuid), a USB device's serial, AirDrop's folder but for the numbers
# to mask. Masked in what is read: MAC and IP addresses (a MAC also as BlueZ
# writes it, and in a USB network device's name), UUIDs and 32-digit ids (the
# machine's, a boot's), serial numbers the kernel logs and the modem's IMEI
# and SIM's, phone numbers, Wi-Fi networks' names, the account's name, its
# owner's and the computer's, the name AirDrop gives senders, the home's path
# (~), and in the journal the numbers AirDrop knows your iPhone by. The
# journal's lines go without the computer's name as well. Kernel versions,
# device ids such as 8086:a0f0 and times stay as they are: a report is no use
# without them.

# The account the report is for: under sudo, the one who asked for it.
report_home() {
  if ((EUID == 0)) && [[ -n ${SUDO_USER:-} ]]; then
    getent passwd "$SUDO_USER" | cut -d: -f6
  else
    echo "$HOME"
  fi
}

# The downloads folder as user-dirs.dirs names it, else Downloads, else the home.
downloads() { # home
  local dir
  dir=$(sed -n -E 's/^XDG_DOWNLOAD_DIR="?([^"]*)"?$/\1/p' "${XDG_CONFIG_HOME:-$1/.config}/user-dirs.dirs" 2>/dev/null | tail -n 1) || true
  case $dir in
    '$HOME/'?*) dir=$1/${dir#\$HOME/} ;;
    /*) ;;
    *) dir=$1/Downloads ;;
  esac
  [[ -d $dir ]] || dir=$1
  echo "$dir"
}

# A boot's journal: warnings and worse from everything (warnings), or every
# line of Nova's own, the shell's and the kernel's (nova). The newest 200,000
# lines: one service in a loop (ModemManager wrote 216,000 warnings in one
# day here) makes a file nobody reads.
journal() { # boot (0, -1) warnings|nova
  if [[ $2 == warnings ]]; then
    journalctl -b "$1" -p warning -n 200000 --no-pager --no-hostname -o short-iso 2>&1 || true
    return
  fi
  { journalctl -b "$1" --no-pager --no-hostname -o short-iso 2>&1 || true; } |
    awk '/^[^ ]/ { keep = $2 ~ /^(kernel|quickshell|qs|nova-[^[]*)(\[[0-9]+\])?:$/ || $3 ~ /^nova-[^ ]*\.(service|timer|path|target|socket):$/ }
      keep' | tail -n 200000
}

# The versions of Nova's packages, the kernels, the drivers, Hyprland and the shell.
packages() {
  local -a names=()
  mapfile -t names < <(pacman -Qq 2>/dev/null | grep -xE 'nova(-.+)?|linux(-.+)?|nvidia(-.+)?|limine(-.+)?|mesa|hyprland|quickshell|whisper-cpp' || true)
  ((${#names[@]})) || { echo "pacman lists none of them"; return 0; }
  pacman -Q "${names[@]}" 2>&1 || true
}

# The boot menu's entries, by name: never their command lines.
boot_entries() {
  if [[ -r $ESP/limine.conf ]]; then
    grep -E '^[[:space:]]*/' "$ESP/limine.conf" | sed 's/^[[:space:]]*//' || true
  else
    echo "Only root can read the boot menu: sudo nova doctor --bundle adds it."
  fi
}

model() {
  local field
  for field in sys_vendor product_name product_version bios_version; do
    printf '%-16s %s\n' "$field" "$(cat -- "$SYS/class/dmi/id/$field" 2>/dev/null)"
  done
}

# lsusb's list, or the same read from sysfs where usbutils is not installed.
usb_devices() {
  local dev
  if command -v lsusb >/dev/null 2>&1; then
    lsusb 2>&1 || true
    return
  fi
  for dev in "$SYS"/bus/usb/devices/*; do
    [[ -r $dev/idVendor ]] || continue
    printf '%s ID %s:%s %s %s\n' "${dev##*/}" "$(<"$dev/idVendor")" "$(<"$dev/idProduct")" \
      "$(cat -- "$dev/manufacturer" 2>/dev/null)" "$(cat -- "$dev/product" 2>/dev/null)"
  done
}

# The PCI devices as the kernel keeps them, never lspci: lspci reads each
# device's configuration, which wakes a graphics card left asleep, where
# these few attributes are kept in memory.
pci_devices() {
  local dev driver
  for dev in "$SYS"/bus/pci/devices/*; do
    [[ -r $dev/vendor ]] || continue
    driver=$(readlink -- "$dev/driver" 2>/dev/null) && driver=${driver##*/} || driver=none
    printf '%s class %s id %s:%s driver %s\n' "${dev##*/}" "$(<"$dev/class")" \
      "$(<"$dev/vendor")" "$(<"$dev/device")" "$driver"
  done
}

# A command's output, or that it is not there.
output_of() { # command...
  if command -v "$1" >/dev/null 2>&1; then
    "$@" 2>&1 || true
  else
    echo "$1 is not installed"
  fi
}

# Whatever would say whose computer this is, masked in a file, in place.
mask() { # file [id...]: the ids are AirDrop's numbers for your iPhone
  local file=$1 id name mark rule edge='[^[:alnum:]_-]' octet='(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])' hex='[0-9A-Fa-f]'
  # A MAC with colons, dashes, or underscores as BlueZ and PipeWire write it
  # (dev_A4_83_E7_11_22_33): twice, as a match takes the character between two.
  local mac="s/(^|[^[:alnum:]])($hex{2}[:_-]){5}$hex{2}([^[:alnum:]]|\$)/\\1XX:XX:XX:XX:XX:XX\\3/g"
  local -a script=(
    -e "$mac" -e "$mac"
    -e "s/\\b(enx|wlx|wwx)$hex{12}\\b/\\1XXXXXXXXXXXX/g"
    -e "s/\\b$hex{8}-$hex{4}-$hex{4}-$hex{4}-$hex{12}\\b/<uuid>/g"
    -e "s/\\b$hex{32}\\b/<id>/g"
    -e "s/\\b($hex{1,4}:){7}$hex{1,4}\\b/<ip>/g"
    -e "s/\\b$hex{1,4}(:$hex{1,4})*::($hex{1,4}(:$hex{1,4})*)?/<ip>/g"
    -e "s/\\b($octet\\.){3}$octet\\b/<ip>/g"
    -e "s/((SerialNumber|[Ss]erial[ _-]?[Nn]umber|[Ss]erial|\\bS\\/N)[:=] *)[^ ,;)]+/\\1<serial>/g"
    -e "s/((IMEI|IMSI|ICCID|imei|imsi|iccid|[Ee]quipment [Ii]dentifier)[^0-9]{0,4})[0-9]{6,}/\\1<serial>/g"
    # A phone number written as from abroad (+49 151 …), not a version's +20251111
    # or a time zone's +01:00; and the modem's own numbers, however written.
    -e "s/(^|[^[:alnum:]])\\+[1-9]([ ()-]{0,2}[0-9]){6,14}\\b/\\1<number>/g"
    -e "s/(own numbers?[:=]? *)[0-9][0-9 ()-]{5,}[0-9]/\\1<number>/gI"
    # A network's name in quotes, or after SSID: or ssid=, to the end of the list.
    -e "s/((\\bSSID|\\bssid|connection|access point|network)[:=]? *['\"])[^'\"]*(['\"])/\\1<network>\\3/g"
    -e "s/(\\b(SSID|ssid)[:=] *)[^'\"<[:space:]][^,;)]*/\\1<network>/g"
    -e "s/(this computer is \")[^\"]*(\" to senders)/\\1<name>\\2/g"
  )
  if [[ -n $home && $home != / ]]; then
    script+=(-e "s#$(literal "$home")#~#g")
  fi
  # The account's name, each word of its owner's (as the installer asked for
  # it) and the computer's, whole: a computer called thinkpad-p1 stays in
  # thinkpad-p1-gen4i, the hardware profile's. Not root or nova, which say
  # nothing, nor a name too short to tell from a word. Twice, as with a MAC, for
  # andre:andre.
  local -a names=("user:$user" "computer:$host") words=()
  read -r -a words <<<"$owner" || true
  for name in "${words[@]}"; do names+=("name:$name"); done
  for name in "${names[@]}"; do
    mark=${name%%:*} name=${name#*:}
    ((${#name} >= 3)) && [[ $name != root && $name != nova && $name != localhost ]] || continue
    rule="s/(^|$edge)$(literal "$name")($edge|\$)/\\1<$mark>\\2/gI"
    script+=(-e "$rule" -e "$rule")
  done
  shift
  for id; do
    [[ $id =~ ^[0-9A-Fa-f]+$ ]] && script+=(-e "s/\\b$id\\b/<phone>/gI")
  done
  sed -E -i "${script[@]}" -- "$file"
}

# A string as sed -E reads it literally.
literal() { printf '%s' "$1" | sed -E 's/[][\\/.*^$#|+?(){}]/\\&/g'; }

bundle_work=''
bundle() {
  local stamp name out dir boot file home user owner host
  local -a phones=()
  # mask reads these four.
  home=$(report_home) user=${SUDO_USER:-${USER:-$(id -un)}} host=$(cat -- "$PROC/sys/kernel/hostname" 2>/dev/null || true)
  owner=$(getent passwd "$user" 2>/dev/null | cut -d: -f5 | cut -d, -f1) || true
  stamp=$(date +%Y-%m-%d-%H%M%S)
  name=nova-report-$stamp
  if [[ -z $bundle_to ]]; then
    out=$(downloads "$home")/$name.tar.gz
  elif [[ -d $bundle_to ]]; then
    out=${bundle_to%/}/$name.tar.gz
  else
    out=$bundle_to
  fi
  [[ $out == /* ]] || out=$PWD/$out
  # Readable by its owner alone until it is sent: it is still about them.
  umask 077
  bundle_work=$(mktemp -d)
  trap 'rm -rf -- "$bundle_work"' EXIT
  dir=$bundle_work/$name
  mkdir -- "$dir"

  "${BASH_SOURCE[0]}" >"$dir/doctor.txt" 2>&1 || true
  journal 0 warnings >"$dir/journal-this-start-warnings.txt"
  journal 0 nova >"$dir/journal-this-start-nova.txt"
  journal -1 warnings >"$dir/journal-last-start-warnings.txt"
  journal -1 nova >"$dir/journal-last-start-nova.txt"
  output_of coredumpctl list --no-pager >"$dir/crashes.txt"
  output_of snapper list >"$dir/snapshots.txt"
  packages >"$dir/packages.txt"
  boot_entries >"$dir/boot-entries.txt"
  model >"$dir/model.txt"
  pci_devices >"$dir/pci.txt"
  usb_devices >"$dir/usb.txt"
  # What each process holds of the graphics memory (all of them under sudo).
  output_of nova-doctor-gpu-memory >"$dir/gpu-memory.txt"

  # Four numbers a phone, a phone a line, which nothing else may show of it.
  read -r -d '' -a phones 2>/dev/null <"${XDG_STATE_HOME:-$home/.local/state}/nova/airdrop/phones" || true
  for file in "$dir"/*; do
    if [[ $file == */journal-* ]]; then mask "$file" "${phones[@]}"; else mask "$file"; fi
  done

  # Under sudo the report goes into a folder of whoever asked, so they write
  # it, and root makes nothing there and follows no link left there: tar would
  # write through one at the .part, a name known to the second, to /etc/shadow.
  if ((EUID == 0)) && [[ -n ${SUDO_UID:-} ]]; then
    if ! tar -C "$bundle_work" -czf "$bundle_work/$name.tar.gz" -- "$name" ||
      ! setpriv --reuid="$SUDO_UID" --regid="${SUDO_GID:-$SUDO_UID}" --init-groups \
        bash -c 'umask 077 && cat >"$1.part" && mv -f -- "$1.part" "$1"' bash "$out" <"$bundle_work/$name.tar.gz"; then
      echo "nova doctor: could not write $out" >&2
      return 1
    fi
  else
    tar -C "$bundle_work" -czf "$out.part" -- "$name" || { echo "nova doctor: could not write $out" >&2; return 1; }
    mv -f -- "$out.part" "$out"
  fi

  boot="the boot menu's entries"
  [[ -r $ESP/limine.conf ]] || boot="no boot menu (sudo adds it)"
  echo "$out"
  echo "Inside: this check, the journal of this start and the last (warnings, and all of Nova's, the shell's and the kernel's), crashes, snapshots, package versions, $boot, the model, its PCI and USB devices, and the graphics memory each program holds. Masked: MAC and IP addresses, serial numbers, UUIDs, phone numbers, Wi-Fi names, your name, your account's and the computer's, AirDrop's numbers for your iPhone and your home's path."
}

if $bundle; then
  bundle
  exit
fi

# Each check run as a condition: a command in one that fails (journalctl -g
# or grep finding nothing, under pipefail) then cannot end the script before
# the report is printed, which Settings could not read. The other checks run.
# Inside a check errexit is off, so a read the check judges says itself when
# it fails, rather than leaving an empty value to be called ok.
checked() { "$@" || true; }

checked check_root_filesystem
checked check_disk_space
checked check_package
checked check_kernel
checked check_lock
checked check_snapshots
checked check_clock
checked check_services
if ((EUID == 0)); then
  checked check_boot_fallback
  report -- "your session's checks: run nova doctor without sudo"
else
  checked check_session
  if [[ -r $ESP/limine.conf ]]; then
    checked check_boot_fallback
  else
    report -- "the boot menu's fallback entry: sudo nova doctor checks it"
  fi
fi
checked check_undervolt
checked check_hardware
checked check_secure_boot
checked check_graphics
checked check_devices
checked check_modem_unlock
checked check_camera
checked check_firmware
checked check_sleep
checked check_patches
checked check_games
if $json; then printf '%s\n' "${reports[@]}" | jq -s .; fi
exit "$failed"
