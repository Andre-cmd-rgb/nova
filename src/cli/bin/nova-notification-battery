#!/bin/bash

# nova:summary=Show the battery's charge and time left in a notification

set -euo pipefail

# nova-battery-info's one line, in a quiet notification with the bar's glyph.
# A computer with no battery says so, not an empty line.
line=$(nova-battery-info)
nova-notification-send -g 󰁹 -u low "${line:-No battery}"
