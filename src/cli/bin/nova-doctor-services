#!/bin/bash
# nova:hidden=true
# nova:summary=Say in a notification when one of Nova's services has failed
#
# nova doctor lists the services that failed when it is asked; this says so
# unasked. nova-doctor-services.timer runs it a minute after login, which is
# when what failed as the computer started shows, and every ten minutes after,
# for what fails later. Each unit is said once a boot: not at every run, nor
# at the next login. A unit that tries again by itself and fails each time
# (the GPU's retry, every two minutes) is one failure, not one a run; once it
# has been seen running, or stopped after a run that went well, a failure
# after is new, and is said again.
#
# What it looks at: Nova's own units, the system's and this user's, in the
# failed state, and limine-snapper-sync, which puts Nova's snapshots in the boot
# menu (its own notifier, which followed the whole system log all day for it,
# is not started on Nova: data/systemd/install.mk). A unit stopped, disabled or masked is not failed, so a service
# turned off on purpose is never said. Nor are the units a command starts for a
# moment (transient ones: an update, Caffeine's hold on the lid), nor AirDrop's
# receiver, which the person who just turned AirDrop on hears about from
# AirDrop itself: each of those says how it went.
#
# NOVA_BOOT_ID stands in for the kernel's boot id in the tests.
set -euo pipefail

TOLD=${XDG_STATE_HOME:-$HOME/.local/state}/nova/services-told
BOOT_ID=${NOVA_BOOT_ID:-/proc/sys/kernel/random/boot_id}

# What a unit does, in words that "stopped" can follow.
name_of() { # unit
  case $1 in
    nova-powerd.service) echo "Nova's power manager" ;;
    nova-power.service) echo "Nova's power settings" ;;
    nova-power-gpu.service) echo "the graphics card's power setting" ;;
    nova-undervolt.service) echo "the CPU's undervolt" ;;
    nova-battery-limit.service) echo "the battery's charge limit" ;;
    nova-browser-theme.service) echo "Chrome's theme color" ;;
    nova-patch-ram.service) echo "the memory patch" ;;
    nova-airdrop-bell@*) echo "AirDrop's listening for your iPhone" ;;
    nova-sleep-lock.service) echo "the lock before sleep" ;;
    nova-idle-inhibitors.service) echo "keeping the screen awake for apps" ;;
    nova-automount.service) echo "mounting drives as they are plugged in" ;;
    nova-speaker-tuning.service | nova-speaker-tuning-auto.service) echo "the speaker tuning" ;;
    nova-keyring-migrate.service) echo "moving your secrets into the login keyring" ;;
    nova-session-guard.service) echo "the session's guard" ;;
    nova-recover-internal-monitor.service) echo "turning the laptop's display back on" ;;
    limine-snapper-sync.service) echo "the boot menu's snapshots" ;;
    *) echo "Nova's service ${1%.*}" ;;
  esac
}

# "<scope> <unit>" for each of Nova's units that has failed, the system's and
# this user's.
failed() {
  local scope unit
  for scope in --system --user; do
    while read -r unit _; do
      [[ ($unit == nova-* || $unit == limine-snapper-sync.service) && $unit != nova-airdrop@* &&
        $unit != nova-doctor-services.* ]] || continue
      [[ $(systemctl "$scope" show --property=Transient --value -- "$unit" 2>/dev/null) != yes ]] || continue
      printf '%s %s\n' "$scope" "$unit"
    done < <(systemctl "$scope" list-units --state=failed --plain --no-legend --no-pager 'nova-*' limine-snapper-sync.service 2>/dev/null || true)
  done
}

# Whether a unit said before is still in the same failure: failed, or on its
# way to another try (activating, as a Restart= waits, or a run under way),
# which may fail the same way. Only one seen running or stopped has recovered.
still_failing() { # scope unit
  case $(systemctl "$1" show --property=ActiveState --value -- "$2" 2>/dev/null) in
    failed | activating | deactivating | reloading | refreshing) return 0 ;;
    *) return 1 ;;
  esac
}

# "a", "a and b", "a, b and c"
in_words() {
  local out=$1
  shift
  while (($# > 1)); do
    out+=", $1"
    shift
  done
  (($# == 0)) || out+=" and $1"
  printf '%s' "$out"
}

# One notification for the units newly failed; fails when it could not be sent.
say() { # "<scope> <unit>"...
  local entry title
  local -a names=()
  for entry; do names+=("$(name_of "${entry#* }")"); done
  title="$(in_words "${names[@]}") stopped"
  nova-notification-send -u normal -g 󰀦 "${title^}" "Settings → Updates → Check for problems has more." \
    --exec nova-shell shell summon nova.settings '{"page":"updates"}' >/dev/null 2>&1
}

main() {
  local boot scope unit entry
  local -a told=() now=() kept=() new=()
  local -A failing=() said=()
  boot=$(<"$BOOT_ID")
  mkdir -p -- "${TOLD%/*}"
  # Two at once (a login while the timer runs) would both say it.
  exec {lock}>"$TOLD.lock"
  flock "$lock"
  # "boot <id>", then the units said in that boot and failing since, a line
  # each ("<scope> <unit>").
  if [[ $(head -n 1 -- "$TOLD" 2>/dev/null) == "boot $boot" ]]; then
    mapfile -t told < <(tail -n +2 -- "$TOLD")
  fi
  mapfile -t now < <(failed)
  for entry in "${now[@]}"; do failing[$entry]=1; done
  # A unit said before stays said while it fails; one that has recovered is
  # let go of, so that its next failure is said.
  for entry in "${told[@]}"; do
    [[ -n $entry ]] || continue
    read -r scope unit <<<"$entry"
    if [[ -n ${failing[$entry]:-} ]] || still_failing "$scope" "$unit"; then
      kept+=("$entry")
      said[$entry]=1
    fi
  done
  for entry in "${now[@]}"; do
    [[ -n ${said[$entry]:-} ]] || new+=("$entry")
  done
  # Not sent (no shell to show it): said at the next run instead.
  if ((${#new[@]})) && say "${new[@]}"; then kept+=("${new[@]}"); fi
  [[ ${kept[*]} != "${told[*]}" ]] || return 0
  { echo "boot $boot"; ((${#kept[@]} == 0)) || printf '%s\n' "${kept[@]}"; } >"$TOLD.part"
  mv -f -- "$TOLD.part" "$TOLD"
}

main "$@"
