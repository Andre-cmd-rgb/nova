#!/bin/bash

# nova:summary=Print each audio output and whether it can play, for the shell
# nova:hidden=true

set -euo pipefail

# A line an output: its sink's name, a tab, then 1 when it can play and 0 when
# it cannot. One that has ports can play through one not marked "not
# available" (headphones plugged in); one without ports always can.
#
# The speakers behind a speaker tuning cannot: the tuning is a sink in front of
# them, and choosing them would only leave it out.
fronted=$(nova-audio-tuning fronted-sink 2>/dev/null || true)

pactl list sinks 2>/dev/null | awk -v fronted="$fronted" '
  function done_with_sink() {
    if (sink != "") print sink "\t" (sink != fronted && (ports == 0 || usable) ? 1 : 0)
  }
  /^Sink #/ {
    done_with_sink()
    sink = ""
    listing = ports = usable = 0
    next
  }
  /^[[:space:]]*Name:/ { sink = $2; next }
  /^[[:space:]]*Ports:$/ { listing = 1; next }
  listing && /^\tActive Port:/ { listing = 0; next }
  listing && /^\t\t/ {
    ports++
    if (!/not available/) usable = 1
    next
  }
  END { done_with_sink() }'
