#!/bin/bash

# nova:summary=Copy text to the clipboard and type or paste it
# nova:args=[--shift-insert] [--copy-only] [--history-index <index> [--history-md5 <md5>]|<text>]
# nova:hidden=true

set -euo pipefail

shift_insert=false
copy_only=false
index=""
md5=""
while (($#)); do
  case $1 in
    --shift-insert)
      shift_insert=true
      shift
      ;;
    --copy-only)
      copy_only=true
      shift
      ;;
    --history-index)
      index=${2:-}
      shift 2
      ;;
    --history-md5)
      md5=${2:-}
      shift 2
      ;;
    *) break ;;
  esac
done

text=""
if [[ -n $index ]]; then
  # A text entry of the clipboard's history, only while it is still the one
  # picked: a copy since moves every entry down one. The shell sends the md5
  # of its key, made as the clipboard's entryKey makes it. It is pasted, as
  # typing it out could take long.
  history=${XDG_STATE_HOME:-$HOME/.local/state}/nova/clipboard-history.json
  [[ $index =~ ^[0-9]+$ ]] || exit 1
  # shellcheck disable=SC2016 # jq's own variables
  text_entry='.[$index] | select(.type == "text" and (.text | type == "string"))'
  if [[ -n $md5 ]]; then
    sum=$(jq -je --argjson index "$index" "$text_entry"' | "text:" + .text' "$history" | md5sum) || exit 1
    [[ $sum == "$md5  -" ]] || exit 1
  else
    jq -e --argjson index "$index" "$text_entry" "$history" >/dev/null || exit 1
  fi
  # shellcheck disable=SC2016 # jq's own variables
  jq -j --argjson index "$index" '.[$index].text' "$history" | wl-copy
  if ! $copy_only; then shift_insert=true; fi
else
  text=${1:-}
  [[ -n $text ]] || exit 1
  printf '%s' "$text" | wl-copy
fi

if $copy_only; then exit 0; fi

# A moment for the clipboard to have it. Typed or pasted into nothing, with no
# text field in focus, is no error.
sleep 0.15
if $shift_insert; then
  wtype -M shift -k Insert -m shift 2>/dev/null || true
else
  wtype "$text" 2>/dev/null || true
fi
