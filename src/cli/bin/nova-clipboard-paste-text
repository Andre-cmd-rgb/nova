#!/bin/bash

# nova:summary=Copy a text of the clipboard's history, and paste it
# nova:args=[--copy-only] --history-index <index> [--history-md5 <md5>]
# nova:hidden=true

set -euo pipefail

# The entry is copied, then pasted with Shift+Insert, as typing it out could
# take long; with --copy-only it is only copied.
paste=1 index="" md5=""
while (($#)); do
  case $1 in
    --copy-only) paste=0 ;;
    --history-index) index=${2:-}; shift ;;
    --history-md5) md5=${2:-}; shift ;;
    *) exit 1 ;;
  esac
  shift
done
[[ $index =~ ^[0-9]+$ ]] || exit 1

# The text of entry $index of the clipboard's history, as it is, trailing
# newlines and all. It fails where that entry is no text.
history_text() {
  # shellcheck disable=SC2016 # jq's own variables
  jq -je --argjson index "$index" '.[$index] | select(.type == "text" and (.text | type == "string")) | .text' \
    "${XDG_STATE_HOME:-$HOME/.local/state}/nova/clipboard-history.json"
}

# Taken only while it is still the entry picked: a copy since moves every
# entry down one. The shell sends the md5 of its key, made as the clipboard's
# entryKey makes it.
if [[ -n $md5 ]]; then
  sum=$({ printf 'text:' && history_text; } | md5sum) || exit 1
  [[ $sum == "$md5  -" ]] || exit 1
else
  history_text >/dev/null || exit 1
fi
history_text | wl-copy
((paste)) || exit 0

# A moment for the clipboard to have it. Pasted into nothing, with no text
# field in focus, is no error.
sleep 0.15
wtype -M shift -k Insert -m shift 2>/dev/null || true
