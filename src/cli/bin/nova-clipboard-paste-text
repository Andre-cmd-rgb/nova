#!/bin/bash

# nova:summary=Copy text to the clipboard and type or paste it
# nova:args=[--shift-insert] [--copy-only] [--history-index <index> [--history-md5 <md5>]|<text>]
# nova:hidden=true

set -euo pipefail

use_shift_insert=false
copy_only=false
history_index=""
history_md5=""
text=""

while (($# > 0)); do
  case "$1" in
    --shift-insert)
      use_shift_insert=true
      shift
      ;;
    --copy-only)
      copy_only=true
      shift
      ;;
    --history-index)
      history_index="${2:-}"
      shift 2
      ;;
    --history-md5)
      history_md5="${2:-}"
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

copy_history_entry() {
  local history_path="$HOME/.local/state/nova/clipboard-history.json"

  [[ $history_index =~ ^[0-9]+$ ]] || exit 1
  jq -e --argjson index "$history_index" '.[$index].type == "text" and (.[$index].text | type == "string")' "$history_path" >/dev/null || exit 1
  # Still the entry picked: the md5 of its key, as the clipboard's entryKey
  # makes it, is the one the shell sent.
  [[ -z $history_md5 || $(jq -j --argjson index "$history_index" '"text:" + .[$index].text' "$history_path" | md5sum) == "$history_md5  -" ]] || exit 1
  jq -j --argjson index "$history_index" '.[$index].text' "$history_path" | wl-copy
}

if [[ -n $history_index ]]; then
  copy_history_entry
  if [[ $copy_only != "true" ]]; then
    use_shift_insert=true
  fi
else
  text=${1:-}
  [[ -n $text ]] || exit 1
  printf '%s' "$text" | wl-copy
fi

if [[ $copy_only == "true" ]]; then
  exit 0
fi

sleep 0.15

if [[ $use_shift_insert == "true" ]]; then
  wtype -M shift -k Insert -m shift 2>/dev/null || true
else
  wtype "$text" 2>/dev/null || true
fi
