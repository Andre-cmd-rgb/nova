#!/bin/bash

# nova:summary=Open Settings
# nova:args=[wifi|bluetooth|mobile-data|airdrop|notifications|sound|displays|keyboard|printers|battery|performance|screentime|appearance|bar|lock|apps|updates|about] | state
#
# Settings is a shell window (shell/plugins/settings). `state` is the one call
# it makes to fill itself: everything it shows, as JSON, read through the same
# commands the CLI offers, so the window and the CLI never disagree. Any piece
# that cannot be read comes back empty rather than failing the whole call.

set -euo pipefail

NOVA_PATH=${NOVA_PATH:-/usr/share/nova}
SUPPLY=${NOVA_POWER_SUPPLY:-/sys/class/power_supply}
DMI=${NOVA_DMI_PATH:-/sys/class/dmi/id}
RFKILL=${NOVA_RFKILL_PATH:-/sys/class/rfkill}
USB=${NOVA_USB_PATH:-/sys/bus/usb/devices}
# The shell's settings as the shell has them (in_effect): the same path the
# shell reads, which is not under XDG_CONFIG_HOME.
source nova-shell-config

PAGES="wifi bluetooth mobile-data airdrop notifications sound displays keyboard printers battery performance screentime appearance bar lock apps updates about"

# Lines on stdin as a JSON array of strings.
lines_json() { jq -R . | jq -sc .; }

# A command's output, or nothing if it fails or is missing.
quiet() { "$@" 2>/dev/null || true; }

# A command's JSON object or array, or the fallback when it fails or prints
# anything else.
json_or() {
  local fallback=$1 out
  shift
  if out=$("$@" 2>/dev/null) && jq -e 'type == "object" or type == "array"' >/dev/null 2>&1 <<<"$out"; then
    printf '%s\n' "$out"
  else
    printf '%s\n' "$fallback"
  fi
}

themes_json() {
  quiet nova-theme list --colors |
    jq -Rc 'split("\t") | {name: .[0], background: (.[1] // ""), foreground: (.[2] // ""), accent: (.[3] // "")}' |
    jq -sc .
}

text_size() {
  local size
  size=$(quiet nova-display-text-size | sed -n -E 's/^text size: ([0-9]+) px$/\1/p')
  echo "${size:-12}"
}

first_battery() {
  local bat
  for bat in "$SUPPLY"/BAT*; do
    [[ -r $bat/type && $(<"$bat/type") == Battery ]] && { echo "$bat"; return 0; }
  done
  return 1
}

# Health is what the battery holds now against what it held new. lid is what
# a closed lid does plugged in, powerButton what the button does,
# hibernate how long sleep on battery lasts before it hibernates (empty on a
# computer that cannot).
battery_json() {
  local bat full design cycles health=null
  if ! bat=$(first_battery); then
    echo '{"present":false}'
    return
  fi
  full=$(cat "$bat/energy_full" 2>/dev/null || cat "$bat/charge_full" 2>/dev/null || echo 0)
  design=$(cat "$bat/energy_full_design" 2>/dev/null || cat "$bat/charge_full_design" 2>/dev/null || echo 0)
  cycles=$(cat "$bat/cycle_count" 2>/dev/null || echo 0)
  [[ $full =~ ^[0-9]+$ && $design =~ ^[0-9]+$ ]] || full=0 design=0
  [[ $cycles =~ ^[0-9]+$ ]] || cycles=0
  ((design > 0)) && health=$((full * 100 / design))
  jq -nc \
    --argjson health "$health" --argjson cycles "$cycles" \
    --arg lid "$(quiet nova-power-lid)" --arg powerButton "$(quiet nova-power-button)" \
    --arg hibernate "$(quiet nova-power-hibernate)" \
    --argjson limit "$(json_or '{"kind":"none","limit":null,"on":false}' nova-battery-limit --json)" \
    '{present: true, health: $health, cycles: $cycles, limit: $limit,
      lid: $lid, powerButton: $powerButton, hibernate: $hibernate}'
}

# Performance's page: the power modes, gpu (when the discrete GPU is on: auto
# or off, or empty where Nova cannot switch it) and the CPU's undervolt.
performance_json() {
  local gpu
  gpu=$(quiet nova-power-gpu mode)
  [[ $gpu == auto || $gpu == off ]] || gpu=''
  jq -nc --arg gpu "$gpu" \
    --argjson profiles "$(quiet nova-power-profile list --active-state | jq -Rc 'split("\t") | {name: .[0], active: (.[1] == "1")}' | jq -sc .)" \
    --argjson undervolt "$(json_or null nova-power-undervolt status --json)" \
    '{profiles: $profiles, gpu: $gpu, undervolt: $undervolt}'
}

# The radios this computer has, by rfkill type (wlan, bluetooth, wwan), switched
# off or not: Settings has a page for each.
radios_json() {
  cat "$RFKILL"/rfkill*/type 2>/dev/null | sort -u | lines_json
}

# The bar widgets that may be switched off, by their manifests'
# barWidget.switchable: the others are always on the bar. One that shows only
# while another plugin is on (barWidget.shownWith: Screen Time's) names it,
# by id and by name.
widgets_json() {
  find "$NOVA_PATH/shell/plugins" \( -name manifest.json -o -name '*.manifest.json' \) -print0 2>/dev/null |
    xargs -0 -r jq -c '{id, name, kinds, barWidget}' 2>/dev/null |
    jq -sc '(map({key: (.id // ""), value: .name}) | from_entries) as $names
      | map(select(((.kinds // []) | index("bar-widget")) != null and .barWidget.switchable == true)
        | {id, name: (.barWidget.displayName // .name)}
          + ((.barWidget.shownWith | strings | {shownWith: ., shownWithName: ($names[.] // .)}) // {}))
      | sort_by(.name | ascii_downcase)'
}

# AirDrop: whether this computer's Wi-Fi card can do it, and whether its
# doorbell (nova airdrop bell) is switched on for this user.
airdrop_json() {
  local available=false bell=false
  nova-airdrop available >/dev/null 2>&1 && available=true
  systemctl is-enabled --quiet "nova-airdrop-bell@$UID.service" 2>/dev/null && bell=true
  printf '{"available":%s,"bell":%s}\n' "$available" "$bell"
}

# iPhone notifications: whether this user switched them on (nova notification
# iphone on), and whether the service runs. How the iPhone is, Settings reads
# from the service itself.
iphone_json() {
  local on=false active=false unit=nova-iphone-notifications.service
  systemctl --user is-enabled --quiet "$unit" 2>/dev/null && on=true
  systemctl --user is-active --quiet "$unit" 2>/dev/null && active=true
  printf '{"on":%s,"active":%s}\n' "$on" "$active"
}

installed() { # name:command...: the names whose command exists
  local pair
  for pair in "$@"; do
    command -v "${pair#*:}" >/dev/null 2>&1 && echo "${pair%%:*}"
  done
  return 0
}

defaults_json() {
  jq -nc \
    --arg browser "$(quiet nova-default-browser)" \
    --arg editor "$(quiet nova-default-editor)" \
    --arg terminal "$(quiet nova-default-terminal)" \
    --argjson browsers "$(installed supernova:supernova chrome:google-chrome-stable chromium:chromium firefox:firefox brave:brave edge:microsoft-edge-stable zen:zen-browser | lines_json)" \
    --argjson editors "$(installed code:code cursor:cursor zed:zeditor sublime_text:sublime_text helix:helix nvim:nvim vim:vim emacs:emacs | lines_json)" \
    --argjson terminals "$(installed foot:foot alacritty:alacritty ghostty:ghostty kitty:kitty | lines_json)" \
    '{browser: $browser, editor: $editor, terminal: $terminal,
      browsers: $browsers, editors: $editors, terminals: $terminals}'
}

# How many lines a command prints; 0 when it fails.
count_lines() { "$@" 2>/dev/null | grep -c . || true; }

# true or false, as a command succeeds or not.
yes_no() { if "$@" >/dev/null 2>&1; then echo true; else echo false; fi; }

fonts_json() { quiet nova-font-list | lines_json; }

candidates_json() { [[ $(quiet nova-update --candidates) == on ]] && echo true || echo false; }

# Fingerprint setup needs fprintd and a reader it can drive. Asking starts
# fprintd if it is not running, which it leaves again once idle: a third of a
# second, and the reader woken, every time Settings reads its state. So the
# answer is kept for this boot in the runtime folder, for as long as the same
# USB devices are plugged in (a reader is one, or built in): a reader for all
# that time, none for a minute of it, as an fprintd only just started may not
# have found its reader yet. No answer from fprintd is not kept.
fingerprint_reader() {
  local devices plugged="" vendor kept=${XDG_RUNTIME_DIR:-}/nova/fingerprint-reader
  command -v fprintd-enroll >/dev/null || return 1
  for vendor in "$USB"/*/idVendor; do
    [[ -r $vendor ]] && plugged+="$(<"$vendor"):$(<"${vendor%/*}/idProduct") "
  done
  if [[ -n ${XDG_RUNTIME_DIR:-} && -r $kept ]] && { IFS= read -r devices && IFS= read -r found; } <"$kept" &&
    [[ $devices == "${plugged:-none}" ]] && { [[ $found == yes ]] || [[ -n $(find "$kept" -newermt '-1 minute' 2>/dev/null) ]]; }; then
    [[ $found == yes ]]
    return
  fi
  devices=$(busctl --system call net.reactivated.Fprint /net/reactivated/Fprint/Manager \
    net.reactivated.Fprint.Manager GetDevices 2>/dev/null) || return 1
  found=no
  [[ $devices != "ao "[1-9]* ]] || found=yes
  if [[ -n ${XDG_RUNTIME_DIR:-} ]] && mkdir -p "${kept%/*}" 2>/dev/null; then
    printf '%s\n%s\n' "${plugged:-none}" "$found" >"$kept.$$" 2>/dev/null && mv -f "$kept.$$" "$kept" 2>/dev/null
  fi
  [[ $found == yes ]]
}

header_value() { # file key: a "# key: value" line nova update writes
  [[ -r $1 ]] && sed -n -E "s/^# $2: *(.*)$/\1/;T;p;q" "$1"
  return 0
}

about_json() {
  local model cpu mem_kb disk
  # The name is in another DMI field from maker to maker; nova-hw-model knows.
  model=$(NOVA_DMI_PATH=$DMI nova-hw-model 2>/dev/null || true)
  cpu=$(sed -n -E 's/^model name\s*:\s*//p;T;q' /proc/cpuinfo 2>/dev/null | sed -E 's/\((R|TM)\)//g; s/ CPU//; s/ @.*//; s/ +/ /g')
  mem_kb=$(awk '/^MemTotal:/ { print $2; exit }' /proc/meminfo 2>/dev/null || echo 0)
  disk=$(df -B1 --output=size,avail / 2>/dev/null | awk 'NR == 2 { print $1 "\t" $2 }')
  jq -nc \
    --arg version "$(pacman -Q nova 2>/dev/null | awk '{ sub(/-[0-9]+$/, "", $2); print $2 }')" \
    --arg release "$(header_value /etc/pacman.d/nova-repo nova-release)" \
    --arg archDate "$(header_value /etc/pacman.d/nova-mirrorlist arch-date)" \
    --arg model "$model" --arg vendor "$(cat "$DMI/sys_vendor" 2>/dev/null || true)" \
    --arg cpu "$cpu" --argjson memory "$((${mem_kb:-0} * 1024))" \
    --arg disk "$disk" --arg kernel "$(uname -r)" --arg hostname "$(cat /proc/sys/kernel/hostname 2>/dev/null || true)" \
    '{version: $version, release: $release, archDate: $archDate, model: $model, vendor: $vendor,
      cpu: $cpu, memory: $memory, kernel: $kernel, hostname: $hostname,
      disk: ($disk | split("\t") | {size: ((.[0] // "0") | tonumber), free: ((.[1] // "0") | tonumber)})}'
}

# Each part is read at once, all of them side by side, into a file of its own:
# the whole takes as long as the slowest part (xdg-terminal-exec, a tenth of
# a second), not as long as all of them one after another. A part runs
# without errexit, as a command substitution would: one that stumbles
# halfway gives what it has, never an empty file that breaks the whole.
state() {
  local dir
  dir=$(mktemp -d)
  # shellcheck disable=SC2064 # the folder made now
  trap "rm -rf -- '$dir'" EXIT
  part() { # name command...
    local name=$1
    shift
    (
      set +e
      "$@"
    ) >"$dir/$name" 2>/dev/null &
  }
  part config json_or '{}' in_effect
  part theme quiet nova-theme current
  part themes themes_json
  part background quiet nova-theme bg current
  part backgrounds count_lines nova-theme bg list
  part adaptive quiet nova-theme adaptive
  part font quiet nova-font-current
  part fonts fonts_json
  part textSize text_size
  part battery battery_json
  part performance performance_json
  part radios radios_json
  part bluetooth json_or null nova-bluetooth-le --json
  part airdrop airdrop_json
  part iphone iphone_json
  part displays json_or '{"displays":[],"pending":null}' nova-monitor list --json
  part input json_or '{}' nova-input --json
  part screenTime yes_no nova-screentime enabled
  part widgets widgets_json
  part fingerprint yes_no fingerprint_reader
  part defaults defaults_json
  part about about_json
  part candidates candidates_json
  wait
  jq -nc \
    --arg theme "$(<"$dir/theme")" \
    --argjson themes "$(<"$dir/themes")" \
    --arg background "$(<"$dir/background")" \
    --argjson backgrounds "$(<"$dir/backgrounds")" \
    --arg adaptive "$(<"$dir/adaptive")" \
    --arg font "$(<"$dir/font")" \
    --argjson fonts "$(<"$dir/fonts")" \
    --argjson textSize "$(<"$dir/textSize")" \
    --argjson battery "$(<"$dir/battery")" \
    --argjson performance "$(<"$dir/performance")" \
    --argjson radios "$(<"$dir/radios")" \
    --argjson bluetooth "$(<"$dir/bluetooth")" \
    --argjson airdrop "$(<"$dir/airdrop")" \
    --argjson iphone "$(<"$dir/iphone")" \
    --argjson displays "$(<"$dir/displays")" \
    --argjson input "$(<"$dir/input")" \
    --argjson screenTime "$(<"$dir/screenTime")" \
    --argjson config "$(<"$dir/config")" \
    --argjson widgets "$(<"$dir/widgets")" \
    --argjson fingerprint "$(<"$dir/fingerprint")" \
    --argjson defaults "$(<"$dir/defaults")" \
    --argjson about "$(<"$dir/about")" \
    --argjson candidates "$(<"$dir/candidates")" \
    --argjson firmware "$(command -v fwupdmgr >/dev/null && echo true || echo false)" \
    '{appearance: {theme: $theme, themes: $themes, background: $background, backgrounds: $backgrounds,
                   font: $font, fonts: $fonts, textSize: $textSize, adaptive: $adaptive},
      battery: $battery,
      performance: $performance,
      radios: $radios,
      bluetooth: $bluetooth,
      airdrop: $airdrop,
      iphone: $iphone,
      displays: $displays,
      input: $input,
      nightlight: ($config.nightlight | objects // {}),
      doNotDisturb: ($config.doNotDisturb | objects // {}),
      screenTime: $screenTime,
      bar: {transparent: ($config.bar.transparent == true),
            widgets: $widgets,
            shown: [($config.bar.layout // {}) | (.left // [], .center // [], .right // [])[] | select(.off? != true) | .id? // empty],
            hiddenTray: [($config.bar.layout // {}) | (.left // [], .center // [], .right // [])[]
              | select(.id? == "nova.tray") | (.hidden // [])[] | strings],
            hiddenTrayNames: ([($config.bar.layout // {}) | (.left // [], .center // [], .right // [])[]
              | select(.id? == "nova.tray") | .names | objects | with_entries(select(.value | type == "string"))] | add // {})},
      lock: {seconds: (if ($config.idle.lock | type) == "number" then $config.idle.lock else 300 end),
             screensaver: (if ($config.idle.screensaver | type) == "number" then $config.idle.screensaver else 180 end),
             fingerprint: $fingerprint},
      apps: $defaults,
      updates: {candidates: $candidates, firmware: $firmware},
      about: $about}'
}

case ${1:-} in
  state) state ;;
  -h | --help) echo "Usage: nova settings [${PAGES// /|}] | nova settings state" ;;
  *)
    page=${1:-}
    if [[ -n $page && " $PAGES " != *" $page "* ]]; then
      echo "nova-settings: no page '$page'; the pages are: $PAGES" >&2
      exit 2
    fi
    nova-shell shell summon nova.settings "$(jq -nc --arg page "$page" '{page: $page}')" >/dev/null ||
      { echo "nova-settings: could not open Settings; is the shell running?" >&2; exit 1; }
    ;;
esac
