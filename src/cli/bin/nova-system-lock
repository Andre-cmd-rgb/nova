#!/bin/bash

# nova:summary=Lock the computer

set -euo pipefail

nova-shell lock lock >/dev/null

# Unlock with the first keyboard layout, the one the password was set in.
hyprctl switchxkblayout all 0 >/dev/null 2>&1 || true

# Lock 1Password too, when it runs. The timeout matters: `1password --lock` can
# leave a whole Electron helper tree behind.
if pgrep -u "$UID" -x 1password >/dev/null; then
  (
    flock -n 9 || exit 0
    timeout --kill-after=1s 3s 1password --lock >/dev/null 2>&1 || true
  ) 9>"${XDG_RUNTIME_DIR:-/tmp}/nova-1password-lock.lock" &
fi
