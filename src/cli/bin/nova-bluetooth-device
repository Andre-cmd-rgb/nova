#!/bin/bash

# nova:summary=Control a Bluetooth device
# nova:args=[pair|connect|disconnect|forget] <address>

set -euo pipefail

usage() {
  echo "Usage: nova-bluetooth-device [pair|connect|disconnect|forget] <address>" >&2
  exit 1
}

action=${1:-}
address=${2:-}

[[ $action == "pair" || $action == "connect" || $action == "disconnect" || $action == "forget" ]] || usage
[[ $address =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]] || usage

power_on() {
  if [[ $(timeout 2s bluetoothctl show 2>/dev/null || true) == *"Powered: yes"* ]]; then
    return 0
  fi
  # Not bluetoothctl directly: Bluetooth is turned off by an rfkill soft block,
  # and BlueZ refuses to power an adapter up while one is set.
  nova-bluetooth-power on || true
}

trust_device() {
  bluetoothctl trust "$address" >/dev/null 2>&1 || true
}

# The agent that says yes to the pairing runs only while this one does: BlueZ
# keeps the adapter pairable while any agent is registered, and this agent
# would say yes to any device that asked, not only the one picked here.
pairing_agent() { # start|stop
  systemctl --user "$1" bt-agent.service >/dev/null 2>&1 || true
}

wait_pairable() {
  local _
  for _ in {1..10}; do
    [[ $(timeout 2s bluetoothctl show 2>/dev/null || true) != *"Pairable: yes"* ]] || return 0
    sleep 0.2
  done
}

case "$action" in
  pair)
    power_on
    trap 'pairing_agent stop' EXIT
    pairing_agent start
    wait_pairable
    timeout 20s bluetoothctl pair "$address" >/dev/null 2>&1 || true
    trust_device
    timeout 20s bluetoothctl connect "$address" >/dev/null 2>&1 || true
    ;;
  connect)
    power_on
    trust_device
    timeout 20s bluetoothctl connect "$address" >/dev/null 2>&1 || true
    ;;
  disconnect)
    timeout 10s bluetoothctl disconnect "$address" >/dev/null 2>&1 || true
    ;;
  forget)
    power_on
    timeout 10s bluetoothctl disconnect "$address" >/dev/null 2>&1 || true
    timeout 10s bluetoothctl remove "$address" >/dev/null 2>&1 || true
    ;;
esac
