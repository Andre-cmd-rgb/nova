#!/bin/bash

# nova:summary=Enable, disable, or toggle a Hyprland input device
# nova:args=<touchpad|touchscreen> [on|off|toggle]
# nova:hidden=true

set -euo pipefail

usage() {
  echo "Usage: nova-toggle-input-device <touchpad|touchscreen> [on|off|toggle]" >&2
  exit 2
}

kind=${1:-}
case $kind in
  touchpad) label=Touchpad icon=touchpad ;;
  touchscreen) label=Touchscreen icon=touch ;;
  *) usage ;;
esac

# A device turned off stays off: its name is kept, as text, where the Hyprland
# config reads it back at every reload (data/hypr/toggles.lua). Names come
# from the hardware, so one is never run as shell or Lua. ~/.local/state, as
# for the other toggles, whatever XDG_STATE_HOME says.
kept=$HOME/.local/state/nova/toggles/hypr/$kind-disabled-name
device=$("nova-hw-$kind" || true)

usable_device() {
  if [[ -z $device ]]; then
    echo "No $kind device found" >&2
    exit 1
  fi
  if [[ $device == *[[:cntrl:]]* ]]; then
    echo "Invalid $kind device name" >&2
    exit 1
  fi
}

# The name as a Lua string, its backslashes and quotes escaped.
set_enabled() { # true|false
  local name=${device//\\/\\\\}
  name=${name//\"/\\\"}
  hyprctl eval "hl.device({ name = \"$name\", enabled = $1 })" >/dev/null
}

turn_on() {
  # Forgotten first, so a device whose name has since become unusable cannot
  # keep the setting stuck off.
  rm -f "$kept"
  usable_device
  set_enabled true
  nova-osd -i "$icon" -m "$label enabled" || true
}

turn_off() {
  usable_device
  set_enabled false
  mkdir -p "${kept%/*}"
  printf '%s\n' "$device" >"$kept"
  nova-osd -i "$icon" -m "$label disabled" || true
}

case ${2:-toggle} in
  on) turn_on ;;
  off) turn_off ;;
  toggle) if [[ -f $kept ]]; then turn_on; else turn_off; fi ;;
  *) usage ;;
esac
