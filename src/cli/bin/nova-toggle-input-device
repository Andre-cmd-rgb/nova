#!/bin/bash

# nova:summary=Enable, disable, or toggle a Hyprland input device
# nova:args=<touchpad|touchscreen> [on|off|toggle]
# nova:hidden=true

set -euo pipefail

usage() {
  echo "Usage: nova-toggle-input-device <touchpad|touchscreen> [on|off|toggle]" >&2
  exit 2
}

kind=${1:-}
action=${2:-toggle}
case $kind in
  touchpad) label="Touchpad" icon="touchpad" ;;
  touchscreen) label="Touchscreen" icon="touch" ;;
  *) usage ;;
esac

# The persisted disable is the device name stored as plain data; on every
# reload hypr/disabled-input-device.lua reads it back and disables the device.
# Names come from USB descriptors and must not be interpolated into shell or
# Lua unescaped. The path is ~/.local/state like the other toggles, so it keeps
# working when XDG_STATE_HOME diverges.
name_file="$HOME/.local/state/nova/toggles/hypr/$kind-disabled-name"

device=$("nova-hw-$kind" || true)

require_device() {
  if [[ -z $device ]]; then
    echo "No $kind device found" >&2
    exit 1
  fi
  if [[ $device == *[[:cntrl:]]* ]]; then
    echo "Invalid $kind device name" >&2
    exit 1
  fi
}

apply_device() {
  local quoted=${device//\\/\\\\}
  quoted=${quoted//\"/\\\"}
  hyprctl eval "hl.device({ name = \"$quoted\", enabled = $1 })" >/dev/null
}

enable() {
  # Clear the persisted state before requiring a usable device, so a device
  # that stops reporting a valid name can never wedge the disable in place.
  rm -f "$name_file"
  require_device
  apply_device true
  nova-osd -i "$icon" -m "$label enabled" || true
}

disable() {
  require_device
  apply_device false
  mkdir -p "${name_file%/*}"
  printf '%s\n' "$device" >"$name_file"
  nova-osd -i "$icon" -m "$label disabled" || true
}

case $action in
  on) enable ;;
  off) disable ;;
  toggle) if [[ -f $name_file ]]; then enable; else disable; fi ;;
  *) usage ;;
esac
