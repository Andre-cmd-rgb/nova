#!/bin/bash

# nova:summary=Turn Bluetooth on or off, remembered across reboots
# nova:args=<on|off|toggle|is-on>

# Bluetooth is on or off by its rfkill soft block, and BlueZ follows that.
# BlueZ never keeps an adapter's Powered across a reboot, so off through
# bluetoothctl lasts until the next boot; systemd-rfkill keeps every block
# (under /var/lib/systemd/rfkill) and puts it back early in the next boot, and
# the block holds every Bluetooth radio, where bluetoothctl speaks to the
# default one only. Taken off, bluetoothd powers the adapter up by itself
# (AutoEnable, as shipped). Everything in Nova that turns Bluetooth on or off
# does it here, as bluetoothctl cannot power an adapter up while it is blocked.

set -euo pipefail

wait_seconds=${NOVA_BLUETOOTH_POWER_WAIT_SECONDS:-2}

# On when any adapter is: the block holds them all, so they are all asked, not
# only the default one, behind which a dongle could be powered.
powered() {
  local _ controller
  local -a controllers=()
  while read -r _ controller _; do
    if [[ -n $controller ]]; then controllers+=("$controller"); fi
  done < <(timeout 2s bluetoothctl list 2>/dev/null || true)
  for controller in "${controllers[@]}"; do
    if [[ $(timeout 2s bluetoothctl show "$controller" 2>/dev/null || true) == *"Powered: yes"* ]]; then
      return 0
    fi
  done
  return 1
}

# Until a time, not for a number of tries: with D-Bus stuck, each try can take
# its whole timeout, and ten of them half a minute.
wait_powered() {
  local until_seconds=$((SECONDS + wait_seconds))
  until powered; do
    ((SECONDS < until_seconds)) || return 1
    sleep 0.2
  done
}

power_on() {
  rfkill unblock bluetooth
  # bluetoothd powers it up as the block goes, but not an adapter that was
  # powered down without one: that is asked for, before giving up.
  wait_powered && return 0
  timeout 5s bluetoothctl power on >/dev/null 2>&1 || true
  wait_powered && return 0
  echo "nova-bluetooth-power: adapter did not come up" >&2
  return 1
}

case ${1:-} in
  on) power_on ;;
  # The block powers the adapter down too, and it is what lasts.
  off) rfkill block bluetooth ;;
  toggle)
    if powered; then
      rfkill block bluetooth
    else
      power_on
    fi
    ;;
  is-on) powered ;;
  *)
    echo "Usage: nova-bluetooth-power <on|off|toggle|is-on>" >&2
    exit 1
    ;;
esac
