#!/bin/bash

# nova:summary=Switch to the next media player, taking playback with it
# nova:args=[next|previous]

set -euo pipefail

direction="${1:-next}"

case "$direction" in
  next)
    nova-shell media sourceSwitch
    ;;
  previous)
    nova-shell media sourceSwitchPrevious
    ;;
  *)
    echo "Usage: nova-audio-source-switch [next|previous]" >&2
    exit 1
    ;;
esac
