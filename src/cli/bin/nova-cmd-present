#!/bin/bash

# nova:summary=Check whether all required commands are available
# nova:args=<command>...
# nova:hidden=true

set -euo pipefail

# False at the first name that is not a command; true when every one is, or
# when none was given.
for name; do
  command -v -- "$name" >/dev/null 2>&1 || exit 1
done
