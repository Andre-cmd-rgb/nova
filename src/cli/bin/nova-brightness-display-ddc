#!/bin/bash

# nova:summary=Show or change the brightness of an external display, over DDC/CI
# nova:args=<monitor> [+N%|N%-|N%]
# nova:hidden=true

# Without a step, the brightness in percent; with one, the percent it is set
# to. The keys' 5% steps go by 1% at 5% and under, as a backlight's do, and
# nothing goes below 1% or above 100%. 1 for a display not reached.

set -euo pipefail

monitor=${1:-}
step=${2:-}
[[ -n $monitor ]] || exit 1
[[ -z $step || $step =~ ^\+?[0-9]+%$ || $step =~ ^[0-9]+%-$ ]] || exit 1
# The step's number, in decimal whatever zeros lead it.
amount=$((10#0${step//[!0-9]/}))

# ddcutil is slow, so what it found is kept, a line in a file for each display:
#   <bus> <time>         the I2C bus the display is on, found at <time>; or
#                        "none", no DDC/CI found, not looked for again for a minute
#   <bus> <time> <max>   and the brightness range, read at <time>: trusted for
#                        ten seconds, for a brightness set as a percentage
# Keeping it is never worth failing over.
kept=${XDG_RUNTIME_DIR:-/tmp}/nova/brightness-ddc/${monitor//[^[:alnum:]_.-]/_}
# NOVA_HARDWARE and NOVA_DRM_PATH are for the tests.
hardware=${NOVA_HARDWARE:-/usr/share/nova/hardware}
drm=${NOVA_DRM_PATH:-/sys/class/drm}
printf -v now '%(%s)T' -1

keep() { # bus [max]
  mkdir -p "${kept%/*}" 2>/dev/null || true
  echo "$1 $now${2:+ $2}" >"$kept" 2>/dev/null || true
}

ddc() { ddcutil --skip-ddc-checks "$@" 2>/dev/null || true; }

# The display's maker and model as ddcutil names them, such as HCH:HETECH:
# the three letters of the EDID's manufacturer code, and its name descriptor.
model() {
  local edid="" file bytes code maker="" name="" at i char
  for file in "$drm"/card*-"$monitor"/edid; do
    [[ -e $file ]] && edid=$file
    break
  done
  [[ -n $edid ]] || return 1
  read -r -d '' -a bytes < <(od -An -v -tu1 -N128 "$edid") || true
  ((${#bytes[@]} == 128)) || return 1
  # Three letters of five bits each, 1 for A, in the big-endian word at 8.
  code=$((bytes[8] << 8 | bytes[9]))
  for i in 10 5 0; do
    printf -v char '\\x%x' $(((code >> i & 31) + 64))
    printf -v char '%b' "$char"
    maker+=$char
  done
  # The name is the descriptor (of four, 18 bytes each) tagged 0xfc: up to 13
  # characters after its 5-byte header, a newline ending it and spaces after.
  for at in 54 72 90 108; do
    ((bytes[at] == 0 && bytes[at + 1] == 0 && bytes[at + 2] == 0 && bytes[at + 3] == 252)) || continue
    for ((i = at + 5; i < at + 18 && bytes[i] != 10; i++)); do
      printf -v char '\\x%x' "${bytes[i]}"
      printf -v char '%b' "$char"
      name+=$char
    done
    break
  done
  name=${name%"${name##*[![:space:]]}"}
  [[ -n $name ]] || return 1
  echo "$maker:$name"
}

# Some displays run their brightness backwards, 0 the brightest; the numbers
# are flipped for them, so that the keys and the slider go the right way.
reversed=false
if model=$(model) && grep -qxF -- "$model" "$hardware/ddc-reversed" 2>/dev/null; then
  reversed=true
fi

# The bus the display is on, in $bus, as kept or as ddcutil detect finds it:
# each display's "I2C bus:" line comes before its "DRM connector:" line,
# cardN-<monitor>. 1 for none.
find_bus() {
  local was="" since="" line found=""
  bus=""
  if [[ -r $kept ]]; then read -r was since _ <"$kept" || true; fi
  if [[ $was =~ ^[0-9]+$ ]]; then
    bus=$was
    return 0
  fi
  if [[ $was == none && $since =~ ^[0-9]+$ ]] && ((now - since < 60)); then return 1; fi
  while read -r line; do
    case $line in
      "I2C bus:"*) found=${line##*/i2c-} ;;
      "DRM connector:"*)
        line=${line##* }
        if [[ -z $bus && ${line#card*-} == "$monitor" && $found =~ ^[0-9]+$ ]]; then bus=$found; fi
        found=""
        ;;
    esac
  done < <(ddc detect --brief)
  if [[ -z $bus ]]; then
    keep none
    return 1
  fi
  keep "$bus"
}

# The brightness, in $value out of $max, flipped for a display that runs
# backwards; the range is kept. 1 when it cannot be read, and the bus is
# looked for again next time.
read_brightness() {
  local tag code kind
  find_bus || return 1
  # getvcp's line: VCP 10 C <value> <max>.
  value="" max=""
  while read -r tag code kind value max _; do
    if [[ $tag == VCP && ${code^^} == 10 && $kind == C && $value =~ ^[0-9]+$ && $max =~ ^[0-9]+$ ]] && ((max > 0)); then break; fi
    value="" max=""
  done < <(ddc --bus "$bus" getvcp 10 --brief)
  if [[ -z $max ]]; then
    rm -f "$kept"
    return 1
  fi
  if $reversed; then value=$((max - value)); fi
  keep "$bus" "$max"
}

# Of the range, rounded to the nearest percent.
percent() { echo $(((value * 100 + max / 2) / max)); }

bus="" value="" max=""
if [[ -z $step ]]; then
  read_brightness || exit 1
  percent
  exit 0
fi

if [[ $step == +* || $step == *- ]]; then
  read_brightness || exit 1
  from=$(percent)
  if [[ $step == +* ]]; then
    target=$((amount == 5 && from < 5 ? from + 1 : from + amount))
  else
    target=$((amount == 5 && from <= 5 ? from - 1 : from - amount))
  fi
else
  # Set as a percentage, the range is all it needs, and a fresh one is kept.
  target=$amount
  since=""
  if [[ -r $kept ]]; then read -r bus since max <"$kept" || true; fi
  if ! [[ $bus =~ ^[0-9]+$ && $since =~ ^[0-9]+$ && $max =~ ^[0-9]+$ ]] || ((max == 0 || since > now || now - since >= 10)); then
    read_brightness || exit 1
  fi
fi

((target >= 1)) || target=1
((target <= 100)) || target=100
raw=$(((target * max + 50) / 100))
if $reversed; then raw=$((max - raw)); fi

if ! ddcutil --bus "$bus" --skip-ddc-checks --noverify setvcp 10 "$raw" >/dev/null 2>&1; then
  rm -f "$kept"
  exit 1
fi
echo "$target"
