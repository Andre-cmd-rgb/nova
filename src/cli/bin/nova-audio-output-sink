#!/bin/bash

# nova:summary=Print the sink whose volume and mute an output really goes by
# nova:args=[sink-name]

set -euo pipefail

# An output can be a filter in front of the real one: a speaker tuning, or
# EasyEffects. Its own volume is the level going into the filter, so turning
# that changes the sound (a limiter's, a compressor's) more than how loud it
# is. The loudness is the volume of the sink the filter plays into, and this
# finds that one.
#
# The output is the default one unless named: headphones or a display chosen
# answer themselves, never the speakers a tuning happens to be in front of.
# The output switcher names the output it is about to switch to.
#
# Every lookup may fail, an audio server not up yet among them: what cannot be
# followed answers the output itself.

sink=${1:-}
if [[ -z $sink ]]; then
  sink=$(pactl get-default-sink 2>/dev/null || true)
fi

# A sound card's own sink is where the loudness is.
if [[ -z $sink || $sink == alsa_output.* ]]; then
  printf '%s\n' "$sink"
  exit 0
fi

# The name of the sink with this id, from the first line that has it.
sink_with_id() {
  local id name
  while read -r id name _; do
    if [[ $id == "$1" ]]; then
      printf '%s\n' "$name"
      return
    fi
  done < <(pactl list sinks short 2>/dev/null || true)
}

# A filter plays into the sink under it through a stream of its own, named
# after it: a tuning's effect_input.x through effect_output.x, others by a
# name that starts with theirs. EasyEffects' stream is known by its
# application. The first stream named exactly so wins; one only named after
# the filter is kept in case none is.
stream_target=$(pactl list sink-inputs 2>/dev/null | awk -v filter="$sink" '
  BEGIN {
    exact = filter
    sub(/^effect_input\./, "effect_output.", exact)
    loose = (exact == filter)
  }
  /^Sink Input #/ { target = "" }
  /^[[:space:]]*Sink:/ { target = $2 }
  target != "" && /node\.name = / {
    name = $0
    sub(/.*node\.name = "/, "", name)
    sub(/"$/, "", name)
    named = index(name, filter) == 1
    if (name == exact || (loose && named)) { found = target; exit }
    if (named && spare == "") spare = target
  }
  target != "" && filter == "easyeffects_sink" && /application\.name = "EasyEffects"/ { found = target; exit }
  END { print (found != "" ? found : spare) }' || true)

if [[ -n $stream_target ]]; then
  under=$(sink_with_id "$stream_target")
  if [[ -n $under ]]; then
    printf '%s\n' "$under"
    exit 0
  fi
fi

# EasyEffects 8 has no such stream: its output node's ports are linked
# straight to the sink's. Under it is the first sound card or Bluetooth sink
# one of its ports (ee_*) plays into. awk reads pw-link to the end, which
# leaving early could kill with SIGPIPE.
if [[ $sink == easyeffects_sink ]]; then
  under=$(pw-link -l 2>/dev/null | awk '
    /^[^ ]/ { port = $0 }
    !found && /^[[:space:]]*\|->/ && port ~ /^ee_/ && $2 ~ /^(alsa|bluez)_output\..*:playback_/ {
      found = $2
      sub(/:playback_.*$/, "", found)
      print found
    }' || true)

  # Idle, EasyEffects unlinks them: then the output its settings name, if
  # that sink is there.
  if [[ -z $under ]]; then
    configured=$(sed -n 's/^outputDevice=//p' "${XDG_CONFIG_HOME:-$HOME/.config}/easyeffects/db/easyeffectsrc" 2>/dev/null || true)
    if [[ -n $configured ]] && pactl list sinks short 2>/dev/null | awk -v want="$configured" '$2 == want { found = 1 } END { exit !found }'; then
      under=$configured
    fi
  fi

  if [[ -n $under ]]; then
    printf '%s\n' "$under"
    exit 0
  fi
fi

# Nothing under it to be found, an idle filter's links among them: the output
# itself, so that callers still have one to act on.
printf '%s\n' "$sink"
