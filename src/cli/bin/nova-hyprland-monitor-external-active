#!/bin/bash

# nova:summary=Returns true when Hyprland has an active external monitor
# nova:hidden=true

set -euo pipefail

# Any display on that is not the laptop's own panel (eDP, LVDS or DSI).
hyprctl monitors all -j |
  jq -e 'first(.[] | select(.disabled == false and (.name | test("^(eDP|LVDS|DSI)-") | not)))' >/dev/null 2>&1
