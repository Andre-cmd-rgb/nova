#!/bin/bash

# nova:summary=Lock before suspend and wait for the session lock to become secure
# nova:hidden=true
#
#   nova-system-sleep-lock [budget-ms]   before suspend (nova-system-sleep-monitor)
#   nova-system-sleep-lock --resumed     after it, when the lock was not up in time
#
# A lock slow to come up gets the screens turned off while it is waited for,
# so the session is not on show. If logind suspends before it is secure, the
# screens stay off after the machine wakes, and the lock is asked for again,
# until it is up: only then do they come back on.

set -euo pipefail

# The time there is: logind holds the suspend for a delay inhibitor only so
# long, and then suspends with the lock half done. So every step is cut short
# at the time left, and the deadline keeps itself, with no guess at how long
# a step takes.
budget_cap_ms=36000
lock_timeout_ms=1000
status_timeout_ms=500
# Without a secure lock this long, the screens go off, and again every second
# after, as a key press turns them on.
blank_after_ms=2000
blank_every_ms=1000
# Woken without a secure lock, how long it is asked for.
resumed_budget_ms=120000
unsecured=${XDG_RUNTIME_DIR:-/run/user/$UID}/nova/sleep-unsecured

# The time now, in milliseconds, in $now. EPOCHREALTIME has the locale's
# decimal separator, which a comma would turn into bash's comma operator, so
# every character but the digits goes.
clock() {
  now=$((10#${EPOCHREALTIME//[!0-9]/} / 1000))
}

# The budget logind's window leaves, asked of logind rather than assumed, as
# Nova's drop-in counts only once logind has reloaded. A fifth of it, and at
# least a second, is left for logind to send PrepareForSleep and act on the
# release: 4 s of the 5 s default, 36 s of Nova's 45 s. The cap keeps a window
# raised by hand from holding a closed laptop awake in a bag.
logind_budget() {
  local window
  window=$(timeout --kill-after=0.1s 1s busctl get-property \
    org.freedesktop.login1 /org/freedesktop/login1 \
    org.freedesktop.login1.Manager InhibitDelayMaxUSec 2>/dev/null || true)
  window=${window##* }
  # Unread, it is logind's default.
  if [[ ! $window =~ ^[0-9]+$ ]] || ((window == 0)); then window=5000000; fi
  window=$((window / 1000))
  window=$((window - (window / 5 > 1000 ? window / 5 : 1000)))
  echo $((window < budget_cap_ms ? window : budget_cap_ms))
}

resumed=false
if [[ ${1:-} == --resumed ]]; then
  resumed=true
  # Only after a suspend without a secure lock, and only once at a time.
  [[ -e $unsecured ]] || exit 0
  exec {held}>>"$unsecured"
  flock -n "$held" || exit 0
  budget_ms=$resumed_budget_ms
else
  budget_ms=${1:-$(logind_budget)}
  if [[ ! $budget_ms =~ ^[0-9]+$ ]] || ((budget_ms < 1 || budget_ms > budget_cap_ms)); then
    budget_ms=$(logind_budget)
  fi
fi
clock
started=$now
deadline=$((now + budget_ms))

# The shell, asked within its own limit and the time left; 1 with no time left.
shell() { # limit-ms argument...
  local limit=$1 seconds
  shift
  clock
  ((deadline - now > 0)) || return 1
  ((limit < deadline - now)) || limit=$((deadline - now))
  printf -v seconds '%d.%03d' $((limit / 1000)) $((limit % 1000))
  NOVA_SHELL_IPC_TIMEOUT=$seconds timeout --kill-after=0.1s "$seconds" nova-shell "$@"
}

# The shell turns a lock down with a zero exit, and says why: only that is
# looked for. Whether it locked is for the status to say, and asking again
# does no harm.
ask_to_lock() {
  case $(shell "$lock_timeout_ms" lock lock 2>/dev/null || true) in
    missing-pam) give_up "no lock screen is configured" ;;
  esac
}

# secure, or locking while the shell works on it; anything else, an answer
# that cannot be read too, is asked again.
lock_state() {
  jq -r 'if .secure == true then "secure" elif .requested == true then "locking" else "idle" end' \
    <<<"$(shell "$status_timeout_ms" lock status 2>/dev/null || true)" 2>/dev/null || true
}

# Hyprland's IPC can stall as the lid moves: the lid's bind and the monitor
# watcher see to clamshell too, so this need not succeed.
clamshell() {
  timeout --kill-after=0.1s 0.4s nova-hyprland-monitor-clamshell >/dev/null 2>&1 || true
}

# The screens off, as long as Hyprland's IPC, which is what stalls, allows.
blank() {
  timeout --kill-after=0.1s 0.4s nova-brightness-display off >/dev/null 2>&1 || true
}

blanked=0
blank_while_waiting() {
  clock
  if $resumed || ((now - started >= blank_after_ms)); then
    if ((now - blanked >= blank_every_ms)); then
      blanked=$now
      blank
    fi
  fi
}

# Secure: the screens it turned off come back on, on the lock screen.
secured() {
  if $resumed; then rm -f -- "$unsecured"; fi
  if $resumed || ((blanked > 0)); then
    timeout --kill-after=0.1s 1s nova-brightness-display on >/dev/null 2>&1 || true
  fi
  exit 0
}

# Woken, the clock has jumped by however long the machine slept: the time left
# starts again from the wake.
polled=$started
woke() {
  clock
  if $resumed && ((now - polled > 5000)); then
    deadline=$((now + budget_ms))
    blanked=0
  fi
  polled=$now
}

# logind suspends whether this succeeded or not: then the machine sleeps with
# the session open, but its screens off, and the lock asked for again as it
# wakes (--resumed). The notification is on the screen it unlocks into.
give_up() { # why
  printf 'nova-system-sleep-lock: suspending without a secure lock (%s)\n' "$1" >&2
  if $resumed; then
    rm -f -- "$unsecured"
    exit 1
  fi
  mkdir -p -- "${unsecured%/*}"
  : >"$unsecured"
  blank
  nova-notification-send -u critical -g 󰌾 \
    "Screen did not lock before suspend" \
    "The screens stayed off until it locked ($1)." >/dev/null 2>&1 || true
  exit 1
}

# The lock first, before anything to do with the monitors, so that a Hyprland
# IPC call that hangs cannot use up the time before the shell has started to
# lock.
ask_to_lock
clamshell

# The sleep at the end can go past the deadline by one poll, well within what
# the budget leaves logind.
while woke && clock && ((deadline - now > 0)); do
  case $(lock_state) in
    secure) secured ;;
    locking) ;;
    *) ask_to_lock ;;
  esac
  blank_while_waiting
  sleep 0.1
done

give_up "the shell did not secure the session within ${budget_ms}ms"
