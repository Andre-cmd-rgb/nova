#!/bin/bash

# nova:summary=Lock before suspend and wait for the session lock to become secure
# nova:hidden=true
#
#   nova-system-sleep-lock [budget-ms]   before suspend (nova-system-sleep-monitor)
#   nova-system-sleep-lock --resumed     after it, when the lock was not up in time
#
# A lock slow to come up gets the screens turned off while it is waited for,
# so the session is not on show. If logind suspends before it is secure, the
# screens stay off after the machine wakes, and the lock is asked for again,
# until it is up: only then do they come back on.

set -euo pipefail

# Overrunning the budget is the failure this whole path exists to prevent:
# logind stops honouring the inhibitor and suspends mid-lock. Every call below
# is bounded by what is left of the budget, so the deadline enforces itself
# rather than depending on an estimate of how long a step ought to take.
budget_cap_ms=36000
lock_timeout_ms=1000
status_timeout_ms=500
poll_interval=0.1
# After this long without a secure lock, the screens go off; they are turned
# off again each second, as a key press turns them on.
blank_after_ms=2000
blank_every_ms=1000
# How long after waking the lock is asked for, the screens off.
resumed_budget_ms=120000
unsecured=${XDG_RUNTIME_DIR:-/run/user/$UID}/nova/sleep-unsecured

# logind decides how long a delay inhibitor may hold the machine, and the
# shipped drop-in only counts once logind has reloaded it, so ask rather than
# assume. Leaving logind a fifth of its own window to deliver PrepareForSleep
# and act on the release gives 4s at the 5s default and 36s at the shipped 45s.
# The cap keeps a hand-raised window from stranding a closed laptop in a bag.
derive_budget_ms() {
  local window
  window=$(timeout --kill-after=0.1s 1s busctl get-property \
    org.freedesktop.login1 /org/freedesktop/login1 \
    org.freedesktop.login1.Manager InhibitDelayMaxUSec 2>/dev/null || true)
  window=${window##* }

  # An unreadable window means we cannot know, so assume logind's own default.
  if [[ ! $window =~ ^[0-9]+$ ]] || ((window == 0)); then window=5000000; fi
  window=$((window / 1000))

  # Never leave logind less than a second, however small its window is.
  window=$((window - (window / 5 > 1000 ? window / 5 : 1000)))

  if ((window < budget_cap_ms)); then echo "$window"; else echo "$budget_cap_ms"; fi
}

resumed=0
if [[ ${1:-} == --resumed ]]; then
  resumed=1
  # Nothing to do unless the last suspend went without a secure lock, and
  # nothing a second time.
  [[ -e $unsecured ]] || exit 0
  exec {resumed_lock}>>"$unsecured"
  flock -n "$resumed_lock" || exit 0
  budget_ms=$resumed_budget_ms
else
  budget_ms=${1:-$(derive_budget_ms)}
  if [[ ! $budget_ms =~ ^[0-9]+$ ]] || ((budget_ms < 1 || budget_ms > budget_cap_ms)); then
    budget_ms=$(derive_budget_ms)
  fi
fi
started_ms=$((10#${EPOCHREALTIME//[!0-9]/} / 1000))

# EPOCHREALTIME renders with the locale's decimal separator, so drop every
# non-digit rather than assuming a period. A comma would otherwise read as
# bash's comma operator and silently void the deadline.
deadline_ms=$((10#${EPOCHREALTIME//[!0-9]/} / 1000 + budget_ms))

remaining_ms() {
  echo $((deadline_ms - 10#${EPOCHREALTIME//[!0-9]/} / 1000))
}

# Clamping to what is left as well as to the call's own limit is what lets the
# loop below stay a plain "while there is time" without predicting step costs.
lock_ipc() {
  local limit=$1 remaining seconds
  shift

  remaining=$(remaining_ms)
  ((remaining > 0)) || return 1
  ((limit < remaining)) || limit=$remaining
  printf -v seconds '%d.%03d' $((limit / 1000)) $((limit % 1000))

  NOVA_SHELL_IPC_TIMEOUT="$seconds" \
    timeout --kill-after=0.1s "$seconds" nova-shell "$@"
}

# The shell answers refusals on stdout with a zero exit, so the reply is the
# only way to spot a lock it can never perform. Nothing else needs inspecting:
# the status poll is what confirms success, and re-requesting is idempotent, so
# a request that may not have landed costs nothing to repeat.
request_lock() {
  case $(lock_ipc "$lock_timeout_ms" lock lock 2>/dev/null || true) in
    missing-pam) report_unsecured "no lock screen is configured" ;;
  esac
}

# secure: done. locking: the shell has the request and is working on it, so
# leave it alone. Anything else, unreadable replies included, means ask again.
lock_state() {
  jq -r 'if .secure == true then "secure"
         elif .requested == true then "locking"
         else "idle" end' \
    <<<"$(lock_ipc "$status_timeout_ms" lock status 2>/dev/null || true)" 2>/dev/null || true
}

sync_clamshell() {
  # Lid transitions can temporarily stall Hyprland IPC. This is best-effort:
  # the lid binding and monitor watcher also reconcile clamshell state.
  timeout --kill-after=0.1s 0.4s \
    nova-hyprland-monitor-clamshell >/dev/null 2>&1 || true
}

# Bounded like the lock calls: Hyprland's IPC is what stalls under load.
blank() {
  timeout --kill-after=0.1s 0.4s nova-brightness-display off >/dev/null 2>&1 || true
}

last_blank_ms=0
blank_while_waiting() {
  local now=$((10#${EPOCHREALTIME//[!0-9]/} / 1000))
  ((resumed || now - started_ms >= blank_after_ms)) || return 0
  ((now - last_blank_ms >= blank_every_ms)) || return 0
  last_blank_ms=$now
  blank
}

# Secure: the screens it turned off come back, on the lock screen.
secured() {
  ((!resumed)) || rm -f -- "$unsecured"
  if ((resumed || last_blank_ms > 0)); then
    timeout --kill-after=0.1s 1s nova-brightness-display on >/dev/null 2>&1 || true
  fi
  exit 0
}

# Woken, its clock has jumped by however long the machine slept: the time
# left starts again from the wake.
last_poll_ms=$started_ms
after_sleep() {
  local now=$((10#${EPOCHREALTIME//[!0-9]/} / 1000))
  if ((resumed && now - last_poll_ms > 5000)); then
    deadline_ms=$((now + budget_ms))
    last_blank_ms=0
  fi
  last_poll_ms=$now
}

# logind suspends whether or not this wait succeeded, so a failure here means
# the machine slept with the session exposed, though with the screens off and
# the lock asked for again as it wakes (--resumed). The notification lands on
# the screen they unlock into.
report_unsecured() {
  printf 'nova-system-sleep-lock: suspending without a secure lock (%s)\n' \
    "$1" >&2
  if ((resumed)); then
    rm -f -- "$unsecured"
    exit 1
  fi
  mkdir -p -- "${unsecured%/*}"
  : >"$unsecured"
  blank

  nova-notification-send -u critical -g 󰌾 \
    "Screen did not lock before suspend" \
    "The screens stayed off until it locked ($1)." >/dev/null 2>&1 || true

  exit 1
}

# Request the lock before touching monitor state, so a stuck Hyprland IPC call
# cannot consume the window before Quickshell has begun securing the session.
request_lock
sync_clamshell

# The trailing sleep can overshoot the deadline by one interval, which is well
# inside the reserve derive_budget_ms already held back for logind.
while after_sleep && (($(remaining_ms) > 0)); do
  case $(lock_state) in
    secure) secured ;;
    locking) ;;
    *) request_lock ;;
  esac
  blank_while_waiting

  sleep "$poll_interval"
done

report_unsecured "the shell did not secure the session within ${budget_ms}ms"
