#!/bin/bash

# nova:summary=Pick a screen region over frozen screen content
# nova:args=[region|windows|smart|fullscreen] [--keep-freeze] [--match-monitor] | --take-fullscreen | --take-window | --select-window <next|prev|left|right|up|down>
# nova:hidden=true

# The picker that screenshots and screen recordings share, so that both pick
# alike. It prints the region picked as slurp does, "X,Y WxH", and exits 1
# when the pick is given up.
#
#   region          drawn freely
#   windows         a monitor or a window, as slurp offers them
#   smart           drawn freely, the monitor and windows offered; a click (an
#                   area under 20 square pixels) takes the one under it
#   fullscreen      the focused monitor, without asking
#
#   --keep-freeze   the screen stays frozen (hyprpicker), its PID printed on a
#                   line before the region (empty when nothing froze it); the
#                   caller ends it
#   --match-monitor "monitor:NAME" instead, for a region that is a monitor
#
# While slurp is up, its keys (data/hypr/keys/desktop.lua) run this again:
# --take-window and --take-fullscreen end the pick with the highlighted window
# or the screen, --select-window moves the highlight to another window.

set -euo pipefail

state=${XDG_RUNTIME_DIR:-/tmp}/nova
take_fullscreen=$state/capture-region-fullscreen
take_window=$state/capture-region-window
mkdir -p "$state"

# A region, "X,Y WxH". X and Y are below 0 on a monitor left of or above the
# first.
region='^(-?[0-9]+),(-?[0-9]+)[[:space:]]([0-9]+)x([0-9]+)$'

# A monitor's region in logical pixels, its width and height swapped when it
# is turned a quarter round.
# shellcheck disable=SC2016 # jq's own variables
geo='def geo:
  (.width / .scale | floor) as $w | (.height / .scale | floor) as $h
  | if .transform == 1 or .transform == 3 then "\(.x),\(.y) \($h)x\($w)" else "\(.x),\(.y) \($w)x\($h)" end;'

# What slurp is shown, a region a line after what it is: "focused" the focused
# monitor; "monitor" the monitors on the focused workspace (that one); "window"
# the windows there, but for those out of sight in a group, and one for those
# at the same place: slurp could not tell them apart, and TAB would stop on the
# first. Without a workspace in focus it fails; without Hyprland it fails as
# hyprctl does.
layout() {
  # shellcheck disable=SC2016 # jq's own variables
  { hyprctl monitors -j; hyprctl clients -j; } | jq -rs "$geo"'
    if length == 0 then empty else
      .[0] as $monitors | (.[1] // []) as $clients
      | [$monitors[] | select(.focused == true) | .activeWorkspace.id]
      | if length == 1 and (.[0] | type) == "number" then .[0] else error("no workspace in focus") end
      | . as $workspace
      | ($monitors[] | select(.focused == true) | "focused " + geo),
        ($monitors[] | select(.activeWorkspace.id == $workspace) | "monitor " + geo),
        ([$clients[] | select(.workspace.id == $workspace and .hidden != true) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"]
          | unique[] | "window " + .)
    end'
}

# Of a layout on stdin, the regions of these kinds, in its order.
only() { # kind...
  local kind rect want
  while read -r kind rect; do
    for want; do
      if [[ $kind == "$want" ]]; then printf '%s\n' "$rect"; fi
    done
  done
}

focused_geo() {
  hyprctl monitors -j | jq -r "$geo"' .[] | select(.focused == true) | geo'
}

# Of the regions given, the one slurp highlights at a point, in $found: the
# smallest there (a floating window over a tiled one, a window over its
# monitor), the first of those the same size. 1 when none is there. A variable
# rather than output, so that the probing below starts no process.
smallest_at() { # x y region...
  local x=$1 y=$2 rect area smallest=0
  shift 2
  found=""
  for rect; do
    [[ $rect =~ $region ]] || continue
    ((x >= BASH_REMATCH[1] && x < BASH_REMATCH[1] + BASH_REMATCH[3] && y >= BASH_REMATCH[2] && y < BASH_REMATCH[2] + BASH_REMATCH[4])) || continue
    area=$((BASH_REMATCH[3] * BASH_REMATCH[4]))
    if [[ -z $found ]] || ((area < smallest)); then
      found=$rect
      smallest=$area
    fi
  done
  [[ -n $found ]]
}

# What slurp highlights under the pointer. It is shown the monitors too, so in
# a gap or over the bar that is the monitor.
at_pointer() {
  local pos layout
  local -a windows monitors
  pos=$(hyprctl cursorpos)
  layout=$(layout)
  mapfile -t windows < <(only window <<<"$layout")
  mapfile -t monitors < <(only monitor <<<"$layout")
  if smallest_at "${pos%,*}" "${pos#*, }" "${windows[@]}" || smallest_at "${pos%,*}" "${pos#*, }" "${monitors[@]}"; then
    echo "$found"
  else
    only focused <<<"$layout"
  fi
}

# A point of a window's own to warp the pointer to, in $warp. Its middle will
# not do when a smaller window covers it, as slurp would go on highlighting
# that one; the points nearest the middle are tried first. 1 when there is
# none, as hovering could not reach the window either.
warp_point() { # region
  [[ $1 =~ $region ]] || return 1
  local left=${BASH_REMATCH[1]} top=${BASH_REMATCH[2]} width=${BASH_REMATCH[3]} height=${BASH_REMATCH[4]}
  local probe x y
  for probe in "${probes[@]}"; do
    x=$((left + width * ${probe:0:1} / 8))
    y=$((top + height * ${probe:1:1} / 8))
    if smallest_at "$x" "$y" "${candidates[@]}" && [[ $found == "$1" ]]; then
      warp="$x $y"
      return 0
    fi
  done
  return 1
}

# Moves slurp's highlight to another window, by moving the pointer to it.
select_window() { # direction
  local direction=$1 pos from_x from_y windows rect probe fx fy current="" target="" at i count
  local x y ahead aside score best=""
  local -a rings=() reachable=() ordered=()
  local -A warp_to
  pos=$(hyprctl cursorpos)
  from_x=${pos%,*}
  from_y=${pos#*, }
  windows=$(layout | only window)
  mapfile -t candidates <<<"$windows"

  # The points tried, in eighths of a window's width and height: by their
  # distance from the middle, and across then down at the same distance.
  for fx in {1..7}; do
    for fy in {1..7}; do
      rings[(fx - 4) ** 2 + (fy - 4) ** 2]+="$fx$fy "
    done
  done
  read -r -a probes <<<"${rings[*]}"

  # Only the windows hovering could reach take part.
  for rect in "${candidates[@]}"; do
    warp_point "$rect" || continue
    warp_to[$rect]=$warp
    reachable+=("$rect")
  done
  ((${#reachable[@]})) || exit 0

  # In reading order: down the screen, and left to right.
  while IFS=$'\t' read -r _ _ rect; do ordered+=("$rect"); done < <(
    for rect in "${reachable[@]}"; do
      if [[ $rect =~ $region ]]; then printf '%d\t%d\t%s\n' "${BASH_REMATCH[2]}" "${BASH_REMATCH[1]}" "$rect"; fi
    done | sort -n -k1,1 -k2,2
  )

  # From the window highlighted now, found as --take-window finds it, so that
  # the two never disagree; from its middle.
  if smallest_at "$from_x" "$from_y" "${candidates[@]}"; then current=$found; fi
  if [[ $current =~ $region ]]; then
    from_x=$((BASH_REMATCH[1] + BASH_REMATCH[3] / 2))
    from_y=$((BASH_REMATCH[2] + BASH_REMATCH[4] / 2))
  fi

  case $direction in
    next | prev)
      count=${#ordered[@]}
      at=-1
      for i in "${!ordered[@]}"; do
        if [[ -n $current && ${ordered[i]} == "$current" ]]; then
          at=$i
          break
        fi
      done
      if [[ $direction == next ]]; then
        target=${ordered[(at + 1) % count]}
      elif ((at == -1)); then
        target=${ordered[count - 1]}
      else
        target=${ordered[(at - 1 + count) % count]}
      fi
      ;;
    left | right | up | down)
      # The nearest that way, a step aside counting double.
      for rect in "${ordered[@]}"; do
        [[ $rect != "$current" && $rect =~ $region ]] || continue
        x=$((BASH_REMATCH[1] + BASH_REMATCH[3] / 2))
        y=$((BASH_REMATCH[2] + BASH_REMATCH[4] / 2))
        case $direction in
          left) ahead=$((from_x - x)) aside=$((y - from_y)) ;;
          right) ahead=$((x - from_x)) aside=$((y - from_y)) ;;
          up) ahead=$((from_y - y)) aside=$((x - from_x)) ;;
          down) ahead=$((y - from_y)) aside=$((x - from_x)) ;;
        esac
        ((ahead > 0)) || continue
        score=$((ahead + 2 * (aside < 0 ? -aside : aside)))
        if [[ -z $best ]] || ((score < best)); then
          best=$score
          target=$rect
        fi
      done
      ;;
    *) exit 1 ;;
  esac

  if [[ -n $target && -n ${warp_to[$target]:-} ]]; then
    read -r x y <<<"${warp_to[$target]}"
    hyprctl eval "hl.dispatch(hl.dsp.cursor.move({ x = $x, y = $y }))" >/dev/null
  fi
}

case ${1:-} in
  --take-fullscreen | --take-window)
    pgrep -x slurp >/dev/null || exit 0
    if [[ $1 == --take-fullscreen ]]; then touch "$take_fullscreen"; else touch "$take_window"; fi
    pkill -x slurp
    exit 0
    ;;
  --select-window)
    pgrep -x slurp >/dev/null || exit 0
    select_window "${2:-}"
    exit 0
    ;;
esac

mode=smart
keep_freeze=false
match_monitor=false
for arg; do
  case $arg in
    --keep-freeze) keep_freeze=true ;;
    --match-monitor) match_monitor=true ;;
    *) mode=$arg ;;
  esac
done

# slurp, given its options, and the regions it offers on stdin. --take-window
# and --take-fullscreen end it without an answer, leaving a mark for what they
# meant; a pick given up leaves none. It fails either way, so its status means
# nothing.
pick() {
  local picked
  rm -f "$take_fullscreen" "$take_window"
  picked=$(slurp "$@" 2>/dev/null || true)
  if [[ -z $picked && -e $take_fullscreen ]]; then
    rm -f "$take_fullscreen"
    picked=$(focused_geo)
  elif [[ -z $picked && -e $take_window ]]; then
    rm -f "$take_window"
    picked=$(at_pointer)
  fi
  printf '%s' "$picked"
}

# hyprpicker shows a still of the screen over it, so that what is picked holds
# still; it is given a moment to come up.
freezer=""
freeze() {
  hyprpicker -r -z >/dev/null 2>&1 &
  freezer=$!
  sleep .1
}
unfreeze() {
  if ! $keep_freeze && [[ -n $freezer ]]; then kill "$freezer" 2>/dev/null || true; fi
}
trap unfreeze EXIT

case $mode in
  region)
    freeze
    picked=$(pick)
    ;;
  windows)
    freeze
    picked=$(layout | only monitor window | pick -r)
    ;;
  fullscreen)
    picked=$(focused_geo)
    ;;
  *)
    # smart, as is anything else.
    rects=$(layout | only monitor window)
    freeze
    picked=$(echo "$rects" | pick)
    # A click takes the region under it, as slurp highlighted it: the window,
    # or the monitor beside every window. No captures of a pixel or two.
    if [[ $picked =~ $region ]] && ((BASH_REMATCH[3] * BASH_REMATCH[4] < 20)); then
      x=${BASH_REMATCH[1]} y=${BASH_REMATCH[2]}
      mapfile -t candidates <<<"$rects"
      if smallest_at "$x" "$y" "${candidates[@]}"; then picked=$found; fi
    fi
    ;;
esac

if $keep_freeze; then echo "$freezer"; fi

[[ -n $picked ]] || exit 1

if $match_monitor; then
  # shellcheck disable=SC2016 # jq's own variables
  monitor=$(hyprctl monitors -j | jq -r --arg picked "$picked" "$geo"' first(.[] | select(geo == $picked) | .name)')
  if [[ -n $monitor ]]; then
    echo "monitor:$monitor"
    exit 0
  fi
fi

echo "$picked"
