#!/bin/bash

# nova:summary=Push the current theme to Hyprland, GTK, terminals, editors and the greeter
# nova:args=[app...]
# nova:hidden=true
#
# Run by `nova-theme set` after the swap, and at session start; `nova-theme bg
# set` runs just the greeter. Each app is one function; they run in parallel and
# none of them needs root. An app that is not installed or not running is
# skipped.

# shellcheck disable=SC2329 # each apply_<app> is called by name below
set -euo pipefail

state=${XDG_STATE_HOME:-$HOME/.local/state}/nova
config_home=${XDG_CONFIG_HOME:-$HOME/.config}
theme=$state/current/theme
greeter=${NOVA_GREETER_DIR:-/var/lib/nova/greeter}

[[ -f $theme/colors.toml ]] || { echo "nova-theme-apply: no current theme" >&2; exit 1; }
mode=$(nova-theme color mode)

# An app of this session: started with this home and runtime folder. Another
# session of the user's (a test's, with a home of its own) has its own apps
# and its own theme, and is not reached from here, nor this one from it.
running() {
  nova-session-pgrep -x "$1" >/dev/null
}

# Points a config file at the rendered theme, unless the user put a real file
# there, which is theirs.
link_config() {
  local target=$1 link=$2
  [[ -e $link && ! -L $link ]] && return 0
  mkdir -p "$(dirname "$link")"
  ln -sfn "$target" "$link"
}

apply_hyprland() {
  [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] || return 0
  hyprctl reload >/dev/null
}

# True when GTK would find <kind>/<name>/<file> where it looks: ~/.<kind>
# (~/.icons, ~/.themes), then the data folders.
data_installed() { # kind name file
  local dir dirs
  IFS=: read -ra dirs <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  [[ -f $HOME/.$1/$2/$3 ]] && return 0
  for dir in "${dirs[@]}"; do
    [[ -f $dir/$1/$2/$3 ]] && return 0
  done
  return 1
}

# The palette goes to GTK as nova.css in ~/.config/gtk-3.0 and gtk-4.0, which
# gtk.css links to beside it: a Flatpak app, shown those two folders
# (apply_flatpak), finds it there, where a link into ~/.local/state would
# point at nothing it can see. A real gtk.css is the user's; it can
# @import url("nova.css") to keep the theme under its own rules.
gtk_css() { # rendered file, GTK's folder
  [[ -f $1 ]] || return 0
  mkdir -p "$2"
  cp -- "$1" "$2/.nova.css.tmp"
  mv -f -- "$2/.nova.css.tmp" "$2/nova.css"
  link_config nova.css "$2/gtk.css"
}

# Adwaita's folders are blue whatever the theme. Nova, an icon theme of the
# user's own, inherits Adwaita and has its folders (and the places beside
# them) in the theme's accent: the SVGs copied through adwaita-folders.sed,
# which the theme renders. Made again on each theme change.
accent_icons() {
  local dir adwaita='' out svg
  local -a dirs
  [[ -f $theme/adwaita-folders.sed ]] || return 1
  IFS=: read -ra dirs <<<"${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  for dir in "${dirs[@]}"; do
    [[ -d $dir/icons/Adwaita/scalable/places ]] && { adwaita=$dir/icons/Adwaita; break; }
  done
  [[ -n $adwaita ]] || return 1
  out=${XDG_DATA_HOME:-$HOME/.local/share}/icons
  rm -rf -- "$out/.Nova.tmp"
  mkdir -p "$out/.Nova.tmp/scalable/places" "$out/.Nova.tmp/scalable/mimetypes"
  for svg in "$adwaita"/scalable/places/*.svg "$adwaita"/scalable/mimetypes/inode-directory.svg; do
    [[ -f $svg ]] || continue
    sed -f "$theme/adwaita-folders.sed" "$svg" >"$out/.Nova.tmp/${svg#"$adwaita"/}"
  done
  cat >"$out/.Nova.tmp/index.theme" <<'THEME'
[Icon Theme]
Name=Nova
Comment=Adwaita, with its folders in the theme's accent
Inherits=Adwaita
Directories=scalable/mimetypes,scalable/places

[scalable/mimetypes]
Context=MimeTypes
Size=128
MinSize=8
MaxSize=512
Type=Scalable

[scalable/places]
Context=Places
Size=128
MinSize=8
MaxSize=512
Type=Scalable
THEME
  # Nova's cursor theme is named Nova too (/usr/share/icons/Nova): linked in
  # here, its cursors are found in this folder, where Hyprland's XCursor
  # loader, which takes the folders in name order, would otherwise take
  # Adwaita's, which this inherits, before them.
  for dir in "${dirs[@]}"; do
    [[ -d $dir/icons/Nova/cursors ]] && { ln -s -- "$dir/icons/Nova/cursors" "$out/.Nova.tmp/cursors"; break; }
  done
  rm -rf -- "$out/Nova"
  mv -- "$out/.Nova.tmp" "$out/Nova"
}

# GTK reads the palette as an app starts. libadwaita, and GTK 4 without it,
# follow color-scheme at once: gtk4.css holds its colors to the theme's own
# light or dark. GTK 3 apps draw with adw-gtk3, libadwaita's look made for
# GTK 3, which takes its colors from the names gtk3.css sets; GTK 3's own
# Adwaita has its colors built in, and no dark variant without
# gnome-themes-extra. Flatpak apps fetch the adw-gtk3 that matches, an
# org.gtk.Gtk3theme extension, as they are installed or updated. A theme's
# icons.theme names the icon set it was made with (Yaru's colours, from the
# AUR); without that set installed, Adwaita, which GTK itself depends on. No
# window has title-bar buttons: an empty button-layout clears them from GTK,
# libadwaita and Chrome alike. X11 apps get all of this as XSETTINGS
# (nova-hyprland-x11-scale).
apply_gtk() {
  gtk_css "$theme/gtk4.css" "$config_home/gtk-4.0"
  gtk_css "$theme/gtk3.css" "$config_home/gtk-3.0"
  [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]] || return 0
  local icons=Adwaita gtk_theme=adw-gtk3
  [[ ! -f $theme/icons.theme ]] || icons=$(<"$theme/icons.theme")
  data_installed icons "$icons" index.theme || icons=Adwaita
  if [[ $icons == Adwaita ]] && accent_icons; then icons=Nova; fi
  data_installed themes "$gtk_theme" gtk-3.0/gtk.css || gtk_theme=Adwaita
  if [[ $mode == light ]]; then
    gsettings set org.gnome.desktop.interface color-scheme prefer-light
    gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme"
  else
    gsettings set org.gnome.desktop.interface color-scheme prefer-dark
    gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme-dark"
  fi
  gsettings set org.gnome.desktop.interface icon-theme "$icons"
  gsettings set org.gnome.desktop.wm.preferences button-layout ':'
  [[ -z ${DISPLAY:-} ]] || nova-hyprland-x11-scale || true
}

# The file chooser and the other dialogs of the system are drawn by
# xdg-desktop-portal-gtk, in GTK 3, and it stays running between them with the
# theme it started with. Started again, by D-Bus, the next time one is wanted;
# not while one of its windows is open, which that would close: that one keeps
# the old theme until the next change. The restart is queued, after apply_gtk
# (gtk_then_portal, below), and nothing waits for it.
apply_portal() {
  [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]] || return 0
  if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] &&
    hyprctl -j clients 2>/dev/null | jq -e 'any(.[]; .class == "xdg-desktop-portal-gtk")' >/dev/null 2>&1; then
    return 0
  fi
  systemctl --user --no-block try-restart xdg-desktop-portal-gtk.service 2>/dev/null || true
}

# Flatpak apps are shown ~/.config/gtk-3.0 and gtk-4.0, read-only, for the
# palette in them, by an override of the user's for every app; set once. A
# choice of the user's about either folder (`flatpak override --user
# --nofilesystem=xdg-config/gtk-4.0`) is theirs.
apply_flatpak() {
  command -v flatpak >/dev/null || return 0
  local global=${FLATPAK_USER_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/flatpak}/overrides/global folder
  local -a show=()
  for folder in xdg-config/gtk-3.0 xdg-config/gtk-4.0; do
    grep -qsF "$folder" "$global" || show+=("--filesystem=$folder:ro")
  done
  (( ${#show[@]} == 0 )) || flatpak override --user "${show[@]}"
}

# New terminals read foot.ini; running ones get the palette as OSC sequences on
# their ptys.
apply_foot() {
  link_config "$theme/foot.ini" "$config_home/foot/theme.ini"
  running foot || return 0
  local osc pid child tty i
  declare -A c=()
  while IFS=$'\t' read -r key value; do c[$key]=$value; done < <(nova-theme color --all)
  osc=$(printf '\e]10;%s\a\e]11;%s\a\e]12;%s\a\e]17;%s\a\e]19;%s\a' \
    "${c[foreground]}" "${c[background]}" "${c[cursor]}" "${c[selection_background]}" "${c[selection_foreground]}")
  for i in {0..15}; do
    osc+=$(printf '\e]4;%d;%s\a' "$i" "${c[color$i]}")
  done
  for pid in $(nova-session-pgrep -x foot || true); do
    for child in $(pgrep -P "$pid" || true); do
      tty=$(readlink "/proc/$child/fd/1" 2>/dev/null || true)
      if [[ $tty == /dev/pts/* && -w $tty ]]; then printf '%s' "$osc" >"$tty"; fi
    done
  done
}

apply_btop() {
  link_config "$theme/btop.theme" "$config_home/btop/themes/nova.theme"
  running btop || return 0
  nova-session-pgrep --signal USR2 -x btop || true
}

# VS Code cannot place Hyprland, so it finds no keyring and offers to keep its
# sign-ins under a key of its own instead; like Chrome, it is told the login
# keyring is gnome-keyring's. argv.json, which it reads that from, is JSON with
# comments, which jq cannot read, so the setting goes in as a line of its own
# after the brace. One the user set (basic, kwallet6) is theirs.
vscode_keyring() {
  local argv=$HOME/.vscode/argv.json file tmp
  if [[ ! -e $argv ]]; then
    printf '{\n\t"password-store": "gnome-libsecret",\n\t"enable-crash-reporter": false\n}\n' >"$argv.tmp"
    mv -- "$argv.tmp" "$argv"
    return 0
  fi
  grep -vE '^[[:space:]]*//' "$argv" | grep -E '"password-store"[[:space:]]*:' >/dev/null && return 0
  file=$(readlink -f -- "$argv") || return 0
  tmp=$(mktemp "$file.XXXXXX") || return 0
  if sed '0,/^[[:space:]]*{/s//&\n\t"password-store": "gnome-libsecret",/' "$file" >"$tmp" && ! cmp -s "$file" "$tmp"; then
    chmod --reference="$file" -- "$tmp"
    mv -- "$tmp" "$file"
  else
    rm -f -- "$tmp"
    echo "nova-theme-apply: VS Code's argv.json has no opening brace, so its keyring is not set" >&2
  fi
}

# A local VS Code extension whose theme file is the rendered one. VS Code picks
# up a changed theme file on its own once the extension is registered. The
# native title bar is the compositor's, and Hyprland draws none, so VS Code has
# no buttons either; Alt shows its menu.
apply_vscode() {
  local extensions=$HOME/.vscode/extensions ext settings
  [[ -d $HOME/.vscode ]] || return 0
  vscode_keyring
  [[ -d $extensions ]] || return 0
  ext=$extensions/nova.nova-theme-1.0.0
  mkdir -p "$ext/themes"
  ln -sfn "$theme/vscode-theme.json" "$ext/themes/nova.json"
  cat >"$ext/package.json" <<JSON
{
  "name": "nova-theme",
  "displayName": "Nova",
  "publisher": "nova",
  "version": "1.0.0",
  "engines": { "vscode": "^1.70.0" },
  "contributes": {
    "themes": [{ "label": "Nova", "uiTheme": "$([[ $mode == light ]] && echo vs || echo vs-dark)", "path": "./themes/nova.json" }]
  }
}
JSON
  [[ -f $extensions/extensions.json ]] || printf '[]\n' >"$extensions/extensions.json"
  # A file that does not parse is left alone, and the other apps still get
  # the theme.
  # shellcheck disable=SC2016 # $path is jq's
  jq_in_place "$extensions/extensions.json" --arg path "$ext" '
    map(select(.identifier.id != "nova.nova-theme")) + [{
      identifier: { id: "nova.nova-theme" },
      version: "1.0.0",
      location: { "$mid": 1, fsPath: $path, path: $path, scheme: "file" },
      relativeLocation: "nova.nova-theme-1.0.0"
    }]' ||
    echo "nova-theme-apply: VS Code's extensions.json does not parse, so its theme is not registered" >&2

  settings=$config_home/Code/User/settings.json
  if [[ -f $settings ]]; then
    jq_in_place "$settings" '."workbench.colorTheme" = "Nova" | ."window.titleBarStyle" = "native" |
      ."window.customTitleBarVisibility" = "never"' ||
      echo "nova-theme-apply: VS Code's settings.json does not parse, so its theme is not set" >&2
  fi
}

# Runs a jq filter over a file in place. The temporary file sits beside the
# real file, so the mv is an atomic rename; a symlink (a dotfiles repository)
# stays a symlink, and the file keeps its mode. Fails, changing nothing, when
# the file does not parse.
jq_in_place() { # file jq-arguments...
  local file tmp
  file=$(readlink -f -- "$1") || return 1
  shift
  tmp=$(mktemp "$file.XXXXXX") || return 1
  if jq "$@" "$file" >"$tmp" 2>/dev/null; then
    chmod --reference="$file" -- "$tmp"
    mv -- "$tmp" "$file"
  else
    rm -f -- "$tmp"
    return 1
  fi
}

apply_claude() {
  local dir=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
  [[ -d $dir ]] || return 0
  mkdir -p "$dir/themes"
  cp "$theme/claude.json" "$dir/themes/nova.json.tmp"
  mv "$dir/themes/nova.json.tmp" "$dir/themes/nova.json"
}

# T3 Code (0.1.11) watches its themes folder, and open windows show the theme
# its settings name as defaultTheme. A theme file has one appearance, light or
# dark, and may give the other as a variant. T3 Code is light, dark or system,
# and system follows the desktop's color-scheme (the settings portal) live, as
# Nova sets it with each theme. Where a window shows an appearance the theme
# lacks, as in system mode with the theme picked for light and for dark, it
# shows T3 Code's stock colors instead. So Nova's theme has both appearances,
# and both are the same palette: whatever T3 Code shows is the theme's colors,
# and they change in one step, whether the file or the color-scheme arrives
# first. A variant goes over T3 Code's stock colors, not over the palette it
# derives from canvas and accent, so the template fills every role.
#
# Settings it lacks are set: defaultTheme, and, once, defaultAppearance
# "system" with the time, which each window applies once, as `t3 theme set`
# does; a mode the user picks afterwards stays theirs. Nothing here waits for
# T3 Code or fails the theme change: a T3 Code not installed, not running or
# with settings that do not parse is passed by. The file is a copy, as T3 Code
# skips a theme that is a symlink.
apply_t3code() {
  local dir=${T3CODE_HOME:-$HOME/.t3}/userdata now
  [[ -d $dir && -f $theme/t3code.json ]] || return 0
  mkdir -p "$dir/themes" 2>/dev/null || return 0
  jq '.variants = {(if .appearance == "light" then "dark" else "light" end): .colors}' \
    "$theme/t3code.json" >"$dir/themes/nova.json.tmp" 2>/dev/null &&
    mv -f "$dir/themes/nova.json.tmp" "$dir/themes/nova.json" ||
    { rm -f "$dir/themes/nova.json.tmp"; return 0; }
  now=$(date -u +%Y-%m-%dT%H:%M:%S.%3NZ)
  if [[ ! -e $dir/settings.json ]]; then
    printf '{\n  "defaultTheme": "nova",\n  "defaultAppearance": "system",\n  "defaultAppearanceSetAt": "%s"\n}\n' \
      "$now" 2>/dev/null >"$dir/settings.json" || true
  elif ! jq -e '.defaultTheme == "nova" and (.defaultAppearance // "") != ""' "$dir/settings.json" >/dev/null 2>&1; then
    # shellcheck disable=SC2016 # $now is jq's
    jq_in_place "$dir/settings.json" --arg now "$now" '.defaultTheme = "nova" |
      if (.defaultAppearance // "") == "" then .defaultAppearance = "system" | .defaultAppearanceSetAt = $now else . end' ||
      echo "nova-theme-apply: T3 Code's settings.json does not parse, so its theme is not set" >&2
  fi
  return 0
}

# The greeter runs before any user is logged in, so it reads a world-readable
# mirror. nova-browser-theme.path (root) turns the mirrored chromium.theme into
# Chrome's color policy; Chrome reloads policy files on its own. Both belong to
# the computer, so only the account's own home writes them: a session in a
# home of its own (a test's) has a theme that is nobody's login screen.
# Every file is mirrored readable by all, whatever its own mode or the umask:
# a photo kept 0600 (a download, one sent by AirDrop), copied as it is, would
# leave the greeter's user a flat colour.
mirror() { # <source> <name>
  install -m 644 -- "$1" "$greeter/.$2.tmp"
  mv -- "$greeter/.$2.tmp" "$greeter/$2"
}

apply_greeter() {
  [[ -d $greeter && -w $greeter ]] || return 0
  [[ $HOME == "$(getent passwd "$UID" | cut -d: -f6)" ]] || return 0
  local file background
  for file in colors.toml shell.toml chromium.theme; do
    [[ -f $theme/$file ]] || continue
    mirror "$theme/$file" "$file"
  done
  background=$(readlink -f "$state/current/background")
  if [[ -f $background ]]; then
    mirror "$background" background
  fi
  # The lock's backdrop of it (nova-theme), which the greeter draws in its
  # first frame; without one it blurs the background itself, never another's.
  if [[ -f $state/current/backdrop.ppm ]]; then
    mirror "$state/current/backdrop.ppm" backdrop.ppm
  else
    rm -f "$greeter/backdrop.ppm"
  fi
}

apps=(hyprland gtk portal flatpak foot btop vscode claude t3code greeter)
if (( $# > 0 )); then
  for app in "$@"; do
    [[ " ${apps[*]} " == *" $app "* ]] || { echo "nova-theme-apply: unknown app '$app' (${apps[*]})" >&2; exit 2; }
  done
  apps=("$@")
fi

# The GTK portal also hands color-scheme on to apps (the settings portal,
# which Chrome, T3 Code and libadwaita read), and a change made while it
# starts again reaches none of them: none of 16 within its first 25 ms, in a
# bus of its own. So it starts again after GTK has the new one, not beside it.
gtk_then_portal() {
  local status=0
  apply_gtk & wait "$!" || status=1
  apply_portal & wait "$!" || status=1
  return "$status"
}

pids=()
for app in "${apps[@]}"; do
  if [[ $app == portal && " ${apps[*]} " == *" gtk "* ]]; then
    continue
  elif [[ $app == gtk && " ${apps[*]} " == *" portal "* ]]; then
    gtk_then_portal &
  else
    "apply_$app" &
  fi
  pids+=("$!")
done

failed=0
for pid in "${pids[@]}"; do
  wait "$pid" || failed=1
done
exit "$failed"
