#!/bin/bash

# nova:summary=Set the default audio input and move active streams
# nova:args=<node-id> <source-name>

set -euo pipefail

node_id=${1:-}
source_name=${2:-}

if [[ -z $node_id || -z $source_name ]]; then
  echo "Usage: nova-audio-input-set-default <node-id> <source-name>" >&2
  exit 1
fi

# Best effort: either tool may be missing or racing a device that just vanished,
# and one succeeding is enough.
wpctl set-default "$node_id" 2>/dev/null || true
pactl set-default-source "$source_name" 2>/dev/null || true

while read -r output; do
  pactl move-source-output "$output" "$source_name" 2>/dev/null || true
done < <(pactl list short source-outputs 2>/dev/null | awk '{ print $1 }')
