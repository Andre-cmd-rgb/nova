#!/bin/bash

# nova:summary=Returns true when the compositor holds a session lock no other locker is alive to own
# nova:args=<own-pid>
# nova:hidden=true

set -euo pipefail

# Hyprland hands a held lock to any client that asks
# (misc:allow_session_lock_restore), so a shell taking back every lock it sees
# could take another shell's live lock screen, and strand it on exit. A lock is
# stranded only once no other Quickshell or hyprlock runs; until then the
# answer is "cannot tell", and the caller asks again until that locker exits or
# it gives up.
#
# Exits 0 stranded, 1 unlocked, 2 when it cannot be told. The caller passes its
# own pid: a shell that crashed starts again in the same process. NOVA_PROC
# stands in for /proc in the tests.
if [[ -z ${1:-} ]]; then
  echo "Usage: nova-hyprland-session-lock-stranded <own-pid>" >&2
  exit 2
fi
own=$1
proc=${NOVA_PROC:-/proc}

# Unlocked, and cannot tell, are the answer as they are.
nova-hyprland-session-locked || exit

# A Quickshell that only speaks to a shell holds no lock: nova-shell's `qs
# ipc`, a moment at every key and every poll (nova-restart-shell asks ten
# times a second while the new shell starts), and the tools' kill, list and
# log. Counted as lockers, they kept a stranded lock from being taken back
# while they ran. One whose command line cannot be read is counted.
shell_client() { # pid
  local arg
  local -a argv=()
  { mapfile -d '' -t argv <"$proc/$1/cmdline"; } 2>/dev/null || return 1
  for arg in "${argv[@]:1}"; do
    case $arg in ipc | msg | kill | list | log) return 0 ;; esac
  done
  return 1
}

while read -r pid; do
  [[ $pid == "$own" ]] || shell_client "$pid" || exit 2
done < <(nova-session-pgrep -x 'quickshell|qs|hyprlock')
