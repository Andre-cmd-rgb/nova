#!/bin/bash

# nova:summary=Take a screenshot
# nova:args=[smart|region|windows|fullscreen] [slurp|copy|save] [--editor=<name>]
# nova:aliases=screenshot

set -euo pipefail

# Into Pictures, or the directory the user's XDG settings name for it.
if [[ -f ~/.config/user-dirs.dirs ]]; then
  # shellcheck disable=SC1090,SC1091
  source ~/.config/user-dirs.dirs
fi
dir=${NOVA_SCREENSHOT_DIR:-${XDG_PICTURES_DIR:-$HOME/Pictures}}
if [[ ! -d $dir ]]; then
  mkdir -p "$dir"
  nova-notification-send "Created screenshot directory: $dir" -t 2000
fi

# PRINT pressed again while the picker is up puts it away.
if pkill slurp; then
  exit 0
fi

# The mode and what to do with it, with --editor=<name> anywhere among them.
editor=${NOVA_SCREENSHOT_EDITOR:-satty}
args=()
for arg; do
  case $arg in
    --editor=*) editor=${arg#--editor=} ;;
    *) args+=("$arg") ;;
  esac
done
mode=${args[0]:-smart}
action=${args[1]:-slurp}

# Where Hyprland draws the cursor itself (a GPU without working hardware
# cursors), it is in every frame grim takes; so hardware cursors until the
# screenshot is taken, and the setting as it was after.
no_hardware_cursors=$(hyprctl getoption cursor:no_hardware_cursors -j | jq '.int')
cursors() { # 0|1
  hyprctl eval "hl.config({ cursor = { no_hardware_cursors = $1 } })" &>/dev/null ||
    hyprctl keyword cursor:no_hardware_cursors "$1" &>/dev/null ||
    true
}

# The picker leaves the screen frozen, its PID on the first line, so that
# grim takes the still and not the screen moving as the freeze ends.
freezer=""
picked=""
restore() {
  if [[ -n $freezer ]]; then kill "$freezer" 2>/dev/null || true; fi
  cursors "$no_hardware_cursors"
}
trap restore EXIT

cursors 0

# A pick given up prints the PID alone, or nothing.
{
  read -r freezer || true
  read -r picked || true
} < <(nova-capture-region "$mode" --keep-freeze)
[[ -n $picked ]] || exit 0

file=$dir/screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png

case $action in
  slurp)
    grim -g "$picked" "$file" || exit 1
    echo "$file"
    wl-copy --type image/png <"$file"
    # It is saved and on the clipboard by now, so a notification that fails
    # does not make the screenshot one.
    nova-notification-send "Screenshot saved to clipboard and file" "Edit with Super + Alt + , (or click this)" \
      --image "$file" \
      --exec nova-image-edit "$file" "$editor" || true
    ;;
  copy)
    grim -g "$picked" - | wl-copy --type image/png
    ;;
  save)
    grim -g "$picked" "$file" || exit 1
    echo "$file"
    ;;
  *)
    echo "Usage: nova-capture-screenshot [smart|region|windows|fullscreen] [slurp|copy|save] [--editor=<name>]" >&2
    exit 1
    ;;
esac
