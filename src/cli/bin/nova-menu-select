#!/bin/bash

# nova:summary=Pick one option from a menu
# nova:name=select
# nova:args=prompt [option...] [-- menu args...]

# An option is a label, or "<glyph><TAB><label>" for one with an icon, or
# "<glyph><TAB><label><TAB><subtext>" for one with a line under it too. The
# glyph is shown but never given back: the pick prints the label, and for an
# option with a subtext "<label><TAB><subtext>", so that rows with the same
# label can be told apart by it. The options come from stdin when none are
# given. After --, --width and --height (or --maxheight) size the menu.

set -euo pipefail

usage() {
  echo "Usage: nova-menu-select <prompt> [option...] [-- menu args...]" >&2
  exit 1
}

(($#)) || usage
prompt=$1
shift

options=()
while (($#)) && [[ $1 != -- ]]; do
  options+=("$1")
  shift
done
width=""
height=""
if (($#)); then
  shift
  while (($#)); do
    case $1 in
      --width | --height | --maxheight)
        if (($# < 2)); then
          echo "nova-menu-select: $1 requires a value" >&2
          exit 1
        fi
        if [[ $1 == --width ]]; then width=$2; else height=$2; fi
        shift
        ;;
    esac
    shift
  done
fi

if ((${#options[@]} == 0)) && [[ ! -t 0 ]]; then
  mapfile -t options
fi
((${#options[@]})) || usage

# A size in whole pixels: the number it starts with, or 0 when it starts with
# none.
whole() {
  if [[ $1 =~ ^[[:space:]]*([+-]?)([0-9]+) ]]; then
    echo $((${BASH_REMATCH[1]:-+}10#${BASH_REMATCH[2]}))
  else
    echo 0
  fi
}

# The shell writes the pick to one file, and makes the other as the menu
# closes.
picked=$(mktemp)
closed=$(mktemp)
rm -f "$closed"
trap 'rm -f "$picked" "$closed"' EXIT

# shellcheck disable=SC2016 # jq's own variables
payload=$(jq -cn --arg prompt "$prompt" --arg picked "$picked" --arg closed "$closed" \
  --arg width "${width:+$(whole "$width")}" --arg height "${height:+$(whole "$height")}" '
  {mode: "select", prompt: $prompt, options: $ARGS.positional, selectionFile: $picked, doneFile: $closed}
  + if $width == "" then {} else {width: ($width | tonumber)} end
  + if $height == "" then {} else {maxHeight: ($height | tonumber)} end' --args "${options[@]}")
nova-shell shell summon nova.menu "$payload" >/dev/null

# Nothing will close the menu if the shell that opened it goes away (it
# crashed, or was restarted), so that is looked for every two seconds. With no
# shell to be seen at the start, there is no telling, and it waits.
shells=$(pgrep -u "$UID" -x 'qs|quickshell' || true)
shell_gone() {
  local pid
  [[ -n $shells ]] || return 1
  for pid in $shells; do
    if kill -0 "$pid" 2>/dev/null; then return 1; fi
  done
  return 0
}
# The wait is a read that never gets a line, from a pipe this holds both ends
# of: a builtin, where sleep would be a process twenty times a second.
exec {never}<> <(:)
for ((checks = 1; ; checks++)); do
  [[ ! -e $closed ]] || break
  read -rt 0.05 -u "$never" _ || true
  if ((checks % 40 == 0)) && shell_gone; then exit 1; fi
done

[[ -s $picked ]] || exit 1
cat "$picked"
