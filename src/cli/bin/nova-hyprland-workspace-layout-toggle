#!/bin/bash

# nova:summary=Toggle this workspace between the dwindle and scrolling layouts

set -euo pipefail

read -r workspace layout < <(hyprctl activeworkspace -j | jq -r '[.id, .tiledLayout] | @tsv')
# The id goes into Lua below, so only a number passes: special workspaces have
# negative ones.
[[ $workspace =~ ^-?[0-9]+$ ]] || exit 1

if [[ $layout == dwindle ]]; then layout=scrolling; else layout=dwindle; fi
rule="hl.workspace_rule({ workspace = \"$workspace\", layout = \"$layout\" })"

# Kept as a rule of its own, which the config loads again at every reload
# (data/hypr/toggles.lua), and applied now.
mkdir -p "$HOME/.local/state/nova/workspace-layouts"
printf '%s\n' "$rule" >"$HOME/.local/state/nova/workspace-layouts/$workspace.lua"

hyprctl eval "$rule" >/dev/null 2>&1 ||
  hyprctl keyword workspace "$workspace, layout:$layout" >/dev/null
nova-notification-send -g 󱂬 "Workspace layout set to $layout"
