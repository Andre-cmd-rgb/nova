#!/bin/bash

# nova:summary=Toggle this workspace between the dwindle and scrolling layouts

set -euo pipefail

read -r ACTIVE_WORKSPACE CURRENT_LAYOUT < <(hyprctl activeworkspace -j | jq -r '[.id, .tiledLayout] | @tsv')
[[ $ACTIVE_WORKSPACE =~ ^-?[0-9]+$ ]] || exit 1
LAYOUTS_DIR="$HOME/.local/state/nova/workspace-layouts"
LAYOUT_FILE="$LAYOUTS_DIR/$ACTIVE_WORKSPACE.lua"

case "$CURRENT_LAYOUT" in
  dwindle) NEW_LAYOUT=scrolling ;;
  *) NEW_LAYOUT=dwindle ;;
esac

mkdir -p "$LAYOUTS_DIR"
printf 'hl.workspace_rule({ workspace = "%s", layout = "%s" })\n' "$ACTIVE_WORKSPACE" "$NEW_LAYOUT" >"$LAYOUT_FILE"

hyprctl eval "hl.workspace_rule({ workspace = \"$ACTIVE_WORKSPACE\", layout = \"$NEW_LAYOUT\" })" >/dev/null 2>&1 ||
  hyprctl keyword workspace "$ACTIVE_WORKSPACE, layout:$NEW_LAYOUT" >/dev/null
nova-notification-send -g 󱂬 "Workspace layout set to $NEW_LAYOUT"
