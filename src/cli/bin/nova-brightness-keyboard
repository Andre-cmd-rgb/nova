#!/bin/bash

# nova:summary=Step the keyboard backlight up, down or round, or turn it off and back on
# nova:args=[--no-osd] <up|down|cycle|off|restore|device>

set -euo pipefail

osd=true
if [[ ${1:-} == --no-osd ]]; then
  osd=false
  shift
fi
direction=${1:-up}
case $direction in
  up | down | cycle | off | restore | device) ;;
  *)
    echo "Usage: nova-brightness-keyboard [--no-osd] <up|down|cycle|off|restore|device>" >&2
    exit 1
    ;;
esac

# The keyboard's light: the first LED named so, such as tpacpi::kbd_backlight.
# NOVA_LEDS_PATH is for the tests.
device=""
for led in "${NOVA_LEDS_PATH:-/sys/class/leds}"/*kbd_backlight*; do
  if [[ -e $led ]]; then
    device=${led##*/}
    break
  fi
done
if [[ -z $device ]]; then
  echo "No keyboard backlight device found" >&2
  exit 1
fi

case $direction in
  # Its name, for the shell, whose nova.keys service takes the keyboard
  # light's keys itself.
  device)
    printf '%s\n' "$device"
    exit 0
    ;;
  # Off while the screen is locked, and back as it was: brightnessctl keeps
  # the level it had.
  off)
    brightnessctl -sd "$device" set 0 >/dev/null
    exit 0
    ;;
  restore)
    brightnessctl -rd "$device" >/dev/null
    exit 0
    ;;
esac

# A step is a tenth of the range: a light with 512 levels needs big steps, and
# one with 3 takes them one at a time. Round goes up, and from the top to off.
max=$(brightnessctl -d "$device" max)
now=$(brightnessctl -d "$device" get)
step=$((max / 10 > 1 ? max / 10 : 1))
case $direction in
  up) level=$((now + step > max ? max : now + step)) ;;
  down) level=$((now - step < 0 ? 0 : now - step)) ;;
  cycle) level=$((now + step > max ? 0 : now + step)) ;;
esac

brightnessctl -d "$device" set "$level" >/dev/null
if $osd; then
  nova-osd -i keyboard -p "$((level * 100 / max))"
fi
