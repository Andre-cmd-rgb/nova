#!/bin/bash

# nova:summary=Show or pin the Wi-Fi band for the active connection
# nova:args=[auto|2.4|5|6]

# With no argument, for the shell's network panel, a line each, after a tab:
#   band       the band the connection is on
#   available  the bands its network answers on, low to high
#   selected   the band its profile is pinned to, or auto
# Nothing while no Wi-Fi is connected.
#
# The band is pinned on the connection's profile, not to one access point (a
# BSSID): that goes on working when the access point changes its BSSIDs, and
# roaming between access points goes on too. NetworkManager 1.44 and later
# pin 5 GHz and 6 GHz apart.

set -euo pipefail

usage() {
  echo "Usage: nova-network-band [auto|2.4|5|6]" >&2
  exit 1
}

# A value from nmcli. In English (LC_ALL=C), as nmcli translates its state
# words, which would then not match; unescaped (-e no), as -g escapes : and
# \ in values, and an SSID escaped would not match the one iw gives.
nm_get() {
  LC_ALL=C nmcli -e no -g "$@" 2>/dev/null
}

# The band of a frequency, in $band, from nmcli's "2412 MHz" or iw's
# "5745.0": the digits it starts with. The bounds are those of the panel's
# formatHeaderFreq (Model.js), so that the two never disagree. 1 for none.
band_of() { # frequency
  local mhz=${1%%[!0-9]*}
  band=""
  [[ -n $mhz ]] || return 1
  if ((mhz >= 2400 && mhz < 2500)); then
    band=2.4
  elif ((mhz >= 4900 && mhz < 5925)); then
    band=5
  elif ((mhz >= 5925 && mhz < 7125)); then
    band=6
  else
    return 1
  fi
}

# The connected Wi-Fi device, in $device; empty for none.
wifi_device() {
  local status name type state
  device=""
  status=$(nm_get DEVICE,TYPE,STATE device status)
  while IFS=: read -r name type state; do
    if [[ $type == wifi && $state == connected ]]; then
      device=$name
      break
    fi
  done <<<"$status"
}

# The network the device is on, in $ssid, and its frequency, in $frequency,
# from iw. iw gives the SSID as the rest of its line, colons and all.
read_link() { # device
  local link line named=false tuned=false
  local -a words
  ssid="" frequency=""
  link=$(iw dev "$1" link 2>/dev/null)
  while IFS= read -r line; do
    if ! $named && [[ $line == *SSID:* ]]; then
      ssid=${line##*SSID: }
      named=true
    fi
    if ! $tuned && [[ $line == *freq:* ]]; then
      read -r -a words <<<"$line"
      frequency=${words[1]:-}
      tuned=true
    fi
  done <<<"$link"
}

# The bands the network answers on, low to high, in $bands: those
# NetworkManager has seen it on, and the one in use always, as a weak radio
# is missed by many a scan. A band it does not answer on is never offered, as
# pinning it would drop the connection, with nothing to come back to. It reads
# NetworkManager's last scan (--rescan no), which the panel keeps fresh: a
# scan here would hold up every reading, and the kernel's own (iw scan dump)
# forgets so soon that bands would come and go.
bands_of() { # device ssid band-in-use
  local list line name seen=" $3 " each
  bands=""
  # The SSID last, so that one with colons in it is whole after the first.
  list=$(nm_get FREQ,SSID dev wifi list ifname "$1" --rescan no)
  while IFS= read -r line; do
    name=""
    if [[ $line == *:* ]]; then name=${line#*:}; fi
    if [[ $name == "$2" ]] && band_of "${line%%:*}"; then seen+="$band "; fi
  done <<<"$list"
  for each in 2.4 5 6; do
    if [[ $seen == *" $each "* ]]; then bands+=${bands:+ }$each; fi
  done
}

status() {
  local device ssid frequency band bands profile pinned in_use
  wifi_device
  [[ -n $device ]] || return 0
  read_link "$device"
  [[ -n $ssid ]] || return 0
  band_of "$frequency" || true
  in_use=$band
  bands_of "$device" "$ssid" "$in_use"
  profile=$(nm_get GENERAL.CONNECTION device show "$device")
  printf 'band\t%s\n' "$in_use"
  printf 'available\t%s\n' "$bands"
  if [[ -n $profile ]]; then
    pinned=$(nm_get 802-11-wireless.band connection show "$profile" || true)
    case $pinned in
      bg) pinned=2.4 ;;
      a) pinned=5 ;;
      6GHz) pinned=6 ;;
      *) pinned=auto ;;
    esac
    printf 'selected\t%s\n' "$pinned"
  fi
}

pin() { # auto|2.4|5|6
  local target=$1 device ssid frequency band bands profile previous wanted
  wifi_device
  if [[ -z $device ]]; then
    echo "Error: no connected Wi-Fi device." >&2
    exit 1
  fi
  profile=$(nm_get GENERAL.CONNECTION device show "$device")
  if [[ -z $profile ]]; then
    echo "Error: no active Wi-Fi connection profile." >&2
    exit 1
  fi

  case $target in
    auto) wanted="" ;;
    *)
      read_link "$device"
      band_of "$frequency" || true
      # What NetworkManager has seen is no requirement here: without it, the
      # band in use is still offered.
      bands_of "$device" "$ssid" "$band" || true
      if [[ " $bands " != *" $target "* ]]; then
        echo "Error: ${target}GHz is not available on this network." >&2
        exit 1
      fi
      case $target in
        2.4) wanted="bg" ;;
        5) wanted=a ;;
        6) wanted=6GHz ;;
      esac
      ;;
  esac

  previous=$(nm_get 802-11-wireless.band connection show "$profile")
  [[ $previous != "$wanted" ]] || exit 0
  nmcli connection modify "$profile" 802-11-wireless.band "$wanted" >/dev/null

  # A band takes effect as the connection comes up again. Where it cannot come
  # up on the band asked for, the band it had is put back, and the connection
  # brought up on that, rather than left down.
  if ! nmcli connection up "$profile" >/dev/null 2>&1; then
    nmcli connection modify "$profile" 802-11-wireless.band "$previous" >/dev/null
    nmcli connection up "$profile" >/dev/null 2>&1 || true
    echo "Error: could not connect on ${target}; reverted to previous band." >&2
    exit 1
  fi
}

case $# in
  0) status ;;
  1)
    case $1 in
      auto | 2.4 | 5 | 6) pin "$1" ;;
      *) usage ;;
    esac
    ;;
  *) usage ;;
esac
