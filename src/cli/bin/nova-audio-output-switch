#!/bin/bash

# nova:summary=Switch to the next audio output, showing its name and volume

set -euo pipefail

# The outputs that can play, as nova-audio-sink-availability counts them: a
# sink without ports, or with one not marked unavailable; the speakers behind
# a speaker tuning left out. Four fields each: the sink's name, its index, its
# description, and the sink itself as JSON. Fields end in a NUL, which no
# description holds. A list that failed partway is no list.
fronted=$(nova-audio-tuning fronted-sink 2>/dev/null || true)
mapfile -d '' -t outputs < <(timeout 2 pactl -f json list sinks | jq --raw-output0 --arg fronted "$fronted" '
  map(select((.ports | length == 0) or any(.ports[]?; .availability != "not available"))
    | select($fronted == "" or .name != $fronted))
  | .[] | .name, (.index | tostring), (.description // .properties."device.description" // .name), tojson')
wait "$!" || outputs=()
if ((${#outputs[@]} == 0)); then
  nova-osd -m "No audio devices found"
  exit 1
fi

# The one after the default output, round to the first; the first when the
# default is none of these.
current=$(timeout 2 pactl get-default-sink)
next=0
for ((i = 0; i < ${#outputs[@]}; i += 4)); do
  if [[ ${outputs[i]} == "$current" ]]; then
    next=$(((i + 4) % ${#outputs[@]}))
    break
  fi
done
name=${outputs[next]}
index=${outputs[next + 1]}
description=${outputs[next + 2]}

# Its volume and mute are those of the sink under it: a tuning stays at 100%
# and unmuted, and the volume keys turn the speakers'. When pactl cannot say,
# the volume pactl listed.
under=$(nova-audio-output-sink "$name")
read -r -a words < <(timeout 2 pactl get-sink-volume "$under" 2>/dev/null) || true
volume=""
for word in "${words[@]}"; do
  if [[ $word == *% ]]; then
    volume=${word/\%/}
    break
  fi
done
if [[ -z $volume ]]; then
  volume=$(jq -r '.volume | to_entries[0].value.value_percent | sub("%"; "") | tonumber' <<<"${outputs[next + 3]}")
fi

if [[ $(timeout 2 pactl get-sink-mute "$under" 2>/dev/null || true) == *yes ]] || ((volume == 0)); then
  level=muted
elif ((volume <= 33)); then
  level=low
elif ((volume <= 66)); then
  level=medium
else
  level=high
fi

if [[ $name != "$current" ]]; then
  nova-audio-output-set-default "$index" "$name"
fi
nova-osd -i "volume-$level" -m "$description"
