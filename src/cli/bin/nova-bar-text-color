#!/bin/bash

# nova:summary=Choose a legible transparent bar text color
# nova:hidden=true

# For a transparent bar: of its text color and its background color, the one
# that stands out more against the wallpaper where the bar is. The wallpaper
# there is taken as its average color, and each color's contrast with it
# measured as WCAG does. Anything it cannot tell answers the text color.
#
#   nova-bar-text-color <position> <bar size> <text color> <background color>
#                       [--background <wallpaper>] [--screen <WxH>]
#
# Colors are #rrggbb. The wallpaper is the theme's current one, and the screen
# Hyprland's first monitor, unless given.

set -euo pipefail

position=${1:-top}
size=${2:-}
text=${3:-}
background=${4:-}
wallpaper=""
screen=""
shift 4 2>/dev/null || true
while (($#)); do
  case $1 in
    --background)
      wallpaper=${2:-}
      shift 2
      ;;
    --screen)
      screen=${2:-}
      shift 2
      ;;
    *) shift ;;
  esac
done

answer_text() {
  printf '%s\n' "$text"
  exit 0
}

[[ $text =~ ^#[0-9A-Fa-f]{6}$ ]] || answer_text
[[ $background =~ ^#[0-9A-Fa-f]{6}$ ]] || answer_text
[[ $position =~ ^(top|bottom|left|right)$ ]] || answer_text
[[ $size =~ ^[0-9]+$ ]] || answer_text
command -v magick >/dev/null 2>&1 || answer_text

if [[ -z $wallpaper ]]; then
  wallpaper=$(readlink -f "${XDG_STATE_HOME:-$HOME/.local/state}/nova/current/background" 2>/dev/null || true)
fi
[[ -f $wallpaper ]] || answer_text

if [[ -z $screen ]] && command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  screen=$(hyprctl monitors -j 2>/dev/null | jq -r '.[0] | "\(.width)x\(.height)"' 2>/dev/null || true)
fi
[[ $screen =~ ^([0-9]+)x([0-9]+)$ ]] || answer_text
width=${BASH_REMATCH[1]}
height=${BASH_REMATCH[2]}
((width > 0 && height > 0 && size > 0)) || answer_text

# The strip of the screen the bar covers.
case $position in
  top) strip=${width}x$size+0+0 ;;
  bottom)
    ((height >= size)) || answer_text
    strip=${width}x$size+0+$((height - size))
    ;;
  left) strip=${size}x$height+0+0 ;;
  right)
    ((width >= size)) || answer_text
    strip=${size}x$height+$((width - size))+0
    ;;
esac

# The wallpaper as it fills the screen (scaled to cover it, centred, cut to
# it), and of that the strip, averaged to one pixel.
pixel=$(magick "$wallpaper" -auto-orient \
  -resize "${width}x${height}^" \
  -gravity center -extent "${width}x${height}" \
  -gravity NorthWest -crop "$strip" +repage \
  -resize '1x1!' -format '%[fx:int(255*r)],%[fx:int(255*g)],%[fx:int(255*b)]' info:- 2>/dev/null || true)
[[ $pixel =~ ^([0-9]+),([0-9]+),([0-9]+)$ ]] || answer_text
printf -v behind '#%02x%02x%02x' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"

# WCAG's contrast ratio, to six places: the background color only where it
# stands out more than the text color.
awk -v text="$text" -v background="$background" -v behind="$behind" '
  function channel(hex, at) { return strtonum("0x" substr(hex, at, 2)) / 255 }
  function linear(c) { return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ^ 2.4 }
  function luminance(hex) {
    return 0.2126 * linear(channel(hex, 2)) + 0.7152 * linear(channel(hex, 4)) + 0.0722 * linear(channel(hex, 6))
  }
  function contrast(a, b,    la, lb) {
    la = luminance(a)
    lb = luminance(b)
    if (la < lb) return sprintf("%.6f", (lb + 0.05) / (la + 0.05)) + 0
    return sprintf("%.6f", (la + 0.05) / (lb + 0.05)) + 0
  }
  BEGIN { print (contrast(background, behind) > contrast(text, behind) ? background : text) }'
