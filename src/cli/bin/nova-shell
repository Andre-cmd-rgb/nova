#!/bin/bash

# nova:summary=Send an IPC call to the running Nova shell
# nova:args=[-q] <target> <method> [args...]

set -euo pipefail

QUIET=0
if [[ ${1:-} == "-q" ]]; then
  QUIET=1
  shift
fi

fail() {
  if ((QUIET)); then exit 0; fi
  echo "$1" >&2
  exit 1
}

if (($# == 0)) || [[ $1 == "-h" || $1 == "--help" ]]; then
  cat <<USAGE
Usage: nova-shell [-q] <target> <method> [args...]

Forwards an IPC call to the running Nova shell. The shell is expected
to already be running; this command does not start it.

Options:
  -q  Quiet best-effort mode. Suppress output and return success even when
      the shell, target, method, or arguments are unavailable.

Examples:
  nova-shell shell ping
  nova-shell -q nova.indicators refresh
  nova-shell shell listPlugins
  nova-shell shell toggle nova.menu '{"menu":"root"}'
USAGE
  exit 0
fi

(($# >= 2)) || fail "Usage: nova-shell <target> <method> [args...]"
NOVA_PATH=${NOVA_PATH:-/usr/share/nova}
[[ -f $NOVA_PATH/shell/shell.qml ]] || fail "nova-shell config not found: $NOVA_PATH/shell/shell.qml"

# qs matches instances by display, and a caller from outside the session (an
# ssh or TTY nova-restart-shell, and the migrations it runs for) has none,
# so recover it from the compositor socket.
if [[ -z ${WAYLAND_DISPLAY:-} ]]; then
  for socket in "${XDG_RUNTIME_DIR:-/run/user/$UID}"/wayland-[0-9]*; do
    [[ -S $socket ]] || continue
    if [[ -z ${newest:-} || $socket -nt $newest ]]; then newest=$socket; fi
  done
  if [[ -n ${newest:-} ]]; then export WAYLAND_DISPLAY=${newest##*/}; fi
fi

if [[ $1 == "shell" && ($2 == "summon" || $2 == "toggle") ]] && (($# == 3)); then
  set -- "$1" "$2" "$3" "{}"
fi

# The -- keeps function names that shadow qs subcommands (e.g. show) as
# positionals. qs reports connection failures with a nonzero exit, but IPC-level
# failures (unknown target/function, bad arguments) go to stdout with exit 0.
ipc_timeout=${NOVA_SHELL_IPC_TIMEOUT:-2s}
ipc_status=0
output=$(timeout --kill-after=1s "$ipc_timeout" qs ipc -n -p "$NOVA_PATH/shell" call -- "$@" 2>/dev/null) || ipc_status=$?

if ((ipc_status == 124 || ipc_status == 137)); then
  fail "nova-shell is not responding"
elif ((ipc_status != 0)); then
  fail "nova-shell is not running"
fi

case $output in
  "Target not found." | "Function not found." | "Too few arguments provided"* | "Too many arguments provided"*)
    fail "$output"
    ;;
  # A starting shell answers on stdout and exits 0, so a ping reads it as up
  # and the next call's answer as a result. It is as unreachable as none.
  "Not ready to accept queries yet"*)
    fail "nova-shell is not ready"
    ;;
esac

if ((!QUIET)) && [[ -n $output ]]; then
  echo "$output"
fi
exit 0
