#!/bin/bash

# nova:summary=Send an IPC call to the running Nova shell
# nova:args=[-q] <target> <method> [args...]

set -euo pipefail

# -q: for callers that only nudge the shell. Whatever goes wrong, nothing is
# printed and the exit is 0.
quiet=false
if [[ ${1:-} == -q ]]; then
  quiet=true
  shift
fi

die() {
  $quiet && exit 0
  echo "$1" >&2
  exit 1
}

if (($# == 0)) || [[ $1 == -h || $1 == --help ]]; then
  cat <<'USAGE'
Usage: nova-shell [-q] <target> <method> [args...]

Calls a function of the running shell over its IPC: the shell's own (target
shell) or a plugin's. It does not start the shell.

  -q  Print nothing and exit 0 whatever happens: for a caller that only
      nudges the shell, and does not mind if it is not there.

For example:
  nova-shell shell ping
  nova-shell shell listPlugins
  nova-shell shell toggle nova.menu '{"menu":"root"}'
  nova-shell -q nova.indicators refresh
USAGE
  exit 0
fi

(($# >= 2)) || die "Usage: nova-shell <target> <method> [args...]"
config=${NOVA_PATH:-/usr/share/nova}/shell
[[ -f $config/shell.qml ]] || die "nova-shell config not found: $config/shell.qml"

# qs finds the shell by its Wayland display. Run from outside the session
# (over ssh, from a TTY: nova-restart-shell, and the migrations it runs), there
# is none: take the compositor's newest socket.
if [[ -z ${WAYLAND_DISPLAY:-} ]]; then
  display=""
  for socket in "${XDG_RUNTIME_DIR:-/run/user/$UID}"/wayland-[0-9]*; do
    if [[ -S $socket && (-z $display || $socket -nt $display) ]]; then display=$socket; fi
  done
  if [[ -n $display ]]; then export WAYLAND_DISPLAY=${display##*/}; fi
fi

# A menu summoned or toggled without a payload gets an empty one.
if (($# == 3)) && [[ $1 == shell && ($2 == summon || $2 == toggle) ]]; then
  set -- "$@" "{}"
fi

# qs fails only when it reaches no shell; a shell that refuses the call (no
# such target or function, the wrong arguments) says so on stdout, with a 0.
# The -- keeps a function named like a qs option (show) an argument.
status=0
reply=$(timeout --kill-after=1s "${NOVA_SHELL_IPC_TIMEOUT:-2s}" qs ipc -n -p "$config" call -- "$@" 2>/dev/null) || status=$?
case $status in
  0) ;;
  124 | 137) die "nova-shell is not responding" ;;
  *) die "nova-shell is not running" ;;
esac

case $reply in
  "Target not found." | "Function not found." | "Too few arguments provided"* | "Too many arguments provided"*)
    die "$reply"
    ;;
  # A shell still starting answers this, with a 0: a ping would count it up,
  # and the next call take its answer for a result.
  "Not ready to accept queries yet"*)
    die "nova-shell is not ready"
    ;;
esac

if ! $quiet && [[ -n $reply ]]; then
  echo "$reply"
fi
