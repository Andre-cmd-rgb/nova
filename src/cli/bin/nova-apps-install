#!/bin/bash

# nova:summary=Install Google Chrome and VS Code from their AUR recipes
# nova:args=[--noconfirm]
#
# Neither may be redistributed, so Nova builds them here from their AUR
# recipes, which download the vendors' own releases from Google and Microsoft.
# Run it as yourself: makepkg refuses root, and asks for your password once it
# installs. The installer runs it for the new account when it has internet.
# Already-installed apps are skipped, so running it again is harmless; updates
# arrive the same way, by running it again.

set -euo pipefail

apps=(google-chrome visual-studio-code-bin)
aur=https://aur.archlinux.org

confirm=()
case ${1:-} in
  "") ;;
  --noconfirm) confirm=(--noconfirm) ;;
  *)
    echo "Usage: nova apps install [--noconfirm]" >&2
    exit 2
    ;;
esac

((EUID != 0)) || { echo "nova apps install: run this as yourself, not root" >&2; exit 1; }

work=$(mktemp -d "${TMPDIR:-/tmp}/nova-apps.XXXXXX")
trap 'rm -rf -- "$work"' EXIT

failed=()
for app in "${apps[@]}"; do
  if pacman -Q "$app" >/dev/null 2>&1; then
    echo "$app is already installed"
    continue
  fi
  echo "==> $app"
  if git clone --quiet --depth 1 "$aur/$app.git" "$work/$app" &&
    (cd "$work/$app" && makepkg --syncdeps --install --needed --clean "${confirm[@]}"); then
    continue
  fi
  failed+=("$app")
done

if ((${#failed[@]})); then
  echo "nova apps install: could not install ${failed[*]}; run nova apps install again to retry" >&2
  exit 1
fi
