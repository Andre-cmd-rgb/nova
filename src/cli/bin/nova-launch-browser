#!/bin/bash

# nova:summary=Open the default browser
# nova:args=[url]

set -euo pipefail

# First word of the Exec line of the named desktop entry, from the first
# applications directory that has it.
desktop_exec() {
  local dir
  for dir in ~/.local/share ~/.nix-profile/share /usr/share; do
    if [[ -r $dir/applications/$1 ]]; then
      awk '/^Exec=/ { sub(/^Exec=/, ""); print $1; exit }' "$dir/applications/$1"
      return 0
    fi
  done
}

default_browser=$(nova-cmd-default-browser) || {
  echo "nova-launch-browser: no default browser is set" >&2
  exit 1
}
browser_exec=$(desktop_exec "$default_browser")
if [[ -z $browser_exec ]]; then
  echo "nova-launch-browser: cannot find the command for $default_browser" >&2
  exit 1
fi

# Firefox and its forks open a private window with --private-window, Edge with
# --inprivate, the rest of Chromium's family with --incognito. The name tells
# which: asking the browser itself for its --help starts it every time, and
# Chrome crashes on it.
case ${browser_exec##*/} in
  *firefox* | *librewolf* | zen* | *waterfox* | *floorp* | *mullvad* | *tor-browser* | *icecat*)
    private_flag="--private-window" ;;
  *edge*) private_flag="--inprivate" ;;
  *) private_flag="--incognito" ;;
esac

if ! nova-cmd-browser-handoff "$browser_exec" "${@/--private/$private_flag}"; then
  systemd-run --user --quiet --collect --unit="nova-browser-$(date +%s%N)" \
    --property=StandardOutput=null --property=StandardError=null \
    uwsm-app -- "$browser_exec" "${@/--private/$private_flag}"
fi

url=""
for argument in "$@"; do
  if [[ $argument != "--private" ]]; then
    url=$argument
    break
  fi
done

if [[ -n $url && -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  nova-hyprland-focus-app "^$(basename "$browser_exec" -stable).*$" || true
fi
