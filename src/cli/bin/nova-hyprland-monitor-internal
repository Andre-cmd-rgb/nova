#!/bin/bash

# nova:summary=Enable, disable, toggle, or recover the internal laptop display
# nova:args=<on|off|toggle|recover>

set -euo pipefail

case ${1:-} in
  on | off | toggle | recover) ;;
  *)
    echo "Usage: ${0##*/} {on|off|toggle|recover}" >&2
    exit 1
    ;;
esac

# The panel off is a toggle of its own, a rule the Hyprland config loads at
# every reload. Mirroring the panel is another, and needs it on.
toggle=internal-monitor-disable
flag=${XDG_STATE_HOME:-$HOME/.local/state}/nova/toggles/hypr/$toggle.lua
# Looked up whatever the action: one Hyprland cannot answer changes nothing.
panel=$(nova-hyprland-monitor-laptop)

notify() { nova-notification-send -g 󰍹 "$1"; }

# Every display awake, the panel brought back included.
wake() {
  hyprctl dispatch 'hl.dsp.dpms({ action = "enable" })' >/dev/null 2>&1 || true
}

turn_on() {
  if nova-hyprland-toggle-enabled "$toggle"; then
    nova-hyprland-toggle "$toggle" off
    notify "Laptop display enabled"
  fi
  wake
}

turn_off() {
  if [[ -z $panel ]]; then
    notify "No laptop display found"
    exit 1
  fi
  # The name goes into Lua the config runs, so only a plain connector name.
  if [[ ! $panel =~ ^[A-Za-z0-9._-]+$ ]]; then
    notify "Refusing unsafe monitor name"
    exit 1
  fi
  if ! nova-hyprland-monitor-external-active; then
    notify "Can't disable the only active display"
    exit 1
  fi
  if nova-hyprland-toggle-disabled "$toggle" && nova-hyprland-toggle-disabled internal-monitor-mirror; then
    mkdir -p "${flag%/*}"
    printf 'hl.monitor({ output = "%s", disabled = true })\n' "$panel" >"$flag"
    notify "Laptop display disabled"
    hyprctl reload
  fi
}

# The panel back on once nothing else shows the desktop. The lid watcher asks
# for this, so it does nothing else: a wake each time would undo the lock
# screen's blanking, and race the modeset after a resume into a flash.
recover() {
  nova-hyprland-monitor-external-active && return 0
  nova-hyprland-toggle-enabled "$toggle" || return 0
  nova-hyprland-toggle "$toggle" off
  wake
}

case $1 in
  on) turn_on ;;
  off) turn_off ;;
  toggle) if nova-hyprland-toggle-enabled "$toggle"; then turn_on; else turn_off; fi ;;
  recover) recover ;;
esac
