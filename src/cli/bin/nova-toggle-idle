#!/bin/bash

# nova:summary=Toggle Stay Awake, which keeps the screen from idling and locking
# nova:args=[toggle|on|off|status]
#
# The shell's idle service owns the state (and persists it), so this only asks
# it over IPC.

set -euo pipefail

case ${1:-toggle} in
  toggle) method=toggle ;;
  on) method=disable ;;
  off) method=enable ;;
  status) method=status ;;
  *)
    echo "Usage: nova-toggle-idle [toggle|on|off|status]" >&2
    exit 2
    ;;
esac

status=$(nova-shell idle "$method")
if [[ $method == status ]]; then
  printf '%s\n' "$status"
fi
