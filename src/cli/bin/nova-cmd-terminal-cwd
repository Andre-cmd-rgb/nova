#!/bin/bash

# nova:summary=Print the working directory of the focused terminal, or home
# nova:hidden=true

# No errexit: whatever fails on the way, the answer is home.
set -uo pipefail

# The directory of the shell in the focused window. The window's newest child
# is the shell when it is a terminal; one that is not a shell from /etc/shells
# (an editor, ssh) has a directory too, but not one to open.
terminal_directory() {
  local window shell directory program line
  window=$(hyprctl activewindow -j 2>/dev/null | jq -r '.pid // empty')
  [[ $window =~ ^[0-9]+$ ]] || return 1
  shell=$(pgrep -n -P "$window") || return 1
  { IFS= read -r -d '' directory && IFS= read -r -d '' program; } < <(
    readlink -fz "/proc/$shell/cwd" "/proc/$shell/exe" 2>/dev/null
  ) || return 1
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line == "$program" ]]; then
      [[ -d $directory ]] && printf '%s\n' "$directory"
      return
    fi
  done 2>/dev/null </etc/shells
  return 1
}

terminal_directory || printf '%s\n' "$HOME"
