#!/bin/bash
# nova:hidden=true
# nova:summary=What the memory in use is made of, line by line, as the kernel counts it
# nova:args=[--total|--programs]
#
# "In use" is MemTotal less MemAvailable, the number free, btop, fastfetch
# and Nova's Memory readout show. The kernel works MemAvailable out
# (si_mem_available, mm/show_mem.c) as
#
#   free pages - the reserve                    the zones' high watermarks, and
#                                               what lower zones keep from
#                                               higher ones (totalreserve_pages)
#   + page cache - min(half of it, low marks)   Active(file) + Inactive(file)
#   + reclaimable - min(half of it, low marks)  KReclaimable
#
# so what is in use is everything that is neither free nor droppable cache,
# and three margins on top that nothing holds: the reserve, and the part of
# the cache and of the reclaimable kernel memory the kernel counts as needed.
# The watermarks follow vm.watermark_scale_factor (nova-memory-reserve), and
# the per-CPU free lists follow the low watermark: pages on them are free, and
# MemFree does not count them. This prints each part, from /proc/meminfo and
# /proc/zoneinfo, which anyone may read; the lines sum to the figure, the last
# one ("not counted elsewhere") being what is left: drivers' own pages, and
# the moment between the two files being read.
#
#   nova-doctor-memory             the account, in MiB
#   nova-doctor-memory --total     "<in use> <held> <margins> <per-CPU free>" in kB:
#                                  held is programs and kernel together, the
#                                  margins are the three above
#   nova-doctor-memory --programs  the account, then the programs by their own
#                                  (anonymous) memory: each one's share where
#                                  the reader may see it (root: all of them),
#                                  else what it has resident
#
# nova doctor --bundle and the install test (tests/install/probe) print it.
# NOVA_PROC points it at a fixture (tests/unit/cli/doctor-memory.bats).

set -euo pipefail

PROC=${NOVA_PROC:-/proc}
mode=table
case $#:${1:-} in
  0:) ;;
  1:--total) mode=total ;;
  1:--programs) mode=programs ;;
  *) echo 'Usage: nova-doctor-memory [--total|--programs]' >&2; exit 2 ;;
esac

[[ -r $PROC/meminfo && -r $PROC/zoneinfo ]] || { echo "nova-doctor-memory: no $PROC/meminfo or $PROC/zoneinfo" >&2; exit 1; }

# tmpfs files are shared memory df can name; the rest of Shmem is graphics
# buffers (i915 keeps them there), programs' shared memory and memfds.
tmpfs_kb=0
if [[ -z ${NOVA_PROC:-} ]]; then
  tmpfs_kb=$(df -k -t tmpfs -t devtmpfs --output=used 2>/dev/null | awk 'NR > 1 { kb += $1 } END { print kb + 0 }') || tmpfs_kb=0
fi
# The graphics buffers as the drivers count them (each client once): the most
# they hold, and the least (what no two clients share).
read -r gpu_total gpu_shared _ < <("${BASH_SOURCE[0]%/*}/nova-doctor-gpu-memory" --total 2>/dev/null || echo '0 0 0') || true

awk -v mode="$mode" -v tmpfs="$tmpfs_kb" -v gpu_total="${gpu_total:-0}" -v gpu_shared="${gpu_shared:-0}" '
  function min(a, b) { return a < b ? a : b }
  function line(kb, what) { if (mode != "total") printf "%9.1f  %s\n", kb / 1024, what }
  function note(text) { if (mode != "total") printf "%9s    %s\n", "", text }
  # /proc/zoneinfo, in pages: each zone its watermarks, what it keeps from
  # higher zones (protection), and every CPU its free list (count).
  FILENAME ~ /zoneinfo$/ {
    if ($1 == "Node" && $3 == "zone") { settle(); zone = 1; high = low = managed = protection = 0; next }
    if (!zone) next
    if ($1 == "low") low = $2
    else if ($1 == "high" && NF == 2) high = $2
    else if ($1 == "managed") managed = $2
    else if ($1 == "protection:") { gsub(/[(),]/, " "); for (i = 2; i <= NF; i++) if ($i + 0 > protection) protection = $i + 0 }
    else if ($1 == "count:") pcp += $2
    next
  }
  function settle() {
    if (!zone) return
    reserve += min(protection + high, managed)
    low_marks += low; high_marks += high
    zone = 0
  }
  { sub(/:$/, "", $1); m[$1] = $2 }
  END {
    settle()
    page = 4
    reserve *= page; low_marks *= page; high_marks *= page; pcp *= page
    used = m["MemTotal"] - m["MemAvailable"]
    cache = m["Active(file)"] + m["Inactive(file)"]
    reclaimable = m["KReclaimable"]
    held = m["MemTotal"] - m["MemFree"] - cache - reclaimable
    cache_kept = min(cache / 2, low_marks)
    reclaimable_kept = min(reclaimable / 2, low_marks)
    margins = reserve + cache_kept + reclaimable_kept
    # File pages that are on no file list: locked, or just read.
    locked = m["Cached"] + m["Buffers"] + m["SwapCached"] - m["Shmem"] - cache
    if (locked < 0) locked = 0
    # On the lists of memory that could be swapped, and mapped by no program.
    unmapped = m["Active(anon)"] + m["Inactive(anon)"] + m["Unevictable"] - m["AnonPages"] - m["Shmem"] - locked
    if (unmapped < 0) unmapped = 0
    kernel_small = m["KernelStack"] + m["PageTables"] + m["SecPageTables"] + m["Percpu"]
    named = m["AnonPages"] + m["Shmem"] + locked + unmapped + m["SUnreclaim"] + kernel_small + m["VmallocUsed"] + pcp + margins
    other = used - named
    if (mode == "total") { printf "%d %d %d %d\n", used, held, margins, pcp; exit }

    printf "Memory in use: %.2f of %.2f GiB (MemTotal less MemAvailable, as free and btop count it)\n\n", used / 1048576, m["MemTotal"] / 1048576
    printf "%9s  %s\n", "MiB", "what"
    line(m["AnonPages"], "programs: their own memory")
    if (m["AnonHugePages"] > 0) note(sprintf("of it in 2 MiB huge pages: %.1f", m["AnonHugePages"] / 1024))
    line(m["Shmem"], "shared memory: graphics buffers, tmpfs files, what programs share")
    if (gpu_total > 0) note(sprintf("graphics buffers, as the drivers count them: %.1f to %.1f", (gpu_total - gpu_shared) / 1024, gpu_total / 1024))
    if (tmpfs > 0) note(sprintf("files on tmpfs (/tmp, /run, /dev/shm): %.1f", tmpfs / 1024))
    if (unmapped >= 1024) line(unmapped, "given back by programs, not yet taken back by the kernel (parts of huge pages)")
    if (locked >= 1024) line(locked, "page cache that cannot be dropped (locked, or in use by the file system)")
    line(m["SUnreclaim"], "kernel: its own objects (slab that cannot be reclaimed)")
    line(m["VmallocUsed"], "kernel: modules, firmware and drivers (vmalloc)")
    line(kernel_small, "kernel: stacks, page tables, per-CPU data")
    line(other, "kernel and drivers, not counted elsewhere")
    line(pcp, "free pages on the per-CPU lists, which MemFree leaves out")
    line(reserve, "the kernel reserve: kept free below the high watermarks, and for the lower zones")
    line(cache_kept, sprintf("page cache counted as needed (half of %.0f, at most the low watermarks)", cache / 1024))
    line(reclaimable_kept, sprintf("reclaimable kernel memory counted as needed (half of %.0f, at most the same)", reclaimable / 1024))
    printf "%9s\n%9.1f  in use: %.1f held by programs and the kernel, %.1f the kernel keeps aside\n", "---------", used / 1024, (used - margins - pcp) / 1024, (margins + pcp) / 1024
    printf "\nWatermarks: low %.0f MiB, high %.0f MiB (vm.watermark_scale_factor, set by nova-memory-reserve).\n", low_marks / 1024, high_marks / 1024
  }' "$PROC/zoneinfo" "$PROC/meminfo"

[[ $mode == programs ]] || exit 0

# Each program's own memory: its share of the anonymous pages (Pss_Anon) where
# smaps_rollup may be read, else what it has resident (RssAnon, which counts a
# page two programs share for both). Kernel threads have none.
printf '\n%9s  %s\n' MiB 'programs, by their own memory'
for dir in "$PROC"/[0-9]*; do
  kb=$(awk '/^Pss_Anon:/ { print $2; exit }' "$dir/smaps_rollup" 2>/dev/null) || kb=''
  if [[ -z $kb ]]; then
    kb=$(awk '/^RssAnon:/ { print $2; exit }' "$dir/status" 2>/dev/null) || kb=''
  fi
  [[ -n $kb && $kb != 0 ]] || continue
  comm=$(cat -- "$dir/comm" 2>/dev/null) || continue
  printf '%s %s\n' "$kb" "${comm// /_}"
done | awk '{ kb[$2] += $1; n[$2]++ } END { for (c in kb) printf "%9.1f  %s%s\n", kb[c] / 1024, c, (n[c] > 1 ? " (" n[c] ")" : "") }' | sort -k1,1nr | head -n 25
