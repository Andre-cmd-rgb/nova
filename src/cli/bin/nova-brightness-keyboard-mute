#!/bin/bash

# nova:summary=Light or darken the microphone-mute LED, on laptops whose kernel has one as platform::micmute
# nova:args=<on|off>
# nova:hidden=true

set -euo pipefail

case ${1:-} in
  on) level=1 ;;
  off) level=0 ;;
  *)
    echo "Usage: nova-brightness-keyboard-mute <on|off>" >&2
    exit 1
    ;;
esac

# Most computers have no such LED, and then there is nothing to do.
led=platform::micmute
if [[ -e /sys/class/leds/$led/brightness ]]; then
  brightnessctl --device="$led" set "$level" >/dev/null 2>&1 || true
fi
