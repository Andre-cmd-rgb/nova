#!/bin/bash

# nova:summary=Turn a Hyprland setting on or off, and keep it that way
# nova:args=<flag-name> [on|off|toggle]

set -euo pipefail

usage() {
  echo "Usage: nova-hyprland-toggle <flag-name> [on|off|toggle]" >&2
  exit 1
}

(($# > 0)) || usage

# A setting that is on is a copy of Nova's Lua for it among the toggles, which
# the Hyprland config loads last (data/hypr/toggles.lua); off, there is none.
name=$1
flag=${XDG_STATE_HOME:-$HOME/.local/state}/nova/toggles/hypr/$name.lua
shipped=${NOVA_PATH:-/usr/share/nova}/default/hypr/toggles/$name.lua

turn_on() {
  if [[ ! -f $shipped ]]; then
    echo "Flag not found: $name" >&2
    exit 1
  fi
  mkdir -p "${flag%/*}"
  cp "$shipped" "$flag"
}

case ${2:-toggle} in
  on) turn_on ;;
  off) rm -f "$flag" ;;
  # Toggling says which way it went, for the notification of the caller.
  toggle)
    if [[ -f $flag ]]; then
      rm -f "$flag"
      echo off
    else
      turn_on
      echo on
    fi
    ;;
  *) usage ;;
esac

hyprctl reload >/dev/null
