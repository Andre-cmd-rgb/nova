#!/bin/bash

# nova:summary=Turn a Hyprland setting on or off, and keep it that way
# nova:args=<flag-name> [on|off|toggle]

set -euo pipefail

usage() {
  echo "Usage: nova-hyprland-toggle <flag-name> [on|off|toggle]" >&2
}

if (($# < 1)); then
  usage
  exit 1
fi

FLAG_NAME="$1"
ACTION="${2:-toggle}"
FLAG_FILE="$HOME/.local/state/nova/toggles/hypr/$FLAG_NAME.lua"
FLAG_SOURCE="$NOVA_PATH/default/hypr/toggles/$FLAG_NAME.lua"

on() {
  if [[ -f $FLAG_SOURCE ]]; then
    mkdir -p "$(dirname "$FLAG_FILE")"
    cp "$FLAG_SOURCE" "$FLAG_FILE"
  else
    echo "Flag not found: $FLAG_NAME" >&2
    exit 1
  fi
}

off() {
  rm -f "$FLAG_FILE"
}

toggle() {
  if [[ -f $FLAG_FILE ]]; then
    off
    echo "off"
  else
    on
    echo "on"
  fi
}

case $ACTION in
  on) on ;;
  off) off ;;
  toggle) toggle ;;
  *)
    usage
    exit 1
    ;;
esac

hyprctl reload >/dev/null
