#!/bin/bash

# nova:summary=Choose what the power button does: open the system menu, sleep, or shut down
# nova:args=[menu | sleep | off]
#
# Yours alone, so it asks for no password: logind leaves the key to the
# session, whose binding runs `nova power button press`. Held down for a few
# seconds the button still powers off in firmware, whatever is chosen. While
# the screen is locked a press opens nothing behind the lock: the menu and
# shutting down (which talks to you and closes windows) do nothing then, and
# sleep still sleeps, the lock staying up. With no argument it says which is
# set.

set -euo pipefail

CHOICE=${XDG_CONFIG_HOME:-$HOME/.config}/nova/power-button
usage() { echo "Usage: nova power button [menu | sleep | off]" >&2; }

# The shell's word on the lock: unlocked, locked, or none when it does not
# answer (gone, starting again, or stuck).
shell_says() {
  local status
  status=$(timeout 0.5s nova-shell lock status 2>/dev/null) || { echo none; return; }
  jq -r 'if .locked == false then "unlocked" elif .locked == true then "locked" else "none" end' <<<"$status" 2>/dev/null || echo none
}

# Whether the screen is open for what was chosen. Only the shell's "unlocked"
# opens it for the menu, which needs the shell to show it. Shutting down needs
# no shell: with none answering, the compositor's own word decides, unlocked
# only when it holds no session lock (nova-hyprland-session-locked exits 1);
# a lock a crashed shell left, or no telling, counts as locked.
open_for() { # choice
  local said code=0
  said=$(shell_says)
  [[ $said == unlocked ]] && return 0
  [[ $1 == off && $said == none ]] || return 1
  timeout 0.5s nova-hyprland-session-locked >/dev/null 2>&1 || code=$?
  ((code == 1))
}

current() {
  local choice=''
  [[ ! -r $CHOICE ]] || read -r choice <"$CHOICE" || true
  case $choice in sleep | off) echo "$choice" ;; *) echo menu ;; esac
}

case "$#:${1:-}" in
  0:) current ;;
  1:menu) rm -f -- "$CHOICE" ;;
  1:sleep | 1:off)
    mkdir -p "${CHOICE%/*}"
    printf '%s\n' "$1" >"$CHOICE"
    ;;
  1:press)
    choice=$(current)
    [[ $choice == sleep ]] && exec systemctl sleep
    open_for "$choice" || exit 0
    case $choice in
      off) exec nova-system-shutdown ;;
      *) exec nova-menu toggle system ;;
    esac
    ;;
  *) usage; exit 2 ;;
esac
