#!/bin/bash

# nova:summary=Print the most likely display backlight device.
# nova:hidden=true

set -euo pipefail

backlight_path="${NOVA_BACKLIGHT_PATH:-/sys/class/backlight}"

# Start with the first possible output, then refine to the most likely given an
# order heuristic. The globs are in the loop lists because [[ ]] does not do
# pathname expansion.
device=""
for candidate in "$backlight_path"/*; do
  if [[ -e $candidate ]]; then
    device="${candidate##*/}"
    break
  fi
done

for candidate in "$backlight_path"/amdgpu_bl* "$backlight_path"/intel_backlight "$backlight_path"/acpi_video*; do
  if [[ -e $candidate ]]; then
    device="${candidate##*/}"
    break
  fi
done

if [[ -n $device ]]; then
  printf '%s\n' "$device"
else
  exit 1
fi
