#!/bin/bash

# nova:summary=Monitor sleep preparation and lock before suspend
# nova:hidden=true
#
# Holds a logind delay inhibitor and watches PrepareForSleep; when the machine
# is about to suspend, nova-system-sleep-lock secures the session before the
# inhibitor is released (by this process exiting, after which systemd restarts
# it for the next sleep).

set -euo pipefail

here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")

consume_sleep_events() {
  local line

  while IFS= read -r line; do
    if [[ $line == *"boolean true"* ]]; then
      "$here/nova-system-sleep-lock" || true
      return 0
    fi
  done
}

monitor_sleep_events() {
  local monitor_fd monitor_pid status

  coproc SLEEP_EVENTS {
    exec dbus-monitor --system \
      "type='signal',sender='org.freedesktop.login1',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'"
  }
  monitor_fd=${SLEEP_EVENTS[0]}
  monitor_pid=$SLEEP_EVENTS_PID

  cleanup_monitor() {
    kill "$monitor_pid" 2>/dev/null || true
    wait "$monitor_pid" 2>/dev/null || true
  }
  trap cleanup_monitor EXIT

  status=0
  consume_sleep_events <&"$monitor_fd" || status=$?
  cleanup_monitor
  trap - EXIT

  return "$status"
}

case ${1:-} in
  --consume)
    consume_sleep_events
    exit 0
    ;;
  --inhibited)
    # The last suspend went without a secure lock: the screens stay off until
    # it is up. systemd restarts this as the machine goes down, so it may run
    # before the suspend or after it; --resumed holds on across it either way.
    if [[ -e ${XDG_RUNTIME_DIR:-/run/user/$UID}/nova/sleep-unsecured ]]; then
      "$here/nova-system-sleep-lock" --resumed </dev/null >/dev/null 2>&1 &
    fi
    monitor_sleep_events
    exit 0
    ;;
esac

exec systemd-inhibit \
  --what=sleep \
  --mode=delay \
  --who=Nova \
  --why="Lock screen before suspend" \
  "$here/nova-system-sleep-monitor" --inhibited
