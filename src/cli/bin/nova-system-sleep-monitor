#!/bin/bash

# nova:summary=Monitor sleep preparation and lock before suspend
# nova:hidden=true
#
# It holds a logind delay inhibitor and watches for PrepareForSleep: as the
# machine is about to suspend, nova-system-sleep-lock locks the session, and
# then this exits, which releases the inhibitor. systemd starts it again for
# the next suspend.
#
#   nova-system-sleep-monitor              takes the inhibitor, and runs
#   nova-system-sleep-monitor --inhibited  under it, watching
#   nova-system-sleep-monitor --consume    reads dbus-monitor's lines on stdin

set -euo pipefail

here=$(readlink -f "${BASH_SOURCE[0]}")
here=${here%/*}

# At the first PrepareForSleep(true) as dbus-monitor prints it, the lock, and
# done.
consume() {
  local line
  while IFS= read -r line; do
    if [[ $line == *"boolean true"* ]]; then
      "$here/nova-system-sleep-lock" || true
      return 0
    fi
  done
}

watcher=""
stop_watching() {
  kill "$watcher" 2>/dev/null || true
  wait "$watcher" 2>/dev/null || true
}

watch() {
  local status=0
  coproc events {
    exec dbus-monitor --system \
      "type='signal',sender='org.freedesktop.login1',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'"
  }
  # shellcheck disable=SC2154 # set by coproc
  watcher=$events_PID
  trap stop_watching EXIT
  consume <&"${events[0]}" || status=$?
  stop_watching
  trap - EXIT
  return "$status"
}

case ${1:-} in
  --consume)
    consume
    exit 0
    ;;
  --inhibited)
    # The last suspend went without a secure lock: the screens stay off until
    # it is up. systemd starts this again as the machine goes down, so it may
    # run before the suspend or after it; --resumed holds on across it either
    # way.
    if [[ -e ${XDG_RUNTIME_DIR:-/run/user/$UID}/nova/sleep-unsecured ]]; then
      "$here/nova-system-sleep-lock" --resumed </dev/null >/dev/null 2>&1 &
    fi
    watch
    exit 0
    ;;
esac

exec systemd-inhibit \
  --what=sleep \
  --mode=delay \
  --who=Nova \
  --why="Lock screen before suspend" \
  "$here/nova-system-sleep-monitor" --inhibited
