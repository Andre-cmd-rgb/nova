#!/bin/bash

# nova:summary=Lock the session before the computer sleeps
# nova:hidden=true
#
# logind says on the system bus as the machine is about to sleep
# (PrepareForSleep true) and once it has woken (false). While the machine is
# awake, this holds a delay inhibitor, so that logind waits, up to
# InhibitDelayMaxSec, for nova-system-sleep-lock to lock the session; then it
# lets it go, and the machine sleeps. logind takes a new inhibitor only once
# it has said the machine woke, and it is taken again then.

set -euo pipefail

unsecured=${XDG_RUNTIME_DIR:-/run/user/$UID}/nova/sleep-unsecured

# systemd-inhibit holds the inhibitor for as long as it runs, and its sleep
# ends with it. One at a time: a new one takes the place of the last.
inhibitor=""
hold() {
  let_go
  systemd-inhibit --what=sleep --mode=delay --who=Nova \
    --why="Locking the screen before sleep" sleep infinity &
  inhibitor=$!
}

let_go() {
  if [[ -z $inhibitor ]]; then return 0; fi
  kill "$inhibitor" 2>/dev/null || true
  wait "$inhibitor" 2>/dev/null || true
  inhibitor=""
}

# Woken from a sleep the lock was not up for: the screens stay off, and the
# lock is asked for again until it is (nova-system-sleep-lock --resumed).
relock() {
  if [[ -e $unsecured ]]; then
    nova-system-sleep-lock --resumed </dev/null >/dev/null 2>&1 &
  fi
}

trap let_go EXIT
relock

# gdbus says whose logind's name is once it watches for its signals, so a
# sleep logind waits for is never one this has not heard of. A new owner, a
# logind started again, gets an inhibitor of its own, in case the one held
# before went with the last.
while IFS= read -r line; do
  case $line in
    'The name org.freedesktop.login1 is owned by '*) hold ;;
    *'.Manager.PrepareForSleep (true,)')
      nova-system-sleep-lock || true
      let_go
      ;;
    *'.Manager.PrepareForSleep (false,)')
      relock
      hold
      ;;
  esac
done < <(gdbus monitor --system --dest org.freedesktop.login1 --object-path /org/freedesktop/login1)

echo "nova-system-sleep-monitor: gdbus stopped; no lock before sleep until it is back" >&2
exit 1
