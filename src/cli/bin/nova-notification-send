#!/bin/bash

# nova:summary=Send a Nova desktop notification
# nova:args=[--app-name <app-name>] [-g <glyph>] [-u <low|normal|critical>] [-i <icon>] [-t <ms>] [-r <id>] [-p] [--image <path-or-uri>] [--value <0-100>] [--button <words> | --buttons <json>] [--] <headline> [description] [--exec <program> [args...]]

# A notification's text can come from anywhere, a web page's title say, so none
# of it is ever taken for more than text: the headline and the description are
# the first two words that are no option (after --, the two words that follow,
# whatever they say), and what a click runs is only the words after --exec,
# which the shell runs as they are, never through a shell. --button puts that
# command on a button of its own as well, with those words on it ("Reopen");
# --buttons gives up to three, each with a command of its own, as JSON:
# [{"says": "Pair", "argv": ["nova-notification-iphone", "answer", "yes"], "main": true}].
# --value shows a bar, how far along something is.
#
# The commands do not travel in the notification, whose hints any program on
# the session bus may send, a sandboxed app's too: they go into a file of
# their own in Nova's runtime folder, $XDG_RUNTIME_DIR/nova/notifications/,
# which only the user's own programs see, under a random name that the
# notification's nova-command hint carries. The shell runs only what such a
# file says, and a notification that has one is Nova's own, which
# do-not-disturb lets through as nova-action (the shell's
# plugins/notifications/components/Commands.qml).

set -euo pipefail

usage() {
  echo "Usage: nova-notification-send [--app-name <app-name>] [-g <glyph>] [-u <low|normal|critical>] [-i <icon>] [-t <ms>] [-r <id>] [-p] [--image <path-or-uri>] [--value <0-100>] [--button <words> | --buttons <json>] [--] <headline> [description] [--exec <program> [args...]]" >&2
}

fail() {
  echo "nova-notification-send: $1" >&2
  exit 1
}

app_name=nova-action
glyph=''
icon=''
image=''
button=''
buttons=''
progress=''
urgency=low
expire=-1
replaces=0
print_id=false
click=()
clicks=false

# The variable an option with a value sets, into $setting.
setting_of() {
  case $1 in
    -g | --glyph) setting=glyph ;;
    -u | --urgency) setting=urgency ;;
    --app-name) setting=app_name ;;
    -i | --icon) setting=icon ;;
    --image) setting=image ;;
    --button) setting=button ;;
    --buttons) setting=buttons ;;
    --value) setting=progress ;;
    -r | --replace-id) setting=replaces ;;
    -t | --expire-time) setting=expire ;;
    *) return 1 ;;
  esac
}

# Whether a word is an option, or --exec.
is_option() {
  case $1 in
    -p | --print-id | --exec) return 0 ;;
    --?*=*) setting_of "${1%%=*}" ;;
    *) setting_of "$1" ;;
  esac
}

# Takes the option at the front of the arguments, as "--name value" or
# "--name=value", and leaves in $used the words it took; returns 1 for a word
# that is no option.
take() {
  local name=$1 value=${2-}
  used=2
  if [[ $name == --?*=* ]]; then
    value=${name#*=} name=${name%%=*} used=1
  fi
  if [[ $name == -p || $name == --print-id ]]; then
    print_id=true used=1
    return 0
  fi
  setting_of "$name" || return 1
  ((used == 1 || $# >= 2)) || fail "$name needs a value"
  case $setting in
    replaces) [[ $value =~ ^[0-9]+$ ]] || fail "$name takes a notification's id, not $value" ;;
    expire) [[ $value =~ ^-?[0-9]+$ ]] || fail "$name takes milliseconds, not $value" ;;
    progress) [[ $value =~ ^[0-9]{1,3}$ ]] && ((10#$value <= 100)) || fail "$name takes a percent from 0 to 100, not $value" ;;
  esac
  printf -v "$setting" '%s' "$value"
}

# Options, then the headline: the first word that is none, or the one after --.
while (($#)) && take "$@"; do shift "$used"; done
if (($#)) && [[ $1 == -- ]]; then
  # After --, the headline and the description, both given (the description
  # may be ""), whatever they say; then only --exec and its command.
  shift
  (($# >= 2)) || fail "-- takes the headline and the description, both"
  headline=$1 description=$2
  shift 2
  if (($#)) && [[ $1 != --exec ]]; then
    fail "after -- and the text, only --exec and its command: $1"
  fi
  if (($#)); then
    shift
    click=("$@") clicks=true
  fi
  set --
elif (($# == 0)); then
  usage
  exit 1
else
  headline=$1
  shift

  # The description is the next word, though it starts with a dash ("-50%
  # off"), unless it is an option or --exec.
  description=''
  if (($#)) && ! is_option "$1"; then
    description=$1
    shift
  fi
fi

# More options, then --exec and the command a click runs, a word each, to the
# end. --exec counts only here, after the text, so a headline "--exec" is text.
while (($#)); do
  if [[ $1 == --exec ]]; then
    shift
    click=("$@") clicks=true
    break
  fi
  if ! take "$@"; then
    echo "nova-notification-send: $1 is no option, and the text is two words at most" >&2
    usage
    exit 1
  fi
  shift "$used"
done

case $urgency in
  low) level=0 ;;
  normal) level=1 ;;
  critical) level=2 ;;
  *) fail "the urgency is low, normal or critical, not $urgency" ;;
esac

# The hints, an a{sv}, as busctl takes them: a name, a type and a value each.
hints=(urgency y "$level")
[[ -z $glyph ]] || hints+=(nova-glyph s "$glyph")
[[ -z $image ]] || hints+=(image-path s "$image")
[[ -z $progress ]] || hints+=(value i "$((10#$progress))")

# What the notification runs, as its file says it: {"argv": [...], "buttons":
# [...]}, each left out for none.
commands='{}'
argv=''
if $clicks; then
  ((${#click[@]})) && [[ -n ${click[0]} ]] || fail "--exec needs the command a click runs"
  # One word with a space in it is a whole command line, which would run a
  # program of that name. Splitting it here would let its text become
  # commands, so it is refused.
  if ((${#click[@]} == 1)) && [[ ${click[0]} == *[[:space:]]* ]]; then
    fail "--exec takes the command a word each, as in: --exec ${click[0]}"
  fi
  # The words go to jq NUL-separated, so a newline or a lone "--" in one stays
  # inside it.
  argv=$(printf '%s\0' "${click[@]}" | jq -Rsc 'split("\u0000")[:-1]')
  commands=$(jq -nc --argjson argv "$argv" '{argv: $argv}')
fi
if [[ -n $button && -n $buttons ]]; then
  fail "--button or --buttons, not both"
elif [[ -n $button ]]; then
  [[ -n $argv ]] || fail "--button needs --exec and the command its press runs"
  # The button, the toast's main one, runs what a click does.
  commands=$(jq -c --arg says "$button" --argjson argv "$argv" '. + {buttons: [{says: $says, argv: $argv, main: true}]}' <<<"$commands")
elif [[ -n $buttons ]]; then
  # Each button what it says and its own command, a program first, three at
  # most: as the shell shows them.
  commands=$(jq -ce --argjson buttons "$buttons" '
    def sound: type == "array" and length > 0 and all(.[]; type == "string") and (.[0] | . != "" and (startswith("-") | not));
    if ($buttons | type == "array" and length > 0 and length <= 3
        and all(.[]; type == "object" and (.says | type == "string" and test("\\S")) and (.argv | sound) and ((.main // false) | type == "boolean")))
    then . + {buttons: [$buttons[] | {says, argv, main: (.main // false)}]} else error("") end' <<<"$commands" 2>/dev/null) \
    || fail "--buttons takes a JSON list of up to three, each {\"says\": <words>, \"argv\": [<program>, <args>...], \"main\": true|false}"
fi

# The file, under 128 random bits: what the shell trusts is the folder, which
# no sandbox sees, and a name no one else can know. Without a runtime folder
# there is none, and a notification with a command cannot be sent; one with
# none goes all the same, as any app's would (do-not-disturb keeps it back).
folder=''
name=''
if [[ -n ${XDG_RUNTIME_DIR-} && -d $XDG_RUNTIME_DIR ]]; then
  folder=$XDG_RUNTIME_DIR/nova/notifications
  name=$(printf '%08x' "$SRANDOM" "$SRANDOM" "$SRANDOM" "$SRANDOM")
  if (umask 077 && mkdir -p -- "$folder" && printf '%s\n' "$commands" >"$folder/$name") 2>/dev/null; then
    hints+=(nova-command s "$name")
  elif [[ $commands != '{}' ]]; then
    fail "could not write into $folder"
  else
    echo "nova-notification-send: could not write into $folder; sent as any app's" >&2
    rm -f -- "$folder/$name" 2>/dev/null || true
    name=''
  fi
elif [[ $commands != '{}' ]]; then
  fail "a command needs Nova's runtime folder, and XDG_RUNTIME_DIR names none"
fi

# org.freedesktop.Notifications.Notify, susssasa{sv}i: the app's name, the id
# it replaces, the icon, the headline, the description, the actions (none), the
# hints and the timeout. busctl, not notify-send, as notify-send would read a
# headline such as "--hint=..." as an option of its own; busctl takes each value
# as one typed argument, and its "--" keeps one that starts with a dash a value.
notify=(
  busctl --user -- call
  org.freedesktop.Notifications /org/freedesktop/Notifications
  org.freedesktop.Notifications Notify 'susssasa{sv}i'
  "$app_name" "$replaces" "$icon" "$headline" "$description"
  0
  "$((${#hints[@]} / 3))" "${hints[@]}"
  "$expire"
)

# -p prints the new notification's id, for -r to replace it later; busctl
# answers "u <id>". A call that failed leaves no file behind.
if ! answer=$("${notify[@]}"); then
  [[ -z $name ]] || rm -f -- "$folder/$name"
  exit 1
fi
if $print_id; then
  echo "${answer##* }"
fi
