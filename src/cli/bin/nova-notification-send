#!/bin/bash

# nova:summary=Send a Nova desktop notification
# nova:args=[--app-name <app-name>] [-g <glyph>] [-u <low|normal|critical>] [-i <icon>] [-t <ms>] [-r <id>] [-p] [--image <path-or-uri>] <headline> [description] [--exec <program> [args...]]

set -euo pipefail

usage() {
  echo "Usage: nova-notification-send [--app-name <app-name>] [-g <glyph>] [-u <low|normal|critical>] [-i <icon>] [-t <ms>] [-r <id>] [-p] [--image <path-or-uri>] <headline> [description] [--exec <program> [args...]]" >&2
}

app_name=nova-action
icon=""
glyph=""
image=""
urgency=low
expire=-1
replaces=0
print_id=false
click=()
clickable=false

# Takes the option at the front of the arguments, as "--name value" or
# "--name=value", and leaves in $taken how many words it was; a word that is no
# option returns 1.
take_option() {
  local name=$1 value=${2-}
  taken=2
  if [[ $name == --?*=* ]]; then
    value=${name#*=} name=${name%%=*} taken=1
  fi
  case $name in
    -p | --print-id)
      print_id=true taken=1
      return 0
      ;;
    -g | --glyph | -u | --urgency | --app-name | -i | --icon | --image | -r | --replace-id | -t | --expire-time) ;;
    *) return 1 ;;
  esac
  if ((taken == 2 && $# < 2)); then
    echo "Missing value for $name" >&2
    exit 1
  fi
  case $name in
    -g | --glyph) glyph=$value ;;
    -u | --urgency) urgency=$value ;;
    --app-name) app_name=$value ;;
    -i | --icon) icon=$value ;;
    --image) image=$value ;;
    -r | --replace-id)
      if [[ ! $value =~ ^[0-9]+$ ]]; then
        echo "Invalid $name value (numeric id expected): $value" >&2
        exit 1
      fi
      replaces=$value
      ;;
    -t | --expire-time)
      if [[ ! $value =~ ^-?[0-9]+$ ]]; then
        echo "Invalid $name value (milliseconds expected): $value" >&2
        exit 1
      fi
      expire=$value
      ;;
  esac
}

# Options, up to the first word that is none: the headline.
while (($#)) && take_option "$@"; do shift "$taken"; done
if (($# == 0)); then
  usage
  exit 1
fi
headline=$1
shift

# The word after the headline is the description, though it starts with a dash
# ("-50% off" is text), unless it is one of the options or --exec.
description=""
if (($#)); then
  case $1 in
    -g | --glyph | -u | --urgency | --app-name | -i | --icon | -t | --expire-time | --image | -r | --replace-id | -p | --print-id | --exec) ;;
    --glyph=* | --urgency=* | --app-name=* | --icon=* | --expire-time=* | --image=* | --replace-id=*) ;;
    *)
      description=$1
      shift
      ;;
  esac
fi

# More options, then --exec and the command a click runs, one word each, to
# the end. --exec is looked for only here, after the text, so a headline that
# reads "--exec" stays a headline.
while (($#)); do
  if [[ $1 == --exec ]]; then
    shift
    click=("$@")
    clickable=true
    break
  fi
  if ! take_option "$@"; then
    echo "Unknown option: $1" >&2
    usage
    exit 1
  fi
  shift "$taken"
done

case $urgency in
  low) level=0 ;;
  normal) level=1 ;;
  critical) level=2 ;;
  *)
    echo "Unknown urgency: $urgency (use low, normal, or critical)" >&2
    exit 1
    ;;
esac

# The hints, a{sv}, as busctl writes them: a name, a type, a value.
hints=(urgency y "$level")
if [[ -n $glyph ]]; then hints+=(nova-glyph s "$glyph"); fi
if [[ -n $image ]]; then hints+=(image-path s "$image"); fi
if $clickable; then
  if ((${#click[@]} == 0)) || [[ -z ${click[0]} ]]; then
    echo "--exec needs a command: --exec <program> [args...]" >&2
    exit 1
  fi
  # A command in one quoted word would run a program of that whole name. It
  # is refused rather than split, as splitting it here would let its text
  # become commands.
  if ((${#click[@]} == 1)) && [[ ${click[0]} == *[[:space:]]* ]]; then
    echo "--exec takes the command as separate words, not one quoted string." >&2
    echo "Write:  --exec ${click[0]}" >&2
    exit 1
  fi
  # The shell runs the words as they are, never through a shell. They reach
  # jq NUL-separated, so a newline or a lone "--" in one stays inside it.
  hints+=(nova-exec-argv s "$(printf '%s\0' "${click[@]}" | jq -Rsc 'split("\u0000")[:-1]')")
fi

# org.freedesktop.Notifications.Notify (susssasa{sv}i: app name, the id to
# replace, icon, summary, body, actions, hints, timeout), called through busctl
# rather than notify-send, which reads a headline such as "--hint=..." as one
# of its options. busctl takes each value as one typed argument, and its "--"
# keeps one that starts with a dash from being taken for an option of its own.
notify=(
  busctl --user -- call
  org.freedesktop.Notifications /org/freedesktop/Notifications
  org.freedesktop.Notifications Notify 'susssasa{sv}i'
  "$app_name" "$replaces" "$icon" "$headline" "$description"
  0
  "$((${#hints[@]} / 3))" "${hints[@]}"
  "$expire"
)

# -p prints the new notification's id, which -r can replace later; busctl
# answers "u <id>".
if $print_id; then
  id=$("${notify[@]}")
  echo "${id##* }"
else
  "${notify[@]}" >/dev/null
fi
