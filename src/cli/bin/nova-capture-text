#!/bin/bash

# nova:summary=Extract text from a screenshot region with OCR

set -euo pipefail

PID=""

# Keep hyprpicker alive until after grim captures so the screenshot sees the
# frozen overlay rather than live content shifting during teardown.
cleanup_freeze() {
  if [[ -n $PID ]]; then
    kill "$PID" 2>/dev/null || true
  fi
}
trap cleanup_freeze EXIT

hyprpicker -r -z >/dev/null 2>&1 &
PID=$!
sleep .1

# slurp exits non-zero when the pick is cancelled, which just means nothing to do.
SELECTION=$(slurp 2>/dev/null || true)
if [[ -z $SELECTION ]]; then
  exit 0
fi

TEXT=$(grim -g "$SELECTION" - | tesseract stdin stdout --oem 1 --psm 6 -l "${NOVA_OCR_LANGS:-eng}" --dpi 300 -c preserve_interword_spaces=1 2>/dev/null) || exit 1

[[ -n $TEXT ]] || exit 1

printf "%s" "$TEXT" | wl-copy
nova-notification-send -g 󰴑 "Copied text from selection to clipboard"
