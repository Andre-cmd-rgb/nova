#!/bin/bash

# nova:summary=Extract text from a screenshot region with OCR

set -euo pipefail

# The screen is frozen (hyprpicker) until grim has taken the region, so that
# it takes the still, not the screen moving as the freeze ends.
freezer=""
unfreeze() {
  if [[ -n $freezer ]]; then kill "$freezer" 2>/dev/null || true; fi
}
trap unfreeze EXIT
hyprpicker -r -z >/dev/null 2>&1 &
freezer=$!
sleep .1

# slurp fails when the pick is given up, and then there is nothing to do.
picked=$(slurp 2>/dev/null || true)
[[ -n $picked ]] || exit 0

text=$(grim -g "$picked" - | tesseract stdin stdout --oem 1 --psm 6 -l "${NOVA_OCR_LANGS:-eng}" --dpi 300 -c preserve_interword_spaces=1 2>/dev/null) || exit 1
[[ -n $text ]] || exit 1

printf '%s' "$text" | wl-copy
nova-notification-send -g 󰴑 "Copied text from selection to clipboard"
