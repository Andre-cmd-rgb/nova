#!/bin/bash

# nova:summary=Extract text from a screenshot region with OCR

set -euo pipefail

# A region drawn on the still of the screen, as a screenshot's is
# (nova-capture-region); the still stays until grim has the region, so that
# it takes the still, not the screen moving as the freeze ends, and goes
# before the text is read.
freezer="" picked="" shot=""
thaw() {
  [[ -z $freezer ]] || nova-capture-region --thaw "$freezer"
  freezer=""
}
trap 'thaw; [[ -z $shot ]] || rm -f -- "$shot"' EXIT
{ read -r freezer && read -r picked; } < <(nova-capture-region region --keep-freeze) || true
# A pick given up: nothing to do.
[[ -n $picked ]] || exit 0

shot=$(mktemp --suffix=.png)
grim -g "$picked" "$shot"
thaw
text=$(tesseract "$shot" stdout --oem 1 --psm 6 -l "${NOVA_OCR_LANGS:-eng}" --dpi 300 -c preserve_interword_spaces=1 2>/dev/null) || exit 1
[[ -n $text ]] || exit 1

printf '%s' "$text" | wl-copy
nova-notification-send -g 󰴑 "Copied text from selection to clipboard"
