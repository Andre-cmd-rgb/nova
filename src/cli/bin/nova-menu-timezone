#!/bin/bash

# nova:summary=Select and set the system timezone
# nova:group=menu
# nova:name=timezone

set -e

timezone=$(timedatectl list-timezones | nova-menu-select "Set timezone" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
nova-shell -q nova.clock refresh
nova-notification-send "Timezone is now set to $timezone"
