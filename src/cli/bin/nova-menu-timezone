#!/bin/bash

# nova:summary=Select and set the system timezone

set -euo pipefail

timezone=$(timedatectl list-timezones | nova-menu-select "Set timezone" -- --width 520 --maxheight 520) || exit 0
[[ -n $timezone ]] || exit 0
# timedated asks for authorization through polkit.
timedatectl set-timezone "$timezone"
nova-shell -q nova.clock refresh
nova-notification-send "Timezone is now set to $timezone"
