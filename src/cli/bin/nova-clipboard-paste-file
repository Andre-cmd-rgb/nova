#!/bin/bash

# nova:summary=Copy a file to the clipboard and paste it
# nova:args=[--copy-only] <mime-type> <path>
# nova:hidden=true

set -euo pipefail

copy_only=false

if [[ ${1:-} == "--copy-only" ]]; then
  copy_only=true
  shift
fi

mime=${1:-}
path=${2:-}

if [[ -z $mime || -z $path ]]; then
  echo "Usage: nova-clipboard-paste-file [--copy-only] <mime-type> <path>" >&2
  exit 1
fi

[[ -r $path ]] || exit 1

wl-copy --type "$mime" <"$path"

if [[ $copy_only == "true" ]]; then
  exit 0
fi

sleep 0.15
# Best effort: with no focused text field there is nothing to paste into.
wtype -M shift -k Insert -m shift 2>/dev/null || true
