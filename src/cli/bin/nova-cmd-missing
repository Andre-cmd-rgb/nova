#!/bin/bash

# nova:summary=Check whether any required commands are missing
# nova:args=<command>...
# nova:hidden=true

set -euo pipefail

# True at the first name that is not a command; false when every one is, or
# when none was given.
for name; do
  command -v -- "$name" >/dev/null 2>&1 || exit 0
done
exit 1
