#!/bin/bash

# nova:summary=Show, set, or adjust focused Hyprland monitor scaling
# nova:args=[up|down|SCALE]

set -euo pipefail

# The steps up and down go through.
presets="1 1.25 1.6 2 3 4"

usage() {
  echo "Usage: nova-hyprland-monitor-scaling [up|down|SCALE]"
}

# The focused display: its scale, width, height, refresh rate and name. None
# focused, and this stops here. The name comes last, as read merges the tabs
# around an empty field, and whole, spaces and all, to be refused.
focused() {
  IFS=$'\t' read -r scale width height rate monitor < <(
    hyprctl monitors -j |
      jq -er '.[] | select(.focused == true) | [.scale, .width, .height, .refreshRate, .name] | @tsv'
  )
}

# Hyprland only takes a scale that divides the mode into whole logical pixels,
# in steps of 1/120: a divisor of the greatest common divisor of width × 120
# and height × 120. The scale asked for goes up to the next one of those.
# Shared by the awk programs below.
usable_scale='
  function gcd(a, b) { return b ? gcd(b, a % b) : a }
  function usable(scale,    whole, steps) {
    whole = gcd(width * 120, height * 120)
    steps = int(scale * 120 + 0.5)
    if (steps > whole) steps = whole
    while (whole % steps) steps++
    return steps / 120
  }'

# The preset a step lands on. Presets that come out as the same usable scale
# count once, under the one nearest to it, so each step changes something.
# The current scale is matched to the nearest: Hyprland reports floats.
step_to() { # next|previous
  awk -v direction="$1" -v presets="$presets" -v current="$scale" -v width="$width" -v height="$height" \
    "$usable_scale"'
    BEGIN {
      count = split(presets, preset, " ")
      for (i = 1; i <= count; i++) {
        takes = usable(preset[i])
        key = sprintf("%.8f", takes)
        off = preset[i] - takes
        if (off < 0) off = -off
        if (!(key in slot)) {
          slot[key] = ++n
          scale_at[n] = takes
          label[n] = preset[i]
          off_at[n] = off
        } else if (off < off_at[slot[key]]) {
          label[slot[key]] = preset[i]
          off_at[slot[key]] = off
        }
      }

      nearest = 1
      best = 1e9
      for (i = 1; i <= n; i++) {
        d = current - scale_at[i]
        if (d < 0) d = -d
        if (d < best) { best = d; nearest = i }
      }

      # In parentheses, or print would take the > for a redirection.
      if (direction == "next") print label[(nearest < n ? nearest + 1 : n)]
      else print label[(nearest > 1 ? nearest - 1 : 1)]
    }'
}

# A line for each change in the log, with the processes that asked for it:
# scales have changed when nobody meant them to.
command_line() { # pid → REPLY
  local -a words=()
  REPLY=""
  [[ -r /proc/$1/cmdline ]] || return 0
  mapfile -d '' -t words <"/proc/$1/cmdline"
  REPLY=${words[*]}
  REPLY=${REPLY//[[:space:]]/ }
  while [[ $REPLY == *"  "* ]]; do REPLY=${REPLY//"  "/ }; done
  REPLY=${REPLY% }
}

log_change() { # asked new
  local log=${XDG_STATE_HOME:-$HOME/.local/state}/nova/monitor-scaling.log
  local now stat grandparent="" parent_line
  mkdir -p "${log%/*}" || return 0

  printf -v now '%(%Y-%m-%dT%H:%M:%S%z)T' -1
  now=${now:0:-2}:${now: -2}
  # A parent that has exited by now leaves blanks.
  if read -r stat 2>/dev/null <"/proc/$PPID/stat"; then
    read -r _ grandparent _ <<<"${stat##*) }"
  fi
  command_line "$PPID"
  parent_line=$REPLY
  command_line "$grandparent"

  printf 'at=%s\trequested=%s\tcurrent=%s\tnew=%s\tmonitor=%s\tpid=%s\tppid=%s\tparent=%s\tgppid=%s\tgrandparent=%s\n' \
    "$now" "$1" "$scale" "$2" "$monitor" "$$" "$PPID" "$parent_line" "$grandparent" "$REPLY" >>"$log"
}

set_scale() { # scale asked
  local new gdk lua=$HOME/.config/hypr/monitors.lua

  # The name goes into the Lua Hyprland runs, so only a plain connector name.
  if [[ ! $monitor =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "Refusing unsafe monitor name" >&2
    exit 1
  fi

  # GTK takes whole scales only, so GDK_SCALE is the nearest whole one.
  new=$(awk -v asked="$1" -v width="$width" -v height="$height" "$usable_scale"'
    BEGIN { s = sprintf("%g", usable(asked)); printf "%s %d\n", s, int(s + 0.5) }')
  read -r new gdk <<<"$new"

  hyprctl eval "hl.monitor({ output = \"$monitor\", mode = \"${width}x${height}@${rate}\", position = \"auto\", scale = $new })" >/dev/null
  log_change "$2" "$new" || true
  # A display Settings → Displays keeps settings for keeps this scale there,
  # or its rule would bring back the old one at the next reload.
  nova-monitor remember "$monitor" scale "$new" 2>/dev/null || true

  # A monitors.lua still on Nova's catch-all rule takes the scale too, so it
  # lasts past a restart.
  [[ -f $lua ]] || return 0
  if grep -q '^local nova_monitor_scale = ' "$lua"; then
    sed -i -E \
      -e "s|^local nova_monitor_scale = .*|local nova_monitor_scale = $new|" \
      -e "s|^local nova_gdk_scale = .*|local nova_gdk_scale = $gdk|" \
      "$lua"
  elif grep -Eq '^hl\.monitor\(\{ output = "", mode = "preferred", position = "auto", scale = ("auto"|[0-9.]+) \}\)' "$lua"; then
    sed -i -E \
      -e 's|^(hl\.monitor\(\{ output = "", mode = "preferred", position = "auto", scale = )[^ ]+( \}\))|\1'"$new"'\2|' \
      -e 's|^hl\.env\("GDK_SCALE", ".*"\)|hl.env("GDK_SCALE", "'"$gdk"'")|' \
      "$lua"
  fi
}

case ${1:-} in
  "")
    hyprctl monitors -j | jq -er '.[] | select(.focused == true) | .scale' | awk 'NR == 1 { printf "%g\n", $0 }'
    ;;
  -h | --help) usage ;;
  up | down)
    focused
    if [[ $1 == up ]]; then to=$(step_to next); else to=$(step_to previous); fi
    set_scale "$to" "$1"
    ;;
  *)
    if [[ ! $1 =~ ^[0-9]+([.][0-9]+)?$ ]] || ! awk -v scale="$1" 'BEGIN { exit !(scale >= 1 && scale <= 4) }'; then
      usage >&2
      exit 1
    fi
    focused
    set_scale "$1" "$1"
    ;;
esac
