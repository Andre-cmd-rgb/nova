#!/bin/bash

# nova:summary=Scale text everywhere: the shell, GTK apps and the terminal
# nova:args=[size|reset]
# nova:examples=nova display text-size | nova display text-size 14 | nova display text-size reset
#
# One knob for apparent text size, anchored to the shell's default of 12 px:
#   the shell's [font] base-size in ~/.config/nova/shell.toml (watched live)
#   GTK's text-scaling-factor, 12 px = 1.0, quantized so the interface font
#     lands on a whole point size (fractional sizes clip in GTK4 menus)
#   foot's font size, 12 px = 9 pt
# Sizes run from 9 to 20 px.

set -euo pipefail

min=9 max=20 default_px=12 default_pt=9
shell_config="$HOME/.config/nova/shell.toml"
foot_config="$HOME/.config/foot/foot.ini"
schema=org.gnome.desktop.interface

usage() {
  echo "Usage: nova-display-text-size [size|reset]" >&2
  exit 2
}

current_base_size() {
  [[ -f $shell_config ]] || return 0
  awk '
    /^[[:space:]]*\[/ { in_font = ($0 ~ /^[[:space:]]*\[font\]([[:space:]]|$)/); next }
    in_font && /^[[:space:]]*base-size[[:space:]]*=/ {
      v = $0; sub(/^[^=]*=[[:space:]]*/, "", v); sub(/[[:space:]]*(#.*)?$/, "", v); print v; exit
    }' "$shell_config"
}

# Sets base-size under [font], or removes it when called with no size. Other
# sections and keys are left alone.
write_base_size() {
  local size=${1:-}
  mkdir -p "${shell_config%/*}"
  [[ -f $shell_config ]] || : >"$shell_config"
  awk -v val="$size" '
    function emit() { if (val != "") print "base-size = " val; done = 1 }
    /^[[:space:]]*\[/ {
      if (in_font && !done) emit()
      in_font = ($0 ~ /^[[:space:]]*\[font\]([[:space:]]|$)/)
      print; next
    }
    in_font && /^[[:space:]]*base-size[[:space:]]*=/ { if (!done) emit(); next }
    { print }
    END {
      if (in_font && !done) emit()
      if (!done && val != "") { if (NR > 0) print ""; print "[font]"; emit() }
    }' "$shell_config" >"$shell_config.tmp"
  mv "$shell_config.tmp" "$shell_config"
}

# Foot reads its size at startup only, so open windows keep theirs; one toast
# (replaced, not stacked, while a slider is dragged) says so.
set_foot_size() {
  local pt=$1 id_file="${XDG_RUNTIME_DIR:-/tmp}/nova/text-size.notification" id="" new_id
  [[ -f $foot_config ]] || return 0
  sed -i -E "s/^(font=[^:]*):size=[0-9.]+/\1:size=$pt/" "$foot_config"
  pgrep -u "$UID" -x foot >/dev/null || return 0
  if [[ -f $id_file ]]; then read -r id <"$id_file" || true; fi
  local replace=()
  if [[ $id =~ ^[0-9]+$ ]]; then replace=(-r "$id"); fi
  new_id=$(nova-notification-send "New terminal windows use the new text size" "${replace[@]}" -p 2>/dev/null || true)
  if [[ $new_id =~ ^[0-9]+$ ]]; then
    mkdir -p "${id_file%/*}"
    printf '%s\n' "$new_id" >"$id_file"
  fi
}

case ${1:-} in
  "")
    printf 'text size: %s px\ngtk text-scaling-factor: %s\n' \
      "$(current_base_size || true)" "$(gsettings get "$schema" text-scaling-factor 2>/dev/null || echo n/a)"
    exit 0
    ;;
  reset)
    write_base_size ""
    gsettings reset "$schema" text-scaling-factor 2>/dev/null || true
    set_foot_size "$default_pt"
    exit 0
    ;;
  *[!0-9]*) usage ;;
esac

size=$1
((size >= min && size <= max)) || { echo "nova-display-text-size: size must be $min-$max px" >&2; exit 2; }

write_base_size "$size"

font=$(gsettings get "$schema" font-name 2>/dev/null || true)
font_pt=${font%\'}
font_pt=${font_pt##* }
[[ $font_pt =~ ^[0-9]+(\.[0-9]+)?$ ]] || font_pt=11
factor=$(awk -v s="$size" -v b="$default_px" -v f="$font_pt" 'BEGIN { printf "%.4f", int(f * s / b + 0.5) / f }')
gsettings set "$schema" text-scaling-factor "$factor" 2>/dev/null || true

set_foot_size "$(((size * default_pt + default_px / 2) / default_px))"
