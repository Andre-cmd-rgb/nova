#!/bin/bash

# nova:summary=Toggle bar visibility without restarting the Nova shell
# nova:args=[toggle|on|off]

set -euo pipefail

# The bar is hidden while the flag bar-off is set: the bar on is the flag off.
case ${1:-toggle} in
  toggle) flag=toggle ;;
  on) flag=off ;;
  off) flag=on ;;
  *)
    echo "Usage: nova-toggle-bar [toggle|on|off]" >&2
    exit 2
    ;;
esac
nova-toggle bar-off "$flag"

# The shell watches the toggles directory, but changes close together can slip
# past it and leave the bar off screen until the shell restarts, so it is told
# to look again. Without a shell running there is no one to tell, and the flag
# is set all the same.
nova-shell -q nova.bar syncHidden
