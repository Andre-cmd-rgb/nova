#!/bin/bash

# nova:summary=Toggle bar visibility without restarting the Nova shell
# nova:args=[toggle|on|off]

set -euo pipefail

# The flag hides the bar, so "on" for the bar is "off" for the flag.
case ${1:-toggle} in
  toggle) action=toggle ;;
  on) action=off ;;
  off) action=on ;;
  *)
    echo "Usage: nova-toggle-bar [toggle|on|off]" >&2
    exit 2
    ;;
esac
nova-toggle bar-off "$action"

# The shell's watch on the toggles directory can miss flag changes that land in
# quick succession, stranding the bar off screen until the shell restarts.
# Nudge the bar to re-read the flag; best effort, so the toggle still works
# when the shell is not up.
nova-shell -q nova.bar syncHidden
