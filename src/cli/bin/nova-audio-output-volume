#!/bin/bash

# nova:summary=Turn the output volume up or down, or mute it, and show it in the OSD
# nova:args=<raise|lower|mute-toggle|+N|-N>

set -euo pipefail

action=${1:-}
if [[ -z $action ]]; then
  echo "Usage: nova-audio-output-volume <raise|lower|mute-toggle|+N|-N>" >&2
  exit 1
fi

# The sink under any filter in front of the output (nova-audio-output-sink):
# the volume moves how loud it is, and the filter keeps getting its input at
# full scale.
sink=$(nova-audio-output-sink)
if [[ -z $sink ]]; then
  echo "Could not resolve an audio sink to control." >&2
  exit 1
fi

# The volume as a percentage, the first "N%" pactl gives (its scale is
# wpctl's, so the OSD reads the same either way); nothing when it cannot say.
volume() {
  local words word
  read -r -a words < <(pactl get-sink-volume "$sink" 2>/dev/null) || true
  for word in "${words[@]}"; do
    if [[ $word == *% ]]; then
      echo "${word/\%/}"
      return
    fi
  done
}

case $action in
  raise) action=+5 ;;
  lower) action=-5 ;;
esac

if [[ $action == mute-toggle ]]; then
  # A key that sends its press twice, within a quarter of a second, toggles once.
  last_file=${XDG_RUNTIME_DIR:-/tmp}/nova/audio-mute-toggle.last
  mkdir -p "${last_file%/*}"
  now=$((10#${EPOCHREALTIME//[!0-9]/} / 1000))
  last=0
  if [[ -r $last_file ]]; then
    read -r last <"$last_file" || last=0
  fi
  ((now - last >= 250)) || exit 0
  echo "$now" >"$last_file"
  pactl set-sink-mute "$sink" toggle
elif [[ $action =~ ^([+-])([0-9]+)$ ]]; then
  sign=${BASH_REMATCH[1]} step=${BASH_REMATCH[2]}
  now=$(volume)
  if [[ -z $now ]]; then
    echo "Could not read volume for $sink." >&2
    exit 1
  fi
  # Up stops at 100%, down at 0; a volume set above 100% elsewhere comes down
  # a step at a time. Changing it unmutes.
  if [[ $sign == + ]]; then
    target=$((now + step))
    ((target <= 100)) || target=100
  else
    target=$((now - step))
    ((target >= 0)) || target=0
  fi
  pactl set-sink-mute "$sink" 0
  pactl set-sink-volume "$sink" "$target%"
else
  echo "Unknown volume action: $action" >&2
  exit 1
fi

percent=$(volume)
if [[ $(pactl get-sink-mute "$sink" 2>/dev/null || true) == *yes ]] || ((${percent:-0} == 0)); then
  icon=volume-muted
else
  icon=volume-high
fi
nova-osd -i "$icon" -p "${percent:-0}"
