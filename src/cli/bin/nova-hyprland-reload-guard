#!/bin/bash

# nova:summary=Pause or resume Hyprland config auto-reload around package transactions
# nova:hidden=true

set -euo pipefail

# As root, no NOVA_ variable is read, here or by what this runs: they are
# test seams (tests/unit/tools/installed-tree.bats).
if ((EUID == 0)); then for seam in $(compgen -e -X '!NOVA_*'); do unset "$seam"; done; fi

# pacman's hooks run this as root before and after a transaction. Hyprland
# reloads its config when one of its files changes, and an update replaces
# Nova's one at a time: every running Hyprland is told to stop reloading, and
# to keep quiet about errors, until the update is done, then reloads once.
# What each had set before is kept in a file of its own under the state
# directory, so a second pause keeps the first's.

run=${NOVA_HYPRLAND_RELOAD_GUARD_RUN_ROOT:-/run/user}
state=${NOVA_HYPRLAND_RELOAD_GUARD_STATE_DIR:-/run/nova/hyprland-reload-guard}
hyprctl=${HYPRCTL:-/usr/bin/hyprctl}

# A command as the owner of a runtime directory, which is named for its
# owner's uid, or not at all. Never as root: the sockets in there are the
# user's, and whatever answers on them, or wherever they lead, is too.
as_owner() { # runtime-dir command...
  local uid gid
  read -r uid gid < <(stat -c '%u %g' -- "$1" 2>/dev/null) || return 1
  [[ ${1##*/} == "$uid" ]] || return 1
  if ((EUID == uid)); then
    "${@:2}"
  elif ((EUID == 0)); then
    setpriv --reuid="$uid" --regid="$gid" --init-groups --no-new-privs --reset-env -- "${@:2}"
  else
    return 1
  fi
}

# hyprctl for one running Hyprland: a user's runtime directory and the
# instance's signature. hyprctl waits on a Hyprland that has stopped
# answering, and this runs inside pacman's transaction, holding its lock.
in_session() { # runtime-dir signature args...
  as_owner "$1" env XDG_RUNTIME_DIR="$1" timeout 3 "$hyprctl" --instance "$2" "${@:3}"
}

# Settings told to one, which it may take or not: nothing waits on the answer.
tell() { # runtime-dir signature lua
  in_session "$1" "$2" eval "hl.config({ $3 })" >/dev/null 2>&1 || true
}

# An option's true or false, and nothing else: it is put back as Lua. An
# instance that has gone prints "Couldn't connect ..." to stdout, so jq is
# silenced too, and the pipeline fails.
option() { # runtime-dir signature option
  local value
  value=$(in_session "$1" "$2" -j getoption "$3" 2>/dev/null | jq -r '.bool' 2>/dev/null) || return 1
  [[ $value == true || $value == false ]] || return 1
  printf '%s\n' "$value"
}

# Each session is a directory <run>/<uid>/hypr/<signature>. Its kept file
# holds its runtime directory, then what disable_autoreload and
# suppress_errors were, a tab between each.
pause() {
  local session runtime signature kept was
  for session in "$run"/*/hypr/*; do
    [[ -d $session ]] || continue
    signature=${session##*/}
    runtime=${session%/hypr/*}
    [[ ${runtime##*/} =~ ^[0-9]+$ ]] || continue
    mkdir -p "$state"
    kept=$state/$signature
    if [[ ! -f $kept ]]; then
      was=$runtime
      was+=$'\t'$(option "$runtime" "$signature" misc.disable_autoreload) || continue
      was+=$'\t'$(option "$runtime" "$signature" debug.suppress_errors) || continue
      echo "$was" >"$kept"
    fi
    tell "$runtime" "$signature" 'misc = { disable_autoreload = true }, debug = { suppress_errors = true }'
  done
}

# The reload comes before auto-reload is back, so it is the only one, and
# errors are shown again for it. A session that has ended since has nothing
# to put back.
resume() {
  local kept runtime no_reload quiet signature
  for kept in "$state"/*; do
    [[ -f $kept ]] || continue
    signature=${kept##*/}
    if IFS=$'\t' read -r runtime no_reload quiet <"$kept" && [[ -d $runtime ]] &&
      [[ $no_reload =~ ^(true|false)$ && $quiet =~ ^(true|false)$ ]]; then
      tell "$runtime" "$signature" "debug = { suppress_errors = $quiet }"
      in_session "$runtime" "$signature" reload >/dev/null 2>&1 || true
      tell "$runtime" "$signature" "misc = { disable_autoreload = $no_reload }, debug = { suppress_errors = $quiet }"
    fi
    rm -f "$kept"
  done
  rmdir "$state" 2>/dev/null || true
}

case ${1:-} in
  pause) pause ;;
  resume) resume ;;
  paused) compgen -G "$state/*" >/dev/null ;;
  *)
    echo "Usage: nova-hyprland-reload-guard pause|resume|paused" >&2
    exit 1
    ;;
esac
