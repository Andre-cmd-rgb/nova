#!/bin/bash

# nova:summary=Pause or resume Hyprland config auto-reload around package transactions
# nova:hidden=true

set -euo pipefail

# pacman's hooks run this as root before and after a transaction. Hyprland
# reloads its config when one of its files changes, and an update replaces
# Nova's one at a time: every running Hyprland is told to stop reloading, and
# to keep quiet about errors, until the update is done, then reloads once.
# What each had set before is kept in a file of its own under the state
# directory, so a second pause keeps the first's.

case ${1:-} in
  pause | resume | paused) ;;
  *)
    echo "Usage: nova-hyprland-reload-guard pause|resume|paused" >&2
    exit 1
    ;;
esac

run=${NOVA_HYPRLAND_RELOAD_GUARD_RUN_ROOT:-/run/user}
state=${NOVA_HYPRLAND_RELOAD_GUARD_STATE_DIR:-/run/nova/hyprland-reload-guard}
hyprctl=${HYPRCTL:-/usr/bin/hyprctl}

# hyprctl for one running Hyprland: a user's runtime directory and the
# instance's signature. hyprctl waits on a Hyprland that has stopped
# answering, and this runs inside pacman's transaction, holding its lock.
in_session() { # runtime-dir signature args...
  XDG_RUNTIME_DIR=$1 timeout 3 "$hyprctl" --instance "$2" "${@:3}"
}

# An option's true or false. An instance that has gone prints "Couldn't
# connect ..." to stdout, so jq is silenced too, and the pipeline fails.
option() { # runtime-dir signature option
  in_session "$1" "$2" -j getoption "$3" 2>/dev/null | jq -r '.bool' 2>/dev/null
}

pause() {
  local session runtime signature autoreload quiet kept
  # Each session is a directory <run>/<uid>/hypr/<signature>.
  for session in "$run"/*/hypr/*; do
    [[ -d $session ]] || continue
    signature=${session##*/}
    runtime=${session%/hypr/*}
    [[ ${runtime##*/} =~ ^[0-9]+$ ]] || continue

    mkdir -p "$state"
    kept=$state/$signature
    if [[ ! -f $kept ]]; then
      autoreload=$(option "$runtime" "$signature" misc.disable_autoreload) || continue
      quiet=$(option "$runtime" "$signature" debug.suppress_errors) || continue
      printf '%s\t%s\t%s\n' "$runtime" "$autoreload" "$quiet" >"$kept"
    fi
    in_session "$runtime" "$signature" eval \
      'hl.config({ misc = { disable_autoreload = true }, debug = { suppress_errors = true } })' \
      >/dev/null 2>&1 || true
  done
}

# The reload comes before auto-reload is back, so it is the only one, and
# errors are shown again for it.
resume() {
  local kept runtime autoreload quiet signature
  [[ -d $state ]] || return 0
  for kept in "$state"/*; do
    [[ -f $kept ]] || continue
    signature=${kept##*/}
    IFS=$'\t' read -r runtime autoreload quiet <"$kept" || continue
    # A session that has ended since has nothing to put back.
    if [[ -d $runtime ]]; then
      in_session "$runtime" "$signature" eval "hl.config({ debug = { suppress_errors = $quiet } })" >/dev/null 2>&1 || true
      in_session "$runtime" "$signature" reload >/dev/null 2>&1 || true
      in_session "$runtime" "$signature" eval \
        "hl.config({ misc = { disable_autoreload = $autoreload }, debug = { suppress_errors = $quiet } })" \
        >/dev/null 2>&1 || true
    fi
    rm -f "$kept"
  done
  rmdir "$state" 2>/dev/null || true
}

case $1 in
  pause) pause ;;
  resume) resume ;;
  paused) compgen -G "$state/*" >/dev/null ;;
esac
