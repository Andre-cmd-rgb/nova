#!/bin/bash

# nova:summary=Show or set the battery's power mode; plugged in, it is always full power
# nova:args=get | list [--active-state] | set <profile> | restore
#
# Talks to power-profiles-daemon over D-Bus. The modes are for the battery:
# plugged in there is no battery to spare, so it is always performance, and
# there is nothing to choose (list offers nothing). `set` remembers the
# battery's mode, and plugged in only remembers it; `restore` (run by the shell
# on plug and unplug, and at login) puts back performance plugged in, and the
# battery's mode, balanced until one is chosen, on battery. Where Nova's power
# governor runs, the battery's mode is how high it climbs (docs/power.md).

set -euo pipefail

state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/nova/power-profile
readonly ppd=(org.freedesktop.UPower.PowerProfiles /org/freedesktop/UPower/PowerProfiles org.freedesktop.UPower.PowerProfiles)

usage() {
  echo "Usage: nova-power-profile get | list [--active-state] | set <profile> | restore" >&2
  exit 2
}

profiles() {
  busctl --system --json=short get-property "${ppd[@]}" Profiles 2>/dev/null |
    jq -r '.data[].Profile.data'
}

active() {
  busctl --system --json=short get-property "${ppd[@]}" ActiveProfile 2>/dev/null | jq -r '.data'
}

source_name() {
  if [[ $(busctl --system get-property org.freedesktop.UPower /org/freedesktop/UPower \
    org.freedesktop.UPower OnBattery 2>/dev/null || true) == "b true" ]]; then
    echo battery
  else
    echo ac
  fi
}

apply() {
  busctl --system set-property "${ppd[@]}" ActiveProfile s "$1"
}

available() {
  local want=$1 p
  while IFS= read -r p; do [[ $p == "$want" ]] && return 0; done < <(profiles)
  return 1
}

case ${1:-} in
  get)
    (($# == 1)) || usage
    current=$(active) && [[ -n $current ]] || { echo "nova-power-profile: power-profiles-daemon is not running" >&2; exit 1; }
    echo "$current"
    ;;
  list)
    [[ $# == 1 || ($# == 2 && $2 == --active-state) ]] || usage
    if [[ $(source_name) == ac ]]; then
      echo "Plugged in, it is always full power: the modes are for the battery." >&2
      exit 1
    fi
    list=$(profiles) && [[ -n $list ]] || { echo "nova-power-profile: power-profiles-daemon is not running" >&2; exit 1; }
    if (($# == 2)); then
      current=$(active || true)
      while IFS= read -r p; do
        if [[ $p == "$current" ]]; then printf '%s\t1\n' "$p"; else printf '%s\t0\n' "$p"; fi
      done <<<"$list"
    else
      echo "$list"
    fi
    ;;
  set)
    (($# == 2)) || usage
    available "$2" || { echo "nova-power-profile: no power mode '$2'" >&2; exit 1; }
    mkdir -p "$state_dir"
    printf '%s\n' "$2" >"$state_dir/battery"
    if [[ $(source_name) == ac ]]; then
      echo "Plugged in, it is always full power: $2 is the battery's mode from now on."
    else
      apply "$2"
    fi
    ;;
  restore)
    (($# == 1)) || usage
    if [[ $(source_name) == ac ]]; then
      profile=performance
    else
      profile=$(cat "$state_dir/battery" 2>/dev/null || true)
      available "$profile" || profile=balanced
    fi
    available "$profile" || exit 0
    [[ $(active || true) == "$profile" ]] || apply "$profile"
    ;;
  *) usage ;;
esac
