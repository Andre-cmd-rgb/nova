#!/bin/bash

# nova:summary=Mirror the laptop screen on an external monitor, or stop
# nova:args=<on|off|toggle|recover>

set -euo pipefail

TOGGLE="internal-monitor-mirror"
TOGGLE_FLAG="$HOME/.local/state/nova/toggles/hypr/$TOGGLE.lua"
DISABLE_TOGGLE="internal-monitor-disable"

INTERNAL=$(nova-hyprland-monitor-laptop)
# The first active external monitor
EXTERNAL=$(hyprctl monitors -j | jq -r 'first(.[] | select(.name | test("^(eDP|LVDS|DSI)-") | not).name) // empty')

on() {
  if [[ -z $EXTERNAL ]]; then
    nova-notification-send -g 󰍹 "No external monitors found for mirror"
    exit 1
  fi

  if [[ -z $INTERNAL ]]; then
    nova-notification-send -g 󰍹 "No laptop monitor found to mirror"
    exit 1
  fi

  # Both names are written into generated Lua below, so only plain connector
  # names may pass; a user-created headless output can carry any name.
  for output in "$INTERNAL" "$EXTERNAL"; do
    if [[ ! $output =~ ^[A-Za-z0-9._-]+$ ]]; then
      nova-notification-send -g 󰍹 "Refusing unsafe monitor name"
      exit 1
    fi
  done

  nova-hyprland-toggle "$DISABLE_TOGGLE" off

  if nova-hyprland-toggle-disabled "$TOGGLE"; then
    mkdir -p "$(dirname "$TOGGLE_FLAG")"
    printf 'hl.monitor({ output = "%s", mode = "preferred", position = "auto", scale = 1, mirror = "%s" })\n' "$EXTERNAL" "$INTERNAL" >"$TOGGLE_FLAG"
    nova-notification-send -g 󰍹 "Mirroring enabled ($EXTERNAL)"
    hyprctl reload
  fi
}

off() {
  if nova-hyprland-toggle-enabled "$TOGGLE"; then
    nova-hyprland-toggle "$TOGGLE" off
    nova-notification-send -g 󰍹 "Extended mode restored"
  fi
}

toggle() {
  if nova-hyprland-toggle-enabled "$TOGGLE"; then
    off
  else
    on
  fi
}

recover() {
  if ! nova-hyprland-monitor-external-active && nova-hyprland-toggle-enabled "$TOGGLE"; then
    nova-hyprland-toggle "$TOGGLE" off
  fi
}

case "${1:-}" in
  on) on ;;
  off) off ;;
  toggle) toggle ;;
  recover) recover ;;
  *)
    echo "Usage: $(basename "$0") {on|off|toggle|recover}" >&2
    exit 1
    ;;
esac
