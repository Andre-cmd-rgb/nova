#!/bin/bash

# nova:summary=Print CPU and memory stats for the shell
# nova:args=[--bar-widget]
# nova:hidden=true

set -euo pipefail

bar_widget_stats() {
  awk '
    NR == 1 {
      idle = $5
      total = 0
      for (i = 2; i <= NF; i++) total += $i
      printf "cpu\t%s\t%s\n", idle, total
    }
  ' /proc/stat

  awk '
    /^MemTotal:/ { total = $2 }
    /^MemAvailable:/ { avail = $2 }
    END {
      if (total > 0) printf "memory\t%.2f\n", ((total - avail) / total) * 100
    }
  ' /proc/meminfo

  awk '{ print "load\t" $1 }' /proc/loadavg
}

case "${1:-}" in
  "")
    ;;
  --bar-widget)
    bar_widget_stats
    exit 0
    ;;
  *)
    echo "Usage: nova-system-stats [--bar-widget]" >&2
    exit 2
    ;;
esac

# CPU use over a short window, from two /proc/stat samples.
read -r _ a1 a2 a3 idle_a a5 a6 a7 a8 _ </proc/stat
sleep 0.2
read -r _ b1 b2 b3 idle_b b5 b6 b7 b8 _ </proc/stat
total=$(((b1 + b2 + b3 + idle_b + b5 + b6 + b7 + b8) - (a1 + a2 + a3 + idle_a + a5 + a6 + a7 + a8)))
idle=$(((idle_b + b5) - (idle_a + a5)))
cpu="0%"
if ((total > 0)); then cpu="$(((100 * (total - idle) + total / 2) / total))%"; fi

awk -v cpu="$cpu" '
  /^MemTotal:/ { total = $2 }
  /^MemAvailable:/ { avail = $2 }
  END {
    used = total - avail
    printf "cpu\t%s\n", cpu
    printf "memory\t%.1fGB / %.0fGB\n", used / 1024 / 1024, total / 1024 / 1024
  }
' /proc/meminfo
