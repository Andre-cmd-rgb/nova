#!/bin/bash

# nova:summary=Hand a command line to the running Chromium-based browser
# nova:args=<browser-command> [browser-args...]
# nova:hidden=true

set -euo pipefail

# Starting a browser of Chromium's family while one is running takes some
# 165 ms, and all the new process does is pass its arguments to the running one
# over the profile's singleton socket. This passes them itself. It fails
# whenever it cannot be sure the running browser would do what a launch does,
# and when no browser answers, so the caller launches one instead.

(($# > 0)) || exit 1
config_home=${XDG_CONFIG_HOME:-$HOME/.config}

# The browsers' own binaries only: a wrapper in their place may pick another
# profile, or add flags of its own.
case $(type -P "$1") in
  /usr/bin/chromium) profile=chromium flags=chromium-flags.conf ;;
  /usr/bin/google-chrome-stable) profile=google-chrome flags=chrome-flags.conf ;;
  /usr/bin/brave) profile=BraveSoftware/Brave-Browser flags=brave-flags.conf ;;
  /usr/bin/brave-origin) profile=BraveSoftware/Brave-Origin flags=brave-origin-flags.conf ;;
  /usr/bin/microsoft-edge-stable) profile=microsoft-edge flags=microsoft-edge-stable-flags.conf ;;
  *) exit 1 ;;
esac
shift

# A data directory from the environment or the arguments is another browser
# than the one on the socket.
[[ -z ${CHROME_USER_DATA_DIR:-}${CHROME_CONFIG_HOME:-} ]] || exit 1
for arg; do
  [[ $arg != --user-data-dir* ]] || exit 1
done

# The running browser started with the flags Nova puts in the flags file:
# Wayland, the keyring, its features and extensions. Any other flag there may
# be meant for every launch, which only a launch passes on. A # starts a
# comment wherever it is.
flag_files=()
for file in "/etc/$flags" "$config_home/$flags"; do
  [[ ! -r $file || -d $file ]] || flag_files+=("$file")
done
if ((${#flag_files[@]})) && awk -F '[[:space:]]+' '
  function shipped(flag) {
    return flag ~ /^--(ozone-platform|ozone-platform-hint|password-store|enable-features|load-extension)=/ ||
      flag == "--no-default-browser-check"
  }
  { sub(/#.*/, "") }
  { for (i = 1; i <= NF; i++) if ($i != "" && !shipped($i)) other = 1 }
  END { exit !other }
' "${flag_files[@]}"; then
  exit 1
fi

# The socket sits in a directory under /tmp, which another user could make
# again once a crashed browser's is cleaned away: only a socket of our own is
# told anything.
socket=$config_home/$profile/SingletonSocket
[[ -S $socket && -O $socket ]] || exit 1

# What a second browser process sends: START, its directory, its name, then
# its arguments, each after a NUL.
reply=$({
  printf 'START\0%s\0browser' "$PWD"
  printf '\0%s' "$@"
} | socat -t2 - "UNIX-CONNECT:$socket" 2>/dev/null) || true
[[ $reply == ACK ]]
