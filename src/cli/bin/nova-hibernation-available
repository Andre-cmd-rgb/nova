#!/bin/bash

# nova:summary=Check if hibernation is supported

set -euo pipefail

if [[ ! -f /sys/power/image_size ]]; then
  exit 1
fi

# Sum all swap sizes (excluding zram); /proc/swaps reports kilobytes.
swap_kb=$(awk '!/Filename|zram/ {sum += $3} END {print sum+0}' /proc/swaps)
swap_bytes=$((1024 * swap_kb))

image_size=$(</sys/power/image_size)

if ((swap_bytes > image_size)) && [[ -f /etc/mkinitcpio.conf.d/nova_resume.conf ]]; then
  exit 0
else
  exit 1
fi
