#!/bin/bash

# nova:summary=Check if hibernation is supported
# nova:hidden=true
#
# logind's own answer: it checks the kernel, the swap space against the size of
# memory in use, and where the image would go, which is everything
# `systemctl hibernate` will check before refusing.

set -euo pipefail

answer=$(busctl --system call org.freedesktop.login1 /org/freedesktop/login1 \
  org.freedesktop.login1.Manager CanHibernate 2>/dev/null) || exit 1
[[ $answer == 's "yes"' ]]
