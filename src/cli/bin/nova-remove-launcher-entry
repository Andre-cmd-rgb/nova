#!/bin/bash

# nova:summary=Remove an app from the launcher, uninstalling it when a package owns it
# nova:args=<desktop-id> [name]
# nova:hidden=true
#
# The launcher's Remove action. An entry of the user's own is deleted; one from
# a package uninstalls the package in a terminal, where pacman asks before it
# removes anything and says so when something else still needs it.

set -euo pipefail

id=${1:-}
name=${2:-$id}
[[ -n $id ]] || { echo "Usage: nova-remove-launcher-entry <desktop-id> [name]" >&2; exit 2; }
file_name=${id%.desktop}.desktop

user_dir=${XDG_DATA_HOME:-$HOME/.local/share}/applications
IFS=: read -ra data_dirs <<<"${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

desktop_file=
for dir in "$user_dir" "${data_dirs[@]/%//applications}"; do
  if [[ -f $dir/$file_name ]]; then
    desktop_file=$dir/$file_name
    break
  fi
done
[[ -n $desktop_file ]] || { echo "nova-remove-launcher-entry: no launcher entry $file_name" >&2; exit 1; }

if [[ $desktop_file == "$user_dir/"* ]]; then
  rm -f -- "$desktop_file"
  update-desktop-database "$user_dir" >/dev/null 2>&1 || true
  exit 0
fi

if package=$(pacman -Qqo "$desktop_file" 2>/dev/null); then
  exec nova-launch-floating-terminal-with-presentation \
    "echo $(printf '%q' "Uninstalling $name ($package)")...; sudo pacman -Rns $(printf '%q' "$package")"
fi

if nova-cmd-present flatpak && flatpak info "${file_name%.desktop}" >/dev/null 2>&1; then
  exec nova-launch-floating-terminal-with-presentation "flatpak uninstall $(printf '%q' "${file_name%.desktop}")"
fi

echo "nova-remove-launcher-entry: nothing owns $desktop_file, so it was left alone" >&2
exit 1
