#!/bin/bash

# nova:summary=Shut down after closing application windows
# nova:args=[--inhibit|--inhibited]
#
# Runs itself in three stages: the caller schedules a transient user service
# (closing the caller's terminal cannot cancel it), the service takes a sleep
# and lid inhibitor, and inside it the windows close and the machine powers off.

set -euo pipefail

case ${1:-} in
  --inhibited)
    # Close windows in the background so they cannot delay power-off.
    (
      nova-osd -i shutdown -m "Shutting down" -d 5000 || true
      nova-hyprland-window-close-all || true
    ) &
    sleep 2 # Let apps like Chrome shut down cleanly
    systemctl poweroff --no-wall
    ;;
  --inhibit)
    # Lid handling ignores high-level sleep inhibitors, so block it explicitly.
    systemd-inhibit --what=sleep:idle:handle-lid-switch \
      --who=Nova --why="Shutdown in progress" --mode=block \
      "$0" --inhibited || {
      status=$?
      nova-notification-send -u critical "Shutdown failed" "Could not complete shutdown. Please try again."
      exit "$status"
    }
    ;;
  "")
    systemd-run --user --collect --quiet --property=Type=exec --property=RuntimeMaxSec=30s \
      "$(readlink -f "${BASH_SOURCE[0]}")" --inhibit
    ;;
  *)
    echo "Usage: nova-system-shutdown" >&2
    exit 2
    ;;
esac
