#!/bin/bash

# nova:summary=Check if a toggle is enabled (flag file exists)
# nova:args=<flag-name>
# nova:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: nova-toggle-enabled <flag-name>" >&2
  exit 2
fi

# On while nova-toggle has left its flag file.
[[ -f $HOME/.local/state/nova/toggles/$1 ]]
