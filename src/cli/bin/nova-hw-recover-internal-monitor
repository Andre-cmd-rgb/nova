#!/bin/bash

# nova:summary=Clear the internal-monitor-disable toggle if no external display is connected
# nova:hidden=true

set -euo pipefail

# Run before the session starts: the laptop's panel turned off for a display
# that is no longer plugged in would leave it with no screen at all.
flag=${XDG_STATE_HOME:-$HOME/.local/state}/nova/toggles/hypr/internal-monitor-disable.lua
if [[ -f $flag ]] && ! nova-hw-external-monitors; then
  rm -f -- "$flag"
fi
