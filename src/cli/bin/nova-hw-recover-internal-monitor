#!/bin/bash

# nova:summary=Clear the internal-monitor-disable toggle if no external display is connected.
# nova:hidden=true

set -euo pipefail

TOGGLE="$HOME/.local/state/nova/toggles/hypr/internal-monitor-disable.lua"

if [[ -f $TOGGLE ]] && ! nova-hw-external-monitors; then
  rm -f "$TOGGLE"
fi
