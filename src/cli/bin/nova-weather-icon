#!/bin/bash

# nova:summary=Print a glyph for the weather now, a night one between sunset and sunrise
# nova:hidden=true

set -euo pipefail

# The place set, if there is one. Without, wttr.in goes by this computer's
# address, as nova-weather-location's own guess would, which costs a request.
query=""
if [[ -s ${XDG_STATE_HOME:-$HOME/.local/state}/nova/settings/weather.json ]]; then
  place=$(nova-weather-location 2>/dev/null || true)
  if [[ -n $place ]]; then
    query=$(jq -rn --arg place "$place" '$place | @uri')
  fi
fi

# The condition's code, and today's sunrise and sunset as "6:58 AM".
report=$(curl -fsS --max-time 3 "https://wttr.in/$query?format=j1" 2>/dev/null |
  jq -er '[.current_condition[0].weatherCode, .weather[0].astronomy[0].sunrise, .weather[0].astronomy[0].sunset]
    | select(all(. != null and . != "")) | @tsv' 2>/dev/null) || exit 1
IFS=$'\t' read -r code sunrise sunset <<<"$report"
clock='^[0-9]{1,2}:[0-9]{2} [AP]M$'
[[ $code =~ ^[0-9]+$ && $sunrise =~ $clock && $sunset =~ $clock ]] || exit 1

# Night when both times read, and now is outside them.
night=false
if times=$(printf 'today %s\n' "$sunrise" "$sunset" | date -f - +%s 2>/dev/null); then
  read -r -d '' dawn dusk <<<"$times" || true
  printf -v now '%(%s)T' -1
  if ((now < dawn || now >= dusk)); then night=true; fi
fi

# wttr.in's condition codes, grouped by glyph: the day's, and the night's
# where it has its own.
case $code in
  113) glyphs=( ) ;;
  116) glyphs=( ) ;;
  119 | 122) glyphs=() ;;
  143 | 248 | 260) glyphs=() ;;
  176 | 263 | 353) glyphs=( ) ;;
  179 | 227 | 230 | 323 | 326 | 368) glyphs=( ) ;;
  182 | 185 | 281 | 284 | 311 | 314 | 317 | 320 | 350 | 362 | 365 | 374 | 377) glyphs=() ;;
  200 | 386 | 389 | 392 | 395) glyphs=() ;;
  266 | 293 | 296 | 299 | 302 | 305 | 308 | 356 | 359) glyphs=() ;;
  329 | 332 | 335 | 338 | 371) glyphs=() ;;
  *) glyphs=() ;;
esac
if $night; then
  echo "${glyphs[-1]}"
else
  echo "${glyphs[0]}"
fi
