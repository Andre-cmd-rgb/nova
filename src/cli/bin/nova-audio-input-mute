#!/bin/bash

# nova:summary=Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
  nova-brightness-keyboard-mute on
  nova-osd -i microphone-muted -m "Microphone muted"
else
  nova-brightness-keyboard-mute off
  nova-osd -i microphone -m "Microphone on"
fi
