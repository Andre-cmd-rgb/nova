#!/bin/bash

# nova:summary=Mute or unmute the microphone, and light its key's LED to match where there is one

set -euo pipefail

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

# A muted source reads "Volume: 0.40 [MUTED]". The answer is kept rather than
# piped to grep -q, which leaves at its first match: under pipefail, wpctl
# could die of SIGPIPE and turn the match into a failure.
if [[ $(wpctl get-volume @DEFAULT_AUDIO_SOURCE@) == *MUTED* ]]; then
  led=on icon=microphone-muted message="Microphone muted"
else
  led=off icon=microphone message="Microphone on"
fi
nova-brightness-keyboard-mute "$led"
nova-osd -i "$icon" -m "$message"
