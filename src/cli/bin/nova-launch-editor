#!/bin/bash

# nova:summary=Open the default editor
# nova:args=[--inline] <path>

set -euo pipefail

default_editor="$HOME/.local/state/nova/defaults/editor"

if [[ ${1:-} == "--inline" ]]; then
  inline=true
  shift
else
  inline=false
fi

# VS Code unless another was chosen, and nano, which is always there, when
# the chosen one is missing.
editor="code"
if [[ -f $default_editor ]]; then
  read -r editor <"$default_editor" || editor="code"
fi

nova-cmd-present "$editor" || editor="nano"

case "${editor##*/}" in
  nvim | vim | nano | micro | hx | helix | fresh)
    if [[ $inline == "true" ]]; then
      exec "$editor" -- "$@"
    else
      exec nova-launch-tui "$editor" -- "$@"
    fi
    ;;
  *)
    exec setsid uwsm-app -- "$editor" -- "$@"
    ;;
esac
