#!/bin/bash

# nova:summary=Open the default editor
# nova:args=[--inline] <path>

set -euo pipefail

# --inline: a terminal editor runs in the terminal this was started from,
# rather than in a new one.
inline=false
if [[ ${1:-} == --inline ]]; then
  inline=true
  shift
fi

# The editor chosen with nova-default-editor, VS Code when none was; nano,
# which is always installed, when the chosen one is not.
editor=code
choice=$HOME/.local/state/nova/defaults/editor
if [[ -f $choice ]]; then
  read -r editor <"$choice" || editor=code
fi
command -v -- "$editor" >/dev/null 2>&1 || editor=nano

case ${editor##*/} in
  nvim | vim | nano | micro | hx | helix | fresh)
    if $inline; then
      exec "$editor" -- "$@"
    fi
    exec nova-launch-tui "$editor" -- "$@"
    ;;
esac
exec setsid uwsm-app -- "$editor" -- "$@"
