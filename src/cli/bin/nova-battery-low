#!/bin/bash

# nova:summary=Send the low battery warning notification and run battery-low hooks
# nova:args=<percentage>
# nova:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: nova-battery-low <percentage>" >&2
  exit 1
fi

level=$1

# A glyph of the bar's own battery set: the icon theme's battery-caution is
# an old bitmap, blurred and out of place beside the rest.
nova-notification-send -g 󰂃 -u critical "Time to recharge!" "Battery is down to ${level}%" -t 30000
nova-hook battery-low "$level"
