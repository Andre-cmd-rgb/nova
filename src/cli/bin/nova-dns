#!/bin/bash

# nova:summary=Show or configure the system DNS provider
# nova:args=[Cloudflare|Google|DHCP|Custom [server...]]

# Without an argument, the provider in use: Cloudflare, Google, DHCP (the
# network's own), or Custom. With one, it is set, for NetworkManager (a global
# drop-in, and every Wi-Fi and wired profile's own DNS) and for systemd-resolved
# (resolved.conf). Custom takes one to four servers, or asks for them. Setting
# needs root: it runs again as root, through polkit, from the packaged copy.

set -euo pipefail

# As root, every command this runs by name (install, tee, rm, nmcli,
# systemctl and the like) is the system's, and none comes from a directory a
# user can write to. Before that, the caller's PATH finds pkexec.
if ((EUID == 0)); then
  export PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin
fi

nm_conf=/etc/NetworkManager/conf.d/20-nova-dns.conf
resolved_conf=/etc/systemd/resolved.conf
# Root runs the packaged copy, never the one that was called, which a user
# could have written.
packaged=/usr/lib/nova/bin/nova-dns

# Runs this again as root, through polkit, which asks for the password on
# screen, with or without a terminal.
require_root() {
  ((EUID != 0)) || return 0
  exec pkexec "$packaged" "$@"
}

# The value of the first key=value line that the pattern matches, of a file,
# passing over comments: of the [global-dns-domain-*] section only, for
# NetworkManager's.
setting() { # file key-pattern [section]
  local line section="" wanted=${3:-}
  [[ -r $1 ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    [[ ! $line =~ ^[[:space:]]*# ]] || continue
    if [[ $line =~ ^[[:space:]]*\[ ]]; then
      section=""
      if [[ $line =~ ^[[:space:]]*\[global-dns-domain-\*\][[:space:]]*$ ]]; then section=global-dns-domain; fi
      continue
    fi
    if [[ $section == "$wanted" && $line =~ ^[[:space:]]*$2[[:space:]]*= ]]; then
      printf '%s\n' "${line#*=}"
      return 0
    fi
  done <"$1"
}

# NetworkManager's servers where its drop-in has any, resolved's where not.
provider() {
  local servers
  servers=$(setting "$nm_conf" servers global-dns-domain)
  [[ -n ${servers//[[:space:],]/} ]] || servers=$(setting "$resolved_conf" DNS)
  if [[ -z ${servers//[[:space:],]/} ]]; then
    echo DHCP
  elif [[ $servers == *cloudflare-dns.com* || $servers == *1.1.1.1* || $servers == *2606:4700:4700::1111* ]]; then
    echo Cloudflare
  elif [[ $servers == *dns.google* || $servers == *8.8.8.8* || $servers == *2001:4860:4860::8888* ]]; then
    echo Google
  else
    echo Custom
  fi
}

# Of one server as resolved.conf takes it, the address alone, which is all
# NetworkManager's ipv4.dns and ipv6.dns take: without dns+tls:// or
# dns+udp://, a #server-name for DNS over TLS, the brackets of an IPv6 address
# before a port, or the :port. 1 for a port out of range.
server_address() {
  local address=${1%%#*}
  address=${address#dns+tls://}
  address=${address#dns+udp://}
  if [[ $address =~ ^\[([0-9A-Fa-f:]+)\](:([0-9]{1,5}))?$ ]]; then
    address=${BASH_REMATCH[1]}
    [[ -z ${BASH_REMATCH[3]} ]] || ((10#${BASH_REMATCH[3]} <= 65535)) || return 1
  elif [[ $address =~ ^([0-9.]+):([0-9]{1,5})$ ]]; then
    address=${BASH_REMATCH[1]}
    ((10#${BASH_REMATCH[2]} <= 65535)) || return 1
  fi
  printf '%s\n' "$address"
}

# Eight groups of up to four hex digits, or fewer with one :: for the rest.
valid_ipv6() {
  local address=$1 group groups=0
  [[ $address =~ ^[0-9A-Fa-f:]+$ && $address == *:* ]] || return 1
  # One :: at most, and no single colon at either end.
  [[ $address != *:::* && ${address/::/} != *::* ]] || return 1
  [[ $address != :[!:]* && $address != *[!:]: ]] || return 1
  local IFS=:
  for group in $address; do
    [[ -n $group ]] || continue
    ((${#group} <= 4)) || return 1
    groups=$((groups + 1))
  done
  if [[ $address == *::* ]]; then ((groups <= 7)); else ((groups == 8)); fi
}

# One server as resolved.conf takes it: an IPv4 or IPv6 address (in brackets
# when a port follows), an optional :port, an optional #server-name for DNS
# over TLS.
valid_server() {
  local server=$1 address name='' octet
  [[ $server == *'#'* ]] && name=${server#*#}
  [[ -z $name || $name =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]] || return 1
  address=$(server_address "$server") || return 1
  if [[ $address =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
    # No leading zeros, which inet_pton, and so NetworkManager, refuses.
    for octet in ${address//./ }; do
      [[ $octet == 0 || $octet != 0* ]] && ((10#$octet <= 255)) || return 1
    done
    return 0
  fi
  valid_ipv6 "$address"
}

# The addresses of servers given with commas or spaces between them, by their
# family, in $ipv4_dns and $ipv6_dns, spaces between.
split_dns_servers() { # servers
  local server address
  local -a servers=()
  ipv4_dns=""
  ipv6_dns=""
  IFS=', ' read -ra servers <<<"$1"
  for server in "${servers[@]}"; do
    address=$(server_address "$server") || continue
    [[ -n $address ]] || continue
    if [[ $address == *:* ]]; then
      ipv6_dns+=${ipv6_dns:+ }$address
    else
      ipv4_dns+=${ipv4_dns:+ }$address
    fi
  done
}

# NetworkManager's drop-in, its servers comma-separated: a line of data, which
# nothing reads as a path or a command.
nm_global() { # servers
  install -d -m 0755 "${nm_conf%/*}"
  cat >"$nm_conf" <<EOF
# Written by nova dns. nova dns DHCP removes it, for the network's own DNS.
[global-dns]

[global-dns-domain-*]
servers=$1
EOF
}

# Every Wi-Fi and wired profile's own DNS: the servers given in place of
# DHCP's (yes), or DHCP's again (no).
profiles() { # yes|no ipv4-servers ipv6-servers
  local uuid type
  while IFS=: read -r uuid type; do
    [[ -n $uuid ]] || continue
    case $type in
      802-11-wireless | 802-3-ethernet) ;;
      *) continue ;;
    esac
    nmcli connection modify "$uuid" \
      ipv4.ignore-auto-dns "$1" \
      ipv4.dns "$2" \
      ipv6.ignore-auto-dns "$1" \
      ipv6.dns "$3" \
      >/dev/null
  done < <(nmcli -t -f UUID,TYPE connection show)
}

# resolved.conf, from stdin.
resolved() {
  tee "$resolved_conf" >/dev/null
}

# resolved's servers when the chosen ones do not answer: Quad9's.
fallback='9.9.9.9#dns.quad9.net 149.112.112.112#dns.quad9.net 2620:fe::fe#dns.quad9.net 2620:fe::9#dns.quad9.net'

# A provider's two IPv4 and two IPv6 servers. resolved speaks DNS over TLS to
# them where it can, to the name their certificate is for.
preset() { # tls-name ipv4 ipv4 ipv6 ipv6
  local name=$1
  shift
  nm_global "$1,$2,$3,$4"
  profiles yes "$1 $2" "$3 $4"
  resolved <<EOF
[Resolve]
DNS=$1#$name $2#$name $3#$name $4#$name
FallbackDNS=$fallback
DNSOverTLS=opportunistic
EOF
}

# NetworkManager's settings read again first, and then its connected Wi-Fi and
# wired devices given their profiles again: reloading both settings and DNS at
# once (conf,dns-full) hands out the DNS it had, and the shell's choice would
# show the one before. resolved after it; and NetworkManager's DNS once more,
# as reloading resolved can leave a link's DNS old or empty.
reload_dns_stack() {
  local device type state
  if systemctl is-active --quiet NetworkManager.service 2>/dev/null; then
    nmcli general reload conf >/dev/null 2>&1 || systemctl reload NetworkManager.service 2>/dev/null || true
    while IFS=: read -r device type state; do
      [[ -n $device && $state == connected ]] || continue
      case $type in
        wifi | ethernet) nmcli device reapply "$device" >/dev/null 2>&1 || true ;;
      esac
    done < <(nmcli -t -f DEVICE,TYPE,STATE device status)
  fi
  systemctl reload systemd-resolved.service 2>/dev/null || systemctl restart systemd-resolved.service
  if systemctl is-active --quiet NetworkManager.service 2>/dev/null; then
    nmcli general reload dns-full >/dev/null 2>&1 || true
  fi
}

usage() {
  echo "Usage: nova-dns [Cloudflare|Google|DHCP|Custom [server...]]" >&2
}

if (($# == 0)); then
  provider
  exit 0
fi

case $1 in
  Cloudflare | cloudflare) chosen=Cloudflare ;;
  Google | google) chosen=Google ;;
  DHCP | dhcp) chosen=DHCP ;;
  Custom | custom) chosen=Custom ;;
  *)
    usage
    exit 1
    ;;
esac
shift

if [[ $chosen == Custom ]]; then
  if (($# == 0)); then
    echo "Enter your DNS servers (one to four, space-separated):"
    read -r typed || typed=''
    # Commas, tabs and spaces between them; quotes as xargs takes them.
    typed=$(tr ',\t\n' ' ' <<<"$typed" | xargs | tr ' ' ',')
    IFS=, read -ra servers <<<"$typed"
  else
    servers=("$@")
  fi
  # Two of each, IPv4 and IPv6, as the presets have.
  if ((${#servers[@]} < 1 || ${#servers[@]} > 4)); then
    echo 'Error: Enter one to four DNS server addresses; nothing was changed.' >&2
    exit 1
  fi
  # Before the password is asked for, and again as root, in the packaged copy.
  for server in "${servers[@]}"; do
    if ! valid_server "$server"; then
      echo "Error: '$server' is not a DNS server address; nothing was changed." >&2
      exit 1
    fi
  done
  require_root "$chosen" "${servers[@]}"
else
  if (($#)); then
    usage
    exit 1
  fi
  require_root "$chosen"
fi

case $chosen in
  Cloudflare) preset cloudflare-dns.com 1.1.1.1 1.0.0.1 2606:4700:4700::1111 2606:4700:4700::1001 ;;
  Google) preset dns.google 8.8.8.8 8.8.4.4 2001:4860:4860::8888 2001:4860:4860::8844 ;;
  DHCP)
    rm -f "$nm_conf"
    profiles no "" ""
    resolved <<'EOF'
[Resolve]
DNSOverTLS=no
EOF
    ;;
  Custom)
    # The servers as data, a line of them, commas between for NetworkManager
    # and spaces for resolved.
    joined=$(IFS=,; echo "${servers[*]}")
    split_dns_servers "$joined"
    nm_global "$joined"
    profiles yes "$ipv4_dns" "$ipv6_dns"
    resolved <<EOF
[Resolve]
DNS=${joined//,/ }
FallbackDNS=$fallback
EOF
    ;;
esac

reload_dns_stack
