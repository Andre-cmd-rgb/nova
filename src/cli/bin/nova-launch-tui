#!/bin/bash

# nova:summary=Launch a TUI command in the default terminal with Nova styling
# nova:args=[--app-id=<app-id>] <command> [args...]

set -euo pipefail

if (($# == 0)); then
  echo "Usage: nova-launch-tui [--app-id=<app-id>] <command> [args...]" >&2
  exit 1
fi

if [[ $1 == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
  shift
else
  APP_ID="org.nova.$(basename "$1")"
fi

(($# > 0)) || {
  echo "Usage: nova-launch-tui [--app-id=<app-id>] <command> [args...]" >&2
  exit 1
}

exec setsid uwsm-app -- xdg-terminal-exec --app-id="$APP_ID" -e "$1" "${@:2}"
