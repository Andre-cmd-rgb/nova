#!/bin/bash
# nova:summary=Update Nova to the newest release, and Chrome and VS Code
# nova:args=[--version <tag>] [--check] [--dry-run] [--yes] | --check-boot | --candidates [on|off] | --status <file> [--apps-only | --apps-install]
#
# Moves this system to a Nova release: the Arch packages are taken from the Arch Linux
# Archive snapshot the release was tested against, the nova packages from the release's
# own signed repository, with a snapper snapshot before and after. Then it brings
# Chrome and VS Code up to date, which come from their vendors outside the release
# (nova apps update). On a Raspberry Pi the Arch Linux ARM packages are the set the
# release pinned itself, Arch Linux ARM having no archive, and there are no
# snapshots to take.
#
#   nova update                     update to the newest release
#   nova update --version v1.0.0-beta.2
#   nova update --check             print "available <version>", "apps <name>..." when
#                                   only Chrome or VS Code is behind, or "current"
#   nova update --dry-run           show what would change, change nothing
#   nova update --check-boot        check the boot entries again, as an update ends:
#                                   after repairing them, before restarting
#   nova update --yes               do not ask before applying
#   nova update --allow-downgrade   permit an older release (uses pacman -Syuu)
#   nova update --no-snapshot       skip the snapper snapshots (not recommended)
#   nova update --release-file F    use a local release.toml instead of GitHub (taken
#                                   as it is: no signature is checked)
#   nova update --candidates on     follow the release candidates too, to test
#                                   each two weeks before it is released; off
#                                   stops, and with neither it says which
#
# Settings runs it with no terminal (nova-update-run, which starts it as a user
# service of its own, so that it outlives the shell it restarts):
#
#   nova update --status F          ask nothing; build Chrome and VS Code first,
#                                   so that one authentication installs them with
#                                   the release; and keep F, as JSON, saying how
#                                   far it is, with the whole output beside it
#   --apps-only                     the apps alone (after a review in Settings,
#                                   with nova apps install's --only and --approve)
#   --apps-install                  the apps that are missing too
#
# A system on a candidate follows candidates anyway, until a final release.
# Everything that needs root runs as one step through pkexec (nova-update-apply).
# Packages held back with IgnorePkg stay held back, and nothing is ever downgraded
# unless you ask for it.
#
# A release's release.toml must be signed by Nova's own key, the one in the
# nova-keyring package, since it says where every package comes from.
#
# Environment (for tests and forks): NOVA_UPDATE_REPO (owner/name), NOVA_UPDATE_API,
# GITHUB_TOKEN (raises the API rate limit), NOVA_UPDATE_CHECK_TTL (seconds),
# NOVA_UPDATE_KEY (the armored public key release.toml is checked against).
set -euo pipefail

NOVA_UPDATE_REPO=${NOVA_UPDATE_REPO:-Andre-cmd-rgb/nova}
API=${NOVA_UPDATE_API:-https://api.github.com/repos/$NOVA_UPDATE_REPO}
MIRRORLIST=${NOVA_MIRRORLIST:-/etc/pacman.d/nova-mirrorlist}
ALARMFILE=${NOVA_ALARMFILE:-/etc/pacman.d/nova-alarm}
REPOFILE=${NOVA_REPOFILE:-/etc/pacman.d/nova-repo}
SYNC_DIR=${NOVA_UPDATE_SYNC_DIR:-/var/lib/pacman/sync}
ARCH=${NOVA_ARCH:-$(uname -m)}
HERE=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
APPLY=${NOVA_UPDATE_APPLY:-$HERE/nova-update-apply}
APPS=${NOVA_UPDATE_APPS:-$HERE/nova-apps-install}
CACHE_TTL=${NOVA_UPDATE_CHECK_TTL:-1800}
CACHE_FILE=${NOVA_UPDATE_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/nova/update-check}
CANDIDATES=${NOVA_UPDATE_CANDIDATES:-${XDG_CONFIG_HOME:-$HOME/.config}/nova/update-candidates}
RELEASE_KEY=${NOVA_UPDATE_KEY:-/usr/share/pacman/keyrings/nova.gpg}

die() {
  printf 'nova update: %s\n' "$*" >&2
  if [[ -n ${STATUS:-} ]]; then
    st_state=failed st_error=$*
    status_write
  fi
  exit 1
}
warn() { printf 'nova update: %s\n' "$*" >&2; }

# v1.0.0-beta.1 -> 1.0.0beta.1, the form the nova package's pkgver takes
tag_pkgver() {
  local v=${1#v}
  v=${v/-/}
  printf '%s' "${v//-/.}"
}

is_prerelease() { [[ $1 =~ [0-9](alpha|beta|rc|pre) ]]; }

installed_pkgver() {
  local line
  if line=$(pacman -Q nova 2>/dev/null); then
    line=${line#nova }
    printf '%s' "${line%-*}"
  else
    printf '0'
  fi
}

# Value of a "# key: value" header line in one of the files nova update writes.
header_value() {
  local file=$1 key=$2
  [[ -r $file ]] || return 0
  sed -n -E "s/^# $key: *(.*)$/\1/;T;p;q" "$file"
}

unfinished_update() {
  local f
  for f in "$MIRRORLIST" "$ALARMFILE" "$REPOFILE" "$SYNC_DIR"; do
    [[ ! -e $f.nova-prev && ! -e $f.nova-absent ]] || return 0
  done
  return 1
}

# A string value from release.toml: key = "value"
toml_get() {
  sed -n -E "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*\"([^\"]*)\".*/\1/;T;p;q" "$1"
}

# Dies with what GitHub's answer means for someone waiting on it.
api_error() { # code what
  case $1 in
    403 | 429) die "GitHub's rate limit for this address is used up; try again within the hour (GITHUB_TOKEN raises it)" ;;
    401) die "GitHub refused GITHUB_TOKEN; unset it or renew it" ;;
    *) die "GitHub answered $1 for $2" ;;
  esac
}

api_get() { # path dest -> HTTP status on stdout; non-zero only if curl itself failed
  local -a auth=()
  [[ -z ${GITHUB_TOKEN:-} ]] || auth=(-H "Authorization: Bearer $GITHUB_TOKEN")
  curl -sSL --retry 2 --connect-timeout 10 --max-time 60 \
    -H 'Accept: application/vnd.github+json' -H 'X-GitHub-Api-Version: 2022-11-28' \
    "${auth[@]}" -o "$2" -w '%{http_code}' "$API$1"
}

download() { # url dest
  local code
  code=$(curl -sSL --retry 2 --connect-timeout 10 --max-time 120 \
    -o "$2" -w '%{http_code}' "$1") || return 1
  [[ $code == 200 ]]
}

# Checks file.sig against Nova's key alone, not the keyring pacman trusts, which
# holds every Arch packager's. gpgv reads only an unarmored key.
signed_by_nova() { # file
  local keyring status=0
  [[ -r $RELEASE_KEY ]] || die "Nova's key is not at $RELEASE_KEY; reinstall nova-keyring"
  keyring=$(mktemp)
  if ! gpg --batch --dearmor <"$RELEASE_KEY" >"$keyring" 2>/dev/null ||
    ! gpgv --quiet --keyring "$keyring" "$1.sig" "$1" >/dev/null 2>&1; then
    status=1
  fi
  rm -f "$keyring"
  return "$status"
}

# Find the release to move to and leave its JSON in $1. $2 is the requested tag (or
# empty), $3 is "yes" when pre-releases are acceptable.
fetch_release() {
  local dest=$1 want=$2 pre=$3 code list
  if [[ -n $want ]]; then
    code=$(api_get "/releases/tags/v${want#v}" "$dest") || die "cannot reach GitHub"
    case $code in
      200) return 0 ;;
      404) die "there is no release v${want#v}" ;;
      *) api_error "$code" "release v${want#v}" ;;
    esac
  fi
  if [[ $pre != yes ]]; then
    code=$(api_get "/releases/latest" "$dest") || die "cannot reach GitHub"
    case $code in
      200)
        # A release flag can be changed by hand; neither a candidate tag nor
        # a flagged pre-release belongs on a stable system.
        jq -e '(.prerelease != true) and ((.tag_name // "") | contains("-") | not)' "$dest" >/dev/null || return 4
        return 0
        ;;
      404) return 4 ;; # nothing but pre-releases (or nothing at all) is published
      *) api_error "$code" "the latest release" ;;
    esac
  fi
  # releases/latest never returns a pre-release, so a system on a beta follows the list.
  local tag best=''
  list=$(mktemp)
  code=$(api_get "/releases?per_page=30" "$list") || { rm -f "$list"; die "cannot reach GitHub"; }
  [[ $code == 200 ]] || { rm -f "$list"; api_error "$code" "the release list"; }
  # The newest by version: GitHub orders the list by commit date, and a final
  # release shares its candidate's commit.
  while IFS= read -r tag; do
    [[ $tag =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$ ]] || continue
    if [[ -z $best ]] || (($(vercmp "$(tag_pkgver "$tag")" "$(tag_pkgver "$best")") > 0)); then
      best=$tag
    fi
  done < <(jq -r '.[]? | select(.draft | not) | .tag_name // empty' "$list" 2>/dev/null)
  if [[ -z $best ]]; then
    rm -f "$list"
    return 4
  fi
  jq --arg tag "$best" '[.[] | select(.tag_name == $tag)] | first' "$list" >"$dest"
  rm -f "$list"
}

# --check: one line for the shell's update badge. Cached so a polling widget does not
# burn the unauthenticated API rate limit (60 requests an hour).
check_only() {
  local want=$1 now cached_at cached_tag tag='' rc=0 apps
  now=$(date +%s)
  if [[ -z $want && -r $CACHE_FILE ]] && read -r cached_at cached_tag < "$CACHE_FILE" &&
     [[ $cached_at =~ ^[0-9]+$ ]] && (( now - cached_at < CACHE_TTL )); then
    tag=$cached_tag
  else
    # Not local: the EXIT trap runs after this function, when fetch_release dies.
    tmp=$(mktemp)
    trap 'rm -f "$tmp"' EXIT
    fetch_release "$tmp" "$want" "$(wants_prereleases)" || rc=$?
    if (( rc != 4 )); then
      tag=$(jq -r '.tag_name // empty' "$tmp")
      [[ -n $tag ]] || { rm -f "$tmp"; die "the release has no tag"; }
      if [[ -z $want ]]; then
        mkdir -p "$(dirname "$CACHE_FILE")"
        printf '%s %s\n' "$now" "$tag" > "$CACHE_FILE"
      fi
    fi
    rm -f "$tmp"
  fi
  if [[ -n $tag && $(vercmp "$(tag_pkgver "$tag")" "$(installed_pkgver)") -gt 0 ]]; then
    echo "available ${tag#v}"
  # A Chrome security fix is as urgent as a release; an AUR that does not
  # answer is not news.
  elif apps=$("$APPS" --check 2>/dev/null) && [[ $apps == "apps "* ]]; then
    echo "$apps"
  else
    echo current
  fi
}

# Systems on a pre-release follow pre-releases, and so do those of the people
# testing candidates; the rest wait for final releases.
wants_prereleases() {
  if [[ ${NOVA_UPDATE_PRERELEASE:-} == 1 || -e $CANDIDATES ]] || is_prerelease "$(installed_pkgver)"; then
    echo yes
  else
    echo no
  fi
}

want='' do_check=0 dry=0 assume_yes=0 downgrade=0 snapshot=1 release_file='' check_boot=0
STATUS='' apps_only=0 apps_install=0 only_app=''
apps_flags=() release_flags=() release_tag=''

candidates() { # [on|off]
  case $1 in
    on) mkdir -p "${CANDIDATES%/*}" && : >"$CANDIDATES" ;;
    off) rm -f "$CANDIDATES" ;;
    "") if [[ -e $CANDIDATES ]]; then echo on; else echo off; fi; return ;;
    *) die "--candidates takes on or off" ;;
  esac
  # The cached check answered for the other kind of release.
  rm -f "$CACHE_FILE"
}

main() {
  while (( $# )); do
    case $1 in
      --version)         want=${2:?--version needs a tag}; shift 2 ;;
      --check)           do_check=1; shift ;;
      --dry-run)         dry=1; shift ;;
      --yes|-y)          assume_yes=1; shift ;;
      --allow-downgrade) downgrade=1; shift ;;
      --no-snapshot)     snapshot=0; shift ;;
      --release-file)    release_file=${2:?--release-file needs a path}; shift 2 ;;
      --candidates)      candidates "${2:-}"; return ;;
      --check-boot)      check_boot=1; shift ;;
      --status)          STATUS=${2:?--status needs a file}; assume_yes=1; shift 2 ;;
      --apps-only)       apps_only=1; shift ;;
      --apps-install)    apps_install=1; shift ;;
      --only)            only_app=${2:?--only needs an app}; apps_flags+=(--only "$only_app"); shift 2 ;;
      --approve)         apps_flags+=(--approve "${2:?--approve needs app=commit}"); shift 2 ;;
      -h|--help)         sed -n '2,/^set /p' "${BASH_SOURCE[0]}" | sed '$d; s/^# \{0,1\}//' | sed '1,3d'; exit 0 ;;
      *) die "unknown argument: $1 (try --help)" ;;
    esac
  done

  if (( do_check )); then
    check_only "$want"
    return 0
  fi
  if (( check_boot )); then
    [[ -x $APPLY ]] || die "missing helper: $APPLY"
    pkexec "$APPLY" --check-boot
    return
  fi
  if [[ -n $STATUS ]]; then
    settings_update
    return
  fi
  # Called plainly, not in a condition, which would switch set -e off inside it:
  # a release that fails or is declined ends the run here.
  update_release
  update_apps
}

# Chrome and VS Code come from their vendors through AUR recipes, outside the
# release: the installed ones are brought up to date after it.
update_apps() {
  local behind
  if (( dry )); then
    behind=$("$APPS" --check 2>/dev/null) || return 0
    [[ $behind != "apps "* ]] || echo "Apps to update: ${behind#apps }"
    return 0
  fi
  local -a flags=(--update)
  (( ! assume_yes )) || flags+=(--noconfirm)
  "$APPS" "${flags[@]}" || warn "Chrome or VS Code did not update; nova apps update tries again"
}

update_release() {
  # Not local: the EXIT trap runs after main has returned.
  tmp=$(mktemp -d)
  trap cleanup EXIT

  local unfinished=0 retry_tag
  if unfinished_update; then
    unfinished=1
    retry_tag=$(header_value "$REPOFILE" nova-release)
    warn "an earlier update did not finish; retrying the packages and boot checks"
    warn "if this run cannot finish, run: nova update ${retry_tag:+--version $retry_tag }--yes"
  fi

  local tag notes=
  if [[ -n $release_file ]]; then
    cp "$release_file" "$tmp/release.toml"
    tag="v$(toml_get "$tmp/release.toml" version)"
  else
    local rc=0
    fetch_release "$tmp/release.json" "$want" "$(wants_prereleases)" || rc=$?
    if (( rc == 4 )); then
      if [[ $(wants_prereleases) == yes ]]; then
        echo "No Nova release is published yet."
      else
        echo "No final Nova release is published yet; nova update --candidates on follows the release candidates."
      fi
      return 0
    fi
    tag=$(jq -r '.tag_name // empty' "$tmp/release.json")
    [[ -n $tag ]] || die "the release has no tag"
    # Printed in a terminal: no escape sequences from the release page.
    notes=$(jq -r '.body // empty' "$tmp/release.json" | tr -d '\000-\010\013-\037\177')
    local name asset
    for name in release.toml release.toml.sig; do
      asset=$(jq -r --arg n "$name" '[.assets[]? | select(.name == $n)][0].browser_download_url // empty' "$tmp/release.json")
      [[ -n $asset ]] || die "release $tag has no $name; it is incomplete (try again later), or older than signed releases"
      download "$asset" "$tmp/$name" || die "could not download $name for $tag"
    done
    signed_by_nova "$tmp/release.toml" || die "release.toml for $tag is not signed by Nova's key; nothing was changed"
  fi

  local version arch_date nova_repo alarm_date alarm_pool
  version=$(toml_get "$tmp/release.toml" version)
  arch_date=$(toml_get "$tmp/release.toml" arch_date)
  nova_repo=$(toml_get "$tmp/release.toml" nova_repo)
  alarm_date=$(toml_get "$tmp/release.toml" alarm_date)
  alarm_pool=$(toml_get "$tmp/release.toml" alarm_pool)
  [[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$ ]] || die "release.toml has a bad version: '$version'"
  [[ $arch_date =~ ^[0-9]{4}/[0-9]{2}/[0-9]{2}$ ]] || die "release.toml has a bad arch_date: '$arch_date'"
  [[ $nova_repo =~ ^https://[A-Za-z0-9._~:/%+-]+$ ]] || die "release.toml has a bad nova_repo: '$nova_repo'"
  [[ v$version == "$tag" ]] || die "release.toml says $version but the release is $tag"

  # Where this computer's Arch packages come from, and the date they are of.
  local base date pinfile pinkey
  case $ARCH in
    x86_64) base='Arch snapshot' date=$arch_date pinfile=$MIRRORLIST pinkey=arch-date ;;
    aarch64)
      # Releases from before the Raspberry Pi port have no packages for it.
      [[ -n $alarm_date ]] || die "$tag has no Raspberry Pi build; nothing was changed"
      [[ $alarm_date =~ ^[0-9]{4}/[0-9]{2}/[0-9]{2}$ ]] || die "release.toml has a bad alarm_date: '$alarm_date'"
      [[ $alarm_pool =~ ^https://[A-Za-z0-9._~:/%+-]+$ ]] || die "release.toml has a bad alarm_pool: '$alarm_pool'"
      base='Arch Linux ARM' date=$alarm_date pinfile=$ALARMFILE pinkey=alarm-date
      ;;
    *) die "Nova is not built for $ARCH" ;;
  esac

  local cur_tag cur_date cur_pkgver new_pkgver
  cur_pkgver=$(installed_pkgver)
  new_pkgver=$(tag_pkgver "$tag")
  cur_tag=$(header_value "$REPOFILE" nova-release)
  cur_date=$(header_value "$pinfile" "$pinkey")

  local newer
  newer=$(vercmp "$new_pkgver" "$cur_pkgver")
  if (( ! unfinished )) && [[ $newer -le 0 && -z $want && -z $release_file ]]; then
    echo "Nova is up to date ($tag)."
    return 0
  fi
  if [[ $newer -lt 0 || ( -n $cur_date && $date < $cur_date ) ]] && (( ! downgrade )); then
    die "$tag is older than what is installed (nova $cur_pkgver, $base ${cur_date:-unknown}); pass --allow-downgrade to go back"
  fi
  if (( ! unfinished )) && [[ $newer -eq 0 && ( -z $cur_date || $date == "$cur_date" ) && ${cur_tag:-$tag} == "$tag" ]]; then
    echo "Nova is already on $tag."
    return 0
  fi

  local held
  held=$( { pacman-conf IgnorePkg 2>/dev/null; pacman-conf IgnoreGroup 2>/dev/null; } | tr '\n' ' ' | sed 's/ *$//' || true)

  printf 'Nova update\n'
  printf '  release        %s -> %s\n' "${cur_tag:-$(printf 'nova %s' "$cur_pkgver")}" "$tag"
  printf '  %-15s%s -> %s\n' "$base" "${cur_date:-unpinned}" "$date"
  printf '  [nova] repo    %s\n' "$nova_repo"
  if [[ -n $held ]]; then
    printf '  held back      %s (IgnorePkg/IgnoreGroup, left alone)\n' "$held"
  fi
  if (( downgrade )); then
    printf '  WARNING        --allow-downgrade: packages newer than the snapshot WILL be downgraded\n'
  fi
  if [[ -n $notes ]]; then
    printf '\nRelease notes:\n'
    awk 'NR <= 20 { print "  " $0 }' <<<"$notes"
  fi
  printf '\n'

  if (( dry )); then
    echo "Dry run: nothing changed."
    return 0
  fi

  if (( ! assume_yes )); then
    local answer=
    read -r -p "Apply this update? [y/N] " answer || answer=
    [[ $answer == [yY] || $answer == [yY][eE][sS] ]] || { echo "Aborted."; return 2; }
  fi

  local -a flags=(--tag "$tag" --version "$version" --arch-date "$arch_date" --nova-repo "$nova_repo")
  [[ $ARCH == x86_64 ]] || flags+=(--alarm-date "$alarm_date" --alarm-pool "$alarm_pool")
  [[ -z $cur_tag ]] || flags+=(--from "$cur_tag")
  (( snapshot )) || flags+=(--no-snapshot)
  (( ! downgrade )) || flags+=(--allow-downgrade)
  (( ! assume_yes )) || flags+=(--noconfirm)

  [[ -x $APPLY ]] || die "missing helper: $APPLY"
  # For Settings the apps are built first, and go into the same root step.
  if [[ -n $STATUS ]]; then
    release_flags=("${flags[@]}") release_tag=$tag
    return 0
  fi
  # A failure can come after the packages are in (3: the boot entries do not
  # check out), and the shell has to follow them all the same.
  local status=0
  pkexec "$APPLY" "${flags[@]}" || status=$?
  restart_shell "$cur_pkgver"
  return "$status"
}

# The running shell holds the old release's QML and would load the rest from
# the new files as it needs them, half one release and half the other: move it
# onto the new release, if one is running and nova changed.
restart_shell() { # the nova pkgver before the update
  [[ $(installed_pkgver) != "$1" ]] || return 0
  nova-shell shell ping >/dev/null 2>&1 || return 0
  echo "Restarting the shell on the new release."
  nova-restart-shell || warn "the shell did not restart; log out and back in to finish the update"
}

# --- Settings ---------------------------------------------------------------------
#
# --status F: the same update, for Settings. F says, in JSON, what it is doing
# (state "running", then "done", "failed" or "cancelled", and a few words), how
# far it is (percent, or -1 while that is unknown), what came of it, and where
# the whole output is.

st_state=running st_text='' st_progress=-1 st_version='' st_error='' st_restart=0
st_held=() st_apps=() st_failed=()
ST_LOG='' build='' last_error='' notified=0

status_write() {
  jq -n --arg state "$st_state" --arg text "$st_text" --argjson progress "$st_progress" \
    --arg version "$st_version" --arg error "$st_error" --argjson restart "$st_restart" \
    --arg held "${st_held[*]}" --arg apps "${st_apps[*]}" --arg failed "${st_failed[*]}" \
    --arg log "$ST_LOG" \
    'def words: split(" ") | map(select(. != ""));
     {state: $state, text: $text, progress: $progress, version: $version, error: $error,
      restart: ($restart == 1), held: ($held | words), apps: ($apps | words),
      failed: ($failed | words), log: $log}' >"$STATUS.part" &&
    mv -f "$STATUS.part" "$STATUS"
}

progress() { # percent text: written only when either changed
  [[ $1 != "$st_progress" || $2 != "$st_text" ]] || return 0
  st_progress=$1 st_text=$2
  status_write
}

# Whatever ends a run before it is through, Settings hears of it.
status_stopped() {
  [[ -n $STATUS && $st_state == running ]] || return 0
  st_state=failed st_error=${st_error:-the update stopped before it finished}
  status_write
}

cleanup() {
  rm -rf -- "${tmp:-}" "$build"
  status_stopped
  # One that ended early, before the root step, has not said so yet.
  [[ -z $STATUS || $notified == 1 ]] || notify_result
}

app_name() {
  case $1 in
    google-chrome) echo Chrome ;;
    visual-studio-code-bin) echo "VS Code" ;;
    *) echo "$1" ;;
  esac
}

# Copies nova-update-apply's output into the log, and reads from it how far it
# is: its steps, and then pacman's packages as they download and go in.
track() {
  local line phase='' total=1 downloaded=0 installed=0 hooks=0
  while IFS= read -r line; do
    printf '%s\n' "$line"
    case $line in
      '==> Taking the pre-update snapshot') progress 1 "Taking a snapshot" ;;
      '==> Pointing pacman at '* | '==> Updating the keyrings') progress 3 "Preparing" ;;
      '==> pacman -S'*) phase=pacman; progress 5 "Downloading" ;;
      '==> Installing for this computer: '*) phase=''; progress 92 "Installing drivers" ;;
      '==> Installing '*) phase=''; progress $(( ${#release_flags[@]} ? 93 : 50 )) "Installing apps" ;;
      '==> Taking the post-update snapshot') progress 95 "Taking a snapshot" ;;
      '==> Checking the boot '*) progress 97 "Checking the boot entries" ;;
      *': restart to finish the update.') st_restart=1 ;;
      'nova update: '*) last_error=${line#nova update: } ;;
    esac
    [[ $phase == pacman ]] || continue
    if [[ $line =~ ^Packages\ \(([0-9]+)\) ]]; then
      total=${BASH_REMATCH[1]}
    elif [[ $line =~ ^\ ?[^\ ]+\ downloading\.\.\.$ ]]; then
      (( downloaded < total )) && downloaded=$((downloaded + 1))
      progress $((5 + 35 * downloaded / total)) "Downloading"
    elif [[ $line =~ ^(installing|upgrading|reinstalling|downgrading|removing)\ [^\ ]+\.\.\.$ ]]; then
      (( installed < total )) && installed=$((installed + 1))
      progress $((40 + 42 * installed / total)) "Installing"
    elif [[ $line == ':: Running post-transaction hooks...' ]]; then
      hooks=1
      progress 82 "Finishing"
    elif (( hooks )) && [[ $line =~ ^\(\ *([0-9]+)/([0-9]+)\)\  ]]; then
      progress $((82 + 10 * BASH_REMATCH[1] / BASH_REMATCH[2])) "Finishing"
    fi
  done
}

# The version in a package's file name, as pacman -Q prints it.
package_version() { # app file
  local name=${2##*/}
  name=${name%-*}
  printf '%s' "${name#"$1"-}"
}

# Chrome and VS Code, behind (or missing, with --apps-install), built into
# $build; their files are in packages afterwards, for the root step.
build_apps() {
  local cache=${XDG_CACHE_HOME:-$HOME/.cache}/nova
  mkdir -p "$cache"
  build=$(mktemp -d "$cache/update-build.XXXXXX")
  local -a flags=(--build "$build")
  (( apps_install )) || flags+=(--update)
  local line
  # Not in a condition: set -e stays on inside it. What did not build is in
  # the result.
  "$APPS" "${flags[@]}" "${apps_flags[@]}" 2>&1 | while IFS= read -r line; do
    printf '%s\n' "$line"
    # "==> google-chrome" as each app starts; makepkg's own "==> " lines say more.
    [[ ! $line =~ ^==\>\ ([a-z0-9@._+-]+)$ ]] || progress -1 "Building $(app_name "${BASH_REMATCH[1]}")"
  done || true
  local kind app commit file
  [[ -r $build/result ]] || return 0
  while read -r kind app commit file; do
    case $kind in
      built) packages+=(--package "$file"); built+=("$app $commit $file") ;;
      held) st_held+=("$app") ;;
      *) st_failed+=("$app") ;;
    esac
  done <"$build/result"
}

settings_update() {
  ST_LOG=${STATUS%.json}.log
  mkdir -p "${STATUS%/*}"
  # Building one reviewed app, the others it held still wait.
  local -a waiting=()
  [[ -z $only_app || ! -r $STATUS ]] ||
    mapfile -t waiting < <(jq -r --arg app "$only_app" '.held[]? | select(. != $app)' "$STATUS" 2>/dev/null || true)
  exec >"$ST_LOG" 2>&1
  shopt -s lastpipe
  trap cleanup EXIT
  progress -1 "Checking for updates"
  (( apps_only )) || update_release
  st_version=${release_tag#v}

  local -a packages=() built=() root=()
  build_apps
  st_held+=("${waiting[@]}")
  if (( ${#release_flags[@]} )); then
    root=("${release_flags[@]}" "${packages[@]}")
  elif (( ${#packages[@]} )); then
    root=(--packages-only "${packages[@]}")
  fi

  local cur_pkgver status=0
  cur_pkgver=$(installed_pkgver)
  if (( ${#root[@]} )); then
    progress -1 "Waiting for authentication"
    pkexec "$APPLY" "${root[@]}" 2>&1 | track || status=$?
  fi
  case $status in
    0) st_state='done' ;;
    126) st_state=cancelled ;;
    127) st_state=failed st_error="not authorized to install updates" ;;
    3) st_state=failed st_error="installed, but the boot entries did not check out; do not restart yet" ;;
    *) st_state=failed st_error=${last_error:-the update failed} ;;
  esac

  local entry app commit file
  for entry in "${built[@]}"; do
    read -r app commit file <<<"$entry"
    if [[ $(pacman -Q "$app" 2>/dev/null) == "$app $(package_version "$app" "$file")" ]]; then
      "$APPS" --record "$app" "$commit"
      st_apps+=("$app")
    elif (( status == 0 )); then
      st_failed+=("$app")
    fi
  done
  (( status != 0 )) || st_progress=100
  status_write
  notify_result
  notified=1
  # Last: a restart that takes long, or fails, changes nothing of the above.
  restart_shell "$cur_pkgver"
}

# For a window that may be closed by now.
notify_result() {
  local -a open=(--exec nova-shell shell summon nova.settings '{"page":"updates"}')
  local app names=()
  for app in "${st_apps[@]}"; do names+=("$(app_name "$app")"); done
  case $st_state in
    done)
      if [[ -n $st_version && $(installed_pkgver) == "$(tag_pkgver "$st_version")" ]]; then
        nova-notification-send -g 󰚰 "Nova is up to date" \
          "Now on $st_version.$( (( ! st_restart )) || echo " Restart to finish.")" "${open[@]}"
      elif (( ${#names[@]} )); then
        nova-notification-send -g 󰚰 "${names[0]}${names[1]:+ and ${names[1]}} updated"
      fi
      for app in "${st_held[@]}"; do
        nova-notification-send -g 󰚰 "$(app_name "$app") is waiting for you" \
          "Its recipe changed; Settings shows how." "${open[@]}"
      done
      ;;
    failed) nova-notification-send -u normal -g 󰚰 "The update did not finish" "${st_error^}." "${open[@]}" ;;
  esac >/dev/null 2>&1 || true
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
