#!/bin/bash

# nova:summary=Show or set the place the weather is for
#
#   nova-weather-location                       the place: the one set, else
#                                               the town wttr.in places this
#                                               computer's address in
#   nova-weather-location --set <name> [lat,lon]  set it
#   nova-weather-location --clear               back to the address's town
#
# The place set is $XDG_STATE_HOME/nova/settings/weather.json:
# {"name": ..., "latitude": ..., "longitude": ...}. The coordinates make the
# weather panel's forecast exact, and may be left out: {"name": "Malibu"}
# written by hand works too.

set -euo pipefail

file=${XDG_STATE_HOME:-$HOME/.local/state}/nova/settings/weather.json
coordinates='^(-?[0-9]+(\.[0-9]+)?),(-?[0-9]+(\.[0-9]+)?)$'

case ${1:-} in
  "")
    place=""
    if [[ -f $file ]]; then
      place=$(jq -r '.name // "" | if type == "string" then . else "" end' "$file" 2>/dev/null || true)
    fi
    if [[ -z $place ]]; then
      # wttr.in names a town "Town, Region", and a place without a name by
      # its coordinates, "lat,lon": that stays whole, a query as it is.
      place=$(curl -fsS --max-time 4 'https://wttr.in/?format=%l' 2>/dev/null || true)
      [[ $place =~ $coordinates ]] || place=${place%%,*}
    fi
    [[ -n $place ]] || exit 1
    echo "$place"
    ;;
  --set)
    if [[ -z ${2:-} ]]; then
      echo "Usage: nova-weather-location --set <name> [lat,lon]" >&2
      exit 1
    fi
    if [[ -z ${3:-} ]]; then
      place=$(jq -n --arg name "$2" '{$name}')
    elif [[ $3 =~ $coordinates ]]; then
      place=$(jq -n --arg name "$2" --argjson latitude "${3%,*}" --argjson longitude "${3#*,}" '{$name, $latitude, $longitude}')
    else
      echo "Invalid coordinates: $3 (expected lat,lon)" >&2
      exit 1
    fi
    # Whole or not at all: the weather panel reads it while this writes.
    mkdir -p "${file%/*}"
    echo "$place" >"$file.tmp"
    mv "$file.tmp" "$file"
    ;;
  --clear)
    rm -f "$file"
    ;;
  *)
    echo "Usage: nova-weather-location [--set <name> [lat,lon]|--clear]" >&2
    exit 1
    ;;
esac
