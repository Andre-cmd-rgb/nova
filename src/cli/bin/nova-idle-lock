#!/bin/bash

# nova:summary=Show or set how long the computer waits, unused, before it locks
# nova:args=[minutes|never]
# nova:examples=nova idle lock | nova idle lock 10 | nova idle lock never
#
# idle.lock in ~/.config/nova/shell.json, in seconds; the shell picks it up
# live. Caffeine (nova caffeine) pauses it without changing it.

set -euo pipefail

source nova-shell-config

case ${1:-} in
  "")
    (($# == 0)) || fail "usage: nova idle lock [minutes|never]"
    seconds=$(jq -r 'if (.idle.lock | type) == "number" then .idle.lock else 300 end' "$(source_file)")
    if ((seconds <= 0)); then
      echo "never"
    else
      echo "$(((seconds + 59) / 60)) min"
    fi
    ;;
  never) commit '.idle.lock = 0' && echo "The computer no longer locks by itself." ;;
  *)
    if ! [[ $# == 1 && $1 =~ ^[0-9]{1,3}$ ]] || ((10#$1 < 1 || 10#$1 > 720)); then
      fail "usage: nova idle lock [minutes|never], minutes from 1 to 720"
    fi
    minutes=$((10#$1))
    commit ".idle.lock = \$s" --argjson s "$((minutes * 60))"
    echo "Locks after $minutes min unused."
    ;;
esac
