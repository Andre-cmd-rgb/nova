#!/bin/bash

# nova:summary=Pop the focused window out to float, pinned on every workspace, or back
# nova:args=[width height x y]

set -euo pipefail

width=${1:-1300}
height=${2:-900}
x=${3:-}
y=${4:-}

window=$(hyprctl activewindow -j)
window=$(jq -r '[.pinned // false, .address // ""] | @tsv' <<<"$window")
read -r pinned address <<<"$window"
target="address:$address"

# Each step as Hyprland's Lua dispatcher, and as the older dispatcher by name
# where that one is refused.
step() { # lua dispatcher [args...]
  local lua=$1
  shift
  hyprctl dispatch "$lua" >/dev/null 2>&1 || hyprctl dispatch "$@" >/dev/null
}

# A popped window is the one pinned: it goes back into the tiling, and loses
# the tag that marks it.
if [[ $pinned == true ]]; then
  step "hl.dsp.window.pin({ window = \"$target\" })" pin "$target"
  step "hl.dsp.window.float({ window = \"$target\", action = \"toggle\" })" togglefloating "$target"
  step "hl.dsp.window.tag({ window = \"$target\", tag = \"-pop\" })" tagwindow -pop "$target"
  exit 0
fi

[[ -n $address ]] || exit 0

step "hl.dsp.window.float({ window = \"$target\", action = \"toggle\" })" togglefloating "$target"
step "hl.dsp.window.resize({ window = \"$target\", x = $width, y = $height })" resizeactive exact "$width" "$height" "$target"
if [[ -n $x && -n $y ]]; then
  step "hl.dsp.window.move({ window = \"$target\", x = $x, y = $y })" moveactive "$x" "$y" "$target"
else
  step "hl.dsp.window.center({ window = \"$target\" })" centerwindow "$target"
fi
step "hl.dsp.window.pin({ window = \"$target\" })" pin "$target"
step "hl.dsp.window.alter_zorder({ window = \"$target\", mode = \"top\" })" alterzorder top "$target"
step "hl.dsp.window.tag({ window = \"$target\", tag = \"+pop\" })" tagwindow +pop "$target"
