#!/bin/bash

# nova:summary=Focus a Hyprland window by application identity
# nova:args=<app-name>

set -euo pipefail

usage() {
  echo "Usage: nova-hyprland-focus-app <app-name>" >&2
  exit 1
}

app=${1:-}
[[ -n $app ]] || usage

# Among several matches take the one focused last, which is also the window a
# browser hands a new tab to. An unreachable compositor has no windows to focus,
# which the check below reports.
address=$(
  { hyprctl clients -j 2>/dev/null || true; } |
    jq -r --arg pattern "$app" \
      'def matches($value): ($value // "") | test($pattern; "i");
       sort_by(.focusHistoryID) |
       first(.[] | select(matches(.class))).address // empty'
)

[[ -n $address ]] || exit 1

hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null 2>&1 ||
  hyprctl dispatch focuswindow "address:$address" >/dev/null
