#!/bin/bash

# nova:summary=Launch an app or focus an existing window matching a pattern
# nova:args=<window-pattern> <launch-command>

set -euo pipefail

if (($# == 0)); then
  echo "Usage: nova-launch-or-focus <window-pattern> [launch-command]" >&2
  exit 1
fi

WINDOW_PATTERN="$1"
LAUNCH_COMMAND="${2:-"uwsm-app -- $WINDOW_PATTERN"}"
WINDOW_ADDRESS=$(hyprctl clients -j | jq -r --arg p "$WINDOW_PATTERN" 'first(.[]|select((.class|test("\\b" + $p + "\\b";"i")) or (.title|test("\\b" + $p + "\\b";"i")))|.address)')

if [[ -n $WINDOW_ADDRESS ]]; then
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$WINDOW_ADDRESS\" })" >/dev/null 2>&1 || hyprctl dispatch focuswindow "address:$WINDOW_ADDRESS"
else
  # The launch command is a shell command line, so it is evaluated as one.
  eval exec setsid "$LAUNCH_COMMAND"
fi
