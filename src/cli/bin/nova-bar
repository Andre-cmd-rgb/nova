#!/bin/bash

# nova:summary=Configure the bar and its widget layout
# nova:args=defaults | position [top|bottom|left|right] | transparent [true|false|toggle] | put <id> [placement] | remove <id> | move <id> [placement] | set <id> <key> <value> [--json] [placement]

set -euo pipefail

source nova-shell-config

usage() {
  cat <<USAGE
Usage: nova bar <command> [args...]

  defaults                             Restore the default bar layout
  position [top|bottom|left|right]     Show or set the bar position
  transparent [true|false|toggle]      Show (on/off) or set bar transparency
  put <id> [placement]                 Put a widget on the bar, leaving one
                                       that is already there where it is
  remove <id>                          Take a widget off the bar; one that is
                                       off by default (Screen Time) stops too
  move <id> [placement]                Move a widget within or between sections
  set <id> <key> <value> [--json] [placement]
                                       Set a per-widget option

Placement:
  --section <left|center|right>        Target section
  --index <n>                          Target index
  --before <id>                        Insert before a widget
  --after <id>                         Insert after a widget
  --from-section <section>             Source section
  --from-index <n>                     Source index

'put' leaves a widget that is already on the bar where it is, and falls back to
the widget's usual spot when --before / --after names a widget the bar does not
carry.

Examples:
  nova bar position bottom
  nova bar put nova.keyboard-layout --after nova.clock
  nova bar remove nova.weather
  nova bar move nova.media left
  nova bar move nova.clock --section center --index 0
  nova bar set nova.clock format HH:mm
USAGE
}

# The layout lives in the shell, which holds the settings in memory: widgets
# are put, moved and set by asking it, not by changing the file behind it.
# What the bar as a whole looks like is the settings', and changed there.

section() { # value
  [[ $1 =~ ^(left|center|right)$ ]] || fail "section must be left, center, or right"
}
index() { # value
  [[ $1 =~ ^[0-9]+$ ]] || fail "index must be a non-negative integer"
}

# Where a widget goes, and where from, from the placement options.
to_section="" to_index="" before="" after="" from_section="" from_index=""
placement() { # option...
  while (($#)); do
    case $1 in
      --section) section "${2:-}" && to_section=$2 ;;
      --index) index "${2:-}" && to_index=$2 ;;
      --before)
        before=${2:-}
        [[ -n $before ]] || fail "--before requires a widget id"
        ;;
      --after)
        after=${2:-}
        [[ -n $after ]] || fail "--after requires a widget id"
        ;;
      --from-section) section "${2:-}" && from_section=$2 ;;
      --from-index) index "${2:-}" && from_index=$2 ;;
      -h | --help)
        usage
        exit 0
        ;;
      *) fail "unknown option: $1" ;;
    esac
    shift 2
  done
  [[ -z $before || -z $after ]] || fail "use only one of --before or --after"
}

# The placement as the shell takes it: only what was given.
# shellcheck disable=SC2016 # jq's own variables
placement_json() {
  jq -cn --arg section "$to_section" --arg index "$to_index" --arg before "$before" --arg after "$after" \
    --arg fromSection "$from_section" --arg fromIndex "$from_index" '
    $ARGS.named
    | .index |= (select(. != "") | tonumber)
    | .fromIndex |= (select(. != "") | tonumber)
    | with_entries(select(.value != ""))'
}

# A section given before the options, as in "move nova.media left", in
# $positional; the options after it in $rest.
positional="" rest=()
section_first() { # option...
  positional=""
  if (($#)) && [[ $1 != --* ]]; then
    section "$1"
    positional=$1
    shift
  fi
  rest=("$@")
}

defaults() {
  (($# == 0)) || fail "defaults does not take arguments"
  # In one change to the file, which the shell's settings in memory cannot
  # come between.
  commit "$NORMALIZE | .bar = \$defaults[0].bar" --slurpfile defaults "$DEFAULTS_FILE"
  echo "Restored the default Nova bar"
}

# Without a value, what it is: the menu reads it to tick its row.
position() {
  (($# <= 1)) || fail "position takes a single value"
  local position=${1:-}
  if [[ -z $position ]]; then
    jq -r '.bar.position // "top"' "$(source_file)"
    return 0
  fi
  [[ $position =~ ^(top|bottom|left|right)$ ]] || fail "position must be top, bottom, left, or right"
  commit "$NORMALIZE | .bar.position = \$position" --arg position "$position"
  echo "Bar position set to $position"
}

# Without a value, on or off, for the menu.
transparent() {
  (($# <= 1)) || fail "transparent takes a single value"
  local transparent=${1:-}
  case $transparent in
    "")
      jq -r 'if .bar.transparent == true then "on" else "off" end' "$(source_file)"
      ;;
    toggle)
      commit "$NORMALIZE | .bar.transparent = (.bar.transparent != true)"
      echo "Bar transparency toggled"
      ;;
    true | false)
      commit "$NORMALIZE | .bar.transparent = \$transparent" --argjson transparent "$transparent"
      echo "Bar transparency set to $transparent"
      ;;
    *) fail "transparent must be true, false, or toggle" ;;
  esac
}

# Asks the shell to put a widget on the bar, in $answer, waiting for one that
# is still coming up. 1 when there is no shell to ask.
answer=""
asked=false
ask_to_put() { # id placement
  local id=$1 attempt missing=0
  for ((attempt = 0; attempt < ${NOVA_SHELL_READY_ATTEMPTS:-50}; attempt++)); do
    if answer=$(nova-shell shell putBarWidget "$id" "$2" 2>&1); then
      asked=true
      [[ $answer == "not ready" ]] || return 0
    elif [[ $answer == *"not ready"* ]]; then
      asked=true
    elif [[ $answer == *"is not running"* ]]; then
      # It answered, and has gone since: it stopped while it was asked.
      if $asked; then fail "nova-shell did not become ready; $id was not put on the bar"; fi
      # A shell just started has no socket yet, and nothing says that one is
      # starting: it is given a few seconds to come.
      if ((++missing >= ${NOVA_SHELL_ABSENT_ATTEMPTS:-30})); then
        echo "nova-shell is not running; $id was not put on the bar" >&2
        return 1
      fi
    else
      fail "could not put $id on the bar: $answer"
    fi
    sleep 0.1
  done
  fail "nova-shell did not become ready; $id was not put on the bar"
}

put() {
  local id=${1:-}
  [[ -n $id ]] || fail "put requires a widget id"
  shift
  section_first "$@"
  placement "${rest[@]}"
  [[ -z $positional || -z $to_section ]] || fail "specify a section positionally or with --section, not both"
  [[ -z $positional ]] || to_section=$positional
  [[ -z $from_section && -z $from_index ]] || fail "put does not accept --from-section or --from-index"

  ask_to_put "$id" "$(placement_json)" || return 0
  [[ $answer != unknown ]] || fail "$id is not a known widget"
  [[ $answer == ok ]] || fail "$answer"
  # The same answer whether it was put there now or was there already.
  echo "$id is on the bar"
}

remove() {
  local id=${1:-} answer
  [[ -n $id ]] || fail "remove requires a widget id"
  (($# == 1)) || fail "remove takes a widget id and nothing else"
  answer=$(nova-shell shell setPluginEnabled "$id" false)
  [[ $answer == ok ]] || fail "could not remove $id: $answer"
  echo "$id is off the bar"
}

move() {
  local id=${1:-} answer
  [[ -n $id ]] || fail "move requires a widget id"
  shift
  section_first "$@"
  placement "${rest[@]}"
  if [[ -n $positional ]]; then
    [[ -z $to_section ]] || fail "specify a section positionally or with --section, not both"
    [[ -z $to_index ]] || fail "specify a section positionally or use --index, not both"
    [[ -z $before ]] || fail "specify a section positionally or use --before, not both"
    [[ -z $after ]] || fail "specify a section positionally or use --after, not both"
    to_section=$positional
  fi
  answer=$(nova-shell shell moveBarWidget "$id" "$(placement_json)")
  [[ $answer == ok ]] || fail "$answer"
  echo "Moved $id"
}

set_option() {
  local id=${1:-} key=${2:-} value=${3:-} json=false value_json answer
  [[ -n $id ]] || fail "set requires a widget id"
  [[ -n $key ]] || fail "set requires a setting key"
  (($# >= 3)) || fail "set requires a value"
  shift 3
  if [[ ${1:-} == --json ]]; then
    json=true
    shift
  fi
  placement "$@"
  [[ -z $before && -z $after ]] || fail "set does not accept --before or --after"
  # shellcheck disable=SC2016 # jq's own variables
  if $json; then
    value_json=$(jq -cn --argjson value "$value" '$value') || fail "invalid JSON value: $value"
  else
    value_json=$(jq -cn --arg value "$value" '$value')
  fi
  answer=$(nova-shell shell setBarWidget "$id" "$key" "$value_json" "$(placement_json)")
  [[ $answer == ok ]] || fail "$answer"
  echo "Set $key on $id"
}

command=${1:-}
if (($#)); then shift; fi
case $command in
  defaults | position | transparent | put | remove | move) "$command" "$@" ;;
  set) set_option "$@" ;;
  -h | --help | help | "") usage ;;
  *) fail "unknown command: $command" ;;
esac
