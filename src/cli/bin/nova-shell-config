#!/bin/bash

# nova:summary=Shared helpers for editing ~/.config/nova/shell.json (source this, don't run it)
# nova:hidden=true

# For the commands that read or change the shell's settings (nova bar, nova
# idle, nova settings):
#   in_effect        the settings in effect, as JSON
#   commit PROGRAM   PROGRAM (jq, with any jq options after it) run on them,
#                    written as the user's, and the shell told to read them;
#                    refused while the user's are there and cannot be read
#   fail MESSAGE     the message, after the command's name, and exit 1
#   NORMALIZE        a jq program giving the settings the shape every change
#                    can count on, to start a change with
#   hours_of KEY ... for the schedules at set hours (nova nightlight
#                    schedule, nova notification schedule): "<from> <to>",
#                    as 22:00, for the arguments <from> <to>, or for `from
#                    <time>` or `to <time>` that one and the other as KEY
#                    has it; a failure for anything else

set -euo pipefail

shell_config=$HOME/.config/nova/shell.json
# shellcheck disable=SC2034 # for the commands that source this
DEFAULTS_FILE=${NOVA_PATH:-/usr/share/nova}/default/shell.json

fail() {
  echo "${0##*/}: $*" >&2
  exit 1
}

# As the shell works them out (services/ShellJson.qml): the user's where
# they are an object at version 1, else Nova's; and where they have no bar,
# Nova's bar, the one the shell draws for them.
in_effect() {
  local file=$shell_config
  if ! jq -e 'type == "object" and .version == 1' "$file" >/dev/null 2>&1; then file=$DEFAULTS_FILE; fi
  jq -c --slurpfile nova "$DEFAULTS_FILE" 'if (.bar | type) == "object" then . else .bar = $nova[0].bar end' "$file"
}

# A time of day as HH:MM; a failure for anything else.
time_of_day() {
  [[ $1 =~ ^([01]?[0-9]|2[0-3]):([0-5][0-9])$ ]] || return 1
  printf '%02d:%s\n' "$((10#${BASH_REMATCH[1]}))" "${BASH_REMATCH[2]}"
}

# One end alone takes the other from the settings, not from what a caller
# read of them before: Settings sends a second change before it has read
# back the first.
hours_of() { # key (<from> <to> | from <time> | to <time>)
  local key=$1 from to
  (($# == 3)) || return 1
  case $2 in
    from | to)
      read -r from to < <(in_effect | jq -r --arg key "$key" '.[$key] | objects // {} | "\(.from) \(.to)"')
      from=$(time_of_day "$from") || from=22:00
      to=$(time_of_day "$to") || to=07:00
      if [[ $2 == from ]]; then from=$(time_of_day "$3"); else to=$(time_of_day "$3"); fi || return 1
      ;;
    *) from=$(time_of_day "$2") && to=$(time_of_day "$3") || return 1 ;;
  esac
  echo "$from $to"
}

# An object at version 1, with a bar, its layout's three sections, and the
# plugins, each made what it should be where it is anything else.
# shellcheck disable=SC2034 # for the commands that source this
NORMALIZE='
  def object: if type == "object" then . else {} end;
  def array: if type == "array" then . else [] end;
  object
  | .version = 1
  | .bar = (.bar | object)
  | .bar.layout = (.bar.layout | object)
  | .bar.layout.left = (.bar.layout.left | array)
  | .bar.layout.center = (.bar.layout.center | array)
  | .bar.layout.right = (.bar.layout.right | array)
  | .plugins = (.plugins | array)'

# Written beside the settings and renamed over them, so that the shell never
# reads them half written. A shell that is not running has nothing to read
# again, and says nothing.
shell_config_next=""
shell_config_cleanup() {
  if [[ -n $shell_config_next ]]; then rm -f "$shell_config_next"; fi
}
trap shell_config_cleanup EXIT

# A file of the user's with something in it that is not settings the shell
# reads (a trailing comma, no version 1) is never written over: the change
# would be made to Nova's, and put those in place of the user's for good. The
# shell refuses the same (ShellJson.qml's blocked).
commit() { # program [jq option...]
  local program=$1
  shift
  if grep -q '[^[:space:]]' "$shell_config" 2>/dev/null &&
    ! jq -e 'type == "object" and .version == 1' "$shell_config" >/dev/null 2>&1; then
    fail "$shell_config is not a config Nova can read; fix it, or move it away, first"
  fi
  mkdir -p "${shell_config%/*}"
  shell_config_next=$(mktemp "$shell_config.XXXXXX")
  in_effect | jq -S -e "$@" "$program" >"$shell_config_next" || fail "could not update shell config"
  mv "$shell_config_next" "$shell_config"
  shell_config_next=""
  nova-shell -q shell reloadConfig
}
