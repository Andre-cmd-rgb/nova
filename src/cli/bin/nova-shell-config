#!/bin/bash

# nova:summary=Shared helpers for editing ~/.config/nova/shell.json (source this, don't run it)
# nova:hidden=true

# For the commands that change the shell's settings (nova bar, nova idle):
#   source_file      the settings to start from: the user's, or Nova's defaults
#   commit PROGRAM   PROGRAM (jq, with any jq options after it) run on them,
#                    written as the user's, and the shell told to read them
#   fail MESSAGE     the message, after the command's name, and exit 1
#   NORMALIZE        a jq program giving the settings the shape every change
#                    can count on, to start a change with

set -euo pipefail

shell_config=$HOME/.config/nova/shell.json
# shellcheck disable=SC2034 # for the commands that source this
DEFAULTS_FILE=$NOVA_PATH/default/shell.json

fail() {
  echo "${0##*/}: $*" >&2
  exit 1
}

source_file() {
  if [[ -s $shell_config ]]; then
    printf '%s\n' "$shell_config"
  else
    printf '%s\n' "$DEFAULTS_FILE"
  fi
}

# An object at version 1, with a bar, its layout's three sections, and the
# plugins, each made what it should be where it is anything else.
# shellcheck disable=SC2034 # for the commands that source this
NORMALIZE='
  def object: if type == "object" then . else {} end;
  def array: if type == "array" then . else [] end;
  object
  | .version = 1
  | .bar = (.bar | object)
  | .bar.layout = (.bar.layout | object)
  | .bar.layout.left = (.bar.layout.left | array)
  | .bar.layout.center = (.bar.layout.center | array)
  | .bar.layout.right = (.bar.layout.right | array)
  | .plugins = (.plugins | array)'

# Written beside the settings and renamed over them, so that the shell never
# reads them half written. A shell that is not running has nothing to read
# again, and says nothing.
shell_config_next=""
shell_config_cleanup() {
  if [[ -n $shell_config_next ]]; then rm -f "$shell_config_next"; fi
}
trap shell_config_cleanup EXIT

commit() { # program [jq option...]
  local program=$1
  shift
  mkdir -p "${shell_config%/*}"
  shell_config_next=$(mktemp "$shell_config.XXXXXX")
  jq -S -e "$@" "$program" "$(source_file)" >"$shell_config_next" || fail "could not update shell config"
  mv "$shell_config_next" "$shell_config"
  shell_config_next=""
  nova-shell -q shell reloadConfig
}
