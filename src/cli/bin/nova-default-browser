#!/bin/bash

# nova:summary=Set the default browser for Nova and XDG handlers
# nova:args=[chromium|chrome|brave|brave-origin|edge|firefox|zen]

set -euo pipefail

# The browsers to choose from: the name given here, the desktop entry, the
# icon and the name the notification shows.
browsers=(
  "chromium chromium.desktop  Chromium"
  "chrome google-chrome.desktop 󰊯 Chrome"
  "brave brave-browser.desktop 󰖟 Brave"
  "brave-origin brave-origin.desktop 󰖟 Brave Origin"
  "edge microsoft-edge.desktop 󰇩 Edge"
  "firefox firefox.desktop 󰈹 Firefox"
  "zen zen.desktop 󰖟 Zen"
)

# Without one, the default browser by the name given here, or its desktop
# entry for one not among them.
if (($# == 0)); then
  current=$(nova-cmd-default-browser || true)
  for browser in "${browsers[@]}"; do
    read -r short entry _ <<<"$browser"
    if [[ $entry == "$current" ]]; then
      echo "$short"
      exit 0
    fi
  done
  echo "$current"
  exit 0
fi

for browser in "${browsers[@]}"; do
  read -r short entry glyph name <<<"$browser"
  [[ $short != "$1" ]] || break
done
if [[ $short != "$1" ]]; then
  echo "Usage: nova-default-browser <chromium|chrome|brave|brave-origin|edge|firefox|zen>" >&2
  exit 1
fi

# xdg-settings reads the handler back to check what it set: without the
# session's $BROWSER and its desktop's own lists, it reads mimeapps.list, which
# is where the browser is kept.
env -u BROWSER XDG_CURRENT_DESKTOP= xdg-settings set default-web-browser "$entry" || exit 1
nova-notification-send -g "$glyph" "$name is now the default browser"
