#!/bin/bash

# nova:summary=List the monospace font families installed

set -euo pipefail

# One family a line, sorted, each once. Emoji and SignWriting fonts call
# themselves monospaced but are no fonts to write in. The filter is awk's, not
# grep -v's: no font left is an answer too, which grep would fail on.
fc-list :spacing=100 -f '%{family[0]}\n' | awk 'tolower($0) !~ /emoji|signwriting/' | sort -u
