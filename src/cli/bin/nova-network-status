#!/bin/bash

# nova:summary=Print active network status for the shell
# nova:args=[--verbose]
# nova:hidden=true

set -euo pipefail

verbose=false
internet_probe=1.1.1.1

case "${1:-}" in
  "")
    ;;
  --verbose)
    verbose=true
    ;;
  *)
    echo "Usage: nova-network-status [--verbose]" >&2
    exit 2
    ;;
esac

print_status() {
  local device nm state ssid signal freq

  device=$(ip route get "$internet_probe" 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }' || true)

  if [[ -z $device ]]; then
    printf 'disconnected\t\t\t\n'
    return
  fi

  if [[ ! -d /sys/class/net/$device/wireless ]]; then
    printf 'ethernet\t%s\t\t\n' "$device"
    return
  fi

  if nova-cmd-present nmcli; then
    nm=$(nmcli -t -f GENERAL.STATE,GENERAL.CONNECTION dev show "$device" 2>/dev/null || true)
    state=$(awk -F: '$1 == "GENERAL.STATE" { print $2; exit }' <<<"$nm")
    ssid=$(awk -F: '$1 == "GENERAL.CONNECTION" { print $2; exit }' <<<"$nm")
    signal=$(nmcli -t -f IN-USE,SIGNAL dev wifi list ifname "$device" --rescan no 2>/dev/null | awk -F: '$1 == "*" { print $2; exit }' || true)
    freq=$(iw dev "$device" link 2>/dev/null | awk '/freq:/ { print $2; exit }' || true)

    if [[ $state != 100* ]]; then
      printf 'disconnected\t\t\t\n'
      return
    fi

    printf 'wifi\t%s\t%s\t%s\n' "${ssid:-$device}" "$signal" "$freq"
    return
  fi

  printf 'wifi\t%s\t\t\n' "$device"
}

# The panel reads this every 1.5 s while it is open, so it parses with bash
# rather than starting a jq or an awk for each field.
ping_latency_ms() {
  local host=$1 line

  while read -r line; do
    if [[ $line =~ time[=\<]([0-9.]+) ]]; then
      printf '%s\n' "${BASH_REMATCH[1]}"
      break
    fi
  done < <(LC_ALL=C ping -n -c 1 -W 1 "$host" 2>/dev/null || true)
}

# Both at once: an unanswered ping takes its full second.
print_ping_samples() {
  local gateway=$1 router internet router_fd internet_fd

  command -v ping >/dev/null || return 0

  if [[ -n $gateway ]]; then
    exec {router_fd}< <(ping_latency_ms "$gateway")
  fi
  exec {internet_fd}< <(ping_latency_ms "$internet_probe")

  if [[ -n $gateway ]]; then
    read -r router <&"$router_fd" || router=""
    exec {router_fd}<&-
    printf 'router_ping_ms\t%s\n' "$router"
  fi

  read -r internet <&"$internet_fd" || internet=""
  exec {internet_fd}<&-
  printf 'internet_ping_ms\t%s\n' "$internet"
}

print_verbose() {
  local -a route words
  local iface="" gw="" src="" prefix="" line value i

  read -r -a route < <(ip route get "$internet_probe" 2>/dev/null || true)
  for ((i = 0; i < ${#route[@]}; i++)); do
    case ${route[i]} in
      dev) iface=${route[i + 1]:-} ;;
      via) gw=${route[i + 1]:-} ;;
      src) src=${route[i + 1]:-} ;;
    esac
  done
  [[ -n $iface ]] || return 0

  # The first IPv4 address's prefix; a point-to-point one has it on the peer.
  read -r line < <(ip -o -4 addr show dev "$iface" 2>/dev/null || true) || true
  if [[ $line =~ inet\ ([^\ ]+\ peer\ )?[^\ /]+/([0-9]+) ]]; then
    prefix=${BASH_REMATCH[2]}
  fi

  printf 'iface\t%s\n' "$iface"
  printf 'ip\t%s\n' "$src"
  printf 'prefix\t%s\n' "$prefix"
  printf 'gateway\t%s\n' "$gw"

  local sys=/sys/class/net/$iface
  if read -r value <"$sys/statistics/rx_bytes" 2>/dev/null; then printf 'rx_bytes\t%s\n' "$value"; fi
  if read -r value <"$sys/statistics/tx_bytes" 2>/dev/null; then printf 'tx_bytes\t%s\n' "$value"; fi

  if [[ -d $sys/wireless ]]; then
    printf 'type\twifi\n'

    if command -v iw >/dev/null; then
      local linked=false ssid="" signal="" freq="" rate="" unit=""

      while IFS= read -r line; do
        linked=true
        line=${line#"${line%%[![:space:]]*}"}
        case $line in
          "SSID: "*) [[ -n $ssid ]] || ssid=${line#SSID: } ;;
          "signal: "*)
            read -r -a words <<<"${line#signal: }"
            [[ -n $signal ]] || signal=${words[0]:-}
            ;;
          "freq: "*)
            read -r -a words <<<"${line#freq: }"
            [[ -n $freq ]] || freq=${words[0]:-}
            ;;
          "tx bitrate: "*)
            read -r -a words <<<"${line#tx bitrate: }"
            [[ -n $rate ]] || { rate=${words[0]:-} unit=${words[1]:-}; }
            ;;
        esac
      done < <(iw dev "$iface" link 2>/dev/null || true)

      if [[ $linked == true ]]; then
        printf 'ssid\t%s\n' "$ssid"
        printf 'signal_dbm\t%s\n' "$signal"
        printf 'freq\t%s\n' "$freq"
        printf 'bitrate\t%s %s\n' "$rate" "$unit"
      fi
    fi
  else
    printf 'type\tethernet\n'
    # A link that is down answers EINVAL instead of a speed.
    read -r value <"$sys/speed" 2>/dev/null || value=""
    printf 'speed\t%s\n' "$value"
    read -r value <"$sys/duplex" 2>/dev/null || value=""
    printf 'duplex\t%s\n' "$value"
  fi

  print_ping_samples "$gw"
}

if [[ $verbose == "true" ]]; then
  print_verbose
else
  print_status
fi
