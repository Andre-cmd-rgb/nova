#!/bin/bash

# nova:summary=Print active network status for the shell
# nova:args=[--verbose]
# nova:hidden=true

# One line, tab-separated: the kind of connection (wifi, ethernet or
# disconnected), its network or device, and for Wi-Fi its signal and
# frequency. With --verbose, for the network panel, a reading a line, its name
# and value tab-separated: the route out, the counters, the link, and how long
# a ping takes to the router and to the internet.
#
# The panel reads this every 1.5 seconds while it is open, so it parses in
# bash rather than starting an awk or a jq for each value.

set -euo pipefail

case ${1:-} in
  "") verbose=false ;;
  --verbose) verbose=true ;;
  *)
    echo "Usage: nova-network-status [--verbose]" >&2
    exit 2
    ;;
esac

# The internet, as far as the route and the ping go.
internet=1.1.1.1

# The route out: its device, gateway and address, from the first line ip
# gives, in $iface, $gateway and $source; 1 when it gives no whole line.
route() {
  local -a words
  local i got=0
  iface="" gateway="" source=""
  read -r -a words < <(ip route get "$internet" 2>/dev/null || true) || got=$?
  for ((i = 0; i < ${#words[@]}; i++)); do
    case ${words[i]} in
      dev) iface=${words[i + 1]:-} ;;
      via) gateway=${words[i + 1]:-} ;;
      src) source=${words[i + 1]:-} ;;
    esac
  done
  return "$got"
}

# The Wi-Fi link from iw, in $ssid, $signal, $frequency, $rate and $unit; 1
# when there is none. iw gives the SSID as the rest of its line.
read_link() { # device
  local line
  local -a words
  ssid="" signal="" frequency="" rate="" unit=""
  linked=false
  while IFS= read -r line; do
    linked=true
    line=${line#"${line%%[![:space:]]*}"}
    case $line in
      "SSID: "*) [[ -n $ssid ]] || ssid=${line#SSID: } ;;
      "signal: "*)
        read -r -a words <<<"${line#signal: }"
        [[ -n $signal ]] || signal=${words[0]:-}
        ;;
      "freq: "*)
        read -r -a words <<<"${line#freq: }"
        [[ -n $frequency ]] || frequency=${words[0]:-}
        ;;
      "tx bitrate: "*)
        read -r -a words <<<"${line#tx bitrate: }"
        [[ -n $rate ]] || { rate=${words[0]:-} unit=${words[1]:-}; }
        ;;
    esac
  done < <(iw dev "$1" link 2>/dev/null || true)
  $linked
}

status() {
  local iface gateway source state="" network="" used strength quality="" ssid signal frequency rate unit linked
  local -a nm
  route || true
  if [[ -z $iface ]]; then
    printf 'disconnected\t\t\t\n'
    return
  fi
  if [[ ! -d /sys/class/net/$iface/wireless ]]; then
    printf 'ethernet\t%s\t\t\n' "$iface"
    return
  fi
  if ! command -v nmcli >/dev/null 2>&1; then
    printf 'wifi\t%s\t\t\n' "$iface"
    return
  fi

  # The state's number and the connection's name, unescaped (-e no), so that
  # a name with a colon in it comes whole.
  mapfile -t nm < <(nmcli -e no -g GENERAL.STATE,GENERAL.CONNECTION dev show "$iface" 2>/dev/null || true)
  state=${nm[0]:-}
  network=${nm[1]:-}
  if [[ $state != 100* ]]; then
    printf 'disconnected\t\t\t\n'
    return
  fi
  while IFS=: read -r used strength _; do
    if [[ $used == "*" ]]; then
      quality=$strength
      break
    fi
  done < <(nmcli -t -f IN-USE,SIGNAL dev wifi list ifname "$iface" --rescan no 2>/dev/null || true)
  read_link "$iface" || true
  printf 'wifi\t%s\t%s\t%s\n' "${network:-$iface}" "$quality" "$frequency"
}

# The time a ping takes, in milliseconds; nothing when none comes back.
latency() { # host
  local line
  while read -r line; do
    if [[ $line =~ time[=\<]([0-9.]+) ]]; then
      printf '%s\n' "${BASH_REMATCH[1]}"
      break
    fi
  done < <(LC_ALL=C ping -n -c 1 -W 1 "$1" 2>/dev/null || true)
}

# To the router and the internet at once: a ping not answered takes its whole
# second.
pings() { # gateway
  local router="" outside="" router_fd outside_fd
  command -v ping >/dev/null || return 0
  if [[ -n $1 ]]; then exec {router_fd}< <(latency "$1"); fi
  exec {outside_fd}< <(latency "$internet")
  if [[ -n $1 ]]; then
    read -r router <&"$router_fd" || router=""
    exec {router_fd}<&-
    printf 'router_ping_ms\t%s\n' "$router"
  fi
  read -r outside <&"$outside_fd" || outside=""
  exec {outside_fd}<&-
  printf 'internet_ping_ms\t%s\n' "$outside"
}

details() {
  local iface gateway source line prefix="" value sys
  local ssid signal frequency rate unit linked
  # Offline, with no route out, there is nothing to tell, and it fails.
  route || exit 1
  [[ -n $iface ]] || return 0

  # The first IPv4 address's prefix; a point-to-point one has it on the peer.
  read -r line < <(ip -o -4 addr show dev "$iface" 2>/dev/null || true) || true
  if [[ $line =~ inet\ ([^\ ]+\ peer\ )?[^\ /]+/([0-9]+) ]]; then
    prefix=${BASH_REMATCH[2]}
  fi

  printf 'iface\t%s\n' "$iface"
  printf 'ip\t%s\n' "$source"
  printf 'prefix\t%s\n' "$prefix"
  printf 'gateway\t%s\n' "$gateway"

  sys=/sys/class/net/$iface
  if read -r value <"$sys/statistics/rx_bytes" 2>/dev/null; then printf 'rx_bytes\t%s\n' "$value"; fi
  if read -r value <"$sys/statistics/tx_bytes" 2>/dev/null; then printf 'tx_bytes\t%s\n' "$value"; fi

  if [[ -d $sys/wireless ]]; then
    printf 'type\twifi\n'
    if command -v iw >/dev/null && read_link "$iface"; then
      printf 'ssid\t%s\n' "$ssid"
      printf 'signal_dbm\t%s\n' "$signal"
      printf 'freq\t%s\n' "$frequency"
      printf 'bitrate\t%s %s\n' "$rate" "$unit"
    fi
  else
    printf 'type\tethernet\n'
    # A link that is down answers EINVAL rather than a speed.
    read -r value <"$sys/speed" 2>/dev/null || value=""
    printf 'speed\t%s\n' "$value"
    read -r value <"$sys/duplex" 2>/dev/null || value=""
    printf 'duplex\t%s\n' "$value"
  fi

  pings "$gateway"
}

if $verbose; then
  details
else
  status
fi
