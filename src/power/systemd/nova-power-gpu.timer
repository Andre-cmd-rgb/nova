[Unit]
Description=Retry the discrete GPU power policy
Documentation=https://github.com/Andre-cmd-rgb/nova/blob/main/docs/hardware/thinkpad-p1-gen4i.md
ConditionFirmware=smbios-field(product_version $= "ThinkPad P1 Gen 4i")
# A portable Nova started on a P1 is a guest there: no model's tuning, and no
# NVIDIA driver for this to manage (the card is on nouveau).
ConditionPathExists=!/etc/nova/portable

# Unplugging while something still has the GPU open leaves it powered: the
# policy declines rather than pulling the card out from under a running
# program, and a plug event is a single edge that never comes again. So
# nova-power starts this when the card did not go where it was sent, and
# after each run of the whole policy, for a plug event merged into one: it
# fires once, two minutes on, and a retry that fails starts it again. That
# is also what catches the gap between logging out and logging back in.
# Nothing enables it: a card where it should be has nothing waking for it.
[Timer]
OnActiveSec=2min
AccuracySec=30s
