[Unit]
Description=Load-adaptive CPU, thermal and fan governor
Documentation=https://github.com/Andre-cmd-rgb/nova/blob/main/docs/hardware/thinkpad-p1-gen4i.md
ConditionFirmware=smbios-field(product_version $= "ThinkPad P1 Gen 4i")
# Deliberately NOT After=power-profiles-daemon.service. PPD is itself
# After=multi-user.target, so ordering after it closes a cycle and systemd
# breaks it by deleting PPD's start job — PPD then does not start at boot.
# See docs/hardware/thinkpad-p1-gen4i.md, fact 5; that cost a boot once already.
After=multi-user.target
ConditionPathExists=/sys/class/powercap/intel-rapl:0

[Service]
Type=simple
ExecStart=/usr/lib/nova/nova-powerd
ExecReload=/bin/kill -HUP $MAINPID
# on-failure: with GOVERNOR=off the daemon exits 0 at once, and "always" would
# start it again every two seconds.
Restart=on-failure
RestartSec=2

# This process feeds the EC's fan watchdog. If it is killed outright its own
# restore never runs, so the cleanup is here too — and the watchdog itself is
# the third line, handing the fans back to the EC about thirty seconds later
# whatever else has failed.
ExecStopPost=-/usr/lib/nova/bin/nova-power daemon-stopped

# Being killed for memory pressure while holding the fans at level 0 is the one
# outcome worth spending priority on avoiding.
OOMScoreAdjust=-500
Nice=-5

# It writes four sysfs files, one proc file and reads /proc. Nothing else is
# needed, and a governor that can be talked into writing elsewhere is a bad one.
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
