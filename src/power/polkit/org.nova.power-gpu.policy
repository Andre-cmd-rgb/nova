<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- nova power gpu mode: the person at the computer may choose when the
     discrete GPU is on without a password, as with the power mode. -->
<policyconfig>
  <vendor>Nova</vendor>
  <action id="org.nova.power-gpu">
    <description>Choose when the discrete GPU is on</description>
    <message>Authentication is required to choose when the discrete GPU is on</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/nova/nova-power-gpu-mode-apply</annotate>
  </action>
</policyconfig>
