[Unit]
Description=The kernel's full memory reserve while memory is short
# The boot's value is nova-memory-reserve's, which systemd-sysctl applied.
# Not started where that is the full one already: memory of 8032 MiB and
# less, where nova-memory-reserve's 100 MiB is 1.25% or more of it
# (tests/unit/session/memory-reserve.bats holds the two together). The
# program ends at once on a setting of the administrator's own.
After=systemd-sysctl.service
ConditionMemory=>8032M
ConditionPathExists=/run/sysctl.d/90-nova-memory-reserve.conf
ConditionPathExists=/proc/pressure/memory

[Service]
Type=exec
ExecStart=/usr/lib/nova/nova-memory-pressure
# Ended while the full reserve was in force, it leaves that in force, and
# takes the setting up again when it is started: the mark in its runtime
# directory, kept until the next boot, says the raise was its own.
Restart=on-failure
RestartSec=30
RuntimeDirectory=nova-memory-pressure
RuntimeDirectoryPreserve=yes

# It reads two files and writes one sysctl and one trigger: the sysctl takes
# root's uid alone (root owns it, mode 644), the trigger's one-second window
# takes CAP_SYS_RESOURCE (an unprivileged one is a whole number of two
# seconds). /proc/sys stays writable: no ProtectKernelTunables.
CapabilityBoundingSet=CAP_SYS_RESOURCE
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
