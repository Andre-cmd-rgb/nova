#!/bin/bash
# nova-airdrop-radio: the Wi-Fi card lent to AirDrop, and given back.
#
#   nova-airdrop-radio check   can this computer's card do it, as things are? Says why not. No root.
#   nova-airdrop-radio up      the card leaves the network and becomes the radio of an AWDL node
#   nova-airdrop-radio down    everything undone, whatever state it got to
#
# nova-airdrop@.service runs `up` before the daemon and `down` after it,
# however it ended. docs/airdrop.md has the why of each step.
#
# up: the card joins AWDL's own ad-hoc cell (channel 6, AWDL's BSSID, an
# address made up for this run as its MAC), which makes its hardware
# acknowledge the frames an iPhone sends to that address; beside it, a monitor
# interface under the same address hears and sends the frames. The Wi-Fi is off
# the network for as long as that lasts: one radio, one channel.
#
# Putting the Wi-Fi back is the part that must not fail, so:
#
# - It never writes an address it read from the interface. NetworkManager puts
#   a random address on a card while it scans, and takes the address a card has
#   when it is handed back for the card's own: restoring one read during such a
#   scan left a laptop refused by its router until a restart. The card's own
#   address comes from the card (phy80211/macaddress), every time.
# - What there is to undo is noted in /run before anything is changed, and
#   undoing takes the note first: it can be asked for twice and happens once.
# - Each step of the undoing is tried whatever became of the one before.
# - Only what this made is ever deleted, by the names it gave: nova-cell and
#   nova-mon. On a card with no room for a cell beside the station, the
#   station itself becomes the cell, and is turned back, never deleted.
# - Undoing waits for NetworkManager to be connected again where it was
#   connected before, and says how long that took, or plainly that it is not.

set -euo pipefail

run=${NOVA_AIRDROP_RUN:-/run/nova-airdrop}
note=$run/wifi   # the Wi-Fi interface, whether it was connected, and as what: while there is something to undo
sys=${NOVA_AIRDROP_SYS:-/sys}
bssid=00:25:00:ff:94:73
freq=2437 # channel 6: the one of AWDL's three that every card may send on
cell=nova-cell
mon=nova-mon
# How long the cell may take to start (mac80211 starts it a moment after it is asked), and the Wi-Fi
# to reconnect: fifths of a second.
cell_tries=${NOVA_AIRDROP_CELL_TRIES:-75}
back_tries=${NOVA_AIRDROP_BACK_TRIES:-100}

# Why not, for whoever asked: on stderr, and for `nova airdrop on` to pass on.
refuse() {
  echo "$1" >&2
  [[ ! -d $run || ! -w $run ]] || echo "$1" >"$run/why"
  exit 1
}

wifi_interface() {
  iw dev | awk '$1 == "Interface" { name = $2 } $1 == "type" && $2 == "managed" { print name; exit }'
}

# Sets wifi and phy, or refuses.
check() {
  wifi=$(wifi_interface || true)
  [[ $wifi =~ ^[A-Za-z0-9_.-]{1,15}$ && -e $sys/class/net/$wifi/phy80211 ]] ||
    refuse "There is no Wi-Fi card AirDrop could use, or it is busy as something else (a hotspot)."
  phy=phy$(<"$sys/class/net/$wifi/phy80211/index")
  local kill
  for kill in "$sys/class/net/$wifi/phy80211"/rfkill*; do
    [[ -e $kill/soft ]] || continue
    if [[ $(<"$kill/soft") == 1 || $(<"$kill/hard") == 1 ]]; then
      refuse "The Wi-Fi is switched off. Switch it on and try again."
    fi
  done
  local can
  can=$(iw phy "$phy" info)
  # The modes it has, between that heading and the next.
  local modes
  modes=$(awk '/Supported interface modes:/ { on = 1; next } on && !/^\t\t \*/ { exit } on' <<<"$can")
  [[ $modes == *"* IBSS"* && $modes == *"* monitor"* ]] ||
    refuse "This computer's Wi-Fi card cannot do what AirDrop needs (an ad-hoc cell and a monitor interface)."
  local six
  six=$(grep -E "\* $freq(\.0)? MHz \[6\]" <<<"$can" | head -n 1)
  [[ -n $six && $six != *disabled* && $six != *"no IR"* ]] ||
    refuse "This computer's Wi-Fi card may not send on channel 6 here, which AirDrop needs."
}

connected() { [[ $(nmcli -g GENERAL.STATE device show "$1" 2>/dev/null) == 100* ]]; }

# The country whose rules the card is under: its own where it keeps them itself, else the system's.
country() {
  iw reg get 2>/dev/null | awk -v phy="${phy/phy/phy#}" '
    $1 == "global" { where = "global" }
    $1 ~ /^phy#/ { where = $1 }
    $1 == "country" { sub(":", "", $2); seen[where] = $2 }
    END { print (phy in seen) ? seen[phy] : seen["global"] }'
}

# An address for the node (locally administered, unicast): the cell's, the monitor's and AWDL's.
new_address() {
  local bytes
  bytes=$(od -An -N6 -tx1 /dev/urandom)
  read -r -a bytes <<<"$bytes"
  printf '%02x:%s:%s:%s:%s:%s\n' $(((16#${bytes[0]} & 0xfc) | 0x02)) "${bytes[@]:1}"
}

up() {
  install -d -m 755 "$run"
  rm -f "$run/why" "$run/last" "$run/env"
  : >"$run/busy"
  # A run that never got to undo (there should be none): undone before this one.
  [[ ! -e $note ]] || down
  : >"$run/busy"
  check

  local was="" profile=""
  if connected "$wifi"; then
    was=connected
    profile=$(nmcli -g GENERAL.CON-UUID device show "$wifi" 2>/dev/null || true)
  fi
  # The way back first.
  printf '%s\n%s\n%s\n' "$wifi" "$was" "$profile" >"$note"
  printf 'NOVA_AIRDROP_COUNTRY=%s\n' "$(country)" >"$run/env"

  nmcli device set "$wifi" managed no >/dev/null 2>&1 || true
  ip link set "$wifi" down

  local address
  address=$(new_address)
  # The cell: an interface of its own if the card allows one beside the station, else the station itself.
  if iw phy "$phy" interface add "$cell" type ibss 2>/dev/null; then
    nmcli device set "$cell" managed no >/dev/null 2>&1 || true
    # IP runs on AWDL's own terms, in the daemon's namespace: the kernel keeps off this interface.
    # (Not said of the station where it is the cell: that would outlast AirDrop.)
    sysctl -qw "net.ipv6.conf.$cell.disable_ipv6=1" 2>/dev/null || true
  else
    echo "no second interface for the cell: $wifi becomes the cell"
    cell=$wifi
    iw dev "$wifi" set type ibss || refuse "The Wi-Fi card would not become an ad-hoc cell."
  fi
  ip link set dev "$cell" address "$address"
  ip link set "$cell" up
  # A beacon every ten seconds: an iPhone does not list a node whose cell beacons ten times a second.
  iw dev "$cell" ibss join nova "$freq" HT20 fixed-freq "$bssid" beacon-interval 10000 ||
    refuse "The Wi-Fi card would not start AirDrop's cell on channel 6."
  local started=0
  for _ in $(seq "$cell_tries"); do
    if [[ $(iw dev "$cell" info 2>/dev/null) == *"channel 6 "* ]]; then
      started=1
      break
    fi
    sleep 0.2
  done
  ((started)) || refuse "The Wi-Fi card did not start AirDrop's cell on channel 6."

  iw phy "$phy" interface add "$mon" type monitor || refuse "The Wi-Fi card gave no monitor interface."
  ip link set dev "$mon" address "$address"
  ip link set "$mon" up
  echo "the cell is up on channel 6 and the card acknowledges for $address; $wifi is off the network"
}

down() {
  # The interfaces this makes go whether or not there is a note: nothing else has these names.
  {
    iw dev nova-mon del
    iw dev nova-cell ibss leave
    iw dev nova-cell del
  } >/dev/null 2>&1 || true

  local mine=$note.$$.$RANDOM wifi="" was="" profile=""
  if mv "$note" "$mine" 2>/dev/null; then
    { read -r wifi && read -r was && read -r profile; } <"$mine" || true
    rm -f "$mine"
  fi
  if [[ $wifi =~ ^[A-Za-z0-9_.-]{1,15}$ && -e $sys/class/net/$wifi/phy80211/macaddress ]]; then
    local own handed_back
    own=$(<"$sys/class/net/$wifi/phy80211/macaddress")
    handed_back=$(date +%s%N)
    {
      iw dev "$wifi" ibss leave
      ip link set "$wifi" down
      iw dev "$wifi" set type managed
      ip link set "$wifi" address "$own"
      ip link set "$wifi" up
      nmcli device set "$wifi" managed yes
    } >/dev/null 2>&1 || true

    local verdict now tenths back=0 step
    if [[ $was == connected ]]; then
      for step in $(seq "$back_tries"); do
        if connected "$wifi"; then
          back=1
          break
        fi
        # NetworkManager reconnects by itself after its scan; asked outright if it has not by eight seconds.
        if ((step == 40)) && [[ -n $profile ]]; then
          nmcli --wait 0 connection up uuid "$profile" ifname "$wifi" >/dev/null 2>&1 || true
        fi
        sleep 0.2
      done
      now=$(<"$sys/class/net/$wifi/address")
      tenths=$((($(date +%s%N) - handed_back) / 100000000))
      if ((back)) && [[ $now == "$own" ]]; then
        verdict="The Wi-Fi is back: connected $((tenths / 10)).$((tenths % 10)) s after AirDrop ended."
      elif ((back)); then
        verdict="The Wi-Fi is connected, but under the address $now and not the card's own ($own)."
      else
        verdict="The Wi-Fi has not reconnected in $((tenths / 10)) s. Try: nmcli device connect $wifi"
      fi
    else
      verdict="The Wi-Fi card is the network's again; it was not connected before AirDrop either."
    fi
    echo "$verdict"
    [[ ! -d $run ]] || echo "$verdict" >"$run/last"
  fi
  rm -f "$run/env" "$run/busy"
}

case "$#:${1:-}" in
  1:check) check ;;
  1:up)
    # A step that fails undoes the ones before it; systemd asks for that again, to no effect.
    undo_if_failed() {
      local status=$?
      ((status == 0)) || down || true
      exit "$status"
    }
    trap undo_if_failed EXIT
    up
    ;;
  1:down) down ;;
  *)
    echo "Usage: nova-airdrop-radio check|up|down" >&2
    exit 2
    ;;
esac
