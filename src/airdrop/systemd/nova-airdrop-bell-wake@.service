[Unit]
Description=AirDrop's doorbell back after the computer has slept, for user %i
Documentation=https://github.com/Andre-cmd-rgb/nova/blob/main/docs/airdrop.md
# nova-airdrop-bell@ stops before the computer sleeps, so that it cannot wake
# it. These targets are reached once the computer is awake again.
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=oneshot
# Only for a user still logged in: starting the doorbell would start their
# session's manager too.
ExecStart=/bin/sh -c 'systemctl --quiet is-active user@%i.service || exit 0; exec systemctl --no-block start nova-airdrop-bell@%i.service'

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
