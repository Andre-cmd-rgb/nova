[Unit]
Description=Nova's session watchers: apps keeping the screen awake, the lock before sleep, crashes, displays and drives
Documentation=https://github.com/Andre-cmd-rgb/nova/blob/main/docs/ARCHITECTURE.md
# The duties ask the shell to lock and talk to Hyprland, so they need the
# session's NOVA_PATH, WAYLAND_DISPLAY and HYPRLAND_INSTANCE_SIGNATURE, which
# uwsm has set once wayland-session-waitenv is done. It still starts before
# graphical-session.target is reached, so that the lock before sleep is
# there early.
After=dbus.socket wayland-session-waitenv.service
Requires=dbus.socket
PartOf=graphical-session.target
ConditionEnvironment=NOVA_PATH
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
# Not Type=dbus on org.freedesktop.ScreenSaver: a name another program holds
# would keep the whole service from starting, where only that duty waits.
Type=exec
# Nova's helpers, which the duties run by name.
Environment=PATH=/usr/lib/nova/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/lib/nova/nova-sessiond
# A duty that fails starts again on its own; this is for the process.
Restart=on-failure
RestartSec=2
# Beside Hyprland, out of systemd-oomd's reach: under memory pressure it ends
# what runs in app.slice (a user service's slice otherwise), and the lock
# before sleep must not go with an app.
Slice=session.slice

[Install]
WantedBy=graphical-session.target
