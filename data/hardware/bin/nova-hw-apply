#!/bin/bash

# nova:summary=Install this computer's hardware profile files under /etc
# nova:args=[--remove]
# nova:hidden=true
#
# Run by a pacman hook whenever the nova package is installed or upgraded, and
# with --remove when it is removed. A profile's etc/ tree is copied into /etc,
# and anything an earlier release installed that this one no longer ships is
# deleted, so the list in /var/lib/nova/hardware-files is always exactly what
# is there. These are modprobe, NetworkManager and boot-entry drop-ins, which
# have no way to apply only on one model from /usr.
#
# A portable Nova (/etc/nova/portable, from nova-install --portable) takes no
# model's files: it starts a different computer each time from the same /etc,
# and what is right for one model can be wrong for the next.

set -euo pipefail

# As root, no NOVA_ variable is read, here or by what this runs: they are
# test seams (tests/unit/tools/installed-tree.bats).
if ((EUID == 0)); then for seam in $(compgen -e -X '!NOVA_*'); do unset "$seam"; done; fi

# NOVA_HARDWARE and NOVA_ROOT exist for the tests.
hardware=${NOVA_HARDWARE:-/usr/share/nova/hardware}
root=${NOVA_ROOT:-}
# pacman hooks run without the session PATH, so the sibling is found by path.
detect=${0%/*}/nova-hw-detect
manifest=$root/var/lib/nova/hardware-files
portable=$root/etc/nova/portable

if (($# > 1)) || [[ $# == 1 && $1 != --remove ]]; then
  echo "Usage: nova-hw-apply [--remove]" >&2
  exit 2
fi

wanted=()
if (($# == 0)) && [[ ! -e $portable ]]; then
  status=0
  profile=$("$detect") || status=$?
  # An upgrade from a chroot without /sys cannot tell which computer this is,
  # which is no reason to take its files away.
  if ((status == 2)); then
    echo "nova-hw-apply: cannot read this computer's model; its hardware files are left as they are" >&2
    exit 0
  fi
  if ((status == 0)) && [[ -d $hardware/$profile/etc ]]; then
    src=$hardware/$profile/etc
    while IFS= read -r -d '' file; do
      wanted+=("${file#"$src"/}")
    done < <(find "$src" -type f -print0 | sort -z)
  fi
fi

is_wanted() {
  local entry
  for entry in "${wanted[@]}"; do
    [[ $entry == "$1" ]] && return 0
  done
  return 1
}

# What changed, and whether any of it is read when the boot entries are built:
# the kernel's command line (limine-entry-tool.d) and the initramfs, which
# carries modprobe.d and drops the modules it blacklists. Those take effect
# only when the entries are next built, at a kernel update or limine-update;
# this does not build them (it is the boot path, run from a pacman hook), and
# says so instead. A first install has no manifest yet: its entries are built
# after this.
changed=()
installed=false
[[ -f $manifest ]] && installed=true

if [[ -f $manifest ]]; then
  while IFS= read -r rel; do
    [[ -n $rel && $rel != /* && $rel != *..* ]] || continue
    if ! is_wanted "$rel" && [[ -e $root/etc/$rel ]]; then
      rm -f -- "$root/etc/$rel"
      changed+=("$rel")
    fi
  done <"$manifest"
fi

for rel in "${wanted[@]}"; do
  cmp -s -- "$src/$rel" "$root/etc/$rel" && continue
  install -Dm644 "$src/$rel" "$root/etc/$rel"
  changed+=("$rel")
done

boot=()
for rel in "${changed[@]}"; do
  case $rel in
    modprobe.d/* | limine-entry-tool.d/* | mkinitcpio.conf.d/*) boot+=("/etc/$rel") ;;
  esac
done
if $installed && ((${#boot[@]})) && (($# == 0)); then
  echo "nova-hw-apply: ${boot[*]} changed; it takes effect once the boot entries are built again: at the next kernel update, or now with sudo limine-update."
fi

mkdir -p "${manifest%/*}"
if ((${#wanted[@]})); then
  printf '%s\n' "${wanted[@]}" >"$manifest.new"
else
  : >"$manifest.new"
fi
mv -f "$manifest.new" "$manifest"
