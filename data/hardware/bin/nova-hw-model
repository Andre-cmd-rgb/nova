#!/bin/bash

# nova:summary=Print this computer's model, as its maker names it
# nova:hidden=true
#
# The firmware's DMI tables (/sys/class/dmi/id) have the name, in a different
# field from maker to maker:
#
#   Lenovo            product_version  "ThinkPad P1 Gen 4i" (product_name is its
#                                      type number, 20Y4S0ER00)
#   every other maker product_name     "XPS 13 9310", "Laptop 13 (AMD Ryzen
#                                      7040Series)"; their product_version is a
#                                      revision: "A6", "1.0"
#   a PC built from   board_name       "B550 AORUS ELITE": the case has no
#   parts                              maker, so product_name was never filled in
#
# A field its maker left as it came ("To Be Filled By O.E.M.", "System Product
# Name", "Default string") names nothing, and is passed over. Exits 1, printing
# nothing, when no field names the computer.

set -euo pipefail

dmi=${NOVA_DMI_PATH:-/sys/class/dmi/id}

# A field's text, with the spaces around it gone; nothing for one left unfilled.
field() {
  local text=''
  [[ ! -r $dmi/$1 ]] || text=$(<"$dmi/$1")
  text=${text#"${text%%[![:space:]]*}"}
  text=${text%"${text##*[![:space:]]}"}
  case ${text,,} in
    "" | none | n/a | na | unknown | invalid | oem | o.e.m. | empty | 0 | 00 | x.x) return 0 ;;
    "to be filled"* | "default string"* | "system product name"* | "system version"* | \
      "system name"* | "not applicable"* | "not specified"* | "not available"* | "type1"*) return 0 ;;
  esac
  printf '%s' "$text"
}

model=''
[[ $(field sys_vendor) != [Ll][Ee][Nn][Oo][Vv][Oo] ]] || model=$(field product_version)
[[ -n $model ]] || model=$(field product_name)
[[ -n $model ]] || model=$(field board_name)
[[ -n $model ]] || exit 1
printf '%s\n' "$model"
