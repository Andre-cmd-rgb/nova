{
  // Nova menu definition. Installed to $NOVA_PATH/default/menu.jsonc; entries in
  // ~/.config/nova/menu.jsonc override these key by key.
  //
  // IDs are object keys, and dotted IDs define the tree: capture.screenrecord.stop
  // belongs under capture.screenrecord. An entry with `action` runs it, an entry
  // with `provider` fills its submenu from a provider in Menu.qml, anything else is
  // a submenu. Entries under an action (settings.wifi) are found by a search only.
  // Optional fields:
  //   aliases   extra names for `nova-menu toggle <name>`, also matched by search
  //   title     header shown while the submenu is open (defaults to label)
  //   when      shell condition; the row is hidden when it fails (plain bash,
  //             with the session's environment, the login profile's as the
  //             session started; an action reads the profile as it is now)
  //   once      true: `when` is asked once a session, for what the computer is
  //             and cannot change while it runs (whether it is a laptop)
  //   checked   shell condition; the row gets a ✓ when it succeeds
  //   search    false: a search does not find it, only its menu does (the
  //             answer under a question, such as Restart Now under Restart…)

  // Root
  "apps": {"icon":"󰀻","label":"Apps","aliases":["app","applications"],"provider":"apps"},
  "capture": {"icon":"","label":"Capture","aliases":["screenshot","screenrecord"]},
  "toggle": {"icon":"󰔎","label":"Toggle","aliases":["toggles"]},
  "style": {"icon":"","label":"Style"},
  "power": {"icon":"󰌪","label":"Power Mode","aliases":["power-mode"],"when":"nova-power-profile list","provider":"power-profiles"},
  "settings": {"icon":"","label":"Settings","action":"nova-settings"},
  "store": {"icon":"󰏓","label":"App Center","aliases":["app-store"],"action":"nova apps store"},
  "update": {"icon":"","label":"Update"},
  "system": {"icon":"","label":"System","aliases":["power-menu"]},

  // Capture
  "capture.screenshot": {"icon":"","label":"Screenshot","action":"nova-capture-screenshot"},
  "capture.screenrecord.stop": {"icon":"","label":"Stop Recording","when":"nova-session-pgrep -f '^gpu-screen-recorder'","action":"nova-capture-screenrecording --stop-recording"},
  "capture.screenrecord": {"icon":"","label":"Screen Recording"},
  "capture.screenrecord.no-audio": {"icon":"","label":"Without audio","action":"nova-capture-screenrecording"},
  "capture.screenrecord.desktop-audio": {"icon":"","label":"With desktop audio","action":"nova-capture-screenrecording --with-desktop-audio"},
  "capture.screenrecord.microphone": {"icon":"","label":"With desktop and microphone audio","action":"nova-capture-screenrecording --with-desktop-audio --with-microphone-audio"},
  "capture.text": {"icon":"󰴑","label":"Text","when":"command -v tesseract","action":"nova-capture-text"},
  "capture.color": {"icon":"󰃉","label":"Color","action":"nova-session-pgrep --signal TERM -x hyprpicker || hyprpicker -a"},
  "capture.emoji": {"icon":"","label":"Emoji","aliases":["emoji","emojis"],"action":"nova-shell shell toggle nova.emojis"},

  // Toggle
  "toggle.caffeine": {"icon":"󰅶","label":"Caffeine","checked":"nova-caffeine armed","action":"nova-caffeine toggle"},
  "toggle.notifications": {"icon":"󰂛","label":"Do Not Disturb","checked":"[[ \"$(nova-shell notifications dndState)\" == on ]]","action":"nova-toggle-notification-silencing"},
  "toggle.nightlight": {"icon":"󰔎","label":"Night Light","action":"nova-toggle-nightlight"},
  "toggle.airdrop": {"icon":"󰀃","label":"AirDrop","aliases":["airdrop"],"when":"compgen -G '/sys/class/ieee80211/*'","checked":"nova-airdrop active","action":"nova-shell shell toggle nova.airdrop"},
  "toggle.screentime": {"icon":"󰥔","label":"Screen Time","checked":"nova-screentime enabled","action":"nova-screentime toggle"},
  "toggle.bar": {"icon":"󰍜","label":"Menu Bar","action":"nova-toggle-bar"},
  "toggle.window-gaps": {"icon":"","label":"Window Gaps","action":"nova-hyprland-window-gaps-toggle"},
  "toggle.laptop-display": {"icon":"󰛧","label":"Laptop Display","when":"nova-hw-laptop","once":true,"action":"nova-hyprland-monitor-internal toggle"},
  "toggle.touchpad": {"icon":"󰟸","label":"Touchpad","when":"nova-hw-touchpad","action":"nova-toggle-touchpad"},
  "toggle.discrete-gpu": {"icon":"󰢮","label":"Discrete GPU","when":"[[ $(nova-hw-detect) == thinkpad-p1-gen4i ]]","once":true,"action":"nova-power-gpu toggle"},

  // Style
  "style.theme": {"icon":"󰸌","label":"Theme","aliases":["theme","themes"],"action":"nova-theme pick"},
  "style.background": {"icon":"","label":"Background","aliases":["background","wallpaper"],"action":"nova-theme bg pick"},
  "style.font": {"icon":"","label":"Font","provider":"fonts"},
  "style.bar": {"icon":"󰂵","label":"Transparent Menu Bar","checked":"[[ \"$(nova-bar transparent)\" == on ]]","action":"nova-bar transparent toggle"},

  // Update
  "update.nova": {"icon":"󰚰","label":"Nova","action":"nova-settings updates"},
  "update.firmware": {"icon":"","label":"Firmware","when":"command -v fwupdmgr","action":"nova-settings updates"},
  "update.restart": {"icon":"󰜉","label":"Restart","title":"Restart a service"},
  "update.restart.shell": {"icon":"󰍜","label":"Shell","action":"nova-restart-shell"},
  "update.restart.audio": {"icon":"","label":"Audio","action":"nova-restart-audio"},
  "update.restart.wifi": {"icon":"󱚾","label":"Wi-Fi","action":"nova-restart-wifi"},
  "update.restart.bluetooth": {"icon":"󰂯","label":"Bluetooth","action":"nova-restart-bluetooth"},
  "update.timezone": {"icon":"","label":"Timezone","action":"nova-menu-timezone"},
  "update.password": {"icon":"","label":"Password","action":"nova-shell shell summon nova.settings '{\"page\":\"lock\",\"sheet\":\"password\"}'"},

  // System
  "system.lock": {"icon":"","label":"Lock","action":"nova-system-lock"},
  "system.suspend": {"icon":"󰒲","label":"Suspend","action":"systemctl sleep"},
  "system.hibernate": {"icon":"󰤁","label":"Hibernate","when":"nova-hibernation-available","action":"systemctl hibernate"},
  // Each that closes every app asks first: an Enter on a search for it opens
  // the question, and only the row under it does it.
  "system.logout": {"icon":"󰍃","label":"Log Out…","title":"Log out?"},
  "system.logout.now": {"icon":"󰍃","label":"Log Out Now","search":false,"action":"nova-system-logout"},
  "system.reboot": {"icon":"󰜉","label":"Restart…","title":"Restart the computer?"},
  "system.reboot.now": {"icon":"󰜉","label":"Restart Now","search":false,"action":"nova-system-reboot"},
  "system.recovery": {"icon":"󰁯","label":"Restart to Recovery…","title":"Restart into the boot menu?"},
  "system.recovery.now": {"icon":"󰁯","label":"Restart Now","search":false,"action":"nova-recovery"},
  "system.shutdown": {"icon":"󰐥","label":"Shut Down…","title":"Shut down the computer?"},
  "system.shutdown.now": {"icon":"󰐥","label":"Shut Down Now","search":false,"action":"nova-system-shutdown"},

  // Settings' pages, which a search finds under Settings (where Return on
  // Settings itself opens it at its first page), each where this computer
  // has the page
  "settings.wifi": {"icon":"󰖩","label":"Wi-Fi","aliases":["wireless","network","internet"],"when":"grep -qsx wlan /sys/class/rfkill/*/type","action":"nova-settings wifi"},
  "settings.bluetooth": {"icon":"󰂯","label":"Bluetooth","aliases":["pairing"],"when":"grep -qsx bluetooth /sys/class/rfkill/*/type","action":"nova-settings bluetooth"},
  "settings.mobile-data": {"icon":"󰞃","label":"Mobile Data","aliases":["cellular","modem","sim","apn","5g","lte"],"when":"grep -qsx wwan /sys/class/rfkill/*/type","action":"nova-settings mobile-data"},
  "settings.airdrop": {"icon":"󰀃","label":"AirDrop","when":"nova-airdrop available","action":"nova-settings airdrop"},
  "settings.notifications": {"icon":"󰂚","label":"Notifications","aliases":["do not disturb","dnd","alerts"],"action":"nova-settings notifications"},
  "settings.sound": {"icon":"󰕾","label":"Sound","aliases":["audio","volume","speakers","headphones","microphone"],"action":"nova-settings sound"},
  "settings.displays": {"icon":"󰍹","label":"Displays","aliases":["monitor","screen","resolution","scale","night light"],"action":"nova-settings displays"},
  "settings.keyboard": {"icon":"󰌌","label":"Keyboard & Mouse","aliases":["touchpad","trackpad","layout","input","scrolling"],"action":"nova-settings keyboard"},
  "settings.printers": {"icon":"󰐪","label":"Printers","aliases":["printer","print","scanner","cups","ink","toner"],"action":"nova-settings printers"},
  "settings.battery": {"icon":"󰁹","label":"Battery","aliases":["charge","lid","hibernate","power button"],"when":"grep -qsx Battery /sys/class/power_supply/BAT*/type","action":"nova-settings battery"},
  "settings.performance": {"icon":"󰓅","label":"Performance","aliases":["undervolt","gpu","cpu"],"when":"grep -qm1 GenuineIntel /proc/cpuinfo || nova-power-profile list","action":"nova-settings performance"},
  "settings.screentime": {"icon":"󰥔","label":"Screen Time","aliases":["usage"],"action":"nova-settings screentime"},
  "settings.appearance": {"icon":"󰸌","label":"Appearance","aliases":["dark mode","light mode","text size","fonts"],"action":"nova-settings appearance"},
  "settings.bar": {"icon":"󰍜","label":"Menu Bar","aliases":["widgets"],"action":"nova-settings bar"},
  "settings.lock": {"icon":"󰌾","label":"Lock Screen","aliases":["password","screensaver","fingerprint"],"action":"nova-settings lock"},
  "settings.apps": {"icon":"󰀻","label":"Default Apps","aliases":["browser","editor","terminal"],"action":"nova-settings apps"},
  "settings.updates": {"icon":"󰚰","label":"Updates","aliases":["upgrade"],"action":"nova-settings updates"},
  "settings.about": {"icon":"󰋼","label":"About","aliases":["version","computer","hostname"],"action":"nova-settings about"},
}
