[Unit]
Description=XSETTINGS for X11 apps: the scale XWayland's apps draw at
# Started and told each new scale by nova-hyprland-x11-scale, which writes the
# settings; it ends with the session.
PartOf=graphical-session.target
ConditionPathExists=%t/nova/xsettingsd.conf

[Service]
ExecStart=/usr/bin/xsettingsd -c %t/nova/xsettingsd.conf
ExecReload=/usr/bin/kill -HUP $MAINPID
# An XWayland that went takes xsettingsd with it; it comes back with the next.
Restart=on-failure
RestartSec=2
