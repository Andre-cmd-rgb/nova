[Unit]
Description=Say when one of Nova's services has failed
# Run by nova-doctor-services.timer; each failure is said once.
After=graphical-session.target

[Service]
Type=oneshot
# Nova's helpers call each other by name.
Environment=PATH=/usr/lib/nova/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/lib/nova/bin/nova-doctor-services
TimeoutStartSec=2min
