[Unit]
Description=Turn on this laptop's speaker tuning, or keep it current
# The tuning goes in front of the speakers' sink, so the audio server has to be
# there. nova-audio-tuning does nothing on a computer without a tuning.
After=pipewire.service pipewire-pulse.service wireplumber.service wayland-session-waitenv.service
Wants=pipewire-pulse.service wireplumber.service
ConditionEnvironment=NOVA_PATH

[Service]
Type=oneshot
# Nova's helpers call each other by name.
Environment=PATH=/usr/lib/nova/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/lib/nova/bin/nova-audio-tuning auto

[Install]
WantedBy=graphical-session.target
