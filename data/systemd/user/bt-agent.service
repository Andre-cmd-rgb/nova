[Unit]
Description=Bluetooth pairing agent, for the pairing nova-bluetooth-device runs
Documentation=man:bt-agent(1)
ConditionPathIsDirectory=/sys/class/bluetooth
# It registers with BlueZ over the system bus.
After=dbus.socket
Requires=dbus.socket

[Service]
Type=simple
# No BlueZ running (no adapter, a virtual machine): nothing to register with,
# so the unit is skipped rather than failed.
ExecCondition=/usr/bin/systemctl is-active --quiet bluetooth.service
# NoInputNoOutput accepts every pairing without asking, and BlueZ keeps the
# adapter pairable for as long as an agent is registered: left running, any
# device in range that knows the address could pair, a keyboard included.
# So nothing enables this unit; nova-bluetooth-device starts it for the
# pairing the user picked and stops it after, and it ends itself after two
# minutes in case that stop never comes.
ExecStart=/usr/bin/bt-agent -c NoInputNoOutput
RuntimeMaxSec=120
# bt-agent can sit on SIGTERM, and with systemd's 90 s default it stayed
# registered, saying yes to any pairing, that long after the one picked had
# ended. Killed, it is gone at once: BlueZ drops an agent when its connection
# to the bus closes.
TimeoutStopSec=2
