[Unit]
Description=Turn the laptop's own display back on when it is off and nothing else is plugged in
# Before Hyprland starts, which would otherwise come up with no display at all.
Before=graphical-session-pre.target
ConditionPathExists=%S/nova/toggles/hypr/internal-monitor-disable.lua

[Service]
Type=oneshot
# Nova's helpers call each other by name.
Environment=PATH=/usr/lib/nova/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/lib/nova/bin/nova-hw-recover-internal-monitor

[Install]
WantedBy=graphical-session-pre.target
