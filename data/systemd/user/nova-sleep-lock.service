[Unit]
Description=Lock Nova before suspend
# The monitor calls into the running Nova shell. Wait until UWSM has imported
# NOVA_PATH and WAYLAND_DISPLAY, but keep the default target ordering so the
# monitor starts before graphical-session.target is reached.
After=dbus.socket wayland-session-waitenv.service
Requires=dbus.socket
PartOf=graphical-session.target
ConditionEnvironment=NOVA_PATH
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
# Nova's helpers call each other by name.
Environment=PATH=/usr/lib/nova/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/lib/nova/bin/nova-system-sleep-monitor
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
