#!/bin/bash
# nova-memory-reserve: how much memory the kernel keeps free ahead of need,
# worked out from the size of this computer's memory and written, each boot,
# as /run/sysctl.d/90-nova-memory-reserve.conf, just before systemd-sysctl
# reads the settings (systemd-sysctl.service.d/10-nova-memory-reserve.conf).
#
# The kernel wakes its background reclaim (kswapd) when free memory falls to
# the low watermark, and makes a program that asks for memory do the
# reclaiming itself, stalled, at the min watermark. The gap between the two
# is the head start the background has on a burst, and with swap on zram a
# burst is worth absorbing: reclaim there is compression, which another CPU
# can do meanwhile. vm.watermark_scale_factor sets the gap as a share of
# memory, in ten-thousandths; the kernel's own 10 (0.1%) is 8 MiB on an 8 GB
# computer. Nova's 125 (1.25%, the usual advice with zram) makes it 100 MiB
# there, and measurably fewer stalls (docs/ARCHITECTURE.md, Memory).
#
# A share is the wrong measure on a big machine, though: the head start is a
# quantity (how much a burst takes before the background catches up), not a
# proportion. At 125 a 32 GB computer keeps 0.86 GiB free at all times that
# no cache may use, counts another 0.46 GiB of cache as unavailable, and
# holds up to 0.46 GiB more on its per-CPU free lists (they follow the low
# watermark, and MemFree leaves them out): about 2 GiB shown as memory in
# use at rest, for a head start four times that of an 8 GB one, with no
# fewer stalls to show for it. So the gap is 1.25% of memory up to GAP_MIB
# and that many MiB above, never under the kernel's own 0.1%:
#
#   memory    factor   gap
#   4 GB      125      49 MiB
#   8 GB      125      98 MiB
#   16 GB     63       100 MiB
#   32 GB     31       100 MiB
#   64 GB     16       100 MiB
#   128 GB    10       126 MiB (the kernel's own)
#
# An administrator's vm.watermark_scale_factor in /etc/sysctl.d wins, as any
# file there sorted after this one does, and a file of this one's name there
# replaces it (sysctl.d(5)).
#
#   nova-memory-reserve          write the file
#   nova-memory-reserve --print  the factor alone
#
# NOVA_PROC and NOVA_RUN point it at a fixture (tests/unit/session/memory-reserve.bats).
set -euo pipefail

PROC=${NOVA_PROC:-/proc}
RUN=${NOVA_RUN:-/run}
GAP_MIB=100
MOST=125 # 1.25%: Nova's share on a small machine
LEAST=10 # 0.1%: the kernel's own

total_kb=$(awk '/^MemTotal:/ { print $2; exit }' "$PROC/meminfo")
[[ $total_kb =~ ^[0-9]+$ ]] && ((total_kb > 0)) || { echo "nova-memory-reserve: no MemTotal in $PROC/meminfo" >&2; exit 1; }

# The factor whose share of memory is GAP_MIB, to the nearest whole one.
factor=$(((GAP_MIB * 1024 * 10000 + total_kb / 2) / total_kb))
((factor <= MOST)) || factor=$MOST
((factor >= LEAST)) || factor=$LEAST

if [[ ${1:-} == --print ]]; then
  echo "$factor"
  exit 0
fi

mkdir -p "$RUN/sysctl.d"
cat >"$RUN/sysctl.d/90-nova-memory-reserve.conf.new" <<CONF
# Written at boot by /usr/lib/nova/nova-memory-reserve for $((total_kb / 1024)) MiB of memory:
# background reclaim starts $((total_kb * factor / 10000 / 1024)) MiB before a program would stall.
vm.watermark_scale_factor = $factor
CONF
mv -f "$RUN/sysctl.d/90-nova-memory-reserve.conf.new" "$RUN/sysctl.d/90-nova-memory-reserve.conf"
