#!/bin/bash
# nova-caffeine-modem: keep the 5G modem out of runtime suspend, or let it
# suspend again. Root's half of nova caffeine, run through pkexec.
#
#   nova-caffeine-modem on|auto
#
# Writes only the power/control of the device bound to mhi-pci-generic, and
# only "on" or "auto".
set -euo pipefail
export PATH=/usr/bin

PCI_DEVICES=${NOVA_PCI_DEVICES_PATH:-/sys/bus/pci/devices}

[[ ${1:-} == on || ${1:-} == auto ]] || {
  echo "usage: nova-caffeine-modem on|auto" >&2
  exit 2
}
for d in "$PCI_DEVICES"/*; do
  driver=$(readlink -f "$d/driver" 2>/dev/null) || continue
  [[ ${driver##*/} == mhi-pci-generic ]] || continue
  echo "$1" >"$d/power/control"
  exit 0
done
echo "nova-caffeine-modem: no modem on mhi-pci-generic" >&2
exit 1
