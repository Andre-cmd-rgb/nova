[Unit]
Description=Nova session guard (end an autologin session whose lock never engaged)
PartOf=graphical-session.target
# No order against graphical-session.target, either way. A target waits for
# a unit it wants unless that unit has DefaultDependencies=no, and this one is
# done only once the lock is secure: the target, and with it the desktop
# portal (After=graphical-session.target), waited for the lock, and a shell
# that asked the portal as it started never locked, so the guard ended the
# session. Nor does the guard wait for the target, which waits for every unit
# the session wants: it starts with the session, whatever else hangs.
# Autostart apps do wait for it, on purpose:
# data/systemd/user/app-.service.d/10-nova-after-lock.conf. The rest is what
# DefaultDependencies gives a user service.
DefaultDependencies=no
Requires=basic.target
After=basic.target graphical-session-pre.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
Environment=PATH=/usr/lib/nova/bin:/usr/local/bin:/usr/bin
RemainAfterExit=yes
# uwsm keeps XDG_SESSION_ID out of the user manager and writes it here instead.
EnvironmentFile=-%t/uwsm/env_session.conf
ExecStart=/usr/lib/nova/bin/nova-session-guard
# The guard keeps its own time: 75 asks, each cut off after two seconds. A
# start timeout killing it first (90 s, the default, while a shell that is up
# but not answering yet takes up to 165) left the session running unguarded.
TimeoutStartSec=infinity

[Install]
WantedBy=graphical-session.target
