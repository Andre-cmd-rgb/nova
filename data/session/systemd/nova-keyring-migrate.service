[Unit]
Description=Move secrets from the passwordless Default keyring into the login keyring
After=nova-unlocked.target
# The installer drops this marker when it restores a carried-over keyring and the
# helper removes it once the migration is verified.
ConditionPathExists=%h/.local/state/nova/keyring-migrate-pending
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
ExecStart=/usr/lib/nova/bin/nova-keyring-migrate
Restart=on-failure
RestartSec=5

[Install]
WantedBy=nova-unlocked.target
