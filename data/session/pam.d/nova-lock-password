#%PAM-1.0
# Password unlock for the Quickshell lock screen. Ten wrong attempts lock the
# account for two minutes; a correct one resets the counter. No nullok: an account
# without a password can never unlock. Only a correct password reaches
# pam_gnome_keyring, which unlocks the login keyring with it (the daemon is already
# running, so the module unlocks during auth; the lock never opens a PAM session).
auth       required                    pam_faillock.so preauth silent deny=10 unlock_time=120
-auth      [success=2 default=ignore]  pam_systemd_home.so
auth       [success=1 default=bad]     pam_unix.so try_first_pass
auth       [default=die]               pam_faillock.so authfail deny=10 unlock_time=120
auth       optional                    pam_permit.so
auth       required                    pam_env.so
auth       required                    pam_faillock.so authsucc
-auth      optional                    pam_gnome_keyring.so
account    include                     system-local-login
