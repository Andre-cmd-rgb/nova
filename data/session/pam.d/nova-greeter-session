#%PAM-1.0
# The greeter's own session (greetd default_session.service): the unprivileged
# `greeter` user, never authenticated, only registered with logind so Hyprland can
# open the GPU and the input devices.
auth       required    pam_permit.so
account    required    pam_permit.so
password   required    pam_deny.so
session    required    pam_unix.so
session    optional    pam_systemd.so
