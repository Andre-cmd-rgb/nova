# Nova's session environment, sourced by uwsm for every graphical session and exported
# to the systemd user manager and the D-Bus activation environment.
# Changes take effect at the next login.

# What the user's login shell sets (~/.bash_profile, ~/.zprofile, fish's
# config), as a console login has it: uwsm read /etc/profile and ~/.profile,
# which bash skips when there is a ~/.bash_profile. First, so that Nova's own
# below still hold.
if [ -x /usr/lib/nova/bin/nova-session-profile ]; then
  eval "$(/usr/lib/nova/bin/nova-session-profile)"
fi

# Not GTK_USE_PORTAL, from a profile or anywhere else before this: in the
# session's environment it reaches the shell, whose GTK 3 then waits on the
# desktop portal with no time limit as it starts, the boot lock with it.
# nova-launch gives it to apps.
unset GTK_USE_PORTAL

export NOVA_PATH=/usr/share/nova

# Helper commands (nova-<group>-<verb>) are on PATH for every app the session starts,
# so shell code and keybindings can call them by name.
case ":$PATH:" in
  *:/usr/lib/nova/bin:*) ;;
  *) export PATH="/usr/lib/nova/bin:$PATH" ;;
esac

# Tools installed with mise (Claude Code, Codex, node, ...) for apps started
# from the desktop, which never read ~/.bashrc.
case ":$PATH:" in
  *:"$HOME/.local/share/mise/shims":*) ;;
  *) export PATH="$PATH:$HOME/.local/share/mise/shims" ;;
esac
