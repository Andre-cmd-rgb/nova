#!/usr/bin/python3 -I

# nova:summary=Change the login password from Settings
# nova:hidden=true
#
# passwd must own the PAM conversation so pwquality and the login keyring
# both take part. A pipe races PAM's terminal flush; answer each prompt on
# a private terminal instead. Python already ships with python-dbus.

import errno
import json
import os
import pty
import re
import resource
import select
import signal
import sys
import termios
import time


def read_passwords():
    values = []
    value = bytearray()
    deadline = time.monotonic() + 10
    while len(values) < 3:
        if not select.select([0], [], [], max(0, deadline - time.monotonic()))[0]:
            raise ValueError("Enter all three passwords.")
        char = os.read(0, 1)
        if not char:
            raise ValueError("Enter all three passwords.")
        if char == b"\0":
            values.append(bytes(value))
            value.clear()
        elif char[0] < 32 or char[0] == 127 or len(value) >= 1024:
            raise ValueError("That password contains unsupported characters or is too long.")
        else:
            value.extend(char)
    if not all(values):
        raise ValueError("Enter all three passwords.")
    if values[1] != values[2]:
        raise ValueError("The new passwords are not the same.")
    return values


PROMPT = re.compile(
    rb"(?P<current>(?:\(current\)|current)(?: UNIX)? password:)"
    rb"|(?P<repeat>retype (?:new (?:UNIX )?)?password:)"
    rb"|(?P<new>(?:enter )?new (?:UNIX )?password:)", re.I
)


def reason(output, sent, passwords):
    # Only a short diagnostic leaves this process, never the conversation.
    for password in sorted(passwords, key=len, reverse=True):
        output = output.replace(password, b"[hidden]")
    text = output.decode("utf-8", "replace")
    weak = re.search(r"BAD PASSWORD:\s*([^\r\n]+)", text, re.I)
    if weak:
        return weak[1].strip()[:160]
    if sent <= 1 and re.search(r"authentication (?:failure|token manipulation error)|incorrect|wrong", text, re.I):
        return "The current password is not right."
    if re.search(r"do not match|not match|mismatch", text, re.I):
        return "The new passwords are not the same."
    lines = [line.strip() for line in text.splitlines() if line.strip().startswith("passwd:")]
    for line in lines:
        if not re.search(r"unchanged|changing password", line, re.I):
            return line.removeprefix("passwd:").strip()[:160]
    return "Could not change the password."


def change(passwords):
    pid, terminal = pty.fork()
    if pid == 0:
        try:
            attrs = termios.tcgetattr(0)
            attrs[3] &= ~(termios.ECHO | termios.ECHONL)
            termios.tcsetattr(0, termios.TCSANOW, attrs)
            # By its path: a passwd earlier in PATH (~/.local/bin) would be
            # handed the current password. NOVA_PASSWD is for tests.
            os.execve(os.environ.get("NOVA_PASSWD", "/usr/bin/passwd"), ["passwd"], dict(os.environ, LC_ALL="C"))
        except OSError:
            os._exit(127)

    output = b""
    pending = b""
    sent = 0
    status = None
    deadline = time.monotonic() + 45
    try:
        while time.monotonic() < deadline:
            if select.select([terminal], [], [], 0.1)[0]:
                try:
                    chunk = os.read(terminal, 4096)
                except OSError as error:
                    if error.errno != errno.EIO:
                        raise
                    chunk = b""
                output = (output + chunk)[-16384:]
                pending += chunk
                while match := PROMPT.search(pending):
                    kind = match.lastgroup
                    pending = pending[match.end():]
                    expected = ["current", "new", "repeat"]
                    # Some accounts have no old password; passwd starts at new.
                    if sent == 0 and kind == "new":
                        sent = 1
                    if sent >= 3 or kind != expected[sent]:
                        return False, reason(output, sent, passwords)
                    os.write(terminal, passwords[sent] + b"\n")
                    sent += 1
                pending = pending[-4096:]
            waited, status = os.waitpid(pid, os.WNOHANG)
            if waited:
                pid = 0
                break
        if pid:
            waited, status = os.waitpid(pid, os.WNOHANG)
            if waited:
                pid = 0
        if pid:
            return False, reason(output, sent, passwords)
        if os.waitstatus_to_exitcode(status) == 0 and sent == 3:
            return True, ""
        return False, reason(output, sent, passwords)
    finally:
        os.close(terminal)
        if pid:
            # Cancelling Settings must also end passwd and its PAM session.
            try:
                os.killpg(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            os.waitpid(pid, 0)


def cancel(_signum, _frame):
    raise SystemExit(1)


def main():
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    signal.signal(signal.SIGTERM, cancel)
    signal.signal(signal.SIGINT, cancel)
    try:
        ok, error = change(read_passwords())
    except ValueError as exception:
        ok, error = False, str(exception)
    except OSError:
        ok, error = False, "Could not start the password change."
    print(json.dumps({"ok": ok, "error": error}), flush=True)
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
